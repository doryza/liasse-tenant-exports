<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Articles — Admin Noxa</title>
<link rel="stylesheet" href="../public/css/admin-styles.css">
</head>
<body>
<%- include('partials/admin-sidebar', { active: 'posts' }) %>
<main class="admin-main">
  <header class="admin-header">
    <h1>Articles</h1>
    <button class="btn btn-primary" onclick="openModal()">+ Nouvel article</button>
  </header>
  <section class="panel">
    <% if (items && items.length > 0) { %>
      <table class="admin-table">
        <thead><tr><th>Date</th><th>Titre</th><th>Catégorie</th><th>Publié</th><th>Actions</th></tr></thead>
        <tbody>
          <% items.forEach(function(p){ %>
            <tr>
              <td><%= new Date(p.created_at).toLocaleDateString('fr-CA') %></td>
              <td><strong><%= p.title %></strong></td>
              <td><%= p.category || '-' %></td>
              <td><%= p.published ? '✓' : '✗' %></td>
              <td>
                <button class="btn-sm" onclick='editItem(<%= JSON.stringify(p) %>)'>Modifier</button>
                <button class="btn-sm btn-danger" onclick="deleteItem(<%= p.id %>)">Suppr.</button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } else { %>
      <p class="muted">Aucun article. Cliquez sur "+ Nouvel article" pour publier.</p>
    <% } %>
  </section>
</main>
<div id="modal" class="modal hidden">
  <div class="modal-content">
    <h2 id="modalTitle">Article</h2>
    <form id="itemForm">
      <input type="hidden" name="id">
      <label>Titre *<input name="title" required></label>
      <label>Catégorie<input name="category"></label>
      <label>URL de l'image<input name="image_url" type="url"></label>
      <label>Contenu<textarea name="content" rows="8"></textarea></label>
      <label class="checkbox"><input name="published" type="checkbox" value="1" checked> Publié</label>
      <div class="modal-actions">
        <button type="button" class="btn" onclick="closeModal()">Annuler</button>
        <button type="submit" class="btn btn-primary">Enregistrer</button>
      </div>
    </form>
  </div>
</div>
<script>
function openModal(){ document.getElementById('modal').classList.remove('hidden'); document.getElementById('itemForm').reset(); document.querySelector('[name=id]').value=''; document.getElementById('modalTitle').textContent='Nouvel article'; }
function closeModal(){ document.getElementById('modal').classList.add('hidden'); }
function editItem(p){
  document.getElementById('modal').classList.remove('hidden');
  document.getElementById('modalTitle').textContent='Modifier l\'article';
  var f = document.getElementById('itemForm');
  f.id.value = p.id;
  f.title.value = p.title || '';
  f.category.value = p.category || '';
  f.image_url.value = p.image_url || '';
  f.content.value = p.content || '';
  f.published.checked = !!p.published;
}
async function deleteItem(id){
  if(!confirm('Supprimer cet article?')) return;
  await fetch('../api/admin/posts/' + id, { method: 'DELETE' });
  location.reload();
}
document.getElementById('itemForm').addEventListener('submit', async function(e){
  e.preventDefault();
  var f = e.target;
  var data = { title:f.title.value, category:f.category.value, image_url:f.image_url.value, content:f.content.value, published:f.published.checked?1:0 };
  var id = f.id.value;
  var url = '../api/admin/posts' + (id ? '/' + id : '');
  var method = id ? 'PUT' : 'POST';
  var res = await fetch(url, { method: method, headers:{'Content-Type':'application/json'}, body: JSON.stringify(data) });
  if (res.ok) location.reload();
  else alert('Erreur');
});
</script>
</body>
</html>
