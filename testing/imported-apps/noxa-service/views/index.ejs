<%- include('partials/header') %>
<section class="relative">
  <img src="<%= (typeof settings!=='undefined' && settings._p_hero_image_url) ? settings._p_hero_image_url : 'https://placehold.co/1600x700/6366f1/ffffff/png?text=Noxa+Service' %>" alt="Noxa Service" class="w-full h-[420px] md:h-[560px] object-cover">
  <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/40 to-transparent flex items-center">
    <div class="max-w-7xl mx-auto px-4 w-full">
      <div class="max-w-2xl text-white">
        <span class="inline-block px-3 py-1 rounded-full bg-white/20 backdrop-blur text-xs font-semibold uppercase tracking-wider mb-4">Service professionnel au Québec</span>
        <h1 class="text-4xl md:text-6xl font-bold leading-tight mb-4"><%= settings.hero_title || t.hero_title %></h1>
        <p class="text-lg md:text-xl text-gray-100 mb-8"><%= settings.hero_subtitle || t.hero_subtitle %></p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="contact" class="px-6 py-3 rounded-lg text-white font-semibold text-center shadow-lg hover:shadow-xl transition" style="background-color:#6366f1;color:#fff"><%= t.hero_cta %></a>
          <a href="services" class="px-6 py-3 rounded-lg bg-white/10 backdrop-blur border border-white/30 text-white font-semibold text-center hover:bg-white/20 transition"><%= t.hero_cta2 %></a>
        </div>
        <div class="mt-8 flex items-center gap-4 text-sm">
          <span class="flex items-center gap-2">✓ Soumission gratuite</span>
          <span class="flex items-center gap-2">✓ Équipe assurée</span>
          <span class="flex items-center gap-2">✓ Satisfaction garantie</span>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="py-16 md:py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3"><%= t.services_title %></h2>
      <p class="text-lg text-gray-600"><%= t.services_subtitle %></p>
    </div>
    <% if (typeof servicesList !== 'undefined' && servicesList.length > 0) { %>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% servicesList.forEach(function(s){ %>
          <article class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition group">
            <div class="relative h-52 overflow-hidden">
              <img src="<%= s.image_url || 'https://placehold.co/600x400/e2e8f0/64748b/png?text=Service' %>" alt="<%= s.name %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
              <div class="absolute top-3 left-3 w-12 h-12 rounded-xl bg-white/95 flex items-center justify-center text-2xl shadow"><%= s.icon || '✨' %></div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-2"><%= s.name %></h3>
              <p class="text-gray-600 text-sm mb-4 line-clamp-3"><%= s.short_description || '' %></p>
              <a href="services/<%= s.slug %>" class="inline-flex items-center gap-1 font-semibold text-sm" style="color:#6366f1"><%= t.service_more %> →</a>
            </div>
          </article>
        <% }); %>
      </div>
    <% } else { %>
      <p class="text-center text-gray-500">Nos services seront bientôt disponibles.</p>
    <% } %>
  </div>
</section>

<section class="py-16 md:py-20">
  <div class="max-w-7xl mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-bold text-center text-gray-900 mb-12"><%= t.why_title %></h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <% var w = [['🏆',t.why_1_title,t.why_1_desc],['🌿',t.why_2_title,t.why_2_desc],['✅',t.why_3_title,t.why_3_desc],['💬',t.why_4_title,t.why_4_desc]]; %>
      <% w.forEach(function(item){ %>
        <div class="p-6 rounded-2xl border border-gray-100 hover:border-brand hover:shadow-md transition">
          <div class="w-14 h-14 rounded-xl flex items-center justify-center text-3xl mb-4" style="background-color:#eef2ff"><%= item[0] %></div>
          <h3 class="text-lg font-bold text-gray-900 mb-2"><%= item[1] %></h3>
          <p class="text-gray-600 text-sm"><%= item[2] %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<% if (typeof testimonials !== 'undefined' && testimonials.length > 0) { %>
<section class="py-16 md:py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-bold text-center text-gray-900 mb-12"><%= t.testimonials_title %></h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% testimonials.forEach(function(tt){ %>
        <figure class="bg-white p-6 rounded-2xl shadow-sm">
          <div class="flex items-center gap-1 mb-3 text-yellow-400">
            <% for (var i=0;i<(tt.rating||5);i++){ %>★<% } %>
          </div>
          <blockquote class="text-gray-700 mb-4 italic">« <%= tt.content %> »</blockquote>
          <figcaption>
            <div class="font-semibold text-gray-900"><%= tt.author %></div>
            <% if (tt.role) { %><div class="text-sm text-gray-500"><%= tt.role %></div><% } %>
          </figcaption>
        </figure>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<section class="py-16 md:py-20" style="background:linear-gradient(135deg,#6366f1,#4f46e5)">
  <div class="max-w-4xl mx-auto px-4 text-center text-white">
    <h2 class="text-3xl md:text-4xl font-bold mb-4"><%= settings.cta_title || t.cta_title %></h2>
    <p class="text-lg text-indigo-100 mb-8"><%= settings.cta_subtitle || t.cta_subtitle %></p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="contact" class="px-6 py-3 rounded-lg bg-white font-semibold shadow-lg hover:shadow-xl transition" style="color:#6366f1"><%= t.cta_btn %></a>
      <% var phone = (typeof settings!=='undefined' && settings.contact_phone) ? settings.contact_phone : '438-376-6883'; %>
      <a href="tel:<%= phone.replace(/\D/g,'') %>" class="px-6 py-3 rounded-lg border-2 border-white text-white font-semibold hover:bg-white/10 transition">📞 <%= phone %></a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
