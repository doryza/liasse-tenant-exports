<%- include('partials/header') %>
<section class="py-12 bg-gray-50 border-b border-gray-100">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <h1 class="text-4xl md:text-5xl font-bold text-gray-900"><%= settings.about_title || t.about_title %></h1>
  </div>
</section>
<section class="py-12 md:py-16">
  <div class="max-w-5xl mx-auto px-4 grid md:grid-cols-2 gap-10 items-center">
    <div>
      <p class="text-lg text-gray-700 leading-relaxed whitespace-pre-line"><%= settings.about_text || 'Noxa Service est une entreprise québécoise spécialisée dans le ménage professionnel.' %></p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3">
        <a href="contact" class="px-6 py-3 rounded-lg text-white font-semibold text-center" style="background-color:#6366f1;color:#fff"><%= t.about_cta %></a>
        <a href="services" class="px-6 py-3 rounded-lg border-2 font-semibold text-center" style="border-color:#6366f1;color:#6366f1">Nos services</a>
      </div>
    </div>
    <div>
      <img src="https://placehold.co/800x600/eef2ff/6366f1/png?text=Noxa+Service" alt="À propos" class="w-full h-auto rounded-2xl shadow-lg">
    </div>
  </div>
</section>
<section class="py-12 bg-gray-50">
  <div class="max-w-5xl mx-auto px-4 grid sm:grid-cols-3 gap-6 text-center">
    <div class="p-6 bg-white rounded-2xl">
      <div class="text-4xl font-bold mb-2" style="color:#6366f1">100%</div>
      <div class="text-gray-600">Satisfaction garantie</div>
    </div>
    <div class="p-6 bg-white rounded-2xl">
      <div class="text-4xl font-bold mb-2" style="color:#6366f1">24h</div>
      <div class="text-gray-600">Réponse à votre demande</div>
    </div>
    <div class="p-6 bg-white rounded-2xl">
      <div class="text-4xl font-bold mb-2" style="color:#6366f1">✓</div>
      <div class="text-gray-600">Équipe assurée et formée</div>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
