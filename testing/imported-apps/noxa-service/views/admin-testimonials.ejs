<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Témoignages — Admin Noxa</title>
<link rel="stylesheet" href="../public/css/admin-styles.css">
</head>
<body>
<%- include('partials/admin-sidebar', { active: 'testimonials' }) %>
<main class="admin-main">
  <header class="admin-header">
    <h1>Témoignages</h1>
    <button class="btn btn-primary" onclick="openModal()">+ Ajouter</button>
  </header>
  <section class="panel">
    <% if (items && items.length > 0) { %>
      <table class="admin-table">
        <thead><tr><th>Auteur</th><th>Note</th><th>Témoignage</th><th>Publié</th><th>Actions</th></tr></thead>
        <tbody>
          <% items.forEach(function(t){ %>
            <tr>
              <td><strong><%= t.author %></strong><% if(t.role){ %><br><small class="muted"><%= t.role %></small><% } %></td>
              <td><%= '★'.repeat(t.rating||5) %></td>
              <td><%= (t.content||'').substring(0,100) %><%= (t.content||'').length>100?'...':'' %></td>
              <td><%= t.published ? '✓' : '✗' %></td>
              <td>
                <button class="btn-sm" onclick='editItem(<%= JSON.stringify(t) %>)'>Modifier</button>
                <button class="btn-sm btn-danger" onclick="deleteItem(<%= t.id %>)">Suppr.</button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } else { %>
      <p class="muted">Aucun témoignage. Ajoutez-en pour rassurer vos clients.</p>
    <% } %>
  </section>
</main>
<div id="modal" class="modal hidden">
  <div class="modal-content">
    <h2 id="modalTitle">Témoignage</h2>
    <form id="itemForm">
      <input type="hidden" name="id">
      <label>Auteur *<input name="author" required></label>
      <label>Rôle / Type de client<input name="role"></label>
      <label>Témoignage *<textarea name="content" rows="4" required></textarea></label>
      <label>Note (1-5)<input name="rating" type="number" min="1" max="5" value="5"></label>
      <label>URL avatar<input name="avatar_url" type="url"></label>
      <label class="checkbox"><input name="published" type="checkbox" value="1" checked> Publié</label>
      <div class="modal-actions">
        <button type="button" class="btn" onclick="closeModal()">Annuler</button>
        <button type="submit" class="btn btn-primary">Enregistrer</button>
      </div>
    </form>
  </div>
</div>
<script>
function openModal(){ document.getElementById('modal').classList.remove('hidden'); document.getElementById('itemForm').reset(); document.querySelector('[name=id]').value=''; document.getElementById('modalTitle').textContent='Nouveau témoignage'; }
function closeModal(){ document.getElementById('modal').classList.add('hidden'); }
function editItem(t){
  document.getElementById('modal').classList.remove('hidden');
  document.getElementById('modalTitle').textContent='Modifier le témoignage';
  var f = document.getElementById('itemForm');
  f.id.value = t.id;
  f.author.value = t.author || '';
  f.role.value = t.role || '';
  f.content.value = t.content || '';
  f.rating.value = t.rating || 5;
  f.avatar_url.value = t.avatar_url || '';
  f.published.checked = !!t.published;
}
async function deleteItem(id){
  if(!confirm('Supprimer ce témoignage?')) return;
  await fetch('../api/admin/testimonials/' + id, { method: 'DELETE' });
  location.reload();
}
document.getElementById('itemForm').addEventListener('submit', async function(e){
  e.preventDefault();
  var f = e.target;
  var data = { author:f.author.value, role:f.role.value, content:f.content.value, rating:parseInt(f.rating.value)||5, avatar_url:f.avatar_url.value, published:f.published.checked?1:0 };
  var id = f.id.value;
  var url = '../api/admin/testimonials' + (id ? '/' + id : '');
  var method = id ? 'PUT' : 'POST';
  var res = await fetch(url, { method: method, headers:{'Content-Type':'application/json'}, body: JSON.stringify(data) });
  if (res.ok) location.reload();
  else alert('Erreur');
});
</script>
</body>
</html>
