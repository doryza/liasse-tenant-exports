<%- include('partials/header') %>
<section class="py-12 bg-gray-50 border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 text-center">
    <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-3"><%= t.services_title %></h1>
    <p class="text-lg text-gray-600 max-w-2xl mx-auto"><%= t.services_subtitle %></p>
  </div>
</section>
<section class="py-12 md:py-16">
  <div class="max-w-7xl mx-auto px-4">
    <% if (typeof servicesList !== 'undefined' && servicesList.length > 0) { %>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% servicesList.forEach(function(s){ %>
          <article class="bg-white rounded-2xl overflow-hidden border border-gray-100 hover:shadow-xl transition group">
            <div class="relative h-56 overflow-hidden">
              <img src="<%= s.image_url || 'https://placehold.co/600x400/e2e8f0/64748b/png?text=Service' %>" alt="<%= s.name %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
              <div class="absolute top-3 left-3 w-12 h-12 rounded-xl bg-white/95 flex items-center justify-center text-2xl shadow"><%= s.icon || '✨' %></div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-2"><%= s.name %></h3>
              <p class="text-gray-600 text-sm mb-4"><%= s.short_description || '' %></p>
              <a href="services/<%= s.slug %>" class="inline-flex items-center gap-1 font-semibold text-sm" style="color:#6366f1"><%= t.service_more %> →</a>
            </div>
          </article>
        <% }); %>
      </div>
    <% } else { %>
      <div class="text-center py-16">
        <p class="text-gray-500">Aucun service disponible pour le moment.</p>
      </div>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>
