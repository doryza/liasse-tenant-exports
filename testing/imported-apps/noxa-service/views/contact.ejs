<%- include('partials/header') %>
<section class="py-12 bg-gray-50 border-b border-gray-100">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-3"><%= t.contact_title %></h1>
    <p class="text-lg text-gray-600"><%= t.contact_subtitle %></p>
  </div>
</section>
<section class="py-12 md:py-16">
  <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-3 gap-10">
    <div class="md:col-span-1 space-y-6">
      <% var ph = (typeof settings!=='undefined' && settings.contact_phone) ? settings.contact_phone : '438-376-6883'; %>
      <% var em = (typeof settings!=='undefined' && settings.contact_email) ? settings.contact_email : ''; %>
      <% var ad = (typeof settings!=='undefined' && settings.business_address) ? settings.business_address : ''; %>
      <div class="p-6 rounded-2xl border border-gray-100">
        <div class="text-2xl mb-2">📞</div>
        <div class="text-sm text-gray-500 mb-1"><%= t.footer_phone %></div>
        <a href="tel:<%= ph.replace(/\D/g,'') %>" class="text-lg font-semibold text-gray-900 hover:text-brand"><%= ph %></a>
      </div>
      <% if (em) { %>
      <div class="p-6 rounded-2xl border border-gray-100">
        <div class="text-2xl mb-2">✉️</div>
        <div class="text-sm text-gray-500 mb-1"><%= t.footer_email %></div>
        <a href="mailto:<%= em %>" class="text-lg font-semibold text-gray-900 hover:text-brand break-all"><%= em %></a>
      </div>
      <% } %>
      <% if (ad) { %>
      <div class="p-6 rounded-2xl border border-gray-100">
        <div class="text-2xl mb-2">📍</div>
        <div class="text-sm text-gray-500 mb-1">Zone desservie</div>
        <div class="text-lg font-semibold text-gray-900"><%= ad %></div>
      </div>
      <% } %>
      <div class="p-6 rounded-2xl" style="background:linear-gradient(135deg,#eef2ff,#e0e7ff)">
        <h4 class="font-bold text-gray-900 mb-2">Heures d'ouverture</h4>
        <ul class="text-sm text-gray-700 space-y-1">
          <li>Lundi – Vendredi : 7h – 19h</li>
          <li>Samedi : 8h – 17h</li>
          <li>Dimanche : Sur rendez-vous</li>
        </ul>
      </div>
    </div>
    <div class="md:col-span-2">
      <form id="reservationForm" class="bg-white p-6 md:p-8 rounded-2xl border border-gray-100 shadow-sm space-y-4">
        <div id="formMsg" class="hidden p-4 rounded-lg"></div>
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1"><%= t.form_name %> *</label>
            <input name="name" required class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:ring-2 focus:ring-brand focus:border-transparent" placeholder="Jean Tremblay">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1"><%= t.form_phone %> *</label>
            <input name="phone" type="tel" required class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:ring-2 focus:ring-brand focus:border-transparent" placeholder="438-555-1234">
          </div>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1"><%= t.form_email %></label>
          <input name="email" type="email" class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:ring-2 focus:ring-brand focus:border-transparent" placeholder="client@exemple.com">
        </div>
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1"><%= t.form_service %></label>
            <select name="service_type" class="w-full px-4 py-3 rounded-lg border border-gray-200 bg-white focus:ring-2 focus:ring-brand focus:border-transparent">
              <option value="">— Sélectionner —</option>
              <% if (typeof servicesList !== 'undefined') { servicesList.forEach(function(s){ %>
                <option value="<%= s.name %>"><%= s.name %></option>
              <% }); } %>
              <option value="Autre">Autre</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1"><%= t.form_date %></label>
            <input name="preferred_date" type="date" class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:ring-2 focus:ring-brand focus:border-transparent">
          </div>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1"><%= t.form_address %></label>
          <input name="address" class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:ring-2 focus:ring-brand focus:border-transparent" placeholder="123 rue Principale, Montréal">
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1"><%= t.form_message %></label>
          <textarea name="message" rows="4" class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:ring-2 focus:ring-brand focus:border-transparent" placeholder="Superficie, type d'espace, fréquence souhaitée..."></textarea>
        </div>
        <button type="submit" id="submitBtn" class="w-full py-3 rounded-lg text-white font-semibold shadow hover:shadow-lg transition" style="background-color:#6366f1;color:#fff"><%= t.form_submit %></button>
      </form>
    </div>
  </div>
</section>
<script>
document.getElementById('reservationForm').addEventListener('submit', async function(e){
  e.preventDefault();
  var form = e.target;
  var btn = document.getElementById('submitBtn');
  var msg = document.getElementById('formMsg');
  var data = {};
  new FormData(form).forEach(function(v,k){ data[k] = v; });
  btn.disabled = true; btn.textContent = '<%- t.form_sending %>';
  msg.className = 'hidden p-4 rounded-lg';
  try {
    var res = await fetch('./api/reservation', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    var j = await res.json();
    if (res.ok && j.success) {
      msg.className = 'p-4 rounded-lg bg-green-50 text-green-800 border border-green-200';
      msg.textContent = '<%- t.form_success %>';
      form.reset();
    } else {
      throw new Error(j.error || 'erreur');
    }
  } catch(err) {
    msg.className = 'p-4 rounded-lg bg-red-50 text-red-800 border border-red-200';
    msg.textContent = '<%- t.form_error %>';
  }
  btn.disabled = false; btn.textContent = '<%- t.form_submit %>';
  msg.scrollIntoView({behavior:'smooth', block:'center'});
});
</script>
<%- include('partials/footer') %>
