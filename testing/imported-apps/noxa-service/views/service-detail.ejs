<%- include('partials/header') %>
<article class="max-w-5xl mx-auto px-4 py-12">
  <a href="services" class="text-sm text-gray-500 hover:text-brand mb-4 inline-block">← Tous les services</a>
  <div class="flex items-center gap-3 mb-4">
    <span class="text-4xl"><%= service.icon || '✨' %></span>
    <h1 class="text-3xl md:text-5xl font-bold text-gray-900"><%= service.name %></h1>
  </div>
  <% if (service.short_description) { %><p class="text-xl text-gray-600 mb-8"><%= service.short_description %></p><% } %>
  <% if (service.image_url) { %>
    <img src="<%= service.image_url %>" alt="<%= service.name %>" class="w-full h-96 object-cover rounded-2xl mb-8 shadow-md">
  <% } %>
  <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed whitespace-pre-line"><%= service.description || '' %></div>
  <div class="mt-10 p-8 rounded-2xl" style="background:linear-gradient(135deg,#eef2ff,#e0e7ff)">
    <h3 class="text-2xl font-bold text-gray-900 mb-2">Intéressé par ce service?</h3>
    <p class="text-gray-700 mb-5">Demandez votre soumission gratuite — réponse rapide garantie.</p>
    <div class="flex flex-col sm:flex-row gap-3">
      <a href="contact" class="px-6 py-3 rounded-lg text-white font-semibold text-center" style="background-color:#6366f1;color:#fff">Demander une soumission</a>
      <% var ph = (typeof settings!=='undefined' && settings.contact_phone) ? settings.contact_phone : '438-376-6883'; %>
      <a href="tel:<%= ph.replace(/\D/g,'') %>" class="px-6 py-3 rounded-lg border-2 font-semibold text-center" style="border-color:#6366f1;color:#6366f1">📞 <%= ph %></a>
    </div>
  </div>
</article>
<% if (typeof others !== 'undefined' && others.length > 0) { %>
<section class="max-w-7xl mx-auto px-4 py-12 border-t border-gray-100">
  <h2 class="text-2xl font-bold text-gray-900 mb-6">Autres services</h2>
  <div class="grid md:grid-cols-3 gap-6">
    <% others.forEach(function(s){ %>
      <a href="<%= s.slug %>" class="block bg-white rounded-2xl overflow-hidden border border-gray-100 hover:shadow-lg transition">
        <% if (s.image_url) { %><img src="<%= s.image_url %>" alt="<%= s.name %>" class="w-full h-40 object-cover"><% } %>
        <div class="p-5">
          <h3 class="font-bold text-gray-900 mb-1"><%= s.icon || '✨' %> <%= s.name %></h3>
          <p class="text-sm text-gray-600"><%= s.short_description || '' %></p>
        </div>
      </a>
    <% }); %>
  </div>
</section>
<% } %>
<%- include('partials/footer') %>
