<%- include('partials/header', { settings, pageTitle: post.title }) %>
<article class="article-page">
  <div class="container article-container">
    <a href="articles" class="back-link">← Retour aux articles</a>
    <% if (post.category) { %><span class="badge"><%= post.category %></span><% } %>
    <h1><%= post.title %></h1>
    <div class="article-meta"><%= formatDate(post.created_at) %></div>
    <% if (post.image_url) { %>
      <img src="<%= post.image_url %>" alt="<%= post.title %>" class="article-hero">
    <% } %>
    <% if (post.excerpt) { %><p class="article-lead"><%= post.excerpt %></p><% } %>
    <div class="article-body"><%- paragraphs(post.content || '') %></div>
    <div class="article-cta">
      <h3>Une question sur cet article ?</h3>
      <p>Je suis là pour vous aider à concrétiser votre projet immobilier.</p>
      <div class="hero-ctas">
        <a href="evaluation" class="btn-primary" style="background-color:#1e3a8a;color:#fff;border-color:#1e3a8a">Évaluation gratuite</a>
        <a href="contact" class="btn-outline">Me contacter</a>
      </div>
    </div>
  </div>
</article>
<% if (typeof related !== 'undefined' && related.length > 0) { %>
  <section class="section section-alt">
    <div class="container">
      <div class="section-head"><h2>D'autres articles à découvrir</h2></div>
      <div class="post-grid">
        <% related.forEach(function(r) { %>
          <article class="post-card">
            <a href="articles/<%= r.id %>" class="post-img-link">
              <img src="<%= r.image_url || 'https://placehold.co/600x400/e2e8f0/64748b/png?text=Article' %>" alt="<%= r.title %>">
            </a>
            <div class="post-body">
              <% if (r.category) { %><span class="badge"><%= r.category %></span><% } %>
              <h3><a href="articles/<%= r.id %>"><%= r.title %></a></h3>
              <div class="post-meta"><%= formatDate(r.created_at) %></div>
            </div>
          </article>
        <% }); %>
      </div>
    </div>
  </section>
<% } %>
<%- include('partials/footer') %>
