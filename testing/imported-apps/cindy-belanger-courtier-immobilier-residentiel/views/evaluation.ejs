<%- include('partials/header', { settings, pageTitle: 'Évaluation gratuite' }) %>
<section class="page-hero">
  <div class="container">
    <span class="eyebrow">Sans engagement</span>
    <h1><%= settings.evaluation_title || 'Évaluation gratuite de votre propriété' %></h1>
    <p><%= settings.evaluation_subtitle || 'Recevez une estimation personnalisée basée sur le marché actuel.' %></p>
  </div>
</section>

<section class="section">
  <div class="container form-layout">
    <div class="form-side">
      <% if (success) { %>
        <div class="alert-success">
          <strong>Merci !</strong> Votre demande d'évaluation a bien été envoyée. Je vous reviendrai sous 24 à 48 heures ouvrables.
        </div>
      <% } %>
      <form id="evalForm" class="form-card">
        <h2>Vos informations</h2>
        <div class="form-row">
          <label>Nom complet *<input type="text" name="name" required></label>
        </div>
        <div class="form-row two-col">
          <label>Courriel<input type="email" name="email" placeholder="votre@courriel.com"></label>
          <label>Téléphone<input type="tel" name="phone" placeholder="418 555-1234"></label>
        </div>
        <p class="form-hint">* Veuillez fournir au moins un moyen de vous joindre (courriel ou téléphone).</p>
        <h2>Votre propriété</h2>
        <div class="form-row">
          <label>Adresse complète *<input type="text" name="address" required placeholder="123 rue Exemple, Québec, QC"></label>
        </div>
        <div class="form-row two-col">
          <label>Type de propriété
            <select name="property_type">
              <option value="">— Sélectionner —</option>
              <option>Maison unifamiliale</option>
              <option>Maison en rangée</option>
              <option>Jumelé</option>
              <option>Condo</option>
              <option>Plex</option>
              <option>Terrain</option>
              <option>Autre</option>
            </select>
          </label>
          <label>Année de construction<input type="text" name="year_built" placeholder="Ex. 1998"></label>
        </div>
        <div class="form-row two-col">
          <label>Chambres<input type="text" name="bedrooms" placeholder="Ex. 3"></label>
          <label>Salles de bain<input type="text" name="bathrooms" placeholder="Ex. 2"></label>
        </div>
        <div class="form-row">
          <label>Échéancier souhaité
            <select name="sale_timeframe">
              <option value="">— Sélectionner —</option>
              <option>Dans les 3 prochains mois</option>
              <option>3 à 6 mois</option>
              <option>6 à 12 mois</option>
              <option>Plus de 12 mois</option>
              <option>Je ne suis pas sûr(e)</option>
            </select>
          </label>
        </div>
        <div class="form-row">
          <label>Informations additionnelles<textarea name="notes" rows="4" placeholder="Rénovations récentes, particularités, questions..."></textarea></label>
        </div>
        <div id="evalMsg" class="form-msg"></div>
        <button type="submit" class="btn-primary btn-lg" style="background-color:#1e3a8a;color:#fff;border-color:#1e3a8a">Envoyer ma demande</button>
      </form>
    </div>
    <aside class="form-aside">
      <div class="aside-card">
        <h3>Comment ça marche ?</h3>
        <ol class="steps">
          <li><strong>Vous remplissez le formulaire</strong> — 2 minutes suffisent.</li>
          <li><strong>J'analyse votre propriété</strong> — comparaisons, marché, particularités.</li>
          <li><strong>Vous recevez votre évaluation</strong> — sous 24 à 48 h ouvrables.</li>
        </ol>
      </div>
      <div class="aside-card aside-promise">
        <h3>Ma promesse</h3>
        <p><%= settings.evaluation_promise || 'Réponse sous 24 à 48 heures ouvrables, aucun engagement, aucune obligation.' %></p>
      </div>
      <div class="aside-card">
        <h3>Préférez parler directement ?</h3>
        <% if (typeof config !== 'undefined' && config && config.contactEmail) { %>
          <p>📧 <a href="mailto:<%= config.contactEmail %>"><%= config.contactEmail %></a></p>
        <% } %>
        <% if (typeof config !== 'undefined' && config && config.contactPhone) { %>
          <p>📞 <a href="tel:<%= config.contactPhone %>"><%= config.contactPhone %></a></p>
        <% } %>
        <p><a href="contact" class="link-arrow">Tous mes coordonnées →</a></p>
      </div>
    </aside>
  </div>
</section>
<script>
document.getElementById('evalForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  var msg = document.getElementById('evalMsg');
  msg.textContent = '';
  msg.className = 'form-msg';
  var data = {};
  new FormData(e.target).forEach(function(v, k) { data[k] = v; });
  var btn = e.target.querySelector('button[type=submit]');
  btn.disabled = true; btn.textContent = 'Envoi en cours...';
  try {
    var res = await fetch('api/evaluation', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
    var j = await res.json();
    if (res.ok && j.success) {
      window.location.href = 'evaluation?success=1';
    } else {
      msg.textContent = j.error || 'Une erreur est survenue.';
      msg.classList.add('error');
      btn.disabled = false; btn.textContent = 'Envoyer ma demande';
    }
  } catch(err) {
    msg.textContent = 'Erreur de connexion. Veuillez réessayer.';
    msg.classList.add('error');
    btn.disabled = false; btn.textContent = 'Envoyer ma demande';
  }
});
</script>
<%- include('partials/footer') %>
