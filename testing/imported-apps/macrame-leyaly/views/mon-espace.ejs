<%- include('partials/header') %>
<section class="page-head"><div class="wrap"><span class="eyebrow script">Mon espace</span><h1>Bonjour <%= (typeof user!=='undefined' && user && user.display_name) ? user.display_name : '' %></h1></div></section>
<section class="wrap section">
<% if(typeof user!=='undefined' && user){ %>
<h2 class="block-title">Mes coups de cœur</h2>
<% if(favs && favs.length){ %>
<div class="cr-grid">
<% favs.forEach(function(c){ %>
<article class="cr-card">
<button class="fav-btn is-fav" data-fav data-reload="1" data-creation="<%= c.id %>" aria-label="Retirer"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M12 21s-7.5-4.6-10-9.3C.4 8.4 2 5 5.2 5c2 0 3.3 1.2 4.8 3 1.5-1.8 2.8-3 4.8-3C18 5 19.6 8.4 22 11.7 19.5 16.4 12 21 12 21z"/></svg></button>
<a class="cr-thumb" href="creations/<%= c.id %>"><span class="cr-hook"></span><img src="<%= c.image_url || 'https://placehold.co/600x450/EBDDC9/9E5634/png?text=Cr%C3%A9ation' %>" alt="<%= c.name %>"></a>
<div class="cr-body"><h3><a href="creations/<%= c.id %>"><%= c.name %></a></h3><div class="cr-foot"><span class="cr-price"><%= formatPrice(c.price) %></span><a class="btn btn-sm btn-primary" style="background-color:#BE6F49;color:#fff" href="commande?creation=<%= c.id %>">Commander</a></div></div>
</article>
<% }); %>
</div>
<% } else { %>
<div class="empty-box"><p>Vous n’avez pas encore de coup de cœur. Explorez la galerie et touchez le ❤ sur vos créations préférées.</p><a class="btn btn-outline" href="galerie">Voir la galerie</a></div>
<% } %>
<h2 class="block-title">Mes commandes</h2>
<% if(myOrders && myOrders.length){ %>
<div class="orders-list">
<% myOrders.forEach(function(o){ %>
<div class="order-row"><div><strong><%= o.creation_name || 'Création sur mesure' %></strong><span class="o-meta">Qté <%= o.quantity %> · <%= formatDate(o.created_at) %></span></div><span class="badge b-<%= (o.status||'nouvelle').replace(/\s/g,'-') %>"><%= o.status %></span></div>
<% }); %>
</div>
<% } else { %>
<div class="empty-box"><p>Aucune commande pour l’instant.</p><a class="btn btn-outline" href="commande">Passer une commande</a></div>
<% } %>
<% } else { %>
<div class="empty-box big"><h2>Connectez-vous</h2><p>Connectez-vous pour retrouver vos coups de cœur et suivre vos commandes.</p><a href="#" class="btn btn-primary" style="background-color:#BE6F49;color:#fff" data-login-btn>Connexion</a></div>
<% } %>
</section>
<%- include('partials/footer') %>