<a href="#" data-login-btn>Connexion</a>
</div>
</header>
<script>
(function(){var b=document.getElementById('burgerBtn'),m=document.getElementById('navMobile');if(b&&m){b.addEventListener('click',function(){m.classList.toggle('open');b.classList.toggle('active');});m.querySelectorAll('a').forEach(function(a){a.addEventListener('click',function(){m.classList.remove('open');b.classList.remove('active');});});}})();
</script>
<main class="page">