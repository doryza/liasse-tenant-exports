<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#BE6F49">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<title><%= (typeof pageTitle!=='undefined' && pageTitle ? pageTitle + ' · ' : '') + (settings.business_name || 'Macramé Leyaly') %></title>
<meta name="description" content="<%= settings.tagline || 'Décorations en macramé faites main par Leylou & Aly' %>">
<link rel="manifest" href="manifest.json">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Gloock&family=Mulish:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="public/css/styles.css">
</head>
<body>
<div class="thread-top"></div>
<header class="site-head">
<div class="wrap head-inner">
<a href="." class="brand" aria-label="Accueil">
<span class="brand-knot" aria-hidden="true"><svg viewBox="0 0 32 32" width="30" height="30"><path d="M6 10c4 0 6 12 10 12s6-12 10-12" fill="none" stroke="#BE6F49" stroke-width="2.4" stroke-linecap="round"/><path d="M6 22c4 0 6-12 10-12s6 12 10 12" fill="none" stroke="#8E9B7E" stroke-width="2.4" stroke-linecap="round"/><circle cx="16" cy="16" r="2.4" fill="#BE6F49"/></svg></span>
<span class="brand-word">Leyaly<span class="brand-sub script">macramé · fait main</span></span>
</a>
<nav class="nav-desktop">
<a href=".">Accueil</a>
<a href="galerie">Galerie</a>
<a href="commande">Commander</a>
<a href="journal">Journal</a>
<a href="a-propos">À propos</a>
<a href="contact">Contact</a>
<a href="mon-espace" class="nav-space" data-auth-only style="display:none">Mon espace</a>
<a href="#" class="nav-login" data-login-btn>Connexion</a>
</nav>
<button class="burger" id="burgerBtn" aria-label="Menu"><span></span><span></span><span></span></button>
</div>
<div class="nav-mobile" id="navMobile">
<a href=".">Accueil</a>
<a href="galerie">Galerie</a>
<a href="commande">Commander</a>
<a href="journal">Journal</a>
<a href="a-propos">À propos</a>
