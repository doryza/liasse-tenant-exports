<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Admin · <%= title %></title>
<link rel="stylesheet" href="public/css/admin-styles.css">
<link href="https://fonts.googleapis.com/css2?family=Mulish:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="admin-body">
<%- include('admin-sidebar', { active: moduleKey }) %>
<main class="admin-main">
<header class="admin-top"><button class="admin-burger" id="adminBurger" aria-label="Menu">☰</button><div class="admin-top-titles"><h1><%= title %></h1><p class="admin-sub">Ajoutez, modifiez et supprimez vos éléments.</p></div><button class="btn btn-primary" id="btnNew">+ Ajouter</button></header>
<div class="admin-toolbar"><input id="searchBox" class="admin-search" placeholder="Rechercher…"><span id="resultCount" class="admin-count"></span></div>
<div id="tableWrap" class="admin-table-wrap"><p class="admin-loading">Chargement…</p></div>
</main>
<div class="admin-modal" id="modal"><div class="admin-modal-card"><div class="admin-modal-head"><h2 id="modalTitle"></h2><button id="modalClose" class="admin-x" aria-label="Fermer">×</button></div><form id="itemForm" class="admin-form"><div id="formFields"></div><div class="admin-form-actions"><button type="button" class="btn btn-light" id="cancelBtn">Annuler</button><button type="submit" class="btn btn-primary">Enregistrer</button></div></form></div></div>
<div class="admin-toast" id="toast"></div>
<script>
var MODULE_KEY=<%- JSON.stringify(moduleKey) %>;
var MODULE_LABEL=<%- JSON.stringify(moduleLabel) %>;
var FIELDS=[],ITEMS=[],EDIT_ID=null;
function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
function showToast(msg,type){var t=document.getElementById('toast');if(!t)return;t.textContent=msg;t.className='admin-toast show '+(type||'');setTimeout(function(){t.className='admin-toast';},2600);}
function toDataUri(file){return new Promise(function(res,rej){var fr=new FileReader();fr.onload=function(){res(fr.result);};fr.onerror=rej;fr.readAsDataURL(file);});}
async function loadModule(){try{var r=await fetch('api/admin/modules');var d=await r.json();var mod=(d.modules||[]).find(function(m){return m.key===MODULE_KEY;});FIELDS=mod?mod.fields:[];await loadItems();}catch(e){document.getElementById('tableWrap').innerHTML='<p class="admin-empty">Erreur de chargement.</p>';}}
async function loadItems(){var r=await fetch('api/admin/'+MODULE_KEY);var d=await r.json();ITEMS=d[MODULE_KEY]||[];renderTable();}
function tableCols(){return FIELDS.filter(function(f){return ['text','select','number','boolean','date','email','url'].indexOf(f.type)!==-1;}).slice(0,4);}
function renderTable(){var q=(document.getElementById('searchBox').value||'').toLowerCase();var cols=tableCols();var rows=ITEMS;if(q){rows=rows.filter(function(it){return Object.keys(it).some(function(k){return String(it[k]==null?'':it[k]).toLowerCase().indexOf(q)!==-1;});});}var rc=document.getElementById('resultCount');if(rc){rc.textContent=rows.length+' '+(rows.length>1?'éléments':'élément');}var h='<table class="admin-table"><thead><tr>';cols.forEach(function(c){h+='<th>'+esc(c.label||c.name)+'</th>';});h+='<th style="text-align:right">Actions</th></tr></thead><tbody>';if(!rows.length){h+='<tr><td colspan="'+(cols.length+1)+'"><div class="admin-empty"><p>Aucun élément pour le moment.</p><button class="btn btn-primary btn-sm" style="margin-top:.7rem" onclick="openCreate()">+ Ajouter '+esc(MODULE_LABEL)+'</button></div></td></tr>';}rows.forEach(function(it){h+='<tr>';cols.forEach(function(c){var v=it[c.name];if(c.name==='status'&&v){h+='<td><span class="badge b-'+esc(String(v).replace(/\s/g,'-'))+'">'+esc(v)+'</span></td>';return;}if(c.type==='boolean'){v=(v==1||v===true||v==='1')?'Oui':'Non';}else if(c.type==='date'&&v){v=new Date(v).toLocaleDateString('fr-CA');}else{v=v==null?'':String(v);if(v.length>54)v=v.slice(0,54)+'…';}h+='<td>'+esc(v)+'</td>';});h+='<td class="admin-actions"><button class="btn-mini" onclick="editItem('+it.id+')">Modifier</button> <button class="btn-mini danger" onclick="delItem('+it.id+')">Supprimer</button></td></tr>';});h+='</tbody></table>';document.getElementById('tableWrap').innerHTML=h;}
function fieldRow(f,val){var row=document.createElement('div');row.className='admin-field';var lab=document.createElement('label');lab.textContent=(f.label||f.name)+(f.required?' *':'');row.appendChild(lab);if(f.type==='image'){var hidden=document.createElement('input');hidden.type='text';hidden.className='admin-input';hidden.value=val==null?'':val;hidden.placeholder='Adresse de l’image';hidden.setAttribute('data-field',f.name);var prev=document.createElement('img');prev.className='admin-img-prev';if(val){prev.src=val;}else{prev.style.display='none';}hidden.addEventListener('input',function(){if(hidden.value){prev.src=hidden.value;prev.style.display='block';}else{prev.style.display='none';}});var btns=document.createElement('div');btns.className='admin-img-btns';var file=document.createElement('input');file.type='file';file.accept='image/*';file.style.display='none';var up=document.createElement('button');up.type='button';up.className='btn btn-light btn-sm';up.textContent='Téléverser';up.addEventListener('click',function(){file.click();});file.addEventListener('change',async function(){var ff=file.files[0];if(!ff)return;up.textContent='Envoi…';try{var du=await toDataUri(ff);var r=await fetch('api/admin/upload',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({dataUri:du})});var d=await r.json();if(d.url){hidden.value=d.url;prev.src=d.url;prev.style.display='block';showToast('Image téléversée','ok');}else{showToast(d.error||'Échec','err');}}catch(e){showToast('Échec du téléversement','err');}up.textContent='Téléverser';});var ai=document.createElement('button');ai.type='button';ai.className='btn btn-light btn-sm';ai.textContent='Générer (IA)';ai.addEventListener('click',async function(){var p=prompt('Décrivez l’image à générer :');if(!p)return;ai.textContent='Génération…';try{var r=await fetch('api/admin/generate-image',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({prompt:p,aspectRatio:'4:3'})});var d=await r.json();if(d.imageUrl){hidden.value=d.imageUrl;prev.src=d.imageUrl;prev.style.display='block';showToast('Image générée','ok');}else{showToast(d.error||'Échec','err');}}catch(e){showToast('Échec de la génération','err');}ai.textContent='Générer (IA)';});btns.appendChild(up);btns.appendChild(ai);btns.appendChild(file);row.appendChild(hidden);row.appendChild(prev);row.appendChild(btns);if(f.description){var hd=document.createElement('small');hd.className='admin-help';hd.textContent=f.description;row.appendChild(hd);}return row;}var input;if(f.type==='textarea'){input=document.createElement('textarea');input.rows=4;input.value=val==null?'':val;}else if(f.type==='boolean'){input=document.createElement('input');input.type='checkbox';input.className='admin-check';input.checked=(val==1||val===true||val==='1');}else if(f.type==='select'){input=document.createElement('select');if(!f.required){var b0=document.createElement('option');b0.value='';b0.textContent='—';input.appendChild(b0);}(f.options||[]).forEach(function(o){var op=document.createElement('option');op.value=o;op.textContent=o;if(String(val)===String(o))op.selected=true;input.appendChild(op);});}else if(f.type==='number'){input=document.createElement('input');input.type='number';if(f.step)input.step=f.step;if(f.min!=null)input.min=f.min;if(f.max!=null)input.max=f.max;input.value=val==null?'':val;}else{input=document.createElement('input');input.type=(f.type==='email'?'email':(f.type==='url'?'url':(f.type==='date'?'date':'text')));input.value=val==null?'':val;}if(f.type!=='boolean')input.className='admin-input';if(f.placeholder&&input.tagName!=='SELECT')input.placeholder=f.placeholder;input.setAttribute('data-field',f.name);row.appendChild(input);if(f.description){var hh=document.createElement('small');hh.className='admin-help';hh.textContent=f.description;row.appendChild(hh);}return row;}
function buildForm(item){var w=document.getElementById('formFields');w.innerHTML='';FIELDS.forEach(function(f){var val=item?item[f.name]:(f.default!==undefined?f.default:'');w.appendChild(fieldRow(f,val));});}
function openModal(item){document.getElementById('modalTitle').textContent=(item?'Modifier · ':'Nouveau · ')+MODULE_LABEL;buildForm(item);document.getElementById('modal').classList.add('open');}
function closeModal(){document.getElementById('modal').classList.remove('open');}
function openCreate(){EDIT_ID=null;openModal(null);}
function editItem(id){var it=ITEMS.find(function(x){return x.id===id;});if(!it)return;EDIT_ID=id;openModal(it);}
async function delItem(id){if(!confirm('Supprimer cet élément ? Cette action est définitive.'))return;try{var r=await fetch('api/admin/'+MODULE_KEY+'/'+id,{method:'DELETE'});if(r.ok){await loadItems();showToast('Élément supprimé','ok');}else{showToast('Erreur lors de la suppression','err');}}catch(e){showToast('Erreur de connexion','err');}}
async function saveItem(e){e.preventDefault();var data={};FIELDS.forEach(function(f){var el=document.querySelector('[data-field="'+f.name+'"]');if(!el)return;if(f.type==='boolean')data[f.name]=el.checked?1:0;else if(f.type==='number')data[f.name]=el.value===''?null:Number(el.value);else data[f.name]=el.value;});var wasEdit=!!EDIT_ID;var method=EDIT_ID?'PUT':'POST';var url='api/admin/'+MODULE_KEY+(EDIT_ID?('/'+EDIT_ID):'');try{var r=await fetch(url,{method:method,headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});if(r.ok){closeModal();await loadItems();showToast(wasEdit?'Modifications enregistrées':'Élément ajouté','ok');}else{var d=await r.json().catch(function(){return {};});showToast(d.error||'Erreur','err');}}catch(e2){showToast('Erreur de connexion','err');}}
document.getElementById('btnNew').addEventListener('click',openCreate);
document.getElementById('modalClose').addEventListener('click',closeModal);
document.getElementById('cancelBtn').addEventListener('click',closeModal);
document.getElementById('itemForm').addEventListener('submit',saveItem);
document.getElementById('searchBox').addEventListener('input',renderTable);
document.getElementById('modal').addEventListener('click',function(e){if(e.target===this)closeModal();});
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeModal();});
document.getElementById('adminBurger').addEventListener('click',function(){document.querySelector('.admin-sidebar').classList.toggle('open');});
loadModule();
</script>
</body>
</html>