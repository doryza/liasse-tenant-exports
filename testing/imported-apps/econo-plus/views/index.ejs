<%- include('partials/header') %>
<% const H=typeof home!=='undefined'?home:lang,term=typeof q!=='undefined'?q:'',selected=typeof category!=='undefined'?category:'',ready=typeof contactReady!=='undefined'&&contactReady;const hasPublishedCatalogue=typeof availableCategories!=='undefined'&&Array.isArray(availableCategories)&&availableCategories.length>0;const link=typeof galleryUrl==='function'?galleryUrl:function(){return H+'#liquidations';};const value=typeof field==='function'?field:function(row,key){return row[lang==='en'?key+'_en':key]||'';};const money=typeof formatPrice==='function'?formatPrice:function(v){return new Intl.NumberFormat(lang==='en'?'en-CA':'fr-CA',{style:'currency',currency:'CAD'}).format(Number(v));}; %>
<main id="main" tabindex="-1"><section class="hero wrap" id="accueil" data-section><div class="hero-copy"><p class="eyebrow" <%= lang==='fr'?'data-setting-key=tagline':'data-setting-key=text_tagline_en' %>><%= t.tagline %></p><h1 <%= lang==='fr'?'data-setting-key=hero_title':'data-setting-key=text_hero_title_en' %>><%= t.hero_title %></h1><p class="hero-subtitle" <%= lang==='fr'?'data-setting-key=hero_subtitle':'data-setting-key=text_hero_subtitle_en' %>><%= t.hero_subtitle %></p><div class="actions"><a class="btn btn-yellow" style="background-color:#ffdd22;color:#132b63" href="<%= H %>#liquidations" data-lk="t:browse"><%= t.browse %><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a><a class="text-link" href="<%= H %>#nous-trouver" data-lk="t:find"><%= t.find %></a></div></div><figure class="hero-figure"><img src="<%= settings._p_hero_image_url||'public/images/appliance.svg' %>" data-setting-key="_p_hero_image_url" alt="<%= t.hero_alt %>" width="1000" height="1000" fetchpriority="high"><figcaption data-lk="<%= settings.hero_real==='true'?'t:real_photo':'t:illustration' %>"><%= settings.hero_real==='true'?t.real_photo:t.illustration %></figcaption></figure></section>
<div class="wrap"><div class="offer-band"><% if(typeof featured!=='undefined'&&featured){ %><div><p data-lk="t:featured_offer"><%= t.featured_offer %></p><h2 data-content-source="products:<%= lang==='en'?'title_en':'title' %>" data-content-id="<%= featured.id %>"><%= value(featured,'title') %></h2></div><div class="offer-price"><strong data-content-source="products:price" data-content-id="<%= featured.id %>"><%= money(featured.price) %></strong><a href="<%= H %>/appareils/<%= featured.id %>" data-lk="t:offer_view"><%= t.offer_view %><span aria-hidden="true"> →</span></a></div><% }else{ %><h2 data-lk="t:in_store"><%= t.in_store %></h2><a href="<%= H %>#liquidations" data-lk="t:browse"><%= t.browse %><span aria-hidden="true"> ↓</span></a><% } %></div></div>
<section class="catalogue wrap section-space" id="liquidations" data-section><div class="section-heading"><h2 data-lk="t:gallery_title"><%= t.gallery_title %></h2><% if(hasPublishedCatalogue){ %><p data-lk="t:gallery_intro"><%= t.gallery_intro %></p><% } %></div>
<% if(hasPublishedCatalogue){ %><nav class="category-nav" aria-label="<%= t.category %>"><a class="<%= !selected?'active':'' %>" href="<%= link('') %>" aria-current="<%= !selected?'true':'false' %>" data-lk="t:all"><%= t.all %></a><% availableCategories.forEach(function(c){ %><a class="<%= selected===c.category?'active':'' %>" href="<%= link(c.category) %>" aria-current="<%= selected===c.category?'true':'false' %>" data-lk="t:<%= c.category %>"><%= t[c.category] %></a><% }); %></nav><form class="search-form" action="<%= H %>#liquidations" method="get"><label for="product-search" data-lk="t:search_label"><%= t.search_label %></label><div><input id="product-search" type="search" name="q" value="<%= term %>" maxlength="100" placeholder="<%= t.search_placeholder %>"><input type="hidden" name="category" value="<%= selected %>"><button type="submit" class="btn" style="background-color:#2858ef;color:#fff" data-lk="t:search"><%= t.search %></button></div></form><% if(term||selected){ %><a class="filter-reset" href="<%= H %>#liquidations" data-lk="t:clear"><%= t.clear %></a><% } %><% }else{ %><% if(ready){ %><p class="availability-note" data-lk="t:confirm_availability"><%= t.confirm_availability %></p><% } %><% } %>
<% if(typeof products!=='undefined'&&products.length){ %><div class="product-grid"><% products.forEach(function(p){ %><article class="product-card"><a href="<%= H %>/appareils/<%= p.id %>" class="product-image-link" data-open-product="product-template-<%= p.id %>" aria-label="<%= t.view+' : '+value(p,'title') %>"><img src="<%= p.image_url %>" data-content-source="products:image_url" data-content-id="<%= p.id %>" alt="<%= value(p,'title') %>" width="800" height="600" loading="lazy"></a><div class="product-copy"><p class="category-label" data-content-source="products:category" data-content-id="<%= p.id %>"><%= t[p.category] %></p><h3 data-content-source="products:<%= lang==='en'?'title_en':'title' %>" data-content-id="<%= p.id %>"><%= value(p,'title') %></h3><% if(p.price!=null){ %><p class="price" data-content-source="products:price" data-content-id="<%= p.id %>"><%= money(p.price) %></p><% }else{ %><p data-lk="t:price_request"><%= t.price_request %></p><% } %><p class="condition-line" data-content-source="products:<%= lang==='en'?'condition_en':'condition' %>" data-content-id="<%= p.id %>"><%= value(p,'condition')||t.not_provided %></p><a href="<%= H %>/appareils/<%= p.id %>" class="btn" style="background-color:#2858ef;color:#fff" data-open-product="product-template-<%= p.id %>" data-lk="t:view"><%= t.view %><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a></div></article><template id="product-template-<%= p.id %>"><%- include('partials/appliance',{product:p}) %></template><% }); %></div><div class="catalogue-foot"><p data-lk="t:currency_note"><%= t.currency_note %></p><p data-lk="t:confirm_availability"><%= t.confirm_availability %></p></div><% }else{ %><div class="empty-catalogue"><div><h3 data-lk="<%= term||selected?'t:no_results':'t:empty_title' %>"><%= term||selected?t.no_results:t.empty_title %></h3><p data-lk="<%= term||selected?'t:no_results_body':'t:empty_body' %>"><%= term||selected?t.no_results_body:t.empty_body %></p></div><% if(term||selected){ %><a href="<%= H %>#liquidations" class="btn" style="background-color:#2858ef;color:#fff" data-lk="t:clear"><%= t.clear %></a><% }else if(ready&&typeof phoneHref!=='undefined'){ %><a href="<%= phoneHref %>" class="btn" style="background-color:#2858ef;color:#fff" data-lk="t:call"><%= t.call %></a><% }else{ %><a href="<%= H %>/magasin" class="btn" style="background-color:#2858ef;color:#fff" data-lk="t:contact_info"><%= t.contact_info %></a><% } %></div><% } %>
<% if(typeof pages!=='undefined'&&pages>1&&typeof page!=='undefined'){ %><nav class="pagination" aria-label="<%= t.page %>"><% if(page>1){ %><a class="btn btn-outline" href="<%= link(selected,page-1) %>" data-lk="t:previous"><%= t.previous %></a><% } %><span data-lk="t:page"><%= t.page %> <%= page %> <%= t.of %> <%= pages %></span><% if(page<pages){ %><a class="btn btn-outline" href="<%= link(selected,page+1) %>" data-lk="t:next"><%= t.next %></a><% } %></nav><% } %></section>
<section class="local-band" id="visite" data-section><div class="wrap local-layout"><div><h2 data-lk="t:local_title"><%= t.local_title %></h2><p <%= lang==='fr'?'data-setting-key=about_text':'data-setting-key=text_about_text_en' %>><%= t.about_text %></p><a class="btn" style="background-color:#2858ef;color:#fff" href="<%= H %>/magasin" data-lk="t:local_link"><%= t.local_link %></a></div><% if(settings._p_store_image_url&&settings.store_real==='true'){ %><img src="<%= settings._p_store_image_url %>" data-setting-key="_p_store_image_url" alt="<%= t.real_photo %>" width="1000" height="750" loading="lazy"><% }else{ %><div class="visit-note"><h3 data-lk="t:find"><%= t.find %></h3><p data-lk="t:confirm_availability"><%= t.confirm_availability %></p><% if(ready&&typeof phoneHref!=='undefined'){ %><a class="local-phone" href="<%= phoneHref %>" data-setting-key="contact_phone"><%= settings.contact_phone %></a><% }else{ %><a class="text-link" href="<%= H %>/magasin" data-lk="t:contact_info"><%= t.contact_info %></a><% } %></div><% } %></div></section><%- include('partials/location') %></main>
<dialog id="product-dialog" class="product-dialog" aria-label="<%= t.view %>"><button type="button" class="dialog-close btn btn-outline" data-close-product data-lk="t:close"><%= t.close %><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button><div id="product-dialog-content"></div></dialog><%- include('partials/footer') %>