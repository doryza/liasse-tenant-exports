<%- include('partials/header',{adminPage:true}) %><div class="admin-layout"><%- include('partials/admin-sidebar') %><main id="main" class="admin-main" tabindex="-1"><div class="admin-heading"><div><p class="admin-eyebrow"><%= t.workspace %></p><h1><%= t.settings %></h1></div><a class="btn btn-outline" href="<%= typeof home!=='undefined'?home:lang %>/magasin" target="_blank" rel="noopener"><%= t.view_site %> ↗</a></div><p class="admin-lead"><%= t.settings_intro %></p>
<div id="settings-app" data-state="<%= JSON.stringify({fields:typeof fields!=='undefined'?fields:[],settings,t,lang}) %>"><div class="settings-overview"><span id="contact-state" class="status-label <%= settings.contact_verified==='true'?'live':'' %>"><%= settings.contact_verified==='true'?t.contact_state_live:t.contact_state_hidden %></span><p id="settings-status" role="status" aria-live="polite"><%= t.up_to_date %></p></div>
<% if(typeof fields!=='undefined'&&fields.length){ %><nav class="settings-nav" aria-label="<%= t.settings %>"><% [['contact',t.contact_group],['media',t.media_group],['copy',t.copy_group]].forEach(function(g){ %><a href="admin/settings#settings-<%= g[0] %>"><%= g[1] %></a><% }); %></nav>
<% [['contact',t.contact_group],['media',t.media_group],['copy',t.copy_group]].forEach(function(g){ %><section class="admin-panel settings-section" id="settings-<%= g[0] %>"><h2><%= g[1] %></h2><% fields.filter(function(f){return (f.group||'copy')===g[0];}).forEach(function(f){ %><form method="post" action="api/admin/settings" class="setting-row" data-setting-form="<%= f.name %>"><div><label for="setting-<%= f.name %>"><%= f.label %></label><p class="field-help" id="help-<%= f.name %>"><%= f.description %></p></div><div class="setting-control"><% if(f.type==='boolean'){ %><input id="setting-<%= f.name %>" name="value" type="checkbox" aria-describedby="help-<%= f.name %>" <%= settings[f.name]==='true'?'checked':'' %>><% }else if(f.type==='textarea'){ %><textarea id="setting-<%= f.name %>" name="value" rows="3" maxlength="12000" aria-describedby="help-<%= f.name %>" placeholder="<%= f.placeholder||'' %>"><%= settings[f.name]||'' %></textarea><% }else{ %><input id="setting-<%= f.name %>" name="value" type="<%= f.type==='image'?'url':f.type==='email'?'email':f.name==='contact_phone'?'tel':'text' %>" maxlength="12000" aria-describedby="help-<%= f.name %>" value="<%= settings[f.name]||'' %>" placeholder="<%= f.placeholder||'' %>"><% } %><% if(f.type==='image'){ %><div data-image-tools="<%= f.name %>"></div><% } %></div><input type="hidden" name="key" value="<%= f.name %>"><button class="btn" type="submit" style="background-color:var(--admin-brand,#2858ef);color:#fff"><%= t.save %></button><p class="setting-message feedback" role="status" aria-live="polite"></p></form><% }); %></section><% }); %><% }else{ %><p role="alert"><%= t.network_error %></p><% } %><noscript><p><%= t.no_script %></p></noscript></div></main></div><script src="public/js/admin.js" defer></script><%- include('partials/footer',{adminPage:true}) %>