<%- include('partials/header',{adminPage:true}) %>
<% const s=typeof stats!=='undefined'&&stats?stats:{}; const recentRows=typeof recent!=='undefined'&&Array.isArray(recent)?recent:[]; const ready=typeof contactReady!=='undefined'&&contactReady; %>
<div class="admin-layout"><%- include('partials/admin-sidebar') %><main id="main" class="admin-main" tabindex="-1"><div class="admin-heading"><div><p class="admin-eyebrow"><%= t.overview %></p><h1><%= t.dashboard %></h1></div><a href="admin/products?new=1" class="btn" style="background-color:var(--admin-brand,#2858ef);color:#fff"><span aria-hidden="true">＋</span><%= t.new_product %></a></div><p class="admin-lead"><%= t.admin_intro %></p>
<div class="stat-grid"><% [['productsLive',t.live_products],['productsDraft',t.draft_products],['recentVisits',t.recent_visits],['totalVisits',t.total_visits],['userCount',t.users],['pushSubscriberCount',t.subscribers]].forEach(function(pair){ %><div class="stat"><span><%= pair[1] %></span><strong><%= s[pair[0]]==null?'—':s[pair[0]] %></strong></div><% }); %></div><p class="field-help"><%= t.visit_note %></p>
<section class="module-grid" aria-label="<%= t.manage %>"><% [{key:'products',title:t.products,description:t.catalogue_help,icon:'▦'},{key:'posts',title:t.posts,description:t.posts_help,icon:'✎'},{key:'settings',title:t.settings,description:t.settings_help,icon:'⚙'}].forEach(function(m){ %><article class="module-card"><div class="module-card-top"><span class="module-icon" aria-hidden="true"><%= m.icon %></span><% if(m.key!=='settings'){ %><span class="count-pill"><%= s[m.key]==null?'—':s[m.key] %></span><% } %></div><h2><%= m.title %></h2><p><%= m.description %></p><a class="module-link" href="admin/<%= m.key %>"><%= t.manage %><span class="sr-only"> · <%= m.title %></span><span aria-hidden="true"> →</span></a></article><% }); %></section>
<div class="dashboard-columns"><section class="admin-panel"><div class="panel-heading"><h2><%= t.next_steps %></h2></div><div class="check-row"><span class="check-dot <%= ready?'complete':'' %>" aria-hidden="true"><%= ready?'✓':'!' %></span><div><strong><%= t.contact_info %></strong><p><%= ready?t.contact_done:t.setup_warning %></p><a href="admin/settings"><%= t.confirm_settings %></a></div></div><div class="check-row"><span class="check-dot" aria-hidden="true">▦</span><div><strong><%= t.review_drafts %></strong><p><%= t.photos_pending %>: <%= s.photosPending==null?'—':s.photosPending %> · <%= t.facts_pending %>: <%= s.factsPending==null?'—':s.factsPending %></p><a href="admin/products?status=draft"><%= t.review_drafts %></a></div></div><p class="admin-notice compact"><%= t.draft_notice %></p></section>
<section class="admin-panel"><div class="panel-heading"><h2><%= t.recent_activity %></h2><a href="admin/products"><%= t.products %></a></div><% if(recentRows.length){ %><ul class="recent-list"><% recentRows.forEach(function(p){ %><li><div><a href="admin/products?edit=<%= p.id %>"><%= lang==='en'?(p.title_en||p.title):p.title %></a><span class="status-label <%= p.published&&p.facts_verified&&p.photos_verified?'live':'' %>"><%= p.published&&p.facts_verified&&p.photos_verified?t.published_label:t.draft %></span></div><span class="muted"><%= formatDate(p.updated_at) %></span></li><% }); %></ul><% }else{ %><div class="admin-empty"><p><%= t.no_activity %></p><a class="btn" style="background-color:var(--admin-brand,#2858ef);color:#fff" href="admin/products?new=1"><%= t.new_product %></a></div><% } %></section></div></main></div><%- include('partials/footer',{adminPage:true}) %>