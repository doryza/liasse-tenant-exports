<% const applianceHome=typeof home!=='undefined'?home:lang;const getValue=typeof field==='function'?field:function(row,key){return row[lang==='en'?key+'_en':key]||'';};const priceText=typeof formatPrice==='function'?formatPrice:function(v){return new Intl.NumberFormat(lang==='en'?'en-CA':'fr-CA',{style:'currency',currency:'CAD'}).format(Number(v));}; %><% if(typeof product!=='undefined'&&product){ %><article class="appliance-detail"><div class="appliance-photos"><% if(product.image_url){ %><img src="<%= product.image_url %>" data-content-source="products:image_url" data-content-id="<%= product.id %>" alt="<%= getValue(product,'title') %>" width="1000" height="750"><% }else{ %><p data-lk="t:photo_missing"><%= t.photo_missing %></p><% } %><% if(product.image_url_2){ %><img src="<%= product.image_url_2 %>" data-content-source="products:image_url_2" data-content-id="<%= product.id %>" alt="<%= getValue(product,'title') %>" width="1000" height="750" loading="lazy"><% } %></div><div class="appliance-info"><p class="category-label" data-content-source="products:category" data-content-id="<%= product.id %>"><%= t[product.category] %></p><h2 class="appliance-title" data-content-source="products:<%= lang==='en'?'title_en':'title' %>" data-content-id="<%= product.id %>"><%= getValue(product,'title') %></h2><% if(product.price!=null){ %><p class="detail-price" data-content-source="products:price" data-content-id="<%= product.id %>"><%= priceText(product.price) %></p><% }else{ %><p data-lk="t:price_request"><%= t.price_request %></p><% } %><% if(product.price!=null&&product.previous_price!=null&&product.comparison_evidence&&Number(product.previous_price)>Number(product.price)){ %><p class="previous-price"><span data-lk="t:previous_price"><%= t.previous_price %></span> <del data-content-source="products:previous_price" data-content-id="<%= product.id %>"><%= priceText(product.previous_price) %></del></p><% } %><% if(getValue(product,'price_note')){ %><p data-content-source="products:<%= lang==='en'?'price_note_en':'price_note' %>" data-content-id="<%= product.id %>"><%= getValue(product,'price_note') %></p><% } %><div class="call-panel" style="margin-block:24px"><p data-lk="t:confirm_availability"><%= t.confirm_availability %></p><% if(typeof contactReady!=='undefined'&&contactReady&&typeof phoneHref!=='undefined'){ %><a class="btn" style="background-color:#2858ef;color:#fff" href="<%= phoneHref %>" data-lk="t:call_product"><%= t.call_product %></a><% }else{ %><a class="btn" style="background-color:#2858ef;color:#fff" href="<%= applianceHome %>/magasin" data-lk="t:contact_info"><%= t.contact_info %></a><% } %></div><% if(getValue(product,'description')){ %><p class="preserve-lines" data-content-source="products:<%= lang==='en'?'description_en':'description' %>" data-content-id="<%= product.id %>"><%= getValue(product,'description') %></p><% } %><dl class="specifications"><% ['reference','condition','dimensions','defects'].forEach(function(key){const v=key==='reference'?product.reference:getValue(product,key); %><div><dt data-lk="t:<%= key %>"><%= t[key] %></dt><% if(v){ %><dd data-content-source="products:<%= key==='reference'||lang==='fr'?key:key+'_en' %>" data-content-id="<%= product.id %>"><%= v %></dd><% }else{ %><dd data-lk="t:not_provided"><%= t.not_provided %></dd><% } %></div><% }); %></dl><a class="full-page-link" href="<%= applianceHome %>/appareils/<%= product.id %>" data-lk="t:full_page"><%= t.full_page %></a></div></article><% }else{ %><div class="empty-catalogue"><div><h2 data-lk="t:unavailable_title"><%= t.unavailable_title %></h2><p data-lk="t:unavailable_body"><%= t.unavailable_body %></p></div><a class="btn" style="background-color:#2858ef;color:#fff" href="<%= applianceHome %>#liquidations" data-lk="t:back_gallery"><%= t.back_gallery %></a></div><% } %>