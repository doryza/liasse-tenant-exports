<% const active=typeof activeAdmin!=='undefined'?activeAdmin:''; %><aside class="admin-sidebar"><details open><summary><%= t.admin_menu %></summary><p class="sidebar-caption"><%= t.workspace %></p><nav aria-label="<%= t.admin_menu %>"><% [['admin',t.dashboard,'◫'],['admin/products',t.products,'▦'],['admin/posts',t.posts,'✎'],['admin/settings',t.settings,'⚙']].forEach(function(link){const selected=active==='/'+link[0]; %><a href="<%= link[0] %>" <%= selected?'aria-current=page':'' %> style="<%= selected?'background-color:var(--admin-brand,#2858ef);color:#fff':'' %>"><span aria-hidden="true"><%= link[2] %></span><%= link[1] %></a><% }); %><div class="sidebar-divider"></div><a href="." target="_blank" rel="noopener"><span aria-hidden="true">↗</span><%= t.view_site %></a><a href="admin/logout"><span aria-hidden="true">↪</span><%= t.logout %></a></nav></details></aside>