<% const m=typeof module!=='undefined'&&module?module:null; const list=typeof items!=='undefined'&&Array.isArray(items)?items:[]; %><% if(m){ %><div id="admin-app" data-state="<%= JSON.stringify({items:list,module:m,t,lang}) %>"><div class="admin-heading"><div><p class="admin-eyebrow"><%= t.workspace %></p><h1><%= m.label %></h1></div><button type="button" id="create-entry" class="btn" style="background-color:var(--admin-brand,#2858ef);color:#fff"><span aria-hidden="true">＋</span><%= m.key==='products'?t.new_product:t.new_post %></button></div><p class="admin-lead"><%= m.key==='products'?t.catalogue_help:t.posts_help %></p><div class="admin-notice"><%= m.key==='products'?t.draft_notice:t.posts_notice %></div><div class="list-summary" id="list-summary"></div>
<div class="admin-panel catalogue-panel"><div class="admin-toolbar"><label for="admin-filter"><%= t.filter %><input id="admin-filter" type="search" maxlength="200" placeholder="<%= t.record_search %>"></label><label for="admin-status-filter"><%= t.status %><select id="admin-status-filter"><option value=""><%= t.all_status %></option><option value="live"><%= m.key==='products'?t.published_label:t.ready_post %></option><option value="draft"><%= t.draft %></option><% if(m.key==='products'){ %><option value="review"><%= t.review %></option><% } %></select></label><label for="admin-category"><%= t.category %><select id="admin-category"><option value=""><%= t.all_categories %></option></select></label><label for="admin-sort"><%= t.sort %><select id="admin-sort"><option value="recent"><%= t.newest %></option><option value="title"><%= t.alphabetical %></option></select></label><button type="button" class="small-btn" id="reset-filters"><%= t.reset %></button><button type="button" class="small-btn" id="refresh-entries"><%= t.refresh %></button></div><div class="list-meta"><p id="admin-result-count" role="status"></p><p id="admin-status" class="feedback" role="status" aria-live="polite"></p></div>
<div class="admin-table-wrap" tabindex="0" role="region" aria-label="<%= m.label %>"><table><caption class="sr-only"><%= m.label %></caption><thead><tr><th scope="col"><%= t.title %></th><th scope="col"><%= t.category %></th><th scope="col"><%= m.key==='products'?t.price:t.updated %></th><th scope="col"><%= t.status %></th><th scope="col"><%= t.actions %></th></tr></thead><tbody id="admin-rows"><% if(list.length){list.slice(0,10).forEach(function(p){ %><tr><td><strong><%= lang==='en'?(p.title_en||p.title):p.title %></strong></td><td><%= t[p.category]||p.category||'—' %></td><td><%= m.key==='products'?(p.price==null?t.price_request:(typeof formatPrice==='function'?formatPrice(p.price):p.price)):formatDate(p.updated_at) %></td><td><%= p.published?(m.key==='products'?t.published_label:t.ready_post):t.draft %></td><td><button type="button" class="small-btn" data-edit="<%= p.id %>"><%= t.edit %></button><button type="button" class="small-btn danger" data-delete="<%= p.id %>"><%= t.delete %></button></td></tr><% });}else{ %><tr><td colspan="5"><%= t.empty_admin %></td></tr><% } %></tbody></table></div><div class="admin-pagination"><button class="small-btn" id="admin-prev" type="button" disabled><%= t.previous %></button><span id="admin-page-count"></span><button class="small-btn" id="admin-next" type="button" disabled><%= t.next %></button></div></div>
<dialog class="admin-dialog" id="entry-dialog" aria-labelledby="entry-heading" aria-describedby="entry-hint"><form id="entry-form" method="post" action="api/admin/<%= m.key %>"><div class="dialog-heading"><div><h2 id="entry-heading"><%= t.edit %></h2><p id="entry-hint" class="field-help"><%= t.required_hint %></p></div><button type="button" class="small-btn" id="cancel-entry"><%= t.cancel %></button></div><div class="dialog-body"><p id="entry-meta" class="field-help"></p><div id="entry-fields"></div><div id="publish-readiness" class="admin-notice compact" role="status"></div><p id="entry-error" class="feedback" role="alert" tabindex="-1"></p></div><div class="dialog-actions"><span id="entry-dirty" class="field-help"></span><button type="submit" class="btn" id="save-entry" style="background-color:var(--admin-brand,#2858ef);color:#fff"><%= t.save %></button></div></form></dialog><noscript><p><%= t.no_script %></p></noscript></div><% }else{ %><div class="admin-empty"><p><%= t.network_error %></p><a href="admin"><%= t.dashboard %></a></div><% } %>