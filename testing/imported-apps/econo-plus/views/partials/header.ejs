<% const headerHome=typeof home!=='undefined'?home:lang; const headerAdmin=typeof adminPage!=='undefined'&&adminPage; const languageLinks=typeof langLinks!=='undefined'?langLinks:{fr:'fr',en:'en'};const heading=typeof pageTitle!=='undefined'?pageTitle:t.site_title; %><!DOCTYPE html><html lang="<%= typeof lang!=='undefined'?lang:'fr' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#2858EF"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="description" content="<%= t.hero_subtitle %>"><title><%= heading %></title><% if(headerAdmin||(typeof noIndex!=='undefined'&&noIndex)){ %><meta name="robots" content="noindex,nofollow"><% }else{ %><meta property="og:type" content="website"><meta property="og:title" content="<%= heading %>"><meta property="og:description" content="<%= t.hero_subtitle %>"><meta property="og:locale" content="<%= lang==='en'?'en_CA':'fr_CA' %>"><meta name="twitter:card" content="summary_large_image"><% if(typeof canonicalUrl!=='undefined'&&canonicalUrl){ %><link rel="canonical" href="<%= canonicalUrl %>"><meta property="og:url" content="<%= canonicalUrl %>"><% } %><% if(settings._p_hero_image_url&&/^https:\/\//i.test(settings._p_hero_image_url)){ %><meta property="og:image" content="<%= settings._p_hero_image_url %>"><% } %><% } %><link rel="manifest" href="manifest.json"><link rel="icon" href="icon.png"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="public/css/styles.css"><% if(headerAdmin){ %><link rel="stylesheet" href="public/css/admin-styles.css"><% } %><script src="public/js/app.js" defer></script></head>
<body class="<%= headerAdmin?'admin-page':'public-page' %>"><a class="skip-link" href="<%= typeof skipHref!=='undefined'?skipHref:headerHome+'#main' %>" data-lk="t:skip"><%= t.skip %></a><header class="site-header"><div class="header-inner"><a class="wordmark" href="<%= headerHome %>" aria-label="Écono Plus"><span data-lk="t:brand_econo"><%= t.brand_econo %></span><span data-lk="t:brand_plus"><%= t.brand_plus %></span></a><nav class="main-nav" id="main-nav" aria-label="<%= t.menu %>"><a href="<%= headerHome %>#liquidations" data-lk="t:nav_clearance"><%= t.nav_clearance %></a><a href="<%= headerHome %>#nous-trouver" data-lk="t:nav_store"><%= t.nav_store %></a><% if(typeof contactReady!=='undefined'&&contactReady&&typeof phoneHref!=='undefined'){ %><a class="header-phone" href="<%= phoneHref %>" data-setting-key="contact_phone"><%= settings.contact_phone %></a><% }else{ %><a href="<%= headerHome %>/magasin" data-lk="t:contact_info"><%= t.contact_info %></a><% } %></nav><div class="languages"><a href="<%= languageLinks.fr %>" data-language="fr" lang="fr" aria-current="<%= lang==='fr'?'true':'false' %>" data-lk="t:language_fr"><%= t.language_fr %></a><span aria-hidden="true">|</span><a href="<%= languageLinks.en %>" data-language="en" lang="en" aria-current="<%= lang==='en'?'true':'false' %>" data-lk="t:language_en"><%= t.language_en %></a></div><button class="menu-toggle" type="button" aria-label="<%= t.menu %>" aria-controls="main-nav" aria-expanded="false" data-lk="t:menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg><span><%= t.menu %></span></button></div></header>
<script>(function(){const b=document.querySelector('.menu-toggle'),n=document.getElementById('main-nav');if(b&&n){b.addEventListener('click',function(){const open=b.getAttribute('aria-expanded')!=='true';b.setAttribute('aria-expanded',String(open));n.classList.toggle('open',open);});n.addEventListener('click',function(e){if(e.target.closest('a')){n.classList.remove('open');b.setAttribute('aria-expanded','false');}});document.addEventListener('keydown',function(e){if(e.key==='Escape'&&n.classList.contains('open')){n.classList.remove('open');b.setAttribute('aria-expanded','false');b.focus();}});}const update=function(hash){document.querySelectorAll('[data-language]').forEach(function(a){a.setAttribute('href',a.getAttribute('href').split('#')[0]+(hash||''));});};update(location.hash);window.addEventListener('hashchange',function(){update(location.hash);});if('IntersectionObserver' in window)document.addEventListener('DOMContentLoaded',function(){const observer=new IntersectionObserver(function(entries){entries.forEach(function(entry){if(entry.isIntersecting)update('#'+entry.target.id);});},{rootMargin:'-10% 0px -55% 0px'});document.querySelectorAll('section[data-section]').forEach(function(el){observer.observe(el);});});})();</script>