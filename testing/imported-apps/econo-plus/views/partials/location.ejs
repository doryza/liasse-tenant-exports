<% const locationHome=typeof home!=='undefined'?home:lang,locationReady=typeof contactReady!=='undefined'&&contactReady; %><section class="location-band" id="nous-trouver" data-section><div class="wrap location-layout"><div class="location-copy"><h2 data-lk="t:store_title"><%= t.store_title %></h2><% if(locationReady&&typeof phoneHref!=='undefined'&&typeof directionsHref!=='undefined'){ %><div class="contact-block"><h3 data-lk="t:address"><%= t.address %></h3><address data-setting-key="business_address"><%= settings.business_address %></address></div><div class="contact-block"><h3 data-lk="t:telephone"><%= t.telephone %></h3><a class="store-phone" href="<%= phoneHref %>" data-setting-key="contact_phone"><%= settings.contact_phone %></a></div><% if((lang==='fr'&&settings.hours)||(lang==='en'&&settings.text_hours_value_en)){ %><div class="contact-block"><h3 data-lk="t:hours"><%= t.hours %></h3><p class="preserve-lines" data-setting-key="<%= lang==='fr'?'hours':'text_hours_value_en' %>"><%= lang==='fr'?settings.hours:settings.text_hours_value_en %></p></div><% } %><a class="btn btn-yellow" style="background-color:#ffdd22;color:#132b63" href="<%= directionsHref %>" target="_blank" rel="noopener noreferrer" data-lk="t:directions"><%= t.directions %><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></a><% }else{ %><p data-lk="t:contact_pending"><%= t.contact_pending %></p><a class="btn btn-yellow" style="background-color:#ffdd22;color:#132b63" href="<%= locationHome %>#liquidations" data-lk="t:browse"><%= t.browse %></a><% } %></div><div class="map-panel"><h3 data-lk="t:map_title"><%= t.map_title %></h3><% if(locationReady){ %><div class="map-canvas" id="store-map" data-key="<%= typeof googleApiKey!=='undefined'?googleApiKey:'' %>" data-address="<%= settings.business_address %>" data-name="<%= settings.business_name||'Écono Plus' %>" data-lang="<%= lang %>" aria-label="<%= t.map_title %>"><div class="map-placeholder"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg><button class="btn" style="background-color:#2858ef;color:#fff" type="button" id="load-map" data-lk="t:map_load"><%= t.map_load %></button></div></div><p id="map-status" role="status" data-lk="t:map_notice"><%= t.map_notice %></p><% }else{ %><div class="map-unconfigured"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg><p data-lk="t:map_missing"><%= t.map_missing %></p></div><% } %></div></div></section>