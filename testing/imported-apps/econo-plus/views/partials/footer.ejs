<% const footerHome=typeof home!=='undefined'?home:lang,footerReady=typeof contactReady!=='undefined'&&contactReady,footerAdmin=typeof adminPage!=='undefined'&&adminPage,footerLinks=typeof langLinks!=='undefined'?langLinks:{fr:'fr',en:'en'}; %><% if(footerAdmin){ %><footer class="admin-footer"><p><%= t.admin_footer %></p><a href="<%= footerHome %>"><%= t.view_site %> ↗</a></footer><% }else{ %><footer class="site-footer"><div class="wrap footer-grid"><div><a class="wordmark" href="<%= footerHome %>" aria-label="Écono Plus"><span data-lk="t:brand_econo"><%= t.brand_econo %></span><span data-lk="t:brand_plus"><%= t.brand_plus %></span></a><p data-lk="t:footer_line"><%= t.footer_line %></p><% if(footerReady){ %><p class="footer-address" data-setting-key="business_address"><%= settings.business_address %></p><% }else{ %><a href="<%= footerHome %>/magasin" data-lk="t:contact_info"><%= t.contact_info %></a><% } %></div><div class="footer-tools"><button type="button" class="btn btn-yellow" style="background-color:#ffdd22;color:#132b63" data-push-btn data-lk="t:push"><%= t.push %></button><a href="<%= footerHome %>/magasin" data-lk="t:local_link"><%= t.local_link %></a><div class="languages"><a href="<%= footerLinks.fr %>" data-language="fr" lang="fr" data-lk="t:language_fr"><%= t.language_fr %></a><span aria-hidden="true">|</span><a href="<%= footerLinks.en %>" data-language="en" lang="en" data-lk="t:language_en"><%= t.language_en %></a></div><a href="admin" data-lk="t:admin"><%= t.admin %></a></div></div></footer><nav class="mobile-contact" aria-label="<%= t.contact_info %>"><% if(footerReady&&typeof phoneHref!=='undefined'&&typeof directionsHref!=='undefined'){ %><a href="<%= phoneHref %>" style="background-color:#2858ef;color:#fff" data-lk="t:call"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-3l-5-2-2 2a14 14 0 0 1-7-7l2-2-2-5Z"/></svg><%= t.call %></a><a href="<%= directionsHref %>" style="background-color:#ffdd22;color:#132b63" target="_blank" rel="noopener noreferrer" data-lk="t:short_directions"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 9 9-9 9-9-9 9-9Z M8 14v-4h7m-3-3 3 3-3 3"/></svg><%= t.short_directions %></a><% }else{ %><a href="<%= footerHome %>#liquidations" style="background-color:#2858ef;color:#fff" data-lk="t:browse"><%= t.browse %></a><a href="<%= footerHome %>/magasin" style="background-color:#ffdd22;color:#132b63" data-lk="t:contact_info"><%= t.contact_info %></a><% } %></nav><% } %><div id="site-runtime" hidden data-copy="<%= JSON.stringify({push_title:t.push_title,push_body:t.push_body,map_loading:t.map_loading,map_error:t.map_error,map_ready:t.map_ready,photo_missing:t.photo_missing}) %>"></div></body></html>