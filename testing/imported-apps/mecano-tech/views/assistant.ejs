<%- include('partials/header') %>
<section class="section">
  <div class="container" style="max-width:820px">
    <h1 class="section-title">🤖 <%= t.assistant_title %></h1>
    <p class="section-sub"><%= t.assistant_desc %></p>
    <div class="card">
      <div class="tabs">
        <button type="button" class="tab-btn active" data-tab="diag">💬 <%= t.assistant_tab_diag %></button>
        <button type="button" class="tab-btn" data-tab="photo">📷 <%= t.assistant_tab_photo %></button>
        <button type="button" class="tab-btn" data-tab="guide">📋 <%= t.assistant_tab_guide %></button>
      </div>
      <div id="tab-diag" class="tab-panel active">
        <p style="color:#64748b">Décrivez le symptôme à voix haute ou par texte. L'IA suggérera des causes probables et des solutions économiques.</p>
        <div style="text-align:center;margin:1.5rem 0">
          <button type="button" id="voice-diag" class="voice-btn" title="Parler">🎤</button>
          <div id="voice-status" style="color:#64748b;margin-top:.5rem;font-size:.85rem">Cliquez pour parler</div>
        </div>
        <textarea id="diag-input" class="textarea" placeholder="<%= t.assistant_diag_placeholder %>"></textarea>
        <button type="button" id="diag-submit" class="btn btn-primary btn-block" style="background-color:#6366f1;color:#fff;margin-top:.75rem"><%= t.btn_analyze %></button>
        <div id="diag-result"></div>
      </div>
      <div id="tab-photo" class="tab-panel">
        <p style="color:#64748b">Prenez une photo nette d'une pièce. L'IA identifiera la pièce et expliquera son rôle.</p>
        <label class="upload-zone" id="upload-zone">
          <input type="file" id="photo-input" accept="image/*" capture="environment" style="display:none">
          <div id="upload-placeholder"><div style="font-size:3rem">📷</div><p>Cliquez pour prendre ou choisir une photo</p></div>
          <img id="photo-preview" style="display:none" alt="Aperçu">
        </label>
        <button type="button" id="photo-submit" class="btn btn-primary btn-block" style="background-color:#6366f1;color:#fff;margin-top:.75rem;display:none"><%= t.btn_analyze %></button>
        <div id="photo-result"></div>
      </div>
      <div id="tab-guide" class="tab-panel">
        <p style="color:#64748b">Décrivez la procédure que vous voulez réaliser. Un guide étape par étape sera généré, lisible à voix haute.</p>
        <input type="text" id="guide-input" class="input" placeholder="<%= t.assistant_guide_placeholder %>">
        <button type="button" id="guide-submit" class="btn btn-primary btn-block" style="background-color:#6366f1;color:#fff;margin-top:.75rem">Générer le guide</button>
        <div id="guide-result"></div>
      </div>
    </div>
  </div>
</section>
<script>
(function(){
var tabs = document.querySelectorAll('.tab-btn');
tabs.forEach(function(t){ t.addEventListener('click', function(){ tabs.forEach(function(x){x.classList.remove('active');}); t.classList.add('active'); var k=t.getAttribute('data-tab'); document.querySelectorAll('.tab-panel').forEach(function(p){p.classList.remove('active');}); document.getElementById('tab-'+k).classList.add('active'); }); });

var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
var voiceBtn = document.getElementById('voice-diag');
var voiceStatus = document.getElementById('voice-status');
var diagInput = document.getElementById('diag-input');
if (SR && voiceBtn) {
  var rec = new SR(); rec.lang='fr-FR'; rec.interimResults=true; rec.continuous=false;
  var listening = false;
  voiceBtn.addEventListener('click', function(){
    if (listening) { rec.stop(); return; }
    listening = true; voiceBtn.classList.add('listening'); voiceStatus.textContent='Écoute en cours…';
    rec.start();
  });
  rec.onresult = function(e){ var txt=''; for (var i=0;i<e.results.length;i++) txt += e.results[i][0].transcript; diagInput.value = txt; };
  rec.onend = function(){ listening=false; voiceBtn.classList.remove('listening'); voiceStatus.textContent='Cliquez pour parler'; };
  rec.onerror = function(e){ listening=false; voiceBtn.classList.remove('listening'); voiceStatus.textContent='Erreur: ' + e.error; };
} else if (voiceBtn) {
  voiceBtn.style.opacity='0.5'; voiceStatus.textContent='Reconnaissance vocale non supportée sur ce navigateur';
}

function renderResult(container, text, error) {
  if (error) { container.innerHTML = '<div class="notice notice-error">' + (text || 'Erreur') + '</div>'; return; }
  var html = '<div class="assistant-result">' + text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</div>';
  html += '<button type="button" class="btn btn-outline btn-sm" style="margin-top:.75rem" onclick="window.__speak(this)">🔊 Lire à voix haute</button>';
  container.innerHTML = html;
  container._text = text;
}
window.__speak = function(btn){
  if (!window.speechSynthesis) return;
  var container = btn.parentElement;
  if (window.speechSynthesis.speaking) { window.speechSynthesis.cancel(); btn.textContent='🔊 Lire à voix haute'; return; }
  var u = new SpeechSynthesisUtterance(container._text || container.querySelector('.assistant-result').textContent);
  u.lang='fr-FR'; u.rate=0.95;
  btn.textContent='⏹ Arrêter';
  u.onend = function(){ btn.textContent='🔊 Lire à voix haute'; };
  window.speechSynthesis.speak(u);
};

document.getElementById('diag-submit').addEventListener('click', async function(){
  var sym = diagInput.value.trim();
  if (!sym) { window.__toast('Veuillez décrire le symptôme', 'error'); return; }
  var btn = this; var orig = btn.textContent; btn.disabled = true; btn.textContent='Analyse…';
  var res = document.getElementById('diag-result'); res.innerHTML = '<div style="text-align:center;padding:2rem"><div class="spinner"></div> Analyse en cours…</div>';
  try {
    var r = await fetch('./api/ai/diagnose', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ symptom: sym }) });
    var d = await r.json();
    if (r.ok) renderResult(res, d.result); else renderResult(res, d.error || 'Erreur', true);
  } catch(e) { renderResult(res, 'Erreur réseau', true); }
  btn.disabled = false; btn.textContent = orig;
});

var photoInput = document.getElementById('photo-input');
var photoPreview = document.getElementById('photo-preview');
var uploadPh = document.getElementById('upload-placeholder');
var photoSubmit = document.getElementById('photo-submit');
var uploadZone = document.getElementById('upload-zone');
var photoData = null;
uploadZone.addEventListener('click', function(e){ if (e.target !== photoInput) photoInput.click(); });
photoInput.addEventListener('change', function(){
  var f = photoInput.files[0]; if (!f) return;
  var fr = new FileReader();
  fr.onload = function(){ photoData = fr.result; photoPreview.src = photoData; photoPreview.style.display='block'; uploadPh.style.display='none'; uploadZone.classList.add('has-image'); photoSubmit.style.display='block'; };
  fr.readAsDataURL(f);
});
photoSubmit.addEventListener('click', async function(){
  if (!photoData) return;
  var btn = this; var orig = btn.textContent; btn.disabled=true; btn.textContent='Analyse…';
  var res = document.getElementById('photo-result'); res.innerHTML = '<div style="text-align:center;padding:2rem"><div class="spinner"></div> Identification en cours…</div>';
  try {
    var r = await fetch('./api/ai/identify-part', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ image: photoData }) });
    var d = await r.json();
    if (r.ok) renderResult(res, d.result); else renderResult(res, d.error || 'Erreur', true);
  } catch(e){ renderResult(res, 'Erreur réseau', true); }
  btn.disabled=false; btn.textContent=orig;
});

document.getElementById('guide-submit').addEventListener('click', async function(){
  var task = document.getElementById('guide-input').value.trim();
  if (!task) { window.__toast('Veuillez décrire la procédure', 'error'); return; }
  var btn = this; var orig = btn.textContent; btn.disabled=true; btn.textContent='Génération…';
  var res = document.getElementById('guide-result'); res.innerHTML = '<div style="text-align:center;padding:2rem"><div class="spinner"></div> Génération du guide…</div>';
  try {
    var r = await fetch('./api/ai/procedure-guide', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ task: task }) });
    var d = await r.json();
    if (r.ok) renderResult(res, d.result); else renderResult(res, d.error || 'Erreur', true);
  } catch(e){ renderResult(res, 'Erreur réseau', true); }
  btn.disabled=false; btn.textContent=orig;
});
})();
</script>
<%- include('partials/footer') %>
