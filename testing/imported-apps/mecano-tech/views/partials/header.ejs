<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#6366f1">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="description" content="<%= (settings && settings.tagline) || t.tagline %>">
<title><%= (settings && settings.business_name) || t.app_name %> — <%= (settings && settings.tagline) || t.tagline %></title>
<link rel="manifest" href="manifest.json">
<link rel="stylesheet" href="public/css/styles.css">
</head>
<body>
<nav class="nav">
  <div class="nav-inner">
    <a href="." class="nav-brand">
      <img src="<%= (typeof settings !== 'undefined' && settings._p_nav_logo_url) ? settings._p_nav_logo_url : (typeof appIconUrl !== 'undefined' && appIconUrl ? appIconUrl : 'https://placehold.co/64/6366f1/ffffff/png?text=M') %>" alt="Logo">
      <span><%= (settings && settings.business_name) || t.app_name %></span>
    </a>
    <div class="nav-links">
      <a href="." class="<%= page==='home'?'active':'' %>"><%= t.nav_home %></a>
      <a href="diagnostics" class="<%= page==='diagnostics'?'active':'' %>"><%= t.nav_diagnostics %></a>
      <a href="procedures" class="<%= page==='procedures'?'active':'' %>"><%= t.nav_procedures %></a>
      <a href="parts" class="<%= page==='parts'?'active':'' %>"><%= t.nav_parts %></a>
      <a href="assistant" class="<%= page==='assistant'?'active':'' %>"><%= t.nav_assistant %></a>
      <a href="inventaire" class="<%= page==='inventory'?'active':'' %>"><%= t.nav_inventory %></a>
    </div>
    <div class="nav-cta">
      <a href="profile" data-auth-only style="display:none" class="btn btn-sm btn-outline"><%= t.nav_profile %></a>
      <a href="#" data-login-btn class="btn btn-sm btn-primary" style="background-color:#6366f1;color:#fff"><%= t.nav_login %></a>
      <button class="hamburger" aria-label="Menu">☰</button>
    </div>
  </div>
  <div class="mobile-menu">
    <a href="."><%= t.nav_home %></a>
    <a href="diagnostics"><%= t.nav_diagnostics %></a>
    <a href="procedures"><%= t.nav_procedures %></a>
    <a href="parts"><%= t.nav_parts %></a>
    <a href="assistant"><%= t.nav_assistant %></a>
    <a href="inventaire"><%= t.nav_inventory %></a>
    <a href="profile" data-auth-only style="display:none"><%= t.nav_profile %></a>
    <button class="login-mobile" data-login-btn><%= t.nav_login %></button>
  </div>
</nav>
