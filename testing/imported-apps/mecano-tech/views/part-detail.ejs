<%- include('partials/header') %>
<section class="section">
  <div class="container" style="max-width:820px">
    <p><a href="parts">← Catalogue</a></p>
    <% if (item.category) { %><span class="badge"><%= item.category %></span><% } %>
    <h1 style="margin-top:.7rem"><%= item.name %></h1>
    <% if (item.part_number) { %><p style="font-family:monospace;color:#64748b"><%= t.part_number %>: <%= item.part_number %></p><% } %>
    <button class="fav-btn" data-fav data-fav-type="part" data-fav-id="<%= item.id %>">☆ Favori</button>
    <% if (item.image_url) { %><img src="<%= item.image_url %>" alt="<%= item.name %>" style="width:100%;max-width:500px;border-radius:10px;margin:1.5rem 0"><% } %>
    <dl class="kv">
      <% if (item.price != null) { %><dt><%= t.price %></dt><dd style="font-size:1.4rem;font-weight:700;color:#6366f1"><%= formatPrice(item.price) %></dd><% } %>
      <% if (item.stock != null) { %><dt><%= t.stock %></dt><dd><% if (item.stock > 0) { %><span class="badge badge-success"><%= item.stock %> en stock</span><% } else { %><span class="badge badge-danger">Rupture</span><% } %></dd><% } %>
      <% if (item.category) { %><dt><%= t.category %></dt><dd><%= item.category %></dd><% } %>
    </dl>
    <% if (item.description) { %><div class="list-block"><h4>Description</h4><p><%= item.description %></p></div><% } %>
    <% if (item.specs) { %><div class="list-block"><h4><%= t.specs %></h4><pre style="white-space:pre-wrap;font-family:inherit;margin:0"><%= item.specs %></pre></div><% } %>
  </div>
</section>
<%- include('partials/footer') %>
