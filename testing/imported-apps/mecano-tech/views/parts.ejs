<%- include('partials/header') %>
<section class="section">
  <div class="container">
    <h1 class="section-title"><%= t.nav_parts %></h1>
    <p class="section-sub">Catalogue des pièces avec spécifications techniques.</p>
    <form method="GET" class="search-bar" action="parts">
      <input type="text" name="q" value="<%= q || '' %>" placeholder="Rechercher par nom, numéro de pièce, catégorie…" class="input">
      <button type="submit" class="btn btn-primary" style="background-color:#6366f1;color:#fff"><%= t.btn_search %></button>
    </form>
    <% if (typeof items !== 'undefined' && items.length > 0) { %>
      <div class="grid grid-3">
        <% items.forEach(function(p){ %>
          <a href="parts/<%= p.id %>" class="card card-link">
            <% if (p.image_url) { %><img class="card-img" src="<%= p.image_url %>" alt="<%= p.name %>"><% } else { %><div class="card-icon">📦</div><% } %>
            <% if (p.category) { %><span class="badge"><%= p.category %></span><% } %>
            <% if (p.stock > 0) { %><span class="badge badge-success" style="margin-left:.3rem">En stock: <%= p.stock %></span><% } else { %><span class="badge badge-danger" style="margin-left:.3rem">Rupture</span><% } %>
            <h3 style="margin-top:.7rem"><%= p.name %></h3>
            <% if (p.part_number) { %><p style="color:#64748b;font-family:monospace;font-size:.85rem"><%= p.part_number %></p><% } %>
            <% if (p.price != null) { %><p style="font-weight:700;font-size:1.1rem;color:#6366f1"><%= formatPrice(p.price) %></p><% } %>
          </a>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state"><div class="icon">📦</div><p><%= q ? 'Aucune pièce pour « ' + q + ' ».' : t.empty_parts %></p></div>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>
