<aside class="admin-sidebar" id="admin-sidebar">
  <div class="admin-brand">
    <strong>MTL Pavage</strong>
    <span>Administration</span>
  </div>
  <nav class="admin-nav">
    <a href="admin" class="<%= currentPath==='/admin' ? 'active' : '' %>">📊 Tableau de bord</a>
