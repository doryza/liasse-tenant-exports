<button id="admin-toggle" class="admin-toggle" aria-label="Menu">☰</button>
<script>
(function(){
  var btn=document.getElementById('admin-toggle');
  var sb=document.getElementById('admin-sidebar');
  if(btn&&sb){btn.addEventListener('click',function(){sb.classList.toggle('open');});}
})();
</script>
