<% var pageTitle = t.nav_booking; %>
<%- include('partials/header') %>
<section class="page-hero">
  <div class="container">
    <h1><%= t.booking_title %></h1>
    <p><%= t.booking_subtitle %></p>
  </div>
</section>
<section class="section section-light">
  <div class="container form-wrap">
    <form id="booking-form" class="form">
      <div id="booking-status" class="form-status"></div>
      <div class="form-row">
        <div class="form-group">
          <label><%= t.form_name %> <span class="req">*</span></label>
          <input type="text" name="name" required value="<%= user ? (user.display_name || '') : '' %>">
        </div>
      </div>
      <div class="form-row form-row-2">
        <div class="form-group">
          <label><%= t.form_email %></label>
          <input type="email" name="email" value="<%= user ? (user.email || '') : '' %>">
        </div>
        <div class="form-group">
          <label><%= t.form_phone %></label>
          <input type="tel" name="phone" value="<%= user ? (user.phone || '') : '' %>">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label><%= t.form_service %></label>
          <select name="service_type">
            <option value=""><%= t.form_service_select %></option>
            <% if (typeof servicesList!=='undefined') { servicesList.forEach(function(s){ %><option value="<%= s.name %>"><%= s.name %></option><% }); } %>
          </select>
        </div>
      </div>
      <div class="form-row form-row-2">
        <div class="form-group">
          <label><%= t.form_date %></label>
          <input type="date" name="preferred_date">
        </div>
        <div class="form-group">
          <label><%= t.form_time %></label>
          <select name="preferred_time">
            <option value="">--</option>
            <option value="morning"><%= t.form_time_morning %></option>
            <option value="afternoon"><%= t.form_time_afternoon %></option>
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label><%= t.form_address %></label>
          <input type="text" name="address" placeholder="<%= lang==='en' ? '1234 Main St, Montreal' : '1234 rue Principale, Montréal' %>">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label><%= t.form_notes %></label>
          <textarea name="notes" rows="4"></textarea>
        </div>
      </div>
      <p class="form-required">* <%= t.form_required %></p>
      <button type="submit" class="btn btn-yellow btn-lg" style="background-color:#FCD34D;color:#0a0a0a"><%= t.form_submit_booking %></button>
    </form>

    <% if (typeof user!=='undefined' && user && myAppts && myAppts.length > 0) { %>
    <div class="my-section">
      <h2><%= t.booking_my_appointments %></h2>
      <div class="my-list">
        <% myAppts.forEach(function(a){ %>
        <div class="my-item">
          <div>
            <strong><%= a.service_type || (lang==='en' ? 'Appointment' : 'Rendez-vous') %></strong>
            <% if (a.preferred_date) { %><span>· <%= formatDate(a.preferred_date, lang) %></span><% } %>
          </div>
          <span class="badge status-<%= a.status %>"><%= a.status %></span>
        </div>
        <% }); %>
      </div>
    </div>
    <% } %>
  </div>
</section>
<script>
(function(){
  var form = document.getElementById('booking-form');
  var status = document.getElementById('booking-status');
  if (!form) return;
  form.addEventListener('submit', async function(e){
    e.preventDefault();
    var btn = form.querySelector('button[type=submit]');
    btn.disabled = true;
    var data = {};
    new FormData(form).forEach(function(v,k){ data[k]=v; });
    status.className = 'form-status';
    status.textContent = '';
    try {
      var fn = (window.TenantSDK && TenantSDK.fetch) ? TenantSDK.fetch : window.fetch;
      var res = await fn('api/booking', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(data) });
      var json = await res.json();
      if (res.ok && json.success) {
        status.className = 'form-status success';
        status.textContent = '<%- t.form_success_booking %>';
        form.reset();
      } else {
        status.className = 'form-status error';
        status.textContent = json.error || '<%- t.form_error %>';
      }
    } catch (err) {
      status.className = 'form-status error';
      status.textContent = '<%- t.form_error %>';
    }
    btn.disabled = false;
  });
})();
</script>
<%- include('partials/footer') %>
