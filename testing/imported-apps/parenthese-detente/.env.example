# Tenant API variables for local testing.
# Tenant: parenthese-detente (Parenthèse Détente)
# Copy to .env.local in this directory and fill in real values.
# .env.local is gitignored — never commit real keys.

# PayPal Client ID — find it in your PayPal Developer dashboard under API credentials
PAYPAL_CLIENT_ID=
# PayPal Client Secret — the secret key paired with your Client ID
PAYPAL_CLIENT_SECRET=
# PayPal mode — enter "sandbox" for testing or "live" for real payments
PAYPAL_MODE=
