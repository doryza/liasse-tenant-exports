<!DOCTYPE html><html lang='fr'><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title><%= title %> — Admin</title><link rel='stylesheet' href='public/css/admin-styles.css'><link href='https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Figtree:wght@400;500;600;700&display=swap' rel='stylesheet'></head><body class='admin'>
<%- include('admin-sidebar', { active: moduleKey }) %>
<main class='admin-main'>
 <header class='admin-top'><button class='side-toggle' id='sideToggle' aria-label='Menu'>≡</button><div class='admin-top-titles'><h1><%= title %></h1><p class='admin-sub'>Ajoutez, modifiez ou supprimez vos éléments.</p></div><button class='btn primary' id='addBtn'>+ Nouveau</button></header>
 <div id='msg' class='admin-msg' style='display:none'></div>
 <div class='toolbar'><div class='search-wrap'><input id='search' class='search-input' placeholder='Rechercher…' aria-label='Rechercher'></div><span id='count' class='count-badge'></span></div>
 <div class='table-wrap'><table id='tbl'><thead id='thead'></thead><tbody id='tbody'></tbody></table></div>
 <div id='empty' class='admin-empty' style='display:none'>Aucun élément pour le moment. Cliquez « + Nouveau » pour commencer.</div>
</main>
<div class='modal' id='modal'><div class='modal-card'><div class='modal-head'><h2 id='modalTitle'></h2><button id='closeModal' class='xbtn' aria-label='Fermer'>×</button></div><form id='form' class='modal-body' onsubmit='return false'></form><div class='modal-foot'><button class='btn ghost' id='cancelBtn'>Annuler</button><button class='btn primary' id='saveBtn'>Enregistrer</button></div></div></div>
<script>
var MODULE_KEY=<%- JSON.stringify(moduleKey) %>;var MODULE_LABEL=<%- JSON.stringify(moduleLabel) %>;
var fields=[],items=[],editingId=null,searchTerm='';
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/'/g,'&#39;');}
function prettify(k){k=k.replace(/_/g,' ');return k.charAt(0).toUpperCase()+k.slice(1);}
function msg(txt,ok){var m=document.getElementById('msg');m.style.display='block';m.textContent=txt;m.className='admin-msg '+(ok?'ok':'err');setTimeout(function(){m.style.display='none';},3500);}
function load(){fetch('api/admin/modules').then(function(r){return r.json();}).then(function(d){var mod=(d.modules||[]).filter(function(m){return m.key===MODULE_KEY;})[0];fields=mod?mod.fields:[];return fetch('api/admin/'+MODULE_KEY);}).then(function(r){return r.json();}).then(function(d){items=d[MODULE_KEY]||[];render();}).catch(function(){msg('Erreur de chargement',false);});}
function colFields(){var base=fields.slice(0,4);var extra=fields.filter(function(f){return f.type==='select'&&base.indexOf(f)===-1;});return base.concat(extra).slice(0,6);}
function cellVal(f,v){if(f.type==='boolean')return (v==1||v===true||v==='1'||v==='true')?'<span class="badge s-paid">Oui</span>':'<span class="badge">Non</span>';if(f.type==='image')return v?`<img class='cellimg' src='${esc(v)}'>`:'—';if(f.type==='select'&&v)return `<span class='badge s-${esc(String(v))}'>${esc(String(v))}</span>`;var s=v==null?'':String(v);if(s.length>60)s=s.slice(0,60)+'…';return esc(s);}
function filtered(){if(!searchTerm)return items;var q=searchTerm.toLowerCase();return items.filter(function(it){return fields.some(function(f){var v=it[f.name];return v!=null&&String(v).toLowerCase().indexOf(q)!==-1;});});}
function render(){var thead=document.getElementById('thead'),tbody=document.getElementById('tbody'),empty=document.getElementById('empty'),tbl=document.getElementById('tbl'),cnt=document.getElementById('count');var cf=colFields();thead.innerHTML='<tr>'+cf.map(function(f){return `<th>${esc(f.label||prettify(f.name))}</th>`;}).join('')+'<th></th></tr>';var list=filtered();if(cnt){var suffix=(list.length!==items.length)?(' / '+items.length):'';cnt.textContent=list.length+suffix+' élément'+(items.length>1?'s':'');}if(!items.length){empty.style.display='block';empty.textContent='Aucun élément pour le moment. Cliquez « + Nouveau » pour commencer.';tbl.style.display='none';return;}if(!list.length){empty.style.display='block';empty.textContent='Aucun résultat pour cette recherche.';tbl.style.display='none';return;}empty.style.display='none';tbl.style.display='table';tbody.innerHTML=list.map(function(it){return `<tr>${cf.map(function(f){return `<td>${cellVal(f,it[f.name])}</td>`;}).join('')}<td class='row-actions'><button class='btn tiny' onclick='edit(${it.id})'>Modifier</button> <button class='btn tiny danger' onclick='del(${it.id})'>Supprimer</button></td></tr>`;}).join('');}
function fieldInput(f,val){var name=f.name,v=(val==null?'':val),id='f_'+name;var help=f.description?`<span class='fld-help'>${esc(f.description)}</span>`:'';var inner='';if(f.type==='textarea'){inner=`<textarea id='${id}' rows='4'>${esc(v)}</textarea>`;}else if(f.type==='boolean'){var ck=(val==null?(f.default?true:false):(v==1||v===true||v==='1'||v==='true'));inner=`<label class='chk'><input type='checkbox' id='${id}' ${ck?'checked':''}> <span>Activé</span></label>`;}else if(f.type==='number'){inner=`<input type='number' id='${id}' value='${esc(v)}' ${f.min!=null?`min='${f.min}'`:''} ${f.step!=null?`step='${f.step}'`:''} ${f.placeholder?`placeholder='${esc(f.placeholder)}'`:''}>`;}else if(f.type==='select'){inner=`<select id='${id}'>`+(f.options||[]).map(function(o){return `<option value='${esc(o)}' ${String(v)===String(o)?'selected':''}>${esc(o)}</option>`;}).join('')+`</select>`;}else if(f.type==='date'){var dv=v?String(v).slice(0,10):'';inner=`<input type='date' id='${id}' value='${esc(dv)}'>`;}else if(f.type==='image'){inner=`<div class='imgfld' data-target='${id}'><input type='text' id='${id}' value='${esc(v)}' placeholder='URL de l’image'><div class='imgfld-actions'><label class='btn tiny'>Téléverser<input type='file' accept='image/*' class='imgfile' style='display:none'></label><button type='button' class='btn tiny imggen'>Générer (IA)</button></div><img class='imgprev' id='prev_${id}' src='${esc(v)}' style='${v?'':'display:none'}'></div>`;}else{inner=`<input type='${f.type==='email'?'email':'text'}' id='${id}' value='${esc(v)}' ${f.placeholder?`placeholder='${esc(f.placeholder)}'`:''}>`;}return `<label class='fld'><span class='fld-label'>${esc(f.label||prettify(name))}${f.required?' *':''}</span>${inner}${help}</label>`;}
function buildForm(item){var f=document.getElementById('form');f.innerHTML=fields.map(function(fl){return fieldInput(fl,item?item[fl.name]:null);}).join('');document.querySelectorAll('.imgfld').forEach(function(box){var target=box.getAttribute('data-target');var file=box.querySelector('.imgfile');var gen=box.querySelector('.imggen');if(file)file.addEventListener('change',function(){uploadImg(file,target);});if(gen)gen.addEventListener('click',function(){genImg(target);});});}
function openModal(t){document.getElementById('modalTitle').textContent=t;document.getElementById('modal').classList.add('open');}
function closeModal(){document.getElementById('modal').classList.remove('open');}
function create(){editingId=null;buildForm(null);openModal('Nouveau : '+MODULE_LABEL);}
function edit(id){editingId=id;var it=items.filter(function(x){return x.id===id;})[0];buildForm(it);openModal('Modifier : '+MODULE_LABEL);}
window.edit=edit;
function del(id){if(!confirm('Supprimer cet élément ?'))return;fetch('api/admin/'+MODULE_KEY+'/'+id,{method:'DELETE'}).then(function(r){return r.json();}).then(function(){msg('Supprimé',true);load();}).catch(function(){msg('Erreur',false);});}
window.del=del;
function collect(){var o={};fields.forEach(function(f){var el=document.getElementById('f_'+f.name);if(!el)return;if(f.type==='boolean')o[f.name]=el.checked?1:0;else o[f.name]=el.value;});return o;}
function save(){var body=collect();var url='api/admin/'+MODULE_KEY+(editingId?'/'+editingId:'');var method=editingId?'PUT':'POST';document.getElementById('saveBtn').disabled=true;fetch(url,{method:method,headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}).then(function(r){return r.json().then(function(d){return{ok:r.ok,d:d};});}).then(function(res){document.getElementById('saveBtn').disabled=false;if(!res.ok){msg((res.d&&res.d.error)||'Erreur',false);return;}closeModal();msg('Enregistré',true);load();}).catch(function(){document.getElementById('saveBtn').disabled=false;msg('Erreur',false);});}
window.uploadImg=function(input,targetId){var file=input.files[0];if(!file)return;var rd=new FileReader();rd.onload=function(){msg('Téléversement en cours…',true);fetch('api/admin/upload',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({dataUri:rd.result})}).then(function(r){return r.json();}).then(function(d){if(d.url){document.getElementById(targetId).value=d.url;var p=document.getElementById('prev_'+targetId);if(p){p.src=d.url;p.style.display='block';}msg('Image téléversée',true);}else{msg(d.error||'Téléversement échoué',false);}}).catch(function(){msg('Téléversement échoué',false);});};rd.readAsDataURL(file);};
window.genImg=function(targetId){var pr=prompt('Décrivez l’image à générer :');if(!pr)return;msg('Génération en cours…',true);fetch('api/admin/generate-image',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({prompt:pr,aspectRatio:'4:3'})}).then(function(r){return r.json();}).then(function(d){if(d.imageUrl){document.getElementById(targetId).value=d.imageUrl;var p=document.getElementById('prev_'+targetId);if(p){p.src=d.imageUrl;p.style.display='block';}msg('Image générée',true);}else{msg(d.error||'Génération échouée',false);}}).catch(function(){msg('Génération échouée',false);});};
document.getElementById('addBtn').addEventListener('click',create);
document.getElementById('saveBtn').addEventListener('click',save);
document.getElementById('cancelBtn').addEventListener('click',closeModal);
document.getElementById('closeModal').addEventListener('click',closeModal);
document.getElementById('modal').addEventListener('click',function(e){if(e.target===this)closeModal();});
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeModal();});
var searchEl=document.getElementById('search');if(searchEl){searchEl.addEventListener('input',function(e){searchTerm=e.target.value;render();});}
(function(){var st=document.getElementById('sideToggle');if(st){st.addEventListener('click',function(){document.querySelector('.admin-sidebar').classList.toggle('open');});}})();
load();
</script>
</body></html>
