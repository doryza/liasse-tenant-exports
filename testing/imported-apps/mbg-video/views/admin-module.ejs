<!DOCTYPE html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= (typeof module!=='undefined'&&module)?module.label:'Module' %> — Admin MBG</title><link rel="stylesheet" href="public/css/admin-styles.css"></head><body class="admin">
<% var _m=(typeof module!=='undefined'&&module)?module:{label:'',key:'',fields:[]}; var _items=(typeof items!=='undefined'&&items)?items:[]; %>
<%- include('partials/admin-sidebar', { active: _m.key }) %>
<main class="admin-main">
<header class="admin-top"><button class="side-toggle" type="button" onclick="document.body.classList.toggle('side-open')" aria-label="Menu">≡</button><div class="tt"><h1><%= _m.label %></h1><p class="admin-sub">Créez, modifiez et supprimez vos entrées.</p></div><button class="btn-primary" type="button" onclick="openCreate()" style="background-color:#6366F1;color:#fff">+ Nouveau</button></header>
<div id="msg" class="admin-msg" style="display:none"></div>
<div class="toolbar">
<div class="search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg><input id="search" type="search" placeholder="Rechercher…" oninput="applyFilter()"></div>
<span class="count-pill"><b id="cnt">0</b> élément(s)</span>
</div>
<div class="table-wrap"><table class="admin-table"><thead id="thead"></thead><tbody id="tbody"></tbody></table></div>
<div id="empty" class="admin-empty" style="display:none"></div>
</main>
<div id="modal" class="modal" style="display:none"><div class="modal-box"><div class="modal-head"><h2 id="modalTitle">Nouveau</h2><button type="button" onclick="closeModal()" aria-label="Fermer">×</button></div><form id="form" onsubmit="return saveItem(event)"><div id="fields"></div><div class="modal-actions"><button type="button" onclick="closeModal()">Annuler</button><button type="submit" class="btn-primary" id="saveBtn" style="background-color:#6366F1;color:#fff">Enregistrer</button></div></form></div></div>
<script>
var MODULE = <%- JSON.stringify(_m) %>;
var ITEMS = <%- JSON.stringify(_items) %>;
var VIEW = ITEMS.slice();
var editingId = null;
function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
function colFields(){ var img=MODULE.fields.filter(function(f){ return f.type==='image'; }); var others=MODULE.fields.filter(function(f){ return f.type!=='image'&&f.type!=='textarea'; }); var cols=[]; if(img.length) cols.push(img[0]); return cols.concat(others.slice(0,4)); }
function cell(it,f){ var v=it[f.name]; if(f.type==='boolean') return v?'<span class="badge on">Oui</span>':'<span class="badge off">Non</span>'; if(f.type==='image') return v?('<img src="'+esc(v)+'" class="thumb">'):'—'; var s=v==null?'':String(v); if(s.length>60) s=s.slice(0,60)+'…'; return esc(s)||'—'; }
function renderTable(){ var th=document.getElementById('thead'),tb=document.getElementById('tbody'),cols=colFields(); document.getElementById('cnt').textContent=ITEMS.length; th.innerHTML='<tr>'+cols.map(function(f){ return '<th>'+esc(f.label||f.name)+'</th>'; }).join('')+'<th>Actions</th></tr>'; var emp=document.getElementById('empty'); if(!ITEMS.length){ emp.textContent='Aucun élément. Cliquez sur « + Nouveau » pour en créer un.'; emp.style.display='block'; tb.innerHTML=''; return; } if(!VIEW.length){ emp.textContent='Aucun résultat pour cette recherche.'; emp.style.display='block'; tb.innerHTML=''; return; } emp.style.display='none'; tb.innerHTML=VIEW.map(function(it){ return '<tr>'+cols.map(function(f){ return '<td>'+cell(it,f)+'</td>'; }).join('')+'<td class="row-actions"><button type="button" onclick="openEdit('+it.id+')">Modifier</button><button type="button" class="danger" onclick="delItem('+it.id+')">Supprimer</button></td></tr>'; }).join(''); }
function applyFilter(){ var el=document.getElementById('search'); var q=(el?el.value:'').toLowerCase().trim(); VIEW=!q?ITEMS.slice():ITEMS.filter(function(it){ return MODULE.fields.some(function(f){ var v=it[f.name]; return v!=null && String(v).toLowerCase().indexOf(q)>-1; }); }); renderTable(); }
function buildForm(item){ editingId=item?item.id:null; document.getElementById('modalTitle').textContent=(item?'Modifier — ':'Nouveau — ')+MODULE.label; var wrap=document.getElementById('fields'); wrap.innerHTML=''; MODULE.fields.forEach(function(f){ var val=item?item[f.name]:(f.default!==undefined?f.default:''); var lab=document.createElement('label'); lab.className='fld'; var sp=document.createElement('span'); sp.className='fld-lbl'; sp.textContent=(f.label||f.name)+(f.required?' *':''); lab.appendChild(sp); var input; if(f.type==='textarea'){ input=document.createElement('textarea'); input.value=val==null?'':val; } else if(f.type==='boolean'){ input=document.createElement('input'); input.type='checkbox'; input.checked=!!val; } else if(f.type==='select'){ input=document.createElement('select'); (f.options||[]).forEach(function(o){ var op=document.createElement('option'); op.textContent=o; op.value=o; if(String(val)===String(o)) op.selected=true; input.appendChild(op); }); } else if(f.type==='number'){ input=document.createElement('input'); input.type='number'; if(f.step) input.step=f.step; input.value=val==null?'':val; } else if(f.type==='image'){ input=document.createElement('input'); input.type='text'; input.value=val==null?'':val; input.placeholder='URL de l’image'; } else { input=document.createElement('input'); input.type=(f.type==='url'?'url':(f.type==='email'?'email':'text')); input.value=val==null?'':val; } if(f.placeholder&&f.type!=='image'&&f.type!=='boolean') input.placeholder=f.placeholder; if(f.required&&f.type!=='boolean') input.required=true; input.id='f_'+f.name; input.name=f.name; if(f.type==='image'){ var box=document.createElement('div'); box.className='img-fld'; box.appendChild(input); var btns=document.createElement('div'); btns.className='img-btns'; var upLab=document.createElement('label'); upLab.className='mini'; upLab.textContent='Téléverser'; var file=document.createElement('input'); file.type='file'; file.accept='image/*'; file.style.display='none'; file.addEventListener('change',function(){ uploadImg(file,input); }); upLab.appendChild(file); btns.appendChild(upLab); var gen=document.createElement('button'); gen.type='button'; gen.className='mini'; gen.textContent='Générer (IA)'; gen.addEventListener('click',function(){ genImg(input); }); btns.appendChild(gen); box.appendChild(btns); var prev=document.createElement('img'); prev.className='prev'; if(val){ prev.src=val; } else { prev.style.display='none'; } input._prev=prev; box.appendChild(prev); lab.appendChild(box); } else { lab.appendChild(input); } if(f.description){ var h=document.createElement('span'); h.className='fld-help'; h.textContent=f.description; lab.appendChild(h); } wrap.appendChild(lab); }); document.getElementById('modal').style.display='flex'; }
function setImg(input,url){ input.value=url; if(input._prev){ input._prev.src=url; input._prev.style.display='block'; } }
function uploadImg(file,input){ var f=file.files[0]; if(!f) return; var rd=new FileReader(); rd.onload=function(){ fetch('api/admin/upload',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({dataUri:rd.result})}).then(function(r){ return r.json().then(function(d){ return {ok:r.ok,d:d}; }); }).then(function(res){ if(!res.ok) throw new Error(); setImg(input,res.d.url); }).catch(function(){ showMsg('Téléversement impossible.',true); }); }; rd.readAsDataURL(f); }
function genImg(input){ var p=window.prompt('Décrivez l’image à générer :'); if(!p) return; showMsg('Génération en cours…',false); fetch('api/admin/generate-image',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({prompt:p,aspectRatio:'16:9'})}).then(function(r){ return r.json().then(function(d){ return {ok:r.ok,d:d}; }); }).then(function(res){ if(!res.ok) throw new Error(); setImg(input,res.d.imageUrl); showMsg('Image générée.',false); }).catch(function(){ showMsg('Génération impossible.',true); }); }
function saveItem(e){ e.preventDefault(); var body={}; MODULE.fields.forEach(function(f){ var el=document.getElementById('f_'+f.name); if(!el) return; body[f.name]=(f.type==='boolean')?el.checked:el.value; }); var btn=document.getElementById('saveBtn'); btn.disabled=true; var url=editingId?('api/admin/'+MODULE.key+'/'+editingId):('api/admin/'+MODULE.key); var method=editingId?'PUT':'POST'; fetch(url,{method:method,headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}).then(function(r){ return r.json().then(function(d){ return {ok:r.ok,d:d}; }); }).then(function(res){ if(!res.ok) throw new Error((res.d&&res.d.error)||'Erreur'); var row=res.d.item; if(editingId){ ITEMS=ITEMS.map(function(x){ return x.id===editingId?row:x; }); } else { ITEMS.unshift(row); } closeModal(); applyFilter(); showMsg(editingId?'Modifié.':'Ajouté.',false); }).catch(function(err){ showMsg(err.message||'Erreur',true); }).then(function(){ btn.disabled=false; }); return false; }
function delItem(id){ if(!confirm('Supprimer cet élément ?')) return; fetch('api/admin/'+MODULE.key+'/'+id,{method:'DELETE'}).then(function(r){ if(!r.ok) throw new Error(); ITEMS=ITEMS.filter(function(x){ return x.id!==id; }); applyFilter(); showMsg('Supprimé.',false); }).catch(function(){ showMsg('Suppression impossible.',true); }); }
function showMsg(t,err){ var m=document.getElementById('msg'); m.textContent=t; m.className='admin-msg '+(err?'err':'ok'); m.style.display='block'; setTimeout(function(){ m.style.display='none'; },3000); }
function closeModal(){ document.getElementById('modal').style.display='none'; }
function openCreate(){ buildForm(null); }
function openEdit(id){ var it=ITEMS.find(function(x){ return x.id===id; }); if(it) buildForm(it); }
renderTable();
</script>
</body></html>
