        {
          "id": 1,
          "title": "Bienvenue sur La Box d’Ici",
          "content": "Notre réseau ouvre ses portes à toute personne invitée par un membre actuel. Si vous lisez ceci, c’est que vous faites partie de ceux qui veulent un Internet plus humain. Merci d’être ici.",
          "image_url": null,
          "category": "Annonces",
          "published": 1,
          "created_at": "2026-05-20T19:41:09.254Z",
          "updated_at": "2026-05-20T19:41:09.254Z"
        },
        {
          "id": 2,
          "title": "Nos engagements en matière de confidentialité",
          "content": "Aucune donnée vendue. Aucun profil partagé à l’extérieur. Vos publications restent visibles uniquement par les amis que vous avez vous-même acceptés.",
          "image_url": null,
          "category": "Confidentialité",
          "published": 1,
          "created_at": "2026-05-20T19:41:09.262Z",
          "updated_at": "2026-05-20T19:41:09.262Z"
        },
        {
          "id": 3,
          "title": "Modération humaine, basée au Québec",
          "content": "Tous les signalements sont examinés par une équipe humaine au Québec, en français. Nous ne sous-traitons pas la modération.",
          "image_url": null,
          "category": "Sécurité",
          "published": 1,
          "created_at": "2026-05-20T19:41:09.269Z",
          "updated_at": "2026-05-20T19:41:09.269Z"
        },
        {
          "id": 4,
          "title": "Contrôles parentaux simples",
          "content": "Les comptes des jeunes de moins de 16 ans sont liés à un parent. Le parent voit les demandes d’amis et peut ajuster qui peut leur écrire en quelques clics.",
          "image_url": null,
          "category": "Famille",
          "published": 1,
          "created_at": "2026-05-20T19:41:09.282Z",
          "updated_at": "2026-05-20T19:41:09.282Z"
        },
        {
          "id": 5,
          "title": "Petites améliorations cette semaine",
          "content": "Nouveau bouton de blocage rapide depuis les publications, traduction améliorée et un nouvel onglet pour les invitations en attente.",
          "image_url": null,
          "category": "Mises à jour",
          "published": 1,
          "created_at": "2026-05-20T19:41:09.294Z",
          "updated_at": "2026-05-20T19:41:09.294Z"
        }
      ]
