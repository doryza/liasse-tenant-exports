<%- include('partials/header') %>
<section class="section">
  <div class="container narrow">
    <a href="annonces" class="back-link">← <%= t.nav_news %></a>
    <% if (typeof post !== 'undefined' && post) { %>
      <article class="article">
        <% if (post.image_url) { %><img src="<%= post.image_url %>" alt="" class="article-img"><% } %>
        <% if (post.category) { %><span class="badge"><%= post.category %></span><% } %>
        <h1><%= post.title %></h1>
        <div class="article-meta"><%= fmtDate(post.created_at, lang) %></div>
        <div class="prose">
          <% (post.content || '').split('\n').forEach(function(par) { if (par.trim()) { %><p><%= par %></p><% } }); %>
        </div>
      </article>
    <% } else { %>
      <p class="empty-state"><%= t.news_empty %></p>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>