<%- include('partials/header') %>
<section class="section section-app">
  <div class="container">
    <h1 class="app-h1"><%= t.feed_h %></h1>
    <% if (typeof user !== 'undefined' && user) { %>
      <div class="composer">
        <textarea id="composerText" placeholder="<%= t.feed_compose_ph %>" rows="3" maxlength="2000"></textarea>
        <div class="composer-actions">
          <span id="composerStatus" class="composer-status"></span>
          <button id="publishBtn" class="btn-primary" style="background-color:#6366f1;color:#fff"><%= t.feed_publish %></button>
        </div>
      </div>
      <div id="postsList">
        <% if (typeof posts !== 'undefined' && posts && posts.length > 0) { %>
          <% posts.forEach(function(p) { %>
            <article class="post-card">
              <div class="post-head">
                <div class="avatar"><%= (p.display_name || 'M').charAt(0).toUpperCase() %></div>
                <div>
                  <div class="post-author"><%= p.display_name || ('Membre ' + p.user_id) %></div>
                  <div class="post-time"><%= timeAgo(p.created_at, lang) %></div>
                </div>
                <div class="post-actions">
                  <% if (p.user_id === user.id) { %>
                    <button class="btn-icon" onclick="deletePost(<%= p.id %>)" title="Supprimer">🗑</button>
                  <% } else { %>
                    <button class="btn-icon" onclick="reportPost(<%= p.id %>)" title="<%= t.report_h %>">⚑</button>
                  <% } %>
                </div>
              </div>
              <div class="post-body"><%= p.content %></div>
              <% if (p.image_url) { %><img src="<%= p.image_url %>" alt="" class="post-img"><% } %>
            </article>
          <% }) %>
        <% } else { %>
          <p class="empty-state"><%= t.feed_empty %> <a href="amis"><%= t.nav_friends %> →</a></p>
        <% } %>
      </div>
    <% } else { %>
      <div class="login-card">
        <p><%= t.feed_login %></p>
        <a href="#" data-login-btn class="btn-primary" style="background-color:#6366f1;color:#fff"><%= t.nav_login %></a>
      </div>
    <% } %>
  </div>
</section>
<div id="reportModal" class="modal" style="display:none">
  <div class="modal-content">
    <h3><%= t.report_h %></h3>
    <select id="reportReason" class="form-input">
      <% (t.report_reasons || []).forEach(function(r) { %><option value="<%= r %>"><%= r %></option><% }) %>
    </select>
    <textarea id="reportDetails" placeholder="<%= t.report_details %>" rows="3" class="form-input"></textarea>
    <div class="modal-actions">
      <button class="btn-ghost" onclick="closeReport()">Annuler</button>
      <button class="btn-primary" style="background-color:#6366f1;color:#fff" onclick="submitReport()"><%= t.report_send %></button>
    </div>
  </div>
</div>
<script>
var reportingId=null;
(function(){
  var btn=document.getElementById('publishBtn');
  if(!btn)return;
  btn.addEventListener('click',async function(){
    var ta=document.getElementById('composerText');
    var st=document.getElementById('composerStatus');
    var c=ta.value.trim();
    if(!c){st.textContent='Vide';return;}
    btn.disabled=true;st.textContent='...';
    try{
      var res=await TenantSDK.fetch('api/feed/post',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({content:c})});
      if(res.ok){location.reload();}else{var j=await res.json();st.textContent=j.error||'Erreur';btn.disabled=false;}
    }catch(e){st.textContent='Erreur';btn.disabled=false;}
  });
})();
async function deletePost(id){
  if(!confirm('Supprimer cette publication ?'))return;
  var res=await TenantSDK.fetch('api/feed/delete/'+id,{method:'POST'});
  if(res.ok)location.reload();
}
function reportPost(id){reportingId={type:'member_post',id:id};document.getElementById('reportModal').style.display='flex';}
function closeReport(){reportingId=null;document.getElementById('reportModal').style.display='none';}
async function submitReport(){
  if(!reportingId)return;
  var reason=document.getElementById('reportReason').value;
  var details=document.getElementById('reportDetails').value;
  var res=await TenantSDK.fetch('api/report',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({targetType:reportingId.type,targetId:reportingId.id,reason:reason,details:details})});
  if(res.ok){alert('<%- t.report_thanks %>');closeReport();}else{alert('Erreur');}
}
</script>
<%- include('partials/footer') %>