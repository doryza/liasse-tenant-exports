<!DOCTYPE html>
<html lang='<%= lang %>'>
<head>
<meta charset='utf-8'>
<meta name='viewport' content='width=device-width, initial-scale=1, viewport-fit=cover'>
<meta name='theme-color' content='#0A0E1A'>
<meta name='apple-mobile-web-app-capable' content='yes'>
<meta name='apple-mobile-web-app-status-bar-style' content='black-translucent'>
<meta name='description' content='<%= (typeof settings!=='undefined' && settings.meta_desc) ? settings.meta_desc : t.meta_desc %>'>
<% var _pt={services:t.nav_services,gallery:t.nav_gallery,news:t.nav_news,contact:t.nav_contact,booking:t.nav_booking}; var _ptv=(typeof page!=='undefined'&&_pt[page])?_pt[page]:null; %><title><%= (typeof settings!=='undefined' && settings.business_name) ? settings.business_name : 'M360' %> — <%= _ptv || t.hero_title %></title>
<link rel='manifest' href='manifest.json'>
<link rel='preconnect' href='https://fonts.googleapis.com'>
<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin>
<link href='https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap' rel='stylesheet'>
<link rel='stylesheet' href='public/css/styles.css'>
</head>
<body>
<div class='rail'>
 <div class='wrap rail-inner'>
  <div class='rail-group'>
   <span class='pill <%= status.open ? 'open' : 'closed' %> mono'><%= status.open ? t.status_open : t.status_closed %></span>
   <span class='rail-item mono'><%= status.dateLabel %></span>
   <span class='rail-sep'></span>
   <span class='rail-item mono'><%= status.hoursLabel %></span>
  </div>
  <div class='rail-group'>
   <span class='rail-item'><span class='rail-label'><%= t.status_next %></span> <span class='mono rail-next'><%= status.nextLabel %></span></span>
   <a href='rendez-vous' class='rail-book mono'><%= t.status_book %></a>
   <span class='rail-lang mono'>
    <a href='<%= (typeof currentPath!=='undefined'?currentPath:'') %>?lang=fr' class='<%= lang==='fr'?'on':'' %>'>FR</a>
    <a href='<%= (typeof currentPath!=='undefined'?currentPath:'') %>?lang=en' class='<%= lang==='en'?'on':'' %>'>EN</a>
   </span>
  </div>
 </div>
</div>
<nav class='nav'>
 <div class='wrap nav-inner'>
  <a class='brand' href='.'>
   <img class='brand-logo' src='<%= (typeof settings!=='undefined' && settings._p_nav_logo_url) ? settings._p_nav_logo_url : (typeof appIconUrl!=='undefined' && appIconUrl ? appIconUrl : 'https://placehold.co/80x80/0A0E1A/39FF6E/png?text=M') %>' data-setting-key='_p_nav_logo_url' alt='M360'>
   <span class='brand-text'>M360</span>
  </a>
  <div class='nav-links' id='navLinks'>
   <a href='.' class='<%= (typeof page!=='undefined'&&page==='home')?'active':'' %>'><%= t.nav_home %></a>
   <a href='services' class='<%= (typeof page!=='undefined'&&page==='services')?'active':'' %>'><%= t.nav_services %></a>
   <a href='galerie' class='<%= (typeof page!=='undefined'&&page==='gallery')?'active':'' %>'><%= t.nav_gallery %></a>
   <a href='actualites' class='<%= (typeof page!=='undefined'&&page==='news')?'active':'' %>'><%= t.nav_news %></a>
   <a href='contact' class='<%= (typeof page!=='undefined'&&page==='contact')?'active':'' %>'><%= t.nav_contact %></a>
   <a href='rendez-vous' class='nav-cta' style='background-color:#39FF6E;color:#0A0E1A'><%= t.nav_booking %></a>
  </div>
  <button class='hamb' id='hambBtn' aria-label='Menu'><span></span><span></span><span></span></button>
 </div>
 <div class='mobile-menu' id='mobileMenu'>
  <a href='.'><%= t.nav_home %></a>
  <a href='services'><%= t.nav_services %></a>
  <a href='galerie'><%= t.nav_gallery %></a>
  <a href='actualites'><%= t.nav_news %></a>
  <a href='contact'><%= t.nav_contact %></a>
  <a href='rendez-vous' class='mm-cta'><%= t.nav_booking %></a>
 </div>
</nav>
<script>
(function(){var b=document.getElementById('hambBtn'),m=document.getElementById('mobileMenu');if(b&&m){b.addEventListener('click',function(){m.classList.toggle('open');b.classList.toggle('active');});m.querySelectorAll('a').forEach(function(a){a.addEventListener('click',function(){m.classList.remove('open');b.classList.remove('active');});});}})();
</script>
