<%- include('partials/header') %>
<main>
 <section class='page-head'><div class='wrap'><span class='kicker'><%= t.contact_kicker %></span><h1 class='h1'><%= t.contact_title %></h1></div></section>
 <section class='section'><div class='wrap contact-grid'>
  <div>
   <form id='contactForm' class='contact-form' data-required='<%= t.form_required %>' data-sending='<%= t.contact_sending %>' data-success='<%= t.contact_success %>' data-error='<%= t.contact_error %>'>
    <div class='field'><label><%= t.contact_name %></label><input id='cName' type='text' required placeholder='<%= t.contact_name %>'></div>
    <div class='field'><label><%= t.contact_email %></label><input id='cEmail' type='email' placeholder='<%= t.contact_email %>'></div>
    <div class='field'><label><%= t.contact_phone %></label><input id='cPhone' type='tel' placeholder='<%= t.contact_phone %>'></div>
    <div class='field'><label><%= t.contact_message %></label><textarea id='cMessage' required placeholder='<%= t.contact_message %>'></textarea></div>
    <button type='submit' class='btn btn-primary' style='background-color:#39FF6E;color:#0A0E1A'><%= t.contact_send %></button>
    <p id='contactMsg' class='form-msg'></p>
   </form>
  </div>
  <div>
   <% if(typeof settings!=='undefined' && settings.business_address){ %>
    <div class='map-wrap'><div id='map' data-address='<%= settings.business_address %>'></div></div>
    <div class='loc-bar'><span class='mono'><%= settings.business_address %></span><a class='btn btn-ghost btn-sm' target='_blank' href='https://www.google.com/maps/dir/?api=1&destination=<%= encodeURIComponent(settings.business_address) %>'><%= t.loc_directions %></a></div>
   <% } else { %><div class='empty'><%= t.loc_no_address %></div><% } %>
   <div style='margin-top:18px'>
    <% if(typeof settings!=='undefined' && settings.contact_phone){ %><p class='foot-line mono'><a href='tel:<%= settings.contact_phone %>' data-setting-key='contact_phone'><%= settings.contact_phone %></a></p><% } %>
    <% if(typeof settings!=='undefined' && settings.contact_email){ %><p class='foot-line mono'><a href='mailto:<%= settings.contact_email %>' data-setting-key='contact_email'><%= settings.contact_email %></a></p><% } %>
   </div>
  </div>
 </div></section>
</main>
<%- include('partials/footer') %>
