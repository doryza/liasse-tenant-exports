<!DOCTYPE html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= moduleLabel %> · Admin</title><link rel="stylesheet" href="public/css/admin-styles.css"><link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet"></head><body class="admin-body">
<%- include('admin-sidebar') %>
<main class="admin-main">
  <header class="admin-topbar"><div class="topbar-left"><h1><%= moduleLabel %></h1><span class="topbar-count" id="itemCount"></span></div><button class="btn-primary" id="newBtn">+ Nouveau</button></header>
  <div class="admin-content">
    <div class="toolbar">
      <input type="text" id="search" class="admin-search" placeholder="Rechercher…">
      <div class="toolbar-actions"><button class="btn-ghost" id="refreshBtn">Actualiser</button></div>
    </div>
    <div id="tableWrap"><div class="admin-loading">Chargement…</div></div>
  </div>
</main>
<div id="modal" class="modal" style="display:none"><div class="modal-card"><div class="modal-head"><h3 id="modalTitle">Éditer</h3><button class="modal-x" id="modalX">&times;</button></div><div class="modal-body" id="modalBody"></div><div class="modal-foot"><button class="btn-ghost" id="cancelBtn">Annuler</button><button class="btn-primary" id="saveBtn">Enregistrer</button></div></div></div>
<div id="toast" class="toast"></div>
<script>
var MODULE='<%- moduleKey %>';var MLABEL='<%- moduleLabel %>';var FIELDS=[];var ACTIONS=[];var ITEMS=[];var editing=null;
var ROW_ACTIONS={razes:[{label:'Tirer',cls:'gold',ep:function(id){return 'api/admin/razes/'+id+'/draw';},confirm:'Lancer le tirage maintenant?'}],card_submissions:[{label:'Approuver',cls:'ok',ep:function(id){return 'api/admin/card_submissions/'+id+'/approve';}},{label:'Rejeter',cls:'danger',ep:function(id){return 'api/admin/card_submissions/'+id+'/reject';}}]};
var STATUS_FIELDS=['status','payment_status'];
var ab=document.getElementById('adminBurger'),sb=document.getElementById('adminSidebar');if(ab&&sb){ab.addEventListener('click',function(){sb.classList.toggle('open');});}
function esc(s){return (s==null?'':String(s)).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function pretty(s){return String(s).replace(/_/g,' ').replace(/\b\w/g,function(c){return c.toUpperCase();});}
function flabel(f){return f.label||pretty(f.name);}
function toast(msg,type){var el=document.getElementById('toast');if(!el)return;el.textContent=msg;el.className='toast show'+(type==='err'?' err':(type==='ok'?' ok':''));setTimeout(function(){el.className='toast';},2800);}
function toLocal(v){if(!v)return '';try{var d=new Date(v);var p=function(n){return (n<10?'0':'')+n;};return d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate())+'T'+p(d.getHours())+':'+p(d.getMinutes());}catch(e){return '';}}
function loadModules(){return fetch('api/admin/modules').then(function(r){return r.json();}).then(function(d){var m=(d.modules||[]).filter(function(x){return x.key===MODULE;})[0];if(m){FIELDS=m.fields||[];ACTIONS=m.actions||[];}});}
function loadItems(){return fetch('api/admin/'+MODULE).then(function(r){return r.json();}).then(function(d){ITEMS=d[MODULE]||[];renderTable();});}
function badge(name,v){var cls='cb-neutral';var key=String(v).toLowerCase();if(['active','approved','confirmed','published'].indexOf(key)>=0)cls='cb-active';else if(['pending','upcoming'].indexOf(key)>=0)cls='cb-pending';else if(['drawn','closed'].indexOf(key)>=0)cls='cb-drawn';else if(key==='rejected')cls='cb-rejected';return '<span class="cell-badge '+cls+'">'+esc(v)+'</span>';}
function renderTable(){var q=(document.getElementById('search').value||'').toLowerCase();var cols=FIELDS.slice(0,4);var rows=ITEMS.filter(function(it){return !q||JSON.stringify(it).toLowerCase().indexOf(q)>=0;});var cnt=document.getElementById('itemCount');if(cnt)cnt.textContent=ITEMS.length+' élément'+(ITEMS.length>1?'s':'');if(!rows.length){document.getElementById('tableWrap').innerHTML='<div class="admin-empty"><svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.3"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/></svg><p>'+(q?'Aucun résultat pour cette recherche.':'Aucun élément. Cliquez sur « + Nouveau » pour en ajouter un.')+'</p></div>';return;}var h='<div class="table-scroll"><table class="admin-table"><thead><tr><th>ID</th>';cols.forEach(function(f){h+='<th>'+esc(flabel(f))+'</th>';});h+='<th class="ta-right">Actions</th></tr></thead><tbody>';rows.forEach(function(it){h+='<tr><td>'+it.id+'</td>';cols.forEach(function(f){var v=it[f.name];if(f.type==='image'){h+='<td>'+(v?'<img class="thumb" src="'+esc(v)+'">':'—')+'</td>';}else if(f.type==='boolean'){h+='<td>'+(v==1||v===true?'<span class="bool-yes">✓ Oui</span>':'<span class="bool-no">—</span>')+'</td>';}else if(STATUS_FIELDS.indexOf(f.name)>=0&&v){h+='<td>'+badge(f.name,v)+'</td>';}else{var s=v==null?'—':String(v);if(s.length>40)s=s.slice(0,40)+'…';h+='<td>'+esc(s)+'</td>';}});h+='<td class="ta-right row-actions"><button class="btn-sm" onclick="editItem('+it.id+')">Éditer</button> <button class="btn-sm danger" onclick="delItem('+it.id+')">Suppr.</button>';var ra=ROW_ACTIONS[MODULE]||[];ra.forEach(function(a){h+=' <button class="btn-sm '+(a.cls||'')+'" onclick="rowAction('+it.id+',\''+a.label+'\')">'+esc(a.label)+'</button>';});h+='</td></tr>';});h+='</tbody></table></div>';document.getElementById('tableWrap').innerHTML=h;}
function rowAction(id,label){var ra=ROW_ACTIONS[MODULE]||[];var a=ra.filter(function(x){return x.label===label;})[0];if(!a)return;if(a.confirm&&!confirm(a.confirm))return;fetch(a.ep(id),{method:'POST'}).then(function(r){return r.json();}).then(function(d){if(d.error){toast(d.error,'err');return;}if(d.winner!==undefined){toast('Gagnant: '+(d.winner||'aucun (aucune entrée confirmée)'),'ok');}else{toast('Action effectuée','ok');}loadItems();}).catch(function(){toast('Erreur','err');});}
function fieldInput(f,val){var id='f_'+f.name;var v=val==null?(f.default!==undefined?f.default:''):val;if(f.type==='textarea')return '<textarea id="'+id+'" rows="4" '+(f.placeholder?'placeholder="'+esc(f.placeholder)+'"':'')+'>'+esc(v)+'</textarea>';if(f.type==='boolean')return '<input type="checkbox" id="'+id+'" '+((v==1||v===true||v==='true')?'checked':'')+'>';if(f.type==='select'){var o='';(f.options||[]).forEach(function(op){o+='<option value="'+esc(op)+'" '+(String(v)===String(op)?'selected':'')+'>'+esc(op)+'</option>';});return '<select id="'+id+'"><option value=""></option>'+o+'</select>';}if(f.type==='number')return '<input type="number" id="'+id+'" value="'+esc(v)+'" '+(f.min!=null?'min="'+f.min+'"':'')+' '+(f.max!=null?'max="'+f.max+'"':'')+' '+(f.step!=null?'step="'+f.step+'"':'')+' '+(f.placeholder?'placeholder="'+esc(f.placeholder)+'"':'')+'>';if(f.type==='datetime')return '<input type="datetime-local" id="'+id+'" value="'+toLocal(v)+'">';if(f.type==='date')return '<input type="date" id="'+id+'" value="'+esc(v?String(v).slice(0,10):'')+'">';if(f.type==='image')return '<div class="img-field"><input type="text" id="'+id+'" value="'+esc(v)+'" placeholder="URL de l’image"><div class="img-tools"><label class="btn-sm upl">Téléverser<input type="file" accept="image/*" style="display:none" onchange="uploadImg(this,\''+id+'\')"></label><button type="button" class="btn-sm gold" onclick="genImg(\''+id+'\')">Générer IA</button></div><div id="'+id+'_prev" class="img-prev">'+(v?'<img src="'+esc(v)+'">':'')+'</div></div>';return '<input type="text" id="'+id+'" value="'+esc(v)+'" '+(f.placeholder?'placeholder="'+esc(f.placeholder)+'"':'')+'>';}
function openModal(item){editing=item;document.getElementById('modalTitle').textContent=item?('Éditer · '+MLABEL):('Nouveau · '+MLABEL);var b='';FIELDS.forEach(function(f){var isCheck=(f.type==='boolean');b+='<label class="admin-field'+(isCheck?' is-checkbox':'')+'"><span>'+esc(flabel(f))+(f.required?' <span class="req">*</span>':'')+'</span>'+fieldInput(f,item?item[f.name]:undefined)+(f.description?'<small>'+esc(f.description)+'</small>':'')+'</label>';});document.getElementById('modalBody').innerHTML=b;document.getElementById('modal').style.display='flex';}
function editItem(id){var it=ITEMS.filter(function(x){return x.id===id;})[0];openModal(it);}
function closeModal(){document.getElementById('modal').style.display='none';editing=null;}
function collect(){var o={};FIELDS.forEach(function(f){var el=document.getElementById('f_'+f.name);if(!el)return;if(f.type==='boolean')o[f.name]=el.checked;else o[f.name]=el.value;});return o;}
function save(){var data=collect();var missing=FIELDS.filter(function(f){return f.required&&(data[f.name]===''||data[f.name]==null);});if(missing.length){toast('Champ requis: '+flabel(missing[0]),'err');return;}var url='api/admin/'+MODULE+(editing?'/'+editing.id:'');var method=editing?'PUT':'POST';var btn=document.getElementById('saveBtn');btn.disabled=true;fetch(url,{method:method,headers:{'Content-Type':'application/json'},body:JSON.stringify(data)}).then(function(r){return r.json();}).then(function(d){btn.disabled=false;if(d.error){toast(d.error,'err');return;}closeModal();toast(editing?'Modifications enregistrées':'Élément créé','ok');loadItems();}).catch(function(){btn.disabled=false;toast('Erreur','err');});}
function delItem(id){if(!confirm('Supprimer cet élément? Cette action est irréversible.'))return;fetch('api/admin/'+MODULE+'/'+id,{method:'DELETE'}).then(function(r){return r.json();}).then(function(d){if(d.error){toast(d.error,'err');return;}toast('Élément supprimé','ok');loadItems();}).catch(function(){toast('Erreur','err');});}
function uploadImg(input,id){var f=input.files[0];if(!f)return;var prev=document.getElementById(id+'_prev');prev.innerHTML='<span class="muted">Téléversement…</span>';var rd=new FileReader();rd.onload=function(){fetch('api/admin/upload-image',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({dataUri:rd.result})}).then(function(r){return r.json();}).then(function(d){if(d.url){document.getElementById(id).value=d.url;prev.innerHTML='<img src="'+d.url+'">';toast('Image téléversée','ok');}else{prev.innerHTML='';toast(d.error||'Erreur','err');}}).catch(function(){prev.innerHTML='';toast('Erreur','err');});};rd.readAsDataURL(f);}
function genImg(id){var p=prompt('Décrivez l’image à générer:');if(!p)return;var prev=document.getElementById(id+'_prev');prev.innerHTML='<span class="muted">Génération…</span>';fetch('api/admin/generate-image',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({prompt:p,aspectRatio:'3:4'})}).then(function(r){return r.json();}).then(function(d){if(d.url){document.getElementById(id).value=d.url;prev.innerHTML='<img src="'+d.url+'">';toast('Image générée','ok');}else{prev.innerHTML='';toast(d.error||'Erreur','err');}}).catch(function(){prev.innerHTML='';toast('Erreur','err');});}
document.getElementById('newBtn').addEventListener('click',function(){openModal(null);});
document.getElementById('refreshBtn').addEventListener('click',function(){loadItems();toast('Liste actualisée','ok');});
document.getElementById('modalX').addEventListener('click',closeModal);
document.getElementById('cancelBtn').addEventListener('click',closeModal);
document.getElementById('saveBtn').addEventListener('click',save);
document.getElementById('search').addEventListener('input',renderTable);
document.getElementById('modal').addEventListener('click',function(e){if(e.target===this)closeModal();});
loadModules().then(loadItems);
</script>
</body></html>