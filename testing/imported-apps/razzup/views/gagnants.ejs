<%- include('partials/header') %>
<section class="page-head"><div class="container"><span class="eyebrow"><%= t.home_winners_eyebrow %></span><h1><%= t.winners_title %></h1><p><%= t.winners_sub %></p></div></section>
<section class="section"><div class="container">
  <% if(typeof winners!=='undefined' && winners.length){ %>
    <div class="winners-grid"><% winners.forEach(function(w){ %>
      <div class="winner-card">
        <div class="winner-card-media"><img src="<%= w.image_url || 'https://placehold.co/300x400/1c2030/c2982e/png?text=W' %>" alt="<%= w.card_name %>"><span class="seal mini"><svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="30" fill="#fff" stroke="#bd962f" stroke-width="2"/><path d="M32 16l3.6 7.3 8 1.2-5.8 5.6 1.4 8L32 41.5 24.8 45.3l1.4-8-5.8-5.6 8-1.2z" fill="#bd962f"/></svg></span></div>
        <div class="winner-card-body"><h3><%= w.winner_name %></h3><p class="wc-raze"><%= w.raze_title %></p><div class="wc-meta"><span><%= t.winner_date %>: <%= fmtDate(w.draw_date) %></span><% if(w.total_tickets){ %><span><%= w.total_tickets %> <%= t.winner_tickets %></span><% } %></div><% if(w.draw_proof){ %><div class="proof small"><span><%= t.winner_proof %></span><code><%= w.draw_proof %></code></div><% } %></div>
      </div>
    <% }); %></div>
  <% } else { %><div class="empty"><%= t.empty_winners %></div><% } %>
</div></section>
<%- include('partials/footer') %>