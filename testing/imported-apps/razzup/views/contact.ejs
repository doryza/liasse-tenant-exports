<%- include('partials/header') %>
<section class="page-head"><div class="container"><span class="eyebrow">RAZZ·UP</span><h1><%= t.contact_title %></h1><p><%= t.contact_sub %></p></div></section>
<section class="section"><div class="container contact-grid">
  <form id="contactForm" class="form-card">
    <label class="field"><span><%= t.contact_name %> *</span><input type="text" id="cName" required></label>
    <label class="field"><span><%= t.contact_email %></span><input type="email" id="cEmail"></label>
    <label class="field"><span><%= t.contact_subject %></span><input type="text" id="cSubject"></label>
    <label class="field"><span><%= t.contact_message %> *</span><textarea id="cMessage" rows="5" required></textarea></label>
    <button type="submit" class="btn btn-primary btn-lg" style="background-color:#6366f1;color:#fff"><%= t.contact_send %></button>
    <div id="contactResult"></div>
  </form>
  <aside class="contact-info"><h3><%= t.contact_info_title %></h3><% if(info.contactEmail){ %><p><strong><%= t.contact_email %></strong><br><%= info.contactEmail %></p><% } %><% if(info.contactPhone){ %><p><strong>Tél.</strong><br><%= info.contactPhone %></p><% } %><% if(info.address){ %><p><%= info.address %></p><% } %><span class="seal small"><svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="30" fill="#fff" stroke="#bd962f" stroke-width="1.5"/><path d="M32 16l3.6 7.3 8 1.2-5.8 5.6 1.4 8L32 41.5 24.8 45.3l1.4-8-5.8-5.6 8-1.2z" fill="#bd962f"/></svg></span></aside>
</div></section>
<%- include('partials/footer') %>