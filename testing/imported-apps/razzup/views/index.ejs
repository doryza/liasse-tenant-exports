<%- include('partials/header') %>
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow"><%= t.hero_eyebrow %></span>
      <h1 class="hero-title"><%= t.hero_title %></h1>
      <p class="hero-sub"><%= t.hero_sub %></p>
      <div class="hero-cta">
        <a href="razes" class="btn btn-primary btn-lg" style="background-color:#6366f1;color:#fff"><%= t.hero_cta %></a>
        <a href="transparence" class="btn btn-outline btn-lg"><%= t.hero_cta2 %></a>
      </div>
      <div class="hero-stats">
        <div><strong><%= stats.activeCount %></strong><span><%= t.stat_active %></span></div>
        <div><strong><%= stats.members %>+</strong><span><%= t.stat_members %></span></div>
        <div><strong><%= stats.winners %></strong><span><%= t.stat_winners %></span></div>
      </div>
    </div>
    <div class="hero-media">
      <img src="<%= (typeof settings!=='undefined' && settings._p_hero_image_url) ? settings._p_hero_image_url : 'https://placehold.co/900x600/1c2030/c2982e/png?text=RAZZ-UP' %>" alt="RAZZ·UP">
      <span class="hero-seal"><svg viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="30" fill="#fff" stroke="#bd962f" stroke-width="1.5"/><circle cx="32" cy="32" r="24" fill="none" stroke="#bd962f" stroke-width="1"/><path d="M32 16l3.6 7.3 8 1.2-5.8 5.6 1.4 8L32 41.5 24.8 45.3l1.4-8-5.8-5.6 8-1.2z" fill="#bd962f"/></svg><b>Certifié</b></span>
    </div>
  </div>
</section>

<section class="section gold-top" id="razes-board">
  <div class="container">
    <div class="section-head">
      <div><span class="eyebrow"><%= t.home_active_eyebrow %></span><h2><%= t.home_active_title %></h2></div>
      <a href="razes" class="link-gold"><%= t.view_all %> →</a>
    </div>
    <% if(typeof activeRazes!=='undefined' && activeRazes.length){ %>
      <div class="raze-grid"><% activeRazes.forEach(function(r){ %><%- include('partials/razecard', { r:r, t:t, lang:lang, formatPrice:formatPrice, fmtDate:fmtDate }) %><% }); %></div>
    <% } else { %><div class="empty"><%= t.empty_razes %></div><% } %>
  </div>
</section>

<section class="section band-ink">
  <div class="container">
    <div class="section-head center"><div><span class="eyebrow gold"><%= t.home_how_eyebrow %></span><h2 class="on-ink"><%= t.home_how_title %></h2></div></div>
    <div class="steps">
      <div class="step"><span class="step-n">1</span><h3><%= t.how1_t %></h3><p><%= t.how1_d %></p></div>
      <div class="step"><span class="step-n">2</span><h3><%= t.how2_t %></h3><p><%= t.how2_d %></p></div>
      <div class="step"><span class="step-n">3</span><h3><%= t.how3_t %></h3><p><%= t.how3_d %></p></div>
      <div class="step"><span class="step-n">4</span><h3><%= t.how4_t %></h3><p><%= t.how4_d %></p></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head"><div><span class="eyebrow"><%= t.home_trust_eyebrow %></span><h2><%= t.home_trust_title %></h2></div></div>
    <div class="trust-grid">
      <a href="transparence" class="trust-card"><span class="trust-icn"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="#bd962f" stroke-width="1.5"><path d="M12 3l8 3v6c0 5-3.4 7.7-8 9-4.6-1.3-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg></span><h3><%= t.trust1_t %></h3><p><%= t.trust1_d %></p></a>
      <a href="vendeurs" class="trust-card"><span class="trust-icn"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="#bd962f" stroke-width="1.5"><path d="M12 2l2.4 4.9 5.4.8-3.9 3.8.9 5.3L12 14.9 7.2 17.6l.9-5.3L4.2 8.5l5.4-.8z"/></svg></span><h3><%= t.trust2_t %></h3><p><%= t.trust2_d %></p></a>
      <a href="transparence#remboursement" class="trust-card"><span class="trust-icn"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="#bd962f" stroke-width="1.5"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/></svg></span><h3><%= t.trust3_t %></h3><p><%= t.trust3_d %></p></a>
    </div>
  </div>
</section>

<section class="section gold-top">
  <div class="container">
    <div class="section-head"><div><span class="eyebrow"><%= t.home_sellers_eyebrow %></span><h2><%= t.home_sellers_title %></h2></div><a href="vendeurs" class="link-gold"><%= t.view_all %> →</a></div>
    <% if(typeof featuredSellers!=='undefined' && featuredSellers.length){ %>
      <div class="seller-grid"><% featuredSellers.forEach(function(s){ %>
        <a class="seller-card" href="vendeurs/<%= s.id %>">
          <img src="<%= s.image_url || 'https://placehold.co/200x200/1c2030/e8d8a4/png?text=V' %>" alt="<%= s.name %>">
          <div class="seller-info"><h3><%= s.name %><% if(s.verified){ %> <span class="vbadge" title="<%= t.seller_verified %>"><svg viewBox="0 0 24 24" width="15" height="15" fill="#bd962f"><path d="M12 2l2.4 2.3 3.2-.4 1 3.1 2.7 1.8-1.3 3 1.3 3-2.7 1.8-1 3.1-3.2-.4L12 22l-2.4-2.3-3.2.4-1-3.1L2.7 15l1.3-3-1.3-3 2.7-1.8 1-3.1 3.2.4z"/><path d="M8.5 12l2.2 2.2 4.3-4.3" stroke="#fff" stroke-width="1.6" fill="none"/></svg></span><% } %></h3><span class="seller-rating">★ <%= (s.rating||5).toFixed(1) %> · <%= s.total_sales||0 %> <%= t.seller_sales %></span></div>
        </a>
      <% }); %></div>
    <% } else { %><div class="empty"><%= t.empty_sellers %></div><% } %>
  </div>
</section>

<section class="section band-paper">
  <div class="container">
    <div class="section-head"><div><span class="eyebrow"><%= t.home_winners_eyebrow %></span><h2><%= t.home_winners_title %></h2></div><a href="gagnants" class="link-gold"><%= t.view_all %> →</a></div>
    <% if(typeof recentWinners!=='undefined' && recentWinners.length){ %>
      <div class="winner-row"><% recentWinners.forEach(function(w){ %>
        <div class="winner-chip"><img src="<%= w.image_url || 'https://placehold.co/120x160/1c2030/c2982e/png?text=W' %>" alt="<%= w.card_name %>"><div><strong><%= w.winner_name %></strong><span><%= w.raze_title %></span><small><%= fmtDate(w.draw_date) %></small></div></div>
      <% }); %></div>
    <% } else { %><div class="empty"><%= t.empty_winners %></div><% } %>
  </div>
</section>

<% if(typeof posts!=='undefined' && posts.length){ %>
<section class="section">
  <div class="container">
    <div class="section-head"><div><span class="eyebrow"><%= t.home_news_eyebrow %></span><h2><%= t.home_news_title %></h2></div><a href="actualites" class="link-gold"><%= t.view_all %> →</a></div>
    <div class="post-grid"><% posts.forEach(function(p){ %>
      <a class="post-card" href="actualites/<%= p.id %>"><img src="<%= p.image_url || 'https://placehold.co/600x400/eee/999/png?text=Article' %>" alt="<%= p.title %>"><div class="post-body"><% if(p.category){ %><span class="post-cat"><%= p.category %></span><% } %><h3><%= p.title %></h3></div></a>
    <% }); %></div>
  </div>
</section>
<% } %>

<section class="cta-band">
  <div class="container cta-inner">
    <div><span class="eyebrow gold"><%= t.home_sellers_eyebrow %></span><h2 class="on-ink"><%= t.cta_title %></h2><p class="on-ink-sub"><%= t.cta_sub %></p></div>
    <a href="soumettre" class="btn btn-gold btn-lg" style="background-color:#bd962f;color:#16181d"><%= t.cta_btn %></a>
  </div>
</section>
<%- include('partials/footer') %>