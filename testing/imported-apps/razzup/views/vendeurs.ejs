<%- include('partials/header') %>
<section class="page-head"><div class="container"><span class="eyebrow"><%= t.home_sellers_eyebrow %></span><h1><%= t.sellers_title %></h1><p><%= t.sellers_sub %></p></div></section>
<section class="section"><div class="container">
  <% if(typeof sellers!=='undefined' && sellers.length){ %>
    <div class="seller-grid wide"><% sellers.forEach(function(s){ %>
      <a class="seller-card" href="vendeurs/<%= s.id %>">
        <img src="<%= s.image_url || 'https://placehold.co/200x200/1c2030/e8d8a4/png?text=V' %>" alt="<%= s.name %>">
        <div class="seller-info"><h3><%= s.name %><% if(s.verified){ %> <span class="vbadge"><svg viewBox="0 0 24 24" width="15" height="15" fill="#bd962f"><path d="M12 2l2.4 2.3 3.2-.4 1 3.1 2.7 1.8-1.3 3 1.3 3-2.7 1.8-1 3.1-3.2-.4L12 22l-2.4-2.3-3.2.4-1-3.1L2.7 15l1.3-3-1.3-3 2.7-1.8 1-3.1 3.2.4z"/><path d="M8.5 12l2.2 2.2 4.3-4.3" stroke="#fff" stroke-width="1.6" fill="none"/></svg></span><% } %></h3><% if(s.location){ %><span class="seller-loc"><%= s.location %></span><% } %><span class="seller-rating">★ <%= (s.rating||5).toFixed(1) %> · <%= s.total_sales||0 %> <%= t.seller_sales %></span></div>
      </a>
    <% }); %></div>
  <% } else { %><div class="empty"><%= t.empty_sellers %></div><% } %>
</div></section>
<%- include('partials/footer') %>