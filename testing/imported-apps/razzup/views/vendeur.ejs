<%- include('partials/header') %>
<section class="section"><div class="container">
  <a href="vendeurs" class="back-link">← <%= t.back_to_sellers %></a>
  <div class="seller-hero">
    <img src="<%= seller.image_url || 'https://placehold.co/240x240/1c2030/e8d8a4/png?text=V' %>" alt="<%= seller.name %>">
    <div>
      <h1><%= seller.name %><% if(seller.verified){ %> <span class="vbadge big"><svg viewBox="0 0 24 24" width="22" height="22" fill="#bd962f"><path d="M12 2l2.4 2.3 3.2-.4 1 3.1 2.7 1.8-1.3 3 1.3 3-2.7 1.8-1 3.1-3.2-.4L12 22l-2.4-2.3-3.2.4-1-3.1L2.7 15l1.3-3-1.3-3 2.7-1.8 1-3.1 3.2.4z"/><path d="M8.5 12l2.2 2.2 4.3-4.3" stroke="#fff" stroke-width="1.8" fill="none"/></svg></span><% } %></h1>
      <div class="seller-stats"><span>★ <%= (seller.rating||5).toFixed(1) %></span><span><%= seller.total_sales||0 %> <%= t.seller_sales %></span><% if(seller.member_since){ %><span><%= t.seller_member_since %> <%= seller.member_since %></span><% } %><% if(seller.location){ %><span><%= seller.location %></span><% } %></div>
      <% if(seller.contact_email){ %><a href="messages?to=<%= encodeURIComponent(seller.contact_email) %>" class="btn btn-outline btn-sm" data-auth-only style="display:none"><%= t.seller_contact %></a><a href="#" class="btn btn-outline btn-sm" data-login-btn><%= t.seller_contact %></a><% } %>
    </div>
  </div>
  <% if(seller.bio){ %><div class="seller-bio"><h2><%= t.seller_about %></h2><p><%= seller.bio %></p></div><% } %>
  <h2 class="gold-top pt"><%= t.seller_active_razes %></h2>
  <% if(typeof sellerRazes!=='undefined' && sellerRazes.length){ %>
    <div class="raze-grid"><% sellerRazes.forEach(function(r){ %><%- include('partials/razecard', { r:r, t:t, lang:lang, formatPrice:formatPrice, fmtDate:fmtDate }) %><% }); %></div>
  <% } else { %><div class="empty"><%= t.empty_razes %></div><% } %>
  <h2 class="gold-top pt"><%= t.seller_reviews %></h2>
  <div class="review-form-wrap">
    <a href="#" class="btn btn-outline btn-sm" data-login-btn><%= t.review_login %></a>
    <form id="reviewForm" data-seller-id="<%= seller.id %>" data-auth-only style="display:none" class="review-form">
      <label class="field"><span><%= t.review_rating %></span><select id="revRating"><option value="5">★★★★★</option><option value="4">★★★★</option><option value="3">★★★</option><option value="2">★★</option><option value="1">★</option></select></label>
      <label class="field"><span><%= t.review_comment %></span><textarea id="revContent" rows="3"></textarea></label>
      <button type="submit" class="btn btn-primary btn-sm" style="background-color:#6366f1;color:#fff"><%= t.review_submit %></button>
    </form>
  </div>
  <div id="reviewList">
  <% if(typeof reviews!=='undefined' && reviews.length){ %>
    <% reviews.forEach(function(rv){ %><div class="review"><div class="review-head"><strong><%= rv.author_name||'Membre' %></strong><span class="stars"><% for(var i=0;i<(rv.rating||5);i++){ %>★<% } %></span></div><p><%= rv.content %></p></div><% }); %>
  <% } else { %><div class="empty"><%= t.empty_reviews %></div><% } %>
  </div>
</div></section>
<%- include('partials/footer') %>