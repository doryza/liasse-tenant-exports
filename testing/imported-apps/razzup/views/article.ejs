<%- include('partials/header') %>
<section class="section"><div class="container narrow">
  <a href="actualites" class="back-link">← <%= t.back_to_news %></a>
  <% if(post.category){ %><span class="post-cat"><%= post.category %></span><% } %>
  <h1 class="article-title"><%= post.title %></h1>
  <p class="article-date"><%= fmtDate(post.created_at) %></p>
  <% if(post.image_url){ %><img class="article-img" src="<%= post.image_url %>" alt="<%= post.title %>"><% } %>
  <div class="article-body"><% (post.content||'').split('\n').forEach(function(par){ if(par.trim()){ %><p><%= par %></p><% } }); %></div>
</div></section>
<%- include('partials/footer') %>