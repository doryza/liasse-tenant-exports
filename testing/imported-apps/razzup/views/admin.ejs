<!DOCTYPE html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin · RAZZ·UP</title><link rel="stylesheet" href="public/css/admin-styles.css"><link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet"></head><body class="admin-body">
<%- include('partials/admin-sidebar') %>
<main class="admin-main">
  <header class="admin-topbar"><div class="topbar-left"><h1>Tableau de bord</h1><span class="topbar-sub">Vue d’ensemble de la maison RAZZ·UP</span></div><span class="admin-user"><span class="admin-user-dot"></span><%= adminUser.name %></span></header>
  <div class="admin-content">
    <% var needsAttention = (stats.pendingSubs>0) || (pendingEntries && pendingEntries.length>0); %>
    <% if(needsAttention){ %>
    <div class="admin-alert">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
      <div><strong>Actions en attente</strong><span><%= (pendingEntries?pendingEntries.length:0) %> paiement(s) e-transfer · <%= stats.pendingSubs %> soumission(s) à examiner</span></div>
      <div class="admin-alert-actions"><a href="admin/card_submissions" class="btn-sm">Soumissions</a></div>
    </div>
    <% } %>
    <div class="stat-grid">
      <div class="stat stat-accent"><span class="stat-ic"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14 7l3 3M5 19l9-9M3 17l4 4M11 4l5 5"/></svg></span><span class="stat-n"><%= stats.activeRazes %></span><span class="stat-l">Razes actifs</span></div>
      <div class="stat"><span class="stat-ic"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg></span><span class="stat-n"><%= stats.pendingSubs %></span><span class="stat-l">Soumissions en attente</span></div>
      <div class="stat"><span class="stat-ic"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="9" cy="7" r="3"/><path d="M2 21c0-3 3-5 7-5s7 2 7 5"/></svg></span><span class="stat-n"><%= stats.userCount %></span><span class="stat-l">Membres</span></div>
      <div class="stat"><span class="stat-ic"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg></span><span class="stat-n"><%= stats.pushCount %></span><span class="stat-l">Abonnés push</span></div>
      <div class="stat"><span class="stat-ic"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></span><span class="stat-n"><%= stats.totalVisits %></span><span class="stat-l">Visites totales</span></div>
      <div class="stat"><span class="stat-ic"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 3v18h18"/><path d="M7 14l4-4 3 3 5-6"/></svg></span><span class="stat-n"><%= stats.recentVisits %></span><span class="stat-l">Visites (7j)</span></div>
    </div>
    <h2 class="admin-section-title">Contenu géré</h2>
    <div class="admin-cards">
      <a class="admin-card" href="admin/razes"><span class="admin-card-ic"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14 7l3 3M5 19l9-9M3 17l4 4M11 4l5 5"/></svg></span><strong><%= counts.razes||0 %></strong><span>Razes</span></a>
      <a class="admin-card" href="admin/card_submissions"><span class="admin-card-ic"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg></span><strong><%= counts.card_submissions||0 %></strong><span>Soumissions</span></a>
      <a class="admin-card" href="admin/sellers"><span class="admin-card-ic"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="9" cy="7" r="3"/><path d="M2 21c0-3 3-5 7-5s7 2 7 5"/></svg></span><strong><%= counts.sellers||0 %></strong><span>Vendeurs</span></a>
      <a class="admin-card" href="admin/reviews"><span class="admin-card-ic"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3l2.5 5 5.5.8-4 3.9 1 5.5L12 16l-5 2.7 1-5.5-4-3.9 5.5-.8z"/></svg></span><strong><%= counts.reviews||0 %></strong><span>Évaluations</span></a>
      <a class="admin-card" href="admin/winners"><span class="admin-card-ic"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 4h12v3a6 6 0 0 1-12 0z"/><path d="M9 14h6M10 18h4M12 10v4"/></svg></span><strong><%= counts.winners||0 %></strong><span>Gagnants</span></a>
      <a class="admin-card" href="admin/posts"><span class="admin-card-ic"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></span><strong><%= counts.posts||0 %></strong><span>Actualités</span></a>
    </div>
    <section class="admin-block">
      <div class="admin-block-head"><h2>Paiements e-transfer en attente</h2><% if(pendingEntries && pendingEntries.length){ %><span class="pill pill-warn"><%= pendingEntries.length %></span><% } %></div>
      <% if(pendingEntries && pendingEntries.length){ %>
      <div class="table-scroll"><table class="admin-table"><thead><tr><th>Raze</th><th>Membre</th><th>Qté</th><th>Montant</th><th>Réf.</th><th class="ta-right">Actions</th></tr></thead><tbody>
        <% pendingEntries.forEach(function(e){ %><tr id="ent-<%= e.id %>"><td><%= e.raze_title||('#'+e.raze_id) %></td><td><%= e.user_name %><br><small class="muted"><%= e.user_email %></small></td><td><%= e.quantity %></td><td><strong><%= formatPrice(e.amount) %></strong></td><td><code><%= e.etransfer_ref %></code></td><td class="ta-right row-actions"><button class="btn-sm ok" onclick="confirmEntry(<%= e.id %>,this)">Confirmer</button> <button class="btn-sm danger" onclick="delEntry(<%= e.id %>,this)">Supprimer</button></td></tr><% }); %>
      </tbody></table></div>
      <% } else { %><div class="admin-empty"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M20 6 9 17l-5-5"/></svg><p>Aucun paiement en attente. Tout est à jour.</p></div><% } %>
    </section>
    <section class="admin-block">
      <div class="admin-block-head"><h2>Messages de contact récents</h2></div>
      <% if(msgs && msgs.length){ %>
      <div class="table-scroll"><table class="admin-table"><thead><tr><th>Nom</th><th>Courriel</th><th>Sujet</th><th>Message</th></tr></thead><tbody>
        <% msgs.forEach(function(m){ %><tr><td><%= m.name %></td><td><small class="muted"><%= m.email %></small></td><td><%= m.subject %></td><td><%= (m.message||'').slice(0,120) %></td></tr><% }); %>
      </tbody></table></div>
      <% } else { %><div class="admin-empty"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg><p>Aucun message reçu pour l’instant.</p></div><% } %>
    </section>
  </div>
</main>
<div id="toast" class="toast"></div>
<script>
var ab=document.getElementById('adminBurger'),sb=document.getElementById('adminSidebar');if(ab&&sb){ab.addEventListener('click',function(){sb.classList.toggle('open');});}
function toast(msg,type){var el=document.getElementById('toast');if(!el)return;el.textContent=msg;el.className='toast show'+(type==='err'?' err':(type==='ok'?' ok':''));setTimeout(function(){el.className='toast';},2800);}
function confirmEntry(id,btn){btn.disabled=true;fetch('api/admin/entries/'+id+'/confirm',{method:'POST'}).then(function(r){return r.json();}).then(function(d){var row=document.getElementById('ent-'+id);if(d.success&&row){row.remove();toast('Paiement confirmé','ok');}else{btn.disabled=false;toast(d.error||'Erreur','err');}}).catch(function(){btn.disabled=false;toast('Erreur','err');});}
function delEntry(id,btn){if(!confirm('Supprimer cette entrée?'))return;btn.disabled=true;fetch('api/admin/entries/'+id,{method:'DELETE'}).then(function(r){return r.json();}).then(function(d){var row=document.getElementById('ent-'+id);if(d.success&&row){row.remove();toast('Entrée supprimée','ok');}else{btn.disabled=false;toast(d.error||'Erreur','err');}}).catch(function(){btn.disabled=false;toast('Erreur','err');});}
</script>
</body></html>