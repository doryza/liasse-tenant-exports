<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tableau de bord · Tandoori Route</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="public/css/admin-styles.css">
</head>
<body class="admin-body">
<%- include('partials/admin-sidebar', { active: 'dashboard' }) %>
<div class="admin-main">
  <header class="admin-topbar">
    <button class="sb-toggle" id="sbToggle" aria-label="Menu">&#9776;</button>
    <h1>Tableau de bord</h1>
    <a class="btn-primary" href="." target="_blank">Voir le site &#8599;</a>
  </header>
  <div class="admin-content">
    <div class="welcome-banner">
      <div>
        <h2>Bienvenue &#128075;</h2>
        <p>Gérez ici tout le contenu de votre site Tandoori Route : galerie de plats, avis, nouvelles, heures d'ouverture et liens importants.</p>
      </div>
      <a class="btn-light-admin" href="admin/dishes">Gérer la galerie</a>
    </div>

    <div class="stat-grid">
      <div class="stat"><span class="stat-ico">&#128202;</span><div class="stat-text"><span class="stat-num"><%= stats.visits %></span><span class="stat-label">Visites totales</span></div></div>
      <div class="stat"><span class="stat-ico">&#128197;</span><div class="stat-text"><span class="stat-num"><%= stats.recent %></span><span class="stat-label">Visites (7 jours)</span></div></div>
      <div class="stat"><span class="stat-ico">&#128101;</span><div class="stat-text"><span class="stat-num"><%= stats.users %></span><span class="stat-label">Membres</span></div></div>
      <div class="stat"><span class="stat-ico">&#128276;</span><div class="stat-text"><span class="stat-num"><%= stats.push %></span><span class="stat-label">Abonnés notif.</span></div></div>
    </div>

    <% var social = (settings && (settings.facebook_url||settings.instagram_url||settings.tiktok_url)); %>
    <% var checks = [
      {ok: !!(settings && settings.order_online_url && settings.order_online_url.trim()), title:'Lien de commande en ligne', okText:'Lien configuré', warnText:'Ajoutez le lien vers votre plateforme de commande.', link:'admin/settings'},
      {ok: !!(settings && settings.google_reviews_url && settings.google_reviews_url.trim()), title:'Avis Google', okText:'Lien ajouté', warnText:'Ajoutez le lien vers vos avis Google.', link:'admin/settings'},
      {ok: !!social, title:'Réseaux sociaux', okText:'Au moins un réseau lié', warnText:'Ajoutez vos liens Facebook / Instagram / TikTok.', link:'admin/settings'},
      {ok: stats.dishes>0, title:'Galerie de plats', okText: stats.dishes + ' plat(s) en ligne', warnText:'Ajoutez des plats à la galerie.', link:'admin/dishes'}
    ]; %>
    <h2 class="sec-title">Configuration</h2>
    <div class="checklist">
      <% checks.forEach(function(c){ %>
      <div class="check-item <%= c.ok?'check-ok':'check-warn' %>">
        <span class="check-badge"><%= c.ok?'\u2713':'!' %></span>
        <div>
          <h4><%= c.title %></h4>
          <% if(c.ok){ %><p><%= c.okText %></p><% } else { %><p><%= c.warnText %></p><a href="<%= c.link %>">Configurer &rarr;</a><% } %>
        </div>
      </div>
      <% }); %>
    </div>

    <h2 class="sec-title">Gérer le contenu</h2>
    <div class="module-grid">
      <a class="module-card" href="admin/dishes"><span class="m-ico">&#127835;</span><h3>Plats / Galerie</h3><p><%= stats.dishes %> élément(s)</p></a>
      <a class="module-card" href="admin/reviews"><span class="m-ico">&#11088;</span><h3>Avis Google</h3><p><%= stats.reviews %> avis</p></a>
      <a class="module-card" href="admin/posts"><span class="m-ico">&#128240;</span><h3>Nouvelles</h3><p><%= stats.posts %> article(s)</p></a>
      <a class="module-card" href="admin/hours"><span class="m-ico">&#128336;</span><h3>Heures</h3><p><%= stats.hours %> entrée(s)</p></a>
      <a class="module-card" href="admin/settings"><span class="m-ico">&#9881;</span><h3>Paramètres</h3><p>Liens &amp; coordonnées</p></a>
    </div>

    <h2 class="sec-title">Messages reçus (<%= stats.submissions %>)</h2>
    <% if(subs && subs.length){ %>
    <div class="table-scroll">
    <table class="admin-table">
      <thead><tr><th>Nom</th><th>Coordonnées</th><th>Message</th><th>Date</th></tr></thead>
      <tbody>
        <% subs.forEach(function(s){ %>
        <tr><td><%= s.name %></td><td><%= s.email||'' %><%= s.phone?(' · '+s.phone):'' %></td><td title="<%= s.message||'' %>"><%= (s.message||'').slice(0,80) %><%= (s.message && s.message.length>80)?'…':'' %></td><td><%= fmt(s.created_at) %></td></tr>
        <% }); %>
      </tbody>
    </table>
    </div>
    <% } else { %>
    <div class="empty">Aucun message pour le moment. Les messages du formulaire de contact apparaîtront ici.</div>
    <% } %>
  </div>
</div>
<script>
document.getElementById('sbToggle').addEventListener('click',function(){document.getElementById('adminSidebar').classList.toggle('open');});
</script>
</body>
</html>
