<%- include('partials/header') %>
<section class="page-head section-dark">
  <div class="container center">
    <span class="eyebrow"><%= t.contact_eyebrow %></span>
    <h1><%= t.contact_title %></h1>
    <p class="lead"><%= t.contact_subtitle %></p>
  </div>
</section>
<section class="section">
  <div class="container split contact-layout">
    <div class="contact-info">
      <h2><%= t.info_title %></h2>
      <ul class="info-list">
        <li><span class="ico">&#128205;</span><div><strong><%= t.address_label %></strong><p><%= settings.business_address || 'Blainville, QC' %></p></div></li>
        <% if(settings.contact_phone){ %><li><span class="ico">&#128222;</span><div><strong><%= t.phone_label %></strong><p><a href="tel:<%= settings.contact_phone %>"><%= settings.contact_phone %></a></p></div></li><% } %>
        <% if(settings.contact_email){ %><li><span class="ico">&#9993;</span><div><strong><%= t.email_label %></strong><p><a href="mailto:<%= settings.contact_email %>"><%= settings.contact_email %></a></p></div></li><% } %>
      </ul>
      <h2 class="mt"><%= t.hours_title %></h2>
      <ul class="hours-list">
        <% if(typeof hours!=='undefined' && hours.length){ hours.forEach(function(h){ %>
        <li><span class="day"><%= lang==='en'?(h.day_en||h.day_fr):(h.day_fr||h.day_en) %></span><span class="time <%= h.closed==1?'closed':'' %>"><%= h.closed==1?t.closed:h.hours_text %></span></li>
        <% }); } else { %>
        <li><%= t.hours_soon %></li>
        <% } %>
      </ul>
      <% if(settings.facebook_url||settings.instagram_url||settings.tiktok_url){ %>
      <div class="social mt">
        <% if(settings.facebook_url){ %><a href="<%= settings.facebook_url %>" target="_blank" rel="noopener">Facebook</a><% } %>
        <% if(settings.instagram_url){ %><a href="<%= settings.instagram_url %>" target="_blank" rel="noopener">Instagram</a><% } %>
        <% if(settings.tiktok_url){ %><a href="<%= settings.tiktok_url %>" target="_blank" rel="noopener">TikTok</a><% } %>
      </div>
      <% } %>
    </div>
    <div class="contact-form-wrap">
      <h2><%= t.form_title %></h2>
      <form id="contactForm" data-ok="<%= t.form_success %>" data-err="<%= t.form_error %>">
        <label><%= t.form_name %><input name="name" required></label>
        <label><%= t.form_email %><input type="email" name="email"></label>
        <label><%= t.form_phone %><input name="phone"></label>
        <label><%= t.form_message %><textarea name="message" rows="5" required></textarea></label>
        <div id="formMsg" class="form-msg" aria-live="polite"></div>
        <button type="submit" class="btn btn-primary" style="background-color:#E2581F;color:#fff"><%= t.form_send %></button>
      </form>
      <% if(!user){ %><p class="muted small mt"><%= t.contact_login_hint %> <a href="#" data-login-btn><%= t.login %></a>.</p><% } %>
    </div>
  </div>
</section>
<section class="map-section">
  <iframe class="map-embed" src="https://www.google.com/maps?q=<%= encodeURIComponent(settings.map_query || settings.business_address || 'Blainville QC') %>&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Carte"></iframe>
</section>
<%- include('partials/order-band') %>
<%- include('partials/footer') %>
