<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#E2581F">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="description" content="<%= t.meta_desc %>">
<title><%= (typeof pageTitle!=='undefined' && pageTitle) ? pageTitle + ' · ' + t.site_name : t.site_name + ' · ' + t.tagline_short %></title>
<link rel="manifest" href="manifest.json">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700;9..144,900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="public/css/styles.css">
</head>
<body>
<header class="site-header">
  <div class="nav-wrap">
    <a href="." class="brand">
      <img class="brand-logo" src="<%= (typeof settings!=='undefined' && settings._p_nav_logo_url) ? settings._p_nav_logo_url : (typeof appIconUrl!=='undefined' && appIconUrl ? appIconUrl : '') %>" alt="<%= t.site_name %>" onerror="this.style.display='none'">
      <span class="brand-name"><%= t.site_name %></span>
    </a>
    <button class="nav-toggle" id="navToggle" aria-label="Menu">&#9776;</button>
    <nav class="nav-links" id="navLinks">
      <a href="."><%= t.nav_home %></a>
      <a href="galerie"><%= t.nav_gallery %></a>
      <a href="nouvelles"><%= t.nav_news %></a>
      <a href="contact"><%= t.nav_contact %></a>
      <span class="lang-toggle">
        <a href="<%= (pathRel && pathRel.length) ? pathRel : '.' %>?lang=fr" class="<%= lang==='fr'?'active':'' %>">FR</a>
        <a href="<%= (pathRel && pathRel.length) ? pathRel : '.' %>?lang=en" class="<%= lang==='en'?'active':'' %>">EN</a>
      </span>
      <a href="#" class="nav-login" data-login-btn><%= t.login %></a>
      <a href="contact" class="nav-account" data-auth-only style="display:none"><%= t.account %></a>
      <% var oext = /^https?:/i.test(orderUrl); %>
      <a href="<%= orderUrl %>" class="btn-order" style="background-color:#E2581F;color:#fff" <%- oext?'target="_blank" rel="noopener"':'' %>><%= t.nav_order %></a>
    </nav>
  </div>
</header>
<script>
(function(){var b=document.getElementById('navToggle');var n=document.getElementById('navLinks');if(b&&n){b.addEventListener('click',function(){n.classList.toggle('open');});}})();
</script>
<main>
