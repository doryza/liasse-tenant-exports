<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> · Admin Tandoori Route</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="public/css/admin-styles.css">
</head>
<body class="admin-body">
<%- include('partials/admin-sidebar', { active: moduleKey }) %>
<div class="admin-main">
  <header class="admin-topbar">
    <button class="sb-toggle" id="sbToggle" aria-label="Menu">&#9776;</button>
    <h1><%= title %></h1>
    <button class="btn-primary" id="btnNew">+ Ajouter</button>
  </header>
  <div class="admin-content">
    <div class="list-toolbar">
      <div class="lt-left"><span class="count-badge" id="countBadge">0</span> <span class="muted">élément(s)</span></div>
      <input type="search" id="searchInput" class="search-input" placeholder="Rechercher…" aria-label="Rechercher">
    </div>
    <div id="tableWrap"><p class="muted">Chargement…</p></div>
  </div>
</div>
<div class="modal-overlay" id="modal">
  <div class="modal">
    <div class="modal-head"><h2 id="modalTitle">Élément</h2><button id="modalClose" aria-label="Fermer">&times;</button></div>
    <form id="itemForm">
      <div id="formFields"></div>
      <div class="modal-actions"><button type="button" class="btn-ghost" id="cancelBtn">Annuler</button><button type="submit" class="btn-primary">Enregistrer</button></div>
    </form>
  </div>
</div>
<div id="toast" class="toast" role="status" aria-live="polite"></div>
<script>
var MODULE_KEY=<%- JSON.stringify(moduleKey) %>;
var MODULE_LABEL=<%- JSON.stringify(moduleLabel) %>;
var fields=[]; var ITEMS={}; var ALL=[]; var EDIT_ID=null;
function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
function toast(msg,type){var el=document.getElementById('toast');el.textContent=msg;el.className='toast show '+(type||'');clearTimeout(window._tt);window._tt=setTimeout(function(){el.className='toast';},2600);}
async function init(){
 try{var m=await fetch('api/admin/modules').then(function(r){return r.json();});var d=(m.modules||[]).find(function(x){return x.key===MODULE_KEY;});fields=d?d.fields:[];}catch(e){}
 load();
}
async function load(){
 try{var data=await fetch('api/admin/'+MODULE_KEY).then(function(r){return r.json();});ALL=data[MODULE_KEY]||[];ITEMS={};ALL.forEach(function(it){ITEMS[it.id]=it;});document.getElementById('countBadge').textContent=ALL.length;applyFilter();}
 catch(e){document.getElementById('tableWrap').innerHTML='<div class="empty">Erreur de chargement.</div>';}
}
function applyFilter(){
 var q=(document.getElementById('searchInput').value||'').toLowerCase().trim();
 var items=ALL;
 if(q){items=ALL.filter(function(it){return Object.keys(it).some(function(k){return String(it[k]==null?'':it[k]).toLowerCase().indexOf(q)!==-1;});});}
 renderTable(items);
}
function cellVal(f,v){
 if(f.type==='boolean'){var on=(v==1||v===true||v==='1');return '<span class="pill '+(on?'pill-on':'pill-off')+'">'+(on?'Oui':'Non')+'</span>';}
 if(v==null||v==='')return '<span class="muted">&mdash;</span>';
 if(f.type==='image')return '<img class="thumb" src="'+esc(v)+'" alt="">';
 var s=String(v);if(s.length>60)s=s.slice(0,60)+'…';return esc(s);
}
function renderTable(items){
 if(!items.length){var msg=ALL.length?'Aucun résultat pour cette recherche.':'Aucun élément pour le moment. Cliquez sur « + Ajouter » pour commencer.';document.getElementById('tableWrap').innerHTML='<div class="empty">'+msg+'</div>';return;}
 var cols=fields.slice(0,4);
 var h='<div class="table-scroll"><table class="admin-table"><thead><tr>';
 cols.forEach(function(f){h+='<th>'+esc(f.label||f.name)+'</th>';});
 h+='<th class="row-actions">Actions</th></tr></thead><tbody>';
 items.forEach(function(it){
  h+='<tr>';
  cols.forEach(function(f){h+='<td>'+cellVal(f,it[f.name])+'</td>';});
  h+='<td class="row-actions"><button class="btn-mini" data-edit="'+it.id+'">Modifier</button> <button class="btn-mini danger" data-del="'+it.id+'">Suppr.</button></td></tr>';
 });
 h+='</tbody></table></div>';
 var w=document.getElementById('tableWrap');w.innerHTML=h;
 w.querySelectorAll('[data-edit]').forEach(function(b){b.addEventListener('click',function(){openForm(ITEMS[b.getAttribute('data-edit')]);});});
 w.querySelectorAll('[data-del]').forEach(function(b){b.addEventListener('click',function(){del(b.getAttribute('data-del'));});});
}
function fieldHtml(f,val){
 var id='f_'+f.name;
 var lab='<label class="lab" for="'+id+'">'+esc(f.label||f.name)+(f.required?' *':'')+'</label>';
 var help=f.description?'<small class="hint">'+esc(f.description)+'</small>':'';
 var input='';
 if(f.type==='textarea')input='<textarea id="'+id+'" rows="5" placeholder="'+esc(f.placeholder||'')+'">'+esc(val)+'</textarea>';
 else if(f.type==='boolean')return '<div class="field"><label class="switch"><input type="checkbox" id="'+id+'" '+((val==1||val===true||val==='1'||val==='true')?'checked':'')+'> '+esc(f.label||f.name)+'</label>'+help+'</div>';
 else if(f.type==='number')input='<input type="number" id="'+id+'" value="'+esc(val)+'" '+(f.min!=null?'min="'+f.min+'"':'')+(f.max!=null?' max="'+f.max+'"':'')+(f.step!=null?' step="'+f.step+'"':'')+' placeholder="'+esc(f.placeholder||'')+'">';
 else if(f.type==='select'){input='<select id="'+id+'"><option value="">&mdash;</option>';(f.options||[]).forEach(function(o){input+='<option value="'+esc(o)+'"'+(String(val)===String(o)?' selected':'')+'>'+esc(o)+'</option>';});input+='</select>';}
 else if(f.type==='image')input='<div class="img-field"><input type="text" id="'+id+'" value="'+esc(val)+'" placeholder="https://..."><div class="img-tools"><label class="btn-mini upload">&#128193; Téléverser<input type="file" accept="image/*" data-imgfile="'+f.name+'" hidden></label><button type="button" class="btn-mini" data-imgai="'+f.name+'">&#10024; IA</button></div><img class="img-prev" id="pv_'+f.name+'" src="'+esc(val)+'" '+(val?'':'style="display:none"')+'></div>';
 else input='<input type="text" id="'+id+'" value="'+esc(val)+'" placeholder="'+esc(f.placeholder||'')+'">';
 return '<div class="field">'+lab+input+help+'</div>';
}
function openForm(item){
 EDIT_ID=item?item.id:null;
 document.getElementById('modalTitle').textContent=(item?'Modifier ':'Ajouter ')+MODULE_LABEL;
 document.getElementById('formFields').innerHTML=fields.map(function(f){var v=item?(item[f.name]!=null?item[f.name]:''):(f.default!=null?f.default:'');return fieldHtml(f,v);}).join('');
 bindImg();
 document.getElementById('modal').classList.add('open');
}
function closeModal(){document.getElementById('modal').classList.remove('open');}
function setImg(n,u){var i=document.getElementById('f_'+n);if(i)i.value=u;var p=document.getElementById('pv_'+n);if(p){p.src=u;p.style.display='block';}}
function bindImg(){
 document.querySelectorAll('[data-imgfile]').forEach(function(inp){inp.addEventListener('change',function(){var file=inp.files[0];if(!file)return;var n=inp.getAttribute('data-imgfile');var rd=new FileReader();rd.onload=function(){fetch('api/admin/upload',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({data:rd.result})}).then(function(r){return r.json();}).then(function(j){if(j.url){setImg(n,j.url);toast('Image téléversée ✓','success');}else toast('Échec du téléversement.','error');}).catch(function(){toast('Échec du téléversement.','error');});};rd.readAsDataURL(file);});});
 document.querySelectorAll('[data-imgai]').forEach(function(btn){btn.addEventListener('click',function(){var n=btn.getAttribute('data-imgai');var p=prompt("Décrivez l'image à générer :");if(!p)return;btn.disabled=true;var old=btn.innerHTML;btn.innerHTML='…';fetch('api/admin/generate-image',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({prompt:p,aspectRatio:'4:3'})}).then(function(r){return r.json();}).then(function(j){if(j.imageUrl){setImg(n,j.imageUrl);toast('Image générée ✓','success');}else toast('Génération échouée.','error');}).catch(function(){toast('Génération échouée.','error');}).then(function(){btn.disabled=false;btn.innerHTML=old;});});});
}
async function del(id){if(!confirm('Supprimer cet élément? Cette action est irréversible.'))return;try{var r=await fetch('api/admin/'+MODULE_KEY+'/'+id,{method:'DELETE'});if(!r.ok)throw new Error();toast('Élément supprimé.','success');load();}catch(e){toast('Erreur lors de la suppression.','error');}}
document.getElementById('itemForm').addEventListener('submit',async function(e){
 e.preventDefault();var obj={};
 fields.forEach(function(f){var el=document.getElementById('f_'+f.name);if(!el)return;if(f.type==='boolean')obj[f.name]=el.checked?1:0;else obj[f.name]=el.value;});
 var btn=this.querySelector('button[type=submit]');if(btn)btn.disabled=true;
 try{var url='api/admin/'+MODULE_KEY+(EDIT_ID?('/'+EDIT_ID):'');var r=await fetch(url,{method:EDIT_ID?'PUT':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(obj)});if(!r.ok)throw new Error();closeModal();toast('Enregistré ✓','success');load();}catch(err){toast("Erreur lors de l'enregistrement.",'error');}
 finally{if(btn)btn.disabled=false;}
});
document.getElementById('btnNew').addEventListener('click',function(){openForm(null);});
document.getElementById('modalClose').addEventListener('click',closeModal);
document.getElementById('cancelBtn').addEventListener('click',closeModal);
document.getElementById('modal').addEventListener('click',function(e){if(e.target===this)closeModal();});
document.getElementById('searchInput').addEventListener('input',applyFilter);
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeModal();});
document.getElementById('sbToggle').addEventListener('click',function(){document.getElementById('adminSidebar').classList.toggle('open');});
init();
</script>
</body>
</html>
