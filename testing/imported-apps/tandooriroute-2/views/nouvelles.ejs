<%- include('partials/header') %>
<section class="page-head section-dark">
  <div class="container center">
    <span class="eyebrow"><%= t.news_eyebrow %></span>
    <h1><%= t.news_title %></h1>
  </div>
</section>
<section class="section">
  <div class="container">
    <% if(typeof posts!=='undefined' && posts.length){ %>
    <div class="news-grid">
      <% posts.forEach(function(p){ %>
      <article class="news-card">
        <a href="nouvelles/<%= p.id %>"><div class="news-media"><img src="<%= p.image_url || 'https://placehold.co/640x400/211710/F5843C/png?text=Nouvelle' %>" alt="<%= p.title %>" loading="lazy"></div></a>
        <div class="news-body"><% if(p.category){ %><span class="tag"><%= p.category %></span><% } %> <span class="date"><%= formatDate(p.created_at) %></span><h3><a href="nouvelles/<%= p.id %>"><%= p.title %></a></h3><p><%= (p.content||'').slice(0,150) %><%= (p.content && p.content.length>150)?'…':'' %></p><a class="link-arrow" href="nouvelles/<%= p.id %>"><%= t.read_more %> &rarr;</a></div>
      </article>
      <% }); %>
    </div>
    <% } else { %>
    <div class="empty-state"><p><%= t.news_empty %></p></div>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>
