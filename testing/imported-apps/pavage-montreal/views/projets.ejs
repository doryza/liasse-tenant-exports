<%- include('partials/header') %>
<section class="bg-brand text-white py-16" style="background-color:#111112">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-accent font-bold uppercase tracking-widest text-sm mb-2" style="color:#ff6a13">Réalisations</div>
    <h1 class="text-4xl md:text-5xl font-extrabold mb-4">Nos projets</h1>
    <p class="text-lg text-gray-300 max-w-2xl">Découvrez nos réalisations dans tous nos domaines d'expertise. Chaque projet témoigne de notre engagement envers la qualité.</p>
  </div>
</section>

<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-extrabold text-brand text-center mb-3">Nos 8 domaines d'expertise</h2>
    <p class="text-gray-600 text-center mb-12 max-w-2xl mx-auto">Cliquez sur un service pour voir la galerie complète des projets réalisés.</p>
    <% if (typeof services !== 'undefined' && services && services.length > 0) { %>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <% services.forEach(function(s) { %>
          <a href="services/<%= s.slug %>" class="bg-white rounded-lg overflow-hidden shadow hover:shadow-xl transition-all duration-300 group block border border-gray-100">
            <div class="relative overflow-hidden aspect-[4/3]">
              <img src="<%= s.image_url || 'https://placehold.co/600x450/e5e7eb/6b7280/png?text=Service' %>" alt="<%= s.title %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div>
              <div class="absolute bottom-3 left-3 right-3">
                <div class="text-accent text-xs font-bold uppercase tracking-wider" style="color:#ff8a3d"><%= s.title %></div>
              </div>
            </div>
            <div class="p-5">
              <h3 class="font-bold text-brand mb-1 leading-tight"><%= s.subtitle %></h3>
              <p class="text-sm text-gray-600 line-clamp-2 mb-3"><%= s.short_desc %></p>
              <div class="text-sm font-bold text-accent uppercase" style="color:#ff6a13">Voir projets →</div>
            </div>
          </a>
        <% }); %>
      </div>
    <% } else { %>
      <p class="text-center text-gray-500">Aucun service à afficher pour le moment.</p>
    <% } %>
  </div>
</section>

<section class="py-16 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-extrabold text-brand text-center mb-3">Projets récents</h2>
    <p class="text-gray-600 text-center mb-10">Un aperçu de nos dernières réalisations.</p>
    <% if (typeof projects !== 'undefined' && projects && projects.length > 0) { %>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% projects.slice(0,9).forEach(function(p) { %>
          <div class="bg-white rounded-lg overflow-hidden shadow group">
            <div class="relative aspect-[4/3] overflow-hidden">
              <img src="<%= p.image_url || 'https://placehold.co/600x450/e5e7eb/6b7280/png?text=Projet' %>" alt="<%= p.title %>" class="w-full h-full object-cover group-hover:scale-110 transition duration-500">
            </div>
            <div class="p-5">
              <h3 class="font-bold text-brand mb-1"><%= p.title %></h3>
              <% if (p.location) { %><div class="text-xs text-accent uppercase font-bold tracking-wide mb-2" style="color:#ff6a13">📍 <%= p.location %></div><% } %>
              <p class="text-sm text-gray-600 line-clamp-2"><%= p.description %></p>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <p class="text-center text-gray-500">Aucun projet à afficher pour le moment.</p>
    <% } %>
  </div>
</section>

<section class="py-16 bg-white">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-extrabold text-brand text-center mb-10">Notre approche de gestion de projet</h2>
    <div class="grid md:grid-cols-4 gap-6">
      <div class="text-center">
        <div class="w-14 h-14 bg-accent text-white font-extrabold text-xl rounded-full flex items-center justify-center mx-auto mb-3" style="background-color:#ff6a13;color:#fff">1</div>
        <h4 class="font-bold text-brand mb-1">Évaluation</h4>
        <p class="text-sm text-gray-600">Visite sur place et analyse complète du projet.</p>
      </div>
      <div class="text-center">
        <div class="w-14 h-14 bg-accent text-white font-extrabold text-xl rounded-full flex items-center justify-center mx-auto mb-3" style="background-color:#ff6a13;color:#fff">2</div>
        <h4 class="font-bold text-brand mb-1">Soumission</h4>
        <p class="text-sm text-gray-600">Devis détaillé et transparent, sans frais cachés.</p>
      </div>
      <div class="text-center">
        <div class="w-14 h-14 bg-accent text-white font-extrabold text-xl rounded-full flex items-center justify-center mx-auto mb-3" style="background-color:#ff6a13;color:#fff">3</div>
        <h4 class="font-bold text-brand mb-1">Réalisation</h4>
        <p class="text-sm text-gray-600">Exécution dans les délais avec une équipe expérimentée.</p>
      </div>
      <div class="text-center">
        <div class="w-14 h-14 bg-accent text-white font-extrabold text-xl rounded-full flex items-center justify-center mx-auto mb-3" style="background-color:#ff6a13;color:#fff">4</div>
        <h4 class="font-bold text-brand mb-1">Suivi</h4>
        <p class="text-sm text-gray-600">Inspection finale et garantie sur les travaux.</p>
      </div>
    </div>
  </div>
</section>

<% if (typeof testimonials !== 'undefined' && testimonials && testimonials.length > 0) { %>
<section class="py-16 bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <% var t=testimonials[0]; %>
    <div class="flex justify-center gap-0.5 text-accent text-3xl mb-4" style="color:#ff6a13"><% for(var i=0;i<(t.rating||5);i++){ %>★<% } %></div>
    <p class="text-2xl text-gray-700 italic leading-relaxed mb-6">« <%= t.content %> »</p>
    <div class="font-bold text-brand text-lg"><%= t.author %></div>
    <% if (t.role) { %><div class="text-gray-500"><%= t.role %></div><% } %>
  </div>
</section>
<% } %>

<section class="py-16 bg-brand text-white" style="background-color:#111112">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl md:text-4xl font-extrabold mb-4">Votre projet est notre prochain défi</h2>
    <a href="<%= (typeof mountPath !== 'undefined' ? mountPath : '') %>/soumission" class="inline-block px-8 py-4 bg-accent text-white font-bold uppercase tracking-wide rounded hover:bg-accent-dark transition mt-4" style="background-color:#ff6a13;color:#fff">Soumission gratuite</a>
  </div>
</section>
<%- include('partials/footer') %>
