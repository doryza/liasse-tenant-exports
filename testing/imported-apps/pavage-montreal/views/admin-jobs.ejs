<%- include('partials/admin-header', { pageTitle: 'Emplois', currentPage: 'jobs' }) %>
<div class="admin-content">
  <div class="admin-head"><div><h1 class="admin-h1">Emplois</h1><p class="admin-sub">Postes ouverts affichés sur la page Emplois.</p></div><button class="btn-primary" onclick="openModal()">+ Nouveau poste</button></div>
  <div id="list" class="data-grid"></div>
</div>
<div id="modal" class="modal hidden"><div class="modal-card"><div class="modal-head"><h2 id="mTitle">Nouveau poste</h2><button onclick="closeModal()" class="x">×</button></div><form id="form" class="modal-body"><input type="hidden" name="id"><label>Titre *<input name="title" required></label><label>Description<textarea name="description" rows="3"></textarea></label><label>Exigences<textarea name="requirements" rows="3" placeholder="3 ans d'expérience • Permis valide…"></textarea></label><label>Lieu<input name="location" placeholder="Montréal"></label><label>Type d'emploi<input name="employment_type" placeholder="Temps plein"></label><label>Ordre<input name="sort_order" type="number" value="0"></label><label class="check"><input type="checkbox" name="active" checked> Actif (visible)</label><div class="modal-foot"><button type="button" onclick="closeModal()" class="btn-ghost">Annuler</button><button type="submit" class="btn-primary">Enregistrer</button></div></form></div></div>
<script>
var items=[];
async function load(){try{var r=await fetch('api/admin/jobs');var d=await r.json();items=d.jobs||[];render();}catch(e){document.getElementById('list').innerHTML='<p class="empty">Erreur.</p>';}}
function render(){var l=document.getElementById('list');if(!items.length){l.innerHTML='<p class="empty">Aucun poste.</p>';return;}l.innerHTML=items.map(function(j){return '<div class="data-card"><div class="dc-body"><div class="dc-tag">'+(j.employment_type||'Temps plein')+'</div><h3>'+(j.title||'')+'</h3><div class="dc-meta">'+(j.location||'')+(j.active?'':' · [Inactif]')+'</div><p>'+(j.description||'')+'</p><div class="dc-actions"><button onclick="editItem('+j.id+')" class="btn-ghost">Modifier</button><button onclick="delItem('+j.id+')" class="btn-danger">Supprimer</button></div></div></div>';}).join('');}
function openModal(){document.getElementById('mTitle').textContent='Nouveau poste';document.getElementById('form').reset();document.getElementById('form').id.value='';document.getElementById('form').active.checked=true;document.getElementById('modal').classList.remove('hidden');}
function closeModal(){document.getElementById('modal').classList.add('hidden');}
function editItem(id){var j=items.find(function(x){return x.id===id;});if(!j)return;var f=document.getElementById('form');f.id.value=j.id;f.title.value=j.title||'';f.description.value=j.description||'';f.requirements.value=j.requirements||'';f.location.value=j.location||'';f.employment_type.value=j.employment_type||'';f.sort_order.value=j.sort_order||0;f.active.checked=!!j.active;document.getElementById('mTitle').textContent='Modifier le poste';document.getElementById('modal').classList.remove('hidden');}
async function delItem(id){if(!confirm('Supprimer ce poste ?'))return;await fetch('api/admin/jobs/'+id,{method:'DELETE'});load();}
document.getElementById('form').addEventListener('submit',async function(e){e.preventDefault();var f=e.target;var d={title:f.title.value,description:f.description.value,requirements:f.requirements.value,location:f.location.value,employment_type:f.employment_type.value,sort_order:Number(f.sort_order.value)||0,active:f.active.checked};var url='api/admin/jobs'+(f.id.value?'/'+f.id.value:'');var m=f.id.value?'PUT':'POST';await fetch(url,{method:m,headers:{'Content-Type':'application/json'},body:JSON.stringify(d)});closeModal();load();});
load();
</script>
<%- include('partials/admin-footer') %>
