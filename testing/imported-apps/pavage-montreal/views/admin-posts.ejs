<%- include('partials/admin-header', { pageTitle: 'Articles', currentPage: 'posts' }) %>
<div class="admin-content">
  <div class="admin-head"><div><h1 class="admin-h1">Articles</h1><p class="admin-sub">Articles et nouvelles de l'entreprise.</p></div><button class="btn-primary" onclick="openModal()">+ Nouvel article</button></div>
  <div id="list" class="data-grid"></div>
</div>
<div id="modal" class="modal hidden"><div class="modal-card"><div class="modal-head"><h2 id="mTitle">Nouvel article</h2><button onclick="closeModal()" class="x">×</button></div><form id="form" class="modal-body"><input type="hidden" name="id"><label>Titre *<input name="title" required></label><label>Contenu<textarea name="content" rows="6"></textarea></label><label>Image (URL)<input name="image_url"></label><label>Catégorie<input name="category" placeholder="Conseils"></label><label class="check"><input type="checkbox" name="published" checked> Publié</label><div class="modal-foot"><button type="button" onclick="closeModal()" class="btn-ghost">Annuler</button><button type="submit" class="btn-primary">Enregistrer</button></div></form></div></div>
<script>
var items=[];
async function load(){try{var r=await fetch('api/admin/posts');var d=await r.json();items=d.posts||[];render();}catch(e){document.getElementById('list').innerHTML='<p class="empty">Erreur.</p>';}}
function render(){var l=document.getElementById('list');if(!items.length){l.innerHTML='<p class="empty">Aucun article.</p>';return;}l.innerHTML=items.map(function(p){var c=(p.content||'').slice(0,150);return '<div class="data-card"><div class="dc-img">'+(p.image_url?'<img src="'+p.image_url+'" alt="">':'')+'</div><div class="dc-body"><div class="dc-tag">'+(p.category||'Article')+'</div><h3>'+(p.title||'')+'</h3><p>'+c+(c.length>=150?'…':'')+'</p>'+(p.published?'':'<div class="dc-meta">[Brouillon]</div>')+'<div class="dc-actions"><button onclick="editItem('+p.id+')" class="btn-ghost">Modifier</button><button onclick="delItem('+p.id+')" class="btn-danger">Supprimer</button></div></div></div>';}).join('');}
function openModal(){document.getElementById('mTitle').textContent='Nouvel article';document.getElementById('form').reset();document.getElementById('form').id.value='';document.getElementById('form').published.checked=true;document.getElementById('modal').classList.remove('hidden');}
function closeModal(){document.getElementById('modal').classList.add('hidden');}
function editItem(id){var p=items.find(function(x){return x.id===id;});if(!p)return;var f=document.getElementById('form');f.id.value=p.id;f.title.value=p.title||'';f.content.value=p.content||'';f.image_url.value=p.image_url||'';f.category.value=p.category||'';f.published.checked=!!p.published;document.getElementById('mTitle').textContent='Modifier l\'article';document.getElementById('modal').classList.remove('hidden');}
async function delItem(id){if(!confirm('Supprimer ?'))return;await fetch('api/admin/posts/'+id,{method:'DELETE'});load();}
document.getElementById('form').addEventListener('submit',async function(e){e.preventDefault();var f=e.target;var d={title:f.title.value,content:f.content.value,image_url:f.image_url.value,category:f.category.value,published:f.published.checked};var url='api/admin/posts'+(f.id.value?'/'+f.id.value:'');var m=f.id.value?'PUT':'POST';await fetch(url,{method:m,headers:{'Content-Type':'application/json'},body:JSON.stringify(d)});closeModal();load();});
load();
</script>
<%- include('partials/admin-footer') %>
