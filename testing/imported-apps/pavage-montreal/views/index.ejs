            <div>
              <div class="font-bold text-brand text-sm"><%= t.author %></div>
              <% if (t.role) { %><div class="text-xs text-gray-500"><%= t.role %></div><% } %>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
    <div class="text-center mt-10">
      <a href="a-propos" class="inline-flex items-center gap-1 font-bold hover:underline transition" style="color:#ff6a13">
        Voir tous les témoignages →
      </a>
    </div>
  </div>
</section>
<% } %>

