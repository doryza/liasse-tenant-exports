<%- include('partials/header') %>

<style>
  /* Voice CTA strip — pulsing mic link */
  .vs-mic-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 5rem;
    height: 5rem;
    border-radius: 9999px;
    background: linear-gradient(135deg, #ff8a3d, #ff6a13, #d6520a);
    color: #fff;
    text-decoration: none;
    box-shadow: 0 10px 28px -6px rgba(255,106,19,0.6);
    transition: transform 180ms ease;
    z-index: 0;
    flex-shrink: 0;
  }
  .vs-mic-link:hover { transform: scale(1.07); }
  .vs-mic-link::before, .vs-mic-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: rgba(255,106,19,0.35);
    z-index: -1;
    animation: vs-pulse 2.4s ease-in-out infinite;
  }
  .vs-mic-link::after { animation-delay: 1.2s; }
  @keyframes vs-pulse {
    0%   { transform: scale(1);   opacity: 0.5; }
    100% { transform: scale(1.9); opacity: 0;   }
  }
  @media (prefers-reduced-motion: reduce) {
    .vs-mic-link::before, .vs-mic-link::after { animation: none; }
  }
</style>

<!-- ===== HERO ===== -->
<section class="relative">
