<%- include('partials/admin-header', { pageTitle: 'Services', currentPage: 'services' }) %>
<div class="admin-content">
  <div class="admin-head">
    <div><h1 class="admin-h1">Services</h1><p class="admin-sub">Gérez les 12 services offerts par votre entreprise.</p></div>
    <button class="btn-primary" onclick="openModal()">+ Nouveau service</button>
  </div>
  <div id="list" class="data-grid"></div>
</div>
<div id="modal" class="modal hidden"><div class="modal-card"><div class="modal-head"><h2 id="mTitle">Nouveau service</h2><button onclick="closeModal()" class="x">×</button></div><form id="form" class="modal-body"><input type="hidden" name="id"><label>Slug (URL) *<input name="slug" required placeholder="pave-uni"></label><label>Titre *<input name="title" required placeholder="Pavé-Uni"></label><label>Sous-titre<input name="subtitle" placeholder="Résidentiel, Commercial…"></label><label>Description courte<textarea name="short_desc" rows="2"></textarea></label><label>Description longue<textarea name="long_desc" rows="4"></textarea></label><label>Image (URL)<input name="image_url" placeholder="https://…"></label><label>Ordre<input name="sort_order" type="number" value="0"></label><label class="check"><input type="checkbox" name="featured" checked> Afficher sur l'accueil</label><div class="modal-foot"><button type="button" onclick="closeModal()" class="btn-ghost">Annuler</button><button type="submit" class="btn-primary">Enregistrer</button></div></form></div></div>
<script>
var items=[];
async function load() { try{var r=await fetch('api/admin/services');var d=await r.json();items=d.services||[];render();}catch(e){document.getElementById('list').innerHTML='<p class="empty">Erreur de chargement.</p>';} }
function render(){var list=document.getElementById('list');if(!items.length){list.innerHTML='<p class="empty">Aucun service. Cliquez sur « Nouveau service » pour commencer.</p>';return;}list.innerHTML=items.map(function(s){return '<div class="data-card"><div class="dc-img">'+(s.image_url?'<img src="'+s.image_url+'" alt="">':'')+'</div><div class="dc-body"><div class="dc-tag">'+(s.title||'')+'</div><h3>'+(s.subtitle||'')+'</h3><p>'+(s.short_desc||'')+'</p><div class="dc-meta">slug: '+(s.slug||'')+' · ordre: '+(s.sort_order||0)+'</div><div class="dc-actions"><button onclick="editItem('+s.id+')" class="btn-ghost">Modifier</button><button onclick="delItem('+s.id+')" class="btn-danger">Supprimer</button></div></div></div>';}).join('');}
function openModal(){document.getElementById('mTitle').textContent='Nouveau service';document.getElementById('form').reset();document.getElementById('form').id.value='';document.getElementById('modal').classList.remove('hidden');}
function closeModal(){document.getElementById('modal').classList.add('hidden');}
function editItem(id){var s=items.find(function(x){return x.id===id;});if(!s)return;var f=document.getElementById('form');f.id.value=s.id;f.slug.value=s.slug||'';f.title.value=s.title||'';f.subtitle.value=s.subtitle||'';f.short_desc.value=s.short_desc||'';f.long_desc.value=s.long_desc||'';f.image_url.value=s.image_url||'';f.sort_order.value=s.sort_order||0;f.featured.checked=!!s.featured;document.getElementById('mTitle').textContent='Modifier le service';document.getElementById('modal').classList.remove('hidden');}
async function delItem(id){if(!confirm('Supprimer ce service ?'))return;await fetch('api/admin/services/'+id,{method:'DELETE'});load();}
document.getElementById('form').addEventListener('submit',async function(e){e.preventDefault();var f=e.target;var d={slug:f.slug.value,title:f.title.value,subtitle:f.subtitle.value,short_desc:f.short_desc.value,long_desc:f.long_desc.value,image_url:f.image_url.value,sort_order:Number(f.sort_order.value)||0,featured:f.featured.checked};var url='api/admin/services'+(f.id.value?'/'+f.id.value:'');var m=f.id.value?'PUT':'POST';await fetch(url,{method:m,headers:{'Content-Type':'application/json'},body:JSON.stringify(d)});closeModal();load();});
load();
</script>
<%- include('partials/admin-footer') %>
