<footer class="bg-brand text-gray-300 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 grid md:grid-cols-4 gap-8">
    <div>
      <div class="flex items-center gap-3 mb-4">
        <% var lf=(typeof settings!=='undefined' && settings._p_nav_logo_url) ? settings._p_nav_logo_url : (typeof appIconUrl!=='undefined' && appIconUrl ? appIconUrl : ''); %>
        <% if (lf) { %><img src="<%= lf %>" alt="Logo" class="h-12 w-12 object-contain bg-white rounded p-1"><% } %>
        <div class="text-white font-extrabold text-lg"><%= settings.business_name || 'Pavage Montréal' %></div>
      </div>
      <p class="text-sm leading-relaxed">Montreal Scellant Inc.<br>Spécialistes du pavage depuis 1991.</p>
    </div>
    <div>
      <h4 class="text-white font-bold uppercase text-sm tracking-wider mb-4">Navigation</h4>
      <ul class="space-y-2 text-sm">
        <li><a href="<%= (typeof mountPath !== 'undefined' ? mountPath : '') %>/accueil" class="hover:text-accent transition">Accueil</a></li>
        <li><a href="a-propos" class="hover:text-accent transition">À propos</a></li>
        <li><a href="nos-projets" class="hover:text-accent transition">Nos projets</a></li>
        <li><a href="emplois" class="hover:text-accent transition">Emplois</a></li>
        <li><a href="nous-contacter" class="hover:text-accent transition">Nous contacter</a></li>
      </ul>
    </div>
    <div>
      <h4 class="text-white font-bold uppercase text-sm tracking-wider mb-4">Coordonnées</h4>
      <ul class="space-y-2 text-sm">
        <% if (settings.business_address) { %><li class="flex gap-2"><svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-accent" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a6 6 0 00-6 6c0 4.5 6 10 6 10s6-5.5 6-10a6 6 0 00-6-6zm0 8a2 2 0 110-4 2 2 0 010 4z"/></svg><span><%= settings.business_address %></span></li><% } %>
        <% if (settings.contact_phone) { %><li class="flex gap-2"><svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-accent" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg><span><a href="tel:<%= (settings.contact_phone||'').replace(/[^0-9+]/g,'') %>" class="hover:text-accent"><%= settings.contact_phone %></a><% if (settings.contact_phone_alt) { %> · <%= settings.contact_phone_alt %><% } %></span></li><% } %>
        <% if (settings.contact_email) { %><li class="flex gap-2"><svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-accent" fill="currentColor" viewBox="0 0 20 20"><path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/><path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/></svg><a href="mailto:<%= settings.contact_email %>" class="hover:text-accent"><%= settings.contact_email %></a></li><% } %>
        <% if (settings.facebook_url) { %><li class="flex gap-2"><svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-accent" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg><a href="<%= settings.facebook_url %>" target="_blank" rel="noopener" class="hover:text-accent">Facebook</a></li><% } %>
      </ul>
    </div>
    <div>
      <h4 class="text-white font-bold uppercase text-sm tracking-wider mb-4">Heures d'ouverture</h4>
      <p class="text-sm leading-relaxed"><%= settings.hours || 'Lundi au Samedi : 08h00 – 17h00' %></p>
      <a href="<%= (typeof mountPath !== 'undefined' ? mountPath : '') %>/soumission" class="inline-block mt-4 px-4 py-2 bg-accent text-white text-sm font-bold uppercase rounded hover:bg-accent-dark transition" style="background-color:#ff6a13;color:#fff">Soumission gratuite</a>
      <button data-push-btn class="block mt-3 text-xs text-gray-400 hover:text-accent underline">Activer les notifications</button>
    </div>
  </div>
  <div class="border-t border-gray-800 py-5 text-center text-xs text-gray-500">
    <%= settings.footer_text || ('© ' + year + ' Pavage Montréal — Tous droits réservés.') %>
  </div>
</footer>

<!-- ===== Floating mobile CTA (hidden on desktop + on soumission/contact pages) ===== -->
<div id="floating-quote-cta" class="fixed bottom-0 left-0 right-0 z-50 lg:hidden">
  <div class="px-4 pb-4 pt-2" style="background:linear-gradient(to top, rgba(0,0,0,0.18) 0%, transparent 100%)">
    <a href="<%= (typeof mountPath !== 'undefined' ? mountPath : '') %>/soumission"
       class="flex items-center justify-center gap-2.5 w-full py-3.5 text-white font-bold text-sm uppercase tracking-wide rounded-xl shadow-xl"
       style="background:linear-gradient(135deg,#ff8a3d,#ff6a13);color:#fff;box-shadow:0 8px 28px -4px rgba(255,106,19,0.6)">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/>
        <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
        <line x1="12" x2="12" y1="19" y2="22"/>
      </svg>
      Soumission gratuite — 2&nbsp;minutes
    </a>
  </div>
</div>

<script>
(function() {
  // Hide floating CTA on pages where it would be redundant
  var path = window.location.pathname || '';
  var cta = document.getElementById('floating-quote-cta');
  if (cta && (path.indexOf('/soumission') !== -1 || path.indexOf('/nous-contacter') !== -1)) {
    cta.style.display = 'none';
  } else if (cta) {
    // Add bottom padding to body so page content isn't hidden behind the bar
    document.body.style.paddingBottom = '5rem';
  }
})();
try { if (window.TenantSDK) { setTimeout(function(){ try{TenantSDK.ui.showInstallBanner();}catch(e){} }, 3000); setTimeout(function(){ try{TenantSDK.ui.showPushPrompt();}catch(e){} }, 12000); } } catch(e) {}
</script>
</body>
</html>
