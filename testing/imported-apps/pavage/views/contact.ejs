<%- include('partials/header') %>
<section class="py-16 bg-gradient-to-br from-dark-2 to-dark">
<div class="max-w-7xl mx-auto px-4 text-center">
<h1 class="section-title gradient-text mb-4"><%= t.contact_title %></h1>
<p class="text-gray-400 text-xl max-w-2xl mx-auto"><%= t.contact_subtitle %></p>
</div>
</section>
<section class="py-16">
<div class="max-w-6xl mx-auto px-4 grid grid-cols-1 lg:grid-cols-3 gap-8">
<div class="lg:col-span-2">
<div class="card p-8">
<form id="quoteForm" class="space-y-5">
<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
<div><label class="block text-sm font-semibold mb-2"><%= t.form_name %> *</label><input name="name" required class="input-field"></div>
<div><label class="block text-sm font-semibold mb-2"><%= t.form_email %></label><input name="email" type="email" class="input-field"></div>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
<div><label class="block text-sm font-semibold mb-2"><%= t.form_phone %></label><input name="phone" type="tel" class="input-field"></div>
<div><label class="block text-sm font-semibold mb-2"><%= t.form_address %></label><input name="address" class="input-field"></div>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
<div>
<label class="block text-sm font-semibold mb-2"><%= t.form_project_type %></label>
<select name="project_type" class="input-field">
<option value=""><%= t.form_select_type %></option>
<option value="driveway"><%= t.type_driveway %></option>
<option value="patio"><%= t.type_patio %></option>
<option value="walkway"><%= t.type_walkway %></option>
<option value="asphalt"><%= t.type_asphalt %></option>
<option value="repair"><%= t.type_repair %></option>
<option value="other"><%= t.type_other %></option>
</select>
</div>
<div><label class="block text-sm font-semibold mb-2"><%= t.form_surface %></label><input name="surface_area" type="text" class="input-field" placeholder="ex. 100"></div>
</div>
<div><label class="block text-sm font-semibold mb-2"><%= t.form_message %></label><textarea name="message" rows="5" class="input-field"></textarea></div>
<button type="submit" id="submitBtn" class="btn-primary w-full text-lg" style="background:linear-gradient(135deg,#8b5cf6 0%,#ec4899 100%);color:#fff"><%= t.btn_send %> →</button>
<div id="formResult" class="hidden p-4 rounded-lg"></div>
</form>
</div>
</div>
<div>
<div class="card p-6 sticky top-24">
<h3 class="text-xl font-bold mb-6 gradient-text"><%= t.contact_info %></h3>
<div class="space-y-4">
<% if (settings.contact_phone) { %><div><div class="text-xs text-gray-500 uppercase mb-1"><%= t.phone_label %></div><a href="tel:<%= settings.contact_phone %>" class="font-semibold" style="color:#a78bfa"><%= settings.contact_phone %></a></div><% } %>
<% if (settings.contact_email) { %><div><div class="text-xs text-gray-500 uppercase mb-1"><%= t.email_label %></div><a href="mailto:<%= settings.contact_email %>" class="font-semibold break-all" style="color:#a78bfa"><%= settings.contact_email %></a></div><% } %>
<% if (settings.business_address) { %><div><div class="text-xs text-gray-500 uppercase mb-1"><%= t.address_label %></div><div><%= settings.business_address %></div></div><% } %>
<% if (settings['hours_' + lang]) { %><div><div class="text-xs text-gray-500 uppercase mb-1"><%= t.hours_label %></div><div><%= settings['hours_' + lang] %></div></div><% } %>
</div>
</div>
</div>
</div>
</section>
<script>
document.getElementById('quoteForm').addEventListener('submit', async function(e){
  e.preventDefault();
  var btn = document.getElementById('submitBtn');
  var result = document.getElementById('formResult');
  var fd = new FormData(e.target);
  var data = {};
  fd.forEach(function(v,k){data[k]=v});
  btn.disabled = true; btn.textContent = '...';
  try {
    var res = await fetch('api/quote', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(data) });
    var json = await res.json();
    if (json.success) {
      result.className = 'p-4 rounded-lg bg-green-500/20 border border-green-500/50 text-green-300';
      result.textContent = <%- JSON.stringify(t.form_success) %>;
      result.classList.remove('hidden');
      e.target.reset();
    } else {
      throw new Error(json.error || 'Error');
    }
  } catch(err){
    result.className = 'p-4 rounded-lg bg-red-500/20 border border-red-500/50 text-red-300';
    result.textContent = <%- JSON.stringify(t.form_error) %>;
    result.classList.remove('hidden');
  } finally {
    btn.disabled = false; btn.textContent = <%- JSON.stringify(t.btn_send + ' →') %>;
  }
});
</script>
<%- include('partials/footer') %>