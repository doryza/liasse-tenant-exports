<%- include('partials/header') %>
<style>
/* pg- scoped: 2:1 bordereau/sidebar split; own breakpoint because an inline
   style would override the stylesheet's .grid-2 mobile collapse rule. */
.pg-soumission-grid { grid-template-columns: 2fr 1fr; align-items: start; }
@media (max-width: 880px) { .pg-soumission-grid { grid-template-columns: 1fr; } }
</style>
<section class="course course--paper">
<div class="container">
<div class="sec-head">
<span class="sec-index sec-index--brique">01</span>
<h1 style="font-size:clamp(1.6rem,3.5vw,2.4rem)"><%= t.contact_title %></h1>
<span class="dim-rule" aria-hidden="true"></span>
</div>
<p class="sec-sub"><%= t.contact_subtitle %></p>
<div class="grid-2 pg-soumission-grid">
<div>
<div class="bordereau">
<div class="bordereau-head"><%= lang === 'fr' ? 'Bordereau de soumission' : 'Quote form' %></div>
<form id="quoteForm" class="bordereau-body">
<div class="form-row">
<div class="form-group">
<label class="form-label" for="f-name"><%= t.form_name %> <span class="req">*</span></label>
<input class="form-control" id="f-name" name="name" required>
</div>
<div class="form-group">
<label class="form-label" for="f-email"><%= t.form_email %></label>
<input class="form-control" id="f-email" name="email" type="email">
</div>
</div>
<div class="form-row">
<div class="form-group">
<label class="form-label" for="f-phone"><%= t.form_phone %></label>
<input class="form-control" id="f-phone" name="phone" type="tel">
</div>
<div class="form-group">
<label class="form-label" for="f-address"><%= t.form_address %></label>
<input class="form-control" id="f-address" name="address">
</div>
</div>
<div class="form-row">
<div class="form-group">
<label class="form-label" for="f-type"><%= t.form_project_type %></label>
<select class="form-control" id="f-type" name="project_type">
<option value=""><%= t.form_select_type %></option>
<option value="driveway"><%= t.type_driveway %></option>
<option value="patio"><%= t.type_patio %></option>
<option value="walkway"><%= t.type_walkway %></option>
<option value="asphalt"><%= t.type_asphalt %></option>
<option value="repair"><%= t.type_repair %></option>
<option value="other"><%= t.type_other %></option>
</select>
</div>
<div class="form-group">
<label class="form-label" for="f-surface"><%= t.form_surface %></label>
<input class="form-control" id="f-surface" name="surface_area" type="text" placeholder="ex. 100">
</div>
</div>
<div class="form-group">
<label class="form-label" for="f-message"><%= t.form_message %></label>
<textarea class="form-control" id="f-message" name="message" rows="5"></textarea>
</div>
<button type="submit" id="submitBtn" class="btn btn--primary btn--block"><%= t.btn_send %> →</button>
<div id="formResult" class="hidden" aria-live="polite"></div>
</form>
</div>
</div>
<div>
<div class="fiche">
<div class="fiche-body">
<h3 class="fiche-title"><%= t.contact_info %></h3>
<ul class="coord-list">
<% if (settings.contact_phone) { %><li><span class="coord-k"><%= t.phone_label %></span><a href="tel:<%= settings.contact_phone %>"><%= settings.contact_phone %></a></li><% } %>
<% if (settings.contact_email) { %><li><span class="coord-k"><%= t.email_label %></span><a href="mailto:<%= settings.contact_email %>" style="word-break:break-all"><%= settings.contact_email %></a></li><% } %>
<% if (settings.business_address) { %><li><span class="coord-k"><%= t.address_label %></span><span><%= settings.business_address %></span></li><% } %>
<% if (settings['hours_' + lang]) { %><li><span class="coord-k"><%= t.hours_label %></span><span><%= settings['hours_' + lang] %></span></li><% } %>
</ul>
</div>
</div>
<div class="fiche" style="margin-top:1.75rem">
<div class="fiche-body">
<p class="kicker" style="margin-bottom:0.25rem">
<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
<%= lang === 'en' ? 'AI Voice Assistant' : 'Assistant vocal IA' %>
</p>
<p class="fiche-desc"><%= lang === 'en' ? 'Prefer to talk? Our AI assistant collects your project details in under 3 minutes — no form to fill.' : 'Vous préférez parler? Notre assistant IA recueille les détails de votre projet en moins de 3 minutes — sans formulaire.' %></p>
<a href="voice-assistant" class="btn"><%= lang === 'en' ? 'Start a voice session →' : 'Démarrer l\'assistant vocal →' %></a>
</div>
</div>
</div>
</div>
</div>
</section>
<script>
document.getElementById('quoteForm').addEventListener('submit', async function(e){
  e.preventDefault();
  var btn = document.getElementById('submitBtn');
  var result = document.getElementById('formResult');
  var fd = new FormData(e.target);
  var data = {};
  fd.forEach(function(v,k){data[k]=v});
  btn.disabled = true; btn.textContent = '...';
  try {
    var res = await fetch('api/quote', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(data) });
    var json = await res.json();
    if (json.success) {
      result.className = 'form-note form-note--ok';
      result.textContent = <%- JSON.stringify(t.form_success) %>;
      result.classList.remove('hidden');
      e.target.reset();
    } else {
      throw new Error(json.error || 'Error');
    }
  } catch(err){
    result.className = 'form-note form-note--err';
    result.textContent = <%- JSON.stringify(t.form_error) %>;
    result.classList.remove('hidden');
  } finally {
    btn.disabled = false; btn.textContent = <%- JSON.stringify(t.btn_send + ' →') %>;
  }
});
</script>
<%- include('partials/footer') %>
