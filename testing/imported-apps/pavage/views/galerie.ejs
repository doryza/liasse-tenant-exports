<%- include('partials/header') %>
<%
var IMG_FALLBACK = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 4 3'%3E%3Crect width='4' height='3' fill='%23BCD7DA'/%3E%3C/svg%3E";
var LINE_CLASS = { driveway: 'line--driveway', patio: 'line--patio', walkway: 'line--walkway', asphalt: 'line--asphalt' };
%>
<section class="course course--paper">
<div class="container">
<div class="sec-head">
<span class="sec-index sec-index--brique">01</span>
<h1 style="font-size:clamp(1.6rem,3.5vw,2.4rem)"><%= t.gallery_title %></h1>
<span class="dim-rule" aria-hidden="true"></span>
</div>
<p class="sec-sub"><%= t.gallery_subtitle %></p>
<nav class="filter-tabs" aria-label="<%= lang === 'fr' ? 'Filtres de la galerie' : 'Gallery filters' %>">
<a href="galerie" class="filter-tab<%= !category ? ' is-active' : '' %>"<%- !category ? ' aria-current="true"' : '' %>><span class="line-disc line--default" aria-hidden="true"></span><%= t.filter_all %></a>
<a href="?cat=driveway" class="filter-tab<%= category === 'driveway' ? ' is-active line--driveway' : '' %>"<%- category === 'driveway' ? ' aria-current="true"' : '' %>><span class="line-disc line--driveway" aria-hidden="true"></span><%= t.filter_driveway %></a>
<a href="?cat=patio" class="filter-tab<%= category === 'patio' ? ' is-active line--patio' : '' %>"<%- category === 'patio' ? ' aria-current="true"' : '' %>><span class="line-disc line--patio" aria-hidden="true"></span><%= t.filter_patio %></a>
<a href="?cat=walkway" class="filter-tab<%= category === 'walkway' ? ' is-active line--walkway' : '' %>"<%- category === 'walkway' ? ' aria-current="true"' : '' %>><span class="line-disc line--walkway" aria-hidden="true"></span><%= t.filter_walkway %></a>
<a href="?cat=asphalt" class="filter-tab<%= category === 'asphalt' ? ' is-active line--asphalt' : '' %>"<%- category === 'asphalt' ? ' aria-current="true"' : '' %>><span class="line-disc line--asphalt" aria-hidden="true"></span><%= t.filter_asphalt %></a>
</nav>
<% if (typeof projects !== 'undefined' && projects.length > 0) { %>
<div class="bond-grid">
<% projects.forEach(function(p){ %>
<a href="galerie/<%= p.id %>" class="fiche fiche--spine <%= LINE_CLASS[p.category] || 'line--default' %>">
<img class="fiche-img" src="<%= p.image_url || IMG_FALLBACK %>" alt="<%= p.title %>" loading="lazy">
<div class="fiche-body">
<span class="line-tag"><span class="line-disc <%= LINE_CLASS[p.category] || 'line--default' %>" aria-hidden="true"></span><%= p.category %></span>
<h3 class="fiche-title"><%= p.title %></h3>
<div class="fiche-meta"><%= p.location %></div>
<% if (p.completed_date) { %><div class="fiche-meta"><%= formatDate(p.completed_date, lang) %></div><% } %>
<span class="fiche-link"><%= t.btn_view_project %> →</span>
</div>
</a>
<% }) %>
</div>
<% } else { %>
<div class="empty-state">
<p><%= t.no_projects %></p>
<a href="galerie" class="btn"><%= t.filter_all %></a>
</div>
<% } %>
</div>
</section>
<%- include('partials/footer') %>
