<%- include('partials/header') %>
<section class="course course--paper">
<div class="container">
<div class="sec-head">
<span class="sec-index sec-index--ink">04</span>
<h1 style="font-size:clamp(1.6rem,3.5vw,2.4rem)"><%= t.blog_title %></h1>
<span class="dim-rule" aria-hidden="true"></span>
</div>
<p class="sec-sub"><%= t.blog_sub %></p>
<% if (typeof posts !== 'undefined' && posts.length > 0) { %>
<div class="ledger">
<% posts.forEach(function(p){ %>
<a href="blogue/<%= p.id %>" class="ledger-row">
<span class="ledger-date"><%= formatDate(p.created_at, lang) %><% if (p.category) { %><span class="line-tag" style="display:flex;margin-top:0.45rem"><span class="line-disc line--default" aria-hidden="true"></span><%= p.category %></span><% } %></span>
<span>
<span class="ledger-title"><%= p.title %></span>
<p class="ledger-excerpt"><%= (p.content || '').substring(0, 150) %>…</p>
</span>
<span class="back-link" aria-hidden="true">→</span>
</a>
<% }) %>
</div>
<% } else { %>
<div class="empty-state"><%= t.empty_default %></div>
<% } %>
</div>
<div class="chevron" style="--chev:#C2502D" aria-hidden="true"></div>
</section>
<section class="course course--brique cta-course">
<div class="container">
<h2><%= settings['cta_title_' + lang] || t.featured_projects %></h2>
<p class="sec-sub"><%= settings['cta_subtitle_' + lang] || '' %></p>
<a href="soumission" class="btn" style="margin-top:0.5rem"><%= t.cta_btn %> →</a>
</div>
</section>
<%- include('partials/footer') %>
