<%- include('partials/header', {root: '../'}) %>
<%
var IMG_FALLBACK = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 4 3'%3E%3Crect width='4' height='3' fill='%23BCD7DA'/%3E%3C/svg%3E";
%>
<section class="course course--paper">
<div class="container" style="max-width:880px">
<div style="margin-bottom:2.25rem"><a href="../blogue" class="back-link"><%= t.blog_back %></a></div>
<article>
<% if (post.category) { %><div class="line-tag" style="margin-bottom:0.9rem"><span class="line-disc line--default" aria-hidden="true"></span><%= post.category %></div><% } %>
<h1 class="h-bars wipe-in"><span class="bars"><%= post.title %></span></h1>
<div class="fiche-meta" style="margin-top:1.1rem"><%= t.published %> <%= formatDate(post.created_at, lang) %></div>
<% if (post.image_url) { %>
<div class="specimen-frame" style="margin-top:2rem">
<img src="<%= post.image_url %>" alt="<%= post.title %>" style="aspect-ratio:16 / 9">
</div>
<% } %>
<% if (post.content) { %><div class="ruled-paper" style="margin-top:2rem"><%= post.content %></div><% } %>
</article>
</div>
<% if (typeof others !== 'undefined' && others.length > 0) { %>
<div class="chevron" style="--chev:#BCD7DA" aria-hidden="true"></div>
<% } %>
</section>
<% if (typeof others !== 'undefined' && others.length > 0) { %>
<section class="course course--glacier" style="padding-top:3.25rem">
<div class="container">
<div class="sec-head">
<span class="sec-index sec-index--ink">01</span>
<h2><%= t.blog_title %></h2>
<span class="dim-rule" aria-hidden="true"></span>
</div>
<div class="grid-3" style="margin-top:1.75rem">
<% others.forEach(function(p){ %>
<a href="<%= p.id %>" class="fiche">
<% if (p.image_url) { %><img class="fiche-img" src="<%= p.image_url || IMG_FALLBACK %>" alt="<%= p.title %>" loading="lazy"><% } %>
<div class="fiche-body">
<h3 class="fiche-title"><%= p.title %></h3>
</div>
</a>
<% }) %>
</div>
</div>
</section>
<% } %>
<%- include('partials/footer', {root: '../'}) %>
