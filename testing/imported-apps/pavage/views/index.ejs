<%- include('partials/header') %>
<%
var IMG_FALLBACK = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 4 3'%3E%3Crect width='4' height='3' fill='%23BCD7DA'/%3E%3C/svg%3E";
var LINE_CLASS = { driveway: 'line--driveway', patio: 'line--patio', walkway: 'line--walkway', asphalt: 'line--asphalt' };
%>
<section class="course course--paper hero-course">
<div class="container hero-grid">
<div>
<p class="kicker"><span class="line-disc line--driveway" aria-hidden="true"></span><%= settings['tagline_' + lang] || t.brand %></p>
<h1 class="h-bars wipe-in"><span class="bars"><%= settings['hero_title_' + lang] || t.brand %></span></h1>
<p class="hero-sub"><%= settings['hero_subtitle_' + lang] || '' %></p>
<div class="hero-ctas">
<a href="soumission" class="btn btn--primary"><%= t.cta_btn %> →</a>
<a href="galerie" class="btn"><%= t.nav_gallery %></a>
</div>
<div class="spec-line">
<span>20+ <%= lang === 'fr' ? 'ans' : 'years' %></span>
<span>2500+ <%= lang === 'fr' ? 'projets' : 'projects' %></span>
<span><%= lang === 'fr' ? 'Garantie 10 ans' : '10-year warranty' %></span>
<span>98% <%= lang === 'fr' ? 'satisfaction' : 'satisfied' %></span>
<span>4.9/5 — 500+ <%= lang === 'fr' ? 'avis' : 'reviews' %></span>
</div>
</div>
<div class="specimen">
<div class="specimen-frame">
<img src="<%= (typeof settings!=='undefined' && settings._p_hero_image_url) ? settings._p_hero_image_url : IMG_FALLBACK %>" alt="<%= settings['hero_title_' + lang] || t.brand %>">
</div>
<div class="annot annot--right" aria-hidden="true"><span><%= lang === 'fr' ? 'PLAN N° 01 — RELEVÉ DE CHANTIER' : 'PLAN NO. 01 — SITE SURVEY' %></span></div>
<div class="annot annot--bottom" aria-hidden="true"><span>QUÉBEC · CA</span></div>
</div>
</div>
<div class="chevron" style="--chev:#BCD7DA" aria-hidden="true"></div>
</section>

<section class="course course--glacier" style="padding-top:3.25rem">
<div class="container">
<div class="sec-head">
<span class="sec-index">01</span>
<h2><%= t.services_title %></h2>
<span class="dim-rule" aria-hidden="true"></span>
</div>
<p class="sec-sub"><%= t.services_subtitle %></p>
<% if (typeof serviceList !== 'undefined' && serviceList.length > 0) { %>
<div class="grid-3">
<% serviceList.forEach(function(s, i){ %>
<div class="fiche fiche--spine fiche--hover spine-<%= (i % 4) + 1 %>">
<% if (s.image_url) { %><img class="fiche-img" src="<%= s.image_url %>" alt="<%= s.name %>" loading="lazy"><% } %>
<div class="fiche-body">
<h3 class="fiche-title"><%= s.name %></h3>
<p class="fiche-desc"><%= s.description %></p>
<% if (s.price_range) { %><div class="fiche-price"><%= s.price_range %></div><% } %>
<a href="soumission" class="fiche-link"><%= t.btn_learn_more %> →</a>
</div>
</div>
<% }) %>
</div>
<div class="view-all-row"><a href="services" class="btn"><%= t.btn_view_all %></a></div>
<% } else { %>
<div class="empty-state"><%= t.empty_default %></div>
<% } %>
</div>
</section>

<section class="course course--craie">
<div class="container">
<div class="sec-head">
<span class="sec-index sec-index--brique">02</span>
<h2><%= t.featured_projects %></h2>
<span class="dim-rule" aria-hidden="true"></span>
</div>
<p class="sec-sub"><%= t.featured_projects_sub %></p>
<% if (typeof projects !== 'undefined' && projects.length > 0) { %>
<div class="grid-3">
<% projects.forEach(function(p){ %>
<a href="galerie/<%= p.id %>" class="fiche fiche--spine <%= LINE_CLASS[p.category] || 'line--default' %>">
<img class="fiche-img" src="<%= p.image_url || IMG_FALLBACK %>" alt="<%= p.title %>" loading="lazy">
<div class="fiche-body">
<span class="line-tag"><span class="line-disc <%= LINE_CLASS[p.category] || 'line--default' %>" aria-hidden="true"></span><%= p.category %></span>
<h3 class="fiche-title"><%= p.title %></h3>
<div class="fiche-meta"><%= p.location %></div>
</div>
</a>
<% }) %>
</div>
<% } else { %>
<div class="empty-state"><%= t.empty_default %></div>
<% } %>
<div class="view-all-row"><a href="galerie" class="btn"><%= t.btn_view_all %> →</a></div>
</div>
<div class="chevron" style="--chev:#0A4A45" aria-hidden="true"></div>
</section>

<section class="course course--sarcelle" style="padding-top:3.25rem">
<div class="container">
<div class="sec-head">
<span class="sec-index sec-index--ocre">03</span>
<h2><%= t.testimonials_title %></h2>
<span class="dim-rule" aria-hidden="true"></span>
</div>
<p class="sec-sub"><%= t.testimonials_sub %></p>
<% if (typeof testimonials !== 'undefined' && testimonials.length > 0) { %>
<div class="grid-3">
<% testimonials.forEach(function(tt, i){ %>
<div class="fiche carnet">
<span class="quote-glyph" aria-hidden="true">«</span>
<span class="pave-row" role="img" aria-label="<%= (tt.rating || 5) %>/5">
<% for (var ri = 0; ri < (tt.rating || 5); ri++) { %><span class="pave-sq"></span><% } %>
</span>
<p class="carnet-text"><%= tt.content %></p>
<div class="carnet-author">
<span class="avatar-sq spine-<%= (i % 4) + 1 %>"><%= (tt.author || '?').charAt(0) %></span>
<div>
<div class="carnet-name"><%= tt.author %></div>
<div class="carnet-loc"><%= tt.location %></div>
</div>
</div>
</div>
<% }) %>
</div>
<% } else { %>
<div class="empty-state" style="border-color:rgba(243,240,231,.4);color:rgba(243,240,231,.75)"><%= t.empty_default %></div>
<% } %>
</div>
</section>

<% if (typeof recentPosts !== 'undefined' && recentPosts.length > 0) { %>
<section class="course course--paper">
<div class="container">
<div class="sec-head">
<span class="sec-index sec-index--ink">04</span>
<h2><%= t.blog_title %></h2>
<span class="dim-rule" aria-hidden="true"></span>
</div>
<p class="sec-sub"><%= t.blog_sub %></p>
<div class="ledger">
<% recentPosts.forEach(function(p){ %>
<a href="blogue/<%= p.id %>" class="ledger-row">
<span class="ledger-date"><% if (p.category) { %><%= p.category %><% } %></span>
<span>
<span class="ledger-title"><%= p.title %></span>
<p class="ledger-excerpt"><%= (p.content || '').substring(0, 120) %>…</p>
</span>
<span class="back-link" aria-hidden="true">→</span>
</a>
<% }) %>
</div>
<div class="view-all-row"><a href="blogue" class="btn"><%= t.btn_view_all %> →</a></div>
</div>
</section>
<% } %>

<!-- voice-module-v1 START -->
<section class="course course--glacier-soft course--tight">
<div class="container" style="max-width:880px;text-align:center">
<p class="kicker" style="justify-content:center">
<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
<%= lang === 'en' ? 'AI Voice Assistant' : 'Assistant vocal IA' %>
</p>
<h2 class="h-bars" style="margin-bottom:1rem"><span class="bars bars--ocre"><%= lang === 'en' ? 'Tell us about your project — by voice.' : 'Décrivez votre projet à la voix.' %></span></h2>
<p class="sec-sub" style="margin:0 auto 1.75rem;max-width:34rem">
<%= lang === 'en' ? 'Our AI assistant collects your details in under 3 minutes. No form to fill — just talk.' : 'Notre assistant IA recueille vos informations en moins de 3 minutes. Sans formulaire — parlez simplement.' %>
</p>
<a href="voice-assistant" class="btn btn--primary">
<%= lang === 'en' ? 'Start a voice session →' : 'Démarrer l\'assistant vocal →' %>
</a>
</div>
</section>
<!-- voice-module-v1 END -->

<section class="course course--brique cta-course">
<div class="container">
<h2><%= settings['cta_title_' + lang] || t.featured_projects %></h2>
<p class="sec-sub"><%= settings['cta_subtitle_' + lang] || '' %></p>
<a href="soumission" class="btn" style="margin-top:0.5rem"><%= t.cta_btn %> →</a>
</div>
</section>
<%- include('partials/footer') %>
