<%- include('partials/header') %>
<section class="relative overflow-hidden">
<img src="<%= (typeof settings!=='undefined' && settings._p_hero_image_url) ? settings._p_hero_image_url : 'https://placehold.co/1920x900/8b5cf6/ffffff/png?text=Pavage+Pro' %>" alt="Hero" class="absolute inset-0 w-full h-full object-cover">
<div class="absolute inset-0 bg-gradient-to-br from-dark/90 via-purple-900/60 to-pink-900/40" style="background:linear-gradient(135deg,rgba(15,10,31,.92) 0%,rgba(109,40,217,.6) 50%,rgba(190,24,93,.45) 100%)"></div>
<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-36">
<div class="max-w-3xl fade-in">
<div class="inline-block px-4 py-1.5 rounded-full glass text-sm mb-6" style="color:#a78bfa">★★★★★ <%= lang === 'fr' ? '4.9/5 — 500+ avis' : '4.9/5 — 500+ reviews' %></div>
<h1 class="section-title mb-6 text-white" style="color:#fff"><%= settings['hero_title_' + lang] || t.brand %></h1>
<p class="text-xl text-gray-200 mb-8 max-w-2xl" style="color:#e5e7eb"><%= settings['hero_subtitle_' + lang] || '' %></p>
<div class="flex flex-wrap gap-4">
<a href="soumission" class="btn-primary text-lg" style="background:linear-gradient(135deg,#8b5cf6 0%,#ec4899 100%);color:#fff"><%= t.cta_btn %> →</a>
<a href="galerie" class="btn-secondary text-lg" style="color:#fff"><%= t.nav_gallery %></a>
</div>
<div class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-4">
<div class="glass rounded-xl p-4 text-center"><div class="text-2xl md:text-3xl font-bold gradient-text">20+</div><div class="text-xs text-gray-300 mt-1"><%= lang === 'fr' ? 'années' : 'years' %></div></div>
<div class="glass rounded-xl p-4 text-center"><div class="text-2xl md:text-3xl font-bold gradient-text">2500+</div><div class="text-xs text-gray-300 mt-1"><%= lang === 'fr' ? 'projets' : 'projects' %></div></div>
<div class="glass rounded-xl p-4 text-center"><div class="text-2xl md:text-3xl font-bold gradient-text">10 <%= lang === 'fr' ? 'ans' : 'yr' %></div><div class="text-xs text-gray-300 mt-1"><%= lang === 'fr' ? 'garantie' : 'warranty' %></div></div>
<div class="glass rounded-xl p-4 text-center"><div class="text-2xl md:text-3xl font-bold gradient-text">98%</div><div class="text-xs text-gray-300 mt-1"><%= lang === 'fr' ? 'satisfaction' : 'satisfied' %></div></div>
</div>
</div>
</div>
</section>
<section class="py-20">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
<div class="text-center mb-12">
<h2 class="section-title gradient-text"><%= t.services_title %></h2>
<p class="text-gray-400 mt-3 text-lg"><%= t.services_subtitle %></p>
</div>
<% if (typeof serviceList !== 'undefined' && serviceList.length > 0) { %>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
<% serviceList.forEach(function(s){ %>
<div class="card group">
<% if (s.image_url) { %><div class="h-48 overflow-hidden"><img src="<%= s.image_url %>" alt="<%= s.name %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"></div><% } %>
<div class="p-6">
<h3 class="text-xl font-bold mb-2"><%= s.name %></h3>
<p class="text-gray-400 text-sm mb-4 line-clamp-3"><%= s.description %></p>
<% if (s.price_range) { %><div class="text-brand-light font-semibold text-sm mb-4" style="color:#a78bfa"><%= s.price_range %></div><% } %>
<a href="soumission" class="font-semibold text-sm" style="color:#a78bfa"><%= t.btn_learn_more %> →</a>
</div>
</div>
<% }) %>
</div>
<div class="text-center mt-10"><a href="services" class="btn-secondary"><%= t.btn_view_all %></a></div>
<% } else { %>
<p class="text-center text-gray-500"><%= t.empty_default %></p>
<% } %>
</div>
</section>
<section class="py-20 bg-dark-2">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
<div class="flex flex-col md:flex-row md:items-end md:justify-between mb-12 gap-4">
<div><h2 class="section-title gradient-text"><%= t.featured_projects %></h2><p class="text-gray-400 mt-3 text-lg"><%= t.featured_projects_sub %></p></div>
<a href="galerie" class="btn-secondary self-start"><%= t.btn_view_all %> →</a>
</div>
<% if (typeof projects !== 'undefined' && projects.length > 0) { %>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
<% projects.forEach(function(p){ %>
<a href="galerie/<%= p.id %>" class="card group block">
<div class="h-64 overflow-hidden relative">
<img src="<%= p.image_url || 'https://placehold.co/600x400/8b5cf6/ffffff/png' %>" alt="<%= p.title %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
<div class="absolute top-3 left-3 px-3 py-1 rounded-full text-xs font-semibold uppercase" style="background:rgba(139,92,246,.9);color:#fff"><%= p.category %></div>
</div>
<div class="p-5">
<h3 class="font-bold text-lg mb-1"><%= p.title %></h3>
<p class="text-gray-400 text-sm">📍 <%= p.location %></p>
</div>
</a>
<% }) %>
</div>
<% } else { %>
<p class="text-center text-gray-500"><%= t.empty_default %></p>
<% } %>
</div>
</section>
<section class="py-20">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
<div class="text-center mb-12">
<h2 class="section-title gradient-text"><%= t.testimonials_title %></h2>
<p class="text-gray-400 mt-3 text-lg"><%= t.testimonials_sub %></p>
</div>
<% if (typeof testimonials !== 'undefined' && testimonials.length > 0) { %>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
<% testimonials.forEach(function(tt){ %>
<div class="card p-6">
<div class="text-yellow-400 mb-3"><% for(var i=0;i<(tt.rating||5);i++){ %>★<% } %></div>
<p class="text-gray-300 mb-4 italic">"<%= tt.content %>"</p>
<div class="flex items-center gap-3">
<div class="w-10 h-10 rounded-full flex items-center justify-center font-bold" style="background:linear-gradient(135deg,#8b5cf6 0%,#ec4899 100%);color:#fff"><%= (tt.author||'?').charAt(0) %></div>
<div>
<div class="font-semibold"><%= tt.author %></div>
<div class="text-xs text-gray-400"><%= tt.location %></div>
</div>
</div>
</div>
<% }) %>
</div>
<% } else { %>
<p class="text-center text-gray-500"><%= t.empty_default %></p>
<% } %>
</div>
</section>
<% if (typeof recentPosts !== 'undefined' && recentPosts.length > 0) { %>
<section class="py-20 bg-dark-2">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
<div class="flex flex-col md:flex-row md:items-end md:justify-between mb-12 gap-4">
<div><h2 class="section-title gradient-text"><%= t.blog_title %></h2><p class="text-gray-400 mt-3 text-lg"><%= t.blog_sub %></p></div>
<a href="blogue" class="btn-secondary self-start"><%= t.btn_view_all %> →</a>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
<% recentPosts.forEach(function(p){ %>
<a href="blogue/<%= p.id %>" class="card group block">
<% if (p.image_url) { %><div class="h-48 overflow-hidden"><img src="<%= p.image_url %>" alt="<%= p.title %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"></div><% } %>
<div class="p-5">
<% if (p.category) { %><div class="text-xs font-semibold uppercase mb-2" style="color:#a78bfa"><%= p.category %></div><% } %>
<h3 class="font-bold text-lg mb-2"><%= p.title %></h3>
<p class="text-gray-400 text-sm line-clamp-2"><%= (p.content || '').substring(0, 120) %>...</p>
</div>
</a>
<% }) %>
</div>
</div>
</section>
<% } %>
<!-- voice-module-v1 START -->
<section class="py-20 bg-dark-2">
<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
<div class="card p-10 md:p-14 text-center" style="background:linear-gradient(135deg,rgba(139,92,246,.13) 0%,rgba(236,72,153,.09) 100%);border:1px solid rgba(139,92,246,.28)">
<div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-5" style="background:rgba(139,92,246,.18);color:#a78bfa;border:1px solid rgba(139,92,246,.32)">
<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
<%= lang === 'en' ? 'AI Voice Assistant' : 'Assistant vocal IA' %>
</div>
<h2 class="section-title gradient-text mb-4">
<%= lang === 'en' ? 'Tell us about your project — by voice.' : 'Décrivez votre projet à la voix.' %>
</h2>
<p class="text-gray-400 text-lg mb-8 max-w-xl mx-auto">
<%= lang === 'en' ? 'Our AI assistant collects your details in under 3 minutes. No form to fill — just talk.' : 'Notre assistant IA recueille vos informations en moins de 3 minutes. Sans formulaire — parlez simplement.' %>
</p>
<a href="voice-assistant" class="btn-primary text-lg inline-flex items-center gap-2" style="background:linear-gradient(135deg,#8b5cf6 0%,#ec4899 100%);color:#fff">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
<%= lang === 'en' ? 'Start a voice session →' : 'Démarrer l\'assistant vocal →' %>
</a>
</div>
</div>
</section>
<!-- voice-module-v1 END -->
<section class="py-24">
<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
<div class="relative rounded-3xl overflow-hidden glow" style="background:linear-gradient(135deg,#8b5cf6 0%,#ec4899 100%)">
<div class="relative p-12 md:p-16 text-center">
<h2 class="text-3xl md:text-5xl font-bold mb-4" style="color:#fff"><%= settings['cta_title_' + lang] || t.featured_projects %></h2>
<p class="text-xl mb-8" style="color:rgba(255,255,255,.92)"><%= settings['cta_subtitle_' + lang] || '' %></p>
<a href="soumission" class="inline-block font-bold px-8 py-4 rounded-xl hover:scale-105 transition" style="background:#fff;color:#6d28d9"><%= t.cta_btn %> →</a>
</div>
</div>
</div>
</section>
<%- include('partials/footer') %>
