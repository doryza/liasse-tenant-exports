<%
// `root` lets nested views (galerie/:id, blogue/:id) prefix shell links
// with '../' so every URL stays relative to the app mount.
var root = (typeof root !== 'undefined' && root) ? root : '';
%><!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0E6B63">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<title><%= (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle + ' | ' : '' %><%= settings.business_name || t.brand %></title>
<meta name="description" content="<%= settings['tagline_' + lang] || t.brand %>">
<link rel="manifest" href="<%= root %>manifest.json">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="<%= root %>public/css/styles.css">
</head>
<body>
<header class="masthead">
<div class="container masthead-utility">
<% if (settings.contact_phone) { %><a href="tel:<%= settings.contact_phone %>"><%= settings.contact_phone %></a><% } %>
<span class="lang-tabs" role="group" aria-label="Langue / Language">
<a href="?lang=fr" class="lang-tab" <%- lang === 'fr' ? 'aria-current="true"' : '' %>>FR</a>
<a href="?lang=en" class="lang-tab" <%- lang === 'en' ? 'aria-current="true"' : '' %>>EN</a>
</span>
<a href="#" data-login-btn><%= t.nav_login %></a>
</div>
<div class="container masthead-main">
<a href="<%= root %>." class="wordmark">
<img src="<%= (typeof settings!=='undefined' && settings._p_nav_logo_url) ? settings._p_nav_logo_url : (typeof appIconUrl!=='undefined' ? appIconUrl : '') %>" alt="Logo" onerror="this.style.display='none'">
<span class="wordmark-name"><%= settings.business_name || t.brand %></span>
</a>
<nav class="cad-nav" aria-label="Navigation principale">
<a href="<%= root %>services" class="cad-link"><span class="cad-num">01</span><%= t.nav_services %></a>
<a href="<%= root %>galerie" class="cad-link"><span class="cad-num">02</span><%= t.nav_gallery %></a>
<a href="<%= root %>a-propos" class="cad-link"><span class="cad-num">03</span><%= t.nav_about %></a>
<a href="<%= root %>blogue" class="cad-link"><span class="cad-num">04</span><%= t.nav_blog %></a>
<a href="<%= root %>soumission" class="cad-cta"><%= t.btn_quote %></a>
</nav>
<button id="mobileMenuBtn" aria-label="Menu" aria-controls="mobileMenu" aria-expanded="false">
<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="3" y="3" width="8" height="8"/><rect x="13" y="3" width="8" height="8"/><rect x="3" y="13" width="8" height="8"/><rect x="13" y="13" width="8" height="8"/></svg>
</button>
</div>
</header>
<div id="mobileMenu" class="hidden">
<a href="<%= root %>." class="mm-band mm-band--craie"><span class="cad-num">00</span><%= t.nav_home %></a>
<a href="<%= root %>services" class="mm-band mm-band--sarcelle"><span class="cad-num">01</span><%= t.nav_services %></a>
<a href="<%= root %>galerie" class="mm-band mm-band--glacier"><span class="cad-num">02</span><%= t.nav_gallery %></a>
<a href="<%= root %>a-propos" class="mm-band mm-band--ocre"><span class="cad-num">03</span><%= t.nav_about %></a>
<a href="<%= root %>blogue" class="mm-band mm-band--ink"><span class="cad-num">04</span><%= t.nav_blog %></a>
<a href="<%= root %>soumission" class="mm-band mm-band--brique"><span class="cad-num">05</span><%= t.btn_quote %></a>
<div class="mm-utility">
<span class="lang-tabs">
<a href="?lang=fr" class="lang-tab" <%- lang === 'fr' ? 'aria-current="true"' : '' %>>FR</a>
<a href="?lang=en" class="lang-tab" <%- lang === 'en' ? 'aria-current="true"' : '' %>>EN</a>
</span>
<a href="#" data-login-btn><%= t.nav_login %></a>
</div>
</div>
<a href="<%= root %>soumission" class="devis-tab"><%= t.btn_quote %> →</a>
<div class="tape-bar">
<div class="tape-bar-inner">
<% if (settings.contact_phone) { %><a href="tel:<%= settings.contact_phone %>" class="tape-tel"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg><%= settings.contact_phone %></a><% } else { %><span></span><% } %>
<a href="<%= root %>soumission" class="tape-cta"><%= t.btn_quote %></a>
</div>
</div>
<script>
(function(){var b=document.getElementById('mobileMenuBtn'),m=document.getElementById('mobileMenu');if(b&&m){b.addEventListener('click',function(){m.classList.toggle('hidden');b.setAttribute('aria-expanded',m.classList.contains('hidden')?'false':'true')})}})();
</script>
