<%
var root = (typeof root !== 'undefined' && root) ? root : '';
%><div class="chevron chevron--flush" style="--chev:#1E2421" aria-hidden="true"></div>
<footer class="site-footer">
<div class="container">
<div class="foot-grid">
<div>
<div class="foot-brand"><%= settings.business_name || t.brand %></div>
<p class="foot-tagline"><%= t.footer_tagline %></p>
</div>
<div class="foot-col">
<h4><%= t.footer_quick %></h4>
<ul>
<li><a href="<%= root %>services"><%= t.nav_services %></a></li>
<li><a href="<%= root %>galerie"><%= t.nav_gallery %></a></li>
<li><a href="<%= root %>a-propos"><%= t.nav_about %></a></li>
<li><a href="<%= root %>blogue"><%= t.nav_blog %></a></li>
<li><a href="<%= root %>soumission"><%= t.nav_contact %></a></li>
</ul>
</div>
<div class="foot-col">
<h4><%= t.footer_contact %></h4>
<ul>
<% if (settings.contact_phone) { %><li><a href="tel:<%= settings.contact_phone %>"><%= settings.contact_phone %></a></li><% } %>
<% if (settings.contact_email) { %><li><a href="mailto:<%= settings.contact_email %>"><%= settings.contact_email %></a></li><% } %>
<% if (settings.business_address) { %><li><%= settings.business_address %></li><% } %>
<% if (settings['hours_' + lang]) { %><li><%= settings['hours_' + lang] %></li><% } %>
</ul>
</div>
<div class="foot-col">
<h4><%= t.footer_follow %></h4>
<div class="social-row">
<% if (settings.social_facebook) { %><a href="<%= settings.social_facebook %>" target="_blank" rel="noopener" class="social-sq" aria-label="Facebook">FB</a><% } %>
<% if (settings.social_instagram) { %><a href="<%= settings.social_instagram %>" target="_blank" rel="noopener" class="social-sq" aria-label="Instagram">IG</a><% } %>
<% if (settings.social_linkedin) { %><a href="<%= settings.social_linkedin %>" target="_blank" rel="noopener" class="social-sq" aria-label="LinkedIn">IN</a><% } %>
<% if (settings.social_youtube) { %><a href="<%= settings.social_youtube %>" target="_blank" rel="noopener" class="social-sq" aria-label="YouTube">YT</a><% } %>
</div>
<button data-push-btn class="push-btn"><%= lang === 'fr' ? 'Activer les notifications' : 'Enable notifications' %></button>
</div>
</div>
<div class="foot-base">
<span>© <%= new Date().getFullYear() %> <%= settings.business_name || t.brand %>. <%= t.footer_rights %>.</span>
<span><%= settings['tagline_' + lang] || '' %></span>
</div>
</div>
</footer>
<script>
setTimeout(function(){try{if(window.TenantSDK&&TenantSDK.ui){TenantSDK.ui.showInstallBanner();}}catch(e){}},3000);
setTimeout(function(){try{if(window.TenantSDK&&TenantSDK.ui){TenantSDK.ui.showPushPrompt();}}catch(e){}},9000);
</script>
</body>
</html>
