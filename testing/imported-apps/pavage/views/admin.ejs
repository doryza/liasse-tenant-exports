<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Admin — Pavage Pro</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="public/css/admin-styles.css">
</head>
<body class="bg-gray-50">
<%- include('partials/admin-sidebar', { active: 'dashboard' }) %>
<main class="admin-main">
<header class="admin-header">
<button id="sidebarToggle" class="md:hidden p-2 rounded hover:bg-gray-100" aria-label="Menu">☰</button>
<div>
<h1 class="text-2xl font-bold">Tableau de bord</h1>
<p class="text-sm text-gray-500">Bienvenue dans votre espace administrateur</p>
</div>
<div class="flex gap-2">
<a href="admin/settings" class="px-4 py-2 bg-white border border-purple-200 text-purple-700 rounded-lg hover:bg-purple-50 text-sm font-semibold">⚙️ Paramètres</a>
<a href="." target="_blank" class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 text-sm font-semibold">↗ Voir le site</a>
</div>
</header>
<div class="p-6 space-y-6">
<% if (counts.newQuotes > 0) { %>
<div class="bg-gradient-to-r from-purple-600 to-pink-500 text-white rounded-xl p-5 flex items-center justify-between" style="background:linear-gradient(135deg,#8b5cf6 0%,#ec4899 100%);color:#fff">
<div>
<div class="font-bold text-lg">📬 <%= counts.newQuotes %> nouvelle<%= counts.newQuotes > 1 ? 's' : '' %> demande<%= counts.newQuotes > 1 ? 's' : '' %> à traiter</div>
<div class="text-sm opacity-90">Des clients attendent votre réponse</div>
</div>
<a href="admin/quotes" class="px-4 py-2 bg-white text-purple-700 rounded-lg font-semibold hover:scale-105 transition" style="background:#fff;color:#6d28d9">Voir →</a>
</div>
<% } %>
<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
<div class="stat-card"><div class="stat-label">👥 Utilisateurs</div><div class="stat-value"><%= stats.userCount %></div></div>
<div class="stat-card"><div class="stat-label">🔔 Abonnés push</div><div class="stat-value"><%= stats.pushCount %></div></div>
<div class="stat-card"><div class="stat-label">📊 Visites totales</div><div class="stat-value"><%= stats.visitsTotal %></div></div>
<div class="stat-card"><div class="stat-label">📈 Visites (7j)</div><div class="stat-value"><%= stats.visits7 %></div></div>
</div>
<div>
<h2 class="text-lg font-bold mb-3 text-gray-800">Gérer le contenu</h2>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
<a href="admin/posts" class="module-card"><div class="module-icon">📝</div><div class="flex-1"><div class="module-title">Articles</div><div class="module-count"><%= counts.posts %> article<%= counts.posts !== 1 ? 's' : '' %></div></div><span class="text-purple-400">→</span></a>
<a href="admin/projects" class="module-card"><div class="module-icon">🖼️</div><div class="flex-1"><div class="module-title">Projets / Galerie</div><div class="module-count"><%= counts.projects %> projet<%= counts.projects !== 1 ? 's' : '' %></div></div><span class="text-purple-400">→</span></a>
<a href="admin/services" class="module-card"><div class="module-icon">🔧</div><div class="flex-1"><div class="module-title">Services</div><div class="module-count"><%= counts.services %> service<%= counts.services !== 1 ? 's' : '' %></div></div><span class="text-purple-400">→</span></a>
<a href="admin/testimonials" class="module-card"><div class="module-icon">⭐</div><div class="flex-1"><div class="module-title">Témoignages</div><div class="module-count"><%= counts.testimonials %> témoignage<%= counts.testimonials !== 1 ? 's' : '' %></div></div><span class="text-purple-400">→</span></a>
<a href="admin/quotes" class="module-card"><div class="module-icon">📨</div><div class="flex-1"><div class="module-title">Demandes de soumission</div><div class="module-count"><%= counts.quotes %> demande<%= counts.quotes !== 1 ? 's' : '' %><% if (counts.newQuotes > 0) { %> · <span class="text-purple-700 font-semibold"><%= counts.newQuotes %> nouvelle<%= counts.newQuotes > 1 ? 's' : '' %></span><% } %></div></div><span class="text-purple-400">→</span></a>
<a href="admin/settings" class="module-card"><div class="module-icon">⚙️</div><div class="flex-1"><div class="module-title">Paramètres du site</div><div class="module-count">Hero, à propos, contact, social</div></div><span class="text-purple-400">→</span></a>
</div>
</div>
<div class="bg-white rounded-xl p-6 shadow-sm">
<div class="flex items-center justify-between mb-4">
<h2 class="text-lg font-bold">📨 Demandes récentes</h2>
<a href="admin/quotes" class="text-sm text-purple-600 hover:underline font-semibold">Tout voir →</a>
</div>
<% if (recentQuotes && recentQuotes.length > 0) { %>
<div class="overflow-x-auto">
<table class="w-full text-sm">
<thead><tr class="border-b text-left text-gray-500 text-xs uppercase"><th class="py-2">Date</th><th>Nom</th><th>Contact</th><th>Type</th><th>Statut</th></tr></thead>
<tbody>
<% recentQuotes.forEach(function(q){ %>
<tr class="border-b hover:bg-gray-50">
<td class="py-3 text-gray-600"><%= new Date(q.created_at).toLocaleDateString('fr-CA') %></td>
<td class="font-semibold"><%= q.name %></td>
<td class="text-gray-600"><%= q.email || q.phone || '—' %></td>
<td class="text-gray-600"><%= q.project_type || '—' %></td>
<td><span class="px-2 py-1 rounded-full text-xs font-semibold <%= q.status === 'new' ? 'bg-purple-100 text-purple-700' : (q.status === 'won' ? 'bg-green-100 text-green-700' : (q.status === 'lost' ? 'bg-red-100 text-red-600' : 'bg-gray-100 text-gray-600')) %>"><%= q.status %></span></td>
</tr>
<% }) %>
</tbody>
</table>
</div>
<% } else { %>
<div class="text-center py-8">
<div class="text-5xl mb-3">📭</div>
<p class="text-gray-500">Aucune demande pour le moment.</p>
<p class="text-xs text-gray-400 mt-2">Les nouvelles demandes apparaîtront ici dès qu’un client soumet le formulaire.</p>
</div>
<% } %>
</div>
</div>
</main>
<script>
document.getElementById('sidebarToggle')?.addEventListener('click',function(){document.querySelector('.admin-sidebar').classList.toggle('open')});
</script>
</body>
</html>