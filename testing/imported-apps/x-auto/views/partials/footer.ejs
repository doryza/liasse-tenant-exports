<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="brand" style="margin-bottom:1rem"><span><span class="brand-x">X</span><span class="brand-auto">-Auto</span></span></div>
        <p><%= typeof settings !== 'undefined' && settings['about_text_' + lang] ? settings['about_text_' + lang].substring(0, 160) + '...' : t.tagline %></p>
      </div>
      <div>
        <h4><%= t.footer_links %></h4>
        <ul>
          <li><a href="."><%= t.nav_home %></a></li>
          <li><a href="inventaire"><%= t.nav_inventory %></a></li>
          <li><a href="financement"><%= t.nav_financing %></a></li>
          <li><a href="rendez-vous"><%= t.nav_appointment %></a></li>
          <li><a href="temoignages"><%= t.nav_testimonials %></a></li>
          <li><a href="contact"><%= t.nav_contact %></a></li>
        </ul>
      </div>
      <div>
        <h4><%= t.footer_contact %></h4>
        <ul>
          <% if (typeof settings !== 'undefined' && settings.contact_phone) { %><li><a href="tel:<%= settings.contact_phone %>"><%= settings.contact_phone %></a></li><% } %>
          <% if (typeof settings !== 'undefined' && settings.contact_email) { %><li><a href="mailto:<%= settings.contact_email %>"><%= settings.contact_email %></a></li><% } %>
          <% if (typeof settings !== 'undefined' && settings.business_address) { %><li style="white-space:pre-line"><%= settings.business_address %></li><% } %>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">© <%= new Date().getFullYear() %> X-Auto. <%= t.footer_rights %></div>
  </div>
</footer>
<script src="public/js/app.js"></script>
</body>
</html>
