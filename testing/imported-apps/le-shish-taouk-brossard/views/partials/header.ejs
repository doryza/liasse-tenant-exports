<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#17110c">
<title><%= page === 'menu' ? t.menu_meta_title : 'Le Shish Taouk — ' + t.meta_title %></title>
<meta name="description" content="<%= page === 'menu' ? t.menu_meta_desc : t.meta_desc %>">
<link rel="manifest" href="manifest.json">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,600..900&family=Figtree:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="public/css/styles.css">
<link rel="stylesheet" href="public/css/welcome-gift.css">
</head>
<body class="page-<%= page %>">
<a class="skip" href="#main" data-lk="t:skip"><%= t.skip %></a>
<header class="site-head">
  <div class="wrap head-row">
    <a class="brand" href="<%= homeHref %>" aria-label="Le Shish Taouk">
      <% if (logoUrl) { %><img class="brand-logo" src="<%= logoUrl %>" alt="Le Shish Taouk" width="56" height="56" data-setting-key="_p_nav_logo_url"><% } %>
      <span class="brand-word">Le Shish Taouk<small>Brossard</small></span>
    </a>
    <nav class="head-nav" aria-label="<%= t.menu_jump %>">
      <a href="<%= homeHref %>" class="hide-sm<%= page === 'home' ? ' on' : '' %>" data-lk="t:nav_home"><%= t.nav_home %></a>
      <a href="<%= menuHref %>" class="<%= page === 'menu' ? 'on' : '' %>" data-lk="t:nav_menu"><%= t.nav_menu %></a>
      <a href="<%= homeHref %>#visit" class="hide-sm" data-lk="t:nav_visit"><%= t.nav_visit %></a>
      <span class="lang" aria-label="Langue / Language"><a href="<%= langFr %>" class="<%= lang === 'fr' ? 'on' : '' %>" hreflang="fr">FR</a><a href="<%= langEn %>" class="<%= lang === 'en' ? 'on' : '' %>" hreflang="en">EN</a></span>
      <a class="btn btn-amber btn-sm" href="<%= orderUrl %>" data-lk="t:nav_order"><%= t.nav_order %></a>
    </nav>
  </div>
</header>
