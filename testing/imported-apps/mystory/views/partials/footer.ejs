<footer class="mt-auto bg-brand-ink text-brand-soft py-12">
  <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-3 gap-8">
    <div>
      <h3 data-lk="t:brand" class="serif text-xl font-semibold mb-2"><%= t.brand %></h3>
      <p data-setting-key="tagline_<%= lang %>" class="text-sm opacity-80 leading-relaxed"><%= t.tagline %></p>
    </div>
    <div>
      <h4 data-lk="footer-nav-heading" class="font-medium uppercase tracking-wider text-xs opacity-60 mb-3">Navigation</h4>
      <ul class="space-y-2 text-sm">
        <li><a href="." data-lk="t:nav_home" class="hover:text-brand"><%= t.nav_home %></a></li>
        <li><a href="library" data-lk="t:nav_library" class="hover:text-brand"><%= t.nav_library %></a></li>
        <li><a href="about" data-lk="t:nav_about" class="hover:text-brand"><%= t.nav_about %></a></li>
        <li><a href="contact" data-lk="t:nav_contact" class="hover:text-brand"><%= t.nav_contact %></a></li>
      </ul>
    </div>
    <div>
      <h4 data-lk="t:enable_notif" class="font-medium uppercase tracking-wider text-xs opacity-60 mb-3"><%= t.enable_notif %></h4>
      <p data-lk="footer-notif-desc" class="text-sm opacity-80 mb-3"><%= lang==='en'?'Be the first to know when a new story drops.':'Soyez la première à savoir quand une nouvelle histoire paraît.' %></p>
      <button data-push-btn data-lk="footer-push-btn" class="btn-secondary px-4 py-2 rounded-full text-xs uppercase tracking-wider"><%= lang==='en'?'Enable notifications':'Activer les notifications' %></button>
    </div>
  </div>
  <div class="max-w-6xl mx-auto px-4 mt-10 pt-6 border-t border-brand-soft/20 text-xs opacity-60 flex flex-col sm:flex-row justify-between gap-2">
    <span data-lk="footer-copyright">© <%= new Date().getFullYear() %> <%= t.brand %>. <%= t.footer_copyright %></span>
    <span data-lk="footer-crafted"><%= lang==='en'?'Crafted with care.':'Fait avec soin.' %></span>
  </div>
</footer>
<script src="public/js/app.js"></script>
</body>
</html>
