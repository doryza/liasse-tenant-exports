<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#f1ffd6">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="description" content="<%= (typeof t!=='undefined'?t.tagline:'My Story') %>">
<title><%= (typeof pageTitle !== 'undefined' ? pageTitle + ' — ' : '') + (typeof t!=='undefined'?t.brand:'My Story') %></title>
<link rel="manifest" href="manifest.json">
<link rel="icon" href="<%= typeof appIconUrl!=='undefined' && appIconUrl ? appIconUrl : '' %>">
<script src="https://cdn.tailwindcss.com"></script>
<script>tailwind.config={theme:{extend:{colors:{brand:'#f1ffd6','brand-soft':'#fbfff0','brand-deep':'#3a4d1a','brand-ink':'#1f2a0e','brand-accent':'#8a9d4d'},fontFamily:{serif:['Lora','Georgia','serif'],sans:['Inter','system-ui','sans-serif']}}}}</script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
<style>
body{font-family:'Inter',system-ui,sans-serif;background:#fbfff0;color:#1f2a0e}
h1,h2,h3,h4,.serif{font-family:'Lora',Georgia,serif}
.btn-primary{background:#1f2a0e;color:#f1ffd6;transition:all .2s}
.btn-primary:hover{background:#3a4d1a;transform:translateY(-1px);box-shadow:0 4px 12px rgba(31,42,14,.25)}
.btn-secondary{background:#f1ffd6;color:#1f2a0e;border:1px solid #1f2a0e;transition:all .2s}
.btn-secondary:hover{background:#e7f5c4}
.book-cover{aspect-ratio:3/4;object-fit:cover;box-shadow:0 10px 30px -10px rgba(31,42,14,.4)}
.prose-reader{font-family:'Lora',Georgia,serif;font-size:1.1rem;line-height:1.85;color:#1f2a0e}
.prose-reader p{margin-bottom:1.2em}
.prose-reader h2{font-size:1.6rem;margin-top:2.5em;margin-bottom:1em;font-weight:600;border-bottom:1px solid #d4e4a8;padding-bottom:.4em}
.fade-in{animation:fadeIn .4s ease-out}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
a:focus-visible,button:focus-visible{outline:2px solid #3a4d1a;outline-offset:2px;border-radius:4px}
.line-clamp-2{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.line-clamp-3{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
</style>
</head>
<body class="min-h-screen flex flex-col">
<header class="sticky top-0 z-40 bg-brand-soft/95 backdrop-blur border-b border-brand-accent/30">
  <nav class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
    <a href="." class="flex items-center gap-2 group">
      <img data-setting-key="_p_nav_logo_url" src="<%= (typeof settings!=='undefined' && settings._p_nav_logo_url) ? settings._p_nav_logo_url : (typeof appIconUrl!=='undefined' && appIconUrl ? appIconUrl : '') %>" alt="My Story" class="w-9 h-9 rounded-full object-cover bg-brand" onerror="this.style.display='none'">
      <div class="flex flex-col leading-tight">
        <span data-lk="t:brand" class="serif font-semibold text-lg text-brand-ink"><%= t.brand %></span>
        <span data-setting-key="tagline_<%= lang %>" class="text-[10px] uppercase tracking-widest text-brand-accent hidden sm:inline"><%= t.tagline %></span>
      </div>
    </a>
    <div class="hidden md:flex items-center gap-6 text-sm font-medium">
      <a href="." data-lk="t:nav_home" class="hover:text-brand-deep"><%= t.nav_home %></a>
      <a href="library" data-lk="t:nav_library" class="hover:text-brand-deep"><%= t.nav_library %></a>
      <a href="about" data-lk="t:nav_about" class="hover:text-brand-deep"><%= t.nav_about %></a>
      <a href="contact" data-lk="t:nav_contact" class="hover:text-brand-deep"><%= t.nav_contact %></a>
      <span class="text-brand-accent/60">|</span>
      <a href="?lang=fr" class="<%= lang==='fr'?'font-bold underline':'opacity-60' %>">FR</a>
      <a href="?lang=en" class="<%= lang==='en'?'font-bold underline':'opacity-60' %>">EN</a>
      <a href="#" data-login-btn data-lk="t:nav_login" class="btn-primary px-4 py-2 rounded-full text-xs uppercase tracking-wider" style="background-color:#1f2a0e;color:#f1ffd6"><%= t.nav_login %></a>
      <a href="library" data-auth-only data-lk="t:view_purchases" style="display:none" class="btn-secondary px-4 py-2 rounded-full text-xs uppercase tracking-wider"><%= t.view_purchases %></a>
    </div>
    <button id="hamburger" aria-label="Menu" class="md:hidden p-2 text-brand-ink">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </nav>
  <div id="mobile-menu" class="md:hidden hidden border-t border-brand-accent/30 bg-brand-soft">
    <div class="px-4 py-3 flex flex-col gap-3 text-sm font-medium">
      <a href="." data-lk="t:nav_home" class="py-2"><%= t.nav_home %></a>
      <a href="library" data-lk="t:nav_library" class="py-2"><%= t.nav_library %></a>
      <a href="about" data-lk="t:nav_about" class="py-2"><%= t.nav_about %></a>
      <a href="contact" data-lk="t:nav_contact" class="py-2"><%= t.nav_contact %></a>
      <div class="flex gap-3 py-2"><a href="?lang=fr" class="<%= lang==='fr'?'font-bold underline':'opacity-60' %>">FR</a> | <a href="?lang=en" class="<%= lang==='en'?'font-bold underline':'opacity-60' %>">EN</a></div>
      <button data-login-btn data-lk="t:nav_login" class="btn-primary py-3 rounded-full text-xs uppercase tracking-wider mt-2" style="background-color:#1f2a0e;color:#f1ffd6"><%= t.nav_login %></button>
      <a href="library" data-auth-only data-lk="t:view_purchases" style="display:none" class="btn-secondary py-3 rounded-full text-xs uppercase tracking-wider text-center"><%= t.view_purchases %></a>
    </div>
  </div>
</header>
<script>
(function(){
  var btn=document.getElementById('hamburger');
  var menu=document.getElementById('mobile-menu');
  if(btn&&menu){btn.addEventListener('click',function(){menu.classList.toggle('hidden');});}
})();
</script>
