<%- include('partials/header') %>
<main class="flex-1">
  <section class="max-w-3xl mx-auto px-4 py-12">
    <a href="story/<%= story.id %>" data-lk="checkout-back-link" class="text-sm text-brand-accent hover:text-brand-deep">← <%= lang==='en'?'Back to book':'Retour au livre' %></a>
    <h1 data-lk="t:checkout_title" class="serif text-3xl md:text-4xl font-semibold text-brand-ink mt-4"><%= t.checkout_title %></h1>
    <p data-lk="t:checkout_sub" class="text-brand-ink/70 mt-2"><%= t.checkout_sub %></p>
    <div class="mt-8 grid md:grid-cols-[180px_1fr] gap-6 bg-brand-soft p-6 rounded-xl border border-brand-accent/20">
      <img data-content-source="stories:image_url" data-content-id="<%= story.id %>" src="<%= story.image_url || 'https://placehold.co/600x800/3a4d1a/f1ffd6/png?text='+encodeURIComponent(story.title) %>" alt="<%= story.title %>" class="book-cover w-full rounded">
      <div>
        <% if (story.genre) { %><span data-content-source="stories:genre" data-content-id="<%= story.id %>" class="text-[11px] uppercase tracking-widest text-brand-accent"><%= story.genre %></span><% } %>
        <h2 data-content-source="stories:title" data-content-id="<%= story.id %>" class="serif text-2xl font-semibold text-brand-ink"><%= story.title %></h2>
        <% if (story.subtitle) { %><p data-content-source="stories:subtitle" data-content-id="<%= story.id %>" class="italic text-brand-ink/70"><%= story.subtitle %></p><% } %>
        <div class="mt-4 flex items-baseline gap-2">
          <span class="text-3xl serif font-semibold text-brand-deep"><%= fmtPrice(story.price_cents) %></span>
          <span data-lk="t:ebook" class="text-sm text-brand-ink/60"><%= t.ebook %></span>
        </div>
      </div>
    </div>
    <form id="checkoutForm" class="mt-8 space-y-5 bg-white p-6 rounded-xl border border-brand-accent/20">
      <input type="hidden" name="story_id" value="<%= story.id %>">
      <div>
        <label data-lk="t:form_name" class="block text-sm font-medium mb-1"><%= t.form_name %> *</label>
        <input name="name" required class="w-full px-4 py-3 rounded-lg border border-brand-accent/30 focus:border-brand-deep focus:outline-none" placeholder="<%= lang==='en'?'Jane Doe':'Marie Tremblay' %>">
      </div>
      <div>
        <label data-lk="t:form_email" class="block text-sm font-medium mb-1"><%= t.form_email %> *</label>
        <input name="email" type="email" required class="w-full px-4 py-3 rounded-lg border border-brand-accent/30 focus:border-brand-deep focus:outline-none" placeholder="<%= lang==='en'?'jane@example.com':'marie@exemple.com' %>">
        <p data-lk="checkout-email-hint" class="text-xs text-brand-ink/60 mt-1"><%= lang==='en'?'Use the email you sign in with to access the book in your library.':'Utilisez le courriel avec lequel vous vous connectez pour accéder au livre dans votre bibliothèque.' %></p>
      </div>
      <div>
        <label data-lk="t:form_phone" class="block text-sm font-medium mb-1"><%= t.form_phone %></label>
        <input name="phone" class="w-full px-4 py-3 rounded-lg border border-brand-accent/30 focus:border-brand-deep focus:outline-none">
      </div>
      <div>
        <label data-lk="t:form_message" class="block text-sm font-medium mb-1"><%= t.form_message %></label>
        <textarea name="message" rows="3" class="w-full px-4 py-3 rounded-lg border border-brand-accent/30 focus:border-brand-deep focus:outline-none" placeholder="<%= lang==='en'?'A note for the author...':'Un mot pour l\'auteure...' %>"></textarea>
      </div>
      <button type="submit" data-lk="t:form_submit" class="w-full btn-primary py-3 rounded-full font-medium" style="background-color:#1f2a0e;color:#f1ffd6"><%= t.form_submit %> — <%= fmtPrice(story.price_cents) %></button>
      <p data-lk="t:please_login_to_buy" class="text-xs text-center text-brand-ink/60"><%= t.please_login_to_buy %></p>
    </form>
    <div id="checkoutSuccess" class="hidden mt-8 p-8 bg-brand rounded-xl border-2 border-brand-deep" style="background-color:#f1ffd6">
      <div class="text-4xl mb-3">✨</div>
      <h2 data-lk="t:checkout_success_title" class="serif text-2xl font-semibold text-brand-ink"><%= t.checkout_success_title %></h2>
      <p data-lk="t:checkout_success_msg" class="text-brand-ink/80 mt-2"><%= t.checkout_success_msg %></p>
      <div class="mt-6 p-5 bg-white rounded-lg">
        <h3 data-lk="t:payment_instructions" class="serif font-semibold text-brand-ink mb-2"><%= t.payment_instructions %></h3>
        <p data-setting-key="payment_instructions_<%= lang %>" class="text-sm text-brand-ink/80 leading-relaxed whitespace-pre-line"><%= t.payment_instructions_text || (lang==='en'?'Send an Interac e-Transfer to mystorybook@liasse.tech using the reference below.':'Faites un virement Interac à mystorybook@liasse.tech en utilisant la référence ci-dessous.') %></p>
        <div class="mt-4 flex items-center justify-between bg-brand-soft p-3 rounded">
          <div><span data-lk="t:reference" class="text-xs text-brand-ink/60"><%= t.reference %></span><div id="refDisplay" class="font-mono font-semibold text-brand-deep"></div></div>
          <button type="button" onclick="navigator.clipboard.writeText(document.getElementById('refDisplay').textContent)" data-lk="checkout-copy-btn" class="text-xs btn-secondary px-3 py-1 rounded"><%= lang==='en'?'Copy':'Copier' %></button>
        </div>
        <div class="mt-3 flex items-center justify-between bg-brand-soft p-3 rounded">
          <div><span data-lk="t:amount_due" class="text-xs text-brand-ink/60"><%= t.amount_due %></span><div class="font-semibold text-brand-deep"><%= fmtPrice(story.price_cents) %></div></div>
        </div>
      </div>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="library" data-lk="t:view_purchases" class="btn-primary px-5 py-2 rounded-full text-sm" style="background-color:#1f2a0e;color:#f1ffd6"><%= t.view_purchases %></a>
        <a href="." data-lk="t:back_home" class="btn-secondary px-5 py-2 rounded-full text-sm"><%= t.back_home %></a>
      </div>
    </div>
    <div id="checkoutError" class="hidden mt-6 p-4 bg-red-50 border border-red-200 rounded-lg text-sm text-red-800"></div>
  </section>
</main>
<script>
document.getElementById('checkoutForm').addEventListener('submit', async function(e){
  e.preventDefault();
  var btn = e.target.querySelector('button[type=submit]');
  var orig = btn.textContent;
  btn.disabled = true; btn.textContent = '<%- lang==='en'?'Processing...':'Envoi...' %>';
  var data = Object.fromEntries(new FormData(e.target));
  try {
    var res = await fetch('./api/checkout', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(data) });
    var json = await res.json();
    if (!res.ok) throw new Error(json.error || 'Error');
    document.getElementById('checkoutForm').classList.add('hidden');
    document.getElementById('refDisplay').textContent = json.reference;
    document.getElementById('checkoutSuccess').classList.remove('hidden');
    window.scrollTo({ top: document.getElementById('checkoutSuccess').offsetTop - 80, behavior: 'smooth' });
  } catch(err) {
    var errEl = document.getElementById('checkoutError');
    errEl.textContent = err.message;
    errEl.classList.remove('hidden');
    btn.disabled = false; btn.textContent = orig;
  }
});
</script>
<%- include('partials/footer') %>
