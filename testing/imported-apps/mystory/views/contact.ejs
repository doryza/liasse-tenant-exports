<%- include('partials/header') %>
<main class="flex-1">
  <section class="max-w-2xl mx-auto px-4 py-14">
    <h1 data-lk="t:contact_title" class="serif text-3xl md:text-4xl font-semibold text-brand-ink"><%= t.contact_title %></h1>
    <p data-setting-key="contact_text_<%= lang %>" class="text-brand-ink/70 mt-2"><%= t.contact_text || t.contact_sub %></p>
    <form id="contactForm" class="mt-8 space-y-5 bg-white p-6 rounded-xl border border-brand-accent/20">
      <div><label data-lk="t:form_name" class="block text-sm font-medium mb-1"><%= t.form_name %> *</label><input name="name" required class="w-full px-4 py-3 rounded-lg border border-brand-accent/30 focus:border-brand-deep focus:outline-none"></div>
      <div><label data-lk="t:form_email" class="block text-sm font-medium mb-1"><%= t.form_email %></label><input name="email" type="email" class="w-full px-4 py-3 rounded-lg border border-brand-accent/30 focus:border-brand-deep focus:outline-none"></div>
      <div><label data-lk="contact-message-label" class="block text-sm font-medium mb-1"><%= lang==='en'?'Message':'Message' %> *</label><textarea name="message" rows="5" required class="w-full px-4 py-3 rounded-lg border border-brand-accent/30 focus:border-brand-deep focus:outline-none"></textarea></div>
      <button type="submit" data-lk="t:form_submit" class="w-full btn-primary py-3 rounded-full font-medium" style="background-color:#1f2a0e;color:#f1ffd6"><%= t.form_submit %></button>
    </form>
    <div id="contactSuccess" class="hidden mt-6 p-6 bg-brand rounded-xl border-2 border-brand-deep text-center" style="background-color:#f1ffd6">
      <div class="text-4xl mb-2">💌</div>
      <p data-lk="t:contact_sent" class="font-medium text-brand-ink"><%= t.contact_sent %></p>
    </div>
    <div id="contactError" class="hidden mt-4 p-4 bg-red-50 border border-red-200 rounded-lg text-sm text-red-800"></div>
  </section>
</main>
<script>
document.getElementById('contactForm').addEventListener('submit', async function(e){
  e.preventDefault();
  var btn = e.target.querySelector('button[type=submit]');
  btn.disabled = true; var orig = btn.textContent; btn.textContent = '<%- lang==='en'?'Sending...':'Envoi...' %>';
  var data = Object.fromEntries(new FormData(e.target));
  try {
    var res = await fetch('./api/contact', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(data) });
    var json = await res.json();
    if (!res.ok) throw new Error(json.error || 'Error');
    e.target.classList.add('hidden');
    document.getElementById('contactSuccess').classList.remove('hidden');
  } catch(err) {
    var errEl = document.getElementById('contactError');
    errEl.textContent = err.message; errEl.classList.remove('hidden');
    btn.disabled = false; btn.textContent = orig;
  }
});
</script>
<%- include('partials/footer') %>
