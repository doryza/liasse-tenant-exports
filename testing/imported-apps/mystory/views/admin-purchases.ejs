<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Commandes — Admin</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="public/css/admin-styles.css">
</head>
<body class="bg-slate-50 min-h-screen">
<%- include('partials/admin-sidebar', { active: 'purchases' }) %>
<main class="admin-main">
  <header class="admin-header">
    <button class="admin-burger" onclick="document.querySelector('.admin-sidebar').classList.toggle('open')" aria-label="Menu">☰</button>
    <div class="flex-1">
      <h1 class="text-xl font-semibold text-slate-900">Commandes</h1>
      <p class="text-xs text-slate-500">Validez les paiements pour donner accès aux livres.</p>
    </div>
    <input id="filter" placeholder="Rechercher nom, courriel, livre..." class="px-3 py-2 border border-slate-300 rounded-lg text-sm w-56 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 focus:outline-none">
  </header>
  <div class="p-6">
    <% if (purchases && purchases.length > 0) { %>
      <div class="flex flex-wrap gap-2 mb-4">
        <button onclick="filterStatus('')" class="filter-pill active" data-pill="">Toutes (<%= purchases.length %>)</button>
        <button onclick="filterStatus('pending')" class="filter-pill" data-pill="pending">⏳ En attente (<%= purchases.filter(function(p){return p.status==='pending';}).length %>)</button>
        <button onclick="filterStatus('paid')" class="filter-pill" data-pill="paid">✓ Payées (<%= purchases.filter(function(p){return p.status==='paid';}).length %>)</button>
        <button onclick="filterStatus('cancelled')" class="filter-pill" data-pill="cancelled">Annulées (<%= purchases.filter(function(p){return p.status==='cancelled';}).length %>)</button>
      </div>
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-slate-50 border-b border-slate-200 sticky top-0"><tr><th class="th">Date</th><th class="th">Livre</th><th class="th">Client</th><th class="th">Référence</th><th class="th text-right">Montant</th><th class="th">Statut</th><th class="th text-right">Actions</th></tr></thead>
            <tbody id="rows" class="divide-y divide-slate-100">
              <% purchases.forEach(function(p){ %>
                <tr data-search="<%= ((p.customer_name||'')+' '+(p.customer_email||'')+' '+(p.story_title||'')+' '+(p.payment_reference||'')).toLowerCase() %>" data-status="<%= p.status %>" class="hover:bg-slate-50 transition">
                  <td class="td text-slate-500 text-xs whitespace-nowrap"><%= new Date(p.created_at).toLocaleDateString(lang==='en'?'en-CA':'fr-CA') %></td>
                  <td class="td font-medium text-slate-900"><%= p.story_title || '—' %></td>
                  <td class="td"><div class="font-medium text-slate-900"><%= p.customer_name %></div><div class="text-xs text-slate-500"><%= p.customer_email %><% if (p.customer_phone) { %> · <%= p.customer_phone %><% } %></div></td>
                  <td class="td font-mono text-xs text-slate-600"><%= p.payment_reference %></td>
                  <td class="td text-right font-semibold"><%= ((p.amount_cents||0)/100).toFixed(2) %> $</td>
                  <td class="td"><span class="badge <%= p.status==='paid'?'badge-green':p.status==='pending'?'badge-orange':'badge-slate' %>"><%= p.status==='paid'?'✓ Payé':p.status==='pending'?'⏳ En attente':'Annulé' %></span></td>
                  <td class="td text-right whitespace-nowrap">
                    <% if (p.status === 'pending') { %>
                      <button onclick="markPaid(<%= p.id %>)" class="px-3 py-1.5 bg-green-600 text-white rounded-lg text-xs font-medium hover:bg-green-700 transition">✓ Marquer payé</button>
                    <% } %>
                    <% if (p.customer_message) { %>
                      <button onclick='showMessage(<%= JSON.stringify(p.customer_message) %>, <%= JSON.stringify(p.customer_name) %>)' class="icon-btn" title="Voir le message">💬</button>
                    <% } %>
                    <button onclick="deletePurchase(<%= p.id %>)" class="icon-btn icon-btn-danger" title="Supprimer">🗑</button>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } else { %>
      <div class="empty-state-large">
        <div class="text-6xl mb-3">🛒</div>
        <h3 class="text-lg font-semibold text-slate-700 mb-1">Aucune commande</h3>
        <p class="text-sm text-slate-500">Les commandes des lectrices apparaîtront ici.</p>
      </div>
    <% } %>
  </div>
</main>
<div id="msgModal" class="modal-overlay hidden">
  <div class="modal-card max-w-md">
    <div class="modal-header"><h3 class="font-semibold">💬 Message de <span id="msgFrom"></span></h3><button onclick="document.getElementById('msgModal').classList.add('hidden')" class="modal-close">×</button></div>
    <div class="p-6"><p id="msgBody" class="text-sm text-slate-700 whitespace-pre-line bg-slate-50 p-4 rounded-lg"></p></div>
  </div>
</div>
<div id="toast" class="toast hidden"></div>
<script>
function toast(msg, type){const t=document.getElementById('toast');t.textContent=msg;t.className='toast '+(type||'success');t.classList.remove('hidden');setTimeout(()=>t.classList.add('hidden'),2400);}
function showMessage(msg, name){document.getElementById('msgFrom').textContent=name||'';document.getElementById('msgBody').textContent=msg||'';document.getElementById('msgModal').classList.remove('hidden');}
document.getElementById('filter').addEventListener('input', function(e){ const q = e.target.value.toLowerCase(); document.querySelectorAll('#rows tr').forEach(tr => { tr.style.display = tr.dataset.search.includes(q) ? '' : 'none'; }); });
function filterStatus(s){document.querySelectorAll('.filter-pill').forEach(p=>p.classList.toggle('active',p.dataset.pill===s));document.querySelectorAll('#rows tr').forEach(tr=>{tr.style.display=(s===''||tr.dataset.status===s)?'':'none';});}
async function markPaid(id){ if (!confirm('Confirmer que le paiement a bien été reçu ?\n\nUn courriel sera envoyé au client avec l\'accès au livre.')) return; const r = await fetch('./api/admin/purchases/'+id, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ status: 'paid' }) }); if (r.ok){toast('Commande validée — courriel envoyé');setTimeout(()=>location.reload(),900);} else toast('Erreur','error'); }
async function deletePurchase(id){ if (!confirm('Supprimer cette commande ?')) return; const r=await fetch('./api/admin/purchases/'+id, { method:'DELETE' }); if(r.ok){toast('Supprimée');setTimeout(()=>location.reload(),600);} else toast('Erreur','error'); }
</script>
</body>
</html>
