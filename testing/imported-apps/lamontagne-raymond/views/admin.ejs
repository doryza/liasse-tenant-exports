<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tableau de bord · Administration</title>
<link rel="stylesheet" href="public/css/admin-styles.css">
<link href="https://fonts.googleapis.com/css2?family=Zilla+Slab:wght@600;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="admin-body">
<%- include('partials/admin-sidebar') %>
<main class="admin-main">
<header class="admin-topbar"><button class="admin-burger" onclick="document.body.classList.toggle('sidebar-open')" aria-label="Menu">☰</button><h1>Tableau de bord</h1><a class="btn-ghost" href="." target="_blank">Voir le site</a></header>
<div class="admin-content">
<div class="dash-welcome"><h2>Bienvenue dans votre espace</h2><p>Gérez vos services, votre boutique et vos demandes en un coup d'œil.</p></div>
<div class="stat-grid">
<div class="stat-card"><span class="ic blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg></span><div class="sc-body"><div class="n"><%= stats.visitsTotal %></div><div class="l">Visites totales</div></div></div>
<div class="stat-card"><span class="ic green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 17l6-6 4 4 7-7"/><path d="M14 7h7v7"/></svg></span><div class="sc-body"><div class="n"><%= stats.visits7 %></div><div class="l">Visites (7 jours)</div></div></div>
<div class="stat-card"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></span><div class="sc-body"><div class="n"><%= stats.users %></div><div class="l">Comptes clients</div></div></div>
<div class="stat-card"><span class="ic orange"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg></span><div class="sc-body"><div class="n"><%= stats.pushSubs %></div><div class="l">Abonnés notifications</div></div></div>
</div>
<% var pending=(stats.quotesNew||0)+(stats.bookingsNew||0)+(stats.ordersNew||0); %>
<% if(pending>0){ %>
<div class="attn-banner"><div><strong><%= pending %> élément(s) à traiter</strong> — <%= stats.quotesNew %> soumission(s), <%= stats.bookingsNew %> rendez-vous, <%= stats.ordersNew %> commande(s)</div><a class="btn-primary" href="admin/quotes">Voir les demandes</a></div>
<% } %>
<div class="admin-card"><h2>Contenu du site</h2><div class="mod-grid">
<a class="mod-link" href="admin/services"><span class="t">Services</span><span class="c"><%= stats.services %> service(s)</span></a>
<a class="mod-link" href="admin/products"><span class="t">Boutique</span><span class="c"><%= stats.products %> produit(s)</span></a>
<a class="mod-link" href="admin/posts"><span class="t">Conseils</span><span class="c"><%= stats.posts %> article(s)</span></a>
<a class="mod-link" href="admin/testimonials"><span class="t">Témoignages</span><span class="c"><%= stats.testimonials %> avis</span></a>
</div></div>
<div class="admin-card"><h2>Demandes &amp; ventes</h2><div class="mod-grid">
<a class="mod-link" href="admin/quotes"><span class="t">Soumissions / Contacts</span><span class="c"><%= stats.quotesNew %> nouvelle(s)</span></a>
<a class="mod-link" href="admin/bookings"><span class="t">Rendez-vous</span><span class="c"><%= stats.bookingsNew %> nouveau(x)</span></a>
<a class="mod-link" href="admin/orders"><span class="t">Commandes</span><span class="c"><%= stats.ordersNew %> à traiter</span></a>
</div></div>
<div class="admin-card"><h2>Réglages du site</h2><p class="muted" style="margin-top:0">Modifiez les textes d'accueil, les coordonnées et les instructions de paiement affichés sur le site public.</p><a class="btn-ghost" href="admin/settings">Ouvrir les réglages</a></div>
<div class="admin-card"><h2>Dernières demandes</h2>
<% if(recentQuotes.length){ %><div class="table-scroll"><table class="admin-table"><thead><tr><th>Client</th><th>Service</th><th>Source</th><th>Date</th></tr></thead><tbody>
<% recentQuotes.forEach(function(q){ %><tr><td><%= q.customer_name||'—' %></td><td><%= q.service_type||'—' %></td><td><span class="badge grey"><%= q.source||'' %></span></td><td><%= formatDate(q.created_at) %></td></tr><% }); %>
</tbody></table></div><% } else { %><div class="empty-state"><p class="muted">Aucune demande pour l'instant.</p></div><% } %>
</div>
<div class="admin-card"><h2>Dernières commandes</h2>
<% if(recentOrders.length){ %><div class="table-scroll"><table class="admin-table"><thead><tr><th>#</th><th>Client</th><th>Total</th><th>Statut</th><th>Date</th></tr></thead><tbody>
<% recentOrders.forEach(function(o){ %><tr><td>#<%= o.id %></td><td><%= o.customer_name %></td><td><%= Number(o.total).toFixed(2).replace('.',',') %> $</td><td><span class="badge orange"><%= o.status %></span></td><td><%= formatDate(o.created_at) %></td></tr><% }); %>
</tbody></table></div><% } else { %><div class="empty-state"><p class="muted">Aucune commande pour l'instant.</p></div><% } %>
</div>
</div>
</main>
</body>
</html>