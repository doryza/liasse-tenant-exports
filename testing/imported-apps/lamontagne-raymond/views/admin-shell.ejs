<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · Administration</title>
<link rel="stylesheet" href="public/css/admin-styles.css">
<link href="https://fonts.googleapis.com/css2?family=Zilla+Slab:wght@600;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="admin-body">
<%- include('partials/admin-sidebar') %>
<main class="admin-main">
<header class="admin-topbar"><button class="admin-burger" onclick="document.body.classList.toggle('sidebar-open')" aria-label="Menu">☰</button><h1><%= moduleLabel %></h1><button class="btn-primary" onclick="openModal(null)">+ Nouveau</button></header>
<div id="alert" class="admin-alert" style="display:none"></div>
<div class="admin-card">
<div class="table-toolbar">
<input type="text" id="searchBox" class="search-input" placeholder="Rechercher…" oninput="renderTable()">
<select id="statusFilter" class="filter-select" style="display:none" onchange="renderTable()"></select>
<span id="countBadge" class="count-badge"></span>
<button class="btn-ghost" type="button" onclick="loadItems()">Actualiser</button>
</div>
<div id="tableWrap"><p class="muted">Chargement…</p></div>
</div>
</main>
<div id="modal" class="modal" style="display:none"><div class="modal-box"><div class="modal-head"><h2 id="modalTitle">Nouveau</h2><button class="modal-x" onclick="closeModal()" aria-label="Fermer">×</button></div><form id="form" onsubmit="return saveItem(event)"><div id="formFields"></div><div class="modal-foot"><button type="button" class="btn-ghost" onclick="closeModal()">Annuler</button><button type="submit" class="btn-primary">Enregistrer</button></div></form></div></div>
<script>
var MODULE=<%- JSON.stringify(moduleKey) %>;
var FIELDS=<%- JSON.stringify(fields) %>;
var items=[];
var editId=null;
function esc(s){ if(s===null||s===undefined) return ''; return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function showAlert(m){ var a=document.getElementById('alert'); a.textContent=m; a.style.display='block'; setTimeout(function(){ a.style.display='none'; },2600); }
function badgeClass(v){ v=(v||'').toLowerCase(); if(/(nouveau|reçue|en préparation)/.test(v)) return 'orange'; if(/(confirmé|payée|gagné|livrée|terminé|soumis)/.test(v)) return 'green'; if(/(annulé|perdu)/.test(v)) return 'grey'; return 'blue'; }
function colFields(){ var allowed=FIELDS.filter(function(f){ return ['text','number','select','date','email'].indexOf(f.type)>=0; }); var pick=allowed.slice(0,4); var st=FIELDS.filter(function(f){ return f.name==='status'; })[0]; if(st && pick.indexOf(st)<0){ pick=pick.slice(0,3); pick.push(st); } return pick; }
function fmtDate(d){ try{ return new Date(d).toLocaleDateString('fr-CA'); }catch(e){ return ''; } }
function setupStatusFilter(){ var st=FIELDS.filter(function(f){ return f.name==='status'; })[0]; var sel=document.getElementById('statusFilter'); if(st && st.options){ sel.style.display='inline-block'; sel.innerHTML='<option value="">Tous les statuts</option>'+st.options.map(function(o){ return '<option>'+esc(o)+'</option>'; }).join(''); } }
function getFiltered(){ var sb=document.getElementById('searchBox'); var q=(sb?sb.value:'').toLowerCase(); var sfEl=document.getElementById('statusFilter'); var sf=sfEl?sfEl.value:''; return items.filter(function(it){ if(sf && it.status!==sf) return false; if(!q) return true; return FIELDS.some(function(f){ var v=it[f.name]; return v!==null&&v!==undefined&&String(v).toLowerCase().indexOf(q)>=0; }); }); }
function loadItems(){ fetch('api/admin/'+MODULE).then(function(r){ return r.json(); }).then(function(d){ items=d[MODULE]||[]; renderTable(); }).catch(function(){ document.getElementById('tableWrap').innerHTML='<p class="muted">Erreur de chargement.</p>'; }); }
function renderTable(){ var cols=colFields(); var imgF=FIELDS.filter(function(f){ return f.type==='image'; })[0]; var hasTotal=FIELDS.filter(function(f){ return f.name==='total'; }).length>0; var countEl=document.getElementById('countBadge'); if(!items.length){ document.getElementById('tableWrap').innerHTML='<div class="empty-state"><p class="muted">Aucune entrée pour le moment. Cliquez « + Nouveau » pour en ajouter.</p></div>'; if(countEl) countEl.textContent=''; return; } var list=getFiltered(); if(countEl) countEl.textContent=list.length+' / '+items.length; if(!list.length){ document.getElementById('tableWrap').innerHTML='<div class="empty-state"><p class="muted">Aucun résultat pour ces critères.</p></div>'; return; } var h='<div class="table-scroll"><table class="admin-table"><thead><tr>'; if(imgF) h+='<th></th>'; cols.forEach(function(f){ h+='<th>'+esc(f.label||f.name)+'</th>'; }); if(hasTotal) h+='<th>Total</th>'; h+='<th>Date</th><th></th></tr></thead><tbody>'; list.forEach(function(it){ h+='<tr>'; if(imgF){ var u=it[imgF.name]; h+='<td>'+(u?('<img class="thumb" src="'+esc(u)+'">'):'<div class="thumb" style="background:#eceee9"></div>')+'</td>'; } cols.forEach(function(f){ var v=it[f.name]; if(f.name==='status'){ h+='<td><span class="badge '+badgeClass(v)+'">'+esc(v||'')+'</span></td>'; } else if(f.type==='number' && (f.name==='price')){ h+='<td>'+((v!==null&&v!=='')?(Number(v).toFixed(2).replace('.',',')+' $'):'—')+'</td>'; } else if(f.type==='boolean'){ h+='<td>'+(v==1?'Oui':'Non')+'</td>'; } else { h+='<td>'+esc(v!==null&&v!==undefined?String(v).slice(0,60):'')+'</td>'; } }); if(hasTotal){ h+='<td>'+((it.total!==null&&it.total!==undefined)?(Number(it.total).toFixed(2).replace('.',',')+' $'):'—')+'</td>'; } h+='<td>'+fmtDate(it.created_at)+'</td>'; h+='<td><div class="row-actions"><button class="edit" onclick="openModal('+it.id+')">Modifier</button><button class="del" onclick="delItem('+it.id+')">Suppr.</button></div></td>'; h+='</tr>'; }); h+='</tbody></table></div>'; document.getElementById('tableWrap').innerHTML=h; }
function fieldHtml(f,val){ var id='f_'+f.name; var label=esc(f.label||f.name)+(f.required?' *':''); var hint=f.description?('<div class="hint">'+esc(f.description)+'</div>'):''; if(f.type==='readonly'){ var disp=val; if(f.name==='items'){ try{ var arr=JSON.parse(val||'[]'); disp=arr.map(function(l){ return '• '+l.qty+' × '+l.name+' ('+Number(l.price).toFixed(2)+' $)'; }).join('\n'); }catch(e){} } return '<div class="ff"><label>'+label+'</label><div class="ro">'+esc((disp!==null&&disp!==undefined)?disp:'—')+'</div>'+hint+'</div>'; } if(f.type==='boolean'){ return '<div class="ff"><div class="chk"><input type="checkbox" id="'+id+'" '+((val==1||val===true)?'checked':'')+'><label for="'+id+'" style="margin:0">'+label+'</label></div>'+hint+'</div>'; } if(f.type==='textarea'){ return '<div class="ff"><label for="'+id+'">'+label+'</label><textarea id="'+id+'" placeholder="'+esc(f.placeholder||'')+'">'+esc(val||'')+'</textarea>'+hint+'</div>'; } if(f.type==='select'){ var o=(f.options||[]).map(function(op){ return '<option value="'+esc(op)+'" '+(val===op?'selected':'')+'>'+esc(op)+'</option>'; }).join(''); return '<div class="ff"><label for="'+id+'">'+label+'</label><select id="'+id+'"><option value="">—</option>'+o+'</select>'+hint+'</div>'; } if(f.type==='image'){ return '<div class="ff"><label>'+label+'</label><div class="img-field"><img class="preview" id="prev_'+f.name+'" src="'+(val?esc(val):'')+'"><input type="hidden" id="'+id+'" value="'+esc(val||'')+'"><div class="img-actions"><label class="up">Téléverser<input type="file" accept="image/*" onchange="uploadImg(this,&quot;'+f.name+'&quot;)"></label><button type="button" class="btn-ghost" onclick="aiImg(&quot;'+f.name+'&quot;)">Générer (IA)</button></div></div>'+hint+'</div>'; } var ty=f.type==='number'?'number':(f.type==='date'?'date':(f.type==='email'?'email':'text')); var extra=f.type==='number'?((f.min!==undefined?(' min="'+f.min+'"'):'')+(f.step!==undefined?(' step="'+f.step+'"'):'')):''; return '<div class="ff"><label for="'+id+'">'+label+'</label><input type="'+ty+'" id="'+id+'" value="'+esc((val!==null&&val!==undefined)?val:'')+'" placeholder="'+esc(f.placeholder||'')+'"'+extra+'>'+hint+'</div>'; }
function openModal(id){ editId=id||null; var it=id?items.filter(function(x){ return x.id===id; })[0]:{}; it=it||{}; document.getElementById('modalTitle').textContent=id?'Modifier':'Nouveau'; document.getElementById('formFields').innerHTML=FIELDS.map(function(f){ return fieldHtml(f,it[f.name]); }).join(''); document.getElementById('modal').style.display='flex'; }
function closeModal(){ document.getElementById('modal').style.display='none'; editId=null; }
function uploadImg(input,name){ var file=input.files[0]; if(!file) return; var rd=new FileReader(); rd.onload=function(){ fetch('api/admin/upload',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({dataUri:rd.result})}).then(function(r){ return r.json(); }).then(function(d){ if(d.url){ document.getElementById('f_'+name).value=d.url; document.getElementById('prev_'+name).src=d.url; } else showAlert(d.error||'Échec du téléversement'); }).catch(function(){ showAlert('Échec du téléversement'); }); }; rd.readAsDataURL(file); }
function aiImg(name){ var p=prompt('Décrivez l image à générer :'); if(!p) return; showAlert('Génération en cours…'); fetch('api/admin/generate-image',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({prompt:p,aspectRatio:'4:3'})}).then(function(r){ return r.json(); }).then(function(d){ if(d.imageUrl){ document.getElementById('f_'+name).value=d.imageUrl; document.getElementById('prev_'+name).src=d.imageUrl; showAlert('Image générée'); } else showAlert(d.error||'Échec de la génération'); }).catch(function(){ showAlert('Échec de la génération'); }); }
function saveItem(e){ e.preventDefault(); var data={}; FIELDS.forEach(function(f){ if(f.type==='readonly') return; var el=document.getElementById('f_'+f.name); if(!el) return; if(f.type==='boolean') data[f.name]=el.checked?1:0; else data[f.name]=el.value; }); var url='api/admin/'+MODULE+(editId?('/'+editId):''); var method=editId?'PUT':'POST'; fetch(url,{method:method,headers:{'Content-Type':'application/json'},body:JSON.stringify(data)}).then(function(r){ return r.json(); }).then(function(d){ if(d.error){ showAlert(d.error); return; } closeModal(); loadItems(); showAlert('Enregistré'); }).catch(function(){ showAlert('Erreur d enregistrement'); }); return false; }
function delItem(id){ if(!confirm('Supprimer cette entrée ?')) return; fetch('api/admin/'+MODULE+'/'+id,{method:'DELETE'}).then(function(r){ return r.json(); }).then(function(){ loadItems(); showAlert('Supprimé'); }).catch(function(){ showAlert('Erreur'); }); }
setupStatusFilter();
loadItems();
</script>
</body>
</html>