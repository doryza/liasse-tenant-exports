<%- include('partials/header') %>
<section class="py-16 md:py-24 bg-cream">
<div class="max-w-7xl mx-auto px-4 md:px-6">
<div class="text-center mb-14">
<div class="text-xs tracking-[0.4em] uppercase text-brand mb-3"><%= t.all_services %></div>
<h1 class="font-display text-5xl md:text-6xl text-ink mb-4"><%= t.services_title %></h1>
<p class="text-ink/60 max-w-2xl mx-auto"><%= t.services_subtitle %></p>
</div>
<% if (typeof categories !== 'undefined' && categories.length > 1) { %>
<div class="flex flex-wrap justify-center gap-2 mb-10">
<button data-cat="all" class="cat-filter px-5 py-2 rounded-full bg-brand text-white text-sm tracking-wide" style="background-color:#6366f1;color:#fff"><%= lang==='en' ? 'All' : 'Tous' %></button>
<% categories.forEach(function(c){ %><button data-cat="<%= c %>" class="cat-filter px-5 py-2 rounded-full bg-white border border-champagne text-sm tracking-wide hover:border-brand"><%= c %></button><% }) %>
</div>
<% } %>
<% if (typeof allServices !== 'undefined' && allServices.length > 0) { %>
<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8" id="services-grid">
<% allServices.forEach(function(s){ %>
<article class="service-card group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500" data-cat="<%= s.category || '' %>">
<a href="services/<%= s.slug %>" class="block aspect-[4/3] overflow-hidden bg-champagne/30">
<img src="<%= s.image_url || 'https://placehold.co/600x450/e8dcc7/6366f1/png' %>" alt="<%= s.name %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
</a>
<div class="p-6">
<% if (s.category) { %><div class="text-[10px] tracking-[0.3em] uppercase text-brand mb-2"><%= s.category %></div><% } %>
<h3 class="font-display text-2xl mb-2 text-ink"><a href="services/<%= s.slug %>" class="hover:text-brand transition"><%= s.name %></a></h3>
<p class="text-sm text-ink/60 mb-5 min-h-[3rem]"><%= s.short_description || '' %></p>
<div class="flex items-center justify-between text-sm mb-5 pb-5 border-b border-champagne/40">
<div><div class="text-[10px] tracking-widest uppercase text-ink/40"><%= t.services_from %></div><div class="font-display text-xl text-ink"><%= formatPrice(s.price_cents) %></div></div>
<div class="text-right"><div class="text-[10px] tracking-widest uppercase text-ink/40"><%= t.services_duration %></div><div class="text-ink"><%= s.duration_minutes %> <%= t.services_minutes %></div></div>
</div>
<div class="flex gap-2">
<a href="services/<%= s.slug %>" class="flex-1 text-center py-2.5 rounded-full border border-ink/20 text-sm hover:border-brand hover:text-brand transition"><%= t.services_learn_more %></a>
<a href="booking?service=<%= s.id %>" class="flex-1 text-center py-2.5 rounded-full bg-brand text-white text-sm hover:bg-brand-dark transition" style="background-color:#6366f1;color:#fff"><%= t.services_book_btn %></a>
</div>
</div>
</article>
<% }) %>
</div>
<% } else { %>
<div class="text-center py-20"><p class="text-ink/50"><%= t.empty_services %></p></div>
<% } %>
</div>
</section>
<script>
(function(){var btns=document.querySelectorAll('.cat-filter'),cards=document.querySelectorAll('.service-card');btns.forEach(function(b){b.addEventListener('click',function(){var c=b.dataset.cat;btns.forEach(function(x){x.classList.remove('bg-brand','text-white');x.style.backgroundColor='';x.style.color='';x.classList.add('bg-white','border','border-champagne');});b.classList.remove('bg-white','border','border-champagne');b.classList.add('bg-brand','text-white');b.style.backgroundColor='#6366f1';b.style.color='#fff';cards.forEach(function(card){if(c==='all'||card.dataset.cat===c){card.style.display='';}else{card.style.display='none';}});});});})();
</script>
<%- include('partials/footer') %>