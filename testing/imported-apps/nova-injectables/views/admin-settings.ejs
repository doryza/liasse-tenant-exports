<!DOCTYPE html>
<html lang="<%= lang %>">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Admin · Paramètres</title><link rel="stylesheet" href="public/css/tailwind.css"><link rel="stylesheet" href="public/css/admin-styles.css"></head>
<body class="bg-slate-50 min-h-screen">
<%- include('partials/admin-sidebar') %>
<main class="admin-main">
<header class="flex items-center justify-between mb-8 flex-wrap gap-4">
<div>
<div class="text-[11px] tracking-[0.3em] uppercase text-slate-400 mb-1">Configuration</div>
<h1 class="text-3xl font-semibold text-slate-900">Paramètres</h1>
<p class="text-slate-500 mt-1 text-sm">Réglages opérationnels du site</p>
</div>
<button onclick="document.getElementById('admin-sidebar').classList.toggle('mobile-open')" class="md:hidden p-2 bg-white rounded-lg shadow border border-slate-200">☰</button>
</header>
<div id="status" class="hidden mb-4 p-3 rounded-lg text-sm"></div>
<div class="bg-white rounded-xl shadow-sm border border-slate-100 p-6 md:p-8 max-w-3xl">
<div class="flex items-start gap-3 p-4 mb-6 rounded-lg bg-brand/5 border border-brand/10">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" class="flex-shrink-0 mt-0.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
<p class="text-sm text-slate-700">Configurez les paramètres avancés du site (paiement, politique, réseaux sociaux). Les textes visibles (titres, descriptions) se modifient directement sur le site public.</p>
</div>
<form id="settings-form" class="space-y-5"></form>
<div class="mt-6 pt-6 border-t border-slate-100 flex justify-end">
<button type="button" onclick="saveAll()" id="save-all" class="px-6 py-3 rounded-full bg-brand text-white text-sm font-medium hover:bg-brand-dark transition" style="background-color:#6366f1;color:#fff">Enregistrer les paramètres</button>
</div>
</div>
</main>
<script>
let fields = [];
let currentSettings = {};
async function load() {
  try {
    const m = await (await fetch('api/admin/modules')).json();
    fields = m.settingsFields || [];
    const s = await (await fetch('api/admin/settings')).json();
    currentSettings = s.settings || {};
    render();
  } catch(e) { showStatus('Erreur de chargement', 'error'); }
}
function render() {
  const f = document.getElementById('settings-form');
  f.innerHTML = '';
  fields.forEach(field => {
    const wrap = document.createElement('div');
    const val = currentSettings[field.name] || '';
    let input = '';
    if (field.type === 'textarea') input = '<textarea name="' + field.name + '" rows="3" class="w-full px-3 py-2 border border-slate-300 rounded-lg outline-none focus:border-brand focus:ring-2 focus:ring-brand/20 text-sm">' + String(val).replace(/</g, '&lt;') + '</textarea>';
    else input = '<input type="' + (field.type === 'url' ? 'url' : 'text') + '" name="' + field.name + '" value="' + String(val).replace(/"/g, '&quot;') + '" class="w-full px-3 py-2 border border-slate-300 rounded-lg outline-none focus:border-brand focus:ring-2 focus:ring-brand/20 text-sm">';
    wrap.innerHTML = '<label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-2">' + (field.label || field.name) + '</label>' + input + (field.description ? '<p class="text-xs text-slate-500 mt-1.5">' + field.description + '</p>' : '');
    f.appendChild(wrap);
  });
}
async function saveAll() {
  const btn = document.getElementById('save-all'); btn.disabled = true; btn.textContent = 'Enregistrement...';
  let ok = true;
  for (const field of fields) {
    const el = document.getElementsByName(field.name)[0];
    if (!el) continue;
    try {
      const r = await fetch('api/admin/settings', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ key: field.name, value: el.value }) });
      if (!r.ok) ok = false;
    } catch(e) { ok = false; }
  }
  showStatus(ok ? 'Paramètres enregistrés avec succès.' : 'Erreur partielle.', ok ? 'success' : 'error');
  btn.disabled = false; btn.textContent = 'Enregistrer les paramètres';
}
function showStatus(msg, type) {
  const s = document.getElementById('status');
  s.textContent = msg;
  s.className = 'mb-4 p-3 rounded-lg text-sm ' + (type === 'success' ? 'bg-green-50 text-green-700 border border-green-200' : 'bg-red-50 text-red-700 border border-red-200');
  s.classList.remove('hidden');
  setTimeout(() => s.classList.add('hidden'), 3500);
}
load();
</script>
</body></html>