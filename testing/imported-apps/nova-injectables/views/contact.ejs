<%- include('partials/header') %>
<section class="py-16 md:py-24 bg-cream">
<div class="max-w-6xl mx-auto px-4 md:px-6">
<div class="text-center mb-14">
<div class="text-xs tracking-[0.4em] uppercase text-brand mb-3"><%= t.nav_contact %></div>
<h1 class="font-display text-5xl md:text-6xl text-ink mb-4"><%= t.contact_title %></h1>
<p class="text-ink/60 max-w-2xl mx-auto"><%= t.contact_subtitle %></p>
</div>
<div class="grid md:grid-cols-2 gap-12">
<div>
<h2 class="font-display text-2xl text-ink mb-6"><%= t.contact_info %></h2>
<div class="space-y-4 text-ink/80">
<% if (settings && settings.business_address) { %><div class="flex gap-3"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" class="flex-shrink-0 mt-1"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><div><%= settings.business_address %></div></div><% } %>
<% if (settings && settings.contact_phone) { %><div class="flex gap-3"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" class="flex-shrink-0 mt-1"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg><a href="tel:<%= settings.contact_phone %>" class="hover:text-brand"><%= settings.contact_phone %></a></div><% } %>
<% if (settings && settings.contact_email) { %><div class="flex gap-3"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" class="flex-shrink-0 mt-1"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg><a href="mailto:<%= settings.contact_email %>" class="hover:text-brand"><%= settings.contact_email %></a></div><% } %>
<% if (settings && settings.business_hours) { %><div class="flex gap-3"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" class="flex-shrink-0 mt-1"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg><div><div class="text-xs uppercase tracking-widest text-ink/40 mb-1"><%= t.contact_hours %></div><%= settings.business_hours %></div></div><% } %>
</div>
<div class="mt-10 pt-10 border-t border-champagne/40">
<h3 class="font-display text-xl text-ink mb-4"><%= lang==='en' ? 'Ready to book?' : 'Prête à réserver?' %></h3>
<a href="booking" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-brand text-white tracking-wide hover:bg-brand-dark transition" style="background-color:#6366f1;color:#fff"><%= t.hero_cta %> →</a>
</div>
</div>
<div class="bg-white rounded-3xl p-8 md:p-10 shadow-sm">
<h2 class="font-display text-2xl text-ink mb-6"><%= lang==='en' ? 'Send us a message' : 'Envoyez-nous un message' %></h2>
<form id="contact-form" class="space-y-5">
<div><label class="block text-xs tracking-widest uppercase text-ink/60 mb-2"><%= t.contact_name %> *</label><input type="text" name="name" required class="w-full px-4 py-3 border border-champagne rounded-xl focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none"></div>
<div class="grid sm:grid-cols-2 gap-4">
<div><label class="block text-xs tracking-widest uppercase text-ink/60 mb-2"><%= t.contact_email %></label><input type="email" name="email" class="w-full px-4 py-3 border border-champagne rounded-xl focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none"></div>
<div><label class="block text-xs tracking-widest uppercase text-ink/60 mb-2"><%= t.contact_phone %></label><input type="tel" name="phone" class="w-full px-4 py-3 border border-champagne rounded-xl focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none"></div>
</div>
<div><label class="block text-xs tracking-widest uppercase text-ink/60 mb-2"><%= t.contact_message %> *</label><textarea name="message" rows="5" required class="w-full px-4 py-3 border border-champagne rounded-xl focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none"></textarea></div>
<div id="contact-result" class="hidden p-4 rounded-xl text-sm"></div>
<button type="submit" id="contact-submit" class="w-full py-4 rounded-full bg-brand text-white tracking-wide hover:bg-brand-dark transition disabled:opacity-50" style="background-color:#6366f1;color:#fff"><%= t.contact_submit %></button>
</form>
</div>
</div>
</div>
</section>
<script>
(function(){var f=document.getElementById('contact-form');if(!f)return;var btn=document.getElementById('contact-submit'),res=document.getElementById('contact-result');f.addEventListener('submit',async function(e){e.preventDefault();res.classList.add('hidden');btn.disabled=true;btn.textContent='<%- t.loading %>';var fd=new FormData(f),data={};fd.forEach(function(v,k){data[k]=v;});try{var r=await fetch('./api/contact',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});var j=await r.json();if(r.ok&&j.success){res.className='p-4 rounded-xl text-sm bg-green-50 border border-green-200 text-green-700';res.textContent='<%- t.contact_success %>';res.classList.remove('hidden');f.reset();}else{res.className='p-4 rounded-xl text-sm bg-red-50 border border-red-200 text-red-700';res.textContent=j.error||'<%- t.contact_error %>';res.classList.remove('hidden');}}catch(ex){res.className='p-4 rounded-xl text-sm bg-red-50 border border-red-200 text-red-700';res.textContent='<%- t.contact_error %>';res.classList.remove('hidden');}btn.disabled=false;btn.textContent='<%- t.contact_submit %>';});})();
</script>
<%- include('partials/footer') %>