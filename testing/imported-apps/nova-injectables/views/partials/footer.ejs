<footer class="bg-ink text-cream/90 mt-20">
<div class="max-w-7xl mx-auto px-4 md:px-6 py-16 grid md:grid-cols-4 gap-10">
<div class="md:col-span-2">
<div class="font-display text-3xl mb-3">Nova <span class="text-brand-light">Injectables</span></div>
<p class="text-sm leading-relaxed text-cream/70 max-w-md"><%= (settings && settings.footer_about) || 'Clinique d\'esthétique médicale dédiée à votre éclat naturel.' %></p>
<div class="flex gap-3 mt-6">
<% if (settings && settings.instagram_url) { %><a href="<%= settings.instagram_url %>" target="_blank" rel="noopener" class="w-10 h-10 rounded-full border border-cream/20 flex items-center justify-center hover:bg-brand hover:border-brand transition" aria-label="Instagram"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".5" fill="currentColor"/></svg></a><% } %>
<% if (settings && settings.facebook_url) { %><a href="<%= settings.facebook_url %>" target="_blank" rel="noopener" class="w-10 h-10 rounded-full border border-cream/20 flex items-center justify-center hover:bg-brand hover:border-brand transition" aria-label="Facebook"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M14 9h3V6h-3c-1.66 0-3 1.34-3 3v2H8v3h3v7h3v-7h3l1-3h-4V9z"/></svg></a><% } %>
<button data-push-btn class="px-4 h-10 rounded-full border border-cream/20 hover:bg-brand hover:border-brand transition text-xs tracking-wide"><%= lang==='en' ? 'Enable notifications' : 'Activer les notifications' %></button>
</div>
</div>
<div>
<h4 class="font-display text-lg mb-4 text-brand-light"><%= t.footer_quick_links %></h4>
<ul class="space-y-2 text-sm text-cream/70">
<li><a href="." class="hover:text-brand-light transition"><%= t.nav_home %></a></li>
<li><a href="services" class="hover:text-brand-light transition"><%= t.nav_services %></a></li>
<li><a href="about" class="hover:text-brand-light transition"><%= t.nav_about %></a></li>
<li><a href="booking" class="hover:text-brand-light transition"><%= t.nav_book %></a></li>
<li><a href="contact" class="hover:text-brand-light transition"><%= t.nav_contact %></a></li>
</ul>
</div>
<div>
<h4 class="font-display text-lg mb-4 text-brand-light"><%= t.footer_contact_info %></h4>
<ul class="space-y-2 text-sm text-cream/70">
<% if (settings && settings.contact_email) { %><li><a href="mailto:<%= settings.contact_email %>" class="hover:text-brand-light transition"><%= settings.contact_email %></a></li><% } %>
<% if (settings && settings.contact_phone) { %><li><a href="tel:<%= settings.contact_phone %>" class="hover:text-brand-light transition"><%= settings.contact_phone %></a></li><% } %>
<% if (settings && settings.business_address) { %><li><%= settings.business_address %></li><% } %>
<% if (settings && settings.business_hours) { %><li class="pt-2 text-cream/60"><%= settings.business_hours %></li><% } %>
</ul>
</div>
</div>
<div class="border-t border-cream/10 py-6 text-center text-xs text-cream/50">© <%= currentYear %> <%= (settings && settings.business_name) || 'Nova Injectables' %> · <%= t.footer_rights %></div>
</footer>
<script>
try { if (window.TenantSDK) { TenantSDK.ui.showInstallBanner(); } } catch(e){}
setTimeout(function(){ try { if (window.TenantSDK) TenantSDK.ui.showPushPrompt(); } catch(e){} }, 9000);
</script>
</body>
</html>