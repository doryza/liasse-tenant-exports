<%- include('partials/header') %>
<section class="py-16 md:py-24 bg-cream">
<div class="max-w-6xl mx-auto px-4 md:px-6">
<div class="text-center mb-14">
<div class="text-xs tracking-[0.4em] uppercase text-brand mb-3"><%= t.blog_subtitle %></div>
<h1 class="font-display text-5xl md:text-6xl text-ink mb-4"><%= t.blog_title %></h1>
</div>
<% if (typeof posts !== 'undefined' && posts.length > 0) { %>
<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
<% posts.forEach(function(p){ %>
<a href="blog/<%= p.id %>" class="group block bg-white rounded-2xl overflow-hidden hover:shadow-xl transition">
<div class="aspect-[4/3] overflow-hidden bg-champagne/30"><img src="<%= p.image_url || 'https://placehold.co/600x450/e8dcc7/6366f1/png' %>" alt="<%= p.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"></div>
<div class="p-6">
<% if (p.category) { %><div class="text-[10px] tracking-[0.3em] uppercase text-brand mb-2"><%= p.category %></div><% } %>
<h2 class="font-display text-2xl text-ink group-hover:text-brand transition mb-3"><%= p.title %></h2>
<p class="text-sm text-ink/60 mb-4"><%= truncate(p.excerpt || p.content || '', 130) %></p>
<div class="text-xs text-ink/40"><%= formatDate(p.created_at) %></div>
</div>
</a>
<% }) %>
</div>
<% } else { %>
<div class="text-center py-20"><p class="text-ink/50"><%= t.empty_posts %></p></div>
<% } %>
</div>
</section>
<%- include('partials/footer') %>