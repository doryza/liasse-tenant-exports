<%- include('partials/header') %>
<section class="py-20 md:py-32 bg-cream min-h-[60vh]">
<div class="max-w-2xl mx-auto px-4 md:px-6 text-center">
<div class="w-20 h-20 mx-auto mb-8 rounded-full bg-ink/5 flex items-center justify-center">
<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
</div>
<h1 class="font-display text-4xl md:text-5xl text-ink mb-6"><%= t.book_cancelled_title %></h1>
<p class="text-ink/70 text-lg mb-10 leading-relaxed"><%= t.book_cancelled_msg %></p>
<div class="flex flex-wrap gap-4 justify-center">
<a href="booking" class="px-8 py-3 rounded-full bg-brand text-white tracking-wide hover:bg-brand-dark transition" style="background-color:#6366f1;color:#fff"><%= t.book_try_again %></a>
<a href="." class="px-8 py-3 rounded-full border border-ink/20 tracking-wide hover:border-brand hover:text-brand transition"><%= t.book_back_home %></a>
</div>
</div>
</section>
<%- include('partials/footer') %>