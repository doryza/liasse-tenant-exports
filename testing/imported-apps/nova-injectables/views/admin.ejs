<!DOCTYPE html>
<html lang="<%= lang %>">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Admin · Nova Injectables</title><link rel="stylesheet" href="public/css/tailwind.css"><link rel="stylesheet" href="public/css/admin-styles.css"></head>
<body class="bg-slate-50 min-h-screen">
<%- include('partials/admin-sidebar') %>
<main class="admin-main">
<header class="flex items-center justify-between mb-8 flex-wrap gap-4">
<div>
<div class="text-[11px] tracking-[0.3em] uppercase text-slate-400 mb-1">Nova Injectables</div>
<h1 class="text-3xl font-semibold text-slate-900">Tableau de bord</h1>
<p class="text-slate-500 mt-1 text-sm">Vue d'ensemble de votre clinique</p>
</div>
<div class="flex gap-2 items-center">
<a href="." target="_blank" class="hidden md:inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-slate-200 text-sm text-slate-700 hover:border-brand hover:text-brand transition"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>Voir le site</a>
<button onclick="document.getElementById('admin-sidebar').classList.toggle('mobile-open')" class="md:hidden p-2 bg-white rounded-lg shadow border border-slate-200" aria-label="Menu">☰</button>
</div>
</header>
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
<div class="stat-card">
<div class="stat-icon" style="background:rgba(99,102,241,0.1);color:#6366f1"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></div>
<div class="stat-label">Visites totales</div>
<div class="stat-value"><%= stats.totalVisits %></div>
<div class="stat-meta text-emerald-600">+<%= stats.recentVisits %> cette semaine</div>
</div>
<div class="stat-card">
<div class="stat-icon" style="background:rgba(16,185,129,0.1);color:#10b981"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></div>
<div class="stat-label">Rendez-vous</div>
<div class="stat-value"><%= stats.appointmentsTotal %></div>
<div class="stat-meta"><span class="text-emerald-600"><%= stats.appointmentsConfirmed %> confirmés</span> · <span class="text-amber-600"><%= stats.appointmentsPending %> en attente</span></div>
</div>
<div class="stat-card">
<div class="stat-icon" style="background:rgba(245,158,11,0.1);color:#f59e0b"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg></div>
<div class="stat-label">Nouveaux messages</div>
<div class="stat-value text-brand"><%= stats.newSubmissions %></div>
<div class="stat-meta"><a href="admin/submissions" class="text-brand hover:underline">Lire →</a></div>
</div>
<div class="stat-card">
<div class="stat-icon" style="background:rgba(139,92,246,0.1);color:#8b5cf6"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg></div>
<div class="stat-label">Abonnés notifications</div>
<div class="stat-value"><%= stats.pushSubscriberCount %></div>
<div class="stat-meta text-slate-400"><%= stats.userCount %> comptes créés</div>
</div>
</div>
<div class="grid lg:grid-cols-2 gap-6 mb-8">
<div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
<div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between"><h2 class="text-base font-semibold text-slate-900">Rendez-vous récents</h2><a href="admin/appointments" class="text-sm text-brand hover:underline">Tout voir →</a></div>
<% if (recentAppts.length === 0) { %><div class="px-6 py-12 text-center"><div class="text-3xl mb-3">📅</div><p class="text-slate-400 text-sm">Aucun rendez-vous pour le moment.</p><p class="text-slate-400 text-xs mt-1">Les nouvelles réservations apparaîtront ici.</p></div><% } else { %>
<div>
<% recentAppts.forEach(function(a){ %>
<div class="px-6 py-3 border-b border-slate-100 last:border-0 flex items-center justify-between gap-4">
<div class="min-w-0"><div class="font-medium text-slate-900 truncate"><%= a.client_name %></div><div class="text-xs text-slate-500 truncate"><%= a.service_name || '—' %> · <%= a.appointment_date %> <%= a.appointment_time || '' %></div></div>
<span class="badge badge-<%= a.status %> flex-shrink-0"><%= a.status %></span>
</div>
<% }) %>
</div>
<% } %>
</div>
<div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
<div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between"><h2 class="text-base font-semibold text-slate-900">Messages récents</h2><a href="admin/submissions" class="text-sm text-brand hover:underline">Tout voir →</a></div>
<% if (recentSubs.length === 0) { %><div class="px-6 py-12 text-center"><div class="text-3xl mb-3">📨</div><p class="text-slate-400 text-sm">Aucun message reçu pour le moment.</p></div><% } else { %>
<div>
<% recentSubs.forEach(function(s){ %>
<div class="px-6 py-3 border-b border-slate-100 last:border-0"><div class="flex items-center justify-between gap-2 mb-1"><div class="font-medium text-slate-900 truncate"><%= s.name %></div><% if (s.status === 'new') { %><span class="badge badge-new flex-shrink-0">Nouveau</span><% } %></div><div class="text-xs text-slate-500 truncate"><%= (s.message || '').slice(0, 100) %><%= (s.message || '').length > 100 ? '…' : '' %></div></div>
<% }) %>
</div>
<% } %>
</div>
</div>
<div class="bg-white rounded-xl shadow-sm border border-slate-100 p-6">
<h2 class="text-base font-semibold text-slate-900 mb-1">Gestion du contenu</h2>
<p class="text-sm text-slate-500 mb-5">Accès rapide aux modules de gestion</p>
<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
<a href="admin/services" class="module-card"><div class="module-icon">✨</div><div class="module-name">Soins</div><div class="module-meta"><%= stats.servicesPublished %> publiés</div></a>
<a href="admin/appointments" class="module-card"><div class="module-icon">📅</div><div class="module-name">Rendez-vous</div><div class="module-meta"><%= stats.appointmentsTotal %> au total</div></a>
<a href="admin/posts" class="module-card"><div class="module-icon">📝</div><div class="module-name">Articles</div><div class="module-meta"><%= stats.postsPublished %> publiés</div></a>
<a href="admin/testimonials" class="module-card"><div class="module-icon">⭐</div><div class="module-name">Témoignages</div><div class="module-meta">Avis clients</div></a>
<a href="admin/gallery" class="module-card"><div class="module-icon">🖼️</div><div class="module-name">Galerie</div><div class="module-meta">Images du site</div></a>
<a href="admin/submissions" class="module-card"><div class="module-icon">📨</div><div class="module-name">Messages</div><div class="module-meta"><%= stats.newSubmissions %> non lus</div></a>
<a href="admin/settings" class="module-card"><div class="module-icon">⚙️</div><div class="module-name">Paramètres</div><div class="module-meta">Configuration</div></a>
<a href="." target="_blank" class="module-card"><div class="module-icon">🌐</div><div class="module-name">Site public</div><div class="module-meta">Voir en direct</div></a>
</div>
</div>
</main>
</body></html>