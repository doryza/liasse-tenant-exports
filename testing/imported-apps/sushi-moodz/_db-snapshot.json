        },
        {
          "key": "tagline_en",
          "value": "Sushi · Nigiri · Maki — a Japanese table",
          "updated_at": "2026-07-10T05:05:07.989Z"
        },
        {
          "key": "hero_title_fr",
          "value": "Sushi Moodz",
          "updated_at": "2026-07-10T05:05:07.994Z"
        },
        {
          "key": "hero_title_en",
          "value": "Sushi Moodz",
          "updated_at": "2026-07-10T05:05:07.999Z"
        },
        {
          "key": "hero_thesis_fr",
          "value": "Le riz est tiède, le poisson est froid. Le sushi comme une calligraphie : précis, épuré, inoubliable.",
          "updated_at": "2026-07-10T05:05:08.005Z"
        },
        {
          "key": "hero_thesis_en",
          "value": "Warm rice, cold fish. Sushi treated like calligraphy — precise, spare, unforgettable.",
          "updated_at": "2026-07-10T05:05:08.013Z"
        },
        {
          "key": "philosophy_fr",
          "value": "Chaque pièce est façonnée à la main, à l’instant. Rien de superflu, rien qui manque.",
          "updated_at": "2026-07-10T05:05:08.018Z"
        },
        {
          "key": "philosophy_en",
          "value": "Every piece is shaped by hand, to order. Nothing extra, nothing missing.",
          "updated_at": "2026-07-10T05:05:08.023Z"
        },
        {
          "key": "order_band_fr",
          "value": "L’envie ne se discute pas.",
          "updated_at": "2026-07-10T05:05:08.027Z"
        }
      ]
    },
