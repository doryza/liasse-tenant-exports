<%- include('partials/header') %>
<main>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <span class="eyebrow" data-setting-key="tagline_<%= lang %>"><%= sv('tagline') %></span>
        <h1 class="hero-title" data-setting-key="hero_title_<%= lang %>"><%= sv('hero_title') || (settings.business_name||'Sushi Moodz') %></h1>
        <p class="hero-thesis" data-setting-key="hero_thesis_<%= lang %>"><%= sv('hero_thesis') %></p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="<%= orderUrl %>" <%= orderExternal?'target="_blank" rel="noopener"':'' %> data-lk="t:cta_order" style="background-color:#FF3E4D;color:#fff"><%= t.cta_order %></a>
          <a class="text-link" href="reserver" data-lk="t:cta_reserve"><%= t.cta_reserve %><span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-note" aria-hidden="true"><span>鮨</span><i></i><small>Montréal · Québec</small></div>
      </div>
      <div class="hero-media">
        <img src="<%= settings._p_hero_image_url ? settings._p_hero_image_url : 'https://placehold.co/900x1100/0C0D12/FF3E4D/png?text=Sushi+Moodz' %>" data-setting-key="_p_hero_image_url" alt="<%= sv('hero_title')||'Sushi Moodz' %>">
        <span class="hero-media-label" aria-hidden="true">一貫ずつ、丁寧に<br><small>Façonné à la main</small></span>
        <span class="hero-stamp" aria-hidden="true">寿<br>司</span>
      </div>
    </div>
  </section>

  <% var tItems = (typeof menuItems!=='undefined') ? menuItems.slice(0,10) : []; %>
  <% if(tItems.length){ %>
  <section class="ticker">
    <div class="ticker-track">
      <% tItems.concat(tItems).forEach(function(m){ %>
      <a class="ticker-item" href="#mi-<%= m.id %>"><%= (lang==='en'&&m.name_en)?m.name_en:m.name_fr %></a><span class="ticker-dot" aria-hidden="true">●</span>
      <% }); %>
    </div>
  </section>
  <% } %>

  <section class="philosophy">
    <div class="container philo-inner">
      <svg class="enso" viewBox="0 0 200 200" aria-hidden="true"><path d="M150 44 A70 70 0 1 0 168 96" fill="none" stroke="currentColor" stroke-width="15" stroke-linecap="round"/></svg>
      <span class="philo-kicker" aria-hidden="true">私たちの哲学 · Notre philosophie</span>
      <p class="philo-text" data-setting-key="philosophy_<%= lang %>"><%= sv('philosophy') %></p>
    </div>
  </section>

  <% var sigs = (typeof featured!=='undefined' && featured.length) ? featured : ((typeof menuItems!=='undefined') ? menuItems.slice(0,3) : []); %>
  <% if(sigs.length){ %>
  <section class="sec signatures-sec" id="signatures">
    <div class="container">
      <div class="section-intro-row">
        <div><span class="section-index">01 · おすすめ</span><div class="sec-head"><h2 class="sec-title" data-lk="t:sig_title"><%= t.sig_title %></h2><span class="sec-en"><%= t.sig_en %></span></div></div>
        <div><p class="sec-intro" data-lk="t:sig_intro"><%= t.sig_intro %></p><a class="text-link" href="carte" data-lk="t:nav_menu"><%= t.nav_menu %><span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="signatures">
        <% sigs.forEach(function(s,i){ %>
        <article class="sig">
          <div class="sig-img"><img src="<%= s.image_url ? s.image_url : 'https://placehold.co/800x600/15161C/F5F3EE/png?text=Plat' %>" data-content-source="menu_items:image_url" data-content-id="<%= s.id %>" alt="<%= (lang==='en'&&s.name_en)?s.name_en:s.name_fr %>" loading="lazy"></div>
          <div class="sig-meta"><span class="sig-num"><%= (i+1) %></span><h3 data-content-source="menu_items:name_fr" data-content-id="<%= s.id %>"><%= (lang==='en'&&s.name_en)?s.name_en:s.name_fr %></h3><% var sd=(lang==='en'&&s.description_en)?s.description_en:(s.description_fr||''); if(sd){ %><p><%= sd %></p><% } %><span class="sig-price"><%= formatPrice(s.price) %></span></div>
        </article>
        <% }); %>
      </div>
    </div>
  </section>
  <% } %>

  <section class="order-band">
    <div class="container order-band-inner">
      <span class="order-kana" aria-hidden="true">今夜は寿司</span>
      <h2 data-setting-key="order_band_<%= lang %>"><%= sv('order_band') || t.order_band_title %></h2>
      <a class="btn btn-white" href="<%= orderUrl %>" <%= orderExternal?'target="_blank" rel="noopener"':'' %> data-lk="t:order_band_cta"><%= t.order_band_cta %></a>
    </div>
  </section>

  <section class="sec" id="galerie">
    <div class="container">
      <span class="section-index">02 · ギャラリー</span>
      <div class="sec-head"><h2 class="sec-title" data-lk="t:gallery_title"><%= t.gallery_title %></h2><span class="sec-en"><%= t.gallery_en %></span></div>
      <% if(typeof galleryItems!=='undefined' && galleryItems.length){ %>
      <div class="gallery-grid">
        <% galleryItems.forEach(function(g){ %>
        <figure class="g-item"><img src="<%= g.image_url ? g.image_url : 'https://placehold.co/600x600/15161C/F5F3EE/png?text=Photo' %>" data-content-source="gallery:image_url" data-content-id="<%= g.id %>" alt="<%= g.title||'' %>" loading="lazy"><% var gc=(lang==='en'&&g.caption_en)?g.caption_en:g.caption_fr; if(gc){ %><figcaption class="g-cap"><%= gc %></figcaption><% } %></figure>
        <% }); %>
      </div>
      <div class="center"><a class="btn btn-outline" href="galerie" data-lk="t:view_gallery"><%= t.view_gallery %></a></div>
      <% } else { %><p class="empty" data-lk="t:empty_gallery"><%= t.empty_gallery %></p><% } %>
    </div>
  </section>

  <section class="sec reserve-sec" id="reserver">
    <div class="container narrow">
      <span class="section-index">03 · ご予約</span>
      <div class="sec-head"><h2 class="sec-title" data-lk="t:reserve_title"><%= t.reserve_title %></h2><span class="sec-en"><%= t.reserve_en %></span></div>
      <p class="sec-intro" data-lk="t:reserve_intro"><%= t.reserve_intro %></p>
      <%- include('partials/reserve-form') %>
    </div>
  </section>

  <section class="sec" id="contact">
    <div class="container">
      <span class="section-index">04 · アクセス</span>
      <div class="sec-head"><h2 class="sec-title" data-lk="t:contact_title"><%= t.contact_title %></h2><span class="sec-en"><%= t.contact_en %></span></div>
      <div class="contact-split">
        <div><%- include('partials/contact-form') %></div>
        <div class="contact-info">
          <%- include('partials/map') %>
          <div class="info-block">
            <h4 data-lk="t:find_us"><%= t.find_us %></h4>
            <p><strong data-lk="t:address_label"><%= t.address_label %> :</strong> <span data-setting-key="business_address"><%= settings.business_address || t.address_tba %></span></p>
            <p><strong data-lk="t:hours_label"><%= t.hours_label %> :</strong> <span data-setting-key="hours_<%= lang %>" style="white-space:pre-line"><%= sv('hours') || t.hours_tba %></span></p>
            <% if(settings.contact_phone){ %><p><strong data-lk="t:phone_label"><%= t.phone_label %> :</strong> <a href="tel:<%= settings.contact_phone %>" data-setting-key="contact_phone"><%= settings.contact_phone %></a></p><% } %>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
