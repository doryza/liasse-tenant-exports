<%- include('partials/header') %>
<main>
  <section class="page-hero"><div class="container"><span class="eyebrow" data-lk="t:contact_en"><%= t.contact_en %></span><h1 class="page-title" data-lk="t:contact_title"><%= t.contact_title %></h1><p data-lk="t:contact_intro"><%= t.contact_intro %></p></div></section>
  <section class="sec"><div class="container"><div class="contact-split">
    <div><%- include('partials/contact-form') %></div>
    <div class="contact-info">
      <%- include('partials/map') %>
      <div class="info-block">
        <h4 data-lk="t:find_us"><%= t.find_us %></h4>
        <p><strong data-lk="t:address_label"><%= t.address_label %> :</strong> <span data-setting-key="business_address"><%= settings.business_address || t.address_tba %></span></p>
        <p><strong data-lk="t:hours_label"><%= t.hours_label %> :</strong> <span data-setting-key="hours_<%= lang %>" style="white-space:pre-line"><%= sv('hours') || t.hours_tba %></span></p>
        <% if(settings.contact_phone){ %><p><strong data-lk="t:phone_label"><%= t.phone_label %> :</strong> <a href="tel:<%= settings.contact_phone %>" data-setting-key="contact_phone"><%= settings.contact_phone %></a></p><% } %>
        <% if(settings.contact_email){ %><p><strong data-lk="t:email_label"><%= t.email_label %> :</strong> <a href="mailto:<%= settings.contact_email %>" data-setting-key="contact_email"><%= settings.contact_email %></a></p><% } %>
      </div>
    </div>
  </div></div></section>
</main>
<%- include('partials/footer') %>
