<%- include('partials/header') %>
<main>
<section class='page-head'>
  <div class='container'>
    <span class='kicker'>Code d’inspection</span>
    <h1 class='page-title'>Nos services</h1>
    <p class='page-lead'>Mécanique à domicile, entretien, réparation et esthétique automobile. Réservez la prestation qui vous convient.</p>
  </div>
</section>
<% var cats=[['entretien','Entretien'],['reparation','Réparation'],['esthetique','Esthétique & lavage']]; var known=['entretien','reparation','esthetique']; %>
<% if(typeof services!=='undefined' && services.length){ %>
<div class='container'>
  <% cats.forEach(function(c){ var group=services.filter(function(s){ return (s.category||'entretien')===c[0]; }); if(!group.length) return; %>
  <section class='svc-section'>
    <h2 class='svc-head'><span class='dot dot-<%= c[0] %>'></span><%= c[1] %></h2>
    <div class='svc-grid'>
      <% group.forEach(function(s,i){ %>
      <article class='svc-card'>
        <% if(s.image_url){ %><img class='svc-img' src='<%= s.image_url %>' alt='<%= s.name %>'><% } %>
        <div class='svc-card-body'>
          <span class='insp-num mono'><%= i+1 %></span>
          <h3 class='insp-name'><%= s.name %></h3>
          <p class='insp-desc'><%= s.description %></p>
          <div class='svc-foot'>
            <div class='svc-meta'>
              <% if(s.price){ %><span class='insp-price'><%= s.price %></span><% } %>
              <% if(s.duration){ %><span class='insp-dur mono'><%= s.duration %></span><% } %>
            </div>
            <a class='btn btn-primary btn-sm' href='reservation?service=<%= encodeURIComponent(s.name) %>' style='background-color:#6366f1;color:#fff'>Réserver</a>
          </div>
        </div>
      </article>
      <% }); %>
    </div>
  </section>
  <% }); %>
  <% var others=services.filter(function(s){ return known.indexOf(s.category||'entretien')<0; }); if(others.length){ %>
  <section class='svc-section'>
    <h2 class='svc-head'><span class='dot dot-default'></span>Autres services</h2>
    <div class='svc-grid'>
      <% others.forEach(function(s,i){ %>
      <article class='svc-card'>
        <% if(s.image_url){ %><img class='svc-img' src='<%= s.image_url %>' alt='<%= s.name %>'><% } %>
        <div class='svc-card-body'>
          <h3 class='insp-name'><%= s.name %></h3>
          <p class='insp-desc'><%= s.description %></p>
          <div class='svc-foot'>
            <div class='svc-meta'><% if(s.price){ %><span class='insp-price'><%= s.price %></span><% } %><% if(s.duration){ %><span class='insp-dur mono'><%= s.duration %></span><% } %></div>
            <a class='btn btn-primary btn-sm' href='reservation?service=<%= encodeURIComponent(s.name) %>' style='background-color:#6366f1;color:#fff'>Réserver</a>
          </div>
        </div>
      </article>
      <% }); %>
    </div>
  </section>
  <% } %>
</div>
<% } else { %>
<div class='container'><p class='empty'>Aucun service disponible pour le moment. Revenez bientôt.</p></div>
<% } %>
<section class='cta'>
  <div class='container cta-inner'>
    <h2 class='cta-title'>Une question sur un service ?</h2>
    <p class='cta-text'>Contactez-nous, on vous répond rapidement.</p>
    <a class='btn btn-primary' href='contact' style='background-color:#6366f1;color:#fff'>Nous contacter</a>
  </div>
</section>
</main>
<%- include('partials/footer') %>
