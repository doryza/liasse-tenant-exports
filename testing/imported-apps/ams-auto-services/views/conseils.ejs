<%- include('partials/header') %>
<main>
<section class='page-head'>
  <div class='container'>
    <span class='kicker'>Le carnet d’entretien</span>
    <h1 class='page-title'>Conseils d’entretien</h1>
    <p class='page-lead'>Astuces et explications claires pour garder votre véhicule fiable plus longtemps.</p>
  </div>
</section>
<div class='container'>
  <% if(typeof posts!=='undefined' && posts.length){ %>
  <div class='card-grid'>
    <% posts.forEach(function(p){ %>
    <a class='card' href='conseils/<%= p.id %>'>
      <% if(p.image_url){ %><img class='card-img' src='<%= p.image_url %>' alt='<%= p.title %>'><% } %>
      <div class='card-body'>
        <% if(p.category){ %><span class='card-cat mono'><%= p.category %></span><% } %>
        <h3 class='card-t'><%= p.title %></h3>
        <p class='card-ex'><%= excerpt(p.content,110) %></p>
        <span class='card-date mono'><%= formatDate(p.created_at) %></span>
      </div>
    </a>
    <% }); %>
  </div>
  <% } else { %>
  <p class='empty'>Aucun conseil publié pour le moment. Revenez bientôt !</p>
  <% } %>
</div>
</main>
<%- include('partials/footer') %>
