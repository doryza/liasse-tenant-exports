<%- include('partials/header') %>
<% var ORDER_URL = 'https://tandoori-route-blain.tapavis.com/order'; %>

<section class="hero hero-squeeze">
  <img src="<%= (typeof settings!=='undefined' && settings._p_hero_image_url) ? settings._p_hero_image_url : 'https://placehold.co/1600x900/0a0806/F5A524/png?text=Tandoori+Route' %>" alt="<%= t.brand %>" class="hero-img">
  <div class="hero-overlay"></div>
  <div class="container hero-inner">
    <span class="hero-eyebrow"><%= lang === 'en' ? 'Authentic Indian cuisine · Blainville' : 'Cuisine indienne authentique · Blainville' %></span>
    <h1><%= t.hero_title %></h1>
    <p><%= t.hero_subtitle %></p>
    <div class="hero-ctas">
      <a href="<%= ORDER_URL %>" class="btn btn-primary btn-order"><%= lang === 'en' ? 'Order now' : 'Commander maintenant' %> →</a>
      <a href="#menu" class="btn btn-secondary"><%= lang === 'en' ? 'See the menu' : 'Voir le menu' %></a>
    </div>
  </div>
</section>

<section class="section squeeze-section" id="menu">
  <div class="container">
    <h2 class="section-title"><%= t.menu_title %></h2>
    <p class="section-sub"><%= t.menu_subtitle %></p>
  </div>
  <% if (typeof menu !== 'undefined' && menu && menu.length > 0) { %>
  <div class="menu-slider" id="menuSlider">
    <button class="slider-arrow slider-prev" id="sliderPrev" aria-label="<%= lang === 'en' ? 'Previous' : 'Précédent' %>">‹</button>
    <div class="slider-track" id="sliderTrack">
      <% menu.forEach(function(m) {
        var catName = '';
        if (typeof categories !== 'undefined' && categories) {
          var _c = categories.find(function(x){ return x.slug === m.category; });
          if (_c) catName = (lang === 'en' && _c.name_en) ? _c.name_en : _c.name_fr;
        }
        var _sizes = (typeof parseSizes === 'function') ? parseSizes(m.sizes_json) : null;
      %>
      <article class="slide-card">
        <div class="slide-card-imgwrap">
          <% if (m.image_url) { %><img src="<%= m.image_url %>" alt="<%= pickLang(m,'name',lang) %>" loading="lazy"><% } else { %><div class="slide-card-placeholder">🔥</div><% } %>
          <% if (m.featured) { %><span class="slide-badge">★ <%= lang === 'en' ? 'Favorite' : 'Coup de cœur' %></span><% } %>
          <% if (catName) { %><span class="slide-cat"><%= catName %></span><% } %>
        </div>
        <div class="slide-card-body">
          <div class="slide-card-top">
            <h3><%= pickLang(m, 'name', lang) %></h3>
            <% if (_sizes && _sizes.length > 1) { %>
              <span class="price"><%= lang === 'en' ? 'from' : 'dès' %> <%= formatPrice(Math.min.apply(null, _sizes.map(function(s){ return s.price == null ? Infinity : s.price; }))) %></span>
            <% } else if (_sizes && _sizes.length === 1) { %>
              <span class="price"><%= formatPrice(_sizes[0].price) %></span>
            <% } else { %>
              <span class="price"><%= formatPrice(m.price) %></span>
            <% } %>
          </div>
          <p class="desc"><%= pickLang(m, 'description', lang) %></p>
          <a href="<%= ORDER_URL %>" class="btn btn-primary btn-slide-order"><%= lang === 'en' ? 'Order' : 'Commander' %> →</a>
        </div>
      </article>
      <% }); %>
    </div>
    <button class="slider-arrow slider-next" id="sliderNext" aria-label="<%= lang === 'en' ? 'Next' : 'Suivant' %>">›</button>
    <div class="slider-dots" id="sliderDots"></div>
  </div>
  <% } else { %>
  <div class="container"><p class="empty-state"><%= t.no_menu %></p></div>
  <% } %>
</section>

<section class="section squeeze-section alt-section">
  <div class="container order-band">
    <div class="order-band-text">
      <h2><%= lang === 'en' ? 'Hungry? It only takes a minute.' : 'Une faim de tandoor? Ça prend une minute.' %></h2>
      <p><%= lang === 'en' ? 'Order for pickup directly from the restaurant — fresh from the tandoor.' : 'Commandez pour emporter directement du restaurant — tout droit sorti du tandoor.' %></p>
    </div>
    <a href="<%= ORDER_URL %>" class="btn btn-primary btn-order"><%= lang === 'en' ? 'Order now' : 'Commander maintenant' %> →</a>
    <% if (typeof platforms !== 'undefined' && platforms && platforms.length > 0) { %>
    <div class="order-band-platforms">
      <span><%= lang === 'en' ? 'Also on' : 'Aussi sur' %></span>
      <% platforms.forEach(function(p) { %>
        <a href="<%= p.link_url %>" target="_blank" rel="noopener" title="<%= p.name %>"><% if (p.logo_url) { %><img src="<%= p.logo_url %>" alt="<%= p.name %>"><% } else { %><%= p.name %><% } %></a>
      <% }); %>
    </div>
    <% } %>
  </div>
</section>

<a href="<%= ORDER_URL %>" class="sticky-order-cta"><%= lang === 'en' ? 'Order now' : 'Commander' %> →</a>

<script>
(function(){
  var track = document.getElementById('sliderTrack');
  if (!track) return;
  var prev = document.getElementById('sliderPrev');
  var next = document.getElementById('sliderNext');
  var dotsWrap = document.getElementById('sliderDots');
  var cards = track.querySelectorAll('.slide-card');

  cards.forEach(function(_, i){
    var d = document.createElement('button');
    d.className = 'slider-dot';
    d.setAttribute('aria-label', 'Slide ' + (i + 1));
    d.addEventListener('click', function(){ goTo(i); pause(); });
    dotsWrap.appendChild(d);
  });
  var dots = dotsWrap.querySelectorAll('.slider-dot');

  function cardStep(){
    if (cards.length < 2) return cards[0] ? cards[0].offsetWidth : 0;
    return cards[1].offsetLeft - cards[0].offsetLeft;
  }
  function currentIndex(){
    var step = cardStep();
    return step ? Math.round(track.scrollLeft / step) : 0;
  }
  function goTo(i){
    var max = cards.length - 1;
    if (i < 0) i = max; else if (i > max) i = 0;
    track.scrollTo({ left: i * cardStep(), behavior: 'smooth' });
  }
  function syncDots(){
    var idx = Math.min(currentIndex(), dots.length - 1);
    dots.forEach(function(d, i){ d.classList.toggle('active', i === idx); });
  }
  syncDots();
  var scrollT;
  track.addEventListener('scroll', function(){ clearTimeout(scrollT); scrollT = setTimeout(syncDots, 80); }, { passive: true });

  prev.addEventListener('click', function(){ goTo(currentIndex() - 1); pause(); });
  next.addEventListener('click', function(){ goTo(currentIndex() + 1); pause(); });

  var timer = setInterval(function(){ goTo(currentIndex() + 1); }, 4500);
  function pause(){ if (timer) { clearInterval(timer); timer = null; } }
  track.addEventListener('pointerdown', pause, { passive: true });
  track.addEventListener('wheel', pause, { passive: true });
})();
</script>

<%- include('partials/footer') %>
