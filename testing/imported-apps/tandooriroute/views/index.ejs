<%- include('partials/header') %>
<% var ORDER_URL = 'https://tandoori-route-blain.tapavis.com/order'; %>
<% var CAT_EMOJI = { 'Poulet': '🍗', 'Agneau': '🍖', 'Végétarien': '🥬', 'À la carte': '🥟', 'Poutine': '🍟', 'Dessert': '🍮', 'Chai / Boissons': '☕', 'Midi Special Thali': '🍱', 'Wraps': '🌯' }; %>

<section class="hero hero-squeeze">
  <img src="<%= (typeof settings!=='undefined' && settings._p_hero_image_url) ? settings._p_hero_image_url : 'https://placehold.co/1600x900/0a0806/F5A524/png?text=Tandoori+Route' %>" alt="<%= t.brand %>" class="hero-img">
  <div class="hero-overlay"></div>
  <div class="hero-banner">
    <div class="hero-banner-inner">
      <img src="<%= (typeof settings!=='undefined' && settings._p_nav_logo_url) ? settings._p_nav_logo_url : (typeof appIconUrl !== 'undefined' ? appIconUrl : '') %>" alt="<%= t.brand %>" class="hero-banner-logo" onerror="this.style.display='none'">
      <span class="hero-banner-divider"></span>
      <span class="hero-banner-name"><%= settings.business_name || t.brand %></span>
    </div>
  </div>
  <h1 class="hero-slogan"><%= lang === 'en' ? 'The route to flavor' : 'La route vers la saveur' %></h1>
</section>

<section class="section squeeze-section" id="menu">
  <div class="container">
    <h2 class="section-title"><%= t.menu_title %></h2>
    <p class="section-sub"><%= t.menu_subtitle %></p>
  </div>
  <% if (typeof preview !== 'undefined' && preview && preview.items && preview.items.length > 0) { %>
  <div class="container">
    <div class="menu-chips" id="menuChips">
      <button class="chip active" data-cat="*"><%= lang === 'en' ? 'All' : 'Tout' %></button>
      <% preview.categories.forEach(function(cat) { %>
      <button class="chip" data-cat="<%= cat %>"><%= (CAT_EMOJI[cat] ? CAT_EMOJI[cat] + ' ' : '') %><%= (lang === 'en' && typeof previewCatEn !== 'undefined' && previewCatEn[cat]) ? previewCatEn[cat] : cat %></button>
      <% }); %>
    </div>
  </div>
  <div class="menu-slider" id="menuSlider">
    <button class="slider-arrow slider-prev" id="sliderPrev" aria-label="<%= lang === 'en' ? 'Previous' : 'Précédent' %>">‹</button>
    <div class="slider-track" id="sliderTrack">
      <% preview.items.forEach(function(m) { %>
      <article class="slide-card" data-cat="<%= m.category %>">
        <div class="slide-card-imgwrap">
          <% if (m.imageUrl) { %><img src="<%= m.imageUrl %>" alt="<%= m.name %>" loading="lazy"><% } else { %><div class="slide-card-placeholder"><%= CAT_EMOJI[m.category] || '🔥' %></div><% } %>
          <span class="slide-cat"><%= (lang === 'en' && typeof previewCatEn !== 'undefined' && previewCatEn[m.category]) ? previewCatEn[m.category] : m.category %></span>
        </div>
        <div class="slide-card-body">
          <div class="slide-card-top">
            <h3><%= m.name %></h3>
            <span class="price"><%= formatPrice(m.price) %></span>
          </div>
          <% if (m.note) { %><span class="slide-note">🕐 <%= lang === 'en' ? 'Lunch only · 11:30–15:00' : 'Midi seulement · 11h30–15h00' %></span><% } %>
          <% if (m.description) { %><p class="desc"><%= m.description %></p><% } %>
        </div>
      </article>
      <% }); %>
    </div>
    <button class="slider-arrow slider-next" id="sliderNext" aria-label="<%= lang === 'en' ? 'Next' : 'Suivant' %>">›</button>
    <div class="slider-progress"><span id="sliderBar"></span></div>
  </div>
  <% } else { %>
  <div class="container"><p class="empty-state"><%= t.no_menu %></p></div>
  <% } %>
</section>

<section class="section squeeze-section alt-section">
  <div class="container order-band">
    <div class="order-band-text">
      <h2><%= lang === 'en' ? 'Craving warm naan? It only takes a minute.' : 'Une envie de naan chaud? Ça prend une minute.' %></h2>
      <p><%= lang === 'en' ? 'Order for pickup directly from the restaurant — hand-made naan, baked fresh in-house.' : 'Commandez pour emporter directement du restaurant — naan fait à la main, cuit sur place.' %></p>
    </div>
    <a href="<%= ORDER_URL %>" target="_blank" rel="noopener" class="btn btn-primary btn-order"><%= lang === 'en' ? 'Order now' : 'Commander maintenant' %> →</a>
    <% if (typeof platforms !== 'undefined' && platforms && platforms.length > 0) { %>
    <div class="order-band-platforms">
      <span><%= lang === 'en' ? 'Also on' : 'Aussi sur' %></span>
      <% platforms.forEach(function(p) { %>
        <a href="<%= p.link_url %>" target="_blank" rel="noopener" title="<%= p.name %>"><% if (p.logo_url) { %><img src="<%= p.logo_url %>" alt="<%= p.name %>"><% } else { %><%= p.name %><% } %></a>
      <% }); %>
    </div>
    <% } %>
  </div>
</section>

<a href="<%= ORDER_URL %>" target="_blank" rel="noopener" class="sticky-order-cta"><%= lang === 'en' ? 'Order now' : 'Commander' %> →</a>

<script>
(function(){
  var track = document.getElementById('sliderTrack');
  if (!track) return;
  var prev = document.getElementById('sliderPrev');
  var next = document.getElementById('sliderNext');
  var bar = document.getElementById('sliderBar');
  var chipsWrap = document.getElementById('menuChips');
  var allCards = Array.prototype.slice.call(track.querySelectorAll('.slide-card'));

  function visibleCards(){
    return allCards.filter(function(c){ return !c.classList.contains('chip-hidden'); });
  }
  function cardStep(){
    var v = visibleCards();
    if (v.length < 2) return v[0] ? v[0].offsetWidth : 0;
    return v[1].offsetLeft - v[0].offsetLeft;
  }
  function currentIndex(){
    var step = cardStep();
    return step ? Math.round(track.scrollLeft / step) : 0;
  }
  function goTo(i){
    var max = visibleCards().length - 1;
    if (max < 0) return;
    if (i < 0) i = max; else if (i > max) i = 0;
    track.scrollTo({ left: i * cardStep(), behavior: 'smooth' });
  }
  function syncBar(){
    var maxScroll = track.scrollWidth - track.clientWidth;
    bar.style.width = (maxScroll > 0 ? Math.min(100, Math.max(0, (track.scrollLeft / maxScroll) * 100)) : 100) + '%';
  }
  syncBar();
  track.addEventListener('scroll', syncBar, { passive: true });
  window.addEventListener('resize', syncBar);

  prev.addEventListener('click', function(){ goTo(currentIndex() - 1); pause(); });
  next.addEventListener('click', function(){ goTo(currentIndex() + 1); pause(); });

  chipsWrap.addEventListener('click', function(ev){
    var chip = ev.target.closest('.chip');
    if (!chip) return;
    var cat = chip.getAttribute('data-cat');
    chipsWrap.querySelectorAll('.chip').forEach(function(c){ c.classList.toggle('active', c === chip); });
    allCards.forEach(function(card){
      card.classList.toggle('chip-hidden', cat !== '*' && card.getAttribute('data-cat') !== cat);
    });
    track.scrollTo({ left: 0, behavior: 'auto' });
    syncBar();
  });

  var timer = setInterval(function(){ goTo(currentIndex() + 1); }, 4500);
  function pause(){ if (timer) { clearInterval(timer); timer = null; } }
  track.addEventListener('pointerdown', pause, { passive: true });
  track.addEventListener('wheel', pause, { passive: true });
})();
</script>

<%- include('partials/footer') %>
