<%# Hand-drawn halal certification seal — pure inline SVG (no fonts for the
    Arabic: the حلال calligraphy is authored as bezier paths). Included once,
    in the hero on index.ejs. Ring text inherits Playfair Display italic from
    the page. IDs are prefixed hseal- to stay unique. %>
<div class="halal-seal" role="img" aria-label="<%= lang === 'en' ? 'Certified 100% halal' : 'Certifié 100 % halal' %>" title="<%= lang === 'en' ? 'Certified 100% halal' : 'Certifié 100 % halal' %>">
<svg viewBox="0 0 220 220" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="hseal-gold" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#FFE3A6"/>
      <stop offset="0.45" stop-color="#F5A524"/>
      <stop offset="1" stop-color="#C77E0B"/>
    </linearGradient>
    <radialGradient id="hseal-glow" cx="0.5" cy="0.42" r="0.6">
      <stop offset="0" stop-color="#F5A524" stop-opacity="0.16"/>
      <stop offset="1" stop-color="#F5A524" stop-opacity="0"/>
    </radialGradient>
    <path id="hseal-arcTop" d="M 26 110 A 84 84 0 0 1 194 110" fill="none"/>
    <path id="hseal-arcBot" d="M 17 110 A 93 93 0 0 0 203 110" fill="none"/>
  </defs>

  <!-- translucent smoked-glass disc -->
  <circle cx="110" cy="110" r="106" fill="rgba(10,8,6,0.66)"/>
  <circle cx="110" cy="110" r="106" fill="url(#hseal-glow)"/>

  <!-- rings -->
  <circle cx="110" cy="110" r="106" fill="none" stroke="url(#hseal-gold)" stroke-width="2.5"/>
  <circle cx="110" cy="110" r="98" fill="none" stroke="#F5A524" stroke-opacity="0.5" stroke-width="1"/>
  <circle class="hseal-ticks" cx="110" cy="110" r="102" fill="none" stroke="url(#hseal-gold)"
          stroke-width="2.6" stroke-linecap="round" stroke-dasharray="0.5 7.5"/>
  <circle cx="110" cy="110" r="72" fill="none" stroke="#F5A524" stroke-opacity="0.55" stroke-width="1.2"/>

  <!-- ring text (inherits page Playfair Display italic) -->
  <text font-family="'Playfair Display', Georgia, serif" font-style="italic" font-weight="600"
        font-size="17" letter-spacing="4.5" fill="#FFD27A">
    <textPath href="#hseal-arcTop" startOffset="50%" text-anchor="middle">HALAL</textPath>
  </text>
  <text font-family="'Playfair Display', Georgia, serif" font-style="italic" font-weight="600"
        font-size="13.5" letter-spacing="3" fill="#FFD27A" fill-opacity="0.9">
    <textPath href="#hseal-arcBot" startOffset="50%" text-anchor="middle"><%= lang === 'en' ? '100% CERTIFIED' : '100% CERTIFIÉ' %></textPath>
  </text>
  <!-- side diamonds -->
  <path d="M 22 110 l 4.2 -4.2 4.2 4.2 -4.2 4.2 z" fill="url(#hseal-gold)"/>
  <path d="M 189.6 110 l 4.2 -4.2 4.2 4.2 -4.2 4.2 z" fill="url(#hseal-gold)"/>

  <!-- crescent + star -->
  <path fill-rule="evenodd" fill="url(#hseal-gold)"
        d="M 110 40 a 12 12 0 1 0 0.01 0 z M 113 40 a 9 9 0 1 0 0.01 0 z"/>
  <path d="M 126 42 l 1.6 4.4 4.4 1.6 -4.4 1.6 -1.6 4.4 -1.6 -4.4 -4.4 -1.6 4.4 -1.6 z" fill="#FFD27A"/>

  <!-- حلال — hand-drawn monoline calligraphy (ḥāʾ · lām-alif · final lām) -->
  <g transform="translate(48.5, 76) scale(0.88)" fill="none" stroke="url(#hseal-gold)"
     stroke-width="6" stroke-linecap="round" stroke-linejoin="round">
    <!-- ḥāʾ (initial): flat head-bar, small turn, sweep to baseline -->
    <path d="M 129 24 C 121 29 111 31 103 31"/>
    <path d="M 103 31 C 110 32 114 35 115 40 C 115 48 104 55 89 57"/>
    <!-- lām-alif ligature: right arm -->
    <path d="M 82 11 C 81 25 76 40 65 50 C 61 53 55 55 48 55"/>
    <!-- lām-alif: left arm + baseline connector to ḥāʾ -->
    <path d="M 52 13 C 55 27 61 40 71 49 C 77 54 84 57 92 57"/>
    <!-- final lām: ascender + bowl -->
    <path d="M 33 8 C 33 20 33 32 33 42 C 33 52 30 60 22 62 C 14 64 8 57 9 49 C 10 45 12 42 16 41"/>
    <!-- ornament -->
    <path d="M 66 26 l 3.2 -3.2 3.2 3.2 -3.2 3.2 z" fill="url(#hseal-gold)" stroke="none"/>
  </g>

  <!-- under-swash -->
  <path d="M 72 150 C 92 157 128 157 148 150" fill="none" stroke="url(#hseal-gold)"
        stroke-width="2" stroke-linecap="round"/>
  <path d="M 107 156 l 3 -3 3 3 -3 3 z" fill="url(#hseal-gold)"/>
</svg>
</div>
