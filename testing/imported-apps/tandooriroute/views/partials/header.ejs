<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#F5A524">
<title><%= settings.business_name || t.brand %></title>
<meta name="description" content="<%= settings.tagline || t.hero_subtitle %>">
<link rel="manifest" href="manifest.json">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,500;1,600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="public/css/styles.css">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="<%= t.brand %>">
</head>
<body class="squeeze">
<header class="site-header">
  <div class="container nav-row">
    <a href="." class="brand">
      <img src="<%= (typeof settings!=='undefined' && settings._p_nav_logo_url) ? settings._p_nav_logo_url : (typeof appIconUrl !== 'undefined' ? appIconUrl : '') %>" alt="<%= t.brand %>" class="brand-logo" onerror="this.style.display='none'">
      <span class="brand-name"><%= t.brand %></span>
    </a>
    <nav class="desktop-nav header-actions">
      <span class="lang-toggle">
        <a href="?lang=fr" class="<%= lang==='fr'?'active':'' %>">FR</a><span>|</span><a href="?lang=en" class="<%= lang==='en'?'active':'' %>">EN</a>
      </span>
      <a href="https://tandoori-route-blain.tapavis.com/order" class="nav-cta"><%= lang === 'en' ? 'Order now' : 'Commander' %></a>
    </nav>
  </div>
</header>
