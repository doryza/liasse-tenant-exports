<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <h4 data-lk="t:brand"><%= t.brand %></h4>
        <% var footerIntro = settings['footer_intro_' + lang] || settings.footer_intro_fr || settings.tagline || t.hero_subtitle; %>
        <p data-setting-key="footer_intro_<%= lang %>"><%= footerIntro %></p>
        <p style="margin-top:0.85rem"><%- include('halal-pill') %></p>
        <% var socials = [
          { key: 'social_facebook',  label: 'Facebook',  icon: 'M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.879V14.89H7.898V12H10.438V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195V8.562h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89H13.563v6.989C18.343 21.128 22 16.991 22 12z' },
          { key: 'social_instagram', label: 'Instagram', icon: 'M12 2.163c3.204 0 3.584.012 4.85.07 1.366.062 2.633.334 3.608 1.308.975.975 1.247 2.242 1.308 3.608.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.062 1.366-.334 2.633-1.308 3.608-.975.975-2.242 1.247-3.608 1.308-1.265.058-1.645.07-4.849.07-3.204 0-3.584-.012-4.849-.07-1.366-.062-2.633-.334-3.608-1.308-.975-.975-1.247-2.242-1.308-3.608C2.175 15.747 2.163 15.367 2.163 12s.012-3.584.07-4.849c.062-1.366.334-2.633 1.308-3.608.975-.975 2.242-1.247 3.608-1.308C8.416 2.175 8.796 2.163 12 2.163zm0 1.802c-3.141 0-3.515.013-4.756.07-1.07.05-1.65.226-2.04.376-.513.2-.88.437-1.265.823-.385.385-.622.752-.823 1.265-.15.39-.326.97-.376 2.04-.057 1.241-.07 1.615-.07 4.756 0 3.141.013 3.515.07 4.756.05 1.07.226 1.65.376 2.04.2.513.438.88.823 1.265.385.385.752.622 1.265.823.39.15.97.326 2.04.376 1.241.057 1.615.07 4.756.07 3.141 0 3.515-.013 4.756-.07 1.07-.05 1.65-.226 2.04-.376.513-.2.88-.437 1.265-.823.385-.385.622-.752.823-1.265.15-.39.326-.97.376-2.04.057-1.241.07-1.615.07-4.756 0-3.141-.013-3.515-.07-4.756-.05-1.07-.226-1.65-.376-2.04-.2-.513-.437-.88-.823-1.265-.385-.385-.752-.622-1.265-.823-.39-.15-.97-.326-2.04-.376-1.241-.057-1.615-.07-4.756-.07zm0 3.064a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 8.467a3.333 3.333 0 100-6.666 3.333 3.333 0 000 6.666zm6.538-8.671a1.2 1.2 0 11-2.4 0 1.2 1.2 0 012.4 0z' },
          { key: 'social_twitter',   label: 'X',         icon: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zM17.083 19.77h1.833L7.084 4.126H5.117z' },
          { key: 'social_tiktok',    label: 'TikTok',    icon: 'M19.589 6.686a4.793 4.793 0 0 1-3.77-4.245V2h-3.445v13.672a2.896 2.896 0 0 1-5.201 1.743l-.002-.001.002.001a2.895 2.895 0 0 1 3.183-4.51v-3.5a6.329 6.329 0 0 0-5.394 10.692 6.33 6.33 0 0 0 10.857-4.424V8.687a8.182 8.182 0 0 0 4.773 1.526V6.79a4.831 4.831 0 0 1-1.003-.104z' },
          { key: 'social_youtube',   label: 'YouTube',   icon: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.546 15.568V8.432L15.818 12l-6.272 3.568z' },
          { key: 'social_linkedin',  label: 'LinkedIn',  icon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z' }
        ]; var hasSocial = socials.some(function(s){ return settings[s.key]; }); %>
        <% if (hasSocial) { %>
        <div class="social-row" style="display:flex;gap:0.6rem;margin-top:0.85rem;flex-wrap:wrap">
          <% socials.forEach(function(s){ if (settings[s.key]) { %>
            <a href="<%= settings[s.key] %>" target="_blank" rel="noopener" aria-label="<%= s.label %>" title="<%= s.label %>" style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;background:rgba(245,165,36,0.08);color:#F5A524;border:1px solid rgba(245,165,36,0.25);transition:all 0.15s" onmouseover="this.style.background='#F5A524';this.style.color='#000'" onmouseout="this.style.background='rgba(245,165,36,0.08)';this.style.color='#F5A524'">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="<%= s.icon %>"/></svg>
            </a>
          <% } }); %>
        </div>
        <% } %>
      </div>
      <div>
        <h4 data-lk="t:contact_us"><%= t.contact_us %></h4>
        <% if (settings.business_address) { %><p data-setting-key="business_address"><%= settings.business_address %></p><% } %>
        <% if (settings.contact_phone) { %><p><%= t.phone %> : <a href="tel:<%= settings.contact_phone %>" style="color:#ccc" data-setting-key="contact_phone"><%= settings.contact_phone %></a></p><% } %>
        <% var publicEmail = settings.contact_email || ''; %>
        <% if (publicEmail) { %><p><%= t.email %> : <a href="mailto:<%= publicEmail %>" style="color:#ccc" data-setting-key="contact_email"><%= publicEmail %></a></p><% } %>
      </div>
      <div>
        <h4 data-lk="t:open_hours"><%= t.open_hours %></h4>
        <% if (typeof hours !== 'undefined' && hours && hours.length) { %>
          <table class="hours-grid" style="color:#bbb;font-size:0.88rem;width:100%;border-collapse:collapse">
            <% hours.forEach(function(row){ %>
              <tr><td style="padding:0.2rem 0.5rem 0.2rem 0;color:#ccc;white-space:nowrap"><%= t['day_' + row.day] || row.day %></td><td style="padding:0.2rem 0;text-align:right"><% if (row.closed) { %><span style="color:#777"><%= t.closed %></span><% } else if (row.open && row.close) { %><span><%= row.open %> – <%= row.close %></span><% } else { %><span style="color:#777">—</span><% } %></td></tr>
            <% }); %>
          </table>
        <% } else if (settings.hours) { %>
          <pre class="hours-pre" data-setting-key="hours"><%= settings.hours %></pre>
        <% } else { %>
          <p style="color:#777;font-size:0.88rem">—</p>
        <% } %>
      </div>
      <div>
        <h4 data-lk="t:enable_notif"><%= t.enable_notif %></h4>
        <button class="btn btn-secondary" data-push-btn style="border-color:#F5A524;color:#F5A524"><%= t.enable_notif %></button>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© <%= new Date().getFullYear() %> <%= settings.business_name || t.brand %> — <%= t.footer_rights %></p>
    </div>
  </div>
</footer>
<script>
try { if (window.TenantSDK) { TenantSDK.ui.showInstallBanner(); setTimeout(function(){ try { TenantSDK.ui.showPushPrompt(); } catch(e){} }, 8000); } } catch(e) {}
</script>
<%# Keychain review modal. Renders inert markup on every page; the inline
    script inside the partial only opens the modal when the
    keychain_show_review cookie is present (set by the post-login
    attribution middleware in routes.js). Cheap to include everywhere. %>
<%- include('keychain-review-modal') %>
</body>
</html>
