</main>
<footer class="site-foot">
<div class="stripe-band"></div>
<div class="wrap foot-grid">
<div>
<p class="foot-brand"><%= settings.business_name || 'Pavage Diamand' %></p>
<p class="foot-tag"><%= t.footer_tagline %></p>
<span class="foot-region"><%= t.footer_region %></span>
</div>
<div>
<h3><%= t.footer_nav %></h3>
<a href="."><%= t.nav_home %></a>
<a href="galerie"><%= t.nav_gallery %></a>
<a href="tarifs"><%= t.nav_pricing %></a>
<a href="rendez-vous"><%= t.nav_book %></a>
<a href="contact"><%= t.nav_contact %></a>
</div>
<div>
<h3><%= t.footer_contact %></h3>
<% if (settings.contact_phone) { %><a href="tel:<%= settings.contact_phone %>"><%= formatPhone(settings.contact_phone) %></a><% } else { %><a href="contact"><%= t.nav_contact %></a><% } %>
<% if (settings.contact_email) { %><a href="mailto:<%= settings.contact_email %>"><%= settings.contact_email %></a><% } %>
<% if (settings.business_address) { %><p style="color:#cfd5df;padding:4px 0"><%= settings.business_address %></p><% } else { %><p style="color:#cfd5df;padding:4px 0"><%= settings.service_area || 'Laurentides, QC' %></p><% } %>
<% if (settings.hours) { %><p style="color:#9aa3b2;padding:4px 0;font-size:14px"><%= settings.hours %></p><% } %>
</div>
<div>
<h3><%= t.footer_push %></h3>
<p style="color:#9aa3b2;font-size:14px;margin-bottom:14px"><%= t.footer_push_text %></p>
<button data-push-btn class="btn btn-outline" type="button"><%= t.footer_push_btn %></button>
</div>
</div>
<div class="foot-bottom">© <%= new Date().getFullYear() %> <%= settings.business_name || 'Pavage Diamand' %> — <%= t.footer_rights %></div>
</footer>
<div class="call-bar">
<% if (settings.contact_phone) { %><a href="tel:<%= settings.contact_phone %>" class="cb-call"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg><%= t.cta_call %></a><% } else { %><a href="contact" class="cb-call"><%= t.nav_contact %></a><% } %>
<a href="rendez-vous" class="cb-book"><%= t.cta_book %></a>
</div>
<script>
try {
  if (window.TenantSDK) {
    TenantSDK.ui.showInstallBanner();
    setTimeout(function() { try { TenantSDK.ui.showPushPrompt(); } catch (e) {} }, 8000);
  }
} catch (e) {}
</script>
</body>
</html>
