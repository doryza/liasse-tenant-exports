<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tableau de bord — Admin</title>
<link rel="stylesheet" href="public/css/admin-styles.css">
</head>
<body class="admin-body">
<%- include('partials/admin-sidebar') %>
<% var s = (typeof stats !== 'undefined' && stats) ? stats : {}; var st = (typeof settings !== 'undefined' && settings) ? settings : {}; %>
<main class="admin-main">
<header class="admin-topbar">
<button class="sidebar-toggle" id="sbToggle" aria-label="Menu"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button>
<h1>Tableau de bord</h1>
<a class="btn" href="." target="_blank">↗ Voir le site</a>
</header>
<div class="admin-content">
<div class="stat-grid">
<div class="stat-card"><span class="stat-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg></span><span class="stat-txt"><span class="stat-n"><%= s.totalVisits || 0 %></span><span class="stat-l">Visites totales</span></span></div>
<div class="stat-card"><span class="stat-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 6l-9.5 9.5-5-5L1 18"/><path d="M17 6h6v6"/></svg></span><span class="stat-txt"><span class="stat-n"><%= s.recentVisits || 0 %></span><span class="stat-l">Visites (7 jours)</span></span></div>
<div class="stat-card"><span class="stat-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></span><span class="stat-txt"><span class="stat-n"><%= s.newBookings || 0 %></span><span class="stat-l">RDV à traiter</span></span></div>
<div class="stat-card"><span class="stat-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span><span class="stat-txt"><span class="stat-n"><%= s.messages || 0 %></span><span class="stat-l">Messages reçus</span></span></div>
<div class="stat-card"><span class="stat-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg></span><span class="stat-txt"><span class="stat-n"><%= s.pushSubs || 0 %></span><span class="stat-l">Abonnés push</span></span></div>
<div class="stat-card"><span class="stat-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span><span class="stat-txt"><span class="stat-n"><%= s.users || 0 %></span><span class="stat-l">Utilisateurs</span></span></div>
</div>
<h2 class="admin-h2">Gérer le contenu</h2>
<div class="mod-grid">
<a class="mod-card" href="admin/bookings"><span class="mc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></span><span class="mc-body"><strong><%= s.bookings || 0 %></strong><span class="mc-lbl">Rendez-vous</span></span><span class="mc-go">Gérer →</span></a>
<a class="mod-card" href="admin/contact_messages"><span class="mc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span><span class="mc-body"><strong><%= s.messages || 0 %></strong><span class="mc-lbl">Messages</span></span><span class="mc-go">Gérer →</span></a>
<a class="mod-card" href="admin/services"><span class="mc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg></span><span class="mc-body"><strong><%= s.services || 0 %></strong><span class="mc-lbl">Services</span></span><span class="mc-go">Gérer →</span></a>
<a class="mod-card" href="admin/pricing_packages"><span class="mc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12l-8 8-9-9V4h7z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg></span><span class="mc-body"><strong><%= s.packages || 0 %></strong><span class="mc-lbl">Tarifs & forfaits</span></span><span class="mc-go">Gérer →</span></a>
<a class="mod-card" href="admin/gallery"><span class="mc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg></span><span class="mc-body"><strong><%= s.gallery || 0 %></strong><span class="mc-lbl">Photos</span></span><span class="mc-go">Gérer →</span></a>
<a class="mod-card" href="admin/team_members"><span class="mc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></span><span class="mc-body"><strong><%= s.team || 0 %></strong><span class="mc-lbl">Équipe</span></span><span class="mc-go">Gérer →</span></a>
<a class="mod-card" href="admin/posts"><span class="mc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z"/></svg></span><span class="mc-body"><strong><%= s.posts || 0 %></strong><span class="mc-lbl">Articles</span></span><span class="mc-go">Gérer →</span></a>
</div>
<div class="two-col">
<section class="panel">
<div class="panel-head"><h2>Derniers rendez-vous</h2><a class="btn btn-sm" href="admin/bookings">Tout voir</a></div>
<% if (typeof recentBookings !== 'undefined' && recentBookings.length > 0) { %>
<table class="admin-table"><thead><tr><th>Nom</th><th>Téléphone</th><th>Service</th><th>Statut</th></tr></thead><tbody>
<% recentBookings.forEach(function(b) { %><tr><td><%= b.name %></td><td><%= b.phone %></td><td><%= b.service %></td><td><span class="badge b-<%= b.status %>"><%= b.status %></span></td></tr><% }); %>
</tbody></table>
<% } else { %><p class="empty-msg">Aucun rendez-vous pour l’instant.</p><% } %>
</section>
<section class="panel">
<div class="panel-head"><h2>Derniers messages</h2><a class="btn btn-sm" href="admin/contact_messages">Tout voir</a></div>
<% if (typeof recentMessages !== 'undefined' && recentMessages.length > 0) { %>
<table class="admin-table"><thead><tr><th>Nom</th><th>Courriel</th><th>Message</th></tr></thead><tbody>
<% recentMessages.forEach(function(m) { %><tr><td><%= m.name %></td><td><%= m.email %></td><td><%= String(m.message || '').slice(0, 60) %></td></tr><% }); %>
</tbody></table>
<% } else { %><p class="empty-msg">Aucun message pour l’instant.</p><% } %>
</section>
</div>
<section class="panel settings-panel">
<div class="panel-head"><h2>Coordonnées & réglages</h2><button class="btn btn-primary" id="saveSettings" type="button" style="background-color:#6366f1;color:#fff">Enregistrer</button></div>
<p class="panel-sub">Ces informations alimentent les liens d’appel, le pied de page et la page contact.</p>
<div class="set-grid">
<div class="ffield"><label for="set_business_name">Nom de l’entreprise</label><input id="set_business_name" type="text" value="<%= st.business_name || '' %>" placeholder="Pavage Diamand"></div>
<div class="ffield"><label for="set_contact_phone">Téléphone</label><input id="set_contact_phone" type="text" value="<%= st.contact_phone || '' %>" placeholder="ex. 4384356829"></div>
<div class="ffield"><label for="set_contact_email">Courriel affiché</label><input id="set_contact_email" type="email" value="<%= st.contact_email || '' %>" placeholder="info@exemple.com"></div>
<div class="ffield"><label for="set_service_area">Zone desservie</label><input id="set_service_area" type="text" value="<%= st.service_area || '' %>" placeholder="ex. Laurentides, QC"></div>
<div class="ffield ffull"><label for="set_business_address">Adresse</label><input id="set_business_address" type="text" value="<%= st.business_address || '' %>" placeholder="ex. 123 rue Principale, Saint-Jérôme, QC"></div>
<div class="ffield ffull"><label for="set_hours">Heures d’ouverture</label><input id="set_hours" type="text" value="<%= st.hours || '' %>" placeholder="ex. Lun – Sam : 7 h à 18 h"></div>
</div>
</section>
</div>
</main>
<div class="toast-wrap" id="toastWrap"></div>
<script>
(function() {
  var tg = document.getElementById('sbToggle');
  var sb = document.getElementById('adminSidebar');
  if (tg && sb) tg.addEventListener('click', function() { sb.classList.toggle('open'); });
})();
</script>
<script>
function showToast(msg, isErr) {
  var w = document.getElementById('toastWrap'); if (!w) return;
  var t = document.createElement('div'); t.className = 'toast' + (isErr ? ' err' : ''); t.textContent = msg;
  w.appendChild(t);
  setTimeout(function() { t.style.opacity = '0'; setTimeout(function() { if (t.parentNode) t.parentNode.removeChild(t); }, 320); }, 2600);
}
(function() {
  var btn = document.getElementById('saveSettings');
  if (!btn) return;
  btn.addEventListener('click', function() {
    var keys = ['business_name', 'contact_phone', 'contact_email', 'service_area', 'business_address', 'hours'];
    btn.disabled = true;
    var ps = keys.map(function(k) {
      var el = document.getElementById('set_' + k);
      return fetch('api/admin/settings', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ key: k, value: el ? el.value : '' }) });
    });
    Promise.all(ps).then(function(rs) {
      var ok = rs.every(function(r) { return r.ok; });
      showToast(ok ? 'Réglages enregistrés ✓' : 'Erreur lors de l’enregistrement', !ok);
      btn.disabled = false;
    }).catch(function() { showToast('Erreur de connexion', true); btn.disabled = false; });
  });
})();
</script>
</body>
</html>
