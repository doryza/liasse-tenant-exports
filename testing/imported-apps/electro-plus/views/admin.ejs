<%- include('partials/header',{adminMode:true}) %>
<% const overview=typeof stats!=='undefined'&&stats?stats:{}; const recentRows=typeof recent!=='undefined'&&Array.isArray(recent)?recent:[]; const dashboardModules=typeof modules!=='undefined'&&Array.isArray(modules)?modules:[]; const adminDate=typeof date==='function'?date:function(v){return v?new Date(v).toLocaleDateString(lang==='en'?'en-CA':'fr-CA'):'—';}; const adminCol=typeof col==='function'?col:function(fr,en){return lang==='en'?en:fr;}; const dashboardSettings=typeof settings!=='undefined'&&settings?settings:{}; const steps=[{label:t.phoneLabel,done:typeof hasPhone!=='undefined'&&hasPhone,href:'admin/settings#groupContact'},{label:t.addressLabel,done:typeof hasAddress!=='undefined'&&hasAddress,href:'admin/settings#groupContact'},{label:t.hoursLabel,done:dashboardSettings.hours_verified==='1'&&typeof s==='function'&&!!s('hours'),href:'admin/settings#groupContact'},{label:t.realPhoto,done:dashboardSettings.hero_photo_real==='1'&&/^https:\/\//.test(dashboardSettings._p_hero_image_url||''),href:'admin/settings#groupStoreImage'},{label:t.confirmedProducts,done:Number(overview.confirmedProducts)>0,href:'admin/products'}]; const complete=steps.filter(function(step){return step.done;}).length; %>
<div class='admin-layout'><%- include('partials/admin-sidebar') %><main class='admin-main' id='main'>
<header class='admin-page-heading admin-heading-row'><div><p class='admin-eyebrow'><%= t.dashboard %></p><h1><%= t.welcomeAdmin %></h1><p><%= t.adminIntro %></p></div><a class='button' style='background-color:#2858ef;color:#fff' href='admin/products?new=1'>+ <%= t.createProduct %></a></header>
<section aria-label='<%= t.inventoryOverview %>' class='admin-stats'><% [['confirmedProducts',t.confirmedProducts],['draftProducts',t.drafts],['totalVisits',t.visits],['recentVisits',t.weekVisits]].forEach(function(m){ %><div class='stat-box'><span><%= m[1] %></span><strong><%= Number(overview[m[0]])||0 %></strong></div><% }); %></section><p class='admin-muted metric-note'><%= t.visitsHint %></p>
<div class='dashboard-grid'><section class='admin-panel'><div class='panel-heading'><h2><%= t.checklistTitle %></h2><span class='status-label <%= complete===steps.length?'status-live':'status-example' %>'><%= complete %> / <%= steps.length %></span></div><progress class='setup-progress' value='<%= complete %>' max='<%= steps.length %>' aria-label='<%= t.checklistProgress %>'></progress><ul class='setup-list'><% steps.forEach(function(step){ %><li><span class='check-dot <%= step.done?'is-complete':'' %>' aria-hidden='true'><%= step.done?'✓':'○' %></span><a href='<%= step.href %>'><%= step.label %></a><span class='admin-muted'><%= step.done?t.ready:t.needsReview %></span></li><% }); %></ul><% if(complete<steps.length){ %><p class='help'><%= t.setupNotice %></p><% } %></section>
<section class='admin-panel'><h2><%= t.manageContent %></h2><div class='module-list'><% dashboardModules.forEach(function(m){ %><a class='module-link' href='admin/<%= m.key %>'><div class='module-top'><strong><%= m.label %></strong><span class='module-count'><%= Number(overview[m.key])||0 %></span></div><p><%= m.description %></p><span class='module-cta'><%= t.manage %> →</span></a><% }); %><a class='settings-shortcut' href='admin/settings'><%= t.settingsTitle %> →</a></div></section></div>
<section class='admin-panel'><div class='panel-heading'><h2><%= t.recentEdits %></h2><a href='admin/products'><%= t.manage %> →</a></div><% if(recentRows.length){ %><div class='table-scroll'><table><thead><tr><th scope='col'><%= t.titleColumn %></th><th scope='col'><%= t.statusColumn %></th><th scope='col'><%= t.updatedColumn %></th><th scope='col'><%= t.actions %></th></tr></thead><tbody><% recentRows.forEach(function(r){ %><tr><td><a class='record-name' href='admin/products?edit=<%= r.id %>'><%= r[adminCol('title','title_en')]||r.title %></a></td><td><span class='status-label <%= !r.published?'status-draft':r.is_example?'status-example':'status-live' %>'><%= !r.published?t.draft:r.is_example?t.exampleStatus:t.verifiedStatus %></span></td><td><%= adminDate(r.updated_at) %></td><td><a class='small-button' href='admin/products?edit=<%= r.id %>'><%= t.edit %></a></td></tr><% }); %></tbody></table></div><% }else{ %><div class='admin-empty'><p><%= t.noEdits %></p><a class='button' style='background-color:#2858ef;color:#fff' href='admin/products?new=1'><%= t.createProduct %></a></div><% } %></section>
<div class='dashboard-grid'><section class='admin-panel'><h2><%= t.subscribers %></h2><dl class='compact-metrics'><div><dt><%= t.subscribers %></dt><dd><%= Number(overview.pushSubscriberCount)||0 %></dd></div><div><dt><%= t.users %></dt><dd><%= Number(overview.userCount)||0 %></dd></div><div><dt><%= t.examples %></dt><dd><%= Number(overview.exampleProducts)||0 %></dd></div></dl></section><section class='admin-panel'><h2><%= t.submissionsTitle %></h2><p><%= t.noSubmissions %></p><% if(typeof contactConfigured!=='undefined'&&!contactConfigured){ %><p class='admin-notice'><%= t.emailSetup %></p><% } %></section></div>
</main></div><%- include('partials/footer',{adminMode:true}) %>