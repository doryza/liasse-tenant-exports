<% const footerAdmin=typeof adminMode!=='undefined'&&adminMode; const footerPhone=typeof hasPhone!=='undefined'&&hasPhone; const footerAddress=typeof hasAddress!=='undefined'&&hasAddress; const footerSettings=typeof settings!=='undefined'&&settings?settings:{}; const footerS=typeof s==='function'?s:function(k){return t[k]||'';}; const footerPath=typeof currentPath!=='undefined'?currentPath:'.'; const footerLink=typeof link==='function'?link:function(path,patch){return path+'?lang='+patch.lang;}; %>
<footer class='site-footer'><div class='wrap footer-inner'>
<div><a class='wordmark' href='.'><span data-setting-key='brand_electro'><%= footerSettings.brand_electro||'Electro' %></span><span data-setting-key='brand_plus'><%= footerSettings.brand_plus||'Plus' %></span></a><p data-setting-key='footer_text'><%= footerS('footer_text') %></p></div>
<div class='footer-contact'><% if(footerPhone){ %><a href='<%= typeof telephone!=='undefined'?telephone:'nous-trouver' %>' data-setting-key='contact_phone'><%= footerSettings.contact_phone %></a><% }else{ %><a href='nous-trouver#coordonnees' data-lk='t:contactLabel'><%= t.contactLabel %></a><% } %>
<% if(footerAddress){ %><a href='<%= typeof directionsUrl!=='undefined'?directionsUrl:'nous-trouver' %>' target='_blank' rel='noopener noreferrer' data-setting-key='business_address'><%= footerSettings.business_address %></a><% }else{ %><span data-lk='t:region'><%= t.region %></span><% } %>
<% if(!footerAdmin){ %><button class='text-button' type='button' data-push-btn data-lk='t:notifications'><%= t.notifications %></button><% } %></div>
<div class='footer-utility'><div class='languages'><a href='<%= footerLink(footerPath,{lang:'fr'}) %>' data-lang-link lang='fr' aria-label='<%= t.french %>' data-lk='t:french'>FR</a><span aria-hidden='true'>/</span><a href='<%= footerLink(footerPath,{lang:'en'}) %>' data-lang-link lang='en' aria-label='<%= t.english %>' data-lk='t:english'>EN</a></div><a href='admin' data-lk='t:adminLink'><%= t.adminLink %></a></div>
</div></footer>
<% if(!footerAdmin){ %><div class='mobile-actions' style='<%= !footerPhone&&!footerAddress?'grid-template-columns:1fr':'' %>'><a style='background-color:#ffe04b;color:#132b54' href='<%= footerPhone&&typeof telephone!=='undefined'?telephone:'nous-trouver#coordonnees' %>' data-lk='<%= footerPhone?'t:call':'t:contactLabel' %>'><% if(footerPhone){ %><svg viewBox='0 0 24 24' aria-hidden='true'><path d='M7 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-3l-5-2-2 2a14 14 0 0 1-7-7l2-2-2-5Z'/></svg><% } %><%= footerPhone?t.call:t.contactLabel %></a><% if(footerPhone||footerAddress){ %><a style='background-color:#2858ef;color:#fff' href='<%= footerAddress&&typeof directionsUrl!=='undefined'?directionsUrl:'nous-trouver#coordonnees' %>' <%= footerAddress?'target=_blank rel=noopener':'' %> data-lk='<%= footerAddress?'t:directions':'t:navFind' %>'><svg viewBox='0 0 24 24' aria-hidden='true'><path d='m12 3 9 9-9 9-9-9 9-9Z M8 15v-4h8m-3-3 3 3-3 3'/></svg><%= footerAddress?t.directions:t.navFind %></a><% } %></div><% } %>
<script id='public-copy' type='application/json'><%- JSON.stringify({pushTitle:t.pushTitle,pushDescription:t.pushDescription,mapLoading:t.mapLoading,mapUnavailable:t.mapUnavailable}).replace(/</g,'\\u003c') %></script>
<script src='public/js/navigation.js' defer></script>
<script src='public/js/app.js' defer></script>
<script src='public/js/map.js' defer></script>
</body></html>