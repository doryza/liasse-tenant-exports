<% const headerAdmin=typeof adminMode!=='undefined'&&adminMode; const headerSettings=typeof settings!=='undefined'&&settings?settings:{}; const headerS=typeof s==='function'?s:function(k){return t[k]||'';}; const headerPath=typeof currentPath!=='undefined'?currentPath:'.'; const headerLink=typeof link==='function'?link:function(path,patch){return path+'?lang='+patch.lang;}; const headerLang=typeof lang!=='undefined'?lang:'fr'; const headerTitle=(typeof pageTitle!=='undefined'?pageTitle:headerS('hero_title'))+' · '+(headerSettings.business_name||'Electro Plus'); const headerSeo=typeof seo!=='undefined'&&seo?seo:{}; %>
<!DOCTYPE html><html lang='<%= headerLang %>'><head>
<meta charset='utf-8'><base href='<%= tenantRoot %>'><meta name='viewport' content='width=device-width,initial-scale=1,viewport-fit=cover'><meta name='theme-color' content='#2858EF'><meta name='apple-mobile-web-app-capable' content='yes'>
<meta name='description' content='<%= headerS('hero_subtitle') %>'><title><%= headerTitle %></title>
<% if(headerAdmin){ %><meta name='robots' content='noindex,nofollow'><% }else{ %><meta property='og:type' content='website'><meta property='og:site_name' content='<%= headerSettings.business_name||'Electro Plus' %>'><meta property='og:title' content='<%= headerTitle %>'><meta property='og:description' content='<%= headerS('hero_subtitle') %>'><meta property='og:locale' content='<%= headerLang==='en'?'en_CA':'fr_CA' %>'><meta property='og:locale:alternate' content='<%= headerLang==='en'?'fr_CA':'en_CA' %>'><meta name='twitter:card' content='summary_large_image'><meta name='twitter:title' content='<%= headerTitle %>'><meta name='twitter:description' content='<%= headerS('hero_subtitle') %>'><% if(headerSeo.canonical){ %><link rel='canonical' href='<%= headerSeo.canonical %>'><meta property='og:url' content='<%= headerSeo.canonical %>'><link rel='alternate' hreflang='fr-CA' href='<%= headerSeo.fr %>'><link rel='alternate' hreflang='en-CA' href='<%= headerSeo.en %>'><link rel='alternate' hreflang='x-default' href='<%= headerSeo.fr %>'><% } %><% if(/^https:\/\//.test(headerSettings._p_hero_image_url||'')){ %><meta property='og:image' content='<%= headerSettings._p_hero_image_url %>'><meta name='twitter:image' content='<%= headerSettings._p_hero_image_url %>'><meta property='og:image:alt' content='<%= headerSettings.hero_photo_real==='1'?t.realPhoto:t.illustration %>'><% } %><% } %>
<link rel='manifest' href='manifest.json'><link rel='icon' href='public/icon.svg' type='image/svg+xml'><link rel='apple-touch-icon' href='icon.png'><link rel='preconnect' href='https://fonts.googleapis.com'><link rel='preconnect' href='https://fonts.gstatic.com' crossorigin><link href='https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@800&amp;family=DM+Sans:wght@400;500;700&amp;display=swap' rel='stylesheet'><link rel='stylesheet' href='public/css/styles.css'><% if(headerAdmin){ %><link rel='stylesheet' href='public/css/admin-styles.css'><% } %>
</head><body data-admin='<%= headerAdmin?'true':'false' %>'>
<a class='skip' href='<%= headerPath %>#main' data-lk='t:skip'><%= t.skip %></a>
<header class='masthead'><div class='wrap masthead-inner'><a class='wordmark' href='.' aria-label='<%= t.navHome %>'><span data-setting-key='brand_electro'><%= headerSettings.brand_electro||'Electro' %></span><span data-setting-key='brand_plus'><%= headerSettings.brand_plus||'Plus' %></span></a>
<button class='menu-button' id='menu-toggle' type='button' aria-label='<%= t.menu %>' aria-expanded='false' aria-controls='site-nav' data-lk='t:menu'><svg viewBox='0 0 24 24' aria-hidden='true'><path d='M4 7h16M4 12h16M4 17h16'/></svg><%= t.menu %></button>
<nav id='site-nav' aria-label='<%= t.menu %>'><a href='liquidations' aria-current='<%= headerPath==='liquidations'?'page':'false' %>' data-lk='t:navClearance'><%= t.navClearance %></a><a href='nous-trouver' aria-current='<%= headerPath==='nous-trouver'?'page':'false' %>' data-lk='t:navFind'><%= t.navFind %></a>
<% if(typeof hasPhone!=='undefined'&&hasPhone){ %><a class='nav-phone' href='<%= typeof telephone!=='undefined'?telephone:'nous-trouver' %>' data-setting-key='contact_phone'><svg viewBox='0 0 24 24' aria-hidden='true'><path d='M7 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-3l-5-2-2 2a14 14 0 0 1-7-7l2-2-2-5Z'/></svg><%= headerSettings.contact_phone %></a><% }else{ %><a href='nous-trouver#coordonnees' data-lk='t:contactLabel'><%= t.contactLabel %></a><% } %>
<div class='languages' aria-label='<%= t.french+' / '+t.english %>'><a href='<%= headerLink(headerPath,{lang:'fr'}) %>' data-lang-link lang='fr' aria-label='<%= t.french %>' aria-current='<%= headerLang==='fr'?'true':'false' %>' data-lk='t:french'>FR</a><span aria-hidden='true'>/</span><a href='<%= headerLink(headerPath,{lang:'en'}) %>' data-lang-link lang='en' aria-label='<%= t.english %>' aria-current='<%= headerLang==='en'?'true':'false' %>' data-lk='t:english'>EN</a></div></nav></div></header>