<% const shellKind=typeof moduleKind!=='undefined'?moduleKind:'products'; const shellModule=typeof moduleDef!=='undefined'&&moduleDef?moduleDef:{key:shellKind,label:shellKind==='products'?t.productsModule:t.postsModule,description:shellKind==='products'?t.productsHint:t.postsHint,fields:[]}; const shellProducts=shellModule.key==='products'; const shellItems=typeof items!=='undefined'&&Array.isArray(items)?items:[]; const shellDate=typeof date==='function'?date:function(v){return v?new Date(v).toLocaleDateString(lang==='en'?'en-CA':'fr-CA'):'—';}; const shellCategory=(shellModule.fields||[]).find(function(f){return f.name==='category';}); %>
<%- include('header',{adminMode:true}) %>
<div class='admin-layout'><%- include('admin-sidebar') %><main class='admin-main' id='main'>
<header class='admin-page-heading admin-heading-row'><div><p class='admin-eyebrow'><%= t.adminLink %></p><h1><%= shellModule.label %></h1><p><%= shellModule.description %></p></div><button class='button' style='background-color:#2858ef;color:#fff' id='admin-add' type='button'>+ <%= shellProducts?t.createProduct:t.createPost %></button></header>
<noscript><p class='admin-notice'><%= t.noJs %></p></noscript>
<div class='admin-panel admin-toolbar'><label class='search-filter' for='admin-search'><span><%= t.filterAdmin %></span><input type='search' id='admin-search' maxlength='160' placeholder='<%= shellProducts?t.searchPlaceholder:t.filterAdmin %>'></label><label for='admin-state-filter'><span><%= t.statusColumn %></span><select id='admin-state-filter'><option value=''><%= t.allStatuses %></option><option value='draft'><%= t.drafts %></option><option value='published'><%= shellProducts?t.published:t.readyNote %></option><% if(shellProducts){ %><option value='example'><%= t.examples %></option><option value='real'><%= t.realOffers %></option><% } %></select></label>
<% if(shellProducts){ %><label for='admin-category-filter'><span><%= t.fields.category[0] %></span><select id='admin-category-filter'><option value=''><%= t.allCategories %></option><% ((shellCategory&&shellCategory.options)||[]).forEach(function(c){ %><option value='<%= c %>'><%= t[c]||c %></option><% }); %></select></label><% } %>
<label for='admin-sort'><span><%= t.sort %></span><select id='admin-sort'><option value='newest'><%= t.newest %></option><option value='oldest'><%= t.oldest %></option><option value='title'><%= t.alphabetical %></option></select></label><button class='small-button' id='admin-refresh' type='button'><%= t.refresh %></button></div>
<p id='admin-status' class='feedback' role='status' aria-live='polite'></p><div class='list-meta'><p id='admin-count' aria-live='polite'><%= shellItems.length %> <%= t.recordsCount %></p><button type='button' id='admin-reset' class='text-button' hidden><%= t.clearAdminFilters %></button></div>
<div class='admin-panel table-panel'><div class='table-scroll'><table class='records-table' aria-label='<%= shellModule.label %>'><thead><tr><th scope='col'><%= t.titleColumn %></th><% if(shellProducts){ %><th scope='col'><%= t.priceColumn %></th><% } %><th scope='col'><%= t.statusColumn %></th><th scope='col'><%= t.updatedColumn %></th><th scope='col'><%= t.actions %></th></tr></thead><tbody id='admin-rows'>
<% if(shellItems.length){shellItems.slice(0,10).forEach(function(item){ %><tr><td><%= (lang==='en'?item.title_en:item.title)||item.title %></td><% if(shellProducts){ %><td><%= item.is_example?'—':item.price===null?t.priceNotSet:item.price %></td><% } %><td><%= item.published?(shellProducts?t.published:t.readyNote):t.draft %></td><td><%= shellDate(item.updated_at) %></td><td class='row-actions'><button type='button' data-edit='<%= item.id %>' class='small-button'><%= t.edit %></button><button type='button' data-delete='<%= item.id %>' class='small-button danger-outline'><%= t.remove %></button></td></tr><% });}else{ %><tr><td class='empty-cell' colspan='<%= shellProducts?5:4 %>'><div class='admin-empty'><p><%= t.emptyAdmin %></p></div></td></tr><% } %>
</tbody></table></div></div><div class='admin-pagination'><button class='small-button' type='button' id='admin-prev' disabled><%= t.previous %></button><span id='admin-page' aria-live='polite'></span><button class='small-button' type='button' id='admin-next' disabled><%= t.next %></button></div>
<dialog id='editor-dialog' aria-labelledby='editor-title' aria-describedby='editor-hint'><form id='editor-form' action='api/admin/<%= shellModule.key %>' method='post'><div class='dialog-heading'><div><h2 id='editor-title'><%= t.editRecord %></h2><p id='editor-hint'><%= t.editorHint %></p></div><button type='button' class='small-button' data-close-dialog><%= t.close %></button></div><div class='editor-body'><div id='editor-fields'></div><p id='editor-error' class='form-error' role='alert' tabindex='-1'></p></div><div class='dialog-actions'><span id='editor-dirty' class='help' aria-live='polite'></span><button type='button' class='small-button' data-close-dialog><%= t.cancel %></button><button class='button' style='background-color:#2858ef;color:#fff' id='editor-save' type='submit'><%= t.save %></button></div></form></dialog>
<dialog id='delete-dialog' aria-labelledby='delete-title' aria-describedby='delete-help'><div class='delete-body'><h2 id='delete-title'><%= t.deleteTitle %></h2><p id='delete-help'><%= t.deleteHelp %></p><p id='delete-name'></p><p id='delete-error' class='form-error' role='alert'></p></div><div class='dialog-actions'><button type='button' class='small-button' id='delete-cancel'><%= t.cancel %></button><button class='button' style='background-color:#a51f36;color:#fff' type='button' id='delete-confirm'><%= t.deleteConfirm %></button></div></dialog>
<script type='application/json' id='admin-data'><%- JSON.stringify({items:shellItems,module:shellModule,t,lang}).replace(/</g,'\\u003c') %></script><script src='public/js/admin-tools.js' defer></script><script src='public/js/admin.js' defer></script>
</main></div><%- include('footer',{adminMode:true}) %>