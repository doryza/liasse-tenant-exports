<% const visitAddress=typeof hasAddress!=='undefined'&&hasAddress; const visitPhone=typeof hasPhone!=='undefined'&&hasPhone; const visitEmail=typeof hasEmail!=='undefined'&&hasEmail; const visitSettings=typeof settings!=='undefined'&&settings?settings:{}; const visitS=typeof s==='function'?s:function(k){return t[k]||'';}; %>
<section class='location-section' id='coordonnees'><div class='wrap'><h2 data-lk='t:locationTitle'><%= t.locationTitle %></h2><div class='location-grid'>
<div class='store-details'><div><h3 data-lk='t:addressLabel'><%= t.addressLabel %></h3><% if(visitAddress){ %><p class='preserve-lines' data-setting-key='business_address'><%= visitSettings.business_address %></p><a class='light-link' href='<%= typeof directionsUrl!=='undefined'?directionsUrl:'nous-trouver' %>' target='_blank' rel='noopener noreferrer' data-lk='t:openMap'><%= t.openMap %></a><% }else{ %><p data-lk='t:addressPending'><%= t.addressPending %></p><% } %></div>
<div><h3 data-lk='t:phoneLabel'><%= t.phoneLabel %></h3><% if(visitPhone){ %><a class='contact-number' href='<%= typeof telephone!=='undefined'?telephone:'nous-trouver' %>' data-setting-key='contact_phone'><%= visitSettings.contact_phone %></a><% }else{ %><p data-lk='t:phonePending'><%= t.phonePending %></p><% } %></div>
<% if(visitEmail){ %><div><h3 data-lk='t:emailLabel'><%= t.emailLabel %></h3><a class='light-link' href='mailto:<%= visitSettings.contact_email %>' data-setting-key='contact_email'><%= visitSettings.contact_email %></a></div><% } %>
<div><h3 data-lk='t:hoursLabel'><%= t.hoursLabel %></h3><% if(visitSettings.hours_verified==='1'&&visitS('hours')){ %><p class='preserve-lines' data-setting-key='hours'><%= visitS('hours') %></p><% }else{ %><p data-lk='t:hoursPending'><%= t.hoursPending %></p><% } %></div></div>
<div class='map-frame' id='store-map' role='region' aria-label='<%= t.mapTitle %>' data-address='<%= visitAddress?visitSettings.business_address:'' %>' data-key='<%= typeof googleApiKey!=='undefined'?googleApiKey:'' %>' data-lang='<%= lang %>'><div class='map-status'><svg viewBox='0 0 24 24' aria-hidden='true'><path d='M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 0 1 14 0Z'/><circle cx='12' cy='10' r='2.5'/></svg><p role='status' data-lk='<%= visitAddress?'t:mapLoading':'t:mapPending' %>'><%= visitAddress?t.mapLoading:t.mapPending %></p></div></div>
</div></div></section>