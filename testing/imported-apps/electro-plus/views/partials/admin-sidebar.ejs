<% const sidebarPath=typeof currentPath!=='undefined'?currentPath:'admin'; const sidebarLinks=[['admin',t.dashboard,'▦'],['admin/products',t.productsModule,'▤'],['admin/posts',t.postsModule,'✎'],['admin/settings',t.settingsTitle,'⚙']]; %>
<button type='button' class='admin-menu-button' style='background-color:#132b54;color:#fff' id='admin-menu-toggle' aria-expanded='false' aria-controls='admin-sidebar'><%= t.adminMenu %><span aria-hidden='true'>☰</span></button>
<aside class='admin-sidebar' id='admin-sidebar'><p class='admin-sidebar-title'><%= t.adminLink %></p><nav aria-label='<%= t.adminMenu %>'><% sidebarLinks.forEach(function(item){ %><a href='<%= item[0] %>' aria-current='<%= sidebarPath===item[0]?'page':'false' %>' style='<%= sidebarPath===item[0]?'background-color:#2858ef;color:#fff':'' %>'><span class='sidebar-marker' aria-hidden='true'><%= item[2] %></span><span><%= item[1] %></span></a><% }); %></nav><div class='admin-sidebar-bottom'><a href='.' target='_blank' rel='noopener'><%= t.backSite %> ↗</a><a href='admin/logout'><%= t.logout %></a></div></aside>