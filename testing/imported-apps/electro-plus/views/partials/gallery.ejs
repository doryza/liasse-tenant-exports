<% const galleryExample=typeof exampleMode!=='undefined'?exampleMode:true; const galleryProducts=typeof products!=='undefined'&&Array.isArray(products)?products:[]; const galleryCategories=typeof categories!=='undefined'&&Array.isArray(categories)?categories:[]; const galleryQ=typeof q!=='undefined'?q:''; const galleryCategory=typeof category!=='undefined'?category:''; const galleryPath=typeof pagePath!=='undefined'?pagePath:'liquidations'; const galleryPage=typeof page!=='undefined'?page:1; const galleryPages=typeof pages!=='undefined'?pages:1; const galleryTotal=typeof total!=='undefined'?total:galleryProducts.length; const galleryCol=typeof col==='function'?col:function(fr,en){return lang==='en'?en:fr;}; const galleryMoney=typeof money==='function'?money:function(v){return String(v);}; const galleryS=typeof s==='function'?s:function(k){return t[k]||'';}; const galleryLink=typeof link==='function'?link:function(path,patch,hash){const params=new URLSearchParams();Object.keys(patch||{}).forEach(function(k){if(patch[k]!=null)params.set(k,patch[k]);});return path+(params.toString()?'?'+params.toString():'')+(hash?'#'+hash:'');}; const galleryPhone=typeof hasPhone!=='undefined'&&hasPhone; %>
<section class='catalog-section' id='liquidations'><div class='wrap'>
<div class='section-heading'><h2 data-lk='<%= galleryExample?'t:previewTitle':'t:current' %>'><%= galleryExample?t.previewTitle:t.current %></h2><p class='result-count'><span><%= galleryTotal %></span> <span data-lk='t:results'><%= t.results %></span></p></div>
<% if(galleryExample&&galleryProducts.length){ %><p class='preview-notice' data-lk='t:previewNote'><%= t.previewNote %></p><% } %>
<form class='search-form' action='<%= galleryPath %>#liquidations' method='get'><label for='catalog-search' data-lk='t:searchLabel'><%= t.searchLabel %></label><div class='search-controls'><input id='catalog-search' type='search' name='q' maxlength='120' placeholder='<%= t.searchPlaceholder %>' value='<%= galleryQ %>'><input type='hidden' name='lang' value='<%= lang %>'><input type='hidden' name='category' value='<%= galleryCategory %>'><button type='submit' class='button' style='background-color:#2858ef;color:#fff' data-lk='t:search'><svg viewBox='0 0 24 24' aria-hidden='true'><circle cx='10' cy='10' r='6'/><path d='m15 15 6 6'/></svg><%= t.search %></button></div><% if(galleryQ||galleryCategory){ %><a class='ink-link' href='<%= galleryLink(galleryPath,{category:null,q:null,page:null},'liquidations') %>' data-lk='t:clearFilters'><%= t.clearFilters %></a><% } %></form>
<nav class='category-filter' aria-label='<%= t.fields.category[0] %>'><a class='<%= !galleryCategory?'selected':'' %>' style='<%= !galleryCategory?'background-color:#2858ef;color:#fff':'' %>' href='<%= galleryLink(galleryPath,{category:null,page:null},'liquidations') %>' aria-current='<%= !galleryCategory?'true':'false' %>' data-lk='t:all'><%= t.all %></a><% galleryCategories.forEach(function(c){ %><a class='<%= galleryCategory===c.category?'selected':'' %>' style='<%= galleryCategory===c.category?'background-color:#2858ef;color:#fff':'' %>' href='<%= galleryLink(galleryPath,{category:c.category,page:null},'liquidations') %>' aria-current='<%= galleryCategory===c.category?'true':'false' %>' data-lk='t:<%= c.category %>'><%= t[c.category]||c.category %></a><% }); %></nav>
<% if(galleryProducts.length){ %><div class='product-grid'><% galleryProducts.forEach(function(p){ %><article class='product-card' id='appareil-<%= p.id %>'>
<div class='product-image'><% if(p.image_url){ %><img src='<%= p.image_url %>' alt='<%= p[galleryCol('title','title_en')] %>' data-content-source='products:image_url' data-content-id='<%= p.id %>' loading='lazy' width='1200' height='900'><% }else{ %><p data-lk='t:photoExample'><%= t.photoExample %></p><% } %></div>
<div class='product-copy'><p class='product-category' data-content-source='products:category' data-content-id='<%= p.id %>'><%= t[p.category]||p.category %></p><h3 data-content-source='products:<%= galleryCol('title','title_en') %>' data-content-id='<%= p.id %>'><%= p[galleryCol('title','title_en')] %></h3><% if(!p.is_example){ %><p class='model-line'><span data-content-source='products:brand' data-content-id='<%= p.id %>'><%= p.brand %></span> <span data-content-source='products:model' data-content-id='<%= p.id %>'><%= p.model %></span></p><p class='condition'><span data-lk='t:condition'><%= t.condition %></span> : <span data-content-source='products:<%= galleryCol('condition_text','condition_en') %>' data-content-id='<%= p.id %>'><%= p[galleryCol('condition_text','condition_en')] %></span></p><% }else{ %><p class='example-label' data-lk='t:example'><%= t.example %></p><% } %></div>
<% if(!p.is_example&&p.price!==null){ %><div class='price-band'><strong data-content-source='products:price' data-content-id='<%= p.id %>'><%= galleryMoney(p.price) %></strong><span data-lk='t:cad'><%= t.cad %></span></div><% if(galleryS('tax_note')){ %><p class='tax-note' data-setting-key='tax_note'><%= galleryS('tax_note') %></p><% } %><% } %>
<details class='product-details'><summary data-lk='t:details'><%= t.details %><svg viewBox='0 0 24 24' aria-hidden='true'><path d='m6 9 6 6 6-6'/></svg></summary><div class='details-body'>
<% if(p[galleryCol('description','description_en')]){ %><p class='preserve-lines' data-content-source='products:<%= galleryCol('description','description_en') %>' data-content-id='<%= p.id %>'><%= p[galleryCol('description','description_en')] %></p><% }else{ %><p data-lk='<%= p.is_example?'t:exampleDetails':'t:availability' %>'><%= p.is_example?t.exampleDetails:t.availability %></p><% } %>
<% if(p[galleryCol('dimensions','dimensions_en')]){ %><h4 data-lk='t:dimensions'><%= t.dimensions %></h4><p data-content-source='products:<%= galleryCol('dimensions','dimensions_en') %>' data-content-id='<%= p.id %>'><%= p[galleryCol('dimensions','dimensions_en')] %></p><% } %>
<% if(p.image_extra_url){ %><img src='<%= p.image_extra_url %>' alt='<%= p[galleryCol('title','title_en')] %>' data-content-source='products:image_extra_url' data-content-id='<%= p.id %>' loading='lazy' width='1200' height='900'><% } %>
<a class='button full-width' style='background-color:#2858ef;color:#fff' href='<%= galleryPhone&&typeof telephone!=='undefined'?telephone:'nous-trouver#coordonnees' %>' data-lk='<%= galleryPhone?'t:callItem':'t:contactLabel' %>'><%= galleryPhone?t.callItem:t.contactLabel %></a></div></details></article><% }); %></div>
<% }else{ %><div class='empty-state'><h3 data-lk='<%= galleryQ||galleryCategory?'t:noResults':'t:noInventory' %>'><%= galleryQ||galleryCategory?t.noResults:t.noInventory %></h3><p data-lk='<%= galleryQ||galleryCategory?'t:emptyHelp':'t:noInventoryHelp' %>'><%= galleryQ||galleryCategory?t.emptyHelp:t.noInventoryHelp %></p><div class='action-row'><a class='ink-link' href='<%= galleryPhone&&typeof telephone!=='undefined'?telephone:'nous-trouver#coordonnees' %>' data-lk='<%= galleryPhone?'t:call':'t:contactLabel' %>'><%= galleryPhone?t.call:t.contactLabel %></a></div></div><% } %>
<% if(galleryPages>1){ %><nav class='pagination' aria-label='<%= t.page %>'><% if(galleryPage>1){ %><a class='button button-outline' href='<%= galleryLink(galleryPath,{page:galleryPage-1},'liquidations') %>' data-lk='t:previous'><%= t.previous %></a><% } %><span><span data-lk='t:page'><%= t.page %></span> <%= galleryPage %> <span data-lk='t:of'><%= t.of %></span> <%= galleryPages %></span><% if(galleryPage<galleryPages){ %><a class='button button-outline' href='<%= galleryLink(galleryPath,{page:galleryPage+1},'liquidations') %>' data-lk='t:next'><%= t.next %></a><% } %></nav><% } %>
<p class='availability' data-lk='t:availability'><%= t.availability %></p></div></section>