<% const homeS=typeof s==='function'?s:function(k){return t[k]||'';}; const homeCol=typeof col==='function'?col:function(fr,en){return lang==='en'?en:fr;}; const homeMoney=typeof money==='function'?money:function(v){return String(v);}; const homeAddress=typeof hasAddress!=='undefined'&&hasAddress; const homePhone=typeof hasPhone!=='undefined'&&hasPhone; const homeSettings=typeof settings!=='undefined'&&settings?settings:{}; %>
<%- include('partials/header') %>
<main id='main'><section class='hero wrap'>
<div class='hero-copy'><p class='place-label' data-lk='t:region'><%= t.region %></p><h1 data-setting-key='hero_title'><%= homeS('hero_title') %></h1><p class='hero-description' data-setting-key='hero_subtitle'><%= homeS('hero_subtitle') %></p><div class='action-row'><a class='button button-yellow' style='background-color:#ffe04b;color:#132b54' href='liquidations' data-lk='t:browse'><%= t.browse %><svg viewBox='0 0 24 24' aria-hidden='true'><path d='M4 12h15m-6-6 6 6-6 6'/></svg></a><a class='light-link' href='<%= homeAddress&&typeof directionsUrl!=='undefined'?directionsUrl:'nous-trouver#coordonnees' %>' <%= homeAddress?'target=_blank rel=noopener':'' %> data-lk='<%= homeAddress?'t:directions':'t:navFind' %>'><%= homeAddress?t.directions:t.navFind %></a></div></div>
<% if(typeof featured!=='undefined'&&featured){ %><figure class='hero-exhibit real-exhibit'><img src='<%= featured.image_url %>' alt='<%= featured[homeCol('title','title_en')] %>' data-content-source='products:image_url' data-content-id='<%= featured.id %>' width='1200' height='900' fetchpriority='high'><figcaption><a class='hero-product-name ink-link' href='liquidations#appareil-<%= featured.id %>' data-content-source='products:<%= homeCol('title','title_en') %>' data-content-id='<%= featured.id %>'><%= featured[homeCol('title','title_en')] %></a><span data-content-source='products:model' data-content-id='<%= featured.id %>'><%= featured.model %></span></figcaption><div class='price-band hero-price'><strong data-content-source='products:price' data-content-id='<%= featured.id %>'><%= homeMoney(featured.price) %></strong><span data-lk='t:cad'><%= t.cad %></span></div></figure>
<% }else{ %><figure class='hero-exhibit'><img src='<%= homeSettings._p_hero_image_url || 'https://res.cloudinary.com/duhp69meg/image/upload/v1789530614/tapavis_tenant_electro-plus/build_electro-plus_c5e3b918-7f4c-484f-851b-27a66fa28fb7.png' %>' data-setting-key='_p_hero_image_url' alt='<%= homeSettings.hero_photo_real==='1'?t.realPhoto:t.illustration %>' width='1200' height='1500' fetchpriority='high'><figcaption data-lk='<%= homeSettings.hero_photo_real==='1'?'t:realPhoto':'t:illustration' %>'><%= homeSettings.hero_photo_real==='1'?t.realPhoto:t.illustration %></figcaption></figure><% } %>
</section><%- include('partials/gallery') %>
<section class='visit-band'><div class='wrap visit-band-inner'><div><h2 data-setting-key='visit_title'><%= homeS('visit_title') %></h2><p data-setting-key='visit_text'><%= homeS('visit_text') %></p></div><div class='action-row'><a class='button' style='background-color:#2858ef;color:#fff' href='<%= homePhone&&typeof telephone!=='undefined'?telephone:'nous-trouver#coordonnees' %>' data-lk='<%= homePhone?'t:call':'t:contactLabel' %>'><%= homePhone?t.call:t.contactLabel %></a><a class='ink-link' href='<%= homeAddress&&typeof directionsUrl!=='undefined'?directionsUrl:'nous-trouver#coordonnees' %>' <%= homeAddress?'target=_blank rel=noopener':'' %> data-lk='<%= homeAddress?'t:getDirections':'t:navFind' %>'><%= homeAddress?t.getDirections:t.navFind %></a></div></div></section>
<%- include('partials/visit') %></main><%- include('partials/footer') %>