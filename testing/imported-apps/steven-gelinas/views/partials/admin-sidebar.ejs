<div class="adm-overlay" id="admOverlay"></div>
<header class="adm-topbar"><button id="admMenuBtn" aria-label="Menu"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button><span><%= (typeof pageTitle!=='undefined')?pageTitle:'Administration' %></span></header>
<script>
(function(){var b=document.getElementById('admMenuBtn'),s=document.getElementById('admSidebar'),o=document.getElementById('admOverlay');if(b&&s){b.addEventListener('click',function(){s.classList.toggle('open');if(o)o.classList.toggle('show');});}if(o&&s){o.addEventListener('click',function(){s.classList.remove('open');o.classList.remove('show');});}})();
</script>