<aside class="adm-sidebar" id="admSidebar">
<div class="adm-brand"><span class="adm-brand-mark">BG</span><div><strong>Boutique Gélinas</strong><small>Administration</small></div></div>
<nav class="adm-nav">
<a href="admin" class="<%= (typeof active!=='undefined'&&active==='dashboard')?'on':'' %>">Tableau de bord</a>
<a href="admin/products" class="<%= (typeof active!=='undefined'&&active==='products')?'on':'' %>">Produits</a>
<a href="admin/orders" class="<%= (typeof active!=='undefined'&&active==='orders')?'on':'' %>">Commandes<% if (typeof badges!=='undefined' && badges && Number(badges.pendingOrders)>0) { %><span class="adm-nav-badge"><%= badges.pendingOrders %></span><% } %></a>
<a href="admin/posts" class="<%= (typeof active!=='undefined'&&active==='posts')?'on':'' %>">Bulletin</a>
