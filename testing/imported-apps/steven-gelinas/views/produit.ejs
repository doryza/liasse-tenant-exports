<%- include('partials/header') %>
<% var S=(typeof settings!=='undefined'&&settings)?settings:{}; %>
<section class="section">
<% if (typeof p!=='undefined' && p) { %>
<p class="crumbs mono"><a href="catalogue">← Retour au catalogue</a></p>
<div class="product-split">
<div class="stamp stamp-lg stamp-square"><img src="<%= p.image_url || 'https://placehold.co/800x800/efe6d3/20244d/png?text=Article' %>" alt="<%= p.name %>"></div>
<div class="product-info">
<p class="tag-no">Nº <%= p.item_number || p.id %><%= p.category ? ' — ' + p.category : '' %></p>
<h1><%= p.name %></h1>
<div class="price-row price-row-lg"><span class="leader"></span><span class="price"><%= formatPrice(p.price) %></span></div>
<p class="product-desc"><%= p.description %></p>
<% if (Number(p.in_stock)) { %>
<div class="qty-row">
<label class="mono" for="qty">Quantité</label>
<div class="qty-stepper"><button type="button" data-qty-minus aria-label="Réduire la quantité">−</button><input id="qty" type="number" min="1" max="20" value="1" aria-label="Quantité"><button type="button" data-qty-plus aria-label="Augmenter la quantité">+</button></div>
</div>
<button class="btn btn-primary btn-block" style="background-color:#6366f1;color:#fff" data-add-cart data-id="<%= p.id %>" data-qty-from="qty">Ajouter au bon de commande</button>
<% } else { %>
<p class="soldout">Cet article est épuisé pour le moment.</p>
<button class="btn btn-ghost" data-push-btn>M'aviser quand il revient</button>
<% } %>
<% if (S.shipping_text) { %><p class="ship-note mono"><%= S.shipping_text %></p><% } %>
</div>
</div>
<% if (typeof related!=='undefined' && related && related.length) { %>
<div class="sec-head" style="margin-top:3.5rem"><h2>Aussi au catalogue</h2></div>
<div class="grid grid-3">
<% related.forEach(function(p){ %><%- include('partials/product-card', { p: p }) %><% }); %>
</div>
<% } %>
<% } else { %>
<div class="empty-note"><p>Cet article n'est plus au catalogue.</p><a class="btn btn-ghost" href="catalogue">Retour au catalogue</a></div>
<% } %>
</section>
<%- include('partials/footer') %>