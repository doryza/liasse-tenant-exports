<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Articles · Admin</title>
<link rel="stylesheet" href="public/css/admin-styles.css">
</head>
<body class="admin-body">
<%- include('partials/admin-sidebar') %>
<main class="admin-main">
  <header class="admin-header">
    <button class="admin-mobile-toggle" id="adminToggle" aria-label="Menu" type="button">☰</button>
    <h1>Articles / Blog</h1>
    <button class="btn btn-primary" onclick="openModal()" type="button" style="background-color:#1b1d83;color:#fff">+ Nouvel article</button>
  </header>
  <div class="admin-content">
    <div class="toolbar">
      <input id="search" class="toolbar-search" type="search" placeholder="Rechercher par titre ou catégorie...">
      <div class="toolbar-filters">
        <button class="chip chip-active" data-filter="all" type="button">Tous</button>
        <button class="chip" data-filter="published" type="button">Publiés</button>
        <button class="chip" data-filter="draft" type="button">Brouillons</button>
      </div>
    </div>
    <div class="table-card">
      <div class="table-scroll">
      <table class="admin-table" id="tbl">
        <thead><tr><th>#</th><th>Titre (FR)</th><th>Catégorie</th><th>Statut</th><th>Date</th><th class="col-actions">Actions</th></tr></thead>
        <tbody>
          <% if (typeof items !== 'undefined' && items && items.length > 0) { %>
            <% items.forEach(function(p){ %>
              <tr data-status="<%= p.published ? 'published' : 'draft' %>" data-search="<%= ((p.title_fr || '') + ' ' + (p.title_en || '') + ' ' + (p.category || '')).toLowerCase() %>">
                <td><%= p.id %></td>
                <td><strong><%= p.title_fr || p.title_en || '(sans titre)' %></strong></td>
                <td><% if (p.category) { %><span class="badge"><%= p.category %></span><% } else { %><span class="text-muted">—</span><% } %></td>
                <td><span class="badge badge-<%= p.published ? 'completed' : 'archived' %>"><%= p.published ? 'Publié' : 'Brouillon' %></span></td>
                <td><span class="text-muted"><%= formatDate(p.created_at, lang) %></span></td>
                <td class="col-actions">
                  <button class="btn btn-sm" onclick='editItem(<%= JSON.stringify(p) %>)' type="button">✏️ Modifier</button>
                  <button class="btn btn-sm btn-danger" onclick="deleteItem(<%= p.id %>)" type="button">🗑</button>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="6"><div class="empty-state"><div class="empty-state-icon">📝</div><p>Aucun article.</p><p class="empty-state-sub">Créez votre premier article pour partager des conseils.</p><button class="btn btn-primary" onclick="openModal()" type="button" style="background-color:#1b1d83;color:#fff;margin-top:14px">+ Nouvel article</button></div></td></tr>
          <% } %>
        </tbody>
      </table>
      </div>
    </div>
  </div>
</main>

<div id="modal" class="modal" style="display:none">
  <div class="modal-backdrop" onclick="closeModal()"></div>
  <div class="modal-card">
    <h2 id="modalTitle">Nouvel article</h2>
    <form id="form">
      <input type="hidden" id="f_id">
      <div class="form-row"><label>Titre (FR) *</label><input id="f_title_fr" required maxlength="200"></div>
      <div class="form-row"><label>Titre (EN)</label><input id="f_title_en" maxlength="200"></div>
      <div class="form-row"><label>Contenu (FR)</label><textarea id="f_content_fr" rows="5"></textarea></div>
      <div class="form-row"><label>Contenu (EN)</label><textarea id="f_content_en" rows="5"></textarea></div>
      <div class="form-row"><label>URL d'image</label><input id="f_image_url" type="url" placeholder="https://..."></div>
      <div class="form-row"><label>Catégorie</label><input id="f_category" maxlength="50" placeholder="Conseils, Nouvelles..."></div>
      <div class="form-row form-row-check"><label><input id="f_published" type="checkbox" checked> <span>Publié (visible des visiteurs)</span></label></div>
      <div id="formError" class="alert alert-error" style="display:none"></div>
      <div class="modal-actions">
        <button type="button" class="btn" onclick="closeModal()">Annuler</button>
        <button type="submit" class="btn btn-primary" style="background-color:#1b1d83;color:#fff">Enregistrer</button>
      </div>
    </form>
  </div>
</div>

<script>
var modal = document.getElementById('modal');
var form = document.getElementById('form');
var formError = document.getElementById('formError');
function openModal(){
  document.getElementById('modalTitle').textContent = 'Nouvel article';
  form.reset();
  document.getElementById('f_id').value = '';
  document.getElementById('f_published').checked = true;
  formError.style.display = 'none';
  modal.style.display = 'flex';
}
function closeModal(){ modal.style.display = 'none'; }
function editItem(p){
  document.getElementById('modalTitle').textContent = 'Modifier l\'article';
  document.getElementById('f_id').value = p.id;
  document.getElementById('f_title_fr').value = p.title_fr || '';
  document.getElementById('f_title_en').value = p.title_en || '';
  document.getElementById('f_content_fr').value = p.content_fr || '';
  document.getElementById('f_content_en').value = p.content_en || '';
  document.getElementById('f_image_url').value = p.image_url || '';
  document.getElementById('f_category').value = p.category || '';
  document.getElementById('f_published').checked = !!p.published;
  formError.style.display = 'none';
  modal.style.display = 'flex';
}
form.addEventListener('submit', async function(e){
  e.preventDefault();
  formError.style.display = 'none';
  var id = document.getElementById('f_id').value;
  var data = {
    title_fr: document.getElementById('f_title_fr').value,
    title_en: document.getElementById('f_title_en').value,
    content_fr: document.getElementById('f_content_fr').value,
    content_en: document.getElementById('f_content_en').value,
    image_url: document.getElementById('f_image_url').value,
    category: document.getElementById('f_category').value,
    published: document.getElementById('f_published').checked
  };
  try {
    var url = id ? ('api/admin/posts/' + id) : 'api/admin/posts';
    var method = id ? 'PUT' : 'POST';
    var res = await fetch(url, { method: method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) });
    var json = await res.json();
    if (!res.ok) throw new Error(json.error || 'Erreur');
    location.reload();
  } catch (err) { formError.textContent = err.message; formError.style.display = 'block'; }
});
async function deleteItem(id){
  if (!confirm('Supprimer cet article? Cette action est irréversible.')) return;
  await fetch('api/admin/posts/' + id, { method: 'DELETE' });
  location.reload();
}
(function(){
  var search = document.getElementById('search');
  var chips = document.querySelectorAll('.chip');
  var currentFilter = 'all';
  function apply(){
    var q = (search.value || '').toLowerCase().trim();
    document.querySelectorAll('#tbl tbody tr[data-search]').forEach(function(tr){
      var matchSearch = !q || (tr.getAttribute('data-search') || '').indexOf(q) >= 0;
      var matchFilter = currentFilter === 'all' || tr.getAttribute('data-status') === currentFilter;
      tr.style.display = (matchSearch && matchFilter) ? '' : 'none';
    });
  }
  if (search) search.addEventListener('input', apply);
  chips.forEach(function(c){ c.addEventListener('click', function(){
    chips.forEach(function(x){ x.classList.remove('chip-active'); });
    c.classList.add('chip-active');
    currentFilter = c.getAttribute('data-filter');
    apply();
  }); });
})();
var t = document.getElementById('adminToggle');
var sb = document.getElementById('adminSidebar');
if (t && sb) t.addEventListener('click', function(){ sb.classList.toggle('open'); });
</script>
</body>
</html>
