<%- include('partials/header') %>

<section class="section">
  <div class="wrap">
    <nav class="breadcrumb" aria-label="fil d’Ariane" style="margin-bottom:26px">
      <a href="<%= urls.home %>"><%= t.home %></a> · <a href="<%= urls.boutique %>"><%= t.boutique %></a> · <%= field(item, 'name') %>
    </nav>

    <div class="split split--top">
      <figure class="portrait" style="aspect-ratio:1;position:relative;overflow:hidden">
        <% if (item.image_url) { %>
          <img src="<%= item.image_url %>" alt="<%= field(item, 'name') %>" width="800" height="800" style="height:100%;object-fit:cover">
        <% } else { %>
          <span class="produit-placeholder" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M24 42V20"/><path d="M24 26c0-7 5-13 12-14 1 8-4 15-12 14z"/><path d="M24 34c0-5-4-10-9-11-1 6 3 12 9 11z"/></svg></span>
        <% } %>
        <% if (!item.in_stock) { %><span class="badge"><%= t.out_of_stock %></span><% } %>
      </figure>

      <div>
        <hr class="hand-rule">
        <h1 style="font-size:clamp(1.9rem,3.6vw,2.7rem)" data-content-source="products:name" data-content-id="<%= item.id %>"><%= field(item, 'name') %></h1>
        <p class="row" style="gap:10px;align-items:baseline">
          <span style="font-family:var(--display);font-size:2rem"><%= money(item.price_cents) %></span>
          <span class="muted small" data-lk="t:before_tax"><%= t.before_tax %></span>
        </p>

        <% if (field(item, 'description')) { %>
          <div class="prose preserve" style="margin-top:8px" data-content-source="products:description" data-content-id="<%= item.id %>"><%= field(item, 'description') %></div>
        <% } %>

        <div class="form-card" style="margin-top:28px">
          <% if (item.in_stock) { %>
            <% if (options.length) { %>
              <label class="field" for="variant">
                <span><%= field(item, 'variant_label') || t.quantity %></span>
                <select id="variant" data-variant-select>
                  <option value=""><%= lang === 'en' ? 'Choose an option' : 'Sélectionner' %></option>
                  <% options.forEach(function (option) { %><option value="<%= option %>"><%= option %></option><% }); %>
                </select>
              </label>
            <% } %>
            <label class="field" for="qty">
              <span><%= t.quantity %></span>
              <select id="qty" data-qty-select>
                <% for (var i = 1; i <= 10; i++) { %><option value="<%= i %>"><%= i %></option><% } %>
              </select>
            </label>
            <button class="button primary block" type="button"
              data-add-to-cart
              data-slug="<%= item.slug %>"
              data-name="<%= field(item, 'name') %>"
              data-price="<%= item.price_cents %>"
              data-image="<%= item.image_url || '' %>"
              data-needs-variant="<%= options.length ? '1' : '0' %>">
              <%= t.add_to_cart %>
            </button>
            <p class="center" style="margin:14px 0 0"><a class="text-button" href="<%= urls.cart %>" data-lk="t:view_cart"><%= t.view_cart %></a></p>
          <% } else { %>
            <p class="notice notice--warn" style="margin:0"><span data-lk="t:out_of_stock"><%= t.out_of_stock %></span></p>
            <p class="small muted" style="margin-top:14px" data-lk="produit-restock">Écrivez-nous ou passez en boutique : nous vous dirons dès qu’il est de retour.</p>
          <% } %>
        </div>

        <ul class="tick-list small" style="margin-top:26px">
          <li data-lk="produit-perk-1"><%= t.pickup %> — <%= t.free.toLowerCase() %></li>
          <% if (flags.shipping && freeShippingThreshold > 0) { %>
            <li><%= t.free_shipping_note.replace('{threshold}', money(freeShippingThreshold)) %></li>
          <% } %>
          <li data-lk="produit-perk-3">Produits choisis avec intention, souvent d’ici.</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<% if (related && related.length) { %>
<section class="section section--paper">
  <div class="wrap">
    <div class="section-head">
      <hr class="hand-rule">
      <h2 data-lk="produit-related">Vous aimerez aussi</h2>
    </div>
    <div class="grid grid--4">
      <% related.forEach(function (product) { %><%- include('partials/produit', { item: product }) %><% }); %>
    </div>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>
