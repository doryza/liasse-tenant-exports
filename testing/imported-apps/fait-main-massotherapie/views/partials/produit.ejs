<article class="produit">
  <a class="produit-media" href="<%= urls.product %><%= item.slug %>" aria-label="<%= field(item, 'name') %>">
    <% if (!item.in_stock) { %><span class="badge" data-lk="t:out_of_stock"><%= t.out_of_stock %></span><% } %>
    <% if (item.image_url) { %>
      <img src="<%= item.image_url %>" alt="<%= field(item, 'name') %>" width="600" height="600" loading="lazy">
    <% } else { %>
      <span class="produit-placeholder" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M24 42V20"/><path d="M24 26c0-7 5-13 12-14 1 8-4 15-12 14z"/><path d="M24 34c0-5-4-10-9-11-1 6 3 12 9 11z"/></svg></span>
    <% } %>
  </a>
  <div class="produit-body">
    <h3><a href="<%= urls.product %><%= item.slug %>" data-content-source="products:name" data-content-id="<%= item.id %>"><%= field(item, 'name') %></a></h3>
    <div class="produit-price"><%= money(item.price_cents) %><small data-lk="t:before_tax"><%= t.before_tax %></small></div>
    <div class="produit-actions">
      <% if (item.in_stock) { %>
        <button class="button primary small block" type="button"
          data-add-to-cart
          data-slug="<%= item.slug %>"
          data-name="<%= field(item, 'name') %>"
          data-price="<%= item.price_cents %>"
          data-image="<%= item.image_url || '' %>"
          data-needs-variant="<%= item.variants && item.variants !== '[]' ? '1' : '0' %>"
          data-href="<%= urls.product %><%= item.slug %>">
          <%= t.add_to_cart %>
        </button>
      <% } else { %>
        <span class="button ghost small block" aria-disabled="true"><%= t.out_of_stock %></span>
      <% } %>
    </div>
  </div>
</article>
