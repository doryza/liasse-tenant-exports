<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'fr' %>">
<head>
<meta charset="utf-8">
<base href="<%= tenantRoot %>">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#91AB78">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="description" content="<%= settings.hero_subtitle || t.request_explain %>">
<title><%= page === 'home' ? settings.business_name + ' · ' + t.request_explain : (t[page] || t.home) + ' · ' + settings.business_name %></title>
<link rel="manifest" href="manifest.json">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="public/css/styles.css">
</head>
<body data-page="<%= page %>">
<a class="skip" href="#main" data-lk="t:skip"><%= t.skip %></a>

<div class="utility">
  <div class="wrap">
    <div class="row" style="gap:18px">
      <% if (flags.contact && settings.contact_phone) { %>
        <a href="<%= phoneHref %>" data-setting-key="contact_phone"><%= settings.contact_phone %></a>
      <% } else { %>
        <span data-lk="t:contact_pending"><%= t.contact_pending %></span>
      <% } %>
      <% if (flags.address && settings.business_address) { %>
        <a href="<%= directionsHref %>" target="_blank" rel="noopener">Mirabel, QC</a>
      <% } %>
    </div>
    <div class="utility-right">
      <button class="text-button" type="button" data-login-btn data-lk="t:login"><%= t.login %></button>
      <a href="<%= urls.orders %>" data-auth-only hidden data-lk="t:my_orders"><%= t.my_orders %></a>
    </div>
  </div>
</div>

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="<%= urls.home %>" aria-label="<%= settings.business_name %>">
      <strong data-lk="brand-name">Fait Main</strong>
      <span data-lk="brand-sub">Massothérapie</span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label="<%= t.menu %>">
      <div class="nav-group <%= ['massotherapie','esthetique','ongles','corps','forfaits'].includes(page) ? 'is-active' : '' %>">
        <button type="button" aria-expanded="false" aria-controls="nav-soins">
          <span data-lk="nav-soins">Nos soins</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="nav-menu" id="nav-soins">
          <a href="<%= urls.massotherapie %>"><%= t.massotherapie %><small data-lk="nav-masso-sub">Détente, thérapeutique, spécialités</small></a>
          <a href="<%= urls.esthetique %>"><%= t.esthetique %><small data-lk="nav-esth-sub">Visage, cils, sourcils, épilation</small></a>
          <a href="<%= urls.ongles %>"><%= t.ongles %><small data-lk="nav-ongles-sub">Manucure, pédicure, pose</small></a>
          <a href="<%= urls.corps %>"><%= t.corps %><small data-lk="nav-corps-sub">Madérothérapie, enveloppements</small></a>
          <a href="<%= urls.forfaits %>"><%= t.forfaits %><small data-lk="nav-forfaits-sub">Formules et cures</small></a>
        </div>
      </div>
      <a href="<%= urls.boutique %>" aria-current="<%= ['boutique','product'].includes(page) ? 'page' : 'false' %>"><%= t.boutique %></a>
      <a href="<%= urls.location %>" aria-current="<%= page === 'location' ? 'page' : 'false' %>"><%= t.location %></a>
      <a href="<%= urls.about %>" aria-current="<%= page === 'about' ? 'page' : 'false' %>"><%= t.about %></a>
      <a href="<%= urls.blog %>" aria-current="<%= ['blog','article'].includes(page) ? 'page' : 'false' %>"><%= t.blog %></a>
      <a href="<%= urls.contact %>" aria-current="<%= page === 'contact' ? 'page' : 'false' %>"><%= t.contact %></a>
      <div class="lang" style="margin-left:6px">
        <a href="<%= langLinks.fr %>" lang="fr" aria-current="<%= lang === 'fr' ? 'true' : 'false' %>" data-lk="nav-fr">FR</a>
        <span aria-hidden="true">·</span>
        <a href="<%= langLinks.en %>" lang="en" aria-current="<%= lang === 'en' ? 'true' : 'false' %>" data-lk="nav-en">EN</a>
      </div>
      <a class="button primary small" style="margin-left:6px" href="<%= bookingUrl || urls.reservation %>"<%= bookingUrl ? ' target="_blank" rel="noopener"' : '' %> data-lk="t:book_short"><%= t.book_short %></a>
    </nav>

    <div class="header-actions">
      <a class="cart-link" href="<%= urls.cart %>" aria-label="<%= t.cart %>">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2l1.5 4h13L19 15H8L6 2H3"/><circle cx="9.5" cy="20" r="1.4"/><circle cx="17.5" cy="20" r="1.4"/></svg>
        <span class="cart-count" data-cart-count hidden>0</span>
      </a>
      <button class="menu-toggle" type="button" aria-label="<%= t.menu %>" aria-controls="site-nav" aria-expanded="false" data-menu-toggle>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>
</header>
<div class="nav-backdrop" data-nav-backdrop></div>

<main id="main">
