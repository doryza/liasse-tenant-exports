<%- include('partials/header') %>

<section class="page-banner">
  <div class="wrap">
    <div class="page-banner-inner">
      <nav class="breadcrumb" aria-label="fil d’Ariane"><a href="<%= urls.home %>"><%= t.home %></a> · <%= t.location %></nav>
      <hr class="hand-rule">
      <h1 data-lk="location-title">Les réunions et ateliers, façon Fait Main</h1>
      <p data-setting-key="location_intro"><%= settings.location_intro %></p>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap split split--top">
    <div>
      <p data-setting-key="location_text"><%= settings.location_text %></p>
      <h2 style="margin-top:34px;font-size:1.5rem" data-lk="location-perks-title">Ce que vous offre notre espace</h2>
      <ul class="tick-list">
        <% lines(settings.location_perks).forEach(function (line) { %>
          <li><%= line %></li>
        <% }); %>
      </ul>
      <div class="notice notice--info" style="margin-top:28px">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1"/></svg>
        <p data-lk="location-quote">Les tarifs et les disponibilités sont établis avec vous selon la durée et le format. Contactez-nous pour plus d’information.</p>
      </div>
      <div class="row" style="margin-top:26px">
        <a class="button primary" href="<%= urls.contact %>" data-lk="location-cta">Demander une information</a>
        <% if (flags.contact && settings.contact_phone) { %><a class="button ghost" href="<%= phoneHref %>"><%= settings.contact_phone %></a><% } %>
      </div>
    </div>

    <figure class="portrait portrait--tall">
      <img src="<%= settings._p_location_image_url %>" data-setting-key="_p_location_image_url" alt="La salle de réunion et d’atelier de Fait Main Massothérapie" width="450" height="602" loading="lazy">
    </figure>
  </div>
</section>

<section class="section section--sage section--tight">
  <div class="wrap center">
    <h2 style="margin-bottom:8px" data-lk="location-outro">Se réunir n’aura jamais été aussi plaisant.</h2>
    <hr class="hand-rule hand-rule--center" style="margin-top:18px">
  </div>
</section>

<%- include('partials/footer') %>
