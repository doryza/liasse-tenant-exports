<%- include('partials/header') %>

<section class="section">
  <div class="wrap">
    <nav class="breadcrumb" aria-label="fil d’Ariane" style="margin-bottom:22px"><a href="<%= urls.home %>"><%= t.home %></a> · <%= t.privacy %></nav>
    <hr class="hand-rule">
    <h1><%= t.privacy %></h1>

    <div class="prose">
      <% if (flags.privacy && settings.privacy_notice) { %>
        <div class="preserve" data-setting-key="privacy_notice"><%= settings.privacy_notice %></div>
      <% } else { %>
        <div class="notice notice--plain">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1"/></svg>
          <p data-lk="privacy-pending">L’avis de confidentialité est en cours de révision par la propriétaire. Pour toute question sur vos renseignements, communiquez directement avec nous.</p>
        </div>
      <% } %>

      <% if (settings.payment_terms) { %>
        <h2 data-lk="privacy-terms">Conditions de vente</h2>
        <div class="preserve" data-setting-key="payment_terms"><%= settings.payment_terms %></div>
      <% } %>
    </div>

    <p style="margin-top:34px"><a class="button secondary" href="<%= urls.contact %>" data-lk="t:contact"><%= t.contact %></a></p>
  </div>
</section>

<%- include('partials/footer') %>
