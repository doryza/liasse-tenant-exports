<%- include('partials/header') %>
<%
var COLLECTION_META = {
  ralentir:    { emoji: '🌙', fr: 'Besoin de ralentir',            en: 'Time to slow down',        subFr: 'Pour relâcher les tensions et ralentir en fin de journée.', subEn: 'To release tension and wind down at the end of the day.', img: '_p_collection_ralentir_url' },
  offrir:      { emoji: '🎁', fr: 'Offrir un moment qui fait du bien', en: 'Give a moment that helps', subFr: 'Des attentions qui font du bien et qui touchent vraiment.',  subEn: 'Thoughtful gifts that genuinely land.',                   img: '_p_collection_offrir_url' },
  'me-choisir':{ emoji: '🤍', fr: 'Me choisir aujourd’hui',        en: 'Choose myself today',      subFr: 'Pour s’offrir un moment juste pour soi, sans raison.',      subEn: 'A moment just for you, for no reason at all.',            img: '_p_collection_me_choisir_url' },
  rituel:      { emoji: '🛁', fr: 'Créer mon rituel à la maison',   en: 'Build my ritual at home',  subFr: 'Prolongez les bienfaits de vos soins chez vous.',           subEn: 'Carry the benefits of your treatments home with you.',    img: '_p_collection_rituel_url' }
};
var activeMeta = collection ? COLLECTION_META[collection] : null;
%>

<section class="page-banner">
  <div class="wrap">
    <div class="page-banner-inner">
      <nav class="breadcrumb" aria-label="fil d’Ariane">
        <a href="<%= urls.home %>"><%= t.home %></a> · <% if (collection) { %><a href="<%= urls.boutique %>"><%= t.boutique %></a> · <%= lang === 'en' ? activeMeta.en : activeMeta.fr %><% } else { %><%= t.boutique %><% } %>
      </nav>
      <hr class="hand-rule">
      <h1><% if (activeMeta) { %><%= activeMeta.emoji %> <%= lang === 'en' ? activeMeta.en : activeMeta.fr %><% } else { %><%= settings.boutique_intro %><% } %></h1>
      <p><% if (activeMeta) { %><%= lang === 'en' ? activeMeta.subEn : activeMeta.subFr %><% } else { %><%= settings.boutique_text %><% } %></p>
      <% if (freeShippingThreshold > 0 && flags.shipping) { %>
        <p class="small" style="color:var(--sage-deep);font-weight:600">
          <%= t.free_shipping_note.replace('{threshold}', money(freeShippingThreshold)) %>
        </p>
      <% } %>
    </div>
  </div>
</section>

<% if (!collection && !q) { %>
<section class="section section--tight">
  <div class="wrap">
    <div class="grid grid--4">
      <% collections.forEach(function (key) { var m = COLLECTION_META[key]; if (!m) return; %>
        <a class="collection" href="<%= urls.boutique %>?collection=<%= key %>">
          <span class="collection-media">
            <% if (settings[m.img]) { %><img src="<%= settings[m.img] %>" data-setting-key="<%= m.img %>" alt="" width="640" height="480" loading="lazy"><% } %>
          </span>
          <span class="collection-label">
            <strong><%= m.emoji %> <%= lang === 'en' ? m.en : m.fr %></strong>
            <span><%= lang === 'en' ? m.subEn : m.subFr %></span>
          </span>
        </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<% if (featured && featured.length) { %>
<section class="section section--tight">
  <div class="wrap">
    <div class="section-head">
      <hr class="hand-rule">
      <h2 data-lk="t:featured"><%= t.featured %></h2>
      <p data-lk="boutique-featured-sub">Nos produits les plus aimés, testés et approuvés pour créer un vrai moment de bien-être.</p>
    </div>
    <div class="grid grid--4">
      <% featured.forEach(function (item) { %><%- include('partials/produit', { item: item }) %><% }); %>
    </div>
  </div>
</section>
<% } %>

<section class="section<%= featured && featured.length ? ' section--paper' : '' %>">
  <div class="wrap">
    <div class="section-head">
      <hr class="hand-rule">
      <h2><% if (activeMeta) { %><%= lang === 'en' ? activeMeta.en : activeMeta.fr %><% } else { %><%= t.all_products %><% } %></h2>
    </div>

    <form class="row" method="get" action="<%= urls.boutique %>" style="margin-bottom:24px;gap:10px">
      <label class="sr-only" for="shop-q"><%= t.boutique %></label>
      <input id="shop-q" type="search" name="q" value="<%= q %>" placeholder="<%= lang === 'en' ? 'Search the shop' : 'Rechercher un produit' %>" style="max-width:320px">
      <% if (collection) { %><input type="hidden" name="collection" value="<%= collection %>"><% } %>
      <button class="button secondary" type="submit"><%= lang === 'en' ? 'Search' : 'Rechercher' %></button>
      <% if (q || collection) { %><a class="text-button" href="<%= urls.boutique %>"><%= lang === 'en' ? 'Clear' : 'Réinitialiser' %></a><% } %>
    </form>

    <div class="chips">
      <a class="chip" href="<%= urls.boutique %>" aria-current="<%= collection ? 'false' : 'true' %>"><%= t.all_products %></a>
      <% collections.forEach(function (key) { var m = COLLECTION_META[key]; if (!m) return; %>
        <a class="chip" href="<%= urls.boutique %>?collection=<%= key %>" aria-current="<%= collection === key ? 'true' : 'false' %>"><%= m.emoji %> <%= lang === 'en' ? m.en : m.fr %></a>
      <% }); %>
    </div>

    <% if (!items.length) { %>
      <p class="empty" data-lk="t:no_products"><%= t.no_products %></p>
    <% } else { %>
      <div class="grid grid--4">
        <% items.forEach(function (item) { %><%- include('partials/produit', { item: item }) %><% }); %>
      </div>
    <% } %>
  </div>
</section>

<section class="section section--tight">
  <div class="wrap">
    <div class="notice notice--info">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2l1.5 4h13L19 15H8L6 2H3"/></svg>
      <p>
        <strong data-lk="boutique-pickup-title">Cueillette en boutique offerte.</strong>
        <span data-lk="boutique-pickup-sub">Ramassez votre commande au comptoir pendant nos heures d’ouverture — c’est toujours gratuit.</span>
        <% if (!flags.shipping) { %>
          <span data-lk="boutique-shipping-pending"> La livraison postale sera activée sous peu.</span>
        <% } %>
      </p>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
