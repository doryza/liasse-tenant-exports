<%- include('partials/header') %>
<main id="main">
<section class="cinema" aria-label="<%= lang === 'fr' ? 'Bienvenue' : 'Welcome' %>" aria-roledescription="carousel" data-carousel>
<div class="cinema-photos"><% ['bn11.jpg','bc5-1-1024x819.jpg','bn22.jpg'].forEach((name,i)=>{ %><img class="cinema-photo <%= i===0?'active':'' %>" src="<%= visuals.images[name] %>" alt="<%= [lang==='fr'?'Pizza au four à bois':'Wood-fired pizza',t.breakfast,lang==='fr'?'Fruits de mer':'Seafood'][i] %>" <%- i===0?'fetchpriority="high"':'loading="lazy"' %> data-slide="<%= i %>" aria-hidden="<%= i!==0 %>"><% }); %></div>
<div class="wrap cinema-content"><p class="eyebrow">BROSSARD · EST. 1999</p><h1><%= lang==='fr'?'Du premier café':'From the first coffee' %><br><em><%= lang==='fr'?'au feu de bois.':'to the wood fire.' %></em></h1><p class="cinema-lead"><%= lang==='fr'?'Le Breakfast Club le matin. Piazza Pazza à table. Deux façons de savourer le moment.':'Le Breakfast Club in the morning. Piazza Pazza at the table. Two ways to savour the moment.' %></p><div class="hero-actions"><a class="btn btn-fire order-primary" href="<%= orderUrl %>"><%= t.footer_order %> <span aria-hidden="true">↗</span></a><a class="hero-link" href="<%= menuHref %>"><%= lang==='fr'?'Découvrir nos menus':'Explore our menus' %> <span>→</span></a></div></div>
<div class="wrap cinema-bottom"><span class="cinema-caption" aria-live="polite"><%= lang==='fr'?'01 / Le four à bois':'01 / The wood-fired oven' %></span><div class="cinema-controls"><button type="button" data-prev aria-label="<%= t.previous %>">←</button><% for(let i=0;i<3;i++){ %><button type="button" data-dot="<%= i %>" aria-label="<%= lang==='fr'?'Image':'Image' %> <%= i+1 %>" aria-pressed="<%= i===0 %>"><span></span></button><% } %><button type="button" data-next aria-label="<%= t.next %>">→</button><button type="button" data-pause aria-label="<%= t.pause %>" data-play-label="<%= t.play %>" data-pause-label="<%= t.pause %>">Ⅱ</button></div><a class="scroll-note" href="<%= homeHref %>#experience"><%= lang==='fr'?'Prenez place':'Take a seat' %> ↓</a></div>
</section>
<%- include('partials/welcome-gift') %>
<section class="experience wrap" id="experience"><div class="section-top"><p class="eyebrow"><%= lang==='fr'?'LE PLAISIR DE SE RETROUVER':'THE PLEASURE OF COMING TOGETHER' %></p><h2><%= lang==='fr'?'À chaque moment,':'Every moment has' %><br><em><%= lang==='fr'?'sa gourmandise.':'its flavour.' %></em></h2><p><%= lang==='fr'?'Un déjeuner qui se prolonge. Une pizza qui sort du four. Des assiettes à découvrir, au rythme de votre journée.':'A breakfast worth lingering over. A pizza fresh from the oven. Something to savour, whatever the time of day.' %></p></div><div class="worlds">
<a class="world-card" href="<%= menuHref %>#breakfast"><img src="<%= visuals.images['bc10-1-819x1024.jpg'] %>" alt="<%= lang==='fr'?'Pain doré aux fruits frais':'French toast with fresh fruit' %>" loading="lazy"><div><span class="eyebrow">01 / LE BREAKFAST CLUB</span><h3><%= lang==='fr'?'Les matins ont du goût.':'Make mornings delicious.' %></h3><p><%= lang==='fr'?'Bénédictines, omelettes, crêpes et douceurs fruitées.':'Eggs Benedict, omelettes, crêpes and fruity favourites.' %></p><span class="text-link"><%= t.breakfast %> ↗</span></div></a>
<a class="world-card" href="<%= menuHref %>#dinner"><img src="<%= visuals.images['bc14-1-1024x819.jpg'] %>" alt="<%= lang==='fr'?'Pizza garnie de roquette':'Pizza topped with arugula' %>" loading="lazy"><div><span class="eyebrow">02 / PIAZZA PAZZA</span><h3><%= lang==='fr'?'Le feu. La pâte. Le plaisir.':'Fire. Dough. Delight.' %></h3><p><%= lang==='fr'?'Pizzas au four à bois, pâtes, moules et fruits de mer.':'Wood-fired pizzas, pasta, mussels and seafood.' %></p><span class="text-link"><%= lang==='fr'?'Le menu Piazza Pazza':'The Piazza Pazza menu' %> ↗</span></div></a></div></section>
<section class="oven-story"><img src="<%= visuals.images['bn11.jpg'] %>" alt="<%= lang==='fr'?'Le four à bois de Piazza Pazza':'The Piazza Pazza wood-fired oven' %>" loading="lazy"><div><p class="eyebrow">FOUR À BOIS / WOOD-FIRED</p><h2><%= lang==='fr'?'Le cœur de':'The heart of' %><br><em>Piazza Pazza.</em></h2><p><%= lang==='fr'?'La chaleur du four, une pâte dorée, vos garnitures préférées. De la Margherita aux créations de la maison, la pizza a toute sa place à notre table.':'The warmth of the oven, a golden crust, your favourite toppings. From Margherita to house creations, pizza always has a place at our table.' %></p><a class="text-link" href="<%= menuHref %>#dinner"><%= t.nav_menu %> ↗</a></div></section>
<section class="gallery-preview wrap"><div class="section-heading"><div><p class="eyebrow"><%= t.nav_gallery %></p><h2><%= t.gallery_title %></h2></div><a class="text-link" href="<%= galleryHref %>"><%= lang==='fr'?'Explorer la galerie':'Explore the gallery' %> ↗</a></div><div class="preview-grid"><% [0,10,9,8].forEach(n=>{let g=visuals.gallery[n];%><a href="<%= galleryHref %>#photo-<%= n %>"><img src="<%= g.src %>" alt="<%= pick(g) %>" loading="lazy"><span><%= pick(g) %> ↗</span></a><%});%></div></section>
<section class="visit wrap" id="visit" aria-labelledby="visit-heading">
<div class="visit-title"><p class="eyebrow"><%= t.visit_label %></p><h2 id="visit-heading"><%= t.visit_title %></h2><div class="visit-actions"><a class="btn btn-fire order-primary" href="<%= orderUrl %>"><%= t.footer_order %> <span aria-hidden="true">↗</span></a><a class="btn btn-outline-light" href="<%= mapsUrl %>" target="_blank" rel="noopener"><%= t.visit_directions %> ↗</a></div></div>
<div class="visit-details"><div class="visit-address"><h3><%= t.visit_address %></h3><address><% addressLines.forEach(l=>{%><span><%= l %></span><%});%></address><a class="contact-phone" href="<%= telHref %>"><%= phone %></a></div><div class="visit-hours"><h3><%= t.visit_hours %></h3><dl class="hours-list"><% hoursLines.forEach(l=>{const parts=l.split(' · ');%><div><dt><%= parts[0] %></dt><dd><%= parts.slice(1).join(' · ') %></dd></div><%});%></dl><p class="service-note"><%= lang==='fr'?'Déjeuner jusqu’à 16 h. Menu Piazza Pazza dès 11 h 30, du mardi au samedi.':'Breakfast until 4 p.m. Piazza Pazza menu from 11:30 a.m., Tuesday–Saturday.' %></p></div></div></section>
<section class="final-band"><p class="eyebrow">LE BREAKFAST CLUB · PIAZZA PAZZA</p><h2><%= lang==='fr'?'Votre table vous attend.':'Your table is waiting.' %></h2><a class="btn btn-fire order-primary" href="<%= orderUrl %>"><%= t.footer_order %> ↗</a></section>
</main><%- include('partials/footer') %>