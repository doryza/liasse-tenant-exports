<%- include('partials/header') %>
<main id="main"><section class="menu-head"><div class="wrap"><p class="eyebrow" data-lk="t:menu_label"><%= t.menu_label %></p><h1 data-lk="t:menu_title"><%= t.menu_title %></h1><p class="lead" data-lk="t:menu_lead"><%= t.menu_lead %></p><div class="meal-tabs"><a href="<%= menuHref %>#breakfast"><%= t.breakfast %> ↓</a><a href="<%= menuHref %>#dinner"><%= t.dinner %> ↓</a></div><p class="meal-hours"><%= lang==='fr'?'Déjeuner : jusqu’à 16 h, du mardi au dimanche. Piazza Pazza : dès 11 h 30, du mardi au samedi.':'Breakfast: until 4 p.m., Tuesday–Sunday. Piazza Pazza: from 11:30 a.m., Tuesday–Saturday.' %></p></div></section>
<%- include('partials/welcome-gift') %>
<div class="wrap menu-layout"><aside class="menu-sidebar"><label class="menu-search" for="menuSearch"><span><%= t.menu_search %></span><input id="menuSearch" type="search" placeholder="<%= t.menu_search_hint %>" autocomplete="off"></label><nav class="category-nav" aria-label="<%= t.menu_jump %>"><% menu.categories.forEach(function(c){ %><a href="<%= menuHref %>#<%= c.slug %>"><span><%= pick(c.label) %></span><small><%= c.items.length %></small></a><% }) %></nav></aside>
<div class="menu-content"><p class="menu-notice"><%= t.menu_prices %></p><p id="noResults" class="no-results" hidden role="status"><%= t.menu_empty %></p>
<% menu.categories.forEach(function(c,ci){ %><% if(ci===0||c.label.en==='Appetizers'){ %><span class="meal-anchor" id="<%= ci===0?'breakfast':'dinner' %>"></span><% } %><section class="menu-category" id="<%= c.slug %>" aria-labelledby="heading-<%= c.slug %>"><div class="category-heading"><h2 id="heading-<%= c.slug %>"><%= pick(c.label) %></h2><span><%= c.items.length %></span></div><ul class="dish-list">
<% c.items.forEach(function(it){ %><li class="dish" id="dish-<%= it.id %>" data-search="<%= pick(it.name) + ' ' + other(it.name) + ' ' + pick(c.label) %>"><div class="dish-main"><% if(it.thumb){ %><img src="<%= it.thumb %>" alt="<%= pick(it.name) %>" width="300" height="300" loading="lazy"><% } %><div class="dish-copy"><div class="dish-title"><h3><%= pick(it.name) %></h3><span class="dish-price"><% if(it.from){ %><small><%= t.menu_from %></small><% } %><%= price(it.price) %></span></div><% if(pick(it.description)){ %><p class="dish-desc"><%= pick(it.description) %></p><% } %></div></div>
<% if(it.groups.length){ %><details class="dish-options"><summary><%= t.menu_options %> <span aria-hidden="true">+</span></summary><div class="options-content"><% it.groups.forEach(function(g){ %><section class="option-group"><div class="option-title"><h4><%= pick(g.name) %></h4><span><% if(g.fixed){ %><%= t.menu_included %><% } else { %><%= g.required ? t.menu_required : t.menu_optional %> · <%= t.menu_select %> <%= g.min === g.max ? g.min : (g.min ? g.min+'–'+g.max : t.menu_upto+' '+g.max) %><% } %></span></div><% if(g.allowQuantity){ %><p class="option-quantity"><%= t.menu_quantity %> · <%= g.choiceMaxQuantity %> <%= t.menu_perchoice %></p><% } %><ul><% g.choices.forEach(function(ch){ %><li><span><%= pick(ch.name) %></span><span><%= ch.price ? (ch.price > 0 ? '+' : '') + price(ch.price) : t.menu_noextra %></span></li><% }) %></ul></section><% }) %><a class="btn btn-dark" href="<%= orderUrl %>"><%= t.menu_item_order %></a></div></details><% } %>
</li><% }) %></ul></section><% }) %></div></div>
</main><%- include('partials/footer') %>
