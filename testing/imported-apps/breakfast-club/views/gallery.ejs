<%- include('partials/header') %><main id="main"><section class="gallery-head wrap"><p class="eyebrow">LE BREAKFAST CLUB · PIAZZA PAZZA</p><h1><%= t.gallery_title %></h1><p class="lead"><%= t.gallery_lead %></p><div class="gallery-filters" aria-label="<%= t.nav_gallery %>"><% [['all',t.gallery_all],['breakfast',t.breakfast],['table',t.dinner],['space',t.ambience]].forEach(([key,label])=>{%><button type="button" data-filter="<%= key %>" aria-pressed="<%= key==='all' %>"><%= label %></button><%});%></div></section><div class="gallery-grid wrap"><% visuals.gallery.forEach((g,i)=>{%><button class="gallery-tile" type="button" id="photo-<%= i %>" data-photo="<%= i %>" data-group="<%= g.group %>" aria-label="<%= pick(g) %> — <%= lang==='fr'?'Agrandir':'Enlarge' %>"><img src="<%= g.src %>" alt="<%= pick(g) %>" width="<%= g.width %>" height="<%= g.height %>" loading="lazy"><span><%= pick(g) %><b aria-hidden="true">↗</b></span></button><%});%></div><dialog class="lightbox" aria-label="<%= t.nav_gallery %>"><button type="button" class="lightbox-close" aria-label="<%= t.close %>">×</button><button type="button" class="lightbox-prev" aria-label="<%= t.previous %>">←</button><figure><img alt=""><figcaption></figcaption></figure><button type="button" class="lightbox-next" aria-label="<%= t.next %>">→</button><span class="lightbox-count" aria-live="polite"></span></dialog></main><%- include('partials/footer') %>