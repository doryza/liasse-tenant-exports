<%- include('partials/header') %>
<section class="page-header">
  <div class="container">
    <h1><%= t.about_title %></h1>
    <p><%= t.about_subtitle %></p>
  </div>
</section>
<section class="container about-page">
  <div class="about-grid">
    <div>
      <img src="<%= (settings && settings.about_image_url) ? settings.about_image_url : 'https://placehold.co/800x600/6366f1/fff/png?text=Andre+Auger' %>" alt="" class="about-img">
    </div>
    <div class="prose">
      <%- (settings && settings['about_text_' + lang]) ? settings['about_text_' + lang] : (lang === 'en' ? '<p>André Auger Plomberie is a trusted plumbing service built on transparency, speed, and quality work.</p>' : '<p>André Auger Plomberie est un service de plomberie de confiance fondé sur la transparence, la rapidité et la qualité du travail.</p>') %>
    </div>
  </div>
  <h2 style="text-align:center;margin:3rem 0 1.5rem"><%= t.features_title %></h2>
  <div class="values-grid">
    <div class="value-card"><div style="font-size:2.5rem">💰</div><h3><%= t.feat1_title %></h3><p><%= t.feat1_desc %></p></div>
    <div class="value-card"><div style="font-size:2.5rem">📅</div><h3><%= t.feat2_title %></h3><p><%= t.feat2_desc %></p></div>
    <div class="value-card"><div style="font-size:2.5rem">✅</div><h3><%= t.feat3_title %></h3><p><%= t.feat3_desc %></p></div>
    <div class="value-card"><div style="font-size:2.5rem">🚨</div><h3><%= t.feat4_title %></h3><p><%= t.feat4_desc %></p></div>
  </div>
  <div style="text-align:center;margin-top:3rem">
    <a href="reservation" class="btn-primary btn-lg" style="background-color:#6366f1;color:#fff"><%= t.cta_book_now %></a>
  </div>
</section>
<%- include('partials/footer') %>
<script>try{if(window.TenantSDK)TenantSDK.ui.showInstallBanner();}catch(e){}</script>
