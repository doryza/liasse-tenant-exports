      "sampleRows": [
        {
          "key": "tagline",
          "value": "Réveille le chasseur en toi.",
          "updated_at": "2026-06-24T00:46:22.086Z"
        },
        {
          "key": "hero_subtitle",
          "value": "Suis le protocole d'ascension. Une routine hebdomadaire qui se régénère chaque semaine pour forger le chasseur en toi.",
          "updated_at": "2026-06-24T00:46:22.092Z"
        },
        {
          "key": "about_text",
          "value": "ASCENSION transforme ton entraînement en un protocole de montée en puissance inspiré des chasseurs. Chaque semaine, le Système te confie sept quêtes. Complète-les, gagne de l'expérience et grimpe les rangs, du rang E jusqu'au légendaire rang S.",
          "updated_at": "2026-06-24T00:46:22.098Z"
        },
        {
          "key": "business_name",
          "value": "ASCENSION",
          "updated_at": "2026-06-24T00:46:22.105Z"
