<%- include('partials/header') %>
<div class="wrap">
<section class="container section-sm" style="padding-top:2.5rem">
 <div class="eyebrow">[ Journal du Système ]</div>
 <h1 style="font-size:clamp(2rem,5vw,3rem);margin:.5rem 0">Annonces &amp; conseils</h1>
 <% if (cats && cats.length) { %>
 <div class="tag-row" style="display:flex;gap:.5rem;flex-wrap:wrap;margin-top:1rem">
   <a href="journal" class="chip <%= !activeCat ? 'chip-active' : '' %>">Tout</a>
   <% cats.forEach(function(c){ %><a href="?cat=<%= encodeURIComponent(c) %>" class="chip <%= activeCat===c ? 'chip-active' : '' %>"><%= c %></a><% }); %>
 </div>
 <% } %>
</section>
<section class="container" style="padding-bottom:4rem">
 <% if (posts && posts.length) { %>
 <div class="grid g3">
  <% posts.forEach(function(p){ %>
   <a href="journal/<%= p.id %>" class="day-card">
     <% if (p.image_url) { %><img class="day-thumb" src="<%= p.image_url %>" alt="<%= p.title %>"><% } %>
     <div class="day-body"><% if (p.category) { %><span class="chip"><%= p.category %></span><% } %><h3 style="font-size:1.1rem;margin:.6rem 0"><%= p.title %></h3><p class="muted" style="font-size:.9rem;flex:1"><%= (p.content || '').replace(/<[^>]*>/g,'').slice(0,110) %><%= (p.content || '').length > 110 ? '…' : '' %></p><span class="muted" style="font-size:.82rem;margin-top:.6rem"><%= formatDate(p.created_at) %></span></div>
   </a>
  <% }); %>
 </div>
 <% } else { %>
  <div class="swin" style="text-align:center"><p class="muted">Aucune annonce pour l'instant. Le Système est silencieux... pour le moment.</p></div>
 <% } %>
</section>
</div>
<%- include('partials/footer') %>
