<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ASCENSION — Exercices</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="public/css/admin-styles.css">
</head>
<body>
<div class="admin-layout">
<%- include('partials/admin-sidebar') %>
<main class="admin-main">
 <button class="admin-burger" onclick="document.querySelector('.admin-sidebar').classList.toggle('open')">Menu</button>
 <header class="admin-head"><div><h1 id="modTitle">Exercices</h1><p id="modDesc">Gère les exercices et leurs variations hebdomadaires. Utilise les filtres pour cibler un jour ou une variation.</p></div><button class="abtn abtn-primary" onclick="ADMIN.openCreate()">+ Nouvel exercice</button></header>
 <div class="list-controls" id="listControls"></div>
 <div class="table-wrap"><table class="atable"><thead id="thead"></thead><tbody id="tbody"></tbody></table></div>
 <div id="emptyState" class="empty-state" style="display:none">Aucun exercice. Clique sur « Nouvel exercice » pour commencer.</div>
</main>
</div>
<div class="modal-overlay" id="modal"><div class="modal"><div class="modal-head"><h2 id="modalTitle">Entrée</h2><button class="modal-x" onclick="ADMIN.closeModal()">✕</button></div><form id="modalForm" class="modal-body"></form><div class="modal-foot"><button class="abtn abtn-ghost" onclick="ADMIN.closeModal()">Annuler</button><button class="abtn abtn-primary" id="saveBtn" onclick="ADMIN.save()">Enregistrer</button></div></div></div>
<script>window.__ADMIN_MODULE='exercises';</script>
<script src="public/js/admin.js"></script>
</body>
</html>
