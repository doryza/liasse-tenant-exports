<%- include('partials/header') %>
<section class="section">
<div class="container">
<h1 class="section-title"><%= t.tem_title %></h1>
<p class="section-subtitle"><%= t.tem_intro %></p>
<% if (typeof posts !== 'undefined' && posts.length > 0) { %>
<div class="grid grid-3">
<% posts.forEach(function(p) { %>
<a href="temoignages/<%= p.id %>" class="card" style="text-decoration:none;color:inherit;display:block">
<% if (p.image_url) { %><img src="<%= p.image_url %>" alt="<%= p.title %>" class="card-img"><% } %>
<% if (p.category) { %><div class="card-meta"><span class="badge"><%= p.category %></span></div><% } %>
<h3><%= p.title %></h3>
<p><%= (p.content || '').substring(0, 150) %><%= (p.content || '').length > 150 ? '...' : '' %></p>
<div style="margin-top:1rem;display:flex;justify-content:space-between;align-items:center;color:#64748b;font-size:.85rem">
<span><%= t.tem_by %> <%= p.author || 'Anonyme' %></span>
<span><%= formatDate(p.created_at) %></span>
</div>
</a>
<% }); %>
</div>
<% } else { %>
<div class="empty-state"><div class="empty-state-icon">📖</div><p><%= t.empty_posts %></p></div>
<% } %>
</div>
</section>
<%- include('partials/footer') %>