<%- include('partials/header') %>
<section class="hero">
<img src="<%= (settings && settings._p_hero_image_url) ? settings._p_hero_image_url : 'https://placehold.co/1600x500/6366f1/ffffff/png?text=Soutien+AA' %>" alt="Hero">
<div class="hero-overlay">
<div class="hero-content">
<h1><%= (lang==='en' && settings['hero_title_en']) ? settings['hero_title_en'] : (settings['hero_title_fr'] || t.hero_title) %></h1>
<p><%= (lang==='en' && settings['hero_subtitle_en']) ? settings['hero_subtitle_en'] : (settings['hero_subtitle_fr'] || t.hero_subtitle) %></p>
<div class="hero-actions">
<a href="contact" class="btn btn-primary" style="background-color:#6366f1;color:#fff"><%= t.hero_cta_contact %></a>
<a href="ressources" class="btn btn-secondary" style="background:#fff;color:#6366f1"><%= t.hero_cta_help %></a>
</div>
</div>
</div>
</section>
<section class="section">
<div class="container">
<h2 class="section-title"><%= t.mission_title %></h2>
<p class="section-subtitle"><%= t.mission_text %></p>
<div class="grid grid-3">
<div class="card">
<div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
<h3><%= t.feat1_title %></h3>
<p><%= t.feat1_text %></p>
</div>
<div class="card">
<div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg></div>
<h3><%= t.feat2_title %></h3>
<p><%= t.feat2_text %></p>
</div>
<div class="card">
<div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
<h3><%= t.feat3_title %></h3>
<p><%= t.feat3_text %></p>
</div>
</div>
</div>
</section>
<section class="section" style="background:#fff">
<div class="container">
<h2 class="section-title"><%= t.tem_title %></h2>
<p class="section-subtitle"><%= t.tem_intro %></p>
<% if (typeof posts !== 'undefined' && posts.length > 0) { %>
<div class="grid grid-3">
<% posts.forEach(function(p) { %>
<a href="temoignages/<%= p.id %>" class="card" style="text-decoration:none;color:inherit;display:block">
<% if (p.image_url) { %><img src="<%= p.image_url %>" alt="<%= p.title %>" class="card-img"><% } %>
<% if (p.category) { %><div class="card-meta"><span class="badge"><%= p.category %></span></div><% } %>
<h3><%= p.title %></h3>
<p><%= (p.content || '').substring(0, 120) %><%= (p.content || '').length > 120 ? '...' : '' %></p>
<div style="margin-top:1rem;color:#64748b;font-size:.85rem"><%= t.tem_by %> <%= p.author || 'Anonyme' %></div>
</a>
<% }); %>
</div>
<div style="text-align:center;margin-top:2rem"><a href="temoignages" class="btn btn-secondary" style="background:#fff;color:#6366f1;border:2px solid #6366f1"><%= t.see_all %></a></div>
<% } else { %>
<div class="empty-state"><div class="empty-state-icon">📖</div><p><%= t.empty_posts %></p></div>
<% } %>
</div>
</section>
<!-- voice-module-v1 START -->
<section class="section" style="background:#eef2ff">
<div class="container">
<div class="cta-strip" style="background:linear-gradient(135deg,#6366f1,#818cf8);border-radius:1rem;padding:2.5rem 2rem;text-align:center">
<div style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.3rem 0.875rem;border-radius:9999px;font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:1rem;background:rgba(255,255,255,0.18);color:#fff;border:1px solid rgba(255,255,255,0.35)">
<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
<%= lang === 'en' ? 'AI Voice Assistant' : 'Assistant vocal IA' %>
</div>
<h2 style="color:#fff;margin:0 0 0.75rem 0"><%= lang === 'en' ? 'Talk to our voice assistant' : 'Parlez à notre assistant vocal' %></h2>
<p style="color:rgba(255,255,255,0.9);margin:0 0 1.5rem 0"><%= lang === 'en' ? 'Share your details by voice — quick, confidential, no commitment.' : 'Partagez vos coordonnées par la voix — rapide, confidentiel, sans engagement.' %></p>
<a href="voice-assistant" class="btn" style="background:#fff;color:#6366f1;font-weight:700;display:inline-flex;align-items:center;gap:0.5rem">
<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
<%= lang === 'en' ? 'Start a voice session' : 'Démarrer la voix' %>
</a>
</div>
</div>
</section>
<!-- voice-module-v1 END -->
<section class="section">
<div class="container">
<div class="cta-strip">
<h2><%= t.need_help %></h2>
<p><%= t.need_help_text %></p>
<a href="contact" class="btn" style="background:#fff;color:#6366f1"><%= t.hero_cta_contact %></a>
</div>
</div>
</section>
<section class="section" style="background:#fff">
<div class="container">
<h2 class="section-title"><%= t.res_title %></h2>
<p class="section-subtitle"><%= t.res_intro %></p>
<% if (typeof ressources !== 'undefined' && ressources.length > 0) { %>
<div class="grid grid-2">
<% ressources.forEach(function(r) { %>
<div class="list-card">
<div class="list-card-icon"><%= (r.title || '?').charAt(0).toUpperCase() %></div>
<div class="list-card-body">
<h3><%= r.title %></h3>
<p><%= r.description || '' %></p>
<div class="list-card-actions">
<% if (r.url) { %><a href="<%= r.url %>" target="_blank" rel="noopener"><%= t.res_visit %></a><% } %>
<% if (r.phone) { %><a href="tel:<%= r.phone %>"><%= r.phone %></a><% } %>
</div>
</div>
</div>
<% }); %>
</div>
<div style="text-align:center;margin-top:2rem"><a href="ressources" class="btn btn-secondary" style="background:#fff;color:#6366f1;border:2px solid #6366f1"><%= t.see_all %></a></div>
<% } else { %>
<div class="empty-state"><div class="empty-state-icon">🔗</div><p><%= t.empty_resources %></p></div>
<% } %>
</div>
</section>
<%- include('partials/footer') %>
