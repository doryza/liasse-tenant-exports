<% const serviceItems=typeof items!=='undefined'&&Array.isArray(items)?items:[];const localField=n=>typeof field==='function'?field(n):(lang==='en'?n+'_en':n);const localText=(r,n)=>typeof text==='function'?text(r,n):r[localField(n)]||''; %><%- include('partials/header') %><main class="wrap" id="main-content" tabindex="-1"><div class="intake-grid"><section class="hero"><h1 data-lk="t:hero_title"><%= t.hero_title %></h1><p class="lead" data-lk="<%= typeof slots!=='undefined'&&slots.length?'t:hero_now':'t:hero_wait' %>"><%= typeof slots!=='undefined'&&slots.length?t.hero_now:t.hero_wait %></p><p data-lk="t:intermediary"><%= t.intermediary %></p><a class="button" href=".#demande" style="background-color:#2858ef;color:#fff" data-lk="t:choose"><%= t.choose %><svg width="20" height="20" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" aria-hidden="true"><path d="M12 4v16m-6-6 6 6 6-6"/></svg></a></section><aside class="ticket-area"><details class="ticket" id="ticket" open><summary data-lk="t:ticket"><%= t.ticket %></summary><div class="ticket-body"><img class="pool-illustration" src="<%= settings._p_hero_image_url||'https://res.cloudinary.com/duhp69meg/image/upload/v1789440920/tapavis_tenant_services-piscine-express/build_services-piscine-express_ce24d60d-b20c-46cf-baff-4b600c7d172d.png' %>" data-setting-key="_p_hero_image_url" alt="<%= t.photo_guide %>" width="360" height="270"><h2 id="ticket-title" data-lk="t:ticket"><%= t.ticket %></h2><dl><dt data-lk="t:step_services"><%= t.step_services %></dt><dd id="ticket-services" data-lk="t:service_empty"><%= t.service_empty %></dd><dt data-lk="t:municipality"><%= t.municipality %></dt><dd id="ticket-place" data-lk="t:place_empty"><%= t.place_empty %></dd><dt data-lk="t:step_call"><%= t.step_call %></dt><dd id="ticket-slot" data-lk="t:slot_empty"><%= t.slot_empty %></dd></dl><div class="ticket-stub"><span data-lk="t:quebec"><%= t.quebec %></span><p data-lk="t:preferred"><%= t.preferred %></p><strong id="ticket-reference"></strong></div></div></details></aside><section class="request-panel" id="demande"><h2 data-lk="t:request_title"><%= t.request_title %></h2><ol class="steps" id="steps"><li aria-current="step"><button type="button" data-step="0"><span>1</span><span data-lk="t:step_services"><%= t.step_services %></span></button></li><li><button type="button" data-step="1"><span>2</span><span data-lk="t:step_call"><%= t.step_call %></span></button></li><li><button type="button" data-step="2"><span>3</span><span data-lk="t:step_contact"><%= t.step_contact %></span></button></li></ol><div class="notice" id="form-status" role="status" tabindex="-1" hidden></div><form id="lead-form" action="api/leads" method="post" novalidate><fieldset data-panel="0"><legend data-lk="t:need"><%= t.need %></legend><p data-lk="t:multiple"><%= t.multiple %></p><div class="service-options"><% if(serviceItems.length){serviceItems.forEach(function(s){ %><label class="service-option"><input type="checkbox" name="service_ids" value="<%= s.id %>" aria-describedby="error-service_ids"><span data-content-source="services:<%= localField('name') %>" data-content-id="<%= s.id %>"><%= localText(s,'name') %></span><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 7h16v9H4zM7 4v9m4-9v9M7 7h4M4 20c2-2 3 2 5 0s3 2 5 0 3 2 6 0"/></svg></label><% });}else{ %><p data-lk="t:empty_content"><%= t.empty_content %></p><% } %></div><p class="field-error" id="error-service_ids"></p><div class="field-grid"><label><span data-lk="t:municipality"><%= t.municipality %></span><input name="municipality" autocomplete="address-level2" maxlength="160" required aria-describedby="error-municipality"><small class="field-error" id="error-municipality"></small></label><label><span data-lk="t:postal"><%= t.postal %></span><input name="postal_code" autocomplete="postal-code" maxlength="7" required aria-describedby="error-postal_code"><small class="field-error" id="error-postal_code"></small></label></div><label><span data-lk="t:pool_type"><%= t.pool_type %></span><select name="pool_type"><% ['unknown','above','inground','other'].forEach(function(k){ %><option value="<%= k %>" data-lk="t:<%= k %>"><%= t[k] %></option><% }); %></select></label><div class="form-actions"><button class="button" type="button" data-next="1" style="background-color:#2858ef;color:#fff" data-lk="t:next"><%= t.next %></button></div></fieldset><fieldset data-panel="1" hidden><legend data-lk="t:call_title"><%= t.call_title %></legend><p data-lk="t:slots_note"><%= t.slots_note %></p><strong class="timezone" data-lk="t:quebec"><%= t.quebec %></strong><div id="slot-options" aria-describedby="error-slot_id"></div><p class="field-error" id="error-slot_id"></p><div class="form-actions"><button class="button secondary" type="button" data-prev="0" data-lk="t:back"><%= t.back %></button><button class="button" type="button" data-next="2" style="background-color:#2858ef;color:#fff" data-lk="t:next"><%= t.next %></button></div></fieldset><fieldset data-panel="2" hidden><legend data-lk="t:contact_title"><%= t.contact_title %></legend><% [{n:'name',k:'name',type:'text',auto:'name',required:true},{n:'phone',k:'phone',type:'tel',auto:'tel',required:true},{n:'email',k:'email',type:'email',auto:'email',required:false}].forEach(function(f){ %><label><span data-lk="t:<%= f.k %>"><%= t[f.k] %></span><input name="<%= f.n %>" type="<%= f.type %>" autocomplete="<%= f.auto %>" maxlength="<%= f.n==='email'?254:160 %>" <%= f.required?'required':'' %> aria-describedby="error-<%= f.n %>"><small class="field-error" id="error-<%= f.n %>"></small></label><% }); %><label><span data-lk="t:notes"><%= t.notes %></span><textarea name="notes" rows="3" maxlength="2500" aria-describedby="error-notes"></textarea><small class="field-error" id="error-notes"></small></label><section class="photos-section"><h3 data-lk="t:photo_title"><%= t.photo_title %></h3><div class="photo-intro"><img src="<%= settings._p_photo_guide_url||'https://res.cloudinary.com/duhp69meg/image/upload/v1789440918/tapavis_tenant_services-piscine-express/build_services-piscine-express_e0a7be8e-223a-4409-9b55-a00ac79079a1.png' %>" data-setting-key="_p_photo_guide_url" width="180" height="120" loading="lazy" alt="<%= t.photo_guide %>"><p data-lk="t:photo_help"><%= t.photo_help %></p></div><p class="small" data-lk="t:photo_private"><%= t.photo_private %></p><div class="photo-controls"><label class="button secondary file-control"><span data-lk="t:files"><%= t.files %></span><input type="file" id="photos-files" accept="image/jpeg,image/png,image/heic,image/heif,.heic,.heif" multiple></label><label class="button secondary file-control"><span data-lk="t:camera"><%= t.camera %></span><input type="file" id="photos-camera" accept="image/jpeg,image/png,image/heic,image/heif" capture="environment"></label></div><div id="photo-list" class="photo-list"></div><p class="field-error" id="error-photos"></p></section><label class="checkline"><input type="checkbox" name="consent" aria-describedby="error-consent"><span data-lk="t:consent"><%= t.consent %></span></label><p class="field-error" id="error-consent"></p><a href="confidentialite" target="_blank" rel="noopener" data-lk="t:privacy"><%= t.privacy %></a><div class="auth-note"><p data-lk="t:login_help"><%= t.login_help %></p><button type="button" class="button secondary" data-login-btn data-lk="t:login"><%= t.login %></button></div><div class="form-actions"><button type="button" class="button secondary" data-prev="1" data-lk="t:back"><%= t.back %></button><button class="button" type="submit" id="send-lead" style="background-color:#2858ef;color:#fff" data-lk="t:send"><%= t.send %></button></div></fieldset></form><section id="lead-confirmation" class="confirmation" tabindex="-1" hidden><h2 data-lk="t:sent"><%= t.sent %></h2><p data-lk="t:next_step"><%= t.next_step %></p><p id="confirmation-reference"></p><a class="button" href="demandes" style="background-color:#2858ef;color:#fff" data-lk="t:requests"><%= t.requests %></a><button type="button" class="button secondary" id="new-request" data-lk="t:new_request"><%= t.new_request %></button></section><noscript><p data-lk="t:network"><%= t.network %></p></noscript></section></div><section class="section" id="services"><h2 data-lk="t:services_title"><%= t.services_title %></h2><div class="services-grid"><% if(serviceItems.length){serviceItems.forEach(function(s){ %><article><img src="<%= s.image_url||settings._p_hero_image_url %>" data-content-source="services:image_url" data-content-id="<%= s.id %>" alt="<%= localText(s,'name') %>" width="320" height="240" loading="lazy"><h3 data-content-source="services:<%= localField('name') %>" data-content-id="<%= s.id %>"><%= localText(s,'name') %></h3><p data-content-source="services:<%= localField('description') %>" data-content-id="<%= s.id %>"><%= localText(s,'description') %></p><button type="button" class="text-button" data-select-service="<%= s.id %>" data-lk="t:select_service"><%= t.select_service %> →</button></article><% });}else{ %><p data-lk="t:empty_content"><%= t.empty_content %></p><% } %></div></section><section class="section process" id="fonctionnement"><h2 data-lk="t:how_title"><%= t.how_title %></h2><ol><% [1,2,3].forEach(function(n){ %><li><span class="process-number"><%= n %></span><div><h3 data-lk="t:how<%= n %>"><%= t['how'+n] %></h3><p data-lk="t:how<%= n %>_body"><%= t['how'+n+'_body'] %></p></div></li><% }); %></ol></section><section class="section faq"><h2 data-lk="t:faq_title"><%= t.faq_title %></h2><div><% if(typeof faqs!=='undefined'&&faqs.length){faqs.forEach(function(p){ %><details><summary data-content-source="posts:<%= localField('title') %>" data-content-id="<%= p.id %>"><%= localText(p,'title') %></summary><p data-content-source="posts:<%= localField('content') %>" data-content-id="<%= p.id %>"><%= localText(p,'content') %></p></details><% });}else{ %><p data-lk="t:empty_content"><%= t.empty_content %></p><% } %></div></section></main><script>window.INITIAL_SLOTS=<%- JSON.stringify(typeof slots!=='undefined'?slots:[]).replace(/</g,'\u003c') %>;</script><%- include('partials/footer') %>