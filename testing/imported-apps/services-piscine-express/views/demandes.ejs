<%- include('partials/header') %><main class="wrap account" id="main-content" tabindex="-1"><h1 data-lk="t:my_title"><%= t.my_title %></h1><p class="lead" data-lk="t:my_intro"><%= t.my_intro %></p><div id="account-login"><p data-lk="t:login_help"><%= t.login_help %></p><button class="button" type="button" data-login-btn style="background-color:#2858ef;color:#fff" data-lk="t:login"><%= t.login %></button></div><div id="account-status" class="notice" role="status" hidden></div><section id="account-results" aria-live="polite"></section><div id="account-pager" class="form-actions" hidden><button type="button" class="button secondary" id="account-prev" data-lk="t:previous"><%= t.previous %></button><span id="account-page"></span><button type="button" class="button secondary" id="account-next" data-lk="t:more"><%= t.more %></button></div><div class="form-actions"><a class="button" href=".#demande" style="background-color:#2858ef;color:#fff" data-lk="t:new_request"><%= t.new_request %></a><button type="button" class="button secondary" id="user-logout" data-auth-only style="display:none" data-lk="t:logout"><%= t.logout %></button></div></main><%- include('partials/footer') %>