<%- include('partials/header') %><main class="admin-main" id="main-content" tabindex="-1"><header class="admin-heading"><div><p class="eyebrow"><%= t.dashboard %></p><h1><%= t.overview %></h1><p><%= t.overview_help %></p></div><a class="button" href="admin/leads?filter=new" style="background-color:var(--admin-brand);color:#fff"><%= t.leads %> →</a></header><div class="admin-health"><span class="status-pill <%= settings.intake_enabled==='false'?'warning':'positive' %>"><%= settings.intake_enabled==='false'?t.intake_off:t.intake_on %></span><a href="admin/settings"><%= t.settings %> →</a></div><% if(typeof emailConfigured!=='undefined'&&!emailConfigured){ %><p class="admin-notice warning"><%= t.email_setup %></p><% } %><div class="stat-grid operational"><% if(typeof stats!=='undefined'){[['newLeads','pending_leads','leads?filter=new'],['liveSlots','live_slots','callback_slots?filter=eligible'],['newPartners','pending_partners','partners'],['activeServices','active_services','services']].forEach(function(p){ %><a class="stat" href="admin/<%= p[2] %>"><span><%= t[p[1]] %></span><strong><%= stats[p[0]]||0 %></strong><small><%= t.manage %> →</small></a><% });} %></div><% if(typeof stats!=='undefined'&&!stats.liveSlots){ %><div class="admin-notice"><p><%= t.slots_setup %></p><a class="button secondary" href="admin/callback_slots?create=1">+ <%= t.add %> · <%= t.slots %></a></div><% } %><section aria-labelledby="modules-heading"><div class="section-heading"><h2 id="modules-heading"><%= t.manage %></h2></div><div class="module-grid"><% if(typeof modules!=='undefined'&&modules.length){modules.forEach(function(m){ %><a href="admin/<%= m.key %>" class="module-card"><div class="module-top"><strong><%= m.label %></strong><span class="module-count"><%= typeof stats!=='undefined'&&stats.counts?stats.counts[m.key]||0:0 %></span></div><p><%= m.description %></p><span class="module-link"><%= t.manage %> →</span></a><% });}else{ %><p><%= t.no_records %></p><% } %></div></section><section><div class="section-heading"><h2><%= t.recent %></h2><a href="admin/leads"><%= t.all %> →</a></div><div class="table-scroll"><table><thead><tr><th scope="col"><%= t.reference %></th><th scope="col"><%= t.name %></th><th scope="col"><%= t.municipality %></th><th scope="col"><%= t.status %></th><th scope="col"><%= t.actions %></th></tr></thead><tbody><% if(typeof recent!=='undefined'&&recent.length){recent.forEach(function(r){ %><tr><td><a href="admin/leads?edit=<%= r.id %>"><%= r.reference %></a></td><td><%= r.name %></td><td><%= r.municipality %></td><td><span class="status-pill"><%= t[r.status]||r.status %></span></td><td><a class="table-action" href="admin/leads?edit=<%= r.id %>"><%= t.edit %></a></td></tr><% });}else{ %><tr><td colspan="5" class="empty-cell"><strong><%= t.no_records %></strong><p><%= t.empty_help %></p><a href="admin/leads?create=1">+ <%= t.add %></a></td></tr><% } %></tbody></table></div></section><div class="stat-grid secondary-stats"><% if(typeof stats!=='undefined'){[['totalVisits','total_visits'],['recentVisits','recent_visits'],['userCount','users'],['pushSubscriberCount','push_count']].forEach(function(p){ %><article class="stat"><strong><%= stats[p[0]]||0 %></strong><span><%= t[p[1]] %></span></article><% });} %></div><p class="muted"><%= t.retention %></p></main><%- include('partials/footer') %>