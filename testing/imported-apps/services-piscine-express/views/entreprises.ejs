<%- include('partials/header') %><main class="wrap partner-layout" id="main-content" tabindex="-1"><section><h1 data-lk="t:company_title"><%= t.company_title %></h1><p class="lead" data-lk="t:company_intro"><%= t.company_intro %></p><a href="." data-lk="t:owners"><%= t.owners %></a></section><section class="plain-panel"><div id="partner-status" class="notice" role="status" tabindex="-1" hidden></div><form id="partner-form" action="api/partners" method="post" novalidate><% [{n:'company',k:'company',type:'text'},{n:'contact_name',k:'contact_name',type:'text'},{n:'phone',k:'phone',type:'tel'},{n:'email',k:'work_email',type:'email'}].forEach(function(f){ %><label><span data-lk="t:<%= f.k %>"><%= t[f.k] %></span><input name="<%= f.n %>" type="<%= f.type %>" required maxlength="254" aria-describedby="error-<%= f.n %>"><small class="field-error" id="error-<%= f.n %>"></small></label><% }); %><label><span data-lk="t:areas"><%= t.areas %></span><textarea name="municipalities" required maxlength="2500" aria-describedby="error-municipalities"></textarea><small class="field-error" id="error-municipalities"></small></label><fieldset><legend data-lk="t:offered"><%= t.offered %></legend><% if(typeof items!=='undefined'&&items.length){items.forEach(function(s){ %><label class="checkline"><input type="checkbox" name="service_ids" value="<%= s.id %>" aria-describedby="error-service_ids"><span data-content-source="services:<%= lang==='en'?'name_en':'name' %>" data-content-id="<%= s.id %>"><%= s[lang==='en'?'name_en':'name'] %></span></label><% });}else{ %><p data-lk="t:empty_content"><%= t.empty_content %></p><% } %><p class="field-error" id="error-service_ids"></p></fieldset><label><span data-lk="t:website"><%= t.website %></span><input name="website" type="url" placeholder="https://" maxlength="500" aria-describedby="error-website"><small class="field-error" id="error-website"></small></label><label><span data-lk="t:message"><%= t.message %></span><textarea name="message" maxlength="2500" aria-describedby="error-message"></textarea><small class="field-error" id="error-message"></small></label><label class="checkline"><input name="consent" type="checkbox" aria-describedby="error-consent"><span data-lk="t:partner_consent"><%= t.partner_consent %></span></label><p class="field-error" id="error-consent"></p><a href="confidentialite" target="_blank" rel="noopener" data-lk="t:privacy"><%= t.privacy %></a><p data-lk="t:partner_login"><%= t.partner_login %></p><button type="button" data-login-btn class="button secondary" data-lk="t:login"><%= t.login %></button><button type="submit" class="button" style="background-color:#2858ef;color:#fff" data-lk="t:partner_send"><%= t.partner_send %></button></form><section id="partner-confirmation" hidden tabindex="-1"><h2 data-lk="t:partner_sent"><%= t.partner_sent %></h2><p data-lk="t:partner_next"><%= t.partner_next %></p><a class="button" href="demandes" style="background-color:#2858ef;color:#fff" data-lk="t:requests"><%= t.requests %></a></section></section></main><%- include('partials/footer') %>