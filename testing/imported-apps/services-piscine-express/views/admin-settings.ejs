<%- include('partials/header') %><main class="admin-main" id="main-content" tabindex="-1"><nav class="breadcrumbs" aria-label="<%= t.menu %>"><a href="admin"><%= t.dashboard %></a><span aria-hidden="true">/</span><span><%= t.settings %></span></nav><header class="admin-heading"><div><h1><%= t.settings %></h1><p><%= t.settings_help %></p></div></header><div id="settings-status" class="admin-notice" role="status" tabindex="-1" hidden></div><section class="settings-card"><h2><%= t.basic_settings %></h2><form id="business-settings-form" action="api/admin/settings" method="post"><label class="toggle-panel"><input type="checkbox" name="intake_enabled" <%= settings.intake_enabled==='false'?'':'checked' %>><span><strong><%= t.intake_label %></strong><small><%= t.intake_help %></small></span></label><div class="admin-fields-grid"><% [['business_name','business_name_label','text'],['contact_email','contact_email_label','email'],['contact_phone','contact_phone_label','tel'],['business_address','address_label','text']].forEach(function(f){ %><label><span><%= t[f[1]] %><%= f[0]==='business_name'?' *':'' %></span><input name="<%= f[0] %>" type="<%= f[2] %>" value="<%= settings[f[0]]||'' %>" maxlength="500" <%= f[0]==='business_name'?'required':'' %>></label><% }); %></div><button type="submit" class="button" style="background-color:var(--admin-brand);color:#fff"><%= t.save %></button></form></section><details class="settings-card" id="advanced-settings"><summary><%= t.advanced_settings %></summary><p><%= t.advanced_help %></p><form id="settings-form" action="api/admin/settings" method="post"><label><span><%= t.key %></span><input id="setting-key" name="key" list="setting-keys" required pattern="[a-zA-Z0-9_:-]{1,100}" placeholder="<%= t.choose_setting %>"><datalist id="setting-keys"></datalist></label><label><span><%= t.value %></span><textarea id="setting-value" name="value" rows="5"></textarea></label><div id="setting-image-tools"></div><button class="button" type="submit" style="background-color:var(--admin-brand);color:#fff"><%= t.save %></button></form><label class="settings-search"><span><%= t.search %></span><input id="settings-search" type="search"></label><div class="table-scroll"><table><thead><tr><th scope="col"><%= t.key %></th><th scope="col"><%= t.value %></th><th scope="col"><%= t.actions %></th></tr></thead><tbody id="settings-rows"></tbody></table></div></details></main><script src="public/js/admin.js" defer></script><%- include('partials/footer') %>