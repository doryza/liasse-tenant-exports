<% const adminPath=typeof currentPath!=='undefined'?currentPath:'/admin';const adminModules=typeof modules!=='undefined'&&Array.isArray(modules)?modules:[]; %><button type="button" id="admin-toggle" class="admin-toggle" aria-label="<%= t.menu %>" aria-controls="admin-sidebar" aria-expanded="false" style="background-color:#182c39;color:#fff"><%= t.menu %></button><button id="admin-overlay" class="admin-overlay" type="button" aria-label="<%= t.close %>" hidden></button><aside id="admin-sidebar" class="admin-sidebar"><a class="admin-brand" href="admin"><span class="admin-mark" aria-hidden="true">≈</span><span><%= settings.business_name %><small><%= t.admin %></small></span></a><nav aria-label="<%= t.admin %>"><a href="admin" class="<%= adminPath==='/admin'?'selected':'' %>" <%= adminPath==='/admin'?'aria-current=page':'' %> style="<%= adminPath==='/admin'?'background-color:var(--admin-brand);color:#fff':'' %>"><%= t.dashboard %></a><% adminModules.forEach(function(m){ %><a href="admin/<%= m.key %>" class="<%= adminPath==='/admin/'+m.key?'selected':'' %>" <%= adminPath==='/admin/'+m.key?'aria-current=page':'' %> style="<%= adminPath==='/admin/'+m.key?'background-color:var(--admin-brand);color:#fff':'' %>"><%= m.label %></a><% }); %><a href="admin/settings" class="<%= adminPath==='/admin/settings'?'selected':'' %>" <%= adminPath==='/admin/settings'?'aria-current=page':'' %> style="<%= adminPath==='/admin/settings'?'background-color:var(--admin-brand);color:#fff':'' %>"><%= t.settings %></a></nav><div class="sidebar-bottom"><a href="." target="_blank" rel="noopener"><%= t.view_site %> ↗</a><a href="admin/logout"><%= t.admin_logout %></a><div class="languages"><a href="<%= adminPath.slice(1) %>?lang=fr" lang="fr" aria-current="<%= lang==='fr'?'true':'false' %>">FR</a><span aria-hidden="true">/</span><a href="<%= adminPath.slice(1) %>?lang=en" lang="en" aria-current="<%= lang==='en'?'true':'false' %>">EN</a></div></div></aside>