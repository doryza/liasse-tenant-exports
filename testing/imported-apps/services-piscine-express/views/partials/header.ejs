<% const cp=typeof currentPath!=='undefined'?currentPath:'/';const adminPage=typeof isAdminPage!=='undefined'&&isAdminPage;const siteName=settings.business_name||'Services Piscine Express'; %><!DOCTYPE html><html lang="<%= lang %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#2858ef"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="description" content="<%= t.seo_description||t.intermediary %>"><title><%= typeof pageTitle!=='undefined'?pageTitle:siteName %> · <%= siteName %></title><link rel="manifest" href="manifest.json"><link rel="stylesheet" href="public/css/styles.css"><% if(adminPage||cp.startsWith('/admin')||cp==='/demandes'){ %><meta name="robots" content="noindex,nofollow"><% }else{ %><meta property="og:type" content="website"><meta property="og:site_name" content="<%= siteName %>"><meta property="og:title" content="<%= typeof pageTitle!=='undefined'?pageTitle:siteName %>"><meta property="og:description" content="<%= t.seo_description||t.intermediary %>"><meta property="og:locale" content="<%= lang==='en'?'en_CA':'fr_CA' %>"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="<%= siteName %>"><meta name="twitter:description" content="<%= t.seo_description||t.intermediary %>"><% if(settings._p_hero_image_url){ %><meta property="og:image" content="<%= settings._p_hero_image_url %>"><meta name="twitter:image" content="<%= settings._p_hero_image_url %>"><% } %><% if(typeof canonical!=='undefined'){ %><link rel="canonical" href="<%= canonical %>?lang=<%= lang %>"><link rel="alternate" hreflang="fr-CA" href="<%= canonical %>?lang=fr"><link rel="alternate" hreflang="en-CA" href="<%= canonical %>?lang=en"><meta property="og:url" content="<%= canonical %>?lang=<%= lang %>"><% } %><% if(cp==='/'&&typeof structuredData!=='undefined'){ %><script type="application/ld+json"><%- JSON.stringify(structuredData).replace(/</g,'\u003c') %></script><% } %><% } %><% if(adminPage){ %><link rel="stylesheet" href="public/css/admin-styles.css"><% } %></head><body class="<%= adminPage?'admin-body':'' %>"><a class="skip-link" href="<%= cp==='/'?'.':cp.slice(1) %>#main-content" data-lk="t:skip"><%= t.skip %></a><% if(adminPage){ %><%- include('admin-sidebar') %><% }else{ %><header class="masthead wrap"><a class="wordmark" href="."><img src="<%= settings._p_nav_logo_url||(typeof appIconUrl!=='undefined'?appIconUrl:'') %>" data-setting-key="_p_nav_logo_url" alt="<%= t.logo %>" width="42" height="42"><span data-setting-key="business_name"><%= siteName %></span></a><button class="nav-toggle" id="nav-toggle" type="button" aria-label="<%= t.menu %>" aria-controls="site-nav" aria-expanded="false" data-lk="t:menu"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button><nav id="site-nav" aria-label="<%= t.menu %>"><a href=".#services" data-lk="t:services"><%= t.services %></a><a href=".#fonctionnement" data-lk="t:how"><%= t.how %></a><a href="demandes" data-auth-only style="display:none" data-lk="t:requests"><%= t.requests %></a><div class="languages"><a href="<%= cp==='/'?'.':cp.slice(1) %>?lang=fr" class="lang-link <%= lang==='fr'?'active':'' %>" lang="fr" aria-current="<%= lang==='fr'?'true':'false' %>" data-lk="nav-fr">FR</a><span aria-hidden="true">/</span><a href="<%= cp==='/'?'.':cp.slice(1) %>?lang=en" class="lang-link <%= lang==='en'?'active':'' %>" lang="en" aria-current="<%= lang==='en'?'true':'false' %>" data-lk="nav-en">EN</a></div></nav></header><% } %><script>document.addEventListener('DOMContentLoaded',function(){var b=document.getElementById('nav-toggle'),n=document.getElementById('site-nav');function publicClose(){if(b&&n){b.setAttribute('aria-expanded','false');n.classList.remove('open');}}if(b&&n){b.addEventListener('click',function(){var on=b.getAttribute('aria-expanded')!=='true';b.setAttribute('aria-expanded',String(on));n.classList.toggle('open',on);});n.addEventListener('click',function(e){if(e.target.closest('a'))publicClose();});}var a=document.getElementById('admin-toggle'),s=document.getElementById('admin-sidebar'),o=document.getElementById('admin-overlay'),mq=matchMedia('(max-width:799px)');function adminOpen(on){document.body.classList.toggle('sidebar-open',on);if(a)a.setAttribute('aria-expanded',String(on));if(s)s.inert=mq.matches&&!on;if(o)o.hidden=!on;}if(a){a.addEventListener('click',function(){adminOpen(!document.body.classList.contains('sidebar-open'));});if(o)o.addEventListener('click',function(){adminOpen(false);a.focus();});mq.addEventListener('change',function(){adminOpen(false);});adminOpen(false);}document.addEventListener('keydown',function(e){if(e.key==='Escape'){publicClose();if(a&&document.body.classList.contains('sidebar-open')){adminOpen(false);a.focus();}}});});</script>