<% if(typeof isAdminPage!=='undefined'&&isAdminPage){ %><footer class="admin-footer"><span><%= t.operation_help %></span><a href="." data-lk="t:view_site"><%= t.view_site %></a></footer><% }else{ %><footer class="site-footer wrap"><div><strong data-setting-key="business_name"><%= settings.business_name %></strong><p data-lk="t:footer_note"><%= t.footer_note %></p></div><nav aria-label="<%= t.menu %>"><a href="confidentialite" data-lk="t:privacy"><%= t.privacy %></a><a href="entreprises" data-lk="t:partners"><%= t.partners %></a><button type="button" data-push-btn data-lk="t:notifications"><%= t.notifications %></button><button type="button" data-login-btn data-lk="t:login"><%= t.login %></button><a href="demandes" data-auth-only style="display:none" data-lk="t:requests"><%= t.requests %></a></nav><div class="contact-lines"><% if(settings.contact_email){ %><a href="mailto:<%= settings.contact_email %>" data-setting-key="contact_email"><%= settings.contact_email %></a><% }else if(settings.contact_phone){ %><a href="tel:<%= settings.contact_phone.replace(/[^+0-9]/g,'') %>" data-setting-key="contact_phone"><%= settings.contact_phone %></a><% }else{ %><p data-lk="t:contact_missing"><%= t.contact_missing %></p><% } %></div></footer><% } %><script>window.APP=<%- JSON.stringify({t:t,lang:lang,admin:typeof isAdminPage!=='undefined'&&isAdminPage}).replace(/</g,'\u003c') %>;</script><% if(typeof isAdminPage==='undefined'||!isAdminPage){ %><script src="public/js/app.js" defer></script><% } %></body></html>