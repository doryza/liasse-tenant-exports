<% const mod=typeof module!=='undefined'&&module&&module.key?module:{key:'',label:t.manage,fields:[],description:''};const records=typeof items!=='undefined'&&Array.isArray(items)?items:[]; %><%- include('header') %><main class="admin-main" id="main-content" tabindex="-1"><nav class="breadcrumbs" aria-label="<%= t.menu %>"><a href="admin"><%= t.dashboard %></a><span aria-hidden="true">/</span><span><%= mod.label %></span></nav><header class="admin-heading"><div><h1><%= mod.label %></h1><p><%= mod.description||t.fields_help %></p></div><button type="button" class="button" id="admin-add" style="background-color:var(--admin-brand);color:#fff">+ <%= t.add %></button></header><% if(mod.key==='uploads'){ %><p class="admin-notice"><%= t.private_notice %></p><% } %><div class="toolbar"><label><span><%= t.search %></span><input id="admin-search" type="search" autocomplete="off"></label><label id="filter-label"><span><%= t.filter %></span><select id="admin-filter"><option value=""><%= t.all %></option></select></label><label><span><%= t.sort %></span><select id="admin-sort"><option value="newest"><%= t.newest %></option><option value="oldest"><%= t.oldest %></option><option value="alpha"><%= t.alphabetical %></option></select></label><button class="button secondary" id="admin-refresh" type="button"><%= t.refresh %></button></div><div class="list-summary"><span id="admin-count" aria-live="polite"></span><button type="button" class="text-button" id="admin-reset"><%= t.reset_filters %></button></div><p id="admin-status" class="admin-notice" role="status" tabindex="-1" hidden></p><div class="table-scroll" id="admin-table-wrap" tabindex="0" aria-label="<%= mod.label %>"><table><thead><tr><th scope="col"><%= t.record %></th><th scope="col"><%= t.details %></th><th scope="col"><%= t.status %></th><th scope="col"><%= t.admin_created %></th><th scope="col"><%= t.actions %></th></tr></thead><tbody id="admin-rows"><% if(records.length){records.slice(0,10).forEach(function(r){ %><tr><td><%= r.title||r.name||r.company||r.filename||r.id %></td><td><%= r.reference||r.municipality||'' %></td><td><%= t[r.status]||r.status||'' %></td><td><%= typeof date==='function'?date(r.created_at):'' %></td><td><button type="button" data-edit="<%= r.id %>"><%= t.edit %></button><button type="button" data-delete="<%= r.id %>"><%= t.delete %></button></td></tr><% });}else{ %><tr><td colspan="5" class="empty-cell"><%= t.no_records %></td></tr><% } %></tbody></table></div><div class="admin-pagination"><button class="button secondary" id="admin-prev" type="button"><%= t.previous %></button><span id="admin-page"></span><button class="button secondary" id="admin-next" type="button"><%= t.more %></button></div></main><dialog id="admin-dialog" aria-labelledby="admin-dialog-title" aria-describedby="admin-dialog-help"><form id="admin-form" action="api/admin/<%= mod.key %>" method="post"><header class="dialog-heading"><div><h2 id="admin-dialog-title"><%= t.edit %></h2><p id="admin-dialog-help"><%= t.fields_help %></p></div><button type="button" id="admin-close" class="icon-close" aria-label="<%= t.close %>">×</button></header><div class="dialog-content"><p id="admin-form-error" class="admin-notice error" role="alert" tabindex="-1" hidden></p><div id="admin-fields" class="admin-fields-grid"></div><section id="admin-linked-photos" hidden></section></div><footer class="dialog-actions"><span id="admin-busy" role="status"></span><button class="button secondary" type="button" id="admin-cancel"><%= t.cancel_action %></button><button class="button" type="submit" id="admin-save" style="background-color:var(--admin-brand);color:#fff"><%= t.save %></button></footer></form></dialog><script>window.ADMIN_DATA=<%- JSON.stringify({items:records,module:mod}).replace(/</g,'\u003c') %>;</script><script src="public/js/admin.js" defer></script><%- include('footer') %>