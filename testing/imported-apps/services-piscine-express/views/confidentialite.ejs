<%- include('partials/header') %><main class="policy wrap" id="main-content" tabindex="-1"><h1 data-lk="t:privacy_title"><%= t.privacy_title %></h1><p class="lead" data-lk="t:privacy_intro"><%= t.privacy_intro %></p><% if(typeof items!=='undefined'&&items.length){items.forEach(function(p){ %><section><h2 data-content-source="posts:<%= lang==='en'?'title_en':'title' %>" data-content-id="<%= p.id %>"><%= p[lang==='en'?'title_en':'title'] %></h2><p class="preserve-lines" data-content-source="posts:<%= lang==='en'?'content_en':'content' %>" data-content-id="<%= p.id %>"><%= p[lang==='en'?'content_en':'content'] %></p></section><% });}else{ %><p class="notice" data-lk="t:policy_missing"><%= t.policy_missing %></p><% } %><section><h2 data-lk="t:contact_business"><%= t.contact_business %></h2><% if(settings.contact_email){ %><a href="mailto:<%= settings.contact_email %>" data-setting-key="contact_email"><%= settings.contact_email %></a><% }else if(settings.contact_phone){ %><a href="tel:<%= settings.contact_phone.replace(/[^+0-9]/g,'') %>" data-setting-key="contact_phone"><%= settings.contact_phone %></a><% }else{ %><p data-lk="t:contact_missing"><%= t.contact_missing %></p><% } %></section><a class="button secondary" href="." data-lk="t:owners"><%= t.owners %></a></main><%- include('partials/footer') %>