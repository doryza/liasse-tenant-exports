<%- include('partials/head') %><%- include('partials/header') %><main id="main" class="wrap section"><p class="eyebrow"><%= b.brand_name %></p><h1 class="page-title"><%= t.request %></h1><p class="lead"><%= t.requestNote %></p><div class="request-layout"><form data-request action="api/requests" data-success="<%= t.sent %>" data-error="<%= t.error %>"><% if(!live){ %><div class="notice"><%= t.pending %> <a href="<%= b.tel %>"><%= b.phone %></a></div><% } %><fieldset <%- !live?'disabled':'' %>><label><%= t.name %><input name="name" autocomplete="name" required minlength="2" maxlength="120"></label><label><%= t.phone %><input name="phone" type="tel" autocomplete="tel" required maxlength="40"></label><label><%= t.serviceAddress %><input name="address" autocomplete="street-address" required minlength="5" maxlength="300"></label><label><%= t.services %><select name="service_id"><option value=""><%= t.other %></option><% b.services.filter(function(s){return s.confirmed;}).forEach(function(s){ %><option value="<%= s.id %>" <%- selectedService===s.id?'selected':'' %>><%= text(s.name) %></option><% }); %></select></label><label><%= t.problem %><textarea name="message" required minlength="5" maxlength="3000" rows="5"></textarea></label><label class="honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"></label><label class="checkbox"><input type="checkbox" name="consent" required><span><%= t.consent %> <a href="<%= url('confidentialite') %>"><%= t.privacy %></a></span></label><input type="hidden" name="language" value="<%= lang %>"><button class="btn" type="submit"><%= t.send %> →</button></fieldset><p class="form-status" role="status" aria-live="polite"></p></form><aside><h2><%= t.urgent %></h2><p><%= t.availability %></p><a class="btn outline" href="<%= b.tel %>"><%= b.phone %> ↗</a><img src="public/images/repair.svg" width="600" height="420" alt="" loading="lazy"></aside></div></main><%- include('partials/footer') %>
