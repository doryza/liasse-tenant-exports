<%- include('partials/head') %><%- include('partials/header') %>
<main id="main"><section class="hero wrap"><div class="hero-copy"><p class="eyebrow" data-lk="t:eyebrow"><%= t.eyebrow %><%= b.city %></p><h1><span data-lk="t:heroA"><%= t.heroA %></span><em data-lk="t:heroB"><%= t.heroB %></em></h1><p class="lead" data-lk="t:heroBody"><%= t.heroBody %></p><div class="hero-actions"><a class="btn" href="<%= b.tel %>"><%= t.call %> <span aria-hidden="true">↗</span></a><a class="text-link" href="<%= url('demande') %>"><%= t.request %> →</a></div><% if(b.rating){ %><a class="review-line" href="<%= b.rating.url %>" target="_blank" rel="noopener"><span class="stars" aria-hidden="true">★★★★★</span><strong><%= ratingText %>/5</strong> · <%= b.rating.count %> <%= t.reviews %> <%= t.rating %><small><%= t.observed %> <%= b.rating.observed_at %></small></a><% } %></div><div class="hero-art"><img src="public/images/hero.svg" width="900" height="900" alt="<%= t.illustration %>"><div class="art-label"><span aria-hidden="true">↗</span><span><strong><%= b.city %></strong><small><%= b.hours ? text(b.hours.text) : t.estimate %></small></span></div></div></section>
<div class="urgent-strip"><div class="wrap"><strong><span class="dot" aria-hidden="true"></span><%= t.urgent %></strong><span><%= t.availability %></span><a href="<%= b.tel %>"><%= b.phone %> ↗</a></div></div>
<section class="section wrap" id="services"><div class="section-heading"><div><p class="eyebrow"><%= t.services %></p><h2 data-lk="t:servicesIntro"><%= t.servicesIntro %></h2></div><a class="text-link" href="<%= url('services') %>"><%= t.allServices %> →</a></div><p class="section-intro"><%= t.servicesBody %></p><%- include('partials/cards',{items:b.services.filter(function(s){return ['urgence','chauffe-eau','debouchage','renovation-residentielle'].includes(s.id);}).slice(0,4)}) %></section>
<section class="process section"><div class="wrap"><p class="eyebrow"><%= b.brand_name %></p><h2><%= t.how %></h2><div class="process-grid"><% [1,2,3].forEach(function(i){ %><article><span class="step-number">0<%= i %></span><h3><%= t['step'+i] %></h3><p><%= t['step'+i+'Body'] %></p></article><% }); %></div></div></section>
<section class="section wrap area-section"><div><p class="eyebrow"><%= b.city %></p><h2><%= t.area %></h2><p class="lead"><%= b.areas ? text(b.areas) : t.areaUnknown %></p><p><%= t.areaQuestion %></p><a class="btn outline" href="<%= url('contact') %>"><%= t.contact %> ↗</a></div><div class="area-art"><img src="public/images/area.svg" width="600" height="420" alt="" loading="lazy"><small><%= t.illustration %></small></div></section>
<section class="section faq wrap"><div><p class="eyebrow">FAQ</p><h2><%= t.faq %></h2></div><div><% ['Price','Time','Area'].forEach(function(k){ %><details><summary><%= t['faq'+k] %></summary><p><%= t['faq'+k+'Body'] %></p></details><% }); %></div></section></main><%- include('partials/footer') %>
