<div class="service-grid"><% items.forEach(function(svc){ %><a class="service-card" href="<%= url('services/'+svc.id) %>"><div class="card-art"><img src="public/images/<%= svc.art %>.svg" width="600" height="420" alt="" loading="lazy"><span class="card-arrow" aria-hidden="true">↗</span></div><div class="card-copy"><% if(!svc.confirmed){ %><small class="unconfirmed"><%= t.draftService %></small><% } %><h3><%= text(svc.name) %></h3><p><%= text(svc.tagline) %></p><span class="card-link"><%= t.view %> <span aria-hidden="true">→</span></span></div></a><% }); %></div>
