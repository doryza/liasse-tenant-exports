<div class="topline">
 <div class="wrap topline-row">
  <span class="status <%= b.emergency ? 'is-open' : openState ? (openState.open ? 'is-open' : 'is-closed') : '' %>">
   <span class="status-dot" aria-hidden="true"></span>
   <% if (b.emergency && !b.hours) { %><%= t.always %><% } else if (openState && openState.open) { %><%= fmt(t.openUntil, { time: clock(openState.until) }) %><% } else if (openState && openState.next) { %><%= t.closed %>. <%= fmt(t.opensAt, { day: openState.next.inDays === 0 ? t.today : openState.next.inDays === 1 ? t.tomorrow : t.days[openState.next.weekday].toLowerCase(), time: clock(openState.next.time) }) %><% } else if (b.hoursText) { %><%= text(b.hoursText) %><% } else { %><%= t.hoursAsk %><% } %>
   <% if (b.emergency && b.hours) { %><span class="status-extra"><%= t.emergencyLine %></span><% } %>
  </span>
  <span class="topline-right">
   <% if (b.free_estimates) { %><span class="topline-note"><%= t.factEstimate %> <%= t.estimateFree.toLowerCase() %></span><% } %>
   <a class="lang" href="<%= other || (lang === 'fr' ? 'en/' : './') %>" hreflang="<%= lang === 'fr' ? 'en' : 'fr' %>" lang="<%= lang === 'fr' ? 'en' : 'fr' %>"><%= t.langOther %></a>
  </span>
 </div>
</div>
<header class="site-header">
 <div class="wrap header-row">
  <a class="brand" href="<%= U.home || './' %>">
   <%- mark({ size: 46 }) %>
   <span class="brand-text"><strong><%= b.brand_name %></strong><small><%= b.city %></small></span>
  </a>
  <nav class="nav" id="site-nav" aria-label="<%= t.menu %>">
   <a href="<%= U.services %>"<%- active === 'services' ? ' aria-current="page"' : '' %> data-lk="t:services"><%= t.services %></a>
   <a href="<%= U.contact %>"<%- active === 'contact' ? ' aria-current="page"' : '' %> data-lk="t:contact"><%= t.contact %></a>
   <a class="nav-call" href="<%= b.tel %>"><%= t.call %> <%= b.phone %></a>
  </nav>
  <div class="header-actions">
   <a class="phone-link" href="<%= b.tel %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg><span><%= b.phone %></span></a>
   <a class="btn btn-accent header-cta" href="<%= U.estimate %>"<%- active === 'request' ? ' aria-current="page"' : '' %>><%= t.estimate %></a>
   <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav"><span class="nav-toggle-bars" aria-hidden="true"></span><span class="sr"><%= t.menu %></span></button>
  </div>
 </div>
</header>
