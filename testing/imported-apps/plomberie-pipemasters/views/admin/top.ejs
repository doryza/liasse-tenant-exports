<%
 var ICON = {
  dashboard: '<path d="M3 13h8V3H3zM13 21h8V11h-8zM3 21h8v-6H3zM13 3v6h8V3z"/>',
  requests: '<path d="M4 4h16v12H5.2L4 17.2z"/><path d="M8 8h8M8 12h5"/>',
  documents: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>',
  customers: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M18 14a5.5 5.5 0 0 1 3.5 6"/>',
  services: '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.2L3 17.8V21h3.2l6.3-6.3a4 4 0 0 0 5.2-5.4l-2.6 2.6-2.4-.5-.5-2.4z"/>',
  hours: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  settings: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/>',
  site: '<path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
  edit: '<path d="M4 20h4L19 9l-4-4L4 16z"/><path d="m13.5 6.5 4 4"/>',
 };
 var svg = function (k) { return '<svg viewBox="0 0 24 24" aria-hidden="true">' + ICON[k] + '</svg>'; };
 var NAV = [
  ['dashboard', 'admin', tr('Tableau de bord', 'Dashboard')],
  ['requests', 'admin/demandes', tr('Demandes', 'Requests'), navCounts.requests],
  ['documents', 'admin/documents', tr('Estimations et factures', 'Estimates & invoices'), b.documents ? navCounts.accepted : 0, !b.documents],
  ['customers', 'admin/clients', tr('Clients', 'Customers')],
  ['services', 'admin/services', tr('Services', 'Services')],
  ['hours', 'admin/horaire', tr('Heures et secteur', 'Hours & area')],
  ['settings', 'admin/reglages', tr('Réglages', 'Settings')],
 ];
%><!doctype html>
<html lang="<%= lang %>" data-family="<%= family %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex">
<base href="<%= tenantRoot %>">
<title><%= pageTitle %> · <%= b.brand_name %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="<%= fontsHref %>">
<link rel="stylesheet" href="public/css/admin.css">
<style>:root{<%- themeVars %>}</style>
</head>
<body class="admin" data-section="<%= section %>" data-lang="<%= lang %>">
<a class="skip" href="#admin-main"><%= tr('Aller au contenu', 'Skip to content') %></a>
<div class="ad-shell">
 <aside class="ad-side" id="ad-side">
  <a class="ad-brand" href="admin<%= lang === 'en' ? '?lang=en' : '' %>"><%- mark({ size: 38 }) %><span><strong><%= b.brand_name %></strong><small><%= tr('Gestion', 'Back office') %></small></span></a>
  <nav class="ad-nav" aria-label="<%= tr('Menu', 'Menu') %>">
   <% NAV.forEach(function (n) { %><a href="<%= n[1] %>"<%- section === n[0] ? ' aria-current="page"' : '' %><%- n[4] ? ' class="is-off"' : '' %>><%- svg(n[0]) %><span><%= n[2] %></span><% if (n[3]) { %><span class="badge"><%= n[3] %></span><% } %><% if (n[4]) { %><span class="off-tag"><%= tr('Inactif', 'Off') %></span><% } %></a><% }) %>
  </nav>
  <div class="ad-side-foot">
   <a href="<%= siteUrl %>" target="_blank" rel="noopener"><%- svg('site') %><span><%= tr('Voir le site', 'View the site') %></span></a>
   <% if (!inTrial) { %><a href="<%= siteUrl %>?_inline_edit=1" target="_blank" rel="noopener"><%- svg('edit') %><span><%= tr('Modifier les textes du site', 'Edit the site’s texts') %></span></a><% } %>
   <a class="ad-lang" href="?lang=<%= lang === 'fr' ? 'en' : 'fr' %>"><%= lang === 'fr' ? 'English' : 'Français' %></a>
  </div>
 </aside>
 <div class="ad-body">
  <header class="ad-top">
   <a class="ad-brand" href="admin"><%- mark({ size: 32 }) %><strong><%= b.brand_name %></strong></a>
   <button class="ad-menu" type="button" aria-controls="ad-side" aria-expanded="false"><%= tr('Menu', 'Menu') %></button>
  </header>
  <main class="ad-main" id="admin-main">
