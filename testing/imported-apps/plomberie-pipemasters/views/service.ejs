<%- include('partials/head') %><%- include('partials/header') %><main id="main" class="wrap section"><a class="text-link" href="<%= url('services') %>">← <%= t.back %></a><div class="service-detail"><div><p class="eyebrow"><%= b.brand_name %></p><h1 class="page-title"><%= text(service.name) %></h1><p class="lead"><%= text(service.tagline) %></p><p><%= text(service.body) %></p><% if(!service.confirmed){ %><div class="notice"><strong><%= t.draftService %></strong><p><%= t.draftServiceBody %></p></div><% } %><a class="btn" href="<%= b.tel %>"><%= t.call %> ↗</a></div><div class="art"><img src="public/images/<%= service.art %>.svg" width="600" height="420" alt="<%= t.illustration %>"></div></div><div class="next-step"><h2><%= t.serviceTitle %></h2><p><%= t.serviceBody %></p><a class="text-link" href="<%= url('demande?service='+service.id) %>"><%= t.request %> →</a></div></main><%- include('partials/footer') %>
