<%- include('partials/head') %><%- include('partials/header') %><main id="main" class="wrap section"><p class="eyebrow"><%= b.city %></p><h1 class="page-title"><%= t.contactTitle %></h1><p class="lead"><%= t.contactBody %></p><div class="contact-grid"><div class="contact-card"><span class="eyebrow"><%= t.phone %></span><a class="contact-number" href="<%= b.tel %>"><%= b.phone %> ↗</a><p><%= t.urgent %></p><% if(b.email){ %><span class="eyebrow"><%= t.email %></span><a class="email" href="mailto:<%= b.email %>"><%= b.email %></a><% } %></div><div><h2><%= t.area %></h2><p><%= b.areas?text(b.areas):t.areaUnknown %></p><p><%= t.noOffice %></p><h3><%= t.hours %></h3><p><%= b.hours?text(b.hours.text):t.hoursUnknown %></p><% if(b.payments){ %><h3><%= t.payments %></h3><p><%= text(b.payments) %></p><% } %><a class="text-link" href="<%= url('demande') %>"><%= t.request %> →</a></div></div></main><%- include('partials/footer') %>
