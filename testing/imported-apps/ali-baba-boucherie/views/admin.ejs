<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Admin — Ali Baba Grillades</title>
<link rel="stylesheet" href="public/css/admin-styles.css">
</head>
<body>
<div class="admin-layout">
<%- include('partials/admin-sidebar', { page: 'dashboard' }) %>
<main class="admin-main">
<div class="admin-header">
  <div>
    <h1>Tableau de bord</h1>
    <p style="margin:0.25rem 0 0;color:#718096;font-size:0.9rem">Bienvenue dans le panneau d'administration de Ali Baba Grillades.</p>
  </div>
  <div style="display:flex;gap:0.5rem;flex-wrap:wrap">
    <a href="." target="_blank" class="btn btn-secondary">🌐 Voir le site</a>
    <a href="admin/menu" class="btn btn-primary">🍴 Gérer le menu</a>
  </div>
</div>

<h2 style="margin:0 0 1rem;font-size:1.1rem;color:#4a5568;text-transform:uppercase;letter-spacing:0.05em">Activité du site</h2>
<div class="stat-grid">
  <div class="stat-card"><div class="label">Visites totales</div><div class="value"><%= stats.visits %></div></div>
  <div class="stat-card"><div class="label">7 derniers jours</div><div class="value"><%= stats.visits7 %></div></div>
  <div class="stat-card"><div class="label">Utilisateurs</div><div class="value"><%= stats.users %></div></div>
  <div class="stat-card"><div class="label">Abonnés push</div><div class="value"><%= stats.pushSubs %></div></div>
</div>

<h2 style="margin:2rem 0 1rem;font-size:1.1rem;color:#4a5568;text-transform:uppercase;letter-spacing:0.05em">Gestion du contenu</h2>
<div class="module-grid">
  <a href="admin/menu" class="module-card">
    <div class="module-icon">🍴</div>
    <h3>Menu</h3>
    <p><strong><%= stats.menu %></strong> plat<%= stats.menu>1?'s':'' %> · <span style="color:#16a34a"><%= stats.availableMenu %> disponible<%= stats.availableMenu>1?'s':'' %></span></p>
  </a>
  <a href="admin/delivery" class="module-card">
    <div class="module-icon">🛵</div>
    <h3>Livraison</h3>
    <p><strong><%= stats.platforms %></strong> plateforme<%= stats.platforms>1?'s':'' %> · <span style="color:#16a34a"><%= stats.activePlatforms %> active<%= stats.activePlatforms>1?'s':'' %></span></p>
  </a>
  <a href="admin/offers" class="module-card">
    <div class="module-icon">🏷️</div>
    <h3>Offres</h3>
    <p>Promotions & codes à échanger</p>
  </a>
  <a href="admin/posts" class="module-card">
    <div class="module-icon">📝</div>
    <h3>Nouvelles</h3>
    <p><strong><%= stats.posts %></strong> publication<%= stats.posts>1?'s':'' %></p>
  </a>
</div>
</main>
</div>
</body>
</html>
