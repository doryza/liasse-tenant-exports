<%- include('partials/header') %>
<section class="page-hero terrazzo"><div class="container"><a href="conseils" style="color:var(--bronze-l);font-weight:600;font-size:.9rem">← <%= t.back_to_advice %></a><% if(post.category){ %><span class="kicker" style="display:block;margin-top:14px"><%= post.category %></span><% } %><h1><%= post.title %></h1><p><%= t.published_on %> <%= fmtDate(post.created_at) %></p></div></section>
<section class="section light">
 <div class="container" style="max-width:780px">
  <% if(post.image_url){ %><img src="<%= post.image_url %>" alt="<%= post.title %>" style="width:100%;border-radius:16px;margin-bottom:30px;box-shadow:var(--shadow)"><% } %>
  <div style="font-size:1.08rem;line-height:1.85;white-space:pre-line;color:var(--ink)"><%= post.content %></div>
  <div style="margin-top:42px;padding:30px;border-radius:16px;background:var(--cream);text-align:center"><h3 style="font-family:'Fraunces',serif;margin-bottom:14px;font-size:1.4rem"><%= t.contact_cta_title %></h3><a class="btn btn-call" href="<%= telHref(settings.contact_phone) %>" style="background-color:#c69749;color:#16130f"><%= t.call_now %></a></div>
 </div>
</section>
<%- include('partials/footer') %>
