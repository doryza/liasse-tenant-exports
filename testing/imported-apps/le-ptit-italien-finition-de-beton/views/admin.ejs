<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tableau de bord — Admin</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,400;9..144,900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="public/css/admin-styles.css">
</head>
<body class="admin">
<%- include('partials/admin-sidebar', { active:'dashboard' }) %>
<main class="admin-main">
<header class="admin-topbar">
<button class="admin-burger" id="adminBurger" aria-label="Menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button>
<h1>Tableau de bord</h1>
<a class="btn-primary" href="." target="_blank" rel="noopener">Voir le site ↗</a>
</header>
<div class="dash-wrap">
<div class="dash-welcome">
<div><h2>Bonjour 👋</h2><p>Gérez vos réalisations, services, témoignages, conseils et demandes — tout au même endroit.</p></div>
<a class="btn-primary" href="admin/projects">+ Ajouter une réalisation</a>
</div>
<div class="stat-grid">
<div class="stat-card"><div class="sc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg></div><div class="sc-val"><%= stats.recentVisits %></div><div class="sc-label">Visites (7 jours)</div></div>
<div class="stat-card"><div class="sc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg></div><div class="sc-val"><%= stats.totalVisits %></div><div class="sc-label">Visites totales</div></div>
<div class="stat-card highlight"><div class="sc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20"><path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.79 19.79 0 0 1 3.08 4.18 2 2 0 0 1 5.08 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg></div><div class="sc-val"><%= stats.submissions %></div><div class="sc-label">Demandes reçues</div></div>
<div class="stat-card"><div class="sc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m21 15-5-5L5 21"/></svg></div><div class="sc-val"><%= stats.projects %></div><div class="sc-label">Réalisations</div></div>
</div>
<h2 class="dash-section-title">Gestion du contenu</h2>
<div class="module-grid">
<a class="module-card" href="admin/projects"><div class="mc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg></div><div class="mc-body"><div class="mc-title">Réalisations</div><div class="mc-sub"><%= stats.projects %> élément(s)</div></div><span class="mc-arrow">→</span></a>
<a class="module-card" href="admin/services"><div class="mc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg></div><div class="mc-body"><div class="mc-title">Services</div><div class="mc-sub"><%= stats.services %> élément(s)</div></div><span class="mc-arrow">→</span></a>
<a class="module-card" href="admin/testimonials"><div class="mc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2 15 9l7 .5-5.5 4.5L18 21l-6-4-6 4 1.5-7L2 9.5 9 9z"/></svg></div><div class="mc-body"><div class="mc-title">Témoignages</div><div class="mc-sub"><%= stats.testimonials %> élément(s)</div></div><span class="mc-arrow">→</span></a>
<a class="module-card" href="admin/posts"><div class="mc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></div><div class="mc-body"><div class="mc-title">Conseils</div><div class="mc-sub"><%= stats.posts %> article(s)</div></div><span class="mc-arrow">→</span></a>
<a class="module-card" href="admin/settings"><div class="mc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></div><div class="mc-body"><div class="mc-title">Coordonnées & images</div><div class="mc-sub">Contact, logo, photos</div></div><span class="mc-arrow">→</span></a>
</div>
<div class="panel" style="margin-top:24px">
<h2>Demandes récentes</h2>
<% if(subs && subs.length){ %>
<div class="table-scroll"><table class="admin-table"><thead><tr><th>Nom</th><th>Contact</th><th>Projet</th><th>Date</th></tr></thead><tbody>
<% subs.forEach(function(s){ %><tr><td><%= s.name %></td><td><%= s.phone || s.email || '—' %></td><td><%= s.service || '—' %></td><td><%= fmtDate(s.created_at) %></td></tr><% }); %>
</tbody></table></div>
<% } else { %><div class="admin-empty">Aucune demande pour le moment. Les soumissions reçues via le formulaire de contact apparaîtront ici.</div><% } %>
</div>
</div>
</main>
<script>document.addEventListener('DOMContentLoaded',function(){var b=document.getElementById('adminBurger');if(b)b.addEventListener('click',function(){document.getElementById('adminSidebar').classList.toggle('open');});});</script>
</body>
</html>
