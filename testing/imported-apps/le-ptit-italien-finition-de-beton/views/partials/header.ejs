<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#16130f">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="description" content="<%= t.meta_desc %>">
<meta property="og:title" content="<%= (settings.business_name||"Le P'tit Italien") %> — <%= t.meta_title %>">
<meta property="og:description" content="<%= t.meta_desc %>">
<meta property="og:type" content="website">
<% if(typeof settings!=='undefined' && settings._p_hero_image_url){ %><meta property="og:image" content="<%= settings._p_hero_image_url %>"><% } %>
<meta name="twitter:card" content="summary_large_image">
<title><%= (settings.business_name||"Le P'tit Italien") %> — <%= t.meta_title %></title>
<link rel="manifest" href="manifest.json">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="public/css/styles.css">
</head>
<body>
<header class="topbar" id="topbar">
 <div class="topbar-inner container">
  <a href="." class="logo">
   <img class="logo-img" src="<%= (typeof settings!=='undefined' && settings._p_nav_logo_url) ? settings._p_nav_logo_url : (typeof appIconUrl!=='undefined' ? appIconUrl : '') %>" alt="Logo" onerror="this.style.display='none'">
   <span class="logo-text"><%= settings.business_name || "Le P'tit Italien" %></span>
  </a>
  <nav class="nav">
   <a href="." class="<%= (typeof active!=='undefined'&&active==='home')?'active':'' %>"><%= t.nav_home %></a>
   <a href="realisations" class="<%= (typeof active!=='undefined'&&active==='work')?'active':'' %>"><%= t.nav_work %></a>
   <a href="services" class="<%= (typeof active!=='undefined'&&active==='services')?'active':'' %>"><%= t.nav_services %></a>
   <a href="temoignages" class="<%= (typeof active!=='undefined'&&active==='testimonials')?'active':'' %>"><%= t.nav_testimonials %></a>
   <a href="conseils" class="<%= (typeof active!=='undefined'&&active==='advice')?'active':'' %>"><%= t.nav_advice %></a>
   <a href="contact" class="<%= (typeof active!=='undefined'&&active==='contact')?'active':'' %>"><%= t.nav_contact %></a>
  </nav>
  <div class="topbar-actions">
   <span class="lang"><a href="?lang=fr" class="<%= lang==='fr'?'on':'' %>">FR</a><span>·</span><a href="?lang=en" class="<%= lang==='en'?'on':'' %>">EN</a></span>
   <a class="btn btn-call desk" href="<%= telHref(settings.contact_phone) %>" style="background-color:#c69749;color:#16130f"><%= t.call %></a>
   <button class="hamburger" id="hamburger" aria-label="<%= t.nav_menu %>"><span></span><span></span><span></span></button>
  </div>
 </div>
 <div class="mobile-menu" id="mobilemenu">
  <a href="."><%= t.nav_home %></a>
  <a href="realisations"><%= t.nav_work %></a>
  <a href="services"><%= t.nav_services %></a>
  <a href="temoignages"><%= t.nav_testimonials %></a>
  <a href="conseils"><%= t.nav_advice %></a>
  <a href="contact"><%= t.nav_contact %></a>
  <a href="?lang=<%= lang==='fr'?'en':'fr' %>"><%= lang==='fr'?'English':'Français' %></a>
  <a class="mm-call" href="<%= telHref(settings.contact_phone) %>"><%= t.call_now %></a>
 </div>
</header>
<script>
(function(){var h=document.getElementById('hamburger'),m=document.getElementById('mobilemenu');if(h&&m){h.addEventListener('click',function(){m.classList.toggle('open');h.classList.toggle('active');});}var tb=document.getElementById('topbar');if(tb){window.addEventListener('scroll',function(){if(window.scrollY>20)tb.classList.add('scrolled');else tb.classList.remove('scrolled');});}})();
</script>
