<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<base href="<%= tenantRoot %>">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#15212b">
<meta name="apple-mobile-web-app-capable" content="yes">
<% var pageTitle = page === 'home' ? settings.business_name + ' — ' + (lang === 'en' ? 'Garage in ' + city : 'Garage à ' + city) : (typeof title !== 'undefined' && title ? title : (t[page] || t.home)) + ' — ' + settings.business_name; %>
<title><%= pageTitle %></title>
<% if (typeof metaDescription !== 'undefined' && metaDescription) { %><meta name="description" content="<%= metaDescription %>">
<% } else if (page === 'home') { %><meta name="description" content="<%= settings.hero_subtitle %>">
<% } %>
<meta property="og:title" content="<%= pageTitle %>">
<meta property="og:image" content="<%= assets.logo %>">
<link rel="icon" href="<%= assets.mark.replace('/upload/', '/upload/w_64,h_64,c_fill/') %>">
<link rel="apple-touch-icon" href="<%= assets.mark.replace('/upload/', '/upload/w_180,h_180,c_fill/') %>">
<link rel="manifest" href="manifest.json">
<link rel="alternate" hreflang="fr" href="<%= langLinks.fr %>">
<link rel="alternate" hreflang="en" href="<%= langLinks.en %>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="public/css/styles.css">
<script type="application/ld+json"><%- safeJSON({ '@context': 'https://schema.org', '@type': 'AutoRepair', name: settings.business_name, telephone: settings.contact_phone, address: settings.business_address, areaServed: city ? [city] : undefined, openingHoursSpecification: !hoursKnown ? undefined : hours.filter(function (h) { return !h.closed; }).map(function (h) { return { '@type': 'OpeningHoursSpecification', dayOfWeek: ['', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'][h.weekday], opens: h.opens, closes: h.closes }; }), paymentAccepted: settings.payment_methods, image: assets.logo }) %></script>
</head>
