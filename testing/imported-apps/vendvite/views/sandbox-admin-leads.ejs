<!doctype html>
<html lang="<%= lang %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>VendVite — <%= lang==='en'?'Test requests':'Demandes de test' %></title><link rel="stylesheet" href="public/css/admin-styles.css"><link rel="stylesheet" href="public/css/admin-operations-v1.css"><link rel="stylesheet" href="public/css/sandbox-v1.css"></head>
<body class="admin"><% const en=lang==='en',tr=(fr,english)=>en?english:fr,date=x=>x?new Date(x).toLocaleString(en?'en-CA':'fr-CA',{timeZone:'America/Toronto'}):'—',suffix=campaign?'&campaign='+campaign.id:'',statuses={'nouveau':tr('Nouveau','New'),'contacté':tr('Contact simulé','Simulated contact'),'évalué':tr('Analyse remise — simulation','Analysis delivered — simulation'),'fermé':tr('Fermé','Closed')},methods={email:tr('Courriel','Email'),phone:tr('Téléphone','Phone'),in_person:tr('En personne','In person'),other:tr('Autre','Other')}; %>
<%- include('partials/admin-sidebar') %><main class="admin-main"><header class="admin-top"><button id="adminBurger" class="admin-burger" aria-label="Menu">≡</button><h1><%= tr('Demandes de test','Test requests') %></h1></header><div class="sandbox-shell">
<p class="sandbox-banner"><strong>TEST / SIMULATION</strong> — <%= tr('Ces demandes servent à répéter le suivi. Les actions ci-dessous ne contactent personne et ne remettent aucune analyse réelle. Les rappels sont enregistrés comme aperçus de courriels, sans envoi.', 'These requests rehearse follow-up. Actions below do not contact anyone or deliver an actual analysis. Reminders are stored as email previews, without sending.') %></p>
<div class="sandbox-actions"><a href="<%= campaign?'admin/campagnes/'+campaign.id+'/preparation':'admin/campagnes?status=test' %>"><%= campaign?tr('← Commande test','← Test order')+' #'+campaign.id:tr('← Commandes test','← Test orders') %></a><a href="admin/tests/notifications<%= campaign?'?campaign='+campaign.id:'' %>"><%= tr('Voir les courriels simulés','View simulated emails') %> →</a></div>
<p><%= tr('Le rappel peut être préparé immédiatement avant de simuler un contact. La remise enregistre votre déclaration de test et son mode; elle n’envoie pas de document.', 'Prepare a reminder immediately before simulating contact. Delivery records your test acknowledgement and method; it does not send a document.') %></p>
<% if(!leads.length){ %><p class="sandbox-card"><%= tr('Aucune demande de test ici. Depuis une commande test préparée, ouvrez une page propriétaire privée et soumettez le formulaire.', 'No test requests here. From a prepared test order, open a private homeowner page and submit the form.') %></p><% } %>
<% leads.forEach(function(l){ %><article class="sandbox-card sandbox-lead" data-id="<%= l.id %>"><h2><%= l.name %> <span class="sandbox-pill"><%= statuses[l.status]||l.status %></span></h2><p><strong><%= l.address %></strong></p><dl class="sandbox-meta"><dt><%= tr('Courtier','Agent') %></dt><dd><%= l.broker_name %></dd><dt><%= tr('Coordonnées de test','Test contact details') %></dt><dd><%= [l.email,l.phone].filter(Boolean).join(' · ')||'—' %></dd><dt><%= tr('Projet','Timeframe') %></dt><dd><%= l.timeframe||'—' %></dd><dt><%= tr('Demande créée','Request created') %></dt><dd><%= date(l.created_at) %></dd><dt><%= tr('Suivi prévu','Follow-up due') %></dt><dd><%= date(l.response_due_at) %></dd><dt><%= tr('Contact simulé','Simulated contact') %></dt><dd><%= date(l.contacted_at) %></dd><dt><%= tr('Remise simulée','Simulated delivery') %></dt><dd><%= date(l.analysis_delivered_at) %><% if(l.delivery_method){ %> · <%= methods[l.delivery_method]||l.delivery_method %><% } %><% if(l.delivery_reference){ %><br><%= l.delivery_reference %><% } %></dd></dl>
<% if(l.campaign_id){ %><p><a href="admin/campagnes/<%= l.campaign_id %>/preparation"><%= tr('Commande test','Test order') %> #<%= l.campaign_id %></a> · <a href="admin/tests/notifications?campaign=<%= l.campaign_id %>"><%= tr('Courriels simulés','Simulated emails') %> →</a></p><% } %>
<div class="sandbox-actions"><% if(!l.contacted_at&&!l.analysis_delivered_at&&l.status!=='fermé'){ %><button type="button" data-action="overdue"><%= tr('Simuler 24 h sans réponse','Simulate 24 hours without a response') %></button><button type="button" class="btn-primary" data-action="contact"><%= tr('Simuler le premier contact','Simulate first contact') %></button><% } %><% if(l.status!=='fermé'){ %><button type="button" data-action="close"><%= tr('Fermer la demande test','Close test request') %></button><% } %></div>
<% if(!l.analysis_delivered_at&&l.status!=='fermé'){ %><details><summary><%= tr('Simuler la remise de l’analyse','Simulate analysis delivery') %></summary><form data-action="delivery"><label><%= tr('Mode de remise simulé','Simulated delivery method') %><select name="deliveryMethod" required><option value=""><%= tr('Choisir…','Choose…') %></option><% Object.entries(methods).forEach(function(entry){ %><option value="<%= entry[0] %>"><%= entry[1] %></option><% }); %></select></label><label><%= tr('Précision (obligatoire pour « Autre »)','Details (required for “Other”)') %><input name="deliveryReference" maxlength="500"></label><label><input type="checkbox" name="deliveryAcknowledged" required> <%= tr('Je confirme qu’il s’agit uniquement d’une remise simulée, sans envoi de document.','I confirm this is only a simulated delivery, without sending a document.') %></label><button type="submit" class="btn-primary"><%= tr('Enregistrer la remise simulée','Record simulated delivery') %></button></form></details><% } %>
<details><summary><%= tr('Notes de test','Test notes') %></summary><form data-action="notes"><label><%= tr('Notes internes','Internal notes') %><textarea name="notes" maxlength="4000" rows="3"><%= l.notes||'' %></textarea></label><button type="submit"><%= tr('Enregistrer les notes','Save notes') %></button></form></details><p class="sandbox-status" role="status"></p></article><% }); %>
<nav aria-label="Pagination"><% if(page>1){ %><a href="admin/tests/leads?page=<%= page-1 %><%= suffix %>">← <%= tr('Précédent','Previous') %></a><% } %><span><%= tr('Page','Page') %> <%= page %></span><% if(more){ %><a href="admin/tests/leads?page=<%= page+1 %><%= suffix %>"><%= tr('Suivant','Next') %> →</a><% } %></nav></div></main><script>window.VV_SANDBOX_LEADS=<%- scriptJson({en}) %>;</script><script src="public/js/sandbox-admin-leads-v1.js" defer></script></body></html>
