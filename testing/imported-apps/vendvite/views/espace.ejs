<%- include('partials/invite-header') %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" crossorigin="">
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js" defer crossorigin=""></script>
<main class="esp">
  <div class="inv-veil" aria-hidden="true"></div>

  <header class="esp-top">
    <div class="esp-wrap esp-top-inner">
      <div>
        <span class="esp-mark">VendVite</span>
        <span class="esp-who"><%= broker.full_name %> · <%= broker.agency || '' %></span>
      </div>
      <nav class="esp-tabs" role="tablist">
        <button class="esp-tab is-on" data-tab="page" role="tab">Ma page</button>
        <button class="esp-tab" data-tab="courrier" role="tab">Courrier ciblé</button>
        <button class="esp-tab" data-tab="pistes" role="tab">Mes pistes <span class="esp-pill"><%= counts.total %></span></button>
        <button class="esp-tab" data-tab="abonnement" role="tab">Abonnement</button>
      </nav>
    </div>
  </header>

  <div class="esp-wrap">

    <!-- Status ribbon -->
    <div class="esp-status <%= isLive ? 'is-live' : (isActive ? 'is-ready' : 'is-locked') %>">
      <div class="esp-status-dot" aria-hidden="true"></div>
      <div class="esp-status-text">
        <% if (isLive) { %>
          <strong><%= isTestAccess ? 'Votre page test est en ligne.' : 'Votre page est en ligne.' %></strong>
          <a href="<%= pageUrl %>" target="_blank" rel="noopener"><%= pageUrl %></a>
        <% } else if (isActive) { %>
          <strong><%= isTestAccess ? 'Accès test actif.' : 'Abonnement actif.' %></strong> Votre page est prête — publiez-la quand vous le souhaitez.
        <% } else { %>
          <strong>Page en préparation.</strong> Bâtissez-la librement&nbsp;; l'activation ouvre la capture de pistes.
        <% } %>
      </div>
      <div class="esp-status-act">
        <a class="esp-ghost" href="espace/apercu" target="_blank" rel="noopener">Aperçu</a>
        <% if (isActive) { %>
          <button class="esp-btn" id="pubBtn" data-published="<%= broker.published %>"><%= Number(broker.published)===1 ? 'Retirer' : 'Publier' %></button>
        <% } else { %>
          <button class="esp-btn" data-goto="abonnement"><%= paypalMode==='sandbox'?'Tester PayPal':'Activer — '+price.total.toFixed(2)+' $' %></button>
        <% } %>
      </div>
    </div>

    <!-- ═══ Ma page ═══ -->
    <section class="esp-panel is-on" data-panel="page">
      <div class="esp-grid">
        <div class="esp-col">
          <h2 class="esp-h">Votre identité</h2>
          <div class="esp-portrait">
            <div class="esp-portrait-img" id="portraitBox">
              <% if (profile.agent_photo_url) { %><img src="<%= profile.agent_photo_url %>" alt="" id="portraitImg"><% } else { %><span id="portraitEmpty">Aucune photo</span><img id="portraitImg" hidden alt=""><% } %>
            </div>
            <div>
              <label class="esp-upload">
                <input type="file" id="photoInput" accept="image/png,image/jpeg,image/webp" hidden>
                <span>Téléverser une photo</span>
              </label>
              <p class="esp-hint" id="photoHint">JPG, PNG ou WebP · 8&nbsp;Mo max</p>
              <p class="esp-help">Votre portrait — affiché dans la section «&nbsp;Votre courtier&nbsp;» de votre page et comme image de partage sur les réseaux sociaux.</p>
            </div>
          </div>
          <div class="esp-f"><label for="f_agent_name">Nom affiché</label><input id="f_agent_name" data-k="agent_name" value="<%= profile.agent_name || broker.full_name %>">
            <p class="esp-help">Votre nom tel qu'il apparaît partout&nbsp;: barre du haut, section courtier, pied de page.</p></div>
          <div class="esp-f"><label for="f_agent_title">Titre</label><input id="f_agent_title" data-k="agent_title" placeholder="<%= t.agent_title %>" value="<%= profile.agent_title || '' %>">
            <p class="esp-help">Votre titre professionnel, sous votre nom dans la section courtier. Vide = «&nbsp;<%= t.agent_title %>&nbsp;».</p></div>
          <div class="esp-f"><label for="f_agency">Agence</label><input id="f_agency" data-k="agency" value="<%= profile.agency || broker.agency || '' %>">
            <p class="esp-help">Le nom de votre agence, affiché sous votre titre dans la section courtier.</p></div>
          <div class="esp-2">
            <div class="esp-f"><label for="f_agent_phone">Téléphone</label><input id="f_agent_phone" data-k="agent_phone" value="<%= profile.agent_phone || broker.phone || '' %>">
              <p class="esp-help">Bouton d'appel dans la barre du haut de votre page.</p></div>
            <div class="esp-f"><label for="f_agent_email">Courriel</label><input id="f_agent_email" data-k="agent_email" value="<%= profile.agent_email || broker.email %>">
              <p class="esp-help">C'est ici que chaque nouvelle piste vous est envoyée — jamais affiché publiquement.</p></div>
          </div>

          <h2 class="esp-h">À propos de vous</h2>
          <div class="esp-f"><label for="f_about">Votre présentation</label>
            <textarea id="f_about" data-k="about" rows="4" placeholder="<%= t.agent_credo %>"><%= profile.about || '' %></textarea>
            <p class="esp-help">Le paragraphe de la section «&nbsp;L'agent&nbsp;» de votre page — votre philosophie, votre approche, en une ou deux phrases. Vide = le texte grisé ci-dessus reste affiché.</p></div>
        </div>

        <div class="esp-col">
          <h2 class="esp-h">Votre accroche</h2>
          <div class="esp-f"><label for="f_hero_title">Titre principal</label><textarea id="f_hero_title" data-k="hero_title" rows="2" placeholder="<%= t.hero_title %>"><%= profile.hero_title || '' %></textarea>
            <p class="esp-help">Le grand titre en haut de votre page. Vide = le texte grisé ci-dessus reste affiché.</p></div>
          <div class="esp-f"><label for="f_hero_sub">Sous-titre</label><textarea id="f_hero_sub" data-k="hero_sub" rows="3" placeholder="<%= t.hero_sub %>"><%= profile.hero_sub || '' %></textarea>
            <p class="esp-help">Le paragraphe sous le titre — votre promesse au vendeur. Vide = texte par défaut.</p></div>
          <div class="esp-f"><label for="f_hero_note">Note sous le champ</label><input id="f_hero_note" data-k="hero_note" placeholder="<%= t.hero_note %>" value="<%= profile.hero_note || '' %>">
            <p class="esp-help">La ligne rassurante sous le champ d'adresse (frais, délai de réponse…). Vide = texte par défaut.</p></div>

          <h2 class="esp-h">Vos chiffres</h2>
          <p class="esp-hint">Affichés dans la section «&nbsp;Les preuves en chiffres&nbsp;». Un champ vide garde la valeur du modèle.</p>
          <div class="esp-2">
            <div class="esp-f"><label for="f_stat_homes">Propriétés vendues</label><input id="f_stat_homes" data-k="stat_homes" placeholder="<%= settings.stat_homes_sold || '0' %>" value="<%= profile.stat_homes || '' %>">
              <p class="esp-help">Nombre total de propriétés que vous avez vendues.</p></div>
            <div class="esp-f"><label for="f_stat_days">Jours au marché</label><input id="f_stat_days" data-k="stat_days" placeholder="<%= settings.stat_avg_days || '0' %>" value="<%= profile.stat_days || '' %>">
              <p class="esp-help">Durée moyenne avant vente, en jours.</p></div>
          </div>
          <div class="esp-2">
            <div class="esp-f"><label for="f_stat_ratio">Ratio vendu/demandé</label><input id="f_stat_ratio" data-k="stat_ratio" placeholder="<%= settings.stat_list_to_sale || '0' %>" value="<%= profile.stat_ratio || '' %>">
              <p class="esp-help">Prix vendu vs prix demandé, en % (le «&nbsp;%&nbsp;» s'ajoute tout seul).</p></div>
            <div class="esp-f"><label for="f_stat_volume">Volume (M$)</label><input id="f_stat_volume" data-k="stat_volume" placeholder="<%= settings.stat_career_volume || '0' %>" value="<%= profile.stat_volume || '' %>">
              <p class="esp-help">Volume de carrière en millions de dollars (le «&nbsp;M$&nbsp;» s'ajoute tout seul).</p></div>
          </div>
        </div>
      </div>

      <h2 class="esp-h">Vos liens</h2>
      <p class="esp-hint">Facebook, Instagram, LinkedIn, YouTube et TikTok deviennent des icônes au pied de page&nbsp;; les autres liens (site d'agence, fiche Centris…) s'affichent en boutons. Aucun lien = rien n'apparaît.</p>
      <div id="linkList" class="esp-links"></div>
      <button class="esp-ghost" id="addLink" type="button">+ Ajouter un lien</button>

      <h2 class="esp-h">Vos témoignages</h2>
      <p class="esp-hint">Laissez vide pour afficher les témoignages par défaut de la page.</p>
      <div id="tmList" class="esp-links"></div>
      <button class="esp-ghost" id="addTm" type="button">+ Ajouter un témoignage</button>

      <div class="esp-savebar">
        <span class="esp-saved" id="savedFlag"></span>
        <button class="esp-btn" id="saveBtn" type="button">Enregistrer</button>
      </div>
    </section>

    <!-- ═══ Courrier ciblé ═══ -->
    <section class="esp-panel" data-panel="courrier">

      <div class="camp-hero">
        <div class="camp-hero-txt">
          <p class="esp-eyebrow">Inclus dans votre licence · Postes Canada</p>
          <h2>Désignez une rue. Nous frappons les portes les plus proches.</h2>
          <p>Vous entrez une adresse&nbsp;; nous dessinons le territoire autour d'elle et sortons les adresses civiques les plus proches — voisins immédiats de votre inscription, de votre dernière vente, du secteur que vous voulez posséder. Chaque lettre porte votre nom, votre agence et un code QR qui mène à votre page.</p>
          <div class="camp-badges">
            <span><b><%= campCible %></b>portes incluses</span>
            <span><b><%= campHeures %>&nbsp;h</b>avant le dépôt</span>
            <span><b>+<%= campPalier %></b>par palier ensuite</span>
          </div>
        </div>
        <div class="camp-hero-seal">
          <div class="camp-seal-n"><%= campQuota.restantes %></div>
          <div class="camp-seal-l"><%= campQuota.restantes > 1 ? 'campagnes incluses' : 'campagne incluse' %><br>cette année</div>
        </div>
      </div>

      <!-- ── La lettre elle-même, dans la même zone que l'offre ── -->
      <article class="camp-lettre">
        <div class="camp-lettre-vue">
          <div class="camp-sheet" id="campSheet">
            <iframe id="campLettre" src="espace/lettre-proprietaires?_embed=1" title="Aperçu de votre lettre" loading="lazy" tabindex="-1" scrolling="no"></iframe>
          </div>
        </div>
        <div class="camp-lettre-txt">
          <p class="esp-eyebrow">Ce qui entre dans la boîte</p>
          <h3>Votre lettre, telle qu'elle sera imprimée.</h3>
          <p>Noir et blanc, une page, prête pour Postes Canada. Votre nom, votre agence, vos coordonnées et un code QR unique vers <strong><%= pageUrl %></strong>. C'est exactement ce document que reçoivent vos voisins, quel que soit le nombre de portes choisi — l'aperçu ci-contre est la pièce elle-même, pas une maquette.</p>
          <a class="esp-btn" href="espace/lettre-proprietaires" target="_blank" rel="noopener">Ouvrir en grand et imprimer</a>
          <% if (!isActive) { %><p class="esp-mail-warning">Activez votre abonnement, puis publiez votre page&nbsp;: le code QR doit mener quelque part.</p>
          <% } else if (!isLive) { %><p class="esp-mail-warning">Publiez votre page avant de distribuer la lettre afin que le code QR soit actif.</p><% } %>
        </div>
      </article>

      <article class="camp-card">
        <% if (!isActive) { %>
          <div class="esp-mail-lock"><strong>Abonnement requis</strong><span>Votre campagne de <%= campCible %> adresses est comprise dans la licence annuelle. Activez-la pour l'utiliser.</span><button class="esp-ghost" type="button" data-goto="abonnement">Voir l'abonnement</button></div>
        <% } else if (!isLive) { %>
          <div class="esp-mail-lock"><strong>Publiez votre page d'abord</strong><span>Le code QR imprimé sur chaque lettre doit mener à une page en ligne, sinon la campagne part dans le vide.</span><button class="esp-ghost" type="button" data-goto="page">Retour à ma page</button></div>
        <% } %>

        <div class="camp-qte">
          <div>
            <label>Combien de portes&nbsp;?</label>
            <div class="camp-stepper">
              <button type="button" id="campMoins" aria-label="Retirer un palier">−</button>
              <span id="campQte"><%= campCible %></span>
              <button type="button" id="campPlus" aria-label="Ajouter un palier">+</button>
            </div>
            <p class="esp-help">Par paliers de <%= campPalier %>. <% if (campQuota.creditPortes > 0) { %>Vos <%= campQuota.creditPortes %> portes incluses se déduisent de <strong>n'importe quelle</strong> taille de commande&nbsp;; le reste est à <%= (campPrixCents/100).toFixed(2).replace('.', ',') %>&nbsp;$ la lettre, taxes en sus.<% } else { %><%= (campPrixCents/100).toFixed(2).replace('.', ',') %>&nbsp;$ la lettre, taxes en sus.<% } %></p>
          </div>
          <div class="camp-prix" id="campPrix"></div>
        </div>

        <div class="camp-search">
          <div class="esp-f">
            <label for="campAdresse">L'adresse au cœur du secteur que vous voulez travailler</label>
            <div class="camp-ac">
              <input id="campAdresse" type="text" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="campSuggest" placeholder="Ex.&nbsp;: 1088 rue de Chambord, Saint-Jérôme" maxlength="200">
              <ul class="camp-suggest" id="campSuggest" role="listbox" hidden></ul>
            </div>
            <p class="esp-help">Commencez à taper&nbsp;: choisissez l'adresse dans la liste pour un point exact. C'est de là que partent les plus proches voisins.</p>
          </div>
          <button class="esp-btn" id="campChercher" type="button">Voir mon territoire</button>
        </div>
        <p class="camp-etat" id="campEtat" role="status"></p>
        <p class="esp-error" id="campErreur" role="alert"></p>

        <div id="campResultat" hidden>
          <div class="camp-stats">
            <div class="camp-stat"><span class="camp-stat-n" id="campNombre">0</span><span class="camp-stat-l">adresses retenues</span></div>
            <div class="camp-stat"><span class="camp-stat-n" id="campPortee">—</span><span class="camp-stat-l">la plus éloignée</span></div>
            <div class="camp-stat"><span class="camp-stat-n" id="campTrouve">0</span><span class="camp-stat-l">balayées au total</span></div>
          </div>
          <p class="camp-centre">Centre du territoire&nbsp;: <span id="campCentreTxt"></span></p>
          <div class="camp-carte" id="campCarte"></div>
          <div class="camp-rues" id="campRues"></div>
          <details class="camp-details">
            <summary>Voir les adresses retenues</summary>
            <ol class="camp-liste" id="campListe"></ol>
          </details>
          <div class="esp-f">
            <label for="campNotes">Une précision pour notre équipe&nbsp;? (facultatif)</label>
            <textarea id="campNotes" rows="2" maxlength="1000" placeholder="Ex.&nbsp;: éviter les tours à condos, viser les unifamiliales…"></textarea>
          </div>
          <div class="camp-promesse">
            <strong>Dès votre confirmation, nous prenons le relais.</strong>
            <span>Nous validons la liste, complétons les codes postaux, imprimons vos lettres et les déposons à Postes Canada <b>sous <%= campHeures %>&nbsp;heures ouvrables</b>. Vous n'avez rien d'autre à faire.</span>
          </div>
          <% if (campModePaypal === 'sandbox') { %>
            <p class="camp-sandbox">Mode test PayPal actif&nbsp;: un achat de palier supplémentaire ne prélève aucun argent réel et sera identifié comme un essai.</p>
          <% } %>
          <button class="esp-btn esp-btn-wide" id="campConfirmer" type="button" disabled>Confirmer et lancer l'envoi</button>
          <p class="esp-mail-success" id="campSucces" role="status"></p>
          <p class="esp-hint">Les adresses proviennent des données cartographiques publiques. Nous validons chaque liste à la main avant impression&nbsp;; un numéro inexistant est retiré sans vous être facturé.</p>
        </div>
      </article>

      <!-- ── Historique ── -->
      <article class="camp-histo-card">
        <h3>Vos campagnes</h3>
        <% if (!campagnes.length) { %>
          <p class="esp-hint">Aucune campagne pour l'instant. La première est comprise dans votre licence.</p>
        <% } else { %>
          <div class="camp-histo-t-head"><span>État</span><span>Territoire</span><span>Portes</span><span>Montant</span><span>Date</span></div>
          <% campagnes.forEach(function(c){
               var libelle = c.centre_label ? c.centre_label.split(',').slice(0,2).join(',') : (c.city || '—');
               var annulee = c.status === 'cancelled';
               var etat = annulee ? 'Abandonnée'
                        : c.status === 'mailed' ? 'Postée'
                        : c.payment_status === 'pending' ? 'Paiement en attente'
                        : 'En préparation';
               var cls  = annulee ? 'is-off'
                        : c.status === 'mailed' ? 'is-ok'
                        : c.payment_status === 'pending' ? 'is-wait' : '';
               // Tant qu'elle n'est pas payée, la campagne reste modifiable :
               // son territoire se recharge dans le sélecteur tel qu'il était.
               var reprenable = c.payment_status !== 'paid' && c.status !== 'mailed' && Number(c.address_count) > 0;
          %>
            <div class="camp-histo-l">
              <span class="camp-histo-b <%= cls %>"><%= etat %><% if (Number(c.is_test) === 1) { %> · test<% } %></span>
              <span class="camp-histo-t" title="<%= c.centre_label || '' %>"><%= libelle %></span>
              <span class="camp-histo-q"><%= c.address_count %></span>
              <span class="camp-histo-m"><%= c.kind === 'paid' ? ((c.total_cents||0)/100).toFixed(2).replace('.', ',') + ' $' : 'Incluse' %></span>
              <span class="camp-histo-d"><%= new Date(c.created_at).toLocaleDateString('fr-CA', { day:'numeric', month:'short', year:'numeric' }) %></span>
              <% if (reprenable || c.payment_status === 'pending') { %>
                <span class="camp-histo-act">
                  <% if (reprenable) { %>
                    <button type="button" class="camp-histo-x" data-reprendre="<%= c.id %>">Recharger ce territoire</button>
                  <% } %>
                  <% if (c.payment_status === 'pending') { %>
                    <button type="button" class="camp-histo-x" data-annuler="<%= c.id %>">Annuler et récupérer ma campagne incluse</button>
                  <% } %>
                </span>
              <% } %>
            </div>
          <% }); %>
        <% } %>
      </article>
    </section>

    <!-- ═══ Mes pistes ═══ -->
    <section class="esp-panel" data-panel="pistes">
      <div class="esp-stats">
        <div class="esp-stat"><span class="esp-stat-n"><%= counts.total %></span><span class="esp-stat-l">Pistes au total</span></div>
        <div class="esp-stat"><span class="esp-stat-n"><%= counts.fresh %></span><span class="esp-stat-l">Nouvelles</span></div>
        <div class="esp-stat"><span class="esp-stat-n"><%= counts.recent %></span><span class="esp-stat-l">30 derniers jours</span></div>
      </div>
      <% if (!leads.length) { %>
        <div class="esp-empty">
          <div class="esp-empty-sigil" aria-hidden="true">&#10022;</div>
          <h3>Aucune piste pour l'instant.</h3>
          <p><% if (!isLive) { %>Publiez votre page pour commencer à recevoir des demandes d'évaluation.<% } else { %>Votre page est en ligne. Les demandes apparaîtront ici et vous serez averti par courriel.<% } %></p>
        </div>
      <% } else { %>
        <div class="esp-leads">
          <% leads.forEach(function(l){ %>
            <article class="esp-lead" data-id="<%= l.id %>">
              <div class="esp-lead-head">
                <div>
                  <h3><%= l.name %></h3>
                  <p class="esp-lead-addr"><%= l.address || '' %></p>
                </div>
                <select class="esp-lead-status" data-id="<%= l.id %>">
                  <% ['nouveau','contacté','évalué','fermé'].forEach(function(s){ %>
                    <option value="<%= s %>" <%= (l.status===s?'selected':'') %>><%= s %></option>
                  <% }); %>
                </select>
              </div>
              <div class="esp-lead-meta">
                <% if (l.phone) { %><a href="tel:<%= String(l.phone).replace(/\D/g,'') %>"><%= formatPhone(l.phone) %></a><% } %>
                <% if (l.email) { %><a href="mailto:<%= l.email %>"><%= l.email %></a><% } %>
                <% if (l.timeframe) { %><span><%= l.timeframe %></span><% } %>
                <span class="esp-lead-when"><%= formatDate(l.created_at, lang) %></span>
              </div>
              <textarea class="esp-lead-notes" data-id="<%= l.id %>" rows="2" placeholder="Notes privées…"><%= l.notes || '' %></textarea>
            </article>
          <% }); %>
        </div>
      <% } %>
    </section>

    <!-- ═══ Abonnement ═══ -->
    <section class="esp-panel" data-panel="abonnement">
      <% if (paymentTest) { %>
        <div class="esp-payment-success is-test">
          <span class="esp-payment-check" aria-hidden="true">◇</span>
          <div><strong>Test PayPal réussi. Votre accès d’essai est ouvert.</strong><p>Aucun paiement réel. Vous pouvez maintenant publier votre page, tester le code QR, recevoir une piste et demander une campagne ciblée.</p></div>
        </div>
      <% } %>
      <% if (paymentConfirmed) { %>
        <div class="esp-payment-success">
          <span class="esp-payment-check" aria-hidden="true">✓</span>
          <div><strong>Paiement confirmé. Votre licence est active.</strong><p>Votre facture VendVite est disponible ci-dessous et une copie vous est envoyée par courriel.</p></div>
        </div>
      <% } %>
      <div class="esp-bill">
        <div class="esp-bill-card">
          <p class="esp-eyebrow">Adhésion annuelle</p>
          <% if (paypalMode === 'sandbox') { %><div class="esp-sandbox-flag"><strong>MODE TEST PAYPAL</strong><span>Compte sandbox seulement · aucun argent réel · accès d’essai isolé</span></div><% } %>
          <h2 class="esp-price"><%= price.base.toFixed(2) %>&nbsp;$ <span>/ an</span></h2>
          <ul class="esp-bill-lines">
            <li><span>Adhésion</span><span><%= price.base.toFixed(2) %>&nbsp;$</span></li>
            <li><span>TPS (5&nbsp;%)</span><span><%= price.gst.toFixed(2) %>&nbsp;$</span></li>
            <li><span>TVQ (9,975&nbsp;%)</span><span><%= price.qst.toFixed(2) %>&nbsp;$</span></li>
            <li class="esp-bill-total"><span>Total</span><span><%= price.total.toFixed(2) %>&nbsp;$</span></li>
          </ul>
          <% if (isTestAccess) { %>
            <div class="esp-active-note">
              <strong>Accès test actif</strong>
              <p>Parcours complet disponible jusqu’au <%= formatDate(broker.paypal_sandbox_expires_at, lang) %>, uniquement en mode sandbox.</p>
            </div>
            <p class="esp-hint" style="text-align:center">La publication, les pistes et les demandes de campagne sont des essais clairement identifiés et ne comptent pas comme une vente.</p>
          <% } else if (broker.status === 'cancelled' && broker.membership_expires_at) { %>
            <div class="esp-active-note">
              <strong>Renouvellement annulé</strong>
              <p>Votre page reste en ligne jusqu'au <%= formatDate(broker.membership_expires_at, lang) %>.</p>
            </div>
            <button class="esp-btn esp-btn-wide" id="subBtn" type="button">Réactiver</button>
          <% } else if (isActive) { %>
            <div class="esp-active-note">
              <strong>Abonnement actif</strong>
              <p>Renouvellement le <%= formatDate(broker.membership_expires_at, lang) %>.</p>
            </div>
            <% if(paypalMode==='live'){ %><button class="esp-ghost esp-danger" id="cancelBtn" type="button">Annuler le renouvellement</button><% } else { %><p class="esp-hint" style="text-align:center">Votre abonnement réel est protégé pendant les essais sandbox. Repassez en mode réel pour gérer son renouvellement.</p><% } %>
          <% } else { %>
            <button class="esp-btn esp-btn-wide" id="subBtn" type="button"><%= paypalMode==='sandbox'?'Tester l’abonnement PayPal':'Activer ma page' %></button>
            <p class="esp-hint" style="text-align:center">Paiement sécurisé par PayPal. Annulable en tout temps.</p>
          <% } %>
          <p class="esp-error" id="billError" role="alert"></p>
        </div>
        <div>
          <ul class="esp-bill-what">
            <li>Votre page privée, à votre nom, sur vendvite.app</li>
            <li>Capture illimitée de demandes d'évaluation</li>
            <li>Alerte courriel instantanée à chaque piste</li>
            <li>Votre registre de pistes, à vous seul</li>
            <li>Modifications en tout temps, sans frais</li>
          </ul>
          <% if (invoices && invoices.length) { %>
            <div class="esp-invoices">
              <p class="esp-eyebrow">Mes factures</p>
              <% invoices.forEach(function(invoice){ %>
                <a class="esp-invoice-row" href="espace/factures/<%= invoice.id %>/pdf">
                  <span><strong><%= invoice.invoice_number %></strong><small><%= formatDate(invoice.payment_time, lang) %><% if(Number(invoice.is_test)===1||invoice.is_test===true){ %> · TEST — sans valeur comptable<% } %></small></span>
                  <span><b><%= (Number(invoice.total_cents || 0) / 100).toFixed(2).replace('.', ',') %>&nbsp;$</b><small>PDF ↓</small></span>
                </a>
              <% }); %>
            </div>
          <% } %>
        </div>
      </div>
    </section>
  </div>
</main>
<script>
  window.VV = {
    profile: <%- JSON.stringify(profile) %>,
    published: <%= Number(broker.published) === 1 ? 'true' : 'false' %>,
    active: <%= isActive ? 'true' : 'false' %>,
    live: <%= isLive ? 'true' : 'false' %>
    ,paypalMode: <%- JSON.stringify(paypalMode) %>
  };
  window.VV_CAMP = { cible: <%= campCible %>, restantes: <%= campQuota.restantes %>, palier: <%= campPalier %>, max: <%= campMax %>, paliers: <%- JSON.stringify(campPaliers) %>, peutPayer: <%= campPeutPayer ? 'true' : 'false' %>, mode: <%- JSON.stringify(campModePaypal) %>, credit: <%= campQuota.creditPortes %> };
</script>
<script src="public/js/espace.js" defer></script>
</body>
</html>
