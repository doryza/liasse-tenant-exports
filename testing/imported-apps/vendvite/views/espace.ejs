<%- include('partials/invite-header') %>
<% if (activePage === 'courrier') { %>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" crossorigin="">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js" defer crossorigin=""></script>
<% } %>
<main class="esp">
  <div class="inv-veil" aria-hidden="true"></div>

  <header class="esp-top">
    <div class="esp-wrap esp-top-inner">
      <div class="esp-brand">
        <span class="esp-mark">VendVite</span>
        <span class="esp-who"><%= broker.full_name %> · <%= broker.agency || '' %></span>
      </div>
      <nav class="esp-tabs" aria-label="<%= lang==='en' ? 'Broker space' : 'Espace courtier' %>">
        <a class="esp-tab <%= activePage==='page'?'is-on':'' %>" href="espace" <%- activePage==='page'?'aria-current="page"':'' %>><%= t.esp_nav_my_page %></a>
        <a class="esp-tab <%= activePage==='courrier'?'is-on':'' %>" href="espace/courrier-cible" <%- activePage==='courrier'?'aria-current="page"':'' %>><%= t.esp_nav_targeted_mail %></a>
        <a class="esp-tab <%= activePage==='pistes'?'is-on':'' %>" href="espace/pistes" <%- activePage==='pistes'?'aria-current="page"':'' %>><%= t.esp_nav_my_leads %> <span class="esp-pill"><%= counts.total %></span></a>
        <a class="esp-tab <%= activePage==='abonnement'?'is-on':'' %>" href="espace/abonnement" <%- activePage==='abonnement'?'aria-current="page"':'' %>><%= t.esp_nav_subscription %></a>
      </nav>
    </div>
  </header>

  <div class="esp-wrap">

    <!-- Activation offer / live status -->
    <% if (activePage === 'page' && !isActive) { %>
      <section class="esp-launch <%= setupComplete ? 'is-complete' : '' %>" aria-labelledby="espLaunchTitle">
        <div class="esp-launch-copy">
          <p class="esp-eyebrow"><%= t.esp_launch_eyebrow %></p>
          <h1 id="espLaunchTitle"><%= setupComplete ? t.esp_launch_complete_title : t.esp_launch_title %></h1>
          <p class="esp-launch-lede"><%= t.esp_launch_body %></p>
          <p class="esp-launch-mobile-summary"><%= t.esp_launch_mobile_summary %></p>
          <div class="esp-launch-actions">
            <a class="esp-ghost" href="espace/apercu" target="_blank" rel="noopener"><%= t.esp_launch_preview_page %> <span aria-hidden="true">↗</span></a>
            <% if (!setupComplete) { %>
              <button class="esp-btn esp-ready-btn" id="setupDoneBtn" type="button"><%= t.esp_launch_mark_done %></button>
            <% } else { %>
              <span class="esp-ready-status"><%= t.esp_launch_done_status %></span>
            <% } %>
          </div>
          <p class="esp-error" id="setupDoneError" role="alert"></p>
        </div>
        <% if (setupComplete) { %>
          <aside class="esp-launch-offer" aria-label="<%= t.esp_launch_offer %>">
            <p><%= t.esp_launch_price_reveal %></p>
            <div class="esp-launch-price"><strong><%= price.base.toFixed(0) %></strong><span>$<small>/ <%= lang==='en'?'year':'an' %></small></span></div>
            <a class="esp-btn esp-launch-cta" href="espace/abonnement"><%= paypalMode==='sandbox'?'Tester PayPal':t.esp_launch_cta %></a>
          </aside>
        <% } %>
      </section>
    <% } else if (activePage === 'page') { %>
      <div class="esp-status <%= isLive ? 'is-live' : 'is-ready' %>">
        <div class="esp-status-dot" aria-hidden="true"></div>
        <div class="esp-status-text">
          <% if (isLive) { %>
            <strong><%= isTestAccess ? t.esp_test_page_live : t.esp_page_live %></strong>
            <a href="<%= pageUrl %>" target="_blank" rel="noopener"><%= pageUrl %></a>
          <% } else { %>
            <strong><%= isTestAccess ? 'Accès test actif.' : 'Abonnement actif.' %></strong> Votre page est prête — publiez-la quand vous le souhaitez.
          <% } %>
        </div>
        <div class="esp-status-act">
          <a class="esp-ghost" href="espace/apercu" target="_blank" rel="noopener"><%= t.esp_preview_button %></a>
          <button class="esp-btn" id="pubBtn" data-published="<%= broker.published %>"><%= Number(broker.published)===1 ? 'Retirer' : 'Publier' %></button>
        </div>
      </div>
    <% } %>

    <!-- ═══ Ma page ═══ -->
    <% if (activePage === 'page') { %>
    <section class="esp-panel is-on" data-panel="page">
      <div class="esp-panel-head">
        <p class="esp-eyebrow"><%= t.esp_setup_eyebrow %></p>
        <h2><%= t.esp_setup_title %></h2>
        <p><%= t.esp_setup_body %></p>
      </div>
      <div class="esp-grid">
        <div class="esp-col">
          <h2 class="esp-h"><%= t.esp_section_your_identity %></h2>
          <div class="esp-portrait">
            <div class="esp-portrait-img" id="portraitBox">
              <span class="esp-portrait-empty" id="portraitEmpty" <%= profile.agent_photo_url ? 'hidden' : '' %>><i aria-hidden="true"></i><b><%= t.esp_no_photo_placeholder %></b></span>
              <img id="portraitImg" src="<%= profile.agent_photo_url || '' %>" <%= profile.agent_photo_url ? '' : 'hidden' %> alt="" onerror="this.hidden=true;var fallback=document.getElementById('portraitEmpty');if(fallback)fallback.hidden=false">
            </div>
            <div class="esp-portrait-copy">
              <label class="esp-upload">
                <input type="file" id="photoInput" accept="image/png,image/jpeg,image/webp" hidden>
                <span><%= t.esp_upload_photo_button %></span>
              </label>
              <p class="esp-hint" id="photoHint"><%- t.esp_photo_format_size_hint %></p>
              <p class="esp-help"><%- t.esp_portrait_field_help %></p>
            </div>
          </div>
          <div class="esp-f"><label for="f_agent_name"><%= t.esp_display_name_label %></label><input id="f_agent_name" data-k="agent_name" value="<%= profile.agent_name || broker.full_name %>">
            <p class="esp-help"><%- t.esp_display_name_help %></p></div>
          <div class="esp-f"><label for="f_agent_title"><%= t.esp_title_label %></label><input id="f_agent_title" data-k="agent_title" placeholder="<%= t.agent_title %>" value="<%= profile.agent_title || t.agent_title %>">
            <p class="esp-help"><%- t.esp_title_help_lead %><%= t.agent_title %><%- t.esp_title_help_tail %></p></div>
          <div class="esp-f"><label for="f_agency"><%= t.esp_agency_label %></label><input id="f_agency" data-k="agency" value="<%= profile.agency || broker.agency || '' %>">
            <p class="esp-help"><%= t.esp_agency_help %></p></div>
          <div class="esp-2">
            <div class="esp-f"><label for="f_agent_phone"><%= t.esp_phone_label %></label><input id="f_agent_phone" data-k="agent_phone" value="<%= profile.agent_phone || broker.phone || '' %>">
              <p class="esp-help"><%= t.esp_phone_help %></p></div>
            <div class="esp-f"><label for="f_agent_email"><%= t.esp_email_label %></label><input id="f_agent_email" data-k="agent_email" value="<%= profile.agent_email || broker.email %>">
              <p class="esp-help"><%= t.esp_email_help %></p></div>
          </div>

          <h2 class="esp-h"><%= t.esp_section_about_you %></h2>
          <div class="esp-f"><label for="f_about"><%= t.esp_bio_label %></label>
            <textarea id="f_about" data-k="about" rows="6" placeholder="<%= t.agent_credo %>"><%= profile.about || t.agent_credo %></textarea>
            <p class="esp-help"><%- t.esp_bio_help %></p></div>
          <div class="esp-f"><label for="f_agency_disclaimer"><%= t.esp_disclaimer_label %></label><textarea id="f_agency_disclaimer" data-k="agency_disclaimer" rows="3" placeholder="<%= t.esp_disclaimer_ph %>" maxlength="300"><%= profile.agency_disclaimer || t.footer_disclaimer %></textarea>
            <p class="esp-help"><%= t.esp_disclaimer_help %></p></div>
        </div>

        <div class="esp-col">
          <h2 class="esp-h"><%= t.esp_section_your_hook %></h2>
          <div class="esp-f"><label for="f_hero_title"><%= t.esp_main_headline_label %></label><textarea id="f_hero_title" data-k="hero_title" rows="3" placeholder="<%= t.hero_title %>"><%= profile.hero_title || t.hero_title %></textarea>
            <p class="esp-help"><%= t.esp_main_headline_help %></p></div>
          <div class="esp-f"><label for="f_hero_sub"><%= t.esp_subtitle_label %></label><textarea id="f_hero_sub" data-k="hero_sub" rows="5" placeholder="<%= t.hero_sub %>"><%= profile.hero_sub || t.hero_sub %></textarea>
            <p class="esp-help"><%= t.esp_subtitle_help %></p></div>
          <div class="esp-f"><label for="f_hero_note"><%= t.esp_note_under_field_label %></label><input id="f_hero_note" data-k="hero_note" placeholder="<%= t.hero_note %>" value="<%= profile.hero_note || t.hero_note %>">
            <p class="esp-help"><%= t.esp_note_under_field_help %></p></div>

          <h2 class="esp-h"><%= t.esp_section_your_numbers %></h2>
          <p class="esp-hint"><%- t.esp_stats_shown_in_proof_section %></p>
          <div class="esp-2">
            <div class="esp-f"><label for="f_stat_homes"><%= t.esp_stat_properties_sold_label %></label><input id="f_stat_homes" data-k="stat_homes" placeholder="<%= settings.stat_homes_sold || '0' %>" value="<%= profile.stat_homes || '' %>">
              <p class="esp-help"><%= t.esp_stat_properties_sold_help %></p></div>
            <div class="esp-f"><label for="f_stat_days"><%= t.esp_stat_days_on_market_label %></label><input id="f_stat_days" data-k="stat_days" placeholder="<%= settings.stat_avg_days || '0' %>" value="<%= profile.stat_days || '' %>">
              <p class="esp-help"><%= t.esp_stat_days_on_market_help %></p></div>
          </div>
          <div class="esp-2">
            <div class="esp-f"><label for="f_stat_ratio"><%= t.esp_stat_sold_to_list_ratio_label %></label><input id="f_stat_ratio" data-k="stat_ratio" placeholder="<%= settings.stat_list_to_sale || '0' %>" value="<%= profile.stat_ratio || '' %>">
              <p class="esp-help"><%- t.esp_stat_sold_to_list_ratio_help %></p></div>
            <div class="esp-f"><label for="f_stat_volume"><%= t.esp_stat_volume_millions_label %></label><input id="f_stat_volume" data-k="stat_volume" placeholder="<%= settings.stat_career_volume || '0' %>" value="<%= profile.stat_volume || '' %>">
              <p class="esp-help"><%- t.esp_stat_volume_millions_help %></p></div>
          </div>
        </div>
      </div>

      <h2 class="esp-h"><%= t.esp_your_links_heading %></h2>
      <p class="esp-hint"><%- t.esp_links_icons_vs_buttons_help %></p>
      <div id="linkList" class="esp-links"></div>
      <button class="esp-ghost" id="addLink" type="button"><%= t.esp_add_link_button %></button>

      <h2 class="esp-h"><%= t.esp_your_testimonials_heading %></h2>
      <p class="esp-hint"><%= t.esp_testimonials_default_help %></p>
      <div id="tmList" class="esp-links"></div>
      <button class="esp-ghost" id="addTm" type="button"><%= t.esp_add_testimonial_button %></button>

      <div class="esp-savebar">
        <span class="esp-saved" id="savedFlag"></span>
        <button class="esp-btn" id="saveBtn" type="button"><%= t.esp_save_button %></button>
      </div>
    </section>
    <% } %>

    <!-- ═══ Courrier ciblé ═══ -->
    <% if (activePage === 'courrier') { %>
    <section class="esp-panel is-on" data-panel="courrier">

      <div class="camp-production" role="note">
        <div class="camp-production-copy">
          <p class="esp-eyebrow"><%= t.esp_campaign_included_canada_post %></p>
          <strong><%= t.esp_campaign_name_street_tagline %></strong>
          <span><%- t.esp_campaign_territory_explainer %></span>
        </div>
        <div class="camp-production-steps" aria-label="<%= t.esp_campaign_name_street_tagline %>">
          <span><i>1</i><%= t.esp_production_step_data %></span>
          <span><i>2</i><%= t.esp_production_step_print %></span>
          <span><i>3</i><%= t.esp_production_step_deposit %></span>
        </div>
      </div>

      <!-- ── La lettre elle-même, dans la même zone que l'offre ── -->
      <article class="camp-lettre">
        <div class="camp-lettre-vue">
          <div class="camp-sheet" id="campSheet">
            <iframe id="campLettre" src="espace/lettre-proprietaires?_embed=1" title="<%= t.esp_letter_preview_alt %>" loading="lazy" tabindex="-1" scrolling="no"></iframe>
          </div>
        </div>
        <div class="camp-lettre-txt">
          <p class="esp-eyebrow"><%= t.esp_letter_mailbox_heading %></p>
          <h3><%= t.esp_letter_as_printed_line %></h3>
          <p><%= t.esp_letter_spec_before_page_url %> <strong><%= pageUrl %></strong><%= t.esp_letter_spec_after_page_url %></p>
          <a class="esp-btn" href="espace/lettre-proprietaires" target="_blank" rel="noopener"><%= t.esp_letter_open_print %></a>
          <% if (!isActive) { %><p class="esp-mail-warning"><%- t.esp_activate_sub_then_publish_qr %></p>
          <% } else if (!isLive) { %><p class="esp-mail-warning"><%= t.esp_publish_before_letter_notice %></p><% } %>
        </div>
      </article>

      <article class="camp-card">
        <% if (!isActive) { %>
          <div class="esp-mail-lock"><strong><%= t.esp_subscription_required_badge %></strong><span><%- t.esp_lock_membership_lead %><%= campCible %><%- t.esp_lock_membership_tail %></span><a class="esp-ghost" href="espace/abonnement"><%= t.esp_view_subscription_link %></a></div>
        <% } else if (!isLive) { %>
          <div class="esp-mail-lock"><strong><%= t.esp_publish_page_first_title %></strong><span><%= t.esp_qr_needs_live_page_warning %></span><a class="esp-ghost" href="espace"><%= t.esp_back_to_my_page %></a></div>
        <% } %>

        <div class="camp-qte">
          <div>
            <label><%- t.esp_how_many_doors_question %></label>
            <div class="camp-stepper">
              <button type="button" id="campMoins" aria-label="<%= t.esp_remove_tier_button %>">−</button>
              <span id="campQte"><%= campCible %></span>
              <button type="button" id="campPlus" aria-label="<%= t.esp_add_tier_button %>">+</button>
            </div>
            <p class="esp-help"><%- t.esp_tiers_of_lead %><%= campPalier %><%- t.esp_tiers_of_tail %> <% if (campQuota.creditPortes > 0) { %><%- t.esp_credit_applies_lead %><%= campQuota.creditPortes %><%- t.esp_credit_applies_mid %> <strong><%= t.esp_deducted_from_any %></strong> <%- t.esp_credit_rest_lead %><%= (campPrixCents/100).toFixed(2).replace('.', ',') %><%- t.esp_credit_rest_tail %><% } else { %><%= (campPrixCents/100).toFixed(2).replace('.', ',') %><%- t.esp_per_letter_taxes_extra %><% } %></p>
          </div>
          <div class="camp-prix" id="campPrix"></div>
        </div>

        <div class="camp-search">
          <div class="esp-f">
            <label for="campAdresse"><%= t.esp_area_centre_address_label %></label>
            <div class="camp-ac">
              <input id="campAdresse" type="text" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="campSuggest" placeholder="<%- t.esp_civic_address_example_ph %>" maxlength="200">
              <ul class="camp-suggest" id="campSuggest" role="listbox" hidden></ul>
            </div>
            <p class="esp-help"><%- t.esp_address_autocomplete_hint %></p>
          </div>
          <button class="esp-btn" id="campChercher" type="button"><%= t.esp_see_my_territory_button %></button>
        </div>
        <p class="camp-etat" id="campEtat" role="status"></p>
        <p class="esp-error" id="campErreur" role="alert"></p>

        <div id="campResultat" hidden>
          <div class="camp-stats">
            <div class="camp-stat"><span class="camp-stat-n" id="campNombre">0</span><span class="camp-stat-l"><%= t.esp_stat_addresses_selected %></span></div>
            <div class="camp-stat"><span class="camp-stat-n" id="campPortee">—</span><span class="camp-stat-l"><%= t.esp_stat_farthest_address %></span></div>
            <div class="camp-stat"><span class="camp-stat-n" id="campTrouve">0</span><span class="camp-stat-l"><%= t.esp_stat_total_swept %></span></div>
          </div>
          <p class="camp-centre"><%- t.esp_territory_centre_label %> <span id="campCentreTxt"></span></p>
          <div class="camp-carte" id="campCarte"></div>
          <div class="camp-rues" id="campRues"></div>
          <details class="camp-details">
            <summary><%= t.esp_view_selected_addresses_link %></summary>
            <ol class="camp-liste" id="campListe"></ol>
          </details>
          <div class="esp-f">
            <label for="campNotes"><%- t.esp_team_note_optional_label %></label>
            <textarea id="campNotes" rows="3" maxlength="1000" placeholder="<%- t.esp_team_note_placeholder %>"></textarea>
          </div>
          <div class="camp-promesse">
            <strong><%= t.esp_after_confirm_we_take_over %></strong>
            <span><%= t.esp_fulfilment_steps_lead %> <b><%- t.esp_within_hours_lead %><%= campHeures %><%- t.esp_within_hours_tail %></b><%= t.esp_nothing_else_to_do_tail %></span>
          </div>
          <% if (campModePaypal === 'sandbox') { %>
            <p class="camp-sandbox"><%- t.esp_paypal_test_mode_notice %></p>
          <% } %>
          <button class="esp-btn esp-btn-wide" id="campConfirmer" type="button" disabled><%= t.esp_confirm_launch_mailing_btn %></button>
          <p class="esp-mail-success" id="campSucces" role="status"></p>
          <p class="esp-hint"><%- t.esp_address_source_manual_check %></p>
        </div>
      </article>

      <!-- ── Historique ── -->
      <article class="camp-histo-card">
        <h3><%= t.esp_your_campaigns_heading %></h3>
        <% if (!campagnes.length) { %>
          <p class="esp-hint"><%= t.esp_no_campaigns_first_included %></p>
        <% } else { %>
          <div class="camp-histo-t-head"><span><%= t.esp_campaign_col_status %></span><span><%= t.esp_campaign_col_territory %></span><span><%= t.esp_campaign_col_doors %></span><span><%= t.esp_campaign_col_amount %></span><span><%= t.esp_campaign_col_date %></span></div>
          <% campagnes.forEach(function(c){
               var libelle = c.centre_label ? c.centre_label.split(',').slice(0,2).join(',') : (c.city || '—');
               var annulee = c.status === 'cancelled';
               var etat = annulee ? 'Abandonnée'
                        : c.status === 'mailed' ? 'Postée'
                        : c.payment_status === 'pending' ? 'Paiement en attente'
                        : 'En préparation';
               var cls  = annulee ? 'is-off'
                        : c.status === 'mailed' ? 'is-ok'
                        : c.payment_status === 'pending' ? 'is-wait' : '';
               // Tant qu'elle n'est pas payée, la campagne reste modifiable :
               // son territoire se recharge dans le sélecteur tel qu'il était.
               var reprenable = c.payment_status !== 'paid' && c.status !== 'mailed' && Number(c.address_count) > 0;
          %>
            <div class="camp-histo-l">
              <span class="camp-histo-b <%= cls %>"><%= etat %><% if (Number(c.is_test) === 1) { %> · test<% } %></span>
              <span class="camp-histo-t" title="<%= c.centre_label || '' %>"><%= libelle %></span>
              <span class="camp-histo-q"><%= c.address_count %></span>
              <span class="camp-histo-m"><%= c.kind === 'paid' ? ((c.total_cents||0)/100).toFixed(2).replace('.', ',') + ' $' : 'Incluse' %></span>
              <span class="camp-histo-d"><%= new Date(c.created_at).toLocaleDateString('fr-CA', { day:'numeric', month:'short', year:'numeric' }) %></span>
              <% if (reprenable || c.payment_status === 'pending') { %>
                <span class="camp-histo-act">
                  <% if (reprenable) { %>
                    <button type="button" class="camp-histo-x" data-reprendre="<%= c.id %>"><%= t.esp_territory_reload_btn %></button>
                  <% } %>
                  <% if (c.payment_status === 'pending') { %>
                    <button type="button" class="camp-histo-x" data-annuler="<%= c.id %>"><%= t.esp_cancel_reclaim_included_btn %></button>
                  <% } %>
                </span>
              <% } %>
            </div>
          <% }); %>
        <% } %>
      </article>
    </section>
    <% } %>

    <!-- ═══ Mes pistes ═══ -->
    <% if (activePage === 'pistes') { %>
    <section class="esp-panel is-on" data-panel="pistes">
      <div class="esp-stats">
        <div class="esp-stat"><span class="esp-stat-n"><%= counts.total %></span><span class="esp-stat-l"><%= t.esp_leads_total_label %></span></div>
        <div class="esp-stat"><span class="esp-stat-n"><%= counts.fresh %></span><span class="esp-stat-l"><%= t.esp_leads_new_label %></span></div>
        <div class="esp-stat"><span class="esp-stat-n"><%= counts.recent %></span><span class="esp-stat-l"><%= t.esp_leads_last_30_days_label %></span></div>
      </div>
      <% if (!leads.length) { %>
        <div class="esp-empty">
          <div class="esp-empty-sigil" aria-hidden="true">&#10022;</div>
          <h3><%= t.esp_leads_empty_state %></h3>
          <p><% if (!isLive) { %><%= t.esp_leads_empty_unpublished %><% } else { %><%= t.esp_leads_empty_published %><% } %></p>
        </div>
      <% } else { %>
        <div class="esp-leads">
          <% leads.forEach(function(l){ %>
            <article class="esp-lead" data-id="<%= l.id %>">
              <div class="esp-lead-head">
                <div>
                  <h3><%= l.name %></h3>
                  <p class="esp-lead-addr"><%= l.address || '' %></p>
                </div>
                <select class="esp-lead-status" data-id="<%= l.id %>">
                  <% ['nouveau','contacté','évalué','fermé'].forEach(function(s){ %>
                    <option value="<%= s %>" <%= (l.status===s?'selected':'') %>><%= s %></option>
                  <% }); %>
                </select>
              </div>
              <div class="esp-lead-meta">
                <% if (l.phone) { %><a href="tel:<%= String(l.phone).replace(/\D/g,'') %>"><%= formatPhone(l.phone) %></a><% } %>
                <% if (l.email) { %><a href="mailto:<%= l.email %>"><%= l.email %></a><% } %>
                <% if (l.timeframe) { %><span><%= l.timeframe %></span><% } %>
                <span class="esp-lead-when"><%= formatDate(l.created_at, lang) %></span>
              </div>
              <textarea class="esp-lead-notes" data-id="<%= l.id %>" rows="2" placeholder="<%= t.esp_lead_private_notes_ph %>"><%= l.notes || '' %></textarea>
            </article>
          <% }); %>
        </div>
      <% } %>
    </section>
    <% } %>

    <!-- ═══ Abonnement ═══ -->
    <% if (activePage === 'abonnement') { %>
    <section class="esp-panel is-on" data-panel="abonnement">
      <% if (paymentTest) { %>
        <div class="esp-payment-success is-test">
          <span class="esp-payment-check" aria-hidden="true">◇</span>
          <div><strong><%= t.esp_paypal_test_success_title %></strong><p><%= t.esp_paypal_test_success_body %></p></div>
        </div>
      <% } %>
      <% if (paymentConfirmed) { %>
        <div class="esp-payment-success">
          <span class="esp-payment-check" aria-hidden="true">✓</span>
          <div><strong><%= t.esp_payment_confirmed_licence_active %></strong><p><%= t.esp_invoice_available_emailed %></p></div>
        </div>
      <% } %>
      <div class="esp-bill">
        <div class="esp-bill-card">
          <% if (!isActive && !setupComplete) { %>
            <p class="esp-eyebrow"><%= t.esp_setup_gate_eyebrow %></p>
            <h2 class="esp-gate-title"><%= t.esp_setup_gate_title %></h2>
            <p class="esp-gate-body"><%= t.esp_setup_gate_body %></p>
            <a class="esp-btn esp-btn-wide esp-gate-cta" href="espace"><%= t.esp_setup_gate_cta %></a>
          <% } else { %>
          <p class="esp-eyebrow"><%= t.esp_annual_membership_heading %></p>
          <% if (paypalMode === 'sandbox') { %><div class="esp-sandbox-flag"><strong><%= t.esp_paypal_test_mode_badge %></strong><span><%= t.esp_test_account_only_note %></span></div><% } %>
          <h2 class="esp-price"><%= price.base.toFixed(2) %>&nbsp;$ <span>/ an</span></h2>
          <ul class="esp-bill-lines">
            <li><span><%= t.esp_invoice_line_membership %></span><span><%= price.base.toFixed(2) %>&nbsp;$</span></li>
            <li><span><%- t.esp_invoice_line_gst %></span><span><%= price.gst.toFixed(2) %>&nbsp;$</span></li>
            <li><span><%- t.esp_invoice_line_qst %></span><span><%= price.qst.toFixed(2) %>&nbsp;$</span></li>
            <li class="esp-bill-total"><span><%= t.esp_invoice_line_total %></span><span><%= price.total.toFixed(2) %>&nbsp;$</span></li>
          </ul>
          <% if (isTestAccess) { %>
            <div class="esp-active-note">
              <strong><%= t.esp_test_access_active_title %></strong>
              <p><%- t.esp_sandbox_until_lead %><%= formatDate(broker.paypal_sandbox_expires_at, lang) %><%- t.esp_sandbox_until_tail %></p>
            </div>
            <p class="esp-hint" style="text-align:center"><%= t.esp_test_actions_not_a_sale %></p>
          <% } else if (broker.status === 'cancelled' && broker.membership_expires_at) { %>
            <div class="esp-active-note">
              <strong><%= t.esp_renewal_cancelled_title %></strong>
              <p><%- t.esp_page_online_until_lead %><%= formatDate(broker.membership_expires_at, lang) %><%- t.esp_page_online_until_tail %></p>
            </div>
            <button class="esp-btn esp-btn-wide" id="subBtn" type="button"><%= t.esp_reactivate_btn %></button>
          <% } else if (isActive) { %>
            <div class="esp-active-note">
              <strong><%= t.esp_subscription_active_title %></strong>
              <p><%- t.esp_renews_on_lead %><%= formatDate(broker.membership_expires_at, lang) %><%- t.esp_renews_on_tail %></p>
            </div>
            <% if(paypalMode==='live'){ %><button class="esp-ghost esp-danger" id="cancelBtn" type="button"><%= t.esp_cancel_renewal_btn %></button><% } else { %><p class="esp-hint" style="text-align:center"><%= t.esp_real_subscription_protected_test %></p><% } %>
          <% } else { %>
            <button class="esp-btn esp-btn-wide" id="subBtn" type="button"><%= paypalMode==='sandbox'?'Tester l’abonnement PayPal':'Activer ma page' %></button>
            <p class="esp-hint" style="text-align:center"><%= t.esp_paypal_secure_cancel_anytime %></p>
          <% } %>
          <p class="esp-error" id="billError" role="alert"></p>
          <% } %>
        </div>
        <div>
          <ul class="esp-bill-what">
            <li><%= t.esp_perk_targeted_campaign_included %></li>
            <li><%= t.esp_perk_private_page_named %></li>
            <li><%= t.esp_perk_unlimited_valuation_capture %></li>
            <li><%= t.esp_perk_instant_lead_email_alert %></li>
            <li><%= t.esp_perk_private_lead_register %></li>
            <li><%= t.esp_perk_free_edits_anytime %></li>
          </ul>
          <% if (invoices && invoices.length) { %>
            <div class="esp-invoices">
              <p class="esp-eyebrow"><%= t.esp_invoices_heading %></p>
              <% invoices.forEach(function(invoice){ %>
                <a class="esp-invoice-row" href="espace/factures/<%= invoice.id %>/pdf">
                  <span><strong><%= invoice.invoice_number %></strong><small><%= formatDate(invoice.payment_time, lang) %><% if(Number(invoice.is_test)===1||invoice.is_test===true){ %> · TEST — sans valeur comptable<% } %></small></span>
                  <span><b><%= (Number(invoice.total_cents || 0) / 100).toFixed(2).replace('.', ',') %>&nbsp;$</b><small>PDF ↓</small></span>
                </a>
              <% }); %>
            </div>
          <% } %>
        </div>
      </div>
    </section>
    <% } %>
  </div>
</main>
<script>
  window.VV = {
    profile: <%- JSON.stringify(profile) %>,
    published: <%= Number(broker.published) === 1 ? 'true' : 'false' %>,
    active: <%= isActive ? 'true' : 'false' %>,
    live: <%= isLive ? 'true' : 'false' %>
    ,paypalMode: <%- JSON.stringify(paypalMode) %>
  };
  // Dictionnaire du panneau, filtre au prefixe : le navigateur ne recoit que
  // ce qu'il affiche, dans la langue choisie.
  window.VV_T = <%- JSON.stringify(Object.keys(t).filter(function(k){return k.indexOf('esp_')===0;}).reduce(function(o,k){o[k]=t[k];return o;},{})) %>;
  window.VV_CAMP = { cible: <%= campCible %>, restantes: <%= campQuota.restantes %>, palier: <%= campPalier %>, max: <%= campMax %>, paliers: <%- JSON.stringify(campPaliers) %>, peutPayer: <%= campPeutPayer ? 'true' : 'false' %>, mode: <%- JSON.stringify(campModePaypal) %>, credit: <%= campQuota.creditPortes %> };
</script>
<script src="public/js/espace.js" defer></script>
</body>
</html>
