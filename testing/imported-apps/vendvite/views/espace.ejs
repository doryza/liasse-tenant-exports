<%- include('partials/invite-header') %>
<% if (activePage === 'courrier') { %>
  <link rel="stylesheet" href="public/vendor/leaflet/leaflet.css" crossorigin="">
  <script src="public/vendor/leaflet/leaflet.js" defer crossorigin=""></script>
<% } %>
<main class="esp ws-workspace <%= activePage==='courrier'?'cs-workspace':'' %>">
  <div class="inv-veil" aria-hidden="true"></div>

  <header class="esp-top">
    <div class="esp-wrap esp-top-inner">
      <div class="esp-brand">
        <a class="esp-mark" href="espace">VendVite<span class="ws-brand-dot">.</span></a>
        <span class="esp-who"><%= broker.full_name %> · <%= broker.agency || '' %></span>
      </div>
      <nav class="esp-tabs" aria-label="<%= lang==='en' ? 'Broker space' : 'Espace courtier' %>">
        <a data-vv-auth class="esp-tab <%= activePage==='accueil'?'is-on':'' %>" href="espace" <%- activePage==='accueil'?'aria-current="page"':'' %>><%= t.ws_home %></a>
        <a data-vv-auth class="esp-tab <%= activePage==='page'?'is-on':'' %>" href="espace/page" <%- activePage==='page'?'aria-current="page"':'' %>><%= t.esp_nav_my_page %></a>
        <a data-vv-auth class="esp-tab <%= activePage==='courrier'?'is-on':'' %>" href="espace/courrier-cible" <%- activePage==='courrier'?'aria-current="page"':'' %>><%= t.esp_nav_targeted_mail %></a>
        <a data-vv-auth class="esp-tab <%= activePage==='pistes'?'is-on':'' %>" href="espace/pistes" <%- activePage==='pistes'?'aria-current="page"':'' %>><%= t.ws_leads %> <span class="esp-pill"><%= counts.total %></span></a>
        <a data-vv-auth class="esp-tab <%= activePage==='abonnement'?'is-on':'' %>" href="espace/abonnement" <%- activePage==='abonnement'?'aria-current="page"':'' %>><%= t.esp_nav_subscription %></a>
        <a data-vv-auth class="esp-tab <%= activePage==='compte'?'is-on':'' %>" href="espace/compte" <%- activePage==='compte'?'aria-current="page"':'' %>><%= t.ws_account %></a>
      </nav>
    </div>
  </header>

  <div class="esp-wrap">
    <div id="workspaceNotice" class="ws-notice" role="status" aria-live="polite" hidden><span id="workspaceNoticeText"></span> <a data-vv-auth id="workspaceReconnect" href="connexion" target="_blank" rel="noopener" hidden><%= t.ws_session_link %> ↗</a></div>
    <% if(activePage==='accueil'){ %><%- include('partials/workspace-overview') %><% } %>
    <% if(activePage==='compte'){ %><%- include('partials/workspace-account') %><% } %>


    <% if(activePage==='page'){ %>
    <section class="ws-profile-heading"><div><p class="ws-eyebrow"><%= t.ws_setup_eyebrow %></p><h1><%= t.ws_setup_title %></h1></div></section>
    <div class="ws-editor-actions" id="pageActions" role="region" aria-label="<%= t.ws_profile %>">
      <div class="ws-editor-status"><div class="ws-editor-summary"><strong id="profileMilestone"><%= isLive?t.ws_live:setupComplete?t.ws_profile_ready:t.ws_draft %></strong><a href="espace/apercu" target="_blank" rel="noopener"><%= t.ws_preview %> ↗</a></div><span class="esp-saved" id="savedFlag" role="status" aria-live="polite"><%= setupComplete?t.ws_saved:t.ws_profile_save_hint %></span></div>
      <div class="ws-editor-buttons">
        <button class="<%= isLive?'esp-btn':'esp-ghost' %>" id="saveBtn" type="button"><%= t.esp_save_button %></button>
        <% if(!isLive){ %><button class="esp-btn" data-publish="true" type="button"><%= t.ws_step_publish %></button><% }else{ %><a class="esp-ghost" href="<%= pageUrl %>" target="_blank" rel="noopener"><%= t.ws_view_live %> ↗</a><% } %>
      </div>
      <% if(!isLive){ %><p class="ws-action-hint"><%= isActive?t.ws_publish_hint:t.ws_publish_member_hint %></p><% } %>
    </div>
    <% } %>

    <!-- ═══ Ma page ═══ -->
    <% if (activePage === 'page') { %>
    <section class="esp-panel is-on" data-panel="page">
      <p class="ws-muted"><%= isLive?t.ws_setup_live_body:t.ws_setup_body %></p>
      <div class="esp-grid">
        <div class="esp-col">
          <h2 class="esp-h"><%= t.esp_section_your_identity %></h2>
          <div class="esp-portrait">
            <div class="esp-portrait-img" id="portraitBox">
              <span class="esp-portrait-empty" id="portraitEmpty" <%= profile.agent_photo_url ? 'hidden' : '' %>><i aria-hidden="true"></i><b><%= t.esp_no_photo_placeholder %></b></span>
              <img id="portraitImg" src="<%= profile.agent_photo_url || '' %>" <%= profile.agent_photo_url ? '' : 'hidden' %> alt="" onerror="this.hidden=true;var fallback=document.getElementById('portraitEmpty');if(fallback)fallback.hidden=false">
            </div>
            <div class="esp-portrait-copy">
              <label class="esp-upload">
                <input type="file" id="photoInput" accept="image/png,image/jpeg,image/webp" hidden>
                <span><%= t.esp_upload_photo_button %></span>
              </label>
              <p class="esp-hint" id="photoHint"><%- t.esp_photo_format_size_hint %></p>
              <p class="esp-help"><%- t.esp_portrait_field_help %></p>
            </div>
          </div>
          <div class="esp-f"><label for="f_agent_name"><%= t.esp_display_name_label %></label><input id="f_agent_name" data-k="agent_name" value="<%= profile.agent_name || broker.full_name %>">
            <p class="esp-help"><%- t.esp_display_name_help %></p></div>
          <div class="esp-f"><label for="f_agent_title"><%= t.esp_title_label %></label><input id="f_agent_title" data-k="agent_title" placeholder="<%= t.agent_title %>" value="<%= profile.agent_title || t.agent_title %>">
            <p class="esp-help"><%- t.esp_title_help_lead %><%= t.agent_title %><%- t.esp_title_help_tail %></p></div>
          <div class="esp-f"><label for="f_agency"><%= t.esp_agency_label %></label><input id="f_agency" data-k="agency" value="<%= profile.agency || broker.agency || '' %>">
            <p class="esp-help"><%= t.esp_agency_help %></p></div>
          <div class="esp-2">
            <div class="esp-f"><label for="f_agent_phone"><%= t.esp_phone_label %></label><input id="f_agent_phone" data-k="agent_phone" value="<%= profile.agent_phone || broker.phone || '' %>">
              <p class="esp-help"><%= t.esp_phone_help %></p></div>
            <div class="esp-f"><label for="f_agent_email"><%= t.esp_email_label %></label><input id="f_agent_email" data-k="agent_email" value="<%= profile.agent_email || broker.email %>">
              <p class="esp-help"><%= t.esp_email_help %></p></div>
          </div>

          <h2 class="esp-h"><%= t.esp_section_about_you %></h2>
          <div class="esp-f"><label for="f_about"><%= t.esp_bio_label %></label>
            <textarea id="f_about" data-k="about" rows="6" placeholder="<%= t.agent_credo %>"><%= profile.about || t.agent_credo %></textarea>
            <p class="esp-help"><%- t.esp_bio_help %></p></div>
          <div class="esp-f"><label for="f_agency_disclaimer"><%= t.esp_disclaimer_label %></label><textarea id="f_agency_disclaimer" data-k="agency_disclaimer" rows="3" placeholder="<%= t.esp_disclaimer_ph %>" maxlength="300"><%= profile.agency_disclaimer || t.footer_disclaimer %></textarea>
            <p class="esp-help"><%= t.esp_disclaimer_help %></p></div>
        </div>

        <div class="esp-col">
          <h2 class="esp-h"><%= t.esp_section_your_hook %></h2>
          <div class="esp-f"><label for="f_hero_title"><%= t.esp_main_headline_label %></label><textarea id="f_hero_title" data-k="hero_title" rows="3" placeholder="<%= t.hero_title %>"><%= profile.hero_title || t.hero_title %></textarea>
            <p class="esp-help"><%= t.esp_main_headline_help %></p></div>
          <div class="esp-f"><label for="f_hero_sub"><%= t.esp_subtitle_label %></label><textarea id="f_hero_sub" data-k="hero_sub" rows="5" placeholder="<%= t.hero_sub %>"><%= profile.hero_sub || t.hero_sub %></textarea>
            <p class="esp-help"><%= t.esp_subtitle_help %></p></div>
          <div class="esp-f"><label for="f_hero_note"><%= t.esp_note_under_field_label %></label><input id="f_hero_note" data-k="hero_note" placeholder="<%= t.hero_note %>" value="<%= profile.hero_note || t.hero_note %>">
            <p class="esp-help"><%= t.esp_note_under_field_help %></p></div>

          <h2 class="esp-h"><%= t.esp_section_your_numbers %></h2>
          <p class="esp-hint"><%= lang==='fr' ? 'Vos chiffres apparaissent dans votre présentation. Laissez un champ vide pour le masquer.' : 'Your figures appear in your profile. Leave a field empty to hide it.' %></p>
          <div class="esp-2">
            <div class="esp-f"><label for="f_stat_homes"><%= t.esp_stat_properties_sold_label %></label><input id="f_stat_homes" data-k="stat_homes" placeholder="—" value="<%= profile.stat_homes || '' %>">
              <p class="esp-help"><%= t.esp_stat_properties_sold_help %></p></div>
            <div class="esp-f"><label for="f_stat_days"><%= t.esp_stat_days_on_market_label %></label><input id="f_stat_days" data-k="stat_days" placeholder="—" value="<%= profile.stat_days || '' %>">
              <p class="esp-help"><%= t.esp_stat_days_on_market_help %></p></div>
          </div>
          <div class="esp-2">
            <div class="esp-f"><label for="f_stat_ratio"><%= t.esp_stat_sold_to_list_ratio_label %></label><input id="f_stat_ratio" data-k="stat_ratio" placeholder="—" value="<%= profile.stat_ratio || '' %>">
              <p class="esp-help"><%- t.esp_stat_sold_to_list_ratio_help %></p></div>
            <div class="esp-f"><label for="f_stat_volume"><%= t.esp_stat_volume_millions_label %></label><input id="f_stat_volume" data-k="stat_volume" placeholder="—" value="<%= profile.stat_volume || '' %>">
              <p class="esp-help"><%- t.esp_stat_volume_millions_help %></p></div>
          </div>
        </div>
      </div>

      <h2 class="esp-h"><%= t.esp_your_links_heading %></h2>
      <p class="esp-hint"><%- t.esp_links_icons_vs_buttons_help %></p>
      <div id="linkList" class="esp-links"></div>
      <button class="esp-ghost" id="addLink" type="button"><%= t.esp_add_link_button %></button>

      <h2 class="esp-h"><%= t.esp_your_testimonials_heading %></h2>
      <p class="esp-hint"><%= t.esp_testimonials_default_help %></p>
      <div id="tmList" class="esp-links"></div>
      <button class="esp-ghost" id="addTm" type="button"><%= t.esp_add_testimonial_button %></button>

      <% if(isLive){ %><div class="ws-ready"><button class="esp-ghost" id="pubBtn" data-publish="false" type="button"><%= t.ws_unpublish %></button></div><% } %>
    </section>
    <% } %>

    <% if(activePage==='courrier'){ %><%- include('partials/campaign-studio') %><% } %>

    <!-- ═══ Mes pistes ═══ -->
    <% if (activePage === 'pistes') { %>
    <section class="esp-panel is-on" data-panel="pistes">
      <h1 class="ws-section-title"><%= t.ws_leads %></h1>
      <div class="esp-stats">
        <div class="esp-stat"><span class="esp-stat-n"><%= counts.total %></span><span class="esp-stat-l"><%= t.esp_leads_total_label %></span></div>
        <div class="esp-stat"><span class="esp-stat-n"><%= counts.fresh %></span><span class="esp-stat-l"><%= t.esp_leads_new_label %></span></div>
        <div class="esp-stat"><span class="esp-stat-n"><%= counts.recent %></span><span class="esp-stat-l"><%= t.esp_leads_last_30_days_label %></span></div>
      </div>
      <% if (!leads.length) { %>
        <div class="esp-empty">
          <div class="esp-empty-sigil" aria-hidden="true">&#10022;</div>
          <h3><%= t.esp_leads_empty_state %></h3>
          <p><% if (!isLive) { %><%= t.esp_leads_empty_unpublished %><% } else { %><%= t.esp_leads_empty_published %><% } %></p>
        </div>
      <% } else { %>
        <div class="ws-lead-filters"><label><span><%= t.ws_filter %></span><input id="leadSearch" type="search" placeholder="<%= t.ws_search %>"></label><label><span><%= t.ws_lead_status %></span><select id="leadFilter"><option value=""><%= t.ws_all %></option><% ['nouveau','contacté','évalué','fermé'].forEach(function(status,i){ %><option value="<%= status %>"><%= [t.ws_status_new,t.ws_status_contacted,t.ws_status_valued,t.ws_status_closed][i] %></option><% }); %></select></label></div><p id="leadNoMatches" class="ws-muted" hidden><%= t.ws_no_matches %></p>
        <div class="esp-leads">
          <% leads.forEach(function(l){ %>
            <article class="esp-lead" data-id="<%= l.id %>">
              <div class="esp-lead-head">
                <div>
                  <h3><%= l.name %></h3>
                  <p class="esp-lead-addr"><%= l.address || '' %></p>
                </div>
                <select class="esp-lead-status" data-id="<%= l.id %>" aria-label="<%= t.ws_lead_status %>">
                  <% ['nouveau','contacté','évalué','fermé'].forEach(function(s,i){ %>
                    <option value="<%= s %>" <%= (l.status===s?'selected':'') %>><%= [t.ws_status_new,t.ws_status_contacted,t.ws_status_valued,t.ws_status_closed][i] %></option>
                  <% }); %>
                </select>
              </div>
              <div class="esp-lead-meta">
                <% if (l.phone) { %><a href="tel:<%= String(l.phone).replace(/\D/g,'') %>"><%= formatPhone(l.phone) %></a><% } %>
                <% if (l.email) { %><a href="mailto:<%= l.email %>"><%= l.email %></a><% } %>
                <% if (l.timeframe) { %><span><%= l.timeframe %></span><% } %>
                <span class="esp-lead-when"><%= formatDate(l.created_at, lang) %></span>
              </div>
              <textarea class="esp-lead-notes" data-id="<%= l.id %>" rows="2" aria-label="<%= t.ws_notes %>" placeholder="<%= t.esp_lead_private_notes_ph %>"><%= l.notes || '' %></textarea><div class="ws-lead-save"><span data-lead-save="<%= l.id %>" role="status" aria-live="polite"></span><button class="esp-ghost" type="button" data-lead-retry="<%= l.id %>" hidden><%= t.ws_reload %></button></div>
            </article>
          <% }); %>
        </div>
      <% } %>
    </section>
    <% } %>

    <!-- ═══ Abonnement ═══ -->
    <% if (activePage === 'abonnement') { %>
    <section class="esp-panel is-on" data-panel="abonnement">
      <% if (paymentTest) { %>
        <div class="esp-payment-success is-test">
          <span class="esp-payment-check" aria-hidden="true">◇</span>
          <div><strong><%= t.esp_paypal_test_success_title %></strong><p><%= t.esp_paypal_test_success_body %></p></div>
        </div>
      <% } %>
      <% if (paymentConfirmed) { %>
        <div class="esp-payment-success">
          <span class="esp-payment-check" aria-hidden="true">✓</span>
          <div><strong><%= t.esp_payment_confirmed_licence_active %></strong><p><%= t.esp_invoice_available_emailed %></p></div>
        </div>
      <% } %>
      <div class="esp-bill">
        <div class="esp-bill-card">
          <% if (!isActive && !setupComplete) { %>
            <p class="esp-eyebrow"><%= t.esp_setup_gate_eyebrow %></p>
            <h2 class="esp-gate-title"><%= t.esp_setup_gate_title %></h2>
            <p class="esp-gate-body"><%= t.esp_setup_gate_body %></p>
            <a class="esp-btn esp-btn-wide esp-gate-cta" href="espace/page"><%= t.esp_setup_gate_cta %></a>
          <% } else { %>
          <p class="esp-eyebrow"><%= t.esp_annual_membership_heading %></p>
          <% if (paypalMode === 'sandbox') { %><div class="esp-sandbox-flag"><strong><%= t.esp_paypal_test_mode_badge %></strong><span><%= t.esp_test_account_only_note %></span></div><% } %>
          <h2 class="esp-price"><%= price.base.toFixed(2) %>&nbsp;$ <span>/ an</span></h2>
          <ul class="esp-bill-lines">
            <li><span><%= t.esp_invoice_line_membership %></span><span><%= price.base.toFixed(2) %>&nbsp;$</span></li>
            <li><span><%- t.esp_invoice_line_gst %></span><span><%= price.gst.toFixed(2) %>&nbsp;$</span></li>
            <li><span><%- t.esp_invoice_line_qst %></span><span><%= price.qst.toFixed(2) %>&nbsp;$</span></li>
            <li class="esp-bill-total"><span><%= t.esp_invoice_line_total %></span><span><%= price.total.toFixed(2) %>&nbsp;$</span></li>
          </ul>
          <% if (isTestAccess) { %>
            <div class="esp-active-note">
              <strong><%= t.esp_test_access_active_title %></strong>
              <p><%- t.esp_sandbox_until_lead %><%= formatDate(broker.paypal_sandbox_expires_at, lang) %><%- t.esp_sandbox_until_tail %></p>
            </div>
            <p class="esp-hint" style="text-align:center"><%= t.esp_test_actions_not_a_sale %></p>
          <% } else if (broker.status === 'cancelled' && broker.membership_expires_at) { %>
            <div class="esp-active-note">
              <strong><%= t.esp_renewal_cancelled_title %></strong>
              <p><%- t.esp_page_online_until_lead %><%= formatDate(broker.membership_expires_at, lang) %><%- t.esp_page_online_until_tail %></p>
            </div>
            <button class="esp-btn esp-btn-wide" id="subBtn" type="button"><%= t.esp_reactivate_btn %></button>
          <% } else if (isActive) { %>
            <div class="esp-active-note">
              <strong><%= t.esp_subscription_active_title %></strong>
              <p><%- t.esp_renews_on_lead %><%= formatDate(broker.membership_expires_at, lang) %><%- t.esp_renews_on_tail %></p>
            </div>
            <% if(paypalMode==='live'){ %><button class="esp-ghost esp-danger" id="cancelBtn" type="button"><%= t.esp_cancel_renewal_btn %></button><% } else { %><p class="esp-hint" style="text-align:center"><%= t.esp_real_subscription_protected_test %></p><% } %>
          <% } else { %>
            <button class="esp-btn esp-btn-wide" id="subBtn" type="button"><%= paypalMode==='sandbox'?(lang==='fr'?'Tester l’abonnement PayPal':'Test the PayPal subscription'):t.esp_launch_cta %></button>
            <p class="esp-hint" style="text-align:center"><%= t.esp_paypal_secure_cancel_anytime %></p>
          <% } %>
          <p class="esp-error" id="billError" role="alert"></p>
          <% } %>
        </div>
        <div>
          <ul class="esp-bill-what">
            <li><%= t.esp_perk_targeted_campaign_included %></li>
            <li><%= t.esp_perk_private_page_named %></li>
            <li><%= t.esp_perk_unlimited_valuation_capture %></li>
            <li><%= t.esp_perk_instant_lead_email_alert %></li>
            <li><%= t.esp_perk_private_lead_register %></li>
            <li><%= t.esp_perk_free_edits_anytime %></li>
          </ul>
          <% if (invoices && invoices.length) { %>
            <div class="esp-invoices">
              <p class="esp-eyebrow"><%= t.esp_invoices_heading %></p>
              <% invoices.forEach(function(invoice){ %>
                <a class="esp-invoice-row" href="espace/factures/<%= invoice.id %>/pdf">
                  <span><strong><%= invoice.invoice_number %></strong><small><%= formatDate(invoice.payment_time, lang) %><% if(Number(invoice.is_test)===1||invoice.is_test===true){ %> · TEST — sans valeur comptable<% } %></small></span>
                  <span><b><%= (Number(invoice.total_cents || 0) / 100).toFixed(2).replace('.', ',') %>&nbsp;$</b><small>PDF ↓</small></span>
                </a>
              <% }); %>
            </div>
          <% } %>
        </div>
      </div>
    </section>
    <% } %>
  </div>
</main>
<script>
  window.VV = {
    csrf: <%- scriptJson(csrf) %>,
    profileVersion: <%= Number(broker.profile_version)||0 %>,
    profile: <%- scriptJson(profile) %>,
    published: <%= Number(broker.published) === 1 ? 'true' : 'false' %>,
    active: <%= isActive ? 'true' : 'false' %>,
    live: <%= isLive ? 'true' : 'false' %>
    ,paypalMode: <%- scriptJson(paypalMode) %>
  };
  // Dictionnaire du panneau, filtre au prefixe : le navigateur ne recoit que
  // ce qu'il affiche, dans la langue choisie.
  window.VV_T = <%- scriptJson(Object.keys(t).filter(function(k){return k.indexOf('esp_')===0||k.indexOf('ws_')===0||k.indexOf('c_')===0;}).reduce(function(o,k){o[k]=t[k];return o;},{})) %>;
  window.VV_CAMP = { id:<%= Number(broker.id) %>, lang:<%- scriptJson(lang) %>, setupComplete:<%= setupComplete?'true':'false' %>, cible: <%= campCible %>, restantes: <%= campQuota.restantes %>, palier: <%= campPalier %>, max: <%= campMax %>, paliers: <%- scriptJson(campPaliers) %>, peutPayer: <%= campPeutPayer ? 'true' : 'false' %>, mode: <%- scriptJson(campModePaypal) %>, credit: <%= campQuota.creditPortes %>, active: <%= isActive ? 'true' : 'false' %>, published: <%= Number(broker.published) === 1 ? 'true' : 'false' %>, subscriptionTotal: <%= Math.round(price.total * 100) %> };
</script>
<script src="public/js/espace.js?v=publish-v1" defer></script>
<% if(activePage==='courrier'){ %><script src="public/js/campaign-model-v1.js?v=address-counts-v1" defer></script><script src="public/js/campaign-studio-v1.js?v=address-counts-v1" defer></script><% } %>
</body>
</html>
