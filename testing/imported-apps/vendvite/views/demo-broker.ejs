<% var demoPage = true; var fr = lang === 'fr'; %>
<%- include('partials/invite-header', {demoPage:true}) %>
<main class="inv hp demo-page">
  <header class="hp-masthead hp-wrap"><a class="hp-brand" href=".?lang=<%= lang %>">VendVite<span class="hp-brand-dot">.</span></a><a class="hp-text-link" href=".?lang=<%= lang %>#invPanel"><%= fr ? 'Créer ma page — 599 $ / an' : 'Get my page — $599 / year' %> ↗</a></header>
  <div class="hp-wrap demo-notice"><strong><%= fr ? 'Vous explorez une démonstration.' : 'You are exploring a demo.' %></strong> <%= fr ? 'Richard Tremblay est un personnage fictif. Photo illustrative et affiliation RE/MAX présentées à titre d’exemple. Aucune demande n’est transmise.' : 'Richard Tremblay is fictional. Illustrative portrait and RE/MAX affiliation shown as examples. No requests are sent.' %></div>
  <section class="hp-hero hp-wrap">
    <div class="hp-pitch">
      <p class="hp-eyebrow"><%= fr ? 'Votre propriété. Votre prochain chapitre.' : 'Your property. Your next chapter.' %></p>
      <h1><%= fr ? 'Votre maison mérite une stratégie à sa mesure.' : 'Your home deserves a strategy of its own.' %></h1>
      <p class="hp-lede"><%= fr ? 'Vous songez à vendre à Montréal ou sur la Rive-Nord? Commencez par une conversation sur votre propriété, votre quartier et vos projets.' : 'Thinking of selling in Montréal or on the North Shore? Start with a conversation about your property, your neighbourhood and your plans.' %></p>
      <div class="demo-profile">
        <img src="https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=800&q=85" alt="<%= fr ? 'Portrait illustratif de Richard Tremblay' : 'Illustrative portrait of Richard Tremblay' %>" width="320" height="384" fetchpriority="high">
        <div><p class="hp-label"><%= fr ? 'Votre courtier · Profil démo' : 'Your broker · Demo profile' %></p><h2>Richard Tremblay</h2><p><%= fr ? 'Courtier immobilier résidentiel' : 'Residential real estate broker' %></p><p class="demo-remax">RE/MAX</p><p><%= fr ? 'Une approche humaine, une écoute attentive et un plan adapté à votre prochaine étape.' : 'A personal approach, attentive listening and a plan tailored to your next step.' %></p></div>
      </div>
    </div>
    <div class="hp-conversion"><div class="inv-panel">
      <p class="hp-label"><%= fr ? 'Parlons de votre propriété' : 'Let’s talk about your property' %></p>
      <h2 class="inv-panel-title"><%= fr ? 'Par où commence votre projet?' : 'Where does your next chapter begin?' %></h2>
      <p class="inv-panel-sub"><%= fr ? 'Essayez le parcours avec des coordonnées fictives.' : 'Try the experience with sample contact details.' %></p>
      <form class="inv-form" id="demoForm">
        <div class="inv-field"><label for="demoAddress"><%= fr ? 'Adresse de la propriété' : 'Property address' %></label><input id="demoAddress" placeholder="123, rue des Érables, Montréal" required maxlength="200"></div>
        <div class="inv-field"><label for="demoName"><%= fr ? 'Votre nom' : 'Your name' %></label><input id="demoName" placeholder="<%= fr ? 'Camille Exemple' : 'Alex Example' %>" required maxlength="120"></div>
        <div class="inv-field"><label for="demoEmail"><%= fr ? 'Votre courriel' : 'Your email' %></label><input id="demoEmail" type="email" placeholder="demo@example.com" required maxlength="190"></div>
        <div class="inv-field"><label for="demoTiming"><%= fr ? 'Quand pensez-vous vendre?' : 'When are you thinking of selling?' %></label><select id="demoTiming"><option><%= fr ? 'Je commence à explorer' : 'I’m starting to explore' %></option><option><%= fr ? 'Dans les 3 prochains mois' : 'Within 3 months' %></option><option><%= fr ? 'Dans les 6 prochains mois' : 'Within 6 months' %></option></select></div>
        <button class="inv-submit" type="submit"><%= fr ? 'Tester la demande d’analyse' : 'Try requesting an analysis' %> ↗</button>
        <p class="inv-fineprint"><%= fr ? 'Démonstration seulement. Aucune donnée enregistrée ou envoyée.' : 'Demo only. No information is stored or sent.' %></p>
      </form>
      <div id="demoSuccess" class="demo-success" role="status" tabindex="-1" hidden><div class="hp-success-mark">✓</div><h3><%= fr ? 'Voilà comment la conversation commence.' : 'This is how the conversation starts.' %></h3><p><%= fr ? 'Sur votre propre page VendVite, la demande du propriétaire vous est transmise pour que vous puissiez faire le suivi. Ici, aucune demande n’a été envoyée.' : 'On your own VendVite page, the homeowner’s request reaches you so you can follow up. No request was sent in this demo.' %></p><a class="hp-cta" href=".?lang=<%= lang %>#invPanel"><%= fr ? 'Je veux ma page' : 'I want my own page' %> ↗</a></div>
    </div></div>
  </section>
  <section class="hp-final hp-wrap"><p class="hp-eyebrow">VendVite</p><h2><%= fr ? 'Imaginez cette page à votre nom.' : 'Imagine this page with your name on it.' %></h2><p class="hp-lede"><%= fr ? 'Votre photo. Votre bannière. Vos demandes. Avec le créateur de campagnes et une campagne annuelle de 150 lettres inclus : 599 $ par année, plus taxes.' : 'Your portrait. Your brokerage. Your leads. With the campaign builder and an included annual 150-letter campaign: $599 per year, plus tax.' %></p><a class="hp-cta" href=".?lang=<%= lang %>#invPanel"><%= fr ? 'Demander mon accès' : 'Request access' %> ↗</a></section>
</main>
<script src="public/js/demo-broker-v1.js" defer></script>
</body></html>
