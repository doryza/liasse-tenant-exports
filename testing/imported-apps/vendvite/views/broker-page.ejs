<%- include('partials/header') %>
<% if(typeof inlineEditor!=='undefined'&&inlineEditor){ %><%- include('partials/page-editor-toolbar') %><% } %>
<% if (typeof invitation !== 'undefined' && invitation) { %>
<div class="bp-demo mailing-invitation"><div class="container bp-demo-inner"><p><strong><%= lang==='fr'?'Votre page de capture à 0 $':'Your $0 lead capture page' %></strong> · <%= lang==='fr'?'Réservée aux campagnes postales VendVite. Démonstration : aucune demande envoyée.':'Reserved for VendVite postal campaigns. Demo: no requests sent.' %></p><a href="demarrer/<%= invitation.tag %>?lang=<%= lang %>"><%= lang==='fr'?'Activer ma page à 0 $':'Activate my $0 page' %> ↗</a></div></div>
<% } %>
<% if (typeof isDemo !== 'undefined' && isDemo && !(typeof invitation !== 'undefined' && invitation)) { %>
<div class="bp-demo" role="note"><div class="container bp-demo-inner">
  <p><strong><%= lang==='fr' ? 'Profil démo' : 'Demo profile' %></strong> · <%= lang==='fr' ? 'Personnage, affiliation et chiffres fictifs. Aucune demande envoyée.' : 'Fictional identity, affiliation and figures. No requests sent.' %></p>
  <a href=".?lang=<%= lang %>#invPanel"><%= lang==='fr' ? 'Votre page — 0 $' : 'Your page — $0' %> ↗</a>
</div></div>
<% } %>
<% if (typeof isPreview !== 'undefined' && isPreview && !(typeof inlineEditor!=='undefined'&&inlineEditor)) { %>
<div class="bp-peek" role="status">
  <span class="bp-peek-dot" aria-hidden="true"></span>
  <span class="bp-peek-txt"><%= typeof isSandboxPreview!=='undefined'&&isSandboxPreview?(lang==='fr'?'Test PayPal — aperçu du destinataire. Aucune demande envoyée.':'PayPal test — recipient preview. No request is sent.'):t.bp_preview_banner %></span>
  <a class="bp-peek-btn" href="espace/page#pageActions"><%= previewPageLive?t.bp_preview_back:t.ws_step_publish %> ↗</a>
</div>
<% } %>
<script>
window.VV_INITIAL_LOCATION = <%- scriptJson(typeof initialLocation!=='undefined'?initialLocation:null) %>;
window.VV_PAGE_PREVIEW = <%- JSON.stringify(!!isPreview) %>;
window.VV_INITIAL_ADDRESS = <%- scriptJson(typeof initialAddress !== 'undefined' ? initialAddress : null) %>;
window.VV_MAILING_TOKEN = <%- scriptJson(typeof mailingToken !== 'undefined' ? mailingToken : null) %>;
window.VV_MAILING_RECIPIENT = <%- scriptJson(typeof mailingRecipient !== 'undefined' ? mailingRecipient : null) %>;
window.VV_DEMO = <%- JSON.stringify(typeof isDemo !== 'undefined' && isDemo) %>;
window.VV_BROKER = <%- JSON.stringify(typeof brokerSlug !== 'undefined' ? brokerSlug : null) %>;
window.VV_LEAD_URL = <%- JSON.stringify(typeof brokerSlug !== 'undefined' && brokerSlug
  ? ('api/courtier/' + brokerSlug + '/piste')
  : null) %>;
</script>
<main class="bp-page">
<section class="hero" id="evaluation">
  <div class="hero-topo" aria-hidden="true"></div>
  <div class="container hero-inner">
    <p class="eyebrow bp-hero-eyebrow" data-lk="t:hero_eyebrow"><%= t.hero_eyebrow %></p>
    <div class="hero-left">
      <h1 class="display" data-lk="t:hero_title"><%= t.hero_title %></h1>
      <p class="hero-sub" data-lk="t:hero_sub"><%= t.hero_sub %></p>
      <div class="address-slot">
        <label for="addressInput" data-lk="t:address_label"><%= t.address_label %></label>
        <input value="<%= initialAddress || '' %>" id="addressInput" class="addr-input" type="text" autocomplete="off" placeholder="<%= t.address_ph %>" aria-label="<%= t.address_label %>">
        <ul id="addressSuggest" class="suggest"></ul>
      </div>
      <p class="bp-broker-byline"><%= lang==='fr' ? 'Avec' : 'With' %> <strong><%= settings.agent_name %></strong> · <%= settings.agency %></p>
      <p class="hero-note" data-lk="t:hero_note"><%= t.hero_note %></p>
    </div>
    <div class="hero-right">
      <div class="fiche" id="fiche">
        <div class="fiche-topline mono"><span data-lk="t:fiche_label"><%= t.fiche_label %></span><span id="ficheRef">—</span></div>
        <div class="fiche-photo" id="fichePhoto">
          <div class="streetview" id="streetview"></div>
          <div class="fiche-photo-empty" id="fichePhotoEmpty">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 10.5 12 4l9 6.5"/><path d="M5 9.5V20h14V9.5"/><path d="M10 20v-5h4v5"/></svg>
            <span data-lk="t:fiche_photo_pending"><%= t.fiche_photo_pending %></span>
          </div>
          <div class="fiche-stamp" id="ficheStamp" hidden data-lk="t:stamp_text"><%= t.stamp_text %></div>
        </div>
        <div class="fiche-plaque">
          <div class="fiche-address" id="ficheAddress" data-lk="t:fiche_empty"><%= t.fiche_empty %></div>
          <div class="fiche-coords mono" id="ficheCoords">—</div>
        </div>
        <form class="fiche-form" id="leadForm" <%= initialAddress?'':'hidden' %>>
          <% if(initialAddress){ %><p class="bp-prefilled-note"><%= lang==='fr'?'Votre adresse est déjà inscrite. Ajoutez simplement vos coordonnées.':'Your address is already filled in. Just add your contact details.' %> <button id="changeRecipientAddress" type="button"><%= lang==='fr'?'Modifier l’adresse':'Change address' %></button></p><% } %>
          <div class="field"><label for="leadName" data-lk="t:form_name"><%= t.form_name %></label><input id="leadName" type="text" placeholder="<%= t.form_name_ph %>" required></div>
          <div class="field-row">
            <div class="field"><label for="leadEmail" data-lk="t:form_email"><%= t.form_email %></label><input id="leadEmail" type="email" placeholder="<%= t.form_email_ph %>"></div>
            <div class="field"><label for="leadPhone" data-lk="t:form_phone"><%= t.form_phone %></label><input id="leadPhone" type="tel" placeholder="<%= t.form_phone_ph %>"></div>
          </div>
          <div class="field"><label for="leadTime" data-lk="t:form_timeframe"><%= t.form_timeframe %></label>
            <select id="leadTime">
              <option value=""><%= t.tf_placeholder %></option>
              <option value="<%= t.tf_asap %>"><%= t.tf_asap %></option>
              <option value="<%= t.tf_3 %>"><%= t.tf_3 %></option>
              <option value="<%= t.tf_6 %>"><%= t.tf_6 %></option>
              <option value="<%= t.tf_explore %>"><%= t.tf_explore %></option>
            </select>
          </div>
          <input type="hidden" id="leadLat"><input type="hidden" id="leadLng">
          <div class="form-error" id="formError" role="alert"></div>
          <button type="submit" class="seal-btn" id="sealBtn" style="background-color:#E30B2D;color:#fff" data-lk="t:form_submit"><%= t.form_submit %></button>
        </form>
        <div class="fiche-success" id="ficheSuccess" hidden>
          <h3 id="ficheSuccessTitle" data-lk="t:success_title"><%= t.success_title %></h3>
          <p id="ficheSuccessText" data-lk="t:success_text"><%= t.success_text %></p>
        </div>
      </div>
    </div>
    <ol class="bp-steps" aria-label="<%= t.proto_title %>">
      <li><span>1</span><div><strong><%= t.step1_t %></strong><p><%= t.step1_d %></p></div></li>
      <li><span>2</span><div><strong><%= t.step2_t %></strong><p><%= t.step2_d %></p></div></li>
      <li><span>3</span><div><strong><%= t.step3_t %></strong><p><%= t.step3_d %></p></div></li>
    </ol>
  </div>
</section>

<section class="section agent" id="agent">
  <div class="container agent-inner <%= settings._p_agent_image_url || inlineEditor ? '' : 'bp-agent-no-photo' %>">
    <% if(settings._p_agent_image_url || inlineEditor){ %>
    <div class="agent-photo">
      <img src="<%= settings._p_agent_image_url ? settings._p_agent_image_url : 'public/img/agent-silhouette.svg' %>" data-setting-key="_p_agent_image_url" alt="<%= settings.agent_name || '' %>">
      <% if(inlineEditor){ %><button id="pagePhotoButton" class="pe-photo-button pe-edit-only" type="button"><%= lang==='fr'?'Changer la photo':'Change photo' %></button><input id="pagePhotoInput" type="file" accept="image/png,image/jpeg,image/webp" hidden><% } %>
      <span class="clip" aria-hidden="true"></span>
    </div>
    <% } %>
    <div class="agent-body">
      <p class="eyebrow-c" data-lk="t:agent_eyebrow"><%= t.agent_eyebrow %></p>
      <h2 class="agent-name" data-setting-key="agent_name"><%= settings.agent_name || t.agent_fallback_name %></h2>
      <p class="agent-title" data-lk="t:agent_title"><%= t.agent_title %></p>
      <p class="agent-credo" data-lk="t:agent_credo"><%= t.agent_credo %></p>
      <p class="agent-remax" data-lk="t:agent_remax"><%= t.agent_remax %></p>
      <div class="bp-contact"><% if(settings.agent_phone||inlineEditor){ %><a data-contact="agent_phone" href="tel:<%= String(settings.agent_phone||'').replace(/\D/g,'') %>"><%= settings.agent_phone||'' %></a><% } %><% if(settings.agent_email||inlineEditor){ %><a data-contact="agent_email" href="mailto:<%= settings.agent_email||'' %>"><%= settings.agent_email||'' %></a><% } %></div>
      <% if(inlineEditor){ %><%- include('partials/page-editor-extras') %><% } %>
      <% if (brokerStats.length) { %>
      <dl class="bp-stats" aria-label="<%= t.stats_title %>">
        <% brokerStats.forEach(function(stat){ %><div><dt><%= stat.label %></dt><dd><%= stat.value %><small><%= stat.unit %></small></dd></div><% }); %>
      </dl>
      <% } %>
      <% if (brokerLinks && brokerLinks.length) { %>
      <ul class="bp-links"><% brokerLinks.forEach(function(l){ %><li><a href="<%= l.url %>" target="_blank" rel="noopener nofollow"><%= l.label %> ↗</a></li><% }); %></ul>
      <% } %>
      <button class="seal-cta" type="button" data-scroll-eval><%= t.seal_btn %></button>

    </div>
  </div>
</section>

<% if(testimonials && testimonials.length){ %>
<section class="testi" id="temoignages">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow-c" data-lk="t:testi_eyebrow"><%= t.testi_eyebrow %></p>
      <h2 class="testi-title" data-lk="t:testi_title"><%= t.testi_title %></h2>
    </div>
    <div class="testi-grid">
      <% testimonials.forEach(function(tm){ %>
      <article class="testi-card">
        <span class="testi-clip" aria-hidden="true"></span>
        <p class="testi-quote" data-content-source="testimonials:quote" data-content-id="<%= tm.id %>"><%= tm.quote %></p>
        <div class="testi-meta">
          <div class="testi-name" data-content-source="testimonials:author" data-content-id="<%= tm.id %>"><%= tm.author %></div>
          <% if(tm.neighborhood){ %><div class="testi-hood" data-content-source="testimonials:neighborhood" data-content-id="<%= tm.id %>"><%= tm.neighborhood %></div><% } %>
          <% if(tm.sale_result){ %><div class="testi-result"><span class="testi-result-label" data-lk="t:testi_result_label"><%= t.testi_result_label %></span><span data-content-source="testimonials:sale_result" data-content-id="<%= tm.id %>"><%= tm.sale_result %></span></div><% } %>
        </div>
      </article>
      <% }); %>
    </div>

  </div>
</section>

<% } %>
</main>
<%- include('partials/footer') %>
<% if(inlineEditor){ %><script src="public/js/page-editor-v1.js?v=1" defer></script><% } %>
<% if(googleApiKey){ %>
<script async src="https://maps.googleapis.com/maps/api/js?key=<%= googleApiKey %>&libraries=places,geometry&callback=initVendvite&v=weekly"></script>
<% } %>
</body>
</html>
