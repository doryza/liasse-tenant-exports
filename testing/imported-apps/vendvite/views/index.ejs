<%- include('partials/invite-header') %>
<main class="inv">
  <div class="inv-veil" aria-hidden="true"></div>
  <div class="inv-orbit" aria-hidden="true"></div>

  <section class="inv-hero">
    <div class="inv-wrap">
      <img class="inv-logo" src="https://res.cloudinary.com/duhp69meg/image/upload/f_auto,q_auto,w_520/v1788268189/vendvite/logo.png"
           alt="VendVite" width="260" height="312" fetchpriority="high" decoding="async">

      <p class="inv-eyebrow"><%= t.inv_eyebrow %></p>
      <h1 class="inv-display"><%= t.inv_title %></h1>
      <p class="inv-lede"><%= t.inv_lede %></p>

      <div class="inv-price" aria-label="<%= t.inv_price_amount %> <%= t.inv_price_term %>">
        <div class="inv-price-lockup">
          <strong><%= t.inv_price_amount %></strong>
          <span><%= t.inv_price_term %></span>
        </div>
        <p><%= t.inv_price_pitch %></p>
      </div>

      <div class="inv-rule" aria-hidden="true"><span></span><em>&#10022;</em><span></span></div>

      <div class="inv-panel" id="invPanel">
        <h2 class="inv-panel-title"><%= t.inv_form_title %></h2>
        <p class="inv-panel-sub"><%= t.inv_form_sub %></p>

        <form id="invForm" class="inv-form" novalidate
              data-err-required="<%= t.inv_err_required %>"
              data-err-email="<%= t.inv_err_email %>"
              data-err-generic="<%= t.inv_err_generic %>">
          <div class="inv-field">
            <label for="invName"><%= t.inv_f_name %></label>
            <input id="invName" name="name" type="text" autocomplete="name" placeholder="<%= t.inv_f_name_ph %>" required>
          </div>
          <div class="inv-field">
            <label for="invAgency"><%= t.inv_f_agency %></label>
            <input id="invAgency" name="agency" type="text" autocomplete="organization" maxlength="120" placeholder="<%= t.inv_f_agency_ph %>" required>
          </div>
          <div class="inv-field">
            <label for="invRegion"><%= t.inv_f_region %></label>
            <input id="invRegion" name="target_region" type="text" maxlength="200" placeholder="<%= t.inv_f_region_ph %>" required>
          </div>
          <div class="inv-row">
            <div class="inv-field">
              <label for="invPhone"><%= t.inv_f_phone %></label>
              <input id="invPhone" name="phone" type="tel" autocomplete="tel" placeholder="<%= t.inv_f_phone_ph %>" required>
            </div>
            <div class="inv-field">
              <label for="invEmail"><%= t.inv_f_email %></label>
              <input id="invEmail" name="email" type="email" autocomplete="email" placeholder="<%= t.inv_f_email_ph %>" required>
            </div>
          </div>
          <p class="inv-error" id="invError" role="alert"></p>
          <button type="submit" class="inv-submit" id="invSubmit"
                  data-sending="<%= t.inv_f_sending %>" data-sent="<%= t.inv_f_sent %>">
            <span class="inv-submit-copy"><%= t.inv_f_submit %></span>
            <span class="inv-submit-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          </button>
          <p class="inv-fineprint"><%= t.inv_fineprint %></p>
        </form>

        <div class="inv-done" id="invDone" role="status" aria-live="polite" tabindex="-1" hidden>
          <p class="inv-done-kicker"><%= t.inv_done_kicker %></p>
          <div class="inv-seal-stage" aria-hidden="true">
            <span class="inv-seal-pulse"></span>
            <span class="inv-seal-spark inv-seal-spark-a">&#10022;</span>
            <span class="inv-seal-spark inv-seal-spark-b">&#10022;</span>
            <span class="inv-seal-spark inv-seal-spark-c">&#10022;</span>
            <div class="inv-done-seal">
              <span class="inv-seal-rim"></span>
              <span class="inv-seal-monogram">V</span>
            </div>
          </div>
          <h3><%= t.inv_done_title %></h3>
          <p id="invDoneText"><%= t.inv_done_text %></p>
          <div class="inv-done-status"><span aria-hidden="true">&#10003;</span><%= t.inv_done_status %></div>
        </div>
      </div>

      <ul class="inv-marks">
        <li><span class="inv-mark-n">I</span><%= t.inv_mark_1 %></li>
        <li><span class="inv-mark-n">II</span><%= t.inv_mark_2 %></li>
        <li><span class="inv-mark-n">III</span><%= t.inv_mark_3 %></li>
      </ul>
    </div>
  </section>

  <footer class="inv-foot">
    <div class="inv-wrap">
      <span class="inv-foot-mark">VendVite</span>
      <span class="inv-foot-note"><%= t.inv_foot %></span>
    </div>
  </footer>
</main>
<script src="public/js/invite.js" defer></script>
</body>
</html>
