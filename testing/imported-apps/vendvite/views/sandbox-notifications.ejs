<!doctype html><html lang="<%= lang %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>VendVite — <%= lang==='en'?'Simulated emails':'Courriels simulés' %></title><link rel="stylesheet" href="public/css/admin-styles.css"><link rel="stylesheet" href="public/css/admin-operations-v1.css"><link rel="stylesheet" href="public/css/sandbox-v1.css"></head><body class="<%= admin?'admin':'ops-report' %>"><% const en=lang==='en',tr=(fr,english)=>en?english:fr,base=admin?'admin/tests/notifications':'espace/tests/notifications',suffix=campaign?'&campaign='+campaign.id:'',date=x=>x?new Date(x).toLocaleString(en?'en-CA':'fr-CA',{timeZone:'America/Toronto'}):'—'; %><% if(admin){ %><%- include('partials/admin-sidebar') %><main class="admin-main"><header class="admin-top"><button id="adminBurger" class="admin-burger" aria-label="Menu">≡</button><h1><%= tr('Courriels simulés','Simulated emails') %></h1></header><div class="sandbox-shell"><% }else{ %><main class="sandbox-shell"><header class="sandbox-head"><a class="sandbox-brand" href="espace">VendVite.</a><nav><a href="espace/tests"><%= tr('Espace de test','Test workspace') %></a><a href="espace/pistes?mode=test"><%= tr('Demandes de test','Test requests') %></a></nav></header><h1><%= tr('Courriels simulés','Simulated emails') %></h1><% } %><p class="sandbox-banner"><strong>TEST / SIMULATION</strong> — <%= tr('Ces messages n’ont pas été envoyés. Le destinataire affiché sert à vérifier le parcours. Le contenu est présenté en texte; aucun lien ni image distante ne s’ouvre automatiquement.','These messages were not sent. The recipient shown helps you verify the journey. Content is shown as text; links and remote images never open automatically.') %></p><% if(campaign){ %><p><a href="<%= admin?'admin/campagnes/'+campaign.id+'/preparation':'espace/commandes/'+campaign.id %>"><%= tr('← Commande test','← Test order') %> #<%= campaign.id %></a></p><% } %><div class="sandbox-actions"><button id="sandboxPreviewNow" class="btn-primary" type="button" <%- admin&&!scopeBrokerId?'disabled':'' %>><%= tr('Préparer les aperçus maintenant','Prepare previews now') %></button><a href="<%= base %><%= campaign?'?campaign='+campaign.id:'' %>"><%= tr('Actualiser','Refresh') %></a></div><% if(admin&&!scopeBrokerId){ %><p class="sandbox-note"><%= tr('Ouvrez les courriels depuis une commande test pour préparer uniquement les aperçus de son courtier.','Open emails from a test order to prepare only that agent’s previews.') %> <a href="admin/campagnes?status=test"><%= tr('Commandes test','Test orders') %> →</a></p><% } %><p id="sandboxFeedback" class="sandbox-status" role="status"></p><% if(!jobs.length){ %><p class="sandbox-card"><%= tr('Aucun message de test ici pour le moment. Créez une commande ou une demande de test, puis actualisez cette page.','No test messages here yet. Create a test order or request, then refresh this page.') %></p><% } %><% jobs.forEach(function(j){var payload=typeof j.payload==='string'?JSON.parse(j.payload):j.payload||{}; %><article class="sandbox-card"><h2><%= payload.subject||tr('Message de test','Test message') %></h2><dl class="sandbox-meta"><dt><%= tr('Destinataire simulé','Simulated recipient') %></dt><dd><%= payload.to||'—' %></dd><dt><%= tr('État','Status') %></dt><dd><%= j.status==='sent'?tr('Aperçu prêt — aucun envoi','Preview ready — not sent'):j.status==='cancelled'?tr('Simulation annulée','Simulation cancelled'):j.status==='failed'?tr('Nouvelle tentative en attente','Retry pending'):tr('Préparation en attente','Preparation pending') %></dd><dt><%= tr('Créé','Created') %></dt><dd><%= date(j.created_at) %></dd><% if(j.sent_at){ %><dt><%= tr('Aperçu préparé','Preview prepared') %></dt><dd><%= date(j.sent_at) %></dd><% } %></dl><details><summary><%= tr('Lire le message simulé','Read the simulated message') %></summary><pre class="sandbox-mail"><%= payload.text||tr('Aucune version texte disponible pour ce message.','No text version is available for this message.') %></pre></details></article><% }); %><nav aria-label="Pagination"><% if(page>1){ %><a href="<%= base %>?page=<%= page-1 %><%= suffix %>">← <%= tr('Précédent','Previous') %></a><% } %><span><%= tr('Page','Page') %> <%= page %></span><% if(more){ %><a href="<%= base %>?page=<%= page+1 %><%= suffix %>"><%= tr('Suivant','Next') %> →</a><% } %></nav><% if(admin){ %></div></main><% }else{ %></main><% } %><script>window.VV_SANDBOX=<%- scriptJson({admin,csrf,en,kind:'previews',campaignId:campaign?campaign.id:null,brokerId:scopeBrokerId}) %>;</script><script src="public/js/sandbox-workspace-v1.js" defer></script></body></html>
