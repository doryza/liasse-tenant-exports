<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tableau de bord — <%= settings.agent_name || 'RE/MAX' %></title>
<link rel="stylesheet" href="public/css/admin-styles.css">
</head>
<body class="admin">
<%- include('partials/admin-sidebar') %>
<div class="admin-main">
  <header class="admin-top">
    <button class="admin-burger" id="adminBurger" aria-label="Menu">≡</button>
    <h1>Tableau de bord</h1>
    <a class="btn-primary top-cta" href="admin/leads">Voir les demandes</a>
  </header>
  <div class="admin-content">
    <div class="admin-hero">
      <div>
        <h2 class="dash-title">Bienvenue</h2>
        <p class="dash-sub">Voici un aperçu de l'activité de votre site VendVite.</p>
      </div>
    </div>
    <div class="stat-cards">
      <div class="scard scard-accent"><div class="scard-num"><%= stats.newLeads %></div><div class="scard-label">Nouvelles demandes</div></div>
      <div class="scard"><div class="scard-num"><%= stats.leads %></div><div class="scard-label">Demandes totales</div></div>
      <div class="scard"><div class="scard-num"><%= stats.recentVisits %></div><div class="scard-label">Visites (7 jours)</div></div>
      <div class="scard"><div class="scard-num"><%= stats.visits %></div><div class="scard-label">Visites totales</div></div>
      <div class="scard"><div class="scard-num"><%= stats.pushCount %></div><div class="scard-label">Abonnés notifications</div></div>
      <div class="scard"><div class="scard-num"><%= stats.testimonials %></div><div class="scard-label">Témoignages</div></div>
      <div class="scard"><div class="scard-num"><%= (Number(stats.revenueCents || 0) / 100).toLocaleString('fr-CA',{minimumFractionDigits:2,maximumFractionDigits:2}) %>&nbsp;$</div><div class="scard-label">Ventes encaissées</div></div>
    </div>
    <h2 class="admin-h2">Gérer le contenu</h2>
    <div class="admin-cards">
      <a class="mcard" href="admin/leads"><div class="mcard-ico" aria-hidden="true">📥</div><h3>Demandes d'évaluation</h3><p>Gérez les prospects vendeurs et leur suivi.</p><span class="mcard-go">Ouvrir →</span></a>
      <a class="mcard" href="admin/testimonials"><div class="mcard-ico" aria-hidden="true">⭐</div><h3>Témoignages</h3><p>Ajoutez et modifiez les témoignages clients.</p><span class="mcard-go">Ouvrir →</span></a>
      <a class="mcard" href="admin/posts"><div class="mcard-ico" aria-hidden="true">📝</div><h3>Journal</h3><p>Publiez vos notes de marché.</p><span class="mcard-go">Ouvrir →</span></a>
      <a class="mcard" href="admin/ventes"><div class="mcard-ico" aria-hidden="true">◫</div><h3>Ventes et paiements</h3><p>Suivez les abonnements, taxes, factures et références PayPal.</p><span class="mcard-go">Ouvrir →</span></a>
      <a class="mcard" href="admin/settings"><div class="mcard-ico" aria-hidden="true">⚙️</div><h3>Réglages</h3><p>Coordonnées, statistiques et réseaux sociaux.</p><span class="mcard-go">Ouvrir →</span></a>
    </div>
    <div class="admin-section-head"><h2 class="admin-h2">Demandes récentes</h2><a class="link-more" href="admin/leads">Tout voir →</a></div>
    <div class="table-wrap">
      <table class="admin-table">
        <thead><tr><th>Nom</th><th>Adresse</th><th>Échéancier</th><th>Statut</th><th>Date</th></tr></thead>
        <tbody>
        <% if(recentLeads && recentLeads.length){ recentLeads.forEach(function(l){ %>
          <tr><td><%= l.name %></td><td><%= l.address %></td><td><%= l.timeframe || '—' %></td><td><span class="badge <%= (typeof statusClass==='function'? statusClass(l.status):'badge-new') %>"><%= l.status || 'nouveau' %></span></td><td><%= formatDate(l.created_at) %></td></tr>
        <% }); } else { %>
          <tr><td colspan="5" class="empty">Aucune demande pour le moment. Partagez votre site pour recevoir vos premières évaluations.</td></tr>
        <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<script>(function(){ var b=document.getElementById('adminBurger'); var s=document.getElementById('adminSidebar'); if(b&&s){ b.addEventListener('click',function(){ s.classList.toggle('open'); }); } })();</script>
</body>
</html>
