<!doctype html><html lang="<%= lang %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>VendVite — <%= lang==='en'?'My orders':'Mes commandes' %></title><link rel="stylesheet" href="public/css/admin-styles.css"><link rel="stylesheet" href="public/css/admin-operations-v1.css"></head><body class="ops-report"><main class="ops" style="max-width:980px;margin:28px auto;padding:18px"><%const en=lang==='en',tr=(fr,eng)=>en?eng:fr,states={pending_payment:tr('Paiement à confirmer','Payment awaiting confirmation'),confirmed:tr('À préparer','Awaiting preparation'),processing:tr('En préparation','In preparation'),mailed:tr('Postée','Mailed'),cancelled:tr('Annulée','Cancelled')};%><a href="espace"><%= tr('← Mon espace','← My workspace') %></a><h1><%= tr('Mes commandes','My orders') %></h1><% if(unknown){ %><p role="alert"><%= tr('Ce lien PayPal ne correspond pas à une commande de votre compte. Retrouvez votre commande ci-dessous pour vérifier son paiement.','This PayPal link does not match an order in your account. Find your order below to verify its payment.') %></p><% } %><% if(!campaigns.length){ %><p><%= tr('Aucune commande sur cette page.','No orders on this page.') %></p><% } %><div class="ops-table-wrap"><table class="ops-table"><thead><tr><th><%= tr('Commande','Order') %></th><th><%= tr('Secteur','Area') %></th><th><%= tr('Lettres','Letters') %></th><th>Total</th><th><%= tr('État','Status') %></th></tr></thead><tbody><% for(const c of campaigns){ %><tr><td><a href="espace/commandes/<%= c.id %>">#<%= c.id %></a><br><%= new Date(c.created_at).toLocaleDateString(en?'en-CA':'fr-CA') %><%= c.is_test||c.paypal_mode==='sandbox'?' · TEST':'' %></td><td><%= c.centre_label %></td><td><%= c.address_count %></td><td><%= money(c.total_cents,lang) %></td><td><%= states[c.status]||c.status %></td></tr><% } %></tbody></table></div><nav aria-label="Pagination" style="display:flex;gap:18px;margin-top:20px"><% if(page>1){ %><a href="espace/commandes?page=<%= page-1 %>"><%= tr('← Précédentes','← Previous') %></a><% } %><% if(more){ %><a href="espace/commandes?page=<%= page+1 %>"><%= tr('Suivantes →','Next →') %></a><% } %></nav></main></body></html>
