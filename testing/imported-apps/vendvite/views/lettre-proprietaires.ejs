<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title><%- TL[lang].ltr_title_prefix %><%= broker.full_name %></title>
  <style>
    @page{size:Letter;margin:0}
    .sandbox-mark{position:absolute;bottom:.30in;left:.72in;right:.72in;font:7px Arial;text-align:center;letter-spacing:.04em;color:#555}
    .proof-note{margin:0;padding:12px;text-align:center;font:12px Arial;background:#fff5df;color:#563e18}
    @media print{.proof-note{display:none}}
    *{box-sizing:border-box}
    html,body{margin:0;background:#e8e8e8;color:#000;font-family:Arial,Helvetica,sans-serif}
    .printbar{position:sticky;top:0;z-index:10;display:flex;justify-content:center;align-items:center;gap:16px;padding:12px;background:#111;color:#fff;font-size:14px;box-shadow:0 2px 14px rgba(0,0,0,.25)}
    .printbar button{border:1px solid #fff;border-radius:3px;padding:10px 18px;background:#fff;color:#000;font-weight:700;cursor:pointer}
    .letter{position:relative;width:8.5in;height:11in;margin:24px auto;padding:.63in .72in .54in;background:#fff;box-shadow:0 12px 42px rgba(0,0,0,.18);overflow:hidden}
    .letter::before{content:"";position:absolute;inset:.28in;border:1px solid #000;pointer-events:none}
    .mast{display:flex;align-items:flex-end;justify-content:space-between;padding-bottom:15px;border-bottom:3px solid #000}
    .brand{font-family:Georgia,'Times New Roman',serif;font-size:29px;font-weight:700;letter-spacing:-.02em}
    .brand span{display:inline-grid;place-items:center;width:34px;height:34px;margin-right:9px;border:2px solid #000;border-radius:50%;font-size:18px;vertical-align:2px}
    .personal{max-width:3.3in;text-align:right;font-size:10px;line-height:1.45}
    .personal strong{display:block;font-size:12px}
    .eyebrow{margin:26px 0 8px;font-size:9px;font-weight:700;letter-spacing:.2em;text-transform:uppercase}
    h1{max-width:6.45in;margin:0;font-family:Georgia,'Times New Roman',serif;font-size:34px;line-height:1.04;letter-spacing:-.025em}
    .salutation{margin:20px 0 11px;font-family:Georgia,'Times New Roman',serif;font-size:16px;font-weight:700}
    .bodycopy{max-width:6.65in;margin:0;font-family:Georgia,'Times New Roman',serif;font-size:13.4px;line-height:1.5}
    .bodycopy p{margin:0 0 11px}
    .reasons{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin:17px 0;border-top:1px solid #000;border-bottom:1px solid #000}
    .reason{min-height:83px;padding:13px 14px 12px;border-right:1px solid #000}
    .reason:last-child{border-right:0}
    .reason strong{display:block;margin-bottom:5px;font-family:Georgia,'Times New Roman',serif;font-size:13px}
    .reason span{display:block;font-size:9.6px;line-height:1.4;color:#333}
    .cta{display:grid;grid-template-columns:1fr 1.36in;gap:23px;align-items:center;margin-top:17px;padding:17px 19px;border:2px solid #000}
    .cta-kicker{margin:0 0 5px;font-size:9px;font-weight:700;letter-spacing:.18em;text-transform:uppercase}
    .cta h2{margin:0 0 7px;font-family:Georgia,'Times New Roman',serif;font-size:21px;line-height:1.14}
    .cta p{margin:0 0 8px;font-size:10.5px;line-height:1.4}
    .url{font-size:11px;font-weight:700;word-break:break-all}
    .qr{width:1.32in;height:1.32in;padding:5px;border:1px solid #000;background:#fff}
    .qr img{display:block;width:100%;height:100%}
    .signature{display:flex;justify-content:space-between;align-items:flex-end;gap:18px;margin-top:18px}
    .sign-name{font-family:Georgia,'Times New Roman',serif;font-size:16px;font-weight:700}
    .sign-meta{margin-top:3px;font-size:9.7px;line-height:1.45}
    .free{max-width:2.6in;text-align:right;font-family:Georgia,'Times New Roman',serif;font-size:14px;font-weight:700;line-height:1.3}
    .fine{position:absolute;right:.72in;bottom:.46in;left:.72in;padding-top:8px;border-top:1px solid #aaa;font-size:7.3px;line-height:1.35;color:#555}
    /* Sample: Letter stock, #10 lower-left window, C fold.
       Fold at 3 11/16 and 7 3/8 inches from the top (shorter inner panel).
       Physical units are deliberate: print at 100%, duplex long edge. */
    .letter{padding-top:.55in}
    .eyebrow{margin:0 0 7px}
    h1{font-size:30px;max-width:6.5in}
    .recipient{position:absolute;left:1.05in;top:2.2in;width:3.25in;margin:0;font:10pt/1.2 Arial,Helvetica,sans-serif;font-style:normal}
    .recipient span{display:block}
    .fold{position:absolute;left:.32in;right:.32in;height:0;pointer-events:none}
    .fold::before,.fold::after{content:"";position:absolute;top:0;width:.14in;border-top:.4pt solid #aaa}
    .fold::before{left:0}.fold::after{right:0}
    .fold-one{top:3.6875in}.fold-two{top:7.375in}
    .middle-panel{position:absolute;top:3.86in;left:.72in;right:.72in}
    .salutation{margin:12px 0 10px}
    .bodycopy{font-size:13.4px;line-height:1.45}
    .bodycopy p{margin-bottom:10px}
    .reasons{margin:14px 0 0}
    .reason{min-height:78px;padding:11px 14px}
    .bottom-panel{position:absolute;top:7.6in;left:.72in;right:.72in}
    .cta{grid-template-columns:1fr 1.05in;gap:18px;margin-top:8px;padding:9px 14px}
    .cta h2{font-size:18px}
    .qr{width:1.05in;height:1.05in;padding:4px}
    .signature{margin-top:8px}
    .sign-name{font-size:15px}.free{font-size:13px}
    .fine{bottom:.42in}
    @media(max-width:850px){.letter{margin:0;transform-origin:top left}.printbar span{display:none}}
    @media print{html,body{background:#fff}.printbar{display:none}.letter{margin:0;box-shadow:none}.letter.recto{page-break-after:always}.letter.verso{page-break-after:auto}}
      @media print{.letter.recto,.letter.verso{break-after:page}.letter:last-child{break-after:auto}}
  </style>
</head>
<body>
  <% if(typeof sandboxPrint!=='undefined'&&sandboxPrint){ %><p class="proof-note"><%= lang==='fr'?'TEST PAYPAL — mêmes lettres et adresses qu’un envoi réel. Les QR ouvrent un aperçu privé; aucune demande ni aucun envoi postal réel.':'PAYPAL TEST — the same letters and addresses as a real mailing. QR codes open a private preview; no real lead requests or postal mailing.' %></p><% } %>
  <% if(typeof proof!=='undefined'&&proof){ %><p class="proof-note"><%= lang==='fr'?'Aperçu privé — ce QR ouvre votre aperçu connecté. Chaque lettre envoyée par VendVite aura son propre code sécurisé.':'Private preview — this QR opens your signed-in preview. Each letter mailed by VendVite will have its own secure code.' %></p><% } %>
  <% if (!embed) { %><div class="printbar"><span><%= TL[lang].ltr_printbar_meta %></span><button type="button" onclick="window.print()"><%= TL[lang].ltr_print_button %></button></div><% } %>
  <% var langues = (lang === 'en') ? ['en', 'fr'] : ['fr', 'en']; %>
  <% (typeof recipients !== 'undefined' && recipients ? recipients : [['ADRESSE DU DESTINATAIRE / RECIPIENT ADDRESS','VILLE QC  A1A 1A1']]).forEach(function(recipient){ var recipientAddress=Array.isArray(recipient)?recipient:recipient.address; %>
  <% langues.forEach(function(L, iL){ var t = TL[L]; var recipientUrl=recipient.url?recipient.url+'?lang='+L:pageUrl; var recipientQr=recipient.qr?recipient.qr[L]:qrDataUrl; %>
  <main class="letter<%= iL === 0 ? ' recto' : ' verso' %>" lang="<%= L %>">
    <header class="mast">
      <div class="brand"><span>V</span>VendVite</div>
      <div class="personal"><strong><%= profile.agent_name || broker.full_name %></strong><%= profile.agent_title || t.agent_title %><% if (profile.agency || broker.agency) { %> · <%= profile.agency || broker.agency %><% } %></div>
    </header>

    <address class="recipient"><% recipientAddress.forEach(function(line){ %><span><%= line %></span><% }); %></address>
    <div class="fold fold-one" aria-hidden="true"></div><div class="fold fold-two" aria-hidden="true"></div>
    <div class="middle-panel">
    <p class="eyebrow"><%= t.ltr_eyebrow_attention %></p>
    <h1><%- t.ltr_headline %></h1>
    <p class="salutation"><%= t.ltr_salutation %></p>
    <div class="bodycopy">
      <p><%= t.ltr_body_assets %></p>
      <p><%= t.ltr_offer_lead %> <strong><%= t.ltr_offer_bold %></strong><%= t.ltr_offer_tail %></p>
    </div>

    <section class="reasons" aria-label="<%= t.ltr_reasons_aria %>">
      <div class="reason"><strong><%= t.ltr_reason1_title %></strong><span><%= t.ltr_reason1_body %></span></div>
      <div class="reason"><strong><%= t.ltr_reason2_title %></strong><span><%= t.ltr_reason2_body %></span></div>
      <div class="reason"><strong><%= t.ltr_reason3_title %></strong><span><%= t.ltr_reason3_body %></span></div>
    </section>

    </div>
    <div class="bottom-panel">
    <div class="bodycopy"><p><%= t.ltr_body_scan %></p></div>

    <section class="cta">
      <div>
        <p class="cta-kicker"><%= t.ltr_cta_kicker %></p>
        <h2><%= t.ltr_cta_title %></h2>
        <p><%= t.ltr_cta_terms %></p>
        <div class="url"><%= recipientUrl %></div>
      </div>
      <div class="qr"><img src="<%= recipientQr %>" alt="<%- t.ltr_qr_alt %><%= broker.full_name %>"></div>
    </section>

    <section class="signature">
      <div><div class="sign-name"><%= profile.agent_name || broker.full_name %></div><div class="sign-meta"><%= profile.agent_title || t.agent_title %><% if (profile.agency || broker.agency) { %> · <%= profile.agency || broker.agency %><% } %><% if (profile.agent_phone || broker.phone) { %><br><%= formatPhone(profile.agent_phone || broker.phone) %><% } %></div></div>
      <div class="free"><%= t.ltr_pullquote %></div>
    </section>

    </div>
    <footer class="fine"><%= t.ltr_fineprint %></footer>
    <% if(typeof sandboxPrint!=='undefined'&&sandboxPrint){ %><div class="sandbox-mark"><%= L==='fr'?'TEST PAYPAL · APERÇU PRIVÉ · AUCUN ENVOI RÉEL':'PAYPAL TEST · PRIVATE PREVIEW · NO REAL MAILING' %></div><% } %>
  </main>
  <% }); %>
  <% }); %>
<% if(embed){ %><script>(function(){function fit(){var scale=Math.min(1,innerWidth/816);document.querySelectorAll('.letter').forEach(function(p){p.style.zoom=scale;});}fit();addEventListener('resize',fit);addEventListener('beforeprint',function(){document.querySelectorAll('.letter').forEach(function(p){p.style.zoom='';});});addEventListener('afterprint',fit);})();</script><% } %>
</body>
</html>
