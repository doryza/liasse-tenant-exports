<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= campaign.name %> — VendVite</title><link rel="stylesheet" href="public/css/admin-styles.css"><link rel="stylesheet" href="public/css/solicitations-v1.css"></head><body class="admin"><%- include('partials/admin-sidebar') %><main class="admin-main"><header class="admin-top"><h1><%= campaign.name %></h1></header><div class="admin-content solicitations"><p><a href="admin/sollicitations">← Campagnes</a></p><a class="btn-primary" href="admin/sollicitations/<%= campaign.id %>/imprimer" target="_blank" rel="noopener">Imprimer les lettres / enregistrer en PDF ↗</a><p><%= agents.length %> agents · <%= campaign.format==='duplex'?'Français / anglais, recto-verso':campaign.format %></p>
<% agents.forEach(function(a){ %><article class="sol-card"><h2><%= a.name %></h2><p><%= a.agency %> · <%= a.title %> · <%= a.phone %></p><p class="sol-address"><%= a.address1 %><br><%= a.address2 %></p><p><code><%= a.tag %></code> · <%= a.visits %> visites · <%= a.broker_id?'Inscription associée':'Pas encore inscrit' %></p><a href="invitation/<%= a.tag %>?lang=fr" target="_blank" rel="noopener">Démonstration personnalisée ↗</a></article><% }); %></div></main></body></html>
