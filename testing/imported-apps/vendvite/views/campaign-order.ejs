<!doctype html><html lang="<%= lang %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>VendVite — <%= lang==='en'?'Order':'Commande' %> #<%= campaign.id %></title><link rel="stylesheet" href="public/css/admin-styles.css"><link rel="stylesheet" href="public/css/admin-operations-v1.css"><style>.order-card{background:#fff;border:1px solid #d8d5cb;border-radius:12px;padding:24px;margin:20px 0}.order-values{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:20px}.order-values dt{color:#525952}.order-values dd{margin:8px 0;font-size:24px;font-weight:700}.order-progress{padding-left:24px;line-height:1.9}.order-actions{display:flex;gap:12px;flex-wrap:wrap}.order-actions button{padding:14px 18px;border-radius:6px;cursor:pointer}.order-actions button:disabled{cursor:wait;opacity:.6}.order-notice{padding:14px;background:#fff2d6;border:1px solid #b98426;color:#503906;border-radius:6px}.order-actions a{align-self:center}.order-status{min-height:28px;margin:16px 0;color:#374037}h1,h2{color:#20281f!important}.order-label{font-weight:700;color:#174d36}</style></head><body class="ops-report"><main class="ops" style="max-width:900px;margin:28px auto;padding:18px">
<% const en=lang==='en', paid=campaign.payment_status==='paid', cancelled=campaign.status==='cancelled', test=Number(campaign.is_test)===1||campaign.paypal_mode==='sandbox', included=campaign.kind==='included', p=campaign.production||{}, prepared=!!p.approvedAt, rec=campaign.payment_recovery||{}, hold=!!(p.correctionPending||p.shortfall&&['requested','rejected'].includes(p.shortfall.state)), tr=(fr,enText)=>en?enText:fr, date=v=>v?new Date(v).toLocaleString(en?'en-CA':'fr-CA',{dateStyle:'long',timeStyle:'short',timeZone:'America/Toronto'}):'—'; %>
<a href="<%= admin?'admin/campagnes':'espace/commandes' %>"><%= admin?tr('← Commandes postales','← Mailing orders'):tr('← Mes commandes','← My orders') %></a>
<h1><%= test?tr('Commande test','Test order'):tr('Commande','Order') %> #<%= campaign.id %></h1>
<% if(test){ %><p class="order-notice"><strong>TEST PAYPAL</strong> — <%= tr('Parcours complet de simulation. Aucun paiement, courrier postal ni courriel réel. Les demandes et courriels restent dans les résultats de test.','Full rehearsal. No real payment, postal mailing or email delivery. Requests and emails remain in the test results.') %></p><% } %>
<% if(checkoutClosed&&!paid){ %><p class="order-notice"><%= tr('La fenêtre PayPal a été fermée. Votre commande est conservée. Vérifiez son paiement avant de la reprendre ou de l’annuler.','The PayPal window was closed. Your order is saved. Verify its payment before resuming or cancelling.') %></p><% } %>
<section class="order-card"><p class="order-label"><%= cancelled?tr('Commande annulée','Order cancelled'):paid?(test?tr('Paiement sandbox confirmé — commande test reçue','Sandbox payment confirmed — test order received'):tr('Paiement confirmé — commande reçue','Payment confirmed — order received')):included?tr('Commande reçue','Order received'):tr('Commande sauvegardée — paiement à confirmer','Order saved — payment awaiting confirmation') %></p>
<p><%= campaign.centre_label||'' %></p><dl class="order-values"><div><dt><%= tr('Lettres commandées','Letters ordered') %></dt><dd><%= campaign.address_count %></dd></div><div><dt><%= test?tr('Total simulé','Simulated total'):paid?tr('Total payé','Total paid'):tr('Total de la commande','Order total') %></dt><dd><%= money(campaign.total_cents,lang) %></dd></div><div><dt><%= tr('Créée le','Created') %></dt><dd style="font-size:16px"><%= date(campaign.created_at) %></dd></div></dl>
<% if(!paid&&!included&&!cancelled){ %><p><%= tr('Votre sélection et votre prix sont conservés. La vérification automatique continue même si vous fermez cette page. Ne créez pas une seconde commande pour ce même envoi.','Your selection and price are saved. Automatic verification continues after you close this page. Do not create a second order for this same mailing.') %></p><div class="order-actions"><button type="button" class="btn-primary" data-order-action="verify"><%= tr('Vérifier le paiement','Verify payment') %></button><% if(!admin){ %><button type="button" data-order-action="resume"><%= tr('Reprendre sur PayPal','Resume on PayPal') %></button><button type="button" data-order-action="cancel"><%= tr('Annuler cette commande','Cancel this order') %></button><% } %></div><% } %>
<% if(rec.error){ %><p class="order-notice"><%= tr('Une vérification reste nécessaire. La commande est conservée; une nouvelle tentative automatique est prévue.','Verification is still required. Your order is saved and an automatic retry is scheduled.') %><% if(rec.error==='CAPTURE_IN_PROGRESS'){ %> <%= tr('La réponse au paiement est incertaine : l’annulation est bloquée pour éviter de masquer un paiement déjà effectué.','The payment response is uncertain: cancellation is blocked so an existing payment cannot be hidden.') %><% } %></p><% } %>
<p role="status" aria-live="polite" class="order-status" id="order-feedback"></p><% if(rec.checkedAt){ %><small><%= tr('Dernière vérification : ','Last checked: ') %><%= date(rec.checkedAt) %></small><% } %>
</section>
<% if(paid||included){ %><section class="order-card"><h2><%= tr('Suivi de votre envoi','Your mailing status') %></h2><% if(hold){ %><p class="order-notice"><strong><%= tr('Préparation suspendue : une décision ou une correction est nécessaire avant l’impression.','Preparation is paused: a decision or correction is required before printing.') %></strong></p><% } %><ol class="order-progress"><li><%= tr('Commande reçue et quantité enregistrée.','Order received and quantity recorded.') %></li><li><%= prepared?tr('Adresses vérifiées et liste préparée : ','Addresses reviewed and recipient list prepared: ')+p.preparedCount:tr('Recherche manuelle des codes postaux et vérification des unités.','Manual postal-code lookup and unit review.') %></li><li><%= campaign.mailed_at?(test?tr('Dépôt simulé enregistré le ','Simulated deposit recorded on '):tr('Déposée à Postes Canada le ','Deposited with Canada Post on '))+date(campaign.mailed_at):test?tr('Impression de test et simulation du dépôt.','Test printing and simulated deposit.'):tr('Impression et dépôt à Postes Canada.','Printing and deposit with Canada Post.') %></li></ol>
<% if(test&&campaign.deadline_at&&!campaign.mailed_at&&!cancelled){ %><p class="order-notice"><%= tr('Échéance fictive pour répéter le suivi : ','Simulated deadline for rehearsing the follow-up: ') %><%= date(campaign.deadline_at) %>. <%= tr('Aucun dépôt postal réel n’est prévu pour cette commande test.','No real postal deposit is planned for this test order.') %></p><% }else if(campaign.deadline_at&&!campaign.mailed_at&&!cancelled){ %><p><%= hold?tr('Objectif initial de dépôt, suspendu pendant la résolution : ','Original deposit target, paused while the issue is resolved: '):tr('Dépôt prévu au plus tard le ','Expected deposit by ') %><strong><%= date(campaign.deadline_at) %></strong>. <%= tr('Délai de préparation : 72 heures, fins de semaine comprises.','Preparation window: 72 hours including weekends.') %> <%= tr('Les délais de transport de Postes Canada s’ajoutent après le dépôt. Une décision requise sur les adresses peut suspendre la préparation.','Canada Post transit time follows deposit. A required address decision can pause preparation.') %></p><% } %>
<% if(p.shortfall){ %><p class="order-notice"><%= tr('Certaines adresses ne sont pas encore préparées. Votre décision et la résolution sont conservées avec cette commande.','Some addresses are not yet prepared. Your decision and resolution are recorded with this order.') %> <a href="<%= admin?'admin/campagnes/'+campaign.id+'/preparation':'espace/campagnes/'+campaign.id+'/decision' %>"><%= tr('Examiner les adresses manquantes','Review missing recipients') %></a></p><% } %>
<% if(prepared){ %><p><a href="<%= admin?'admin/campagnes/'+campaign.id+'/preparation':'espace/campagnes/'+campaign.id+'/preparation' %>"><%= tr('Voir le rapport de préparation et les adresses non retenues','View the preparation report and omitted addresses') %></a></p><% } %></section><% } %>
<% if(test){ %><section class="order-card"><h2><%= tr('Parcours de test et résultats','Test journey and results') %></h2><p><%= tr('Les pages propriétaires ci-dessous sont privées : seuls ce courtier et l’administrateur connectés peuvent les ouvrir. Les demandes créées ici servent uniquement au test.','The homeowner pages below are private: only this signed-in agent and the administrator can open them. Requests created here are for testing only.') %></p><div class="order-actions"><a href="<%= admin?'admin/tests/leads?campaign='+campaign.id:'espace/pistes?mode=test' %>"><%= tr('Ouvrir les demandes de test','Open test requests') %></a><a href="<%= admin?'admin/tests/notifications?campaign='+campaign.id:'espace/tests/notifications?campaign='+campaign.id %>"><%= tr('Voir les courriels simulés','View simulated emails') %></a><% if(admin){ %><a href="admin/campagnes/<%= campaign.id %>/preparation"><%= tr('Ouvrir la préparation test','Open test preparation') %></a><% } %></div><% if(prepared&&campaign.mailing_token&&(p.recipients||[]).length){ %><details><summary><%= tr('Tester une page propriétaire par adresse préparée','Test a homeowner page for each prepared address') %> · <%= p.recipients.length %></summary><ul class="ops-report-list"><% p.recipients.forEach(function(a){ %><li><a href="courrier-test/<%= campaign.mailing_token %>/<%= a.mailing_id %>?lang=<%= lang %>" target="_blank" rel="noopener"><%= a.unit?a.unit+'-':'' %><%= a.numero %> <%= a.rue %>, <%= a.ville %> ↗</a></li><% }); %></ul></details><% }else{ %><p><%= tr('Les liens de test des destinataires apparaîtront ici après la validation de la préparation postale.','Recipient test links will appear here after postal preparation is approved.') %></p><% } %></section><% } %>
<% if(invoices.length){ %><section class="order-card"><h2><%= test?tr('Facture de test','Test invoice'):tr('Facture','Invoice') %></h2><% for(const inv of invoices){ %><p><a href="<%= admin?'admin/ventes/factures':'espace/factures' %>/<%= inv.id %>/pdf"><%= tr('Télécharger','Download') %> <%= inv.invoice_number %> (PDF)</a></p><% if(test){ %><p><%= inv.email_previewed_at?tr('Copie simulée disponible; aucun courriel envoyé.','Simulated copy available; no email was sent.'):tr('La copie simulée apparaîtra dans les aperçus; aucun courriel réel ne sera envoyé.','The simulated copy will appear in previews; no real email will be sent.') %> <a href="<%= admin?'admin/tests/notifications?campaign='+campaign.id:'espace/tests/notifications?campaign='+campaign.id %>"><%= tr('Aperçus des courriels','Email previews') %></a></p><% }else{ %><p><%= inv.emailed_at?tr('Copie envoyée par courriel.','Copy sent by email.'):tr('Copie par courriel en attente; les envois échoués sont relancés automatiquement.','Email copy pending; failed deliveries are retried automatically.') %></p><% } %><% } %></section><% }else if(paid){ %><p class="order-notice"><%= test?tr('Le paiement sandbox est confirmé. La facture de test apparaîtra ici automatiquement.','Your sandbox payment is confirmed. The test invoice will appear here automatically.'):tr('Votre paiement est confirmé. La facture est en cours de préparation; elle apparaîtra ici automatiquement.','Your payment is confirmed. Your invoice is being prepared and will appear here automatically.') %></p><% } %>
<% if(cancelled&&!admin){ %><a href="espace/courrier-cible"><%= tr('Préparer une nouvelle sélection','Prepare a new selection') %></a><% } %>
</main><script>window.VV_ORDER=<%- JSON.stringify({id:campaign.id,lang,admin,csrf,pending:!paid&&!included&&!cancelled||paid&&(!invoices.length||rec.effectsComplete===false)}).replace(/</g,'\\u003c') %>;</script><script src="public/js/campaign-order-v1.js"></script></body></html>
