<section class="ws-account"><div class="ws-heading"><p class="ws-eyebrow">VendVite</p><h1><%= t.ws_account %></h1><p class="ws-muted"><%= t.ws_security_intro %></p></div>
<div class="ws-overview-grid"><section class="ws-card"><h2><%= t.ws_login_email %></h2><p class="ws-account-email"><%= broker.email %></p><p class="ws-muted"><%= t.ws_email_note %></p><a class="esp-ghost" href="espace/abonnement"><%= t.ws_billing %> ↗</a></section>
<section class="ws-card"><h2><%= t.ws_security %></h2><p class="ws-muted"><%= t.ws_session_note %></p><ul class="ws-sessions"><% sessions.forEach(function(session){ %><li><div><strong><%= session.device_label %></strong><% if(String(session.id)===String(sessionId)){ %><span class="ws-session-current"><%= t.ws_this_device %></span><% } %></div><small><%= t.ws_last_seen %> · <%= formatDate(session.last_seen_at) %></small></li><% }); %></ul><div class="ws-account-actions"><button class="esp-btn" type="button" data-signout="one"><%= t.ws_logout %></button><button class="esp-ghost esp-danger" type="button" data-signout="all"><%= t.ws_logout_all %></button></div></section></div></section>
