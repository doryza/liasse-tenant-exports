<section id="campaignStudio" class="cs-studio" aria-labelledby="csTitle">
 <header class="cs-heading"><div><p class="ws-eyebrow"><%= t.c_eyebrow %></p><h1 id="csTitle"><%= t.c_title %></h1><p><%= t.c_intro %></p></div><button id="csLetterOpen" class="esp-ghost" type="button"><span aria-hidden="true">▤</span> <%= t.c_letter %> ↗</button></header>
 <div class="cs-topline"><p id="csDraftStatus" role="status"><%= t.c_loading %></p><div><button id="csDraftRestore" type="button" hidden><%= t.c_restore_shared %></button><button id="csDraftRetry" type="button" hidden><%= t.c_retry %></button><button id="csExport" type="button"><%= t.c_export %> ↓</button><button id="csNew" type="button"><%= t.c_new %> +</button></div></div>
 <div class="cs-layout">
  <aside class="cs-controls" aria-label="<%= t.c_search %>">
   <section class="cs-search-card"><label for="csSearch"><%= t.c_search %></label><form id="csSearchForm"><div class="cs-search-row"><input id="csSearch" autocomplete="off" type="search" placeholder="<%= t.c_search_ph %>" maxlength="200" role="combobox" aria-expanded="false" aria-controls="csSuggestions"><button class="esp-btn" type="submit" aria-label="<%= t.c_search_btn %>">↗</button></div><ul id="csSuggestions" role="listbox" hidden></ul></form>
    <div class="cs-search-options"><label><span><%= t.c_radius %></span><select id="csRadius"><% [200,400,800,1500,3000,5000].forEach(function(r){ %><option value="<%= r %>" <%= r===800?'selected':'' %>><%= r<1000?r+' m':(r/1000)+' km' %></option><% }); %></select></label><label><span><%= t.c_target %></span><input id="csTarget" type="number" min="1" max="1200" value="150" step="1"></label></div>
    <p class="cs-fine"><%= t.c_target_note %></p><div class="cs-search-actions"><button id="csScan" type="button" class="esp-btn" disabled><%= t.c_scan %> ↗</button></div><button id="csCancelSearch" type="button" hidden><%= t.c_cancel %></button>
    <p id="csStatus" class="cs-status" role="status" aria-live="polite"></p><p id="csError" class="esp-error" role="alert"></p>
   </section>
   <section class="cs-selection-card"><div class="cs-section-heading"><h2><%= t.c_selection %></h2><button id="csUndo" type="button" disabled aria-label="<%= t.c_undo %>" title="<%= t.c_undo %>">↶</button></div>
    <div class="cs-stats"><div><div class="cs-selected-total"><strong id="csSelected">0</strong><span>/ <b id="csTargetTotal">150</b></span></div><span><%= t.c_selected_letters %></span></div><div><strong id="csFound">0</strong><span><%= t.c_mapped_count %></span></div></div>
    <p id="csEstimatedSelected" class="cs-fine" hidden></p><p id="csTargetProgress" class="cs-target-progress" role="status" hidden></p>
    <p id="csEstimatesNote" class="cs-fine" hidden></p><p id="csLimitNote" class="cs-fine" hidden><%= t.c_limit %></p>
    <div id="csTargetRecovery" class="cs-target-recovery" hidden><p id="csTargetHelp"></p><div><button id="csFill" class="esp-ghost" type="button" title="<%= t.c_under_target_note %>"><%= t.c_under_target %></button><button id="csExpandArea" class="esp-ghost" type="button"><%= t.c_expand_area %></button><button id="csAddEstimated" type="button"></button></div></div>
    <div class="cs-list-search"><label for="csAddressSearch"><%= t.c_find_address %></label><input id="csAddressSearch" type="search" placeholder="<%= t.c_find_address %>"></div>
    <p class="cs-fine"><%= t.c_remove_hint %></p>
    <div class="cs-tabs" role="group" aria-label="<%= t.c_selection %>"><button data-view="all" class="is-on" aria-pressed="true" type="button"><%= t.c_view_all %></button><button data-view="selected" aria-pressed="false" type="button"><%= t.c_view_selected %></button><button data-view="removed" aria-pressed="false" type="button"><%= t.c_view_removed %></button></div>
    <p id="csSelectionLimit" class="cs-target-progress" role="status" hidden></p>
    <div class="cs-bulk"><button id="csSelectFiltered" type="button" aria-describedby="csSelectionLimit"><%= t.c_select_results %></button><button id="csRemoveFiltered" type="button"><%= t.c_remove_results %></button></div>
    <div id="csAddressList" class="cs-address-list" aria-live="polite"><p class="cs-empty"><%= t.c_empty %></p></div><button id="csMore" class="esp-ghost cs-wide" type="button" hidden><%= t.c_more %></button>
   </section>
   <section class="cs-order-card"><h2><%= t.c_summary %></h2><dl id="csQuote"><div><dt><%= t.c_selected_count %></dt><dd id="csQuoteCount">0</dd></div><div><dt><%= t.c_credit %></dt><dd id="csQuoteCredit">—</dd></div><div><dt><%= t.c_extra %></dt><dd id="csQuoteExtra">—</dd></div><div><dt><%= t.c_before_tax %></dt><dd id="csSubtotal">—</dd></div><div><dt><%= t.c_tax %></dt><dd id="csTax">—</dd></div><div class="cs-total"><dt><%= t.c_total %></dt><dd id="csTotal">—</dd></div></dl><button id="csQuoteRetry" class="esp-ghost" type="button" hidden><%= t.c_retry %></button><p id="csQuoteStatus" class="cs-fine" role="status"></p><p id="csCreditNote" class="cs-fine" hidden><%= t.c_credit_note %></p><label for="csNotes"><%= t.c_notes %></label><textarea id="csNotes" rows="2" maxlength="1000" placeholder="<%= t.c_notes_ph %>"></textarea><button id="csCheckout" type="button" class="esp-btn cs-wide" disabled><%= t.c_checkout %> ↗</button><p class="cs-fine"><%= t.c_data_note %></p><p id="csSuccess" class="esp-mail-success" role="status"></p></section>
  </aside>
  <section class="cs-map-panel" aria-label="<%= t.c_map %>"><div class="cs-map-tools"><div><button id="csProvince" class="is-on" type="button"><%= t.c_quebec %></button><button id="csFit" type="button"><%= t.c_fit %></button></div><button id="csFullscreen" type="button" aria-expanded="false" aria-controls="csMap"><%= t.c_map_expand %> ⛶</button></div>
   <div id="csMapRadiusBar" class="cs-map-radius" hidden><label for="csMapRadius"><%= t.c_radius %> <output id="csMapRadiusValue" for="csMapRadius">800 m</output></label><input id="csMapRadius" type="range" min="200" max="5000" step="50" value="800" aria-describedby="csMapGestureHelp"><p id="csMapGestureHelp"><%= t.c_zoom_help %></p></div>
   <div class="cs-map-shell"><div id="csMap" tabindex="0" aria-label="<%= t.c_map %>"></div><div id="csMapWelcome" class="cs-map-welcome"><span class="ws-eyebrow">QUÉBEC</span><h2><%= t.c_initial %></h2><p><%= t.c_initial_note %></p><div><button data-city="montreal" type="button">Montréal ↗</button><button data-city="quebec" type="button">Québec ↗</button><button data-city="sherbrooke" type="button">Sherbrooke ↗</button></div></div><p id="csMapHint" class="cs-map-hint" role="status"><%= t.c_map_hint %></p></div>
   <div id="csMapPending" class="cs-map-pending" hidden><div><strong id="csMapPendingTitle"><%= t.c_area_preview %></strong><p id="csMapPendingCount"></p></div><div class="cs-map-pending-actions"><button id="csMapApply" class="esp-btn" type="button"><%= t.c_update_addresses %></button><button id="csMapDiscard" class="esp-ghost" type="button"><%= t.c_keep_area %></button></div></div>
   <p id="csMapError" class="esp-error cs-map-error" role="alert"></p>
   <div class="cs-legend"><span><i class="cs-selected-dot"></i><%= t.c_view_selected %></span><span><i class="cs-removed-dot"></i><%= t.c_view_removed %></span><small><%= t.c_map_only %></small></div>
   <div id="csMapSummary" class="cs-map-summary" hidden><div><strong id="csMapCount"></strong><span id="csMapTotal"></span></div><button id="csQuickReview" type="button" class="esp-btn" disabled><%= t.c_quick_review %> ↗</button></div><div id="csProperty" class="cs-property" hidden></div>
  </section>
 </div>
 <%- include('campaign-history') %>
 <dialog id="csLetterDialog" class="cs-dialog cs-letter-dialog"><div class="cs-dialog-head"><h2><%= t.c_letter_title %></h2><button data-close-dialog type="button" aria-label="<%= t.c_close %>">×</button></div><p><%= t.c_letter_note %></p><a class="esp-ghost" href="espace/lettre-proprietaires" target="_blank" rel="noopener"><%= t.c_print %> ↗</a><iframe id="csLetterFrame" title="<%= t.esp_letter_preview_alt %>" data-src="espace/lettre-proprietaires?_embed=1"></iframe></dialog>
 <dialog id="csReviewDialog" class="cs-dialog"><div class="cs-dialog-head"><h2><%= t.c_review_title %></h2><button data-close-dialog type="button" aria-label="<%= t.c_close %>">×</button></div><div id="csReviewContent"></div><p><%= t.c_review_note %></p><p id="csReviewError" class="esp-error" role="alert"></p><div class="cs-dialog-actions"><button data-close-dialog type="button" class="esp-ghost"><%= t.c_review_later %></button><button id="csConfirm" type="button" class="esp-btn"><%= t.c_confirm %> ↗</button></div></dialog>
</section>
