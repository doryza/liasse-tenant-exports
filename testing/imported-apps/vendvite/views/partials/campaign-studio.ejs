<section id="campaignStudio" class="cs-studio cs-wizard" aria-labelledby="csTitle">
 <header class="cs-heading"><div><p class="ws-eyebrow"><%= t.c_eyebrow %></p><h1 id="csTitle"><%= t.c_title %></h1><p><%= t.c_intro %></p></div><a class="esp-ghost" data-vv-auth href="espace/page"><%= t.c_edit_page %> ↗</a></header>
 <nav class="cs-stepper" aria-label="<%= t.c_steps %>"><% [t.c_step_region,t.c_step_letter,t.c_step_launch].forEach(function(label,i){ %><button type="button" data-step="<%= i+1 %>" aria-current="<%= i===0?'step':'false' %>" <%= i?'disabled':'' %>><span><%= i+1 %></span><%= label %></button><% }); %></nav>
 <div class="cs-topline"><p id="csDraftStatus" role="status"><%= t.c_loading %></p><div><button id="csDraftRestore" type="button" hidden><%= t.c_restore_shared %></button><button id="csDraftRetry" type="button" hidden><%= t.c_retry %></button><button id="csNew" type="button"><%= t.c_new %> +</button></div></div>
 <p id="csFlowError" class="esp-error" role="alert"></p>
 <section id="csStep1" class="cs-step" aria-labelledby="csRegionTitle">
  <h2 id="csRegionTitle" tabindex="-1"><%= t.c_region_title %></h2>
  <div class="cs-layout"><aside class="cs-controls">   <section class="cs-search-card"><label for="csSearch"><%= t.c_search %></label><form id="csSearchForm"><div class="cs-search-row"><input id="csSearch" autocomplete="off" type="search" placeholder="<%= t.c_search_ph %>" maxlength="200" role="combobox" aria-expanded="false" aria-controls="csSuggestions"><button class="esp-btn" type="submit" aria-label="<%= t.c_search_btn %>">↗</button></div><ul id="csSuggestions" role="listbox" hidden></ul></form>
    <div class="cs-search-options"><label><span><%= t.c_radius %></span><select id="csRadius"><% [200,400,800,1500,3000,5000].forEach(function(r){ %><option value="<%= r %>" <%= r===800?'selected':'' %>><%= r<1000?r+' m':(r/1000)+' km' %></option><% }); %></select></label><label><span><%= t.c_target %></span><input id="csTarget" type="number" min="1" max="1200" value="150" step="1"></label></div>
    <div class="cs-volumes" role="group" aria-label="<%= t.c_target %>"><% [100,150,300,500].forEach(function(n){ %><button type="button" data-volume="<%= n %>" aria-pressed="<%= n===150 %>"><%= n %></button><% }); %></div><div class="cs-search-actions"><button id="csScan" type="button" class="esp-btn" disabled><%= t.c_scan %> ↗</button></div><button id="csCancelSearch" type="button" hidden><%= t.c_cancel %></button>
    <p id="csStatus" class="cs-status" role="status" aria-live="polite"></p><p id="csError" class="esp-error" role="alert"></p>
   </section>
</aside>  <section class="cs-map-panel" aria-label="<%= t.c_map %>"><div class="cs-map-tools"><div><button id="csProvince" class="is-on" type="button"><%= t.c_quebec %></button><button id="csFit" type="button"><%= t.c_fit %></button></div><button id="csFullscreen" type="button" aria-expanded="false" aria-controls="csMap"><%= t.c_map_expand %> ⛶</button></div>
   <div id="csMapRadiusBar" class="cs-map-radius" hidden><label for="csMapRadius"><%= t.c_radius %> <output id="csMapRadiusValue" for="csMapRadius">800 m</output></label><input id="csMapRadius" type="range" min="200" max="5000" step="50" value="800" aria-describedby="csMapGestureHelp"><p id="csMapGestureHelp"><%= t.c_zoom_help %></p></div>
   <div class="cs-map-shell"><div id="csMap" tabindex="0" aria-label="<%= t.c_map %>"></div><div id="csMapWelcome" class="cs-map-welcome"><span class="ws-eyebrow">QUÉBEC</span><h2><%= t.c_initial %></h2><p><%= t.c_initial_note %></p><div><button data-city="montreal" type="button">Montréal ↗</button><button data-city="quebec" type="button">Québec ↗</button><button data-city="sherbrooke" type="button">Sherbrooke ↗</button></div></div><p id="csMapHint" class="cs-map-hint" role="status"><%= t.c_map_hint %></p></div>
   <div id="csMapPending" class="cs-map-pending" hidden><div><strong id="csMapPendingTitle"><%= t.c_area_preview %></strong><p id="csMapPendingCount"></p></div><div class="cs-map-pending-actions"><button id="csMapApply" class="esp-btn" type="button"><%= t.c_update_addresses %></button><button id="csMapDiscard" class="esp-ghost" type="button"><%= t.c_keep_area %></button></div></div>
   <p id="csMapError" class="esp-error cs-map-error" role="alert"></p>
   <div class="cs-legend"><span><i class="cs-selected-dot"></i><%= t.c_view_selected %></span><span><i class="cs-removed-dot"></i><%= t.c_view_removed %></span><small><%= t.c_map_only %></small></div>
   <div id="csMapSummary" class="cs-map-summary" hidden><div><strong id="csMapCount"></strong><span id="csMapTotal"></span></div><button id="csQuickReview" type="button" class="esp-btn" disabled><%= t.c_quick_review %> ↗</button></div><div id="csProperty" class="cs-property" hidden></div>
  </section></div>
  <div class="cs-area-result"><div><strong id="csFlowCount">0</strong> <%= t.c_letters %><p id="csFlowArea"><%= t.c_region_hint %></p></div><button class="esp-btn" id="csNextLetter" type="button" disabled><%= t.c_next_letter %> →</button></div>
     <details class="cs-selection-card"><summary><%= t.c_edit_addresses %> <span>+</span></summary><div class="cs-section-heading"><h2><%= t.c_selection %></h2><button id="csUndo" type="button" disabled aria-label="<%= t.c_undo %>" title="<%= t.c_undo %>">↶</button></div>
    <div class="cs-stats"><div><div class="cs-selected-total"><strong id="csSelected">0</strong><span>/ <b id="csTargetTotal">150</b></span></div><span><%= t.c_selected_letters %></span></div><div><strong id="csFound">0</strong><span><%= t.c_mapped_count %></span></div></div>
    <p id="csEstimatedSelected" class="cs-fine" hidden></p><p id="csTargetProgress" class="cs-target-progress" role="status" hidden></p>
    <p id="csEstimatesNote" class="cs-fine" hidden></p><p id="csLimitNote" class="cs-fine" hidden><%= t.c_limit %></p>
    <div id="csTargetRecovery" class="cs-target-recovery" hidden><p id="csTargetHelp"></p><div><button id="csFill" class="esp-ghost" type="button" title="<%= t.c_under_target_note %>"><%= t.c_under_target %></button><button id="csExpandArea" class="esp-ghost" type="button"><%= t.c_expand_area %></button><button id="csAddEstimated" type="button"></button></div></div>
    <div class="cs-list-search"><label for="csAddressSearch"><%= t.c_find_address %></label><input id="csAddressSearch" type="search" placeholder="<%= t.c_find_address %>"></div>
    <p class="cs-fine"><%= t.c_remove_hint %></p>
    <div class="cs-tabs" role="group" aria-label="<%= t.c_selection %>"><button data-view="all" class="is-on" aria-pressed="true" type="button"><%= t.c_view_all %></button><button data-view="selected" aria-pressed="false" type="button"><%= t.c_view_selected %></button><button data-view="removed" aria-pressed="false" type="button"><%= t.c_view_removed %></button></div>
    <p id="csSelectionLimit" class="cs-target-progress" role="status" hidden></p>
    <div class="cs-bulk"><button id="csSelectFiltered" type="button" aria-describedby="csSelectionLimit"><%= t.c_select_results %></button><button id="csRemoveFiltered" type="button"><%= t.c_remove_results %></button></div>
    <div id="csAddressList" class="cs-address-list" aria-live="polite"><p class="cs-empty"><%= t.c_empty %></p></div><button id="csMore" class="esp-ghost cs-wide" type="button" hidden><%= t.c_more %></button>
   </details>
  <div class="cs-tools"><button id="csExport" type="button"><%= t.c_export %> ↓</button></div>
 </section>
 <section id="csStep2" class="cs-step" aria-labelledby="csProofTitle" hidden>
  <h2 id="csProofTitle" tabindex="-1"><%= t.c_proof_title %></h2><p class="cs-step-intro"><%= t.c_proof_intro %></p>
  <div class="cs-proof-layout"><div class="cs-proof"><div class="cs-proof-tools"><div><button type="button" data-proof-lang="fr" aria-pressed="<%= lang==='fr' %>">Français</button><button type="button" data-proof-lang="en" aria-pressed="<%= lang==='en' %>">English</button></div><button type="button" id="csProofZoom" aria-pressed="false"><%= lang==='fr'?'Agrandir':'Enlarge' %></button><a id="csPrintProof" href="espace/lettre-proprietaires?proof=1" target="_blank" rel="noopener"><%= t.c_print %> ↗</a></div><p id="csProofStatus" role="status"></p><iframe id="csLetterFrame" title="<%= t.esp_letter_preview_alt %>"></iframe></div>
  <aside class="cs-proof-aside"><p class="ws-eyebrow"><%= t.c_on_your_behalf %></p><h3><%= profile.agent_name || broker.full_name %></h3><p><%= profile.agency || broker.agency %></p><p><%= profile.agent_phone || broker.phone %></p><a data-vv-auth href="espace/page"><%= t.c_edit_page %> ↗</a><div class="cs-qr-explainer"><span aria-hidden="true">⌁</span><h3><%= t.c_prefilled_title %></h3><p><%= t.c_prefilled_body %></p><p class="cs-fine"><%= t.c_duplex_note %></p></div></aside></div>
  <div class="cs-proof-approval"><label><input type="checkbox" id="csLetterApproved"><span><%= t.c_approve_letter %></span></label><div><button class="esp-ghost" type="button" data-back="1">← <%= t.c_step_region %></button><button class="esp-btn" id="csNextTotal" type="button" disabled><%= t.c_next_total %> →</button></div></div>
 </section>
 <section id="csStep3" class="cs-step" aria-labelledby="csLaunchTitle" hidden>
  <h2 id="csLaunchTitle" tabindex="-1"><%= t.c_launch_title %></h2><div class="cs-checkout-layout">
     <section class="cs-order-card"><h2><%= t.c_summary %></h2><p class="cs-fine"><%= t.c_all_in %></p><p class="cs-fine"><%= (campPrixCents/100).toLocaleString(lang==='fr'?'fr-CA':'en-CA',{style:'currency',currency:'CAD'}) %> <%= lang==='fr'?'par lettre, avant taxes.':'per letter, before tax.' %></p><dl id="csQuote"><div><dt><%= t.c_selected_count %></dt><dd id="csQuoteCount">0</dd></div><div <%= isMailing?'hidden':'' %>><dt><%= t.c_credit %></dt><dd id="csQuoteCredit">—</dd></div><div <%= isMailing?'hidden':'' %>><dt><%= t.c_extra %></dt><dd id="csQuoteExtra">—</dd></div><div><dt><%= t.c_before_tax %></dt><dd id="csSubtotal">—</dd></div><div><dt><%= t.c_tax %></dt><dd id="csTax">—</dd></div><div class="cs-total"><dt><%= t.c_total %></dt><dd id="csTotal">—</dd></div></dl><button id="csQuoteRetry" class="esp-ghost" type="button" hidden><%= t.c_retry %></button><p id="csQuoteStatus" class="cs-fine" role="status"></p><p id="csCreditNote" class="cs-fine" hidden><%= t.c_credit_note %></p><details class="cs-notes"><summary><%= t.c_notes %></summary><label for="csNotes"><%= t.c_notes %></label><textarea id="csNotes" rows="2" maxlength="1000" placeholder="<%= t.c_notes_ph %>"></textarea></details><button hidden id="csCheckout" type="button" class="esp-btn cs-wide" disabled><%= t.c_checkout %> ↗</button><p class="cs-fine"><%= t.c_data_note %></p><p id="csSuccess" class="esp-mail-success" role="status"></p></section>
  <aside class="cs-launch-aside"><div class="cs-mail-promise"><span class="cs-promise-number">72 h</span><h3><%= t.c_promise_title %></h3><p><%= t.c_promise_body %></p></div><div id="csReviewContent"></div><p><%= t.c_review_note %></p><p id="csReviewError" class="esp-error" role="alert"></p><button id="csConfirm" type="button" class="esp-btn cs-wide"><%= t.c_confirm %> →</button><p id="csPaymentMethod" class="cs-payment-method" hidden><strong>PayPal</strong><span><%= lang==='fr'?'accepté':'accepted' %></span></p><button data-back="2" type="button" class="esp-ghost cs-wide">← <%= t.c_step_letter %></button></aside></div>
 </section>
 <%- include('campaign-history') %>
</section>
