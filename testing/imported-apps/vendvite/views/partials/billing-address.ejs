<% var sandboxBilling=typeof campModePaypal!=='undefined'&&campModePaypal==='sandbox'; %><section class="ws-card" id="billingAddressCard">
<h2><%= lang==='en'?'Business billing address':'Adresse professionnelle de facturation' %></h2>
<p><%= lang==='en'?'Confirm the purchasing business address for your invoice. Postal campaign taxes follow the delivery province of each selected mailing address.':'Confirmez l’adresse de l’entreprise acheteuse pour la facture. Les taxes des campagnes postales suivent la province de livraison de chaque adresse sélectionnée.' %></p>
<% if(sandboxBilling){ %><p role="note"><strong>TEST SANDBOX</strong> — <%= lang==='en'?'This address is prefilled from your account until you save a separate test address. Saving here does not change your real billing address.':'Cette adresse reprend celle de votre compte jusqu’à l’enregistrement d’une adresse de test distincte. L’enregistrement ici ne modifie pas votre adresse de facturation réelle.' %></p><% } %>
<form id="billingAddressForm" data-payment-mode="<%= sandboxBilling?'sandbox':'live' %>" style="display:grid;gap:12px;max-width:620px">
<% [['legal_name',lang==='en'?'Legal name':'Nom légal'],['line1',lang==='en'?'Street address':'Adresse'],['city',lang==='en'?'City':'Ville'],['postal_code',lang==='en'?'Postal code':'Code postal']].forEach(function(f){ %><label style="display:grid;gap:4px"><%= f[1] %><input name="<%= f[0] %>" value="<%= billingAddress[f[0]]||'' %>" required maxlength="160" style="width:100%;box-sizing:border-box;padding:12px"></label><% }); %>
<label style="display:grid;gap:4px"><%= lang==='en'?'Province / Territory':'Province / Territoire' %><select name="province" required style="padding:12px"><option value="">—</option><% Object.keys(billingProvinces).forEach(function(p){ %><option value="<%= p %>" <%= billingAddress.province===p?'selected':'' %>><%= billingProvinces[p] %></option><% }); %></select></label>
<label><input name="confirmed" type="checkbox" required> <%= lang==='en'?'I confirm this is the Canadian business address connected to this purchase.':'Je confirme que cette adresse professionnelle canadienne est liée à cet achat.' %></label>
<button class="esp-btn" type="submit"><%= lang==='en'?'Confirm billing address':'Confirmer l’adresse de facturation' %></button><p id="billingAddressStatus" role="status"><%= billingConfirmed?(lang==='en'?'Saved. Confirm again if your address changes.':'Enregistrée. Confirmez à nouveau si votre adresse change.') : '' %></p>
</form></section>
