<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#E30B2D">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="description" content="<%= t.meta_desc %>">
<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= settings.agent_name || 'VendVite' %>">
<meta property="og:title" content="<%= (settings.agent_name || t.agent_fallback_name) %> — <%= t.meta_title %>">
<meta property="og:description" content="<%= t.meta_desc %>">
<meta property="og:locale" content="<%= lang==='en' ? 'en_CA' : 'fr_CA' %>">
<% if(typeof ogImage!=='undefined' && ogImage){ %><meta property="og:image" content="<%= ogImage %>"><% } %>
<% if(typeof canonical!=='undefined' && canonical){ %><meta property="og:url" content="<%= canonical %>"><link rel="canonical" href="<%= canonical %>"><% } %>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= (settings.agent_name || t.agent_fallback_name) %> — <%= t.meta_title %>">
<meta name="twitter:description" content="<%= t.meta_desc %>">
<% if(typeof ogImage!=='undefined' && ogImage){ %><meta name="twitter:image" content="<%= ogImage %>"><% } %>
<title><%= (settings.agent_name || t.agent_fallback_name) %> — <%= t.meta_title %></title>
<link rel="manifest" href="manifest.json">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..900&family=IBM+Plex+Mono:wght@500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="public/css/styles.css?v=recipient-address-v2">
<% if(typeof inlineEditor!=='undefined'&&inlineEditor){ %><meta name="robots" content="noindex,nofollow"><link rel="stylesheet" href="public/css/page-editor-v1.css?v=1"><script src="public/js/broker-navigation-v1.js" defer></script><% } %>
</head>
<body class="<%= typeof inlineEditor!=='undefined'&&inlineEditor?'pe-body':'' %> <%= typeof initialAddress!=='undefined'&&initialAddress?'bp-prefilled':'' %>">
<header class="topbar">
  <div class="container topbar-inner">
    <a class="wordmark" href="." aria-label="VendVite">
      <span class="seal" aria-hidden="true">V</span>
      <span>VendVite</span>
    </a>
    <div class="lang-toggle">
      <a href="<%= (typeof cheminCourant !== 'undefined' ? cheminCourant : '') %>?lang=fr" class="<%= lang==='fr'?'active':'' %>">FR</a><span aria-hidden="true">·</span><a href="<%= (typeof cheminCourant !== 'undefined' ? cheminCourant : '') %>?lang=en" class="<%= lang==='en'?'active':'' %>">EN</a>
    </div>
    <div class="topbar-right">
      <% if(settings.agent_phone){ %><a class="topbar-phone" href="tel:<%= String(settings.agent_phone).replace(/\D/g,'') %>" data-setting-key="agent_phone"><%= formatPhone(settings.agent_phone) %></a><% } %>
      <a class="topbar-cta" href="./#evaluation"<%= (typeof isHome!=='undefined' && isHome) ? ' data-scroll-eval' : '' %> data-lk="t:topbar_cta"><%= t.topbar_cta %></a>
    </div>
  </div>
</header>
