<% [['admin','dashboard','Suivi & conversions'],['admin/sollicitations','sollicitations','Sollicitations'],['admin/courtiers','courtiers','Agents'],['admin/campagnes','campagnes','Commandes postales']].forEach(function(link){ %><a href="<%= link[0] %>" class="<%= typeof active!=='undefined'&&active===link[1]?'active':'' %>"><%= link[2] %></a><% }); %>
</nav><div class="admin-nav-foot"><a href="admin/operations-settings">Paiements & réglages</a><a href="." target="_blank" rel="noopener">Voir le site ↗</a></div></aside>
<script>(function(){function init(){var panel=document.getElementById('adminSidebar'),toggle=document.getElementById('adminBurger'),close=document.getElementById('adminMenuClose'),mobile=window.matchMedia('(max-width:820px)');if(!panel||!toggle)return;toggle.setAttribute('aria-controls','adminSidebar');function setOpen(open,restore){panel.classList.toggle('open',open);toggle.setAttribute('aria-expanded',String(open));panel.inert=mobile.matches&&!open;if(mobile.matches)panel.setAttribute('aria-hidden',String(!open));else panel.removeAttribute('aria-hidden');if(restore)toggle.focus();}setOpen(false);document.addEventListener('click',function(e){var target=e.target;if(target.closest&&target.closest('#adminBurger')){e.preventDefault();e.stopImmediatePropagation();var opening=!panel.classList.contains('open');setOpen(opening);if(opening)close.focus();return;}if(target.closest&&target.closest('#adminMenuClose')){e.preventDefault();setOpen(false,true);return;}if(mobile.matches&&panel.classList.contains('open')&&!panel.contains(target))setOpen(false);},true);document.addEventListener('keydown',function(e){if(e.key==='Escape'&&mobile.matches&&panel.classList.contains('open')){e.preventDefault();setOpen(false,true);}});mobile.addEventListener('change',function(){setOpen(false);});}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();})();</script>
