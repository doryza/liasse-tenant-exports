<aside class="admin-sidebar" id="adminSidebar">
  <% var adminRoot = (typeof active!=='undefined' && active==='dashboard') ? 'admin' : '../admin'; %>
  <div class="admin-brand"><span class="admin-seal">V</span><span><%= (typeof settings!=='undefined' && settings.agent_name) ? settings.agent_name : 'RE/MAX' %></span></div>
  <nav class="admin-nav">
    <a href="<%= adminRoot %>" class="<%= (typeof active!=='undefined' && active==='dashboard') ? 'active' : '' %>">Tableau de bord</a>
    <a href="<%= adminRoot %>/leads" class="<%= (typeof active!=='undefined' && active==='leads') ? 'active' : '' %>">Demandes</a>
    <a href="<%= adminRoot %>/courtiers" class="<%= (typeof active!=='undefined' && active==='courtiers') ? 'active' : '' %>">Courtiers</a>
    <a href="<%= adminRoot %>/campagnes" class="<%= (typeof active!=='undefined' && active==='campagnes') ? 'active' : '' %>">Campagnes</a>
    <a href="<%= adminRoot %>/ventes" class="<%= (typeof active!=='undefined' && active==='ventes') ? 'active' : '' %>">Ventes</a>
    <a href="<%= adminRoot %>/testimonials" class="<%= (typeof active!=='undefined' && active==='testimonials') ? 'active' : '' %>">Témoignages</a>
    <a href="<%= adminRoot %>/posts" class="<%= (typeof active!=='undefined' && active==='posts') ? 'active' : '' %>">Journal</a>
    <a href="<%= adminRoot %>/settings" class="<%= (typeof active!=='undefined' && active==='settings') ? 'active' : '' %>">Réglages</a>
  </nav>
  <div class="admin-nav-foot">
    <a href="<%= (typeof active!=='undefined' && active==='dashboard') ? '.' : '../' %>" target="_blank">Voir le site</a>
  </div>
</aside>
