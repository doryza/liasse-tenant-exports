<% var pr=campaign.production||{},en=reportLang==='en'; %><section class="ops-card"><h2><%= en?'Mailing preparation report':'Rapport de préparation postale' %></h2><p><strong><%= pr.orderedCount %></strong> <%= en?'letters ordered':'lettres commandées' %> · <strong><%= pr.preparedCount %></strong> <%= en?'letters prepared':'lettres préparées' %></p><p><%= en?'One letter per building. The unit chosen for this mailing is shown below. Other identified units and omitted addresses remain listed for planning a future mailing. Undocumented unit numbers are not guessed.':'Une lettre par bâtiment. L’unité choisie pour cet envoi apparaît ci-dessous. Les autres unités identifiées et les adresses non retenues restent listées pour préparer un futur mailer. Les numéros d’unité inconnus ne sont pas inventés.' %></p><% if(pr.preparedCount<pr.orderedCount){ %><p class="ops-warning"><%= pr.orderedCount-pr.preparedCount %> <%= en?'ordered address(es) not prepared. This report does not automatically change your payment or issue a credit.':'adresse(s) commandée(s) non préparée(s). Ce rapport ne modifie pas automatiquement votre paiement et n’émet pas de crédit.' %></p><% } %>
<% if(pr.shortfall&&pr.shortfall.state==='accepted'){ %><p class="ops-ok"><%= en?'You explicitly accepted the prepared quantity at the original total on ':'Vous avez accepté explicitement la quantité préparée au montant initial le ' %><%= new Date(pr.shortfall.decidedAt).toLocaleString(en?'en-CA':'fr-CA') %>.</p><% } %>
<% if(!(pr.report||[]).length){ %><p><%= en?'All ordered addresses are prepared; no multi-unit exception was identified in the available data.':'Toutes les adresses commandées sont préparées; aucune exception d’unités n’a été identifiée dans les données disponibles.' %></p><% } %>
<% (pr.report||[]).forEach(function(g){ %><article class="ops-group"><h3><%= g.address.numero %> <%= g.address.rue %>, <%= g.address.ville %></h3><p><%= en?'Selected for this mailing:':'Retenue pour cet envoi :' %> <strong><%= g.selected?(g.selected.unit?(en?'unit ':'unité ')+g.selected.unit:(en?'civic address':'adresse civique')):(en?'none':'aucune') %></strong><%= g.selected?' · '+g.selected.postal:'' %></p><% if(g.knownUnits){ %><p><%= g.knownUnits %> <%= en?'documented dwellings in the building. This does not provide their unit numbers.':'logements documentés dans le bâtiment. Ce nombre ne fournit pas leurs numéros d’unité.' %></p><% } %><% if(g.missing){ %><p class="ops-warning"><%= en?'Address missing from the returned postal file.':'Adresse absente du fichier postal retourné.' %></p><% } %><ul class="ops-report-list"><% g.omitted.forEach(function(item){ %><li><%= item.address.unit?(en?'Unit ':'Unité ')+item.address.unit:(en?'Civic address':'Adresse civique') %> · <%= item.address.postal||'—' %> · <%= en?(item.reason==='Code postal manquant ou invalide'?'Missing or invalid postal code':item.reason.startsWith('Déjà ciblée')?'Previously targeted on '+item.reason.slice(14):'Not selected'):item.reason %></li><% }); %></ul><% if(g.multiUnit&&!g.omitted.length){ %><p class="ops-muted"><%= en?'Other unit numbers were not returned by the address lookup; they must be identified before a future mailing.':'Les autres numéros d’unité n’ont pas été retournés par la recherche d’adresses; ils devront être identifiés avant un prochain mailer.' %></p><% } %></article><% }); %></section>
