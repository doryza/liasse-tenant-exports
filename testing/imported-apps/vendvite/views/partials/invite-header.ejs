<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0D0A0B">
<meta name="robots" content="noindex, nofollow">
<meta name="description" content="<%= t.inv_meta_desc %>">
<meta property="og:type" content="website">
<meta property="og:site_name" content="VendVite">
<meta property="og:title" content="VendVite — <%= t.inv_meta_title %>">
<meta property="og:description" content="<%= t.inv_meta_desc %>">
<meta property="og:locale" content="<%= lang==='en' ? 'en_CA' : 'fr_CA' %>">
<title>VendVite — <%= typeof ws!=='undefined' && ws ? t.ws_home : t.inv_meta_title %></title>
<link rel="manifest" href="manifest.json">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..900&family=IBM+Plex+Mono:wght@500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="public/css/styles.css">
<% if (typeof experiment !== 'undefined') { %><link rel="stylesheet" href="public/css/homepage.css?v=homepage-price-v1"><% } %>
<% if(typeof ws!=='undefined' && ws){ %><link rel="stylesheet" href="public/css/workspace-v1.css"><% } %>
<script src="public/js/broker-navigation-v1.js" defer></script>
</head>
<body class="inv-body">
<% if (typeof langueVisible === 'undefined' || langueVisible) { %>
<div class="inv-lang">
  <a href="<%= (typeof cheminCourant !== 'undefined' ? cheminCourant : '') %>?lang=fr<%= typeof experiment !== 'undefined' && experiment.preview ? '&vv_preview='+experiment.variant : '' %>" class="<%= lang==='fr'?'active':'' %>">FR</a><span aria-hidden="true">·</span><a href="<%= (typeof cheminCourant !== 'undefined' ? cheminCourant : '') %>?lang=en<%= typeof experiment !== 'undefined' && experiment.preview ? '&vv_preview='+experiment.variant : '' %>" class="<%= lang==='en'?'active':'' %>">EN</a>
</div>
<% } %>
