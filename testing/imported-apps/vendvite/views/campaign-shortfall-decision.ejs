<!doctype html><html lang="<%= lang %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>VendVite — <%= lang==='en'?'Your mailing decision':'Votre décision pour cet envoi' %></title><link rel="stylesheet" href="public/css/admin-styles.css"><link rel="stylesheet" href="public/css/admin-operations-v1.css"><link rel="stylesheet" href="public/css/admin-production-v2.css"></head><body class="ops-report"><main class="ops" style="max-width:900px;margin:30px auto;padding:18px"><% var en=lang==='en',p=campaign.production,x=p.shortfall,test=Number(campaign.is_test)===1||campaign.paypal_mode==='sandbox'; %><a href="espace/commandes/<%= campaign.id %>"><%= en?'← My order':'← Ma commande' %></a><h1><%= en?'Confirm a smaller mailing':'Décider pour un envoi réduit' %> #<%= campaign.id %></h1><% if(test){ %><p class="ops-warning"><strong>TEST SANDBOX</strong> — <%= en?'Simulation only. No real payment, postal mailing, refund or credit. Your choice is recorded only for this test order.':'Simulation uniquement. Aucun paiement, envoi postal, remboursement ou crédit réel. Votre choix est enregistré uniquement pour cette commande test.' %></p><p><a href="espace/tests/notifications?campaign=<%= campaign.id %>"><%= en?'View simulated emails':'Voir les courriels simulés' %></a></p><% } %><section class="ops-card"><p><%= en?'The postal lookup could prepare':'La recherche postale a permis de préparer' %> <strong><%= x.preparedCount %> / <%= x.orderedCount %></strong> <%= en?'letters.':'lettres.' %> <strong><%= x.missingCount %></strong> <%= test?(en?'are omitted from this simulation.':'sont omises de cette simulation.'):(en?'will not be sent.':'ne seront pas envoyées.') %></p><p><%= test?(en?'Simulated sandbox amount:':'Montant sandbox simulé :'):(en?'Original amount paid:':'Montant initial payé :') %> <strong><%= (x.totalCents/100).toLocaleString(en?'en-CA':'fr-CA',{style:'currency',currency:'CAD',currencyDisplay:'code'}) %></strong>.</p><p class="ops-warning"><%= test?(en?'This rehearses accepting a smaller mailing at the full simulated price. It creates no real financial agreement or mailing. Declining keeps the test order on hold so you can rehearse the resolution.':'Ce test reproduit l’acceptation d’un envoi réduit au prix simulé intégral. Il ne crée aucun accord financier ni envoi réel. Refuser conserve la commande test en attente pour répéter la résolution.') : en?'Accepting authorizes the smaller mailing for the full original amount. No refund or credit will be issued for the missing letters under this acceptance. You can decline; the order will stay on hold while VendVite resolves the missing addresses with you.':'Accepter autorise l’envoi réduit pour le montant initial intégral. Aucun remboursement ni crédit ne sera émis pour les lettres manquantes dans le cadre de cet accord. Vous pouvez refuser; la commande restera en attente pendant que VendVite résout les adresses manquantes avec vous.' %></p><% if(x.state==='requested'){ %><form id="shortfallDecision"><label><input id="decisionAcknowledge" type="checkbox" required> <%= en?'I have reviewed the quantity, unchanged amount and omitted-address report below.':'J’ai vérifié la quantité, le montant inchangé et le rapport des adresses non retenues ci-dessous.' %></label><button type="submit" value="accept" class="btn-primary"><%= test?(en?'Simulate acceptance at the full test price':'Simuler l’accord au prix test intégral'):(en?'Accept this smaller mailing at the full price':'Accepter cet envoi réduit au prix intégral') %></button><button type="submit" value="reject" class="btn-ghost"><%= test?(en?'Simulate decline — hold test order':'Simuler le refus — suspendre le test'):(en?'Decline — keep my order on hold':'Refuser — garder ma commande en attente') %></button></form><p id="decisionError" class="ops-error" role="alert"></p><% }else{ %><p class="ops-ok"><%= x.state==='accepted'?(en?'Your acceptance is recorded.':'Votre accord est enregistré.'):(en?'Your decline is recorded. This order is on hold for resolution.':'Votre refus est enregistré. La commande reste en attente d’une résolution.') %></p><% } %></section><%- include('partials/production-report',{campaign:{production:{orderedCount:x.orderedCount,preparedCount:x.preparedCount,report:x.report}},reportLang:lang}) %></main><script>window.VV_SHORTFALL=<%- scriptJson({id:campaign.id,revision:p.revision,en:en}) %>;</script><script src="public/js/campaign-shortfall-v1.js" defer></script></body></html>
