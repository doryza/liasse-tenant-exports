<%- include('partials/invite-header') %><main class="inv hp"><header class="hp-masthead hp-wrap"><a class="hp-brand" href=".">VendVite.</a><a class="hp-broker-login" href="connexion"><%= t.ws_login %> ↗</a></header><section class="hp-hero hp-wrap"><div class="hp-pitch"><p class="hp-eyebrow"><%= lang==='fr'?'Votre prochaine campagne commence ici':'Your next campaign starts here' %></p><h1><%= lang==='fr'?'Votre prochaine campagne, en 3 étapes.':'Your next campaign, in 3 steps.' %></h1><p class="hp-lede"><%= lang==='fr'?'Votre identité est déjà prête. Confirmez vos coordonnées pour accéder à votre campagne : choisissez votre secteur, vérifiez votre lettre, puis confirmez le coût de l’envoi.':'Your identity is already prepared. Confirm your details to open your campaign: choose your area, review your letter, then confirm the mailing cost.' %></p><ol class="mailing-onboarding-steps"><% (lang==='fr'?['Choisissez votre secteur','Voyez votre lettre personnalisée','Confirmez le coût — postée sous 72 h']:['Choose your target area','See your personalized letter','Confirm the cost — mailed within 72 h']).forEach(function(label,i){ %><li><span><%= i+1 %></span><%= label %></li><% }); %></ol><div class="hp-offer"><div class="hp-offer-price"><strong>0 $</strong><span><%= lang==='fr'?'pour la page':'for the page' %></span></div><p><%= lang==='fr'?'Aucun abonnement. Campagnes postales à 1,59 $ par lettre, avant taxes. Données, impression, pliage, enveloppe et dépôt chez Postes Canada.':'No subscription. Postal campaigns at $1.59 per letter, before tax. Data, printing, folding, envelope insertion and Canada Post deposit.' %></p></div><p><%= lang==='fr'?'Page réservée exclusivement aux campagnes postales confiées à VendVite.':'Page reserved exclusively for postal campaigns fulfilled by VendVite.' %></p></div>
<div class="inv-panel"><h2><%= lang==='fr'?'Activez votre espace gratuit':'Activate your free workspace' %></h2><form class="inv-form" id="mailingSignup"><input name="tag" type="hidden" value="<%= agent.tag %>"><% [['name',t.inv_f_name,agent.name,'text'],['agency',t.inv_f_agency,agent.agency,'text'],['phone',t.inv_f_phone,agent.phone,'tel'],['email',t.inv_f_email,'','email']].forEach(function(f){ %><div class="inv-field"><label for="signup-<%= f[0] %>"><%= f[1] %></label><input id="signup-<%= f[0] %>" name="<%= f[0] %>" type="<%= f[3] %>" value="<%= f[2] %>" maxlength="190" required></div><% }); %><label class="mailing-terms"><input type="checkbox" name="mailing_terms" required> <span><%= lang==='fr'?'J’utiliserai cette page uniquement pour les campagnes postales confiées à VendVite.':'I will use this page only for postal campaigns fulfilled by VendVite.' %></span></label><p class="inv-error" id="signupError" role="alert"></p><button class="inv-submit" type="submit"><%= lang==='fr'?'Recevoir mon lien d’activation':'Send my activation link' %> ↗</button><p><%= lang==='fr'?'Aucune carte requise. Vous validez le prix de chaque envoi avant de payer.':'No card required. You review each mailing’s price before paying.' %></p></form><p id="signupDone" role="status" hidden></p></div></section></main><script src="public/js/onboarding-mailing-v1.js" defer></script></body></html>
