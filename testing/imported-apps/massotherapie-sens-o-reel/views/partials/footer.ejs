</main><footer class="site-footer"><div class="footer-top"><div><img class="footer-seal" src="<%= settings._p_footer_logo_url || settings._p_nav_logo_url || (appIconUrl || '') %>" data-setting-key="_p_footer_logo_url" width="72" height="72" alt="Logo Sens-Ô-Réel" loading="lazy"><p data-setting-key="business_name"><%= settings.business_name %></p><p class="small" data-setting-key="tagline"><%= settings.tagline %></p></div><nav aria-label="<%= t.menu %>"><a href="<%= urls.home %>" data-lk="t:home"><%= t.home %></a><a href="<%= urls.services %>" data-lk="t:services"><%= t.services %></a><a href="<%= urls.about %>" data-lk="t:about"><%= t.about %></a><a href="<%= urls.contact %>" data-lk="t:contact"><%= t.contact %></a><a href="<%= urls.appointments %>" data-lk="t:appointments"><%= t.appointments %></a><a href="<%= urls.privacy %>" data-lk="t:privacy"><%= t.privacy %></a></nav><div><% if(flags.contact && settings.contact_phone){ %><a href="<%= phoneHref %>" data-setting-key="contact_phone"><%= settings.contact_phone %></a><% } else { %><p class="small" data-lk="t:contact_pending"><%= t.contact_pending %></p><% } %><% if(flags.contact && settings.business_address){ %><p class="small preserve" data-setting-key="business_address"><%= settings.business_address %></p><% } %><% if(flags.contact && settings.contact_email){ %><a class="small" href="<%= emailHref %>" data-setting-key="contact_email"><%= settings.contact_email %></a><% } %><details class="footer-hours"><summary data-lk="t:hours"><%= t.hours %></summary><% if(typeof hours!=='undefined' && hours.length){ %><dl class="hours-list"><% hours.forEach(h=>{ %><div><dt data-lk="t:day<%= h.weekday %>"><%= t['day'+h.weekday] %></dt><dd><% if(h.closed){ %><span data-lk="t:closed"><%= t.closed %></span><% } else { %><span data-content-source="hours:opens" data-content-id="<%= h.id %>"><%= h.opens %></span> – <span data-content-source="hours:closes" data-content-id="<%= h.id %>"><%= h.closes %></span><% } %></dd></div><% }); %></dl><% } else { %><p data-lk="t:no_hours"><%= t.no_hours %></p><% } %></details></div></div><div class="footer-bottom"><button type="button" class="text-button" data-push-btn data-lk="t:push"><%= t.push %></button><div class="languages"><a href="<%= langLinks.fr %>" lang="fr" data-lk="footer-fr">FR</a><a href="<%= langLinks.en %>" lang="en" data-lk="footer-en">EN</a></div><a href="admin" data-lk="t:admin"><%= t.admin %></a><button type="button" class="text-button" data-logout data-auth-only style="display:none" data-lk="t:logout"><%= t.logout %></button></div></footer><div class="mobile-action"><a class="button primary" href="<%= urls.appointments %>" data-lk="t:book"><%= t.book %></a><% if(flags.contact && settings.contact_phone){ %><a class="button secondary" href="<%= phoneHref %>" data-lk="t:call"><%= t.call %></a><% } else { %><a class="button secondary" href="<%= urls.contact %>" data-lk="t:contact"><%= t.contact %></a><% } %></div><script id="page-data" type="application/json"><%- safeJSON({t,lang,urls,page}) %></script><script src="public/js/navigation.js"></script><script src="public/js/app.js"></script></body></html>