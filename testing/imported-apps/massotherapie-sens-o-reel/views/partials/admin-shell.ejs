<%- include('admin-header') %><section id="module-editor" data-module="<%= module.key %>"><div class="admin-heading"><h1><%= module.label %></h1><button type="button" class="button primary" id="add-record"><%= t.add %></button></div><div class="admin-toolbar"><label><%= t.filter %><input id="filter-records" type="search"></label><label><%= t.sort %><select id="sort-records"><option value="new"><%= t.newest %></option><option value="old"><%= t.oldest %></option></select></label></div><p id="admin-status" role="status" aria-live="polite"></p><div class="table-wrap"><table><thead><tr><th>ID</th><th><%= module.label %></th><th><%= t.actions %></th></tr></thead><tbody id="records-body"></tbody></table></div><nav class="pagination" id="records-pagination"></nav><dialog id="record-dialog" aria-labelledby="record-title"><form id="record-form" method="POST" action="api/admin/<%= module.key %>"><header class="dialog-heading"><h2 id="record-title"><%= module.label %></h2><button type="button" id="close-record" class="button secondary"><%= t.close %></button></header><div id="record-fields"></div><p id="record-error" role="alert"></p><button class="button primary" type="submit"><%= t.save %></button></form></dialog><script id="module-data" type="application/json"><%- safeJSON({items:typeof items!=='undefined'?items:[],module}) %></script></section><%- include('admin-footer') %>