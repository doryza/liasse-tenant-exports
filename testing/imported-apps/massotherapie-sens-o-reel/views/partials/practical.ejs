<section class="practical spread"><div><h2 data-lk="t:coordinates"><%= t.coordinates %></h2><% if(flags.contact){ %><% if(settings.contact_phone){ %><a class="contact-number" href="<%= phoneHref %>" data-setting-key="contact_phone"><%= settings.contact_phone %></a><% } else { %><p data-lk="t:contact_pending"><%= t.contact_pending %></p><% } %><% if(settings.contact_email){ %><p><a href="<%= emailHref %>" data-setting-key="contact_email"><%= settings.contact_email %></a></p><% } else { %><p data-lk="t:question_text"><%= t.question_text %></p><% } %><% if(settings.business_address){ %><p class="preserve" data-setting-key="business_address"><%= settings.business_address %></p><% } else { %><p data-lk="t:address_pending"><%= t.address_pending %></p><% } %><% } else { %><p data-lk="t:contact_pending"><%= t.contact_pending %></p><% } %><% if(flags.contact && flags.address && settings.business_address){ %><a href="<%= directionsHref %>" target="_blank" rel="noopener noreferrer" data-lk="t:directions"><%= t.directions %> ↗</a><% } else { %><p class="small" data-lk="t:address_pending"><%= t.address_pending %></p><% } %></div><div><h2 data-lk="t:hours"><%= t.hours %></h2><% if(!flags.hours){ %><p class="small" data-lk="t:hours_pending"><%= t.hours_pending %></p><% } %><% if(typeof hours!=='undefined' && hours.length){ %><dl class="hours-list"><% hours.forEach(h=>{ %><div><dt data-lk="t:day<%= h.weekday %>"><%= t['day'+h.weekday] %></dt><dd><% if(h.closed){ %><span data-lk="t:closed"><%= t.closed %></span><% } else { %><span data-content-source="hours:opens" data-content-id="<%= h.id %>"><%= h.opens %></span> – <span data-content-source="hours:closes" data-content-id="<%= h.id %>"><%= h.closes %></span><% } %></dd></div><% }); %></dl><% } else { %><p data-lk="t:no_hours"><%= t.no_hours %></p><% } %></div></section>