<!DOCTYPE html>
<html lang="<%= typeof lang!=='undefined'?lang:'fr' %>"><head><meta charset="utf-8"><base href="<%= tenantRoot %>"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#2858ef"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="description" content="<%= settings.hero_subtitle || t.request_explain %>"><title><%= page==='home' ? settings.business_name : (t[page] || t.summary) + ' · ' + settings.business_name %></title><link rel="manifest" href="manifest.json"><link rel="stylesheet" href="public/css/styles.css"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600&family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet"></head><body data-page="<%= page %>"><a class="skip" href="<%= urls[page] || urls.appointments %>#main" data-lk="t:skip"><%= t.skip %></a><header class="site-header"><a class="brand-mark" href="<%= urls.home %>" aria-label="<%= settings.business_name %>"><img src="<%= (typeof settings!=='undefined' && settings._p_nav_logo_url) ? settings._p_nav_logo_url : (appIconUrl || '') %>" data-setting-key="_p_nav_logo_url" alt="Logo" width="431" height="100"></a><button class="menu-toggle" type="button" aria-label="Menu" aria-controls="site-nav" aria-expanded="false" data-lk="t:menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg><span><%= t.menu %></span></button><nav id="site-nav" aria-label="<%= t.menu %>"><a href="<%= urls.services %>" aria-current="<%= page==='services'?'page':'false' %>" data-lk="t:services"><%= t.services %></a><a href="<%= urls.about %>" aria-current="<%= page==='about'?'page':'false' %>" data-lk="t:about"><%= t.about %></a><a href="<%= urls.contact %>" aria-current="<%= page==='contact'?'page':'false' %>" data-lk="t:contact"><%= t.contact %></a><div class="languages"><a href="<%= langLinks.fr %>" lang="fr" aria-current="<%= lang==='fr'?'true':'false' %>" data-lk="nav-fr">FR</a><span aria-hidden="true">/</span><a href="<%= langLinks.en %>" lang="en" aria-current="<%= lang==='en'?'true':'false' %>" data-lk="nav-en">EN</a></div><a class="button primary" href="<%= urls.appointments %>" data-lk="t:book"><%= t.book %></a></nav></header><div class="utility"><% if(flags.contact && settings.contact_phone){ %><a href="<%= phoneHref %>" data-setting-key="contact_phone"><%= settings.contact_phone %></a><% } else { %><span data-lk="t:contact_pending"><%= t.contact_pending %></span><% } %><div><button class="text-button" type="button" data-login-btn data-lk="t:login"><%= t.login %></button><a href="<%= urls.appointments %>" data-auth-only style="display:none" data-lk="t:my_requests"><%= t.my_requests %></a></div></div><main id="main" class="site-main">