<%- include('partials/admin-header') %><h1><%= t.dashboard %></h1><section class="admin-stats"><% [['users',stats.userCount],['subscribers',stats.pushSubscriberCount],['visits',stats.totalVisits],['recent_visits',stats.recentVisits]].forEach(pair=>{ %><article><span><%= t[pair[0]] %></span><strong><%= pair[1] %></strong></article><% }); %></section><section class="admin-notice"><h2><%= t.setup_title %></h2><p><%= t.setup_help %></p><p><%= paypalConfigured?t.keys_present:t.keys_missing %></p><% if(!emailConfigured){ %><p><%= t.email_notice %></p><% } %><% if(!flags.operations){ %><p><%= t.operations_off %></p><% } %><a class="button primary" href="admin/settings"><%= t.settings %></a></section><div class="module-grid"><% if(typeof modules!=='undefined' && modules.length){modules.forEach(m=>{ %><a href="admin/<%= m.key %>"><strong><%= stats.counts[m.key] %></strong><span><%= m.label %> →</span></a><% });} %></div><section class="admin-panel"><h2><%= t.recent %></h2><% if(typeof recent!=='undefined' && recent.length){ %><div class="table-wrap"><table><thead><tr><th><%= t.name %></th><th><%= t.service %></th><th><%= t.date %></th><th><%= t.actions %></th></tr></thead><tbody><% recent.forEach(b=>{ %><tr><td><%= b.name %></td><td><%= field(b,'service_label') || t.undecided %></td><td><%= t['status_'+b.status] %></td><td><a href="admin/appointments"><%= t.edit %></a></td></tr><% }); %></tbody></table></div><% } else { %><p><%= t.empty_admin %></p><% } %></section><%- include('partials/admin-footer') %>