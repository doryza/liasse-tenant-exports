<%- include('partials/header') %><section class="spread hero"><div class="hero-copy"><p class="eyebrow" data-setting-key="tagline"><%= settings.tagline %></p><h1 data-setting-key="hero_title"><%= settings.hero_title %></h1><p class="lead" data-setting-key="hero_subtitle"><%= settings.hero_subtitle %></p><div class="actions"><a class="button primary" href="<%= urls.appointments %>" data-lk="t:book"><%= t.book %><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></a><a href="<%= urls.services %>" data-lk="t:rates"><%= t.rates %></a></div></div><figure class="portrait-frame"><img src="<%= settings._p_hero_image_url || settings._p_about_image_url %>" data-setting-key="_p_hero_image_url" alt="<%= t.portrait %>" width="1000" height="1000" fetchpriority="high" decoding="async"><figcaption data-lk="t:caption"><%= t.caption %></figcaption><a class="edge-tab" href="<%= urls.about %>" data-lk="t:approach"><%= t.approach %></a></figure></section><section class="care-index"><div class="section-heading"><h2 data-lk="t:care_title"><%= t.care_title %></h2><p data-lk="t:care_intro"><%= t.care_intro %></p></div><% if(typeof items!=='undefined' && items.length){ %><div class="index-grid"><% items.forEach(item=>{ %><article class="index-entry"><h3 data-content-source="services:<%= column(item,'name') %>" data-content-id="<%= item.id %>"><%= field(item,'name') %></h3><p data-content-source="services:<%= column(item,'description') %>" data-content-id="<%= item.id %>"><%= field(item,'description') %></p><a class="tab-link" href="<%= urls.services %>#<%= item.category %>" data-lk="t:services"><%= t.services %> <span aria-hidden="true">↗</span></a></article><% }); %></div><% } else { %><p class="notice" data-lk="t:catalog_empty"><%= t.catalog_empty %></p><% } %></section><section class="spread"><div><p class="eyebrow" data-lk="t:about"><%= t.about %></p><h2 data-lk="t:approach_title"><%= t.approach_title %></h2><p data-setting-key="about_text"><%= settings.about_text %></p><a href="<%= urls.about %>" data-lk="t:approach"><%= t.approach %> →</a></div><div><h2 data-lk="t:complement"><%= t.complement %></h2><p data-lk="t:complement_text"><%= t.complement_text %></p><div class="actions"><a href="<%= urls.services %>#yoga" data-lk="t:yoga"><%= t.yoga %></a><a href="<%= urls.services %>#meditation" data-lk="t:meditation"><%= t.meditation %></a></div><p data-setting-key="welcome_text"><%= settings.welcome_text %></p></div></section><%- include('partials/practical') %><section class="appointment-invitation"><div><h2 data-lk="t:next"><%= t.next %></h2><p data-lk="t:next_text"><%= t.next_text %></p></div><a class="button primary" href="<%= urls.appointments %>" data-lk="t:request"><%= t.request %> →</a></section><%- include('partials/footer') %>