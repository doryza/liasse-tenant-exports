<%- include('partials/header') %><section class="page-intro"><p class="eyebrow" data-lk="t:services"><%= t.services %></p><h1 data-lk="t:service_title"><%= t.service_title %></h1><nav class="tabs" aria-label="<%= t.services %>"><% ['massage','ayurveda','yoga','meditation'].forEach(c=>{ %><a href="<%= urls.services %>#<%= c %>" data-lk="t:<%= c %>"><%= t[c] %></a><% }); %></nav></section><form class="catalog-search" action="<%= urls.services %>" method="GET"><input type="hidden" name="lang" value="<%= lang %>"><label><span data-lk="t:search"><%= t.search %></span><input name="q" value="<%= q %>" maxlength="100" placeholder="<%= t.search_placeholder %>"></label><label><span data-lk="t:services"><%= t.services %></span><select name="category"><option value=""><%= t.all %></option><% ['massage','ayurveda','yoga','meditation'].forEach(c=>{ %><option value="<%= c %>" <%= category===c?'selected':'' %>><%= t[c] %></option><% }); %></select></label><button class="button primary" data-lk="t:search"><%= t.search %></button><a href="<%= urls.services %>" data-lk="t:clear"><%= t.clear %></a></form><% if(typeof items!=='undefined' && items.length){ %><% ['massage','ayurveda','yoga','meditation'].forEach(c=>{const group=items.filter(x=>x.category===c); %><section id="<%= c %>" class="service-section"><% if(group.length){ %><header><h2 data-lk="t:<%= c %>"><%= t[c] %></h2></header><% group.forEach(item=>{ %><article class="spread service-entry"><div><h3 data-content-source="services:<%= column(item,'name') %>" data-content-id="<%= item.id %>"><%= field(item,'name') %></h3><p class="lead" data-content-source="services:<%= column(item,'description') %>" data-content-id="<%= item.id %>"><%= field(item,'description') %></p><p class="preserve" data-content-source="services:<%= column(item,'details') %>" data-content-id="<%= item.id %>"><%= field(item,'details') %></p><% if(item.image_url){ %><img class="service-photo" src="<%= item.image_url %>" data-content-source="services:image_url" data-content-id="<%= item.id %>" alt="<%= field(item,'name') %>" width="800" height="600" loading="lazy"><% } %></div><div class="service-facts"><dl><div><dt data-lk="t:duration"><%= t.duration %></dt><dd><% if(item.duration_minutes){ %><span data-content-source="services:duration_minutes" data-content-id="<%= item.id %>"><%= item.duration_minutes %></span> <span data-lk="t:minutes"><%= t.minutes %></span><% } else { %><span data-lk="t:confirm"><%= t.confirm %></span><% } %></dd></div><div><dt data-lk="t:format"><%= t.format %></dt><dd><% if(field(item,'format')){ %><span data-content-source="services:<%= column(item,'format') %>" data-content-id="<%= item.id %>"><%= field(item,'format') %></span><% } else { %><span data-lk="t:confirm"><%= t.confirm %></span><% } %></dd></div><div><dt data-lk="t:price"><%= t.price %></dt><dd><% if(item.price_verified && item.price_cents!==null){ %><strong data-content-source="services:price_cents" data-content-id="<%= item.id %>"><%= money(item.price_cents) %></strong><span class="small" data-content-source="services:<%= column(item,'tax_note') %>" data-content-id="<%= item.id %>"><%= field(item,'tax_note') %></span><% } else { %><span data-lk="t:call_rates"><%= t.call_rates %></span><% } %></dd></div></dl><a class="button primary" href="<%= urls.appointments %>?service=<%= item.id %>" data-lk="t:request"><%= t.request %></a></div></article><% }); %><% } else { %><% if(!q && !category){ %><p class="small" data-lk="t:catalog_empty"><%= t.catalog_empty %></p><% } %><% } %></section><% }); %><% } else { %><div class="notice"><p data-lk="t:empty"><%= t.empty %></p><a href="<%= urls.services %>" data-lk="t:clear"><%= t.clear %></a></div><% } %><% if(pages>1){ %><nav class="pagination" aria-label="<%= t.page %>"><% if(current>1){ %><a href="<%= urls.services %>?q=<%= encodeURIComponent(q) %>&category=<%= category %>&page=<%= current-1 %>&lang=<%= lang %>" data-lk="t:previous"><%= t.previous %></a><% } %><span data-lk="t:page"><%= t.page %> <%= current %> / <%= pages %></span><% if(current<pages){ %><a href="<%= urls.services %>?q=<%= encodeURIComponent(q) %>&category=<%= category %>&page=<%= current+1 %>&lang=<%= lang %>" data-lk="t:next_page"><%= t.next_page %></a><% } %></nav><% } %><section class="appointment-invitation"><div><h2 data-lk="t:choose_help"><%= t.choose_help %></h2><p data-lk="t:choose_text"><%= t.choose_text %></p></div><a class="button primary" href="<%= urls.contact %>" data-lk="t:contact"><%= t.contact %> →</a></section><%- include('partials/footer') %>