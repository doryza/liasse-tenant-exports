<%- include('partials/header') %><section class="spread booking-opening"><div><p class="eyebrow" data-lk="t:appointments"><%= t.appointments %></p><h1 data-lk="t:request_intro"><%= t.request_intro %></h1><p class="lead" data-lk="t:request_explain"><%= t.request_explain %></p><% if(flags.contact && settings.contact_phone){ %><a class="button secondary" href="<%= phoneHref %>" data-lk="t:call"><%= t.call %></a><% } else { %><a href="<%= urls.contact %>" data-lk="t:contact"><%= t.contact %></a><% } %><div class="login-invitation"><p data-lk="t:login_reason"><%= t.login_reason %></p><button class="button primary" type="button" data-login-btn data-lk="t:login"><%= t.login %></button></div></div><div><h2 data-lk="t:request"><%= t.request %></h2><% if(flags.requests){ %><form id="appointment-form" action="api/appointments" method="POST" data-auth-only style="display:none"><label><span data-lk="t:name"><%= t.name %></span><input name="name" autocomplete="name" required minlength="2" maxlength="160"></label><label><span data-lk="t:email"><%= t.email %></span><input name="email" type="email" autocomplete="email" required maxlength="254"></label><label><span data-lk="t:phone"><%= t.phone %></span><input name="phone" type="tel" autocomplete="tel" required maxlength="40"></label><label><span data-lk="t:service"><%= t.service %></span><select name="service_id"><option value=""><%= t.undecided %></option><% if(typeof items!=='undefined' && items.length){items.forEach(item=>{ %><option value="<%= item.id %>" data-content-source="services:<%= column(item,'name') %>" data-content-id="<%= item.id %>"><%= field(item,'name') %></option><% });} %></select></label><div class="form-pair"><label><span data-lk="t:preferred_date"><%= t.preferred_date %></span><input type="date" name="preferred_date" min="<%= today %>" required></label><label><span data-lk="t:time_window"><%= t.time_window %></span><select name="time_window"><% ['flexible','morning','afternoon','evening'].forEach(k=>{ %><option value="<%= k %>"><%= t[k] %></option><% }); %></select></label></div><p class="small" data-lk="t:no_health"><%= t.no_health %></p><a href="<%= urls.privacy %>" data-lk="t:privacy"><%= t.privacy %></a><label class="check"><input type="checkbox" name="consent" required><span data-lk="t:consent"><%= t.consent %></span></label><button class="button primary" type="submit" data-lk="t:send"><%= t.send %></button></form><% } else { %><p class="notice" data-lk="t:request_closed"><%= t.request_closed %></p><% } %><p id="request-status" class="status" role="status" aria-live="polite" data-lk="request-status"></p><noscript><p data-lk="t:noscript"><%= t.noscript %></p></noscript></div></section><section class="account-panel" data-auth-only style="display:none"><div class="section-heading"><h2 data-lk="t:my_requests"><%= t.my_requests %></h2><button type="button" class="button secondary" id="refresh-requests" data-lk="t:refresh"><%= t.refresh %></button></div><div id="request-list"><p data-lk="t:loading"><%= t.loading %></p></div><nav id="request-pagination" class="pagination" aria-label="<%= t.page %>"></nav></section><script src="public/js/appointments.js" defer></script><%- include('partials/footer') %>