<%- include('partials/header') %><section class="spread about-opening"><div><p class="eyebrow" data-lk="t:about"><%= t.about %></p><h1 data-lk="t:about_name"><%= t.about_name %></h1><p class="lead" data-lk="t:about_roles"><%= t.about_roles %></p><p data-setting-key="about_text"><%= settings.about_text %></p></div><figure class="portrait-frame"><img src="<%= settings._p_about_image_url || settings._p_hero_image_url %>" data-setting-key="_p_about_image_url" alt="<%= t.portrait %>" width="1000" height="1000" decoding="async"><figcaption data-lk="t:caption"><%= t.caption %></figcaption></figure></section><section class="spread"><div><h2 data-lk="t:origin"><%= t.origin %></h2><p data-setting-key="origin_text"><%= settings.origin_text %></p></div><div><h2 data-lk="t:experience"><%= t.experience %></h2><p data-setting-key="welcome_text"><%= settings.welcome_text %></p><p data-lk="t:complement_text"><%= t.complement_text %></p></div></section><section class="appointment-invitation"><div><h2 data-lk="t:next"><%= t.next %></h2><p data-lk="t:next_text"><%= t.next_text %></p></div><a class="button primary" href="<%= urls.appointments %>" data-lk="t:book"><%= t.book %></a></section><%- include('partials/footer') %>