<%- include('partials/header') %>
<div class="admin-layout"><%- include('partials/admin-sidebar') %><main id="main" class="admin-main" tabindex="-1"><p class="eyebrow"><%= t.demo %></p><span class="badge"><%= t.sharedBadge %></span><h1><%= t.settingsTitle %></h1><p><%= t.settingsHelp %></p><div class="admin-notice"><%= t.databaseNotice %></div><div class="inline-actions"><a href="admin/lab_content"><%= t.pagesModule %></a><a href="."><%= t.viewSite %></a></div><noscript><p class="admin-notice"><%= t.noScript %></p></noscript>
<form id="settings-form" action="api/admin/settings" method="post"><% const keys=typeof publicKeys!=='undefined'&&Array.isArray(publicKeys)?publicKeys:[]; %><% if(keys.length&&typeof translations!=='undefined'&&translations){ %><% keys.forEach(function(key){ %><fieldset class="translation-row"><legend><%= t[key] %></legend><div class="language-fields"><label><span><%= t.frLabel %></span><textarea rows="2" maxlength="2000" name="text_<%= key %>_fr" lang="fr" required><%= translations.fr[key] %></textarea></label><label><span><%= t.enLabel %></span><textarea rows="2" maxlength="2000" name="text_<%= key %>_en" lang="en" required><%= translations.en[key] %></textarea></label></div></fieldset><% }); %><% }else{ %><p><%= t.emptyAdmin %></p><% } %><div class="editor-actions sticky-actions"><button type="submit" class="button primary" style="background-color:var(--admin-brand,#2858ef);color:#fff" id="save-settings"><%= t.save %></button><button type="button" id="reset-settings"><%= t.settingsReset %></button></div><p id="settings-status" class="status" role="status" aria-live="polite"></p><p id="settings-error" role="alert"></p></form><script id="settings-data" type="application/json"><%- JSON.stringify({t,publicKeys:keys}).replace(/</g,'\\u003c') %></script></main></div>
<%- include('partials/footer') %>