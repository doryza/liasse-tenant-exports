<% const md=typeof moduleDef!=='undefined'&&moduleDef?moduleDef:{key:'lab_content',label:t.pagesModule,singular:'content',fields:[]};const tableItems=typeof items!=='undefined'&&Array.isArray(items)?items:[];const tableLang=typeof lang!=='undefined'?lang:'fr'; %>
<div class="module-heading"><div><p class="eyebrow"><%= t.demo %></p><span class="badge"><%= t.sharedBadge %></span><h1><%= md.label %></h1></div><button class="button primary" style="background-color:var(--admin-brand,#2858ef);color:#fff" id="add-item" type="button"><span aria-hidden="true">+</span><%= md.key==='posts'?t.addDraft:t.add %></button></div>
<p class="module-description"><%= md.key==='posts'?t.postsHelp:t.moduleHelp %></p><% if(md.key==='lab_content'){ %><p class="help"><%= t.localOverlayHelp %> <a href="admin/editor"><%= t.localEditor %></a></p><% } %><noscript><p class="admin-notice"><%= t.noScript %></p></noscript><div id="module-message" class="status" role="status" aria-live="polite" aria-atomic="true"></div>
<div class="table-tools <%= md.key==='posts'?'posts-tools':'' %>"><label><span><%= t.filter %></span><input id="table-filter" type="search" placeholder="<%= t.filterPlaceholder %>" autocomplete="off"></label>
<% if(md.key==='lab_content'){ %><label><span><%= t.fieldPage %></span><select id="page-filter"><option value=""><%= t.allPages %></option><option value="home"><%= t.navHome %></option><option value="about"><%= t.navAbout %></option></select></label><% } %>
<label><span><%= t.status %></span><select id="status-filter"><option value=""><%= t.allStatuses %></option><option value="1"><%= md.key==='posts'?t.ready:t.visible %></option><option value="0"><%= md.key==='posts'?t.draft:t.hidden %></option></select></label>
<label><span><%= t.sort %></span><select id="table-sort"><% if(md.key==='lab_content'){ %><option value="ordered"><%= t.ordered %></option><% } %><option value="newest"><%= t.newest %></option><option value="alphabetical"><%= t.alphabetical %></option></select></label></div>
<div class="table-toolbar"><p id="result-count" role="status" aria-live="polite"><%= tableItems.length %> <%= t.results %></p><div class="toolbar-actions"><button type="button" id="clear-filters"><%= t.clearFilters %></button><button type="button" id="refresh-items"><%= t.refresh %></button></div></div>
<div class="table-wrap" id="table-region" aria-busy="false"><table><caption class="sr-only"><%= md.label %></caption><thead><tr><th scope="col"><%= t.name %></th><th scope="col"><%= t.location %></th><th scope="col"><%= t.updated %></th><th scope="col"><%= t.actions %></th></tr></thead><tbody id="module-rows">
<% if(tableItems.length){tableItems.forEach(function(item){const name=(tableLang==='en'?item.title_en:item.title)||item.title||item.content_key||t.note;const d=new Date(item.updated_at); %><tr><td data-label="<%= t.name %>"><span class="row-title"><%= name %></span></td><td data-label="<%= t.location %>"><%= item.page?(item.page==='home'?t.navHome:t.navAbout):t.privateDraft %><span class="row-meta"><%= md.key==='posts'?(Number(item.published)===1?t.ready:t.draft):(Number(item.published)===1?t.visible:t.hidden) %></span></td><td data-label="<%= t.updated %>"><%= item.updated_at&&!Number.isNaN(d.getTime())?d.toLocaleDateString(tableLang==='fr'?'fr-CA':'en-CA'):t.unavailable %></td><td data-label="<%= t.actions %>"><div class="row-actions"><button type="button" data-edit="<%= item.id %>" aria-label="<%= t.edit+' — '+name %>"><%= t.edit %></button><button type="button" class="danger-text" data-delete="<%= item.id %>" aria-label="<%= t.remove+' — '+name %>"><%= t.remove %></button></div></td></tr><% });}else{ %><tr><td class="empty-cell" colspan="4"><%= t.emptyModule %></td></tr><% } %>
</tbody></table></div>
<nav class="pagination" aria-label="<%= md.label %>"><button type="button" id="table-prev"><%= t.previous %></button><span id="table-page" role="status"></span><button type="button" id="table-next"><%= t.next %></button></nav>
<dialog id="item-dialog" aria-labelledby="item-dialog-title" aria-describedby="item-dialog-help"><div class="dialog-heading"><h2 id="item-dialog-title"><%= t.newItem %></h2><button type="button" id="close-item"><%= t.close %></button></div><p id="item-dialog-help" class="dialog-context"><%= md.key==='posts'?t.postsHelp:t.moduleHelp %></p><p class="help"><%= t.requiredHelp %></p><p id="item-dirty" class="dirty-hint" role="status"></p><form id="item-form" action="api/admin/<%= md.key %>" method="post"><div id="item-fields" class="form-grid"></div><p id="item-error" class="status" role="alert" tabindex="-1"></p><div class="dialog-actions"><button type="button" id="cancel-item"><%= t.cancel %></button><button class="button primary" style="background-color:var(--admin-brand,#2858ef);color:#fff" type="submit" id="save-item"><%= t.save %></button></div></form></dialog>
<dialog id="delete-dialog" aria-labelledby="delete-title" aria-describedby="delete-help"><h2 id="delete-title"><%= t.deleteTitle %></h2><p id="delete-item-name"></p><p id="delete-help"><%= t.deleteHelp %></p><p id="delete-error" role="alert"></p><div class="dialog-actions"><button type="button" id="cancel-delete"><%= t.cancel %></button><button type="button" class="button" style="background-color:#a32132;border-color:#a32132;color:#fff" id="confirm-delete"><%= t.remove %></button></div></dialog>
<script id="module-data" type="application/json"><%- JSON.stringify({items:tableItems,module:md,t,lang:tableLang}).replace(/</g,'\\u003c') %></script>