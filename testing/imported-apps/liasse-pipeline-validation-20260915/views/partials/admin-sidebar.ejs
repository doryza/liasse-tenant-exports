<% const sidePath=typeof pagePath!=='undefined'?pagePath:'admin';const sideLinks=[{path:'admin',label:t.dashboard},{path:'admin/lab_content',label:t.pagesModule},{path:'admin/posts',label:t.postsModule},{path:'admin/settings',label:t.settingsTitle},{path:'admin/editor',label:t.localEditor}]; %>
<aside class="admin-sidebar"><button type="button" id="admin-menu-toggle" aria-controls="admin-navigation" aria-expanded="false" style="background-color:#17233b;color:#fff"><%= t.adminMenu %></button><div class="sidebar-inner"><p class="sidebar-caption"><%= t.administration %></p><nav id="admin-navigation" aria-label="<%= t.adminMenu %>"><% sideLinks.forEach(function(link){ %><a href="<%= link.path %>" <% if(sidePath===link.path){ %>aria-current="page" style="background-color:#edf2ff;color:#17233b"<% } %>><%= link.label %></a><% }); %><div class="sidebar-utility"><a href="." target="_blank" rel="noopener"><%= t.viewSite %><span aria-hidden="true"> ↗</span></a><a href="admin/logout"><%= t.logout %></a></div></nav></div></aside>
<script>
(function(){const toggle=document.getElementById('admin-menu-toggle'),nav=document.getElementById('admin-navigation');if(!toggle||!nav)return;function close(focus){toggle.setAttribute('aria-expanded','false');nav.classList.remove('is-open');if(focus)toggle.focus();}toggle.addEventListener('click',function(){const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));nav.classList.toggle('is-open',open);});document.addEventListener('keydown',function(e){if(e.key==='Escape'&&toggle.getAttribute('aria-expanded')==='true')close(true);});const media=window.matchMedia('(min-width:760px)');if(media.addEventListener)media.addEventListener('change',function(){close(false);});})();
</script>