<%- include('partials/header') %>
<div class="admin-layout"><%- include('partials/admin-sidebar') %><main id="main" class="admin-main" tabindex="-1"><p class="eyebrow"><%= t.demo %></p><span class="badge badge-local"><%= t.localBadge %></span><h1><%= t.localEditor %></h1><div class="admin-notice"><strong><%= t.localNotice %></strong><p><%= t.localAccess %></p></div><p><%= t.localHelp %></p><noscript><p class="admin-notice"><%= t.noScript %></p></noscript>
<div class="local-editor"><nav class="editor-groups" aria-label="<%= t.fieldPage %>"><button type="button" data-editor-group="home" aria-pressed="true" style="background-color:var(--admin-brand,#2858ef);color:#fff"><%= t.navHome %></button><button type="button" data-editor-group="about" aria-pressed="false"><%= t.navAbout %></button></nav><div><div id="local-fields"></div><section class="local-preview" aria-labelledby="preview-title"><h2 id="preview-title"><%= t.localPreview %></h2><p class="help"><%= t.previewHelp %></p><div id="local-preview-content"></div></section><div class="editor-actions sticky-actions"><button type="button" class="button primary" style="background-color:var(--admin-brand,#2858ef);color:#fff" id="save-local"><%= t.save %></button><button type="button" id="reset-local"><%= t.resetLocal %></button></div><p id="local-status" class="status" role="status" aria-live="polite"></p><p id="local-error" role="alert"></p><p class="help"><%= t.leaveLocal %></p></div></div>
<div class="inline-actions"><a href="."><%= t.navHome %></a><a href="a-propos"><%= t.navAbout %></a><a href="admin/lab_content"><%= t.sharedContent %></a></div>
<script id="editor-data" type="application/json"><%- JSON.stringify({items:typeof items!=='undefined'?items:[],lang:typeof lang!=='undefined'?lang:'fr',t}).replace(/</g,'\\u003c') %></script><script src="public/js/editor.js" defer></script>
</main></div>
<%- include('partials/footer') %>