<%- include('partials/header') %>
<main id="main">
<section class="hero wrap">
<div class="hero-copy">
<p class="kicker"><span class="chip chip-xs" style="background:#fbbf24"></span><span class="chip chip-xs" style="background:#e23636"></span><span class="chip chip-xs" style="background:#6366f1"></span> <%= t.hero_kicker %></p>
<h1><%= t.hero_title %></h1>
<p class="lead"><%= t.hero_sub %></p>
<div class="cta-row">
<a href="soumission" class="btn btn-primary" style="background-color:#6366f1;color:#fff"><%= t.hero_cta_quote %></a>
<a href="realisations" class="btn btn-ghost"><%= t.hero_cta_gallery %></a>
</div>
<ul class="trust">
<li><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#6366f1" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg><%= t.trust1 %></li>
<li><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#6366f1" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg><%= t.trust2 %></li>
<li><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#6366f1" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg><%= t.trust3 %></li>
</ul>
</div>
<figure class="hero-fig">
<img src="<%= settings._p_hero_image_url || 'https://placehold.co/1200x900/eef0fe/6366f1/png?text=Epoxy' %>" alt="<%= t.hero_badge %>">
<figcaption><span class="chip" style="background:#4549c0"></span><%= t.hero_badge %></figcaption>
</figure>
</section>
<section class="band band-alt">
<div class="wrap">
<div class="sec-head"><h2><%= t.finishes_title %></h2><p><%= t.finishes_sub %></p></div>
<div class="chip-rail">
<% cats.forEach(function(c){ %>
<a class="chip-card" href="realisations?cat=<%= c.key %>"><span class="chip chip-lg" style="background:<%= c.hex %>"></span><span><%= t['cat_'+c.key] %></span><span class="arr">→</span></a>
<% }); %>
</div>
</div>
</section>
<section class="band">
<div class="wrap">
<div class="sec-head row"><div><h2><%= t.featured_title %></h2><p><%= t.featured_sub %></p></div><a href="realisations" class="link-arrow"><%= t.view_all %> →</a></div>
<% if (projects && projects.length) { %>
<div class="grid grid-3">
<% projects.forEach(function(p){ %>
<article class="sample-card">
<a href="realisations?cat=<%= p.category %>" class="card-img"><img src="<%= p.image_url || 'https://placehold.co/800x600/eef0fe/6366f1/png?text=Projet' %>" alt="<%= p.title %>" loading="lazy"></a>
<div class="card-meta"><span class="chip" style="background:<%= p.color_hex||'#6366f1' %>" title="<%= p.color_name||'' %>"></span><div><h3><%= p.title %></h3><p class="meta-line"><%= p.location||'' %><% if (p.surface) { %> • <%= p.surface %><% } %></p></div><span class="tag"><%= t['cat_'+p.category]||p.category %></span></div>
</article>
<% }); %>
</div>
<% } else { %><p class="empty"><%= t.empty_projects %></p><% } %>
</div>
</section>
<section class="band band-alt">
<div class="wrap">
<div class="sec-head row"><div><h2><%= t.services_title %></h2><p><%= t.services_sub %></p></div><a class="link-arrow" href="services"><%= t.nav_services %> →</a></div>
<% if (svcItems && svcItems.length) { %>
<div class="grid grid-3">
<% svcItems.forEach(function(s){ %>
<article class="sample-card">
<a class="card-img" href="services"><img src="<%= s.image_url||'https://placehold.co/800x600/eef0fe/6366f1/png?text=Service' %>" alt="<%= s.name %>" loading="lazy"></a>
<div class="card-meta"><div><h3><%= s.name %></h3><% if (s.price_from) { %><p class="meta-line"><%= t.from_price %> <strong><%= s.price_from %></strong></p><% } %></div></div>
<p class="card-desc"><%= s.description||'' %></p>
<div style="padding:0 1.1rem 1.1rem"><a href="soumission" class="btn btn-primary btn-sm" style="background-color:#6366f1;color:#fff"><%= t.ask_quote %></a></div>
</article>
<% }); %>
</div>
<% } else { %><p class="empty"><%= t.empty_services %></p><% } %>
</div>
</section>
<section class="band">
<div class="wrap">
<div class="sec-head"><h2><%= t.process_title %></h2></div>
<div class="grid grid-4">
<div class="step"><span class="step-num">1</span><h3><%= t.p1t %></h3><p><%= t.p1d %></p></div>
<div class="step"><span class="step-num">2</span><h3><%= t.p2t %></h3><p><%= t.p2d %></p></div>
<div class="step"><span class="step-num">3</span><h3><%= t.p3t %></h3><p><%= t.p3d %></p></div>
<div class="step"><span class="step-num">4</span><h3><%= t.p4t %></h3><p><%= t.p4d %></p></div>
</div>
</div>
</section>
<section class="stats-band">
<div class="wrap stats">
<div class="stat"><strong><%= t.s1n %></strong><span><%= t.s1l %></span></div>
<div class="stat"><strong><%= t.s2n %></strong><span><%= t.s2l %></span></div>
<div class="stat"><strong><%= t.s3n %></strong><span><%= t.s3l %></span></div>
<div class="stat"><strong><%= t.s4n %></strong><span><%= t.s4l %></span></div>
</div>
</section>
<section class="band">
<div class="wrap">
<div class="sec-head"><h2><%= t.testi_title %></h2></div>
<% if (testimonials && testimonials.length) { %>
<div class="grid grid-3">
<% testimonials.forEach(function(x){ %>
<div class="testi-card"><div class="stars"><%= '★★★★★'.slice(0, Math.max(1, Math.min(5, x.rating||5))) %></div><blockquote>« <%= x.content %> »</blockquote><div class="testi-who"><%= x.author %><span><%= x.location||'' %></span></div></div>
<% }); %>
</div>
<% } else { %><p class="empty"><%= t.empty_testi %></p><% } %>
</div>
</section>
<section class="band band-alt">
<div class="wrap about">
<img src="<%= settings._p_about_image_url || 'https://placehold.co/900x600/eef0fe/6366f1/png?text=Equipe' %>" alt="<%= t.about_title %>">
<div><h2><%= t.about_title %></h2><p style="color:var(--mut);margin-top:.8rem"><%= t.about_text %></p>
<div class="cta-row" style="margin-top:1.6rem"><a href="rendez-vous" class="btn btn-ghost"><%= t.cta_book %></a></div></div>
</div>
</section>
<section class="cta-band">
<div class="wrap">
<h2><%= t.cta_title %></h2><p><%= t.cta_sub %></p>
<div class="cta-row"><a href="soumission" class="btn btn-light"><%= t.cta_quote %></a><a href="rendez-vous" class="btn btn-ghost-light"><%= t.cta_book %></a></div>
</div>
</section>
</main>
<%- include('partials/footer') %>
