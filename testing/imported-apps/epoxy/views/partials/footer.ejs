<footer class="site-footer">
<div class="seam"></div>
<div class="wrap foot-grid">
<div>
<div class="brand"><% var fLogo=(settings&&settings._p_nav_logo_url)?settings._p_nav_logo_url:((typeof appIconUrl!=='undefined'&&appIconUrl)?appIconUrl:''); %><% if (fLogo) { %><img src="<%= fLogo %>" alt="Logo" class="brand-logo"><% } %><span class="brand-name"><%= settings.business_name||'Surface Époxy' %></span></div>
<p><%= t.footer_about %></p>
<button data-push-btn class="btn btn-ghost-light btn-sm" style="margin-top:1rem"><%= t.notif_btn %></button>
</div>
<div><h4><%= t.footer_nav %></h4><ul>
<li><a href="."><%= t.nav_home %></a></li>
<li><a href="realisations"><%= t.nav_gallery %></a></li>
<li><a href="services"><%= t.nav_services %></a></li>
<li><a href="rendez-vous"><%= t.nav_booking %></a></li>
<li><a href="soumission"><%= t.nav_quote %></a></li>
</ul></div>
<div><h4><%= t.footer_contact %></h4><ul>
<% if (settings.contact_phone) { %><li><a href="tel:<%= String(settings.contact_phone).replace(/[^0-9+]/g,'') %>"><%= settings.contact_phone %></a></li><% } %>
<% if (settings.contact_email) { %><li><a href="mailto:<%= settings.contact_email %>"><%= settings.contact_email %></a></li><% } %>
<% if (settings.business_address) { %><li><%= settings.business_address %></li><% } %>
<li><a href="soumission"><%= t.cta_quote %> →</a></li>
</ul></div>
<div><h4><%= t.footer_hours %></h4><p><%= settings.business_hours||'' %></p></div>
</div>
<div class="foot-bottom"><div class="wrap">© <%= new Date().getFullYear() %> <%= settings.business_name||'Surface Époxy' %> — <%= t.rights %></div></div>
</footer>
<% if (settings.contact_phone) { %><a class="call-fab" href="tel:<%= String(settings.contact_phone).replace(/[^0-9+]/g,'') %>" aria-label="<%= t.call %>" style="background-color:#e23636"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg></a><% } %>
<script>
(function(){var b=document.getElementById('hamBtn');var n=document.getElementById('mobileNav');if(b&&n){b.addEventListener('click',function(){n.classList.toggle('open');b.classList.toggle('x');});}})();
</script>
<script>
try{if(window.TenantSDK){TenantSDK.ready.then(function(){try{TenantSDK.ui.showInstallBanner();}catch(e){}setTimeout(function(){try{TenantSDK.ui.showPushPrompt({title:<%- JSON.stringify(t.push_title) %>,description:<%- JSON.stringify(t.push_desc) %>});}catch(e){}},8000);}).catch(function(e){});}}catch(e){}
</script>
</body>
</html>
