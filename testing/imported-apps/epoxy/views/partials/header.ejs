<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#6366f1">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="description" content="<%= t.meta_desc %>">
<title><%= (typeof pageTitle!=='undefined'&&pageTitle)?pageTitle+' — ':'' %><%= settings.business_name||'Surface Époxy' %></title>
<meta property="og:type" content="website">
<meta property="og:title" content="<%= settings.business_name||'Surface Époxy' %><%= (typeof pageTitle!=='undefined'&&pageTitle)?(' — '+pageTitle):'' %>">
<meta property="og:description" content="<%= t.meta_desc %>">
<% if (settings._p_hero_image_url) { %><meta property="og:image" content="<%= settings._p_hero_image_url %>"><% } %>
<meta name="twitter:card" content="summary_large_image">
<link rel="manifest" href="manifest.json">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="public/css/styles.css">
</head>
<body>
<div class="seam"></div>
<header class="site-header">
<div class="wrap header-in">
<a href="." class="brand">
<% var logoUrl=(settings&&settings._p_nav_logo_url)?settings._p_nav_logo_url:((typeof appIconUrl!=='undefined'&&appIconUrl)?appIconUrl:''); %>
<% if (logoUrl) { %><img src="<%= logoUrl %>" alt="Logo" class="brand-logo"><% } %>
<span class="brand-name"><%= settings.business_name||'Surface Époxy' %></span>
</a>
<nav class="main-nav">
<a href="." class="<%= (typeof active!=='undefined'&&active==='home')?'on':'' %>"><%= t.nav_home %></a>
<a href="realisations" class="<%= (typeof active!=='undefined'&&active==='gallery')?'on':'' %>"><%= t.nav_gallery %></a>
<a href="services" class="<%= (typeof active!=='undefined'&&active==='services')?'on':'' %>"><%= t.nav_services %></a>
<a href="rendez-vous" class="<%= (typeof active!=='undefined'&&active==='booking')?'on':'' %>"><%= t.nav_booking %></a>
<a href="soumission" class="btn btn-primary btn-sm" style="background-color:#6366f1;color:#fff"><%= t.nav_quote %></a>
<div class="lang-sw"><a href="<%= pagePath %>?lang=fr" class="<%= lang==='fr'?'on':'' %>">FR</a><span>|</span><a href="<%= pagePath %>?lang=en" class="<%= lang==='en'?'on':'' %>">EN</a></div>
</nav>
<% if (settings.contact_phone) { %><a class="btn btn-call header-call" href="tel:<%= String(settings.contact_phone).replace(/[^0-9+]/g,'') %>" style="background-color:#e23636;color:#fff"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg> <%= t.call %></a><% } %>
<button class="ham" id="hamBtn" aria-label="Menu"><span></span><span></span><span></span></button>
</div>
<nav class="mobile-nav" id="mobileNav">
<a href="."><%= t.nav_home %></a>
<a href="realisations"><%= t.nav_gallery %></a>
<a href="services"><%= t.nav_services %></a>
<a href="rendez-vous"><%= t.nav_booking %></a>
<a href="soumission"><%= t.nav_quote %></a>
<% if (settings.contact_phone) { %><a class="btn btn-call" style="background-color:#e23636;color:#fff" href="tel:<%= String(settings.contact_phone).replace(/[^0-9+]/g,'') %>"><%= t.call %> — <%= settings.contact_phone %></a><% } %>
<div class="lang-sw"><a href="<%= pagePath %>?lang=fr" class="<%= lang==='fr'?'on':'' %>">FR</a><span>|</span><a href="<%= pagePath %>?lang=en" class="<%= lang==='en'?'on':'' %>">EN</a></div>
</nav>
</header>
