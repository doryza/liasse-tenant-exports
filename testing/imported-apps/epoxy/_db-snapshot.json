      "sampleRows": [
        {
          "id": 1,
          "title": "Combien de temps dure un plancher d’époxy ?",
          "content": "Un système époxy posé sur un béton bien préparé dure de 15 à 20 ans en résidentiel. La clé : le meulage diamanté, qui ouvre les pores du béton et garantit l’adhérence. C’est pourquoi nous offrons une garantie écrite de 5 ans contre le pelage.",
          "image_url": "https://res.cloudinary.com/duhp69meg/image/upload/v1781203512/tapavis_tenant_epoxy/build_epoxy_1781203512662.png",
          "category": "Conseils",
          "published": 1,
          "created_at": "2026-06-11T19:10:37.039Z",
          "updated_at": "2026-06-11T19:10:37.039Z"
        },
        {
          "id": 2,
          "title": "Flocons ou métallique : quel fini choisir ?",
          "content": "Les flocons offrent une surface texturée, antidérapante et très tolérante aux marques — idéale pour les garages. Le métallique crée un effet marbré spectaculaire, parfait pour les espaces de vie et les commerces. Notre équipe apporte des échantillons des deux lors de l’évaluation.",
          "image_url": "https://res.cloudinary.com/duhp69meg/image/upload/v1781203513/tapavis_tenant_epoxy/build_epoxy_1781203513057.png",
          "category": "Guides",
          "published": 1,
          "created_at": "2026-06-11T19:10:37.054Z",
          "updated_at": "2026-06-11T19:10:37.054Z"
        },
        {
          "id": 3,
          "title": "Préparer son garage avant la pose",
          "content": "Videz le garage, et nous nous occupons du reste : meulage, réparation des fissures et dépoussiérage industriel. Prévoyez 24 h sans marcher sur la surface et 72 h avant d’y stationner un véhicule.",
          "image_url": "https://res.cloudinary.com/duhp69meg/image/upload/v1781203513/tapavis_tenant_epoxy/build_epoxy_1781203513110.png",
          "category": "Conseils",
          "published": 1,
          "created_at": "2026-06-11T19:10:37.069Z",
          "updated_at": "2026-06-11T19:10:37.069Z"
        },
        {
          "id": 4,
          "title": "L’entretien d’un plancher d’époxy en hiver",
          "content": "Le calcium et la gadoue ne pénètrent pas l’époxy : un coup de raclette et c’est sec. Évitez simplement les abrasifs agressifs et rincez à l’eau tiède au printemps pour retrouver le lustre d’origine.",
          "image_url": "https://res.cloudinary.com/duhp69meg/image/upload/v1781203512/tapavis_tenant_epoxy/build_epoxy_1781203512760.png",
          "category": "Conseils",
          "published": 1,
          "created_at": "2026-06-11T19:10:37.082Z",
          "updated_at": "2026-06-11T19:10:37.082Z"
        }
      ]
    },
