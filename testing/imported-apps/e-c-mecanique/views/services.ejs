<%- include('partials/header') %>
<section class="page-head">
  <div class="wrap">
    <div class="crumbs"><a href="<%= urls.home %>"><%= t.home %></a> / <%= t.services %></div>
    <h1><%= lang === 'en' ? 'Everything we fix' : 'Tout ce qu’on répare' %></h1>
    <p><%= lang === 'en' ? 'Eleven services, one garage. Each page explains the work and the signs to watch for; every one of them can be booked online.' : 'Onze services, un garage. Chaque page explique les travaux et les signes à surveiller; chacun se réserve en ligne.' %></p>
  </div>
</section>
<section class="section">
  <div class="wrap">
    <% if (services.some(function (s) { return Number(s.confirmed) === 0; })) { %><p class="tbc-note"><%= t.services_tbc_note %></p><% } %>
    <div class="svc-grid">
      <% services.forEach(function (s) { %>
        <a class="svc<%= Number(s.confirmed) === 0 ? ' is-tbc' : '' %>" href="<%= urls.service %><%= s.slug %>/">
          <div class="svc-img" role="img" aria-label="<%= field(s, 'name') %>" style="background-image:url('<%= serviceImage(s).replace('/upload/', '/upload/w_720,f_auto,q_auto/') %>')"></div>
          <div class="svc-body">
            <h3><%= field(s, 'name') %></h3><% if (Number(s.confirmed) === 0) { %><span class="tbc-tag"><%= t.tbc %></span><% } %>
            <p><%= field(s, 'tagline') %></p>
            <div class="svc-meta">
              <span><%= s.bookable == 1 ? (s.duration_min > 0 ? fmt(t.duration_about, { n: durationLabel(s.duration_min) }) : '') : (s.option_kind === 'courtesy' ? t.option_courtesy : t.option_towing) %></span>
              <b><%= s.bookable == 1 ? priceLabel(s) : '' %></b>
            </div>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
