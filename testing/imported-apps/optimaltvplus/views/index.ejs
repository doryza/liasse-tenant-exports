<!-- Carousel JS -->
<script>
(function() {
  function initCarousel(trackId, prevId, nextId) {
    var track = document.getElementById(trackId);
    var prev = document.getElementById(prevId);
    var next = document.getElementById(nextId);
    if (!track || !prev || !next) return;
    track.style.webkitOverflowScrolling = 'touch';
    var style = document.createElement('style');
    style.textContent = '#' + trackId + '::-webkit-scrollbar{display:none}';
    document.head.appendChild(style);
    var cardWidth = 160 + 14;
    var visibleCount = Math.floor(track.offsetWidth / cardWidth) || 3;
    var scrollAmount = cardWidth * Math.max(1, Math.floor(visibleCount / 2));
    prev.addEventListener('click', function() { track.scrollBy({ left: -scrollAmount, behavior: 'smooth' }); });
    next.addEventListener('click', function() { track.scrollBy({ left: scrollAmount, behavior: 'smooth' }); });
    function updateBtns() {
      prev.style.opacity = track.scrollLeft <= 4 ? '0.4' : '1';
      next.style.opacity = (track.scrollLeft + track.offsetWidth >= track.scrollWidth - 4) ? '0.4' : '1';
    }
    track.addEventListener('scroll', updateBtns, { passive: true });
    updateBtns();
    var isDown = false, startX = 0, scrollLeft = 0;
    track.addEventListener('mousedown', function(e) { isDown = true; track.style.cursor = 'grabbing'; startX = e.pageX - track.offsetLeft; scrollLeft = track.scrollLeft; });
    track.addEventListener('mouseleave', function() { isDown = false; track.style.cursor = ''; });
    track.addEventListener('mouseup', function() { isDown = false; track.style.cursor = ''; });
    track.addEventListener('mousemove', function(e) { if (!isDown) return; e.preventDefault(); var x = e.pageX - track.offsetLeft; track.scrollLeft = scrollLeft - (x - startX); });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      initCarousel('movieTrack', 'moviePrev', 'movieNext');
      initCarousel('seriesTrack', 'seriesPrev', 'seriesNext');
    });
  } else {
    initCarousel('movieTrack', 'moviePrev', 'movieNext');
    initCarousel('seriesTrack', 'seriesPrev', 'seriesNext');
  }
})();
</script>

