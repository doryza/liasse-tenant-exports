<%- include('partials/header') %>
<section class="page-header">
  <div class="container">
    <h1>🔷 Omega IPTV</h1>
    <p><%= lang === 'en' ? 'Premium IPTV subscriptions on the Omega server' : 'Abonnements IPTV premium sur le serveur Omega' %></p>
  </div>
</section>

<section class="section" style="background:var(--bg-2)">
  <div class="container">
    <div class="section-head">
      <h2><%= lang === 'en' ? 'Omega Server Plans' : 'Forfaits Serveur Omega' %></h2>
      <p><%= lang === 'en' ? 'Choose the duration that suits you. All plans include access to 10,000+ channels in 4K on the Omega server.' : 'Choisissez la durée qui vous convient. Tous les forfaits donnent accès à 10 000+ chaînes en 4K sur le serveur Omega.' %></p>
    </div>

    <% if (typeof plans !== 'undefined' && plans.length > 0) { %>
      <div class="plans-grid plans-grid-full">
        <% plans.forEach(function(p){ %>
          <div class="plan-card <%= p.featured ? 'featured' : '' %>">
            <% if (p.badge) { %><div class="plan-badge" style="background-color:#22c55e;color:#fff"><%= p.badge %></div><% } %>
            <h3><%= lang === 'en' && p.name_en ? p.name_en : p.name %></h3>
            <p class="plan-desc"><%= lang === 'en' && p.description_en ? p.description_en : (p.description || '') %></p>
            <div class="plan-price">
              <span class="price-amount"><%= formatPrice(p.price_cents, 'CAD', lang) %></span>
              <span class="price-period"><%= t.valid_for.replace('{n}', p.duration_days) %></span>
            </div>
            <% if (p.features || p.features_en) { %>
              <h4 class="features-title"><%= t.features_label %></h4>
              <ul class="plan-features">
                <% var feats = ((lang === 'en' && p.features_en) ? p.features_en : (p.features || '')).split('\n').filter(function(f){return f.trim()}); %>
                <% feats.forEach(function(f){ %><li>✓ <%= f.trim() %></li><% }); %>
              </ul>
            <% } %>
            <a href="checkout/<%= p.id %>" class="btn-primary plan-cta" style="background-color:#22c55e;color:#fff"><%= t.cta_subscribe %></a>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <!-- Fallback static display when DB plans not yet seeded -->
      <%
        var omegaPricing = [
          { label_fr: '1 Mois', label_en: '1 Month', days: 30, display: lang === 'en' ? '$25.00 CAD' : '25,00 $ CAD', badge: null },
          { label_fr: '3 Mois', label_en: '3 Months', days: 90, display: lang === 'en' ? '$60.00 CAD' : '60,00 $ CAD', badge: null },
          { label_fr: '6 Mois', label_en: '6 Months', days: 180, display: lang === 'en' ? '$100.00 CAD' : '100,00 $ CAD', badge: null },
          { label_fr: '12 Mois', label_en: '12 Months', days: 365, display: lang === 'en' ? '$200.00 CAD' : '200,00 $ CAD', badge: lang === 'en' ? 'BEST VALUE' : 'MEILLEURE OFFRE' }
        ];
      %>
      <div class="plans-grid plans-grid-full">
        <% omegaPricing.forEach(function(p){ %>
          <div class="plan-card">
            <% if (p.badge) { %><div class="plan-badge" style="background-color:#22c55e;color:#fff"><%= p.badge %></div><% } %>
            <h3><%= lang === 'en' ? p.label_en : p.label_fr %></h3>
            <div class="plan-price">
              <span class="price-amount"><%= p.display %></span>
              <span class="price-period"><%= lang === 'en' ? 'for ' + p.days + ' days' : 'pour ' + p.days + ' jours' %></span>
            </div>
            <a href="contact" class="btn-primary plan-cta" style="background-color:#22c55e;color:#fff"><%= lang === 'en' ? 'Contact us' : 'Nous contacter' %></a>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">📡</div>
        <h3><%= lang === 'en' ? '10,000+ Channels' : '10 000+ Chaînes' %></h3>
        <p><%= lang === 'en' ? 'Sport, cinema, entertainment, news and international channels.' : 'Sport, cinéma, divertissement, actualités et chaînes internationales.' %></p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🎬</div>
        <h3>4K Ultra HD</h3>
        <p><%= lang === 'en' ? 'Crystal clear picture on all your compatible devices.' : 'Image cristalline sur tous vos appareils compatibles.' %></p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">⚡</div>
        <h3><%= lang === 'en' ? 'Fast Activation' : 'Activation Rapide' %></h3>
        <p><%= lang === 'en' ? 'Your Omega credentials ready in under 30 minutes after payment.' : 'Vos identifiants Omega prêts en moins de 30 minutes après paiement.' %></p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">💬</div>
        <h3>Support 24/7</h3>
        <p><%= lang === 'en' ? 'Our team is available day and night to assist you.' : 'Notre équipe disponible jour et nuit pour vous assister.' %></p>
      </div>
    </div>
  </div>
</section>

<section class="cta-section">
  <div class="cta-overlay">
    <div class="container text-center">
      <h2><%= lang === 'en' ? 'Ready to subscribe to Omega?' : 'Prêt à vous abonner à Omega?' %></h2>
      <p><%= lang === 'en' ? 'Choose your plan above and enjoy premium IPTV streaming today.' : 'Choisissez votre forfait ci-dessus et profitez du streaming IPTV premium dès aujourd\'hui.' %></p>
      <a href="#" onclick="window.scrollTo({top:0,behavior:'smooth'});return false;" class="btn-primary btn-lg" style="background-color:#fff;color:#16a34a"><%= lang === 'en' ? 'View Plans ↑' : 'Voir les forfaits ↑' %></a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
