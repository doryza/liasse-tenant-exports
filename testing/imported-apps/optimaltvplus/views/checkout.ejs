<%- include('partials/header') %>
<section class="page-header">
  <div class="container">
    <h1><%= t.checkout_heading %></h1>
    <p><%= t.checkout_intro %></p>
  </div>
</section>

<section class="section">
  <div class="container">
    <% if (!user) { %>
      <div class="empty-state-large">
        <div class="empty-icon">🔒</div>
        <h2><%= t.login_required_action %></h2>
        <p><%= lang === 'en' ? 'Sign in to complete your subscription. After login you will return to checkout.' : 'Connectez-vous pour finaliser votre abonnement. Vous reviendrez sur cette page après la connexion.' %></p>
        <a href="#" class="btn-primary btn-lg" data-login-btn style="background-color:#22c55e;color:#fff"><%= t.login_btn %></a>
      </div>
    <% } else { %>
      <div class="checkout-grid">
        <div class="checkout-main">
          <div class="checkout-card">
            <h2><%= t.checkout_payment_method %></h2>
            <div class="payment-option selected">
              <span class="radio-dot"></span>
              <div>
                <strong><%= t.checkout_etransfer %> 🇨🇦</strong>
                <p><%= lang === 'en' ? 'Send the exact amount via Interac e-Transfer. Subscription activates within 30 minutes of payment receipt.' : 'Envoyez le montant exact par virement Interac. L''abonnement s''active dans les 30 minutes suivant la réception.' %></p>
              </div>
            </div>
            <form id="checkoutForm">
              <div class="form-row">
                <label><%= t.form_name %> *</label>
                <input type="text" name="customerName" value="<%= user.display_name || '' %>" required>
              </div>
              <div class="form-row">
                <label><%= t.form_phone %></label>
                <input type="tel" name="customerPhone" value="<%= user.phone || '' %>">
              </div>
              <button type="submit" id="checkoutBtn" class="btn-primary btn-lg btn-block" style="background-color:#22c55e;color:#fff">🔒 <%= t.checkout_confirm %></button>
              <div id="checkoutMsg" class="form-msg"></div>
            </form>
          </div>
        </div>
        <aside class="checkout-sidebar">
          <div class="summary-card">
            <h3><%= t.checkout_order_summary %></h3>
            <% if (plan.image_url) { %><img src="<%= plan.image_url %>" alt="<%= plan.name %>" class="summary-img"><% } %>
            <div class="summary-row">
              <span><%= t.checkout_plan %></span>
              <strong><%= lang === 'en' && plan.name_en ? plan.name_en : plan.name %></strong>
            </div>
            <div class="summary-row">
              <span><%= t.checkout_duration %></span>
              <strong><%= plan.duration_days %> <%= t.days %></strong>
            </div>
            <ul class="summary-features">
              <% var feats = ((lang === 'en' && plan.features_en) ? plan.features_en : (plan.features || '')).split('\n').filter(function(f){return f.trim()}); %>
              <% feats.forEach(function(f){ %><li>✓ <%= f.trim() %></li><% }); %>
            </ul>
            <div class="summary-total">
              <span><%= t.checkout_total %></span>
              <strong><%= formatPrice(plan.price_cents, 'CAD', lang) %></strong>
            </div>
          </div>
        </aside>
      </div>
    <% } %>
  </div>
</section>

<% if (user) { %>
<script>
(function(){
  var form = document.getElementById('checkoutForm');
  var btn = document.getElementById('checkoutBtn');
  var msg = document.getElementById('checkoutMsg');
  var T_PROC = <%- JSON.stringify(t.checkout_processing) %>;
  var T_CONFIRM = <%- JSON.stringify(t.checkout_confirm) %>;
  var T_ERR = <%- JSON.stringify(t.form_error) %>;
  var PLAN_ID = <%- plan.id %>;
  if (!form) return;
  form.addEventListener('submit', async function(e){
    e.preventDefault();
    btn.disabled = true; btn.textContent = T_PROC; msg.textContent = '';
    try {
      var data = { planId: PLAN_ID, customerName: form.customerName.value, customerPhone: form.customerPhone.value };
      var res = await TenantSDK.fetch('api/checkout', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
      var json = await res.json();
      if (res.ok && json.success && json.orderId) {
        window.location.href = 'thank-you/' + json.orderId;
      } else {
        msg.textContent = (json && json.error) || T_ERR; msg.className = 'form-msg form-msg-error';
        btn.disabled = false; btn.textContent = '🔒 ' + T_CONFIRM;
      }
    } catch (err) {
      msg.textContent = T_ERR; msg.className = 'form-msg form-msg-error';
      btn.disabled = false; btn.textContent = '🔒 ' + T_CONFIRM;
    }
  });
})();
</script>
<% } %>

<%- include('partials/footer') %>