<%- include('partials/header') %>
<section class="page-header">
  <div class="container">
    <h1><%= t.account_heading %></h1>
    <% if (user) { %>
      <p><%= t.account_welcome %><% if (user.display_name) { %>, <%= user.display_name %><% } else if (user.email) { %>, <%= user.email %><% } %>!</p>
    <% } %>
  </div>
</section>

<section class="section">
  <div class="container">
    <% if (!user) { %>
      <div class="account-login-prompt">
        <div class="empty-state-large">
          <div class="empty-icon">🔒</div>
          <h2><%= t.login_required_action %></h2>
          <p><%= t.account_login_required %></p>
          <a href="#" class="btn-primary btn-lg" data-login-btn style="background-color:#22c55e;color:#fff"><%= t.login_btn %></a>
        </div>
      </div>
    <% } else { %>
      <div class="account-block">
        <h2><%= t.account_my_sub %></h2>
        <% if (subscription) { %>
          <div class="sub-card">
            <div class="sub-header">
              <div>
                <span class="badge badge-active"><%= statusLabel(subscription.status, t) %></span>
                <h3><%= lang === 'en' && subscription.plan_name_en ? subscription.plan_name_en : (subscription.plan_name || 'Plan') %></h3>
              </div>
              <div class="sub-expiry">
                <span><%= t.expires_on %></span>
                <strong><%= formatDate(subscription.expires_at, lang) %></strong>
              </div>
            </div>

            <%
              var hasMain = !!(subscription.m3u_url || subscription.credentials_username);
              var hasFirstaru = !!(subscription.firstaru_m3u_url || subscription.firstaru_credentials_username);
              var hasOmega = !!(subscription.omega_m3u_url || subscription.omega_credentials_username);
              var hasEdge = !!(subscription.edge_m3u_url || subscription.edge_credentials_username);
              var hasTrex = !!(subscription.trex_m3u_url || subscription.trex_credentials_username);
              var showTabs = hasMain || hasFirstaru || hasOmega || hasEdge || hasTrex;
            %>

            <% if (showTabs) { %>
              <div class="credentials">
                <h4><%= t.account_credentials %></h4>
                <p class="cred-help"><%= t.cred_help %></p>

                <!-- Server tabs -->
                <div class="server-tabs" style="display:flex;gap:0;border-bottom:2px solid rgba(255,255,255,.1);margin-bottom:1.25rem;flex-wrap:wrap">
                  <button type="button"
                    class="server-tab-btn active"
                    data-tab="main"
                    style="padding:.6rem 1.25rem;background:none;border:none;cursor:pointer;font-weight:700;font-size:.95rem;color:#22c55e;border-bottom:2px solid #22c55e;margin-bottom:-2px;transition:all .15s">
                    🖥️ <%= t.cred_server_main %>
                  </button>
                  <button type="button"
                    class="server-tab-btn"
                    data-tab="firstaru"
                    style="padding:.6rem 1.25rem;background:none;border:none;cursor:pointer;font-weight:700;font-size:.95rem;color:rgba(255,255,255,.5);border-bottom:2px solid transparent;margin-bottom:-2px;transition:all .15s">
                    🌐 <%= t.cred_server_firstaru %>
                  </button>
                  <button type="button"
                    class="server-tab-btn"
                    data-tab="omega"
                    style="padding:.6rem 1.25rem;background:none;border:none;cursor:pointer;font-weight:700;font-size:.95rem;color:rgba(255,255,255,.5);border-bottom:2px solid transparent;margin-bottom:-2px;transition:all .15s">
                    🔷 <%= t.cred_server_omega %>
                  </button>
                  <button type="button"
                    class="server-tab-btn"
                    data-tab="edge"
                    style="padding:.6rem 1.25rem;background:none;border:none;cursor:pointer;font-weight:700;font-size:.95rem;color:rgba(255,255,255,.5);border-bottom:2px solid transparent;margin-bottom:-2px;transition:all .15s">
                    ⚡ <%= t.cred_server_edge %>
                  </button>
                  <button type="button"
                    class="server-tab-btn"
                    data-tab="trex"
                    style="padding:.6rem 1.25rem;background:none;border:none;cursor:pointer;font-weight:700;font-size:.95rem;color:rgba(255,255,255,.5);border-bottom:2px solid transparent;margin-bottom:-2px;transition:all .15s">
                    🦕 <%= t.cred_server_trex %>
                  </button>
                </div>

                <!-- Main server panel -->
                <div id="cred-panel-main" class="cred-panel">
                  <% if (hasMain) { %>
                    <% if (subscription.m3u_url) { %>
                      <div class="cred-row">
                        <label><%= t.cred_url %></label>
                        <div class="cred-value">
                          <code><%= subscription.m3u_url %></code>
                          <button type="button" class="btn-copy" data-copy="<%= subscription.m3u_url %>"><%= t.cred_copy %></button>
                        </div>
                      </div>
                    <% } %>
                    <% if (subscription.credentials_username) { %>
                      <div class="cred-row">
                        <label><%= t.cred_user %></label>
                        <div class="cred-value">
                          <code><%= subscription.credentials_username %></code>
                          <button type="button" class="btn-copy" data-copy="<%= subscription.credentials_username %>"><%= t.cred_copy %></button>
                        </div>
                      </div>
                    <% } %>
                    <% if (subscription.credentials_password) { %>
                      <div class="cred-row">
                        <label><%= t.cred_pass %></label>
                        <div class="cred-value">
                          <code><%= subscription.credentials_password %></code>
                          <button type="button" class="btn-copy" data-copy="<%= subscription.credentials_password %>"><%= t.cred_copy %></button>
                        </div>
                      </div>
                    <% } %>
                  <% } else { %>
                    <p class="cred-help" style="color:rgba(255,255,255,.5);font-style:italic">
                      <%= lang === 'en' ? 'Your credentials will be available here shortly. Check back in a few minutes.' : 'Vos identifiants seront disponibles ici sous peu. Revenez dans quelques minutes.' %>
                    </p>
                  <% } %>
                </div>

                <!-- Firstaru server panel -->
                <div id="cred-panel-firstaru" class="cred-panel" style="display:none">
                  <% if (hasFirstaru) { %>
                    <% if (subscription.firstaru_m3u_url) { %>
                      <div class="cred-row">
                        <label><%= t.cred_url %></label>
                        <div class="cred-value">
                          <code><%= subscription.firstaru_m3u_url %></code>
                          <button type="button" class="btn-copy" data-copy="<%= subscription.firstaru_m3u_url %>"><%= t.cred_copy %></button>
                        </div>
                      </div>
                    <% } %>
                    <% if (subscription.firstaru_credentials_username) { %>
                      <div class="cred-row">
                        <label><%= t.cred_user %></label>
                        <div class="cred-value">
                          <code><%= subscription.firstaru_credentials_username %></code>
                          <button type="button" class="btn-copy" data-copy="<%= subscription.firstaru_credentials_username %>"><%= t.cred_copy %></button>
                        </div>
                      </div>
                    <% } %>
                    <% if (subscription.firstaru_credentials_password) { %>
                      <div class="cred-row">
                        <label><%= t.cred_pass %></label>
                        <div class="cred-value">
                          <code><%= subscription.firstaru_credentials_password %></code>
                          <button type="button" class="btn-copy" data-copy="<%= subscription.firstaru_credentials_password %>"><%= t.cred_copy %></button>
                        </div>
                      </div>
                    <% } %>
                  <% } else { %>
                    <p class="cred-help" style="color:rgba(255,255,255,.5);font-style:italic">
                      <%= lang === 'en' ? 'Firstaru server credentials will be available here shortly.' : 'Les identifiants du serveur Firstaru seront disponibles ici sous peu.' %>
                    </p>
                  <% } %>
                </div>

                <!-- Omega server panel -->
                <div id="cred-panel-omega" class="cred-panel" style="display:none">
                  <% if (hasOmega) { %>
                    <% if (subscription.omega_m3u_url) { %>
                      <div class="cred-row">
                        <label><%= t.cred_url %></label>
                        <div class="cred-value">
                          <code><%= subscription.omega_m3u_url %></code>
                          <button type="button" class="btn-copy" data-copy="<%= subscription.omega_m3u_url %>"><%= t.cred_copy %></button>
                        </div>
                      </div>
                    <% } %>
                    <% if (subscription.omega_credentials_username) { %>
                      <div class="cred-row">
                        <label><%= t.cred_user %></label>
                        <div class="cred-value">
                          <code><%= subscription.omega_credentials_username %></code>
                          <button type="button" class="btn-copy" data-copy="<%= subscription.omega_credentials_username %>"><%= t.cred_copy %></button>
                        </div>
                      </div>
                    <% } %>
                    <% if (subscription.omega_credentials_password) { %>
                      <div class="cred-row">
                        <label><%= t.cred_pass %></label>
                        <div class="cred-value">
                          <code><%= subscription.omega_credentials_password %></code>
                          <button type="button" class="btn-copy" data-copy="<%= subscription.omega_credentials_password %>"><%= t.cred_copy %></button>
                        </div>
                      </div>
                    <% } %>
                  <% } else { %>
                    <p class="cred-help" style="color:rgba(255,255,255,.5);font-style:italic">
                      <%= lang === 'en' ? 'Omega server credentials will be available here shortly.' : 'Les identifiants du serveur Omega seront disponibles ici sous peu.' %>
                    </p>
                  <% } %>
                </div>

                <!-- Edge server panel -->
                <div id="cred-panel-edge" class="cred-panel" style="display:none">
                  <% if (hasEdge) { %>
                    <% if (subscription.edge_m3u_url) { %>
                      <div class="cred-row">
                        <label><%= t.cred_url %></label>
                        <div class="cred-value">
                          <code><%= subscription.edge_m3u_url %></code>
                          <button type="button" class="btn-copy" data-copy="<%= subscription.edge_m3u_url %>"><%= t.cred_copy %></button>
                        </div>
                      </div>
                    <% } %>
                    <% if (subscription.edge_credentials_username) { %>
                      <div class="cred-row">
                        <label><%= t.cred_user %></label>
                        <div class="cred-value">
                          <code><%= subscription.edge_credentials_username %></code>
                          <button type="button" class="btn-copy" data-copy="<%= subscription.edge_credentials_username %>"><%= t.cred_copy %></button>
                        </div>
                      </div>
                    <% } %>
                    <% if (subscription.edge_credentials_password) { %>
                      <div class="cred-row">
                        <label><%= t.cred_pass %></label>
                        <div class="cred-value">
                          <code><%= subscription.edge_credentials_password %></code>
                          <button type="button" class="btn-copy" data-copy="<%= subscription.edge_credentials_password %>"><%= t.cred_copy %></button>
                        </div>
                      </div>
                    <% } %>
                  <% } else { %>
                    <p class="cred-help" style="color:rgba(255,255,255,.5);font-style:italic">
                      <%= lang === 'en' ? 'Edge server credentials will be available here shortly.' : 'Les identifiants du serveur Edge seront disponibles ici sous peu.' %>
                    </p>
                  <% } %>
                </div>

                <!-- Trex server panel -->
                <div id="cred-panel-trex" class="cred-panel" style="display:none">
                  <% if (hasTrex) { %>
                    <% if (subscription.trex_m3u_url) { %>
                      <div class="cred-row">
                        <label><%= t.cred_url %></label>
                        <div class="cred-value">
                          <code><%= subscription.trex_m3u_url %></code>
                          <button type="button" class="btn-copy" data-copy="<%= subscription.trex_m3u_url %>"><%= t.cred_copy %></button>
                        </div>
                      </div>
                    <% } %>
                    <% if (subscription.trex_credentials_username) { %>
                      <div class="cred-row">
                        <label><%= t.cred_user %></label>
                        <div class="cred-value">
                          <code><%= subscription.trex_credentials_username %></code>
                          <button type="button" class="btn-copy" data-copy="<%= subscription.trex_credentials_username %>"><%= t.cred_copy %></button>
                        </div>
                      </div>
                    <% } %>
                    <% if (subscription.trex_credentials_password) { %>
                      <div class="cred-row">
                        <label><%= t.cred_pass %></label>
                        <div class="cred-value">
                          <code><%= subscription.trex_credentials_password %></code>
                          <button type="button" class="btn-copy" data-copy="<%= subscription.trex_credentials_password %>"><%= t.cred_copy %></button>
                        </div>
                      </div>
                    <% } %>
                  <% } else { %>
                    <p class="cred-help" style="color:rgba(255,255,255,.5);font-style:italic">
                      <%= lang === 'en' ? 'Trex server credentials will be available here shortly.' : 'Les identifiants du serveur Trex seront disponibles ici sous peu.' %>
                    </p>
                  <% } %>
                </div>

              </div>
            <% } else { %>
              <p class="cred-help"><%= lang === 'en' ? 'Your credentials will be available here shortly. Check back in a few minutes.' : 'Vos identifiants seront disponibles ici sous peu. Revenez dans quelques minutes.' %></p>
            <% } %>
          </div>
        <% } else { %>
          <div class="empty-state">
            <p><%= t.account_no_sub %></p>
            <a href="plans" class="btn-primary" style="background-color:#22c55e;color:#fff"><%= t.account_browse_plans %></a>
          </div>
        <% } %>
      </div>

      <div class="account-block">
        <h2><%= t.account_my_orders %></h2>
        <% if (orders && orders.length > 0) { %>
          <div class="orders-list">
            <% orders.forEach(function(o){ %>
              <div class="order-row">
                <div>
                  <strong>#<%= o.id %></strong>
                  <span class="order-plan"><%= lang === 'en' && o.plan_name_en ? o.plan_name_en : (o.plan_name || '-') %></span>
                </div>
                <div class="order-amount"><%= formatPrice(o.amount_cents, o.currency, lang) %></div>
                <div class="order-date"><%= formatDate(o.created_at, lang) %></div>
                <div><span class="badge badge-<%= o.status %>"><%= statusLabel(o.status, t) %></span></div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <p class="empty-text"><%= t.empty_no_orders %></p>
        <% } %>
      </div>

      <div class="account-block">
        <h2><%= t.enable_notifs %></h2>
        <p><%= t.enable_notifs_desc %></p>
        <button data-push-btn class="btn-primary" style="background-color:#22c55e;color:#fff">🔔 <%= t.enable_notifs %></button>
      </div>
    <% } %>
  </div>
</section>

<script>
(function(){
  var COPIED = <%- JSON.stringify(t.cred_copied) %>;
  var COPY = <%- JSON.stringify(t.cred_copy) %>;

  // Copy-to-clipboard
  document.querySelectorAll('[data-copy]').forEach(function(btn){
    btn.addEventListener('click', function(){
      var v = btn.getAttribute('data-copy');
      try { navigator.clipboard.writeText(v); } catch(e) {}
      var orig = btn.textContent;
      btn.textContent = COPIED;
      setTimeout(function(){ btn.textContent = COPY; }, 1500);
    });
  });

  // Server tabs
  var tabBtns = document.querySelectorAll('.server-tab-btn');
  var panels = document.querySelectorAll('.cred-panel');
  if (tabBtns.length > 0) {
    tabBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var target = btn.getAttribute('data-tab');
        // Update button styles
        tabBtns.forEach(function(b) {
          if (b.getAttribute('data-tab') === target) {
            b.classList.add('active');
            b.style.color = '#22c55e';
            b.style.borderBottomColor = '#22c55e';
          } else {
            b.classList.remove('active');
            b.style.color = 'rgba(255,255,255,.5)';
            b.style.borderBottomColor = 'transparent';
          }
        });
        // Show/hide panels
        panels.forEach(function(p) {
          if (p.id === 'cred-panel-' + target) {
            p.style.display = '';
          } else {
            p.style.display = 'none';
          }
        });
      });
    });
  }
})();
</script>

<%- include('partials/footer') %>
