<%- include('partials/header') %>
<div class="container page-head">
<h1><%= t.services_title %></h1>
<p><%= t.services_subtitle %></p>
</div>
<section style="padding-top:1rem">
<div class="container">
<% if (typeof rates !== 'undefined' && rates.length > 0) { %>
<div class="grid grid-3">
<% rates.forEach(function(r, i){ %>
<div class="service-card <%= i===0 ? 'featured' : '' %>">
<h3><%= lang === 'en' ? (r.display_name_en || r.service_level) : (r.display_name_fr || r.service_level) %></h3>
<div class="price-base"><%= formatPrice(r.base_price) %><span> + <%= formatPrice(r.price_per_km) %>/km</span></div>
<p class="muted"><%= lang === 'en' ? (r.description_en || '') : (r.description_fr || '') %></p>
<ul class="features">
<li><span><%= t.services_cutoff %></span><strong><%= r.cutoff_time || '—' %></strong></li>
<li><span><%= t.services_base %></span><strong><%= formatPrice(r.base_price) %></strong></li>
<li><span><%= t.services_per_km %></span><strong><%= formatPrice(r.price_per_km) %></strong></li>
</ul>
<a href="inscription" class="btn btn-outline" style="width:100%;text-align:center;display:block"><%= t.hero_cta_signup %></a>
</div>
<% }); %>
</div>
<p class="muted text-center mt-4"><%= t.services_note %></p>
<% } else { %>
<div class="empty-state"><h3><%= t.coming_soon %></h3><p>—</p></div>
<% } %>
</div>
</section>
<section class="section-alt">
<div class="container">
<div class="section-head">
<h2><%= lang === 'en' ? 'Pricing example' : 'Exemple de tarification' %></h2>
<p><%= lang === 'en' ? 'A typical 10 km delivery, by service level' : 'Une livraison typique de 10 km, par niveau de service' %></p>
</div>
<div class="grid grid-3">
<% if (typeof rates !== 'undefined' && rates.length > 0) { rates.forEach(function(r){ var ex = parseFloat(r.base_price) + parseFloat(r.price_per_km) * 10; %>
<div class="card"><div class="card-body text-center"><h3><%= lang === 'en' ? r.display_name_en : r.display_name_fr %></h3><div style="font-size:2rem;font-weight:800;color:#dc2626;margin:1rem 0"><%= formatPrice(ex) %></div><p class="muted">10 km · <%= formatPrice(r.base_price) %> + 10×<%= formatPrice(r.price_per_km) %></p></div></div>
<% }); } %>
</div>
</div>
</section>
<%- include('partials/footer') %>
