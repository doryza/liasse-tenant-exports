<%- include('partials/header') %>
<div class="container page-head">
<h1><%= t.contact_title %></h1>
<p><%= t.contact_subtitle %></p>
</div>
<section style="padding-top:1rem">
<div class="container">
<div class="grid grid-2">
<div>
<div class="form-card">
<% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success"><%= t.contact_success %></div><% } %>
<div id="contactStatus"></div>
<form id="contactForm">
<div class="form-row">
<div><label><%= t.contact_name %> *</label><input type="text" name="name" required></div>
<div><label><%= t.contact_email %></label><input type="email" name="email"></div>
</div>
<div class="form-row">
<div><label><%= t.contact_phone %></label><input type="tel" name="phone"></div>
<div><label><%= t.contact_subject %></label><input type="text" name="subject"></div>
</div>
<div><label><%= t.contact_message %> *</label><textarea name="message" required></textarea></div>
<button type="submit" class="btn" style="background-color:#dc2626;color:#fff"><%= t.contact_send %></button>
</form>
</div>
</div>
<div>
<h3><%= lang === 'en' ? 'Get in touch' : 'Contactez-nous directement' %></h3>
<% if (typeof settings !== 'undefined' && settings.contact_email) { %><p>📧 <a href="mailto:<%= settings.contact_email %>"><%= settings.contact_email %></a></p><% } %>
<% if (typeof settings !== 'undefined' && settings.contact_phone) { %><p>📞 <a href="tel:<%= settings.contact_phone %>"><%= settings.contact_phone %></a></p><% } %>
<% if (typeof settings !== 'undefined' && settings.business_address) { %><p>📍 <%= settings.business_address %></p><% } %>
<p class="muted"><%= lang === 'en' ? 'We respond to business inquiries within 24 hours.' : 'Nous répondons aux demandes d\'affaires sous 24 heures.' %></p>
</div>
</div>
</div>
</section>
<script>
document.getElementById('contactForm').addEventListener('submit', async function(e){
  e.preventDefault();
  var status = document.getElementById('contactStatus');
  var btn = this.querySelector('button[type=submit]');
  btn.disabled = true;
  var data = {};
  new FormData(this).forEach(function(v,k){ data[k] = v; });
  try {
    var r = await fetch('api/contact', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(data) });
    var j = await r.json();
    if (j.success) {
      status.innerHTML = '<div class="alert alert-success"><%- t.contact_success %></div>';
      e.target.reset();
    } else {
      status.innerHTML = '<div class="alert alert-danger">' + (j.error || 'Error') + '</div>';
    }
  } catch(err) {
    status.innerHTML = '<div class="alert alert-danger">Connection error</div>';
  }
  btn.disabled = false;
});
</script>
<%- include('partials/footer') %>
