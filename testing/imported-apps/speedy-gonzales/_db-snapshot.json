      "sampleRows": [
        {
          "id": 1,
          "title": "Bienvenue chez Speedy Gonzales",
          "content": "Nous sommes ravis de lancer notre nouveau service de courrier dédié aux entreprises du Grand Montréal. Inscrivez votre entreprise dès aujourd'hui et profitez de nos tarifs préférentiels sur toutes vos livraisons.",
          "image_url": null,
          "category": "Annonces",
          "published": 1,
          "created_at": "2026-05-17T04:37:06.846Z",
          "updated_at": "2026-05-17T04:37:06.846Z"
        },
        {
          "id": 2,
          "title": "Nouveau service Express disponible",
          "content": "À partir de ce mois-ci, nous offrons un service Express avec livraison garantie en moins de 2 heures partout sur l'île de Montréal. Réservez vos livraisons urgentes avant 14h pour une livraison le jour même.",
          "image_url": null,
          "category": "Services",
          "published": 1,
          "created_at": "2026-05-17T04:37:06.853Z",
          "updated_at": "2026-05-17T04:37:06.853Z"
        },
        {
          "id": 3,
          "title": "Couverture étendue à Laval et la Rive-Nord",
          "content": "Speedy Gonzales étend ses services à Laval, Boisbriand, Sainte-Thérèse et Blainville. Tous nos niveaux de service (Express, Jour même, Jour suivant) sont disponibles sans frais supplémentaires.",
          "image_url": null,
          "category": "Nouvelles",
          "published": 1,
          "created_at": "2026-05-17T04:37:06.861Z",
          "updated_at": "2026-05-17T04:37:06.861Z"
        },
        {
          "id": 4,
          "title": "Conseils pour optimiser vos livraisons",
          "content": "Saviez-vous que regrouper plusieurs livraisons à partir du même point de ramassage peut vous faire économiser jusqu'à 30%? Découvrez nos astuces pour réduire vos coûts de courrier.",
          "image_url": null,
          "category": "Conseils",
          "published": 1,
          "created_at": "2026-05-17T04:37:06.870Z",
          "updated_at": "2026-05-17T04:37:06.870Z"
