<%- include('partials/header', { pageTitle: (lang === 'en' ? 'Menu' : 'Menu'), activeNav: 'menu' }) %>
<%
  var cats = (categories || []).filter(function(c){ return (menu || []).some(function(m){ return m.category === c.slug; }); });
  function catLabel(c){ return (lang === 'en' && c.name_en) ? c.name_en : c.name_fr; }
  function catSub(c){ return (lang === 'en' ? c.subtitle_en : c.subtitle_fr) || (lang === 'en' ? c.subtitle_fr : c.subtitle_en) || ''; }
%>

<section class="subpage-hero">
  <div class="container">
    <span class="eyebrow center" style="justify-content:center"><%= settings.business_name || t.brand %></span>
    <h1><%= sx('menu_title') %></h1>
    <p class="lead"><%= sx('menu_intro') %></p>
  </div>
</section>

<% if (cats.length) { %>
<nav class="menu-nav" aria-label="<%= lang === 'en' ? 'Menu sections' : 'Sections du menu' %>">
  <div class="container">
    <div class="menu-nav__inner">
      <% cats.forEach(function(c){ %><a href="#<%= c.slug %>" data-cat="<%= c.slug %>"><%= catLabel(c) %></a><% }); %>
    </div>
  </div>
</nav>
<% } %>

<div class="container">
  <% if (!menu || !menu.length) { %>
    <div class="page-empty"><p><%= lang === 'en' ? 'The menu will be available soon.' : 'Le menu sera bientôt disponible.' %></p></div>
  <% } %>
  <% cats.forEach(function(c){ var rows = (menu || []).filter(function(m){ return m.category === c.slug; }); %>
  <section class="menu-section" id="<%= c.slug %>" aria-labelledby="cat-<%= c.slug %>">
    <div class="menu-section__head">
      <h2 id="cat-<%= c.slug %>"><%= catLabel(c) %></h2>
      <% if (catSub(c)) { %><div class="sub"><%= catSub(c) %></div><% } %>
    </div>
    <div class="menu-items">
      <% rows.forEach(function(m){ var _desc = pickLang(m,'description',lang); %>
      <div class="m-item <%= m.image_url ? 'has-img' : '' %> <%= m.available ? '' : 'unavailable' %>">
        <% if (m.image_url) { %><img class="m-item__thumb" src="<%= cimg(m.image_url, 'f_auto,q_auto,w_180,h_180,c_fill,g_auto') %>" alt="<%= pickLang(m,'name',lang) %>" loading="lazy"><% } %>
        <div class="m-item__body">
          <div class="m-item__top">
            <span class="m-item__name"><%= pickLang(m,'name',lang) %><% if (m.is_signature) { %><span class="star" role="img" aria-label="<%= lang === 'en' ? 'House specialty' : 'Spécialité de la maison' %>">★</span><% } %></span>
            <span class="m-item__dots"></span>
            <span class="m-item__price"><%= itemPriceLabel(m) %></span>
          </div>
          <% if (_desc) { %><p class="m-item__desc"><%= _desc %></p><% } %>
        </div>
      </div>
      <% }); %>
    </div>
  </section>
  <% }); %>

  <div class="text-center" style="padding:3rem 0 4rem">
    <a class="btn btn-reserve btn-lg" href=".#reservation"><%= t.reserve %></a>
  </div>
</div>

<script>
(function(){
  // Highlight the active section in the sticky menu nav.
  var links = Array.prototype.slice.call(document.querySelectorAll('.menu-nav a'));
  var sections = links.map(function(a){ return document.getElementById(a.getAttribute('data-cat')); }).filter(Boolean);
  if (!('IntersectionObserver' in window) || !sections.length) return;
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(en){
      if (en.isIntersecting){
        links.forEach(function(a){ var on = a.getAttribute('data-cat') === en.target.id; a.classList.toggle('active', on); if (on) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current'); });
      }
    });
  }, { rootMargin: '-45% 0px -50% 0px' });
  sections.forEach(function(s){ io.observe(s); });
})();
</script>

<%- include('partials/footer') %>
