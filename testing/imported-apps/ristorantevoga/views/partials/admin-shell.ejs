<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Admin — <%= title %></title>
<link rel="stylesheet" href="public/css/admin-styles.css">
</head>
<body>
<div class="admin-layout">
<%- include('admin-sidebar', { page: page }) %>
<main class="admin-main">
<div class="admin-header">
  <div>
    <h1><%= title %></h1>
    <p style="margin:.25rem 0 0;color:#8a7e6e;font-size:.9rem" id="countLabel"></p>
  </div>
  <button class="btn btn-primary" onclick="openModal()">+ Ajouter</button>
</div>
<% if (typeof intro !== 'undefined' && intro) { %><div class="card" style="background:#fbf7ef"><p style="margin:0;color:#6a5f50;font-size:.92rem"><%= intro %></p></div><% } %>
<div class="toolbar">
  <input type="text" id="searchInput" placeholder="🔍 Rechercher…" oninput="renderList()">
</div>
<div class="card">
  <div id="listContainer"><p class="empty"><span class="emoji">⏳</span>Chargement…</p></div>
</div>
</main>
</div>
<div class="modal-overlay" id="modal" onclick="if(event.target===this)closeModal()">
  <div class="modal">
    <h2 id="modalTitle">Ajouter</h2>
    <form id="itemForm">
      <div id="formFields"></div>
      <div class="form-actions">
        <button type="button" class="btn btn-secondary" onclick="closeModal()">Annuler</button>
        <button type="submit" class="btn btn-primary" id="saveBtn">Enregistrer</button>
      </div>
    </form>
  </div>
</div>
<div class="toast" id="toast"></div>
<script>
var MODULE_KEY = '<%- moduleKey %>';
var items = [];
var fields = [];
var editingId = null;
var dynamicSources = {};

function esc(s){ if (s == null) return ''; return String(s).replace(/[&<>"']/g, function(c){ return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]; }); }
function labelFor(f){ return f.label || f.name; }
function toast(msg, type){ var t = document.getElementById('toast'); t.className = 'toast toast-' + (type || 'success'); t.textContent = msg; setTimeout(function(){ t.classList.add('show'); }, 10); setTimeout(function(){ t.classList.remove('show'); }, 2800); }

async function loadModule(){
  try {
    var r = await fetch('api/admin/modules'); var data = await r.json();
    var m = (data.modules || []).find(function(x){ return x.key === MODULE_KEY; });
    if (m) fields = m.fields;
    var sources = [];
    fields.forEach(function(f){ if (f.type === 'select_dynamic' && f.source && sources.indexOf(f.source) === -1) sources.push(f.source); });
    await Promise.all(sources.map(async function(src){ try { var rr = await fetch('api/admin/' + src); var dd = await rr.json(); dynamicSources[src] = dd[src] || []; } catch(e){ dynamicSources[src] = []; } }));
    await loadItems();
  } catch(e){ document.getElementById('listContainer').innerHTML = '<p class="empty"><span class="emoji">⚠️</span>Erreur de chargement</p>'; }
}
async function loadItems(){
  try { var r = await fetch('api/admin/' + MODULE_KEY); var data = await r.json(); items = data[MODULE_KEY] || []; renderList(); }
  catch(e){ document.getElementById('listContainer').innerHTML = '<p class="empty"><span class="emoji">⚠️</span>Erreur de chargement</p>'; }
}
function matchesSearch(it, q){ if (!q) return true; q = q.toLowerCase(); for (var k in it){ var v = it[k]; if (v != null && String(v).toLowerCase().indexOf(q) !== -1) return true; } return false; }

function renderList(){
  var c = document.getElementById('listContainer');
  var countLabel = document.getElementById('countLabel');
  var q = (document.getElementById('searchInput') || {}).value || '';
  var filtered = items.filter(function(it){ return matchesSearch(it, q); });
  countLabel.textContent = filtered.length + ' / ' + items.length + ' élément' + (items.length > 1 ? 's' : '');
  if (!items.length){ c.innerHTML = '<p class="empty"><span class="emoji">📭</span>Aucun élément pour l\'instant.<br><span style="font-size:.85rem;color:#b9ac9a">Cliquez sur <strong>+ Ajouter</strong> pour commencer.</span></p>'; return; }
  if (!filtered.length){ c.innerHTML = '<p class="empty"><span class="emoji">🔍</span>Aucun résultat.</p>'; return; }

  var displayFields = fields.filter(function(f){ return f.type !== 'textarea'; }).slice(0, 5);
  if (MODULE_KEY === 'menu_items') displayFields = fields.filter(function(f){ return ['image_url','name_fr','price','is_signature','available'].indexOf(f.name) !== -1; });
  else if (MODULE_KEY === 'wine_items') displayFields = fields.filter(function(f){ return ['name_fr','category','price_glass','price_bottle','available'].indexOf(f.name) !== -1; });
  else if (MODULE_KEY === 'tasting_courses') displayFields = fields.filter(function(f){ return ['position','title_fr','active'].indexOf(f.name) !== -1; });
  else if (MODULE_KEY === 'gallery_images') displayFields = fields.filter(function(f){ return ['image_url','alt_fr','category','active'].indexOf(f.name) !== -1; });
  else if (MODULE_KEY === 'reviews') displayFields = fields.filter(function(f){ return ['author','rating','source','active'].indexOf(f.name) !== -1; });
  else if (MODULE_KEY === 'promotions') displayFields = fields.filter(function(f){ return ['image_url','title_fr','badge_fr','active'].indexOf(f.name) !== -1; });

  if (MODULE_KEY === 'menu_items'){ renderMenuItemsGrouped(c, filtered, displayFields); return; }

  var html = '<div style="overflow-x:auto"><table><thead><tr>';
  displayFields.forEach(function(f){ html += '<th>' + esc(labelFor(f)) + '</th>'; });
  html += '<th style="text-align:right">Actions</th></tr></thead><tbody>';
  filtered.forEach(function(it){
    html += '<tr>';
    displayFields.forEach(function(f){ html += '<td>' + cellValue(it, f) + '</td>'; });
    html += '<td class="row-actions" style="text-align:right">';
    html += '<button class="btn btn-sm btn-secondary" onclick="editItem(' + it.id + ')" title="Modifier">✏️</button>';
    html += '<button class="btn btn-sm btn-danger" onclick="deleteItem(' + it.id + ')" title="Supprimer">🗑️</button>';
    html += '</td></tr>';
  });
  html += '</tbody></table></div>';
  c.innerHTML = html;
}

function cellValue(it, f){
  var v = it[f.name];
  if (f.type === 'image' && v) return '<img src="' + esc(v) + '" alt="">';
  if (f.type === 'image') return '<div style="width:48px;height:48px;background:#eee3d3;border-radius:6px;display:flex;align-items:center;justify-content:center;color:#b9ac9a">—</div>';
  if (f.type === 'boolean') return (v && v != '0' ? '<span class="badge badge-success">✓</span>' : '<span class="badge badge-muted">—</span>');
  if (f.type === 'datetime' && v) return esc(String(v).replace('T',' ').substring(0,16));
  if ((f.name === 'price' || f.name === 'price_glass' || f.name === 'price_bottle') && v != null) return '<strong>' + esc(Number(v).toFixed(2)) + ' $</strong>';
  if (f.name === 'rating' && v != null){ var n = Math.max(0, Math.min(5, Number(v))); return '<span style="color:#c4a24c">' + '★'.repeat(n) + '<span style="color:#d8cdba">' + '★'.repeat(5-n) + '</span></span>'; }
  if (f.type === 'select_dynamic' && f.source){ var rows = dynamicSources[f.source] || []; var match = rows.find(function(r){ return String(r[f.valueField||'slug']) === String(v); }); var lbl = match ? (match[f.labelField||'name_fr'] || match[f.valueField||'slug']) : v; return esc(lbl == null || lbl === '' ? '—' : String(lbl)); }
  if (v != null && String(v).length > 60) return esc(String(v).substring(0,60)) + '…';
  return esc(v == null || v === '' ? '—' : String(v));
}

function renderMenuItemsGrouped(c, filtered, displayFields){
  var dynRows = dynamicSources['menu_categories'] || [];
  var orderedCats = dynRows.map(function(r){ return r.slug; });
  var groups = {};
  filtered.forEach(function(it){ var cat = it.category || ''; (groups[cat] = groups[cat] || []).push(it); });
  var presentCats = orderedCats.filter(function(s){ return groups[s] && groups[s].length; });
  Object.keys(groups).forEach(function(s){ if (presentCats.indexOf(s) === -1) presentCats.push(s); });

  var html = '<div style="overflow-x:auto"><table id="menuItemsTable">';
  html += '<thead><tr><th style="width:30px"></th>';
  displayFields.forEach(function(f){ html += '<th>' + esc(labelFor(f)) + '</th>'; });
  html += '<th style="text-align:right">Actions</th></tr></thead>';
  presentCats.forEach(function(slug){
    var catRow = dynRows.find(function(r){ return r.slug === slug; });
    var catLabel = catRow ? (catRow.name_fr || slug) : (slug || 'Sans catégorie');
    html += '<tbody data-menu-cat="' + esc(slug) + '">';
    html += '<tr class="menu-cat-header"><td colspan="' + (displayFields.length + 2) + '" style="background:#f5f2ec;padding:.6rem .85rem;font-weight:800;color:#3a342d;font-size:.82rem;text-transform:uppercase;letter-spacing:.06em;border-top:1px solid #e7e0d4">' + esc(catLabel) + '</td></tr>';
    groups[slug].forEach(function(it){
      html += '<tr class="menu-row" draggable="true" data-id="' + it.id + '" data-menu-cat="' + esc(slug) + '" ondragstart="menuDragStart(event)" ondragover="menuDragOver(event)" ondragleave="menuDragLeave(event)" ondrop="menuDrop(event)" ondragend="menuDragEnd(event)">';
      html += '<td class="drag-handle" style="cursor:grab;color:#b9ac9a;font-size:1.1rem;user-select:none;text-align:center" title="Glisser pour réordonner">⋮⋮</td>';
      displayFields.forEach(function(f){ html += '<td>' + cellValue(it, f) + '</td>'; });
      html += '<td class="row-actions" style="text-align:right">';
      html += '<button class="btn btn-sm btn-secondary" onclick="editItem(' + it.id + ')" title="Modifier">✏️</button>';
      html += '<button class="btn btn-sm btn-danger" onclick="deleteItem(' + it.id + ')" title="Supprimer">🗑️</button>';
      html += '</td></tr>';
    });
    html += '</tbody>';
  });
  html += '</table></div>';
  html += '<p style="margin:.8rem 0 0;color:#8a7e6e;font-size:.82rem">💡 Glissez les plats dans une section pour les réordonner.</p>';
  c.innerHTML = html;
}

var _menuDragSrc = null;
function menuDragStart(e){ var row = e.target.closest && e.target.closest('tr.menu-row'); if (!row) return; _menuDragSrc = row; if (e.dataTransfer){ e.dataTransfer.effectAllowed = 'move'; try { e.dataTransfer.setData('text/plain', row.getAttribute('data-id')); } catch(_){} } row.style.opacity = '0.45'; }
function menuDragOver(e){ var row = e.target.closest && e.target.closest('tr.menu-row'); if (!row || !_menuDragSrc || row === _menuDragSrc) return; if (row.getAttribute('data-menu-cat') !== _menuDragSrc.getAttribute('data-menu-cat')) return; e.preventDefault(); if (e.dataTransfer) e.dataTransfer.dropEffect = 'move'; var rect = row.getBoundingClientRect(); var pos = e.clientY < (rect.top + rect.height/2) ? 'before' : 'after'; row.dataset.dropPos = pos; row.style.borderTop = pos === 'before' ? '3px solid #6e1b2a' : ''; row.style.borderBottom = pos === 'after' ? '3px solid #6e1b2a' : ''; }
function menuDragLeave(e){ var row = e.target.closest && e.target.closest('tr.menu-row'); if (row){ row.style.borderTop = ''; row.style.borderBottom = ''; } }
function menuDrop(e){ e.preventDefault(); var row = e.target.closest && e.target.closest('tr.menu-row'); if (!row || !_menuDragSrc || row === _menuDragSrc){ menuDragEnd(); return; } if (row.getAttribute('data-menu-cat') !== _menuDragSrc.getAttribute('data-menu-cat')){ menuDragEnd(); return; } var parent = row.parentNode; var pos = row.dataset.dropPos || 'before'; if (pos === 'before') parent.insertBefore(_menuDragSrc, row); else parent.insertBefore(_menuDragSrc, row.nextSibling); var cat = _menuDragSrc.getAttribute('data-menu-cat'); var ids = []; parent.querySelectorAll('tr.menu-row').forEach(function(r){ ids.push(parseInt(r.getAttribute('data-id'),10)); }); fetch('api/admin/menu_items/reorder', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ category: cat || null, ordered_ids: ids }) }).then(function(r){ return r.ok ? r.json() : null; }).then(function(d){ if (d && d.success) toast('Ordre mis à jour'); else toast('Erreur', 'error'); }).catch(function(){ toast('Erreur réseau', 'error'); }); menuDragEnd(); }
function menuDragEnd(){ if (_menuDragSrc) _menuDragSrc.style.opacity = ''; document.querySelectorAll('tr.menu-row').forEach(function(r){ r.style.borderTop = ''; r.style.borderBottom = ''; }); _menuDragSrc = null; }

function buildFormFields(item){
  var html = '';
  fields.forEach(function(f){
    var v = item ? (item[f.name] == null ? '' : item[f.name]) : (f.default !== undefined ? f.default : '');
    var id = 'fld_' + f.name;
    var req = f.required ? ' required' : '';
    var reqStar = f.required ? ' <span style="color:#b3261e">*</span>' : '';
    html += '<div class="form-group"><label for="' + id + '">' + esc(labelFor(f)) + reqStar + '</label>';
    if (f.type === 'textarea'){ html += '<textarea id="' + id + '" class="form-control"' + req + ' placeholder="' + esc(f.placeholder||'') + '">' + esc(v) + '</textarea>'; }
    else if (f.type === 'boolean'){ html += '<div class="field-checkbox"><input type="checkbox" id="' + id + '"' + (v && v != '0' ? ' checked' : '') + '><span class="help-text" style="margin:0">' + esc(f.description||'') + '</span></div></div>'; return; }
    else if (f.type === 'select'){ html += '<select id="' + id + '" class="form-control">'; if (!f.required) html += '<option value="">—</option>'; (f.options||[]).forEach(function(o){ html += '<option value="' + esc(o) + '"' + (String(v) === String(o) ? ' selected' : '') + '>' + esc(o) + '</option>'; }); html += '</select>'; }
    else if (f.type === 'select_dynamic'){
      var rows = dynamicSources[f.source] || []; var valueField = f.valueField || 'slug'; var labelField = f.labelField || 'name_fr'; var editable = !!f.editable;
      html += '<div class="select-dynamic-wrap" data-source="' + esc(f.source) + '" data-field-id="' + id + '" data-value-field="' + esc(valueField) + '" data-label-field="' + esc(labelField) + '" style="display:flex;gap:.4rem;align-items:stretch;flex-wrap:wrap">';
      html += '<select id="' + id + '" class="form-control"' + req + ' style="flex:1;min-width:160px"><option value="">' + (f.required ? '— Choisir —' : '— Aucune —') + '</option>';
      rows.forEach(function(row){ var optVal = row[valueField] == null ? '' : String(row[valueField]); var optLabel = row[labelField] || row[valueField] || ('#' + row.id); html += '<option value="' + esc(optVal) + '" data-id="' + esc(row.id) + '" data-name-fr="' + esc(row.name_fr||'') + '" data-name-en="' + esc(row.name_en||'') + '"' + (String(v) === optVal ? ' selected' : '') + '>' + esc(optLabel) + '</option>'; });
      html += '</select>';
      if (editable){ html += '<button type="button" class="btn btn-sm btn-secondary" onclick="dynRename(\'' + id + '\')" title="Renommer">✏️</button><button type="button" class="btn btn-sm" onclick="dynCreate(\'' + id + '\')" title="Créer" style="background:#c4a24c;color:#2a210e">+ Nouvelle</button>'; }
      html += '</div>';
      if (editable) html += '<div id="' + id + '_inline" style="display:none;margin-top:.5rem;padding:.75rem;background:#fbf7ef;border:1px solid #e7e0d4;border-radius:8px"></div>';
    }
    else if (f.type === 'size_list'){
      var sizes = []; try { sizes = v ? (typeof v === 'string' ? JSON.parse(v) : v) : []; } catch(_){ sizes = []; } if (!Array.isArray(sizes)) sizes = [];
      html += '<div class="size-list" data-field-id="' + id + '"><div class="size-list-rows" id="' + id + '_rows"></div><button type="button" class="btn btn-sm btn-secondary" onclick="addSizeRow(\'' + id + '\')" style="margin-top:.4rem">+ Ajouter un format</button></div>';
      window._pendingSizeInit = window._pendingSizeInit || {}; window._pendingSizeInit[id] = sizes;
    }
    else if (f.type === 'image'){
      html += '<input type="text" id="' + id + '" class="form-control" placeholder="URL de l\'image" value="' + esc(v) + '" oninput="refreshPreview(\'' + id + '\')"><input type="file" accept="image/*" onchange="uploadImage(this, \'' + id + '\')" style="margin-top:.5rem;font-size:.85rem"><div id="' + id + '_preview">' + (v ? '<img src="' + esc(v) + '" class="img-preview">' : '') + '</div>';
    }
    else if (f.type === 'datetime'){ var dtv = ''; if (v){ dtv = String(v).replace(' ','T').substring(0,16); } html += '<input type="datetime-local" id="' + id + '" class="form-control"' + req + ' value="' + esc(dtv) + '">'; }
    else if (f.type === 'number'){ var step = f.step != null ? f.step : '1'; var mn = f.min != null ? ' min="' + f.min + '"' : ''; var mx = f.max != null ? ' max="' + f.max + '"' : ''; html += '<input type="number" id="' + id + '" class="form-control"' + req + ' value="' + esc(v) + '" step="' + step + '"' + mn + mx + ' placeholder="' + esc(f.placeholder||'') + '">'; }
    else if (f.type === 'url'){ html += '<input type="url" id="' + id + '" class="form-control"' + req + ' value="' + esc(v) + '" placeholder="' + esc(f.placeholder||'') + '">'; }
    else { html += '<input type="text" id="' + id + '" class="form-control"' + req + ' value="' + esc(v) + '" placeholder="' + esc(f.placeholder||'') + '">'; }
    if (f.description) html += '<div class="help-text">' + esc(f.description) + '</div>';
    html += '</div>';
  });
  return html;
}
function refreshPreview(fieldId){ var url = document.getElementById(fieldId).value; document.getElementById(fieldId + '_preview').innerHTML = url ? '<img src="' + url.replace(/"/g,'&quot;') + '" class="img-preview">' : ''; }
async function uploadImage(input, fieldId){ var file = input.files[0]; if (!file) return; var reader = new FileReader(); reader.onload = async function(){ try { var r = await fetch('api/admin/upload', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ dataUri: reader.result }) }); var data = await r.json(); if (data.url){ document.getElementById(fieldId).value = data.url; refreshPreview(fieldId); toast('Image téléchargée'); } else toast('Erreur: ' + (data.error || 'inconnue'), 'error'); } catch(e){ toast('Erreur de téléchargement', 'error'); } }; reader.readAsDataURL(file); }

async function dynRefreshSource(source){ try { var r = await fetch('api/admin/' + source); var d = await r.json(); dynamicSources[source] = d[source] || []; return dynamicSources[source]; } catch(e){ return dynamicSources[source] || []; } }
function dynRerenderSelect(fieldId, selectedValue){ var wrap = document.querySelector('.select-dynamic-wrap[data-field-id="' + fieldId + '"]'); if (!wrap) return; var source = wrap.getAttribute('data-source'); var valueField = wrap.getAttribute('data-value-field')||'slug'; var labelField = wrap.getAttribute('data-label-field')||'name_fr'; var rows = dynamicSources[source]||[]; var sel = document.getElementById(fieldId); if (!sel) return; var keep = selectedValue != null ? String(selectedValue) : String(sel.value||''); var html = '<option value="">— Aucune —</option>'; rows.forEach(function(row){ var optVal = row[valueField]==null?'':String(row[valueField]); var optLabel = row[labelField]||row[valueField]||('#'+row.id); html += '<option value="' + esc(optVal) + '" data-id="' + esc(row.id) + '" data-name-fr="' + esc(row.name_fr||'') + '" data-name-en="' + esc(row.name_en||'') + '"' + (String(keep)===optVal?' selected':'') + '>' + esc(optLabel) + '</option>'; }); sel.innerHTML = html; }
function dynCloseInline(fieldId){ var box = document.getElementById(fieldId + '_inline'); if (box){ box.style.display = 'none'; box.innerHTML = ''; } }
function dynShowInline(fieldId, html){ var box = document.getElementById(fieldId + '_inline'); if (box){ box.innerHTML = html; box.style.display = 'block'; } }
function dynCreate(fieldId){ dynShowInline(fieldId, '<div style="font-weight:700;font-size:.92rem;margin-bottom:.5rem">Nouvelle section</div><div style="display:grid;grid-template-columns:1fr 1fr auto auto;gap:.4rem;align-items:center"><input type="text" id="' + fieldId + '_new_fr" class="form-control" placeholder="Nom (FR)" style="font-size:.9rem"><input type="text" id="' + fieldId + '_new_en" class="form-control" placeholder="Name (EN)" style="font-size:.9rem"><button type="button" class="btn btn-sm btn-primary" onclick="dynSubmitCreate(\'' + fieldId + '\')">✓ Créer</button><button type="button" class="btn btn-sm btn-secondary" onclick="dynCloseInline(\'' + fieldId + '\')">×</button></div>'); var el = document.getElementById(fieldId + '_new_fr'); if (el) el.focus(); }
async function dynSubmitCreate(fieldId){ var wrap = document.querySelector('.select-dynamic-wrap[data-field-id="' + fieldId + '"]'); if (!wrap) return; var source = wrap.getAttribute('data-source'); var valueField = wrap.getAttribute('data-value-field')||'slug'; var nameFr = (document.getElementById(fieldId + '_new_fr').value||'').trim(); var nameEn = (document.getElementById(fieldId + '_new_en').value||'').trim(); if (!nameFr){ toast('Nom requis', 'error'); return; } try { var r = await fetch('api/admin/' + source, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ name_fr: nameFr, name_en: nameEn }) }); var d = await r.json().catch(function(){ return {}; }); if (!r.ok){ toast('Erreur: ' + (d.error||'inconnue'), 'error'); return; } await dynRefreshSource(source); var newVal = d.item && d.item[valueField] ? d.item[valueField] : null; dynRerenderSelect(fieldId, newVal); dynCloseInline(fieldId); try { renderList(); } catch(_){} toast('Section créée'); } catch(e){ toast('Erreur réseau', 'error'); } }
function dynRename(fieldId){ var sel = document.getElementById(fieldId); if (!sel || !sel.value){ toast('Choisissez une section à renommer', 'error'); return; } var opt = sel.options[sel.selectedIndex]; var id = opt.getAttribute('data-id'); var nameFr = opt.getAttribute('data-name-fr') || opt.textContent; var nameEn = opt.getAttribute('data-name-en') || ''; if (!id){ toast('Introuvable', 'error'); return; } dynShowInline(fieldId, '<div style="font-weight:700;font-size:.92rem;margin-bottom:.5rem">Renommer la section</div><div style="display:grid;grid-template-columns:1fr 1fr auto auto;gap:.4rem;align-items:center"><input type="text" id="' + fieldId + '_ren_fr" class="form-control" value="' + esc(nameFr) + '" style="font-size:.9rem"><input type="text" id="' + fieldId + '_ren_en" class="form-control" value="' + esc(nameEn) + '" style="font-size:.9rem"><button type="button" class="btn btn-sm btn-primary" onclick="dynSubmitRename(\'' + fieldId + '\', ' + id + ')">✓ Sauver</button><button type="button" class="btn btn-sm btn-secondary" onclick="dynCloseInline(\'' + fieldId + '\')">×</button></div>'); }
async function dynSubmitRename(fieldId, id){ var wrap = document.querySelector('.select-dynamic-wrap[data-field-id="' + fieldId + '"]'); if (!wrap) return; var source = wrap.getAttribute('data-source'); var nameFr = (document.getElementById(fieldId + '_ren_fr').value||'').trim(); var nameEn = (document.getElementById(fieldId + '_ren_en').value||'').trim(); if (!nameFr){ toast('Nom requis', 'error'); return; } try { var r = await fetch('api/admin/' + source + '/' + id, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ name_fr: nameFr, name_en: nameEn }) }); var d = await r.json().catch(function(){ return {}; }); if (!r.ok){ toast('Erreur: ' + (d.error||'inconnue'), 'error'); return; } await dynRefreshSource(source); dynRerenderSelect(fieldId, document.getElementById(fieldId).value); dynCloseInline(fieldId); try { renderList(); } catch(_){} toast('Section renommée'); } catch(e){ toast('Erreur réseau', 'error'); } }

function renderSizeRowsInto(fieldId, sizes){ var container = document.getElementById(fieldId + '_rows'); if (!container) return; if (!sizes || !sizes.length){ container.innerHTML = '<p style="color:#b9ac9a;font-size:.85rem;margin:.25rem 0">Aucun format — le prix unique s\'applique.</p>'; return; } var html = ''; sizes.forEach(function(s, idx){ var lfr = s.label_fr==null?'':s.label_fr; var len = s.label_en==null?'':s.label_en; var price = s.price==null||s.price===''?'':s.price; html += '<div class="size-row" data-row-idx="' + idx + '" style="display:grid;grid-template-columns:1fr 1fr 110px 36px;gap:.4rem;margin-bottom:.4rem;align-items:center"><input type="text" class="form-control size-fr" placeholder="Format (FR)" value="' + esc(lfr) + '" style="font-size:.9rem"><input type="text" class="form-control size-en" placeholder="Size (EN)" value="' + esc(len) + '" style="font-size:.9rem"><input type="number" class="form-control size-price" placeholder="Prix" step="0.01" min="0" value="' + esc(price) + '" style="font-size:.9rem"><button type="button" class="btn btn-sm btn-danger" onclick="removeSizeRow(\'' + fieldId + '\', ' + idx + ')">×</button></div>'; }); container.innerHTML = html; }
function collectSizeRows(fieldId){ var rows = document.querySelectorAll('#' + fieldId + '_rows .size-row'); var out = []; rows.forEach(function(r){ var lfr = (r.querySelector('.size-fr')||{}).value||''; var len = (r.querySelector('.size-en')||{}).value||''; var p = (r.querySelector('.size-price')||{}).value; var price = p === '' ? null : parseFloat(p); if (lfr || len || price != null) out.push({ label_fr: lfr.trim(), label_en: len.trim(), price: price }); }); return out; }
function addSizeRow(fieldId){ var current = collectSizeRows(fieldId); current.push({ label_fr:'', label_en:'', price:'' }); renderSizeRowsInto(fieldId, current); }
function removeSizeRow(fieldId, idx){ var current = collectSizeRows(fieldId); current.splice(idx, 1); renderSizeRowsInto(fieldId, current); }

function openModal(item){ editingId = item ? item.id : null; document.getElementById('modalTitle').textContent = item ? 'Modifier' : 'Ajouter'; document.getElementById('formFields').innerHTML = buildFormFields(item); if (window._pendingSizeInit){ for (var k in window._pendingSizeInit) renderSizeRowsInto(k, window._pendingSizeInit[k]); window._pendingSizeInit = {}; } document.getElementById('modal').classList.add('open'); }
function closeModal(){ document.getElementById('modal').classList.remove('open'); }
function editItem(id){ var it = items.find(function(x){ return x.id === id; }); if (it) openModal(it); }
async function deleteItem(id){ if (!confirm('Supprimer cet élément définitivement ?')) return; try { var r = await fetch('api/admin/' + MODULE_KEY + '/' + id, { method:'DELETE' }); if (r.ok){ toast('Supprimé'); loadItems(); } else toast('Erreur de suppression', 'error'); } catch(e){ toast('Erreur réseau', 'error'); } }

document.getElementById('itemForm').addEventListener('submit', async function(e){
  e.preventDefault();
  var data = {};
  fields.forEach(function(f){
    if (f.type === 'size_list'){ var fieldId = 'fld_' + f.name; var rows = collectSizeRows(fieldId); data[f.name] = rows.length ? JSON.stringify(rows) : null; return; }
    var el = document.getElementById('fld_' + f.name); if (!el) return;
    if (f.type === 'boolean') data[f.name] = el.checked ? 1 : 0;
    else if (f.type === 'number') data[f.name] = el.value === '' ? null : parseFloat(el.value);
    else data[f.name] = el.value;
  });
  var saveBtn = document.getElementById('saveBtn'); saveBtn.disabled = true; saveBtn.textContent = 'Enregistrement…';
  try {
    var url = editingId ? ('api/admin/' + MODULE_KEY + '/' + editingId) : ('api/admin/' + MODULE_KEY);
    var r = await fetch(url, { method: editingId ? 'PUT' : 'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(data) });
    if (r.ok){ closeModal(); toast(editingId ? 'Modifié' : 'Ajouté'); loadItems(); }
    else { var err = await r.json().catch(function(){ return {}; }); toast('Erreur: ' + (err.error || 'inconnue'), 'error'); }
  } catch(e){ toast('Erreur réseau', 'error'); }
  finally { saveBtn.disabled = false; saveBtn.textContent = 'Enregistrer'; }
});
document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeModal(); });
loadModule();
</script>
</body>
</html>
