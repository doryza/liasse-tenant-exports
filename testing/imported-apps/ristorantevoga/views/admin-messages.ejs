<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Admin — Messages</title>
<link rel="stylesheet" href="public/css/admin-styles.css">
</head>
<body>
<div class="admin-layout">
<%- include('partials/admin-sidebar', { page: 'messages' }) %>
<main class="admin-main">
<div class="admin-header">
  <div>
    <h1>Messages</h1>
    <p style="margin:.25rem 0 0;color:#8a7e6e;font-size:.9rem" id="countLabel">Messages reçus via le formulaire de contact (hors réservations).</p>
  </div>
</div>
<div class="card">
  <div id="list"><p class="empty"><span class="emoji">⏳</span>Chargement…</p></div>
</div>
</main>
</div>
<div class="toast" id="toast"></div>
<script>
function esc(s){ if (s == null) return ''; return String(s).replace(/[&<>"']/g, function(c){ return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]; }); }
function toast(msg, type){ var t = document.getElementById('toast'); t.className = 'toast toast-' + (type||'success'); t.textContent = msg; setTimeout(function(){ t.classList.add('show'); }, 10); setTimeout(function(){ t.classList.remove('show'); }, 2800); }
var messages = [];
function fmtDate(s){ try { return new Date(s).toLocaleString('fr-CA', { year:'numeric', month:'short', day:'numeric', hour:'2-digit', minute:'2-digit' }); } catch(e){ return s; } }

async function load(){
  try { var r = await fetch('api/admin/contact_messages'); var d = await r.json(); messages = d.contact_messages || []; render(); }
  catch(e){ document.getElementById('list').innerHTML = '<p class="empty"><span class="emoji">⚠️</span>Erreur de chargement</p>'; }
}
function render(){
  var c = document.getElementById('list');
  if (!messages.length){ c.innerHTML = '<p class="empty"><span class="emoji">📭</span>Aucun message pour l\'instant.</p>'; return; }
  var html = '<div style="overflow-x:auto"><table><thead><tr><th>Date</th><th>Nom</th><th>Coordonnées</th><th>Message</th><th>Statut</th><th style="text-align:right">Actions</th></tr></thead><tbody>';
  messages.forEach(function(m){
    var contact = esc(m.email || '');
    if (m.phone) contact += '<br><span style="color:#8a7e6e">' + esc(m.phone) + '</span>';
    var subj = m.subject ? '<strong>' + esc(m.subject) + '</strong><br>' : '';
    html += '<tr style="' + (m.handled ? 'opacity:.6' : '') + '">';
    html += '<td style="white-space:nowrap;font-size:.85rem">' + esc(fmtDate(m.created_at)) + '</td>';
    html += '<td>' + esc(m.name || '—') + '</td>';
    html += '<td style="font-size:.85rem">' + contact + '</td>';
    html += '<td style="max-width:380px">' + subj + '<span style="color:#3a342d">' + esc(m.message || '') + '</span></td>';
    html += '<td>' + (m.handled ? '<span class="badge badge-muted">Traité</span>' : '<span class="badge badge-warn">Nouveau</span>') + '</td>';
    html += '<td class="row-actions" style="text-align:right;white-space:nowrap">';
    if (m.email) html += '<a class="btn btn-sm btn-primary" href="mailto:' + esc(m.email) + '?subject=' + encodeURIComponent('Re: ' + (m.subject || 'Votre message — Ristorante Voga')) + '" title="Répondre">↩︎</a>';
    html += '<button class="btn btn-sm btn-secondary" onclick="toggle(' + m.id + ',' + (m.handled ? 0 : 1) + ')" title="' + (m.handled ? 'Marquer non traité' : 'Marquer traité') + '">' + (m.handled ? '↺' : '✓') + '</button>';
    html += '<button class="btn btn-sm btn-danger" onclick="del(' + m.id + ')" title="Supprimer">🗑️</button>';
    html += '</td></tr>';
  });
  html += '</tbody></table></div>';
  c.innerHTML = html;
}
async function toggle(id, handled){ try { var r = await fetch('api/admin/contact_messages/' + id, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ handled: handled }) }); if (r.ok){ toast('Mis à jour'); load(); } else toast('Erreur', 'error'); } catch(e){ toast('Erreur réseau', 'error'); } }
async function del(id){ if (!confirm('Supprimer ce message ?')) return; try { var r = await fetch('api/admin/contact_messages/' + id, { method:'DELETE' }); if (r.ok){ toast('Supprimé'); load(); } else toast('Erreur', 'error'); } catch(e){ toast('Erreur réseau', 'error'); } }
load();
</script>
</body>
</html>
