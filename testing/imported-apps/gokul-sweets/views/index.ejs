<%- include('partials/header') %>
<main id="main">
<section class="hero"><div class="wrap hero-grid">
<div class="hero-copy"><p class="eyebrow" data-lk="t:hero_eyebrow"><span class="spark" aria-hidden="true">✳</span> <%= t.hero_eyebrow %></p>
<h1><span data-lk="t:hero_title"><%= t.hero_title %></span><em data-lk="t:hero_title2"><%= t.hero_title2 %></em></h1>
<p class="lead" data-lk="t:hero_lead"><%= t.hero_lead %></p>
<div class="cta-row"><a class="btn btn-fire" href="<%= orderUrl %>" data-lk="t:hero_cta"><%= t.hero_cta %></a><a class="text-link" href="<%= menuHref %>" data-lk="t:hero_menu"><%= t.hero_menu %> <span aria-hidden="true">↗</span></a></div>
<p class="hero-note" data-lk="t:hero_note"><%= t.hero_note %></p></div>
<figure class="hero-photo"><% if (heroUrl) { %><img src="<%= heroUrl %>" width="900" height="900" alt="<%= t.hero_img_alt %>" fetchpriority="high" data-setting-key="_p_hero_image_url"><% } %><figcaption><span class="photo-number">G</span><span data-lk="t:hero_caption"><%= t.hero_caption %></span><span aria-hidden="true">✳</span></figcaption></figure>
</div></section>
<%- include('partials/welcome-gift') %>
<div class="menu-ribbon" aria-hidden="true"><span><%= lang === 'en' ? 'THALIS' : 'THALIS' %></span><i>✳</i><span><%= lang === 'en' ? 'PARANTHAS' : 'PARANTHAS' %></span><i>✳</i><span><%= lang === 'en' ? 'SWEETS' : 'DOUCEURS' %></span><i>✳</i><span><%= lang === 'en' ? 'TO SHARE' : 'À PARTAGER' %></span></div>
<section class="favourites section"><div class="wrap"><div class="section-head"><div><p class="eyebrow" data-lk="t:fav_label"><%= t.fav_label %></p><h2 data-lk="t:fav_title"><%= t.fav_title %></h2></div><a class="text-link" href="<%= menuHref %>" data-lk="t:fav_all"><%= t.fav_all %> ↗</a></div>
<ul class="favourite-grid"><% favourites.forEach(function(it) { %><li class="food-card"><a href="<%= menuHref %>#dish-<%= it.id %>"><div class="food-photo"><img src="<%= it.image %>" alt="<%= pick(it.name) %>" width="400" height="400" loading="lazy"><span class="food-arrow" aria-hidden="true">↗</span></div><div class="food-caption"><h3><%= pick(it.name) %></h3><span class="food-price"><% if(it.from){ %><small><%= t.menu_from %></small><% } %><%= price(it.price) %></span></div></a></li><% }) %></ul></div></section>
<section class="bowl section"><div class="wrap bowl-grid"><div class="bowl-photo"><img src="<%= bowlUrl %>" alt="<%= t.bowl_img_alt %>" width="700" height="700" loading="lazy" data-setting-key="_p_bowl_image_url"><span class="bowl-stamp" aria-hidden="true">GOKUL<br>SWEETS<br><%= lang === 'en' ? 'BROSSARD' : 'BROSSARD' %></span></div><div class="bowl-copy"><p class="eyebrow" data-lk="t:bowl_label"><%= t.bowl_label %></p><h2 data-lk="t:bowl_title"><%= t.bowl_title %></h2><p class="lead" data-lk="t:bowl_lead"><%= t.bowl_lead %></p>
<ol class="steps"><% [1,2,3].forEach(function(n){ %><li><span class="step-n">0<%= n %></span><div><h3 data-lk="t:bowl_s<%= n %>_title"><%= t['bowl_s'+n+'_title'] %></h3><p data-lk="t:bowl_s<%= n %>_text"><%= t['bowl_s'+n+'_text'] %></p></div></li><% }) %></ol><a class="btn btn-dark" href="<%= menuHref %>#desserts" data-lk="t:bowl_cta"><%= t.bowl_cta %></a></div></div></section>
<section class="categories section"><div class="wrap"><p class="eyebrow" data-lk="t:cats_label"><%= t.cats_label %></p><h2 data-lk="t:cats_title"><%= t.cats_title %></h2><ul class="category-grid"><% menu.categories.forEach(function(c){ %><li><a href="<%= menuHref %>#<%= c.slug %>"><span><%= pick(c.label) %></span><small><%= c.items.length %> <%= t.cats_dishes %></small><b aria-hidden="true">↗</b></a></li><% }) %></ul></div></section>
<section id="visit" class="visit section"><div class="wrap visit-grid"><div><p class="eyebrow" data-lk="t:visit_label"><%= t.visit_label %></p><h2 data-lk="t:visit_title"><%= t.visit_title %></h2><div class="cta-row"><a class="btn btn-fire" href="<%= mapsUrl %>" target="_blank" rel="noopener" data-lk="t:visit_directions"><%= t.visit_directions %></a><a class="text-link" href="<%= telHref %>" data-lk="t:visit_call"><%= t.visit_call %> ↗</a></div></div><dl class="visit-facts"><div><dt><%= t.visit_address %></dt><dd data-setting-key="business_address"><% addressLines.forEach(function(l){ %><%= l %><br><% }) %></dd></div><div><dt><%= t.visit_phone %></dt><dd><a href="<%= telHref %>" data-setting-key="contact_phone"><%= phone %></a></dd></div><% if(hoursLines.length){ %><div><dt><%= t.visit_hours %></dt><dd><% hoursLines.forEach(function(l){ %><%= l %><br><% }) %></dd></div><% } %></dl></div></section>
<section class="order-band"><div class="wrap band-row"><div><h2 data-lk="t:band_title"><%= t.band_title %></h2><p data-lk="t:band_text"><%= t.band_text %></p></div><a class="btn btn-dark" href="<%= orderUrl %>" data-lk="t:band_cta"><%= t.band_cta %></a></div></section>
</main><%- include('partials/footer') %>
