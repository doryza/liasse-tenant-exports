<%- include('partials/header') %>
<section class="bg-ink text-white py-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-4xl md:text-5xl font-black"><%= t.booking_title %></h1>
    <p class="mt-4 text-lg text-slate-300"><%= t.booking_subtitle %></p>
  </div>
</section>
<section class="py-12 bg-white">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div id="bsuccess" class="hidden bg-green-50 border border-green-200 rounded-xl p-6 text-center">
      <div class="text-4xl mb-3">📅</div>
      <p class="text-green-800 font-semibold"><%= t.booking_success %></p>
    </div>
    <form id="booking-form" class="bg-slate-50 rounded-2xl p-6 md:p-8 shadow-sm space-y-5">
      <div class="grid md:grid-cols-2 gap-4">
        <div><label class="block text-sm font-semibold mb-1"><%= t.quote_name %> *</label><input name="name" required class="w-full px-4 py-2.5 rounded-lg border border-slate-300"></div>
        <div><label class="block text-sm font-semibold mb-1"><%= t.quote_email %></label><input name="email" type="email" class="w-full px-4 py-2.5 rounded-lg border border-slate-300"></div>
        <div><label class="block text-sm font-semibold mb-1"><%= t.quote_phone %></label><input name="phone" type="tel" class="w-full px-4 py-2.5 rounded-lg border border-slate-300"></div>
        <div><label class="block text-sm font-semibold mb-1"><%= t.quote_address %> *</label><input name="address" required class="w-full px-4 py-2.5 rounded-lg border border-slate-300"></div>
        <div><label class="block text-sm font-semibold mb-1"><%= t.booking_date %> *</label><input name="preferred_date" type="date" required class="w-full px-4 py-2.5 rounded-lg border border-slate-300"></div>
        <div><label class="block text-sm font-semibold mb-1"><%= t.booking_time %></label><select name="preferred_time" class="w-full px-4 py-2.5 rounded-lg border border-slate-300"><option value=""><%= t.quote_select %></option><option><%= t.booking_time_morning %></option><option><%= t.booking_time_afternoon %></option><option><%= t.booking_time_evening %></option></select></div>
      </div>
      <div><label class="block text-sm font-semibold mb-1"><%= t.quote_project_type %></label><select name="project_type" class="w-full px-4 py-2.5 rounded-lg border border-slate-300"><option value=""><%= t.quote_select %></option><option><%= t.quote_type_new %></option><option><%= t.quote_type_repair %></option><option><%= t.quote_type_seal %></option><option><%= t.quote_type_other %></option></select></div>
      <div><label class="block text-sm font-semibold mb-1"><%= t.booking_notes %></label><textarea name="notes" rows="3" class="w-full px-4 py-2.5 rounded-lg border border-slate-300"></textarea></div>
      <p class="text-xs text-slate-500">* <%= t.required %></p>
      <button type="submit" class="w-full px-6 py-3 rounded-lg font-semibold" style="background-color:#8b5cf6;color:#fff"><%= t.btn_book_now %></button>
      <p id="berror" class="hidden text-red-600 text-sm text-center"><%= t.booking_error %></p>
    </form>
  </div>
</section>
<script>
document.getElementById('booking-form').addEventListener('submit',async function(e){
  e.preventDefault();var btn=e.target.querySelector('button[type=submit]');btn.disabled=true;btn.style.opacity=0.6;
  document.getElementById('berror').classList.add('hidden');
  var fd=new FormData(e.target);var d={};fd.forEach(function(v,k){d[k]=v});
  try{var r=await fetch('./api/booking',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(d)});var j=await r.json();
    if(r.ok&&j.success){e.target.classList.add('hidden');document.getElementById('bsuccess').classList.remove('hidden');window.scrollTo({top:0,behavior:'smooth'});}
    else{document.getElementById('berror').classList.remove('hidden');btn.disabled=false;btn.style.opacity=1;}
  }catch(err){document.getElementById('berror').classList.remove('hidden');btn.disabled=false;btn.style.opacity=1;}
});
</script>
<%- include('partials/footer') %>