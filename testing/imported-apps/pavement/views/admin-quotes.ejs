<%- include('partials/admin-header') %>
<div class="admin-content">
  <div class="admin-header"><div><h1>📋 Demandes de soumission</h1><p class="text-muted">Suivez et qualifiez les demandes entrantes</p></div></div>
  <div class="toolbar"><input id="q" placeholder="🔍 Rechercher (nom, courriel, adresse)…" oninput="render()"><select id="f" onchange="render()"><option value="">Tous les statuts</option><option value="new">Nouveau</option><option value="contacted">Contacté</option><option value="quoted">Soumis</option><option value="won">Gagné</option><option value="lost">Perdu</option></select></div>
  <div id="list" class="data-list"></div>
</div>
<div id="modal" class="modal-overlay hidden"><div class="modal"><div class="modal-header"><h2>Détails de la demande</h2><button onclick="closeModal()" aria-label="Fermer">×</button></div><div id="mbody" class="modal-body"></div></div></div>
<div id="toast" class="toast hidden"></div>
<script>
var items = <%- JSON.stringify(items) %>;
function toast(m,e){var t=document.getElementById('toast');t.textContent=m;t.className='toast'+(e?' err':'');setTimeout(function(){t.classList.add('hidden');},2200);}
function render(){var q=(document.getElementById('q').value||'').toLowerCase();var f=document.getElementById('f').value;var filtered=items.filter(function(it){if(f&&it.status!==f)return false;if(q){var blob=((it.name||'')+' '+(it.email||'')+' '+(it.phone||'')+' '+(it.address||'')).toLowerCase();if(!blob.includes(q))return false;}return true;});var h='';if(!filtered.length){h='<div class="empty"><div class="empty-icon">📋</div><h3>Aucune demande</h3><p>'+(items.length?'Aucun résultat avec ces filtres.':'Les demandes envoyées via le site apparaîtront ici.')+'</p></div>';}else{filtered.forEach(function(qq){h+='<div class="data-item"><div class="placeholder">📋</div><div class="data-info"><h3>'+escapeHtml(qq.name||'')+' <span class="badge badge-'+qq.status+'">'+qq.status+'</span></h3><p>'+escapeHtml(qq.project_type||'(type non précisé)')+(qq.surface_size?' · '+escapeHtml(qq.surface_size)+' pi²':'')+(qq.timeline?' · '+escapeHtml(qq.timeline):'')+'</p><div class="meta">'+(qq.email?'✉ '+qq.email:'')+(qq.phone?' · 📞 '+qq.phone:'')+' · '+new Date(qq.created_at).toLocaleDateString('fr-CA')+'</div></div><div class="data-actions"><button onclick=\'view('+JSON.stringify(qq)+')\'>👁️ Détails</button><button class="danger" onclick="del('+qq.id+')">🗑️</button></div></div>';});}document.getElementById('list').innerHTML=h;}
function escapeHtml(s){return String(s||'').replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
function view(qq){var h='<dl class="detail-list">';var labels={name:'Nom',email:'Courriel',phone:'Téléphone',address:'Adresse',project_type:'Type',surface_size:'Surface',timeline:'Échéancier'};Object.keys(labels).forEach(function(k){if(qq[k])h+='<dt>'+labels[k]+'</dt><dd>'+(k==='email'?'<a href="mailto:'+escapeHtml(qq[k])+'">'+escapeHtml(qq[k])+'</a>':k==='phone'?'<a href="tel:'+escapeHtml(qq[k])+'">'+escapeHtml(qq[k])+'</a>':escapeHtml(qq[k]))+'</dd>';});if(qq.message)h+='<dt>Message</dt><dd style="white-space:pre-wrap">'+escapeHtml(qq.message)+'</dd>';h+='<dt>Reçu le</dt><dd>'+new Date(qq.created_at).toLocaleString('fr-CA')+'</dd></dl><label>Statut du suivi<select id="qstat"><option value="new">🆕 Nouveau</option><option value="contacted">📞 Contacté</option><option value="quoted">💰 Soumis</option><option value="won">✅ Gagné</option><option value="lost">❌ Perdu</option></select></label><div class="modal-actions"><button type="button" onclick="closeModal()">Fermer</button><button class="btn-primary" onclick="updateStatus('+qq.id+')">💾 Mettre à jour</button></div>';document.getElementById('mbody').innerHTML=h;document.getElementById('qstat').value=qq.status||'new';document.getElementById('modal').classList.remove('hidden');}
function closeModal(){document.getElementById('modal').classList.add('hidden');}
async function updateStatus(id){var s=document.getElementById('qstat').value;var r=await fetch('api/admin/quotes/'+id,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:s})});if(r.ok){items=items.map(function(x){return x.id==id?Object.assign(x,{status:s}):x;});closeModal();render();toast('Statut mis à jour');}else{toast('Erreur',true);}}
async function del(id){if(!confirm('Supprimer cette demande? Cette action est irréversible.'))return;var r=await fetch('api/admin/quotes/'+id,{method:'DELETE'});if(r.ok){items=items.filter(function(s){return s.id!==id});render();toast('Demande supprimée');}else{toast('Erreur',true);}}
render();
</script>
<%- include('partials/admin-footer') %>