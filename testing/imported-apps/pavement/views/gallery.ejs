<%- include('partials/header') %>
<section class="bg-ink text-white py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-4xl md:text-5xl font-black"><%= t.gallery_title %></h1>
    <p class="mt-4 text-lg text-slate-300"><%= t.gallery_subtitle %></p>
  </div>
</section>
<section class="py-12 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <% if (gallery && gallery.length > 0) { %>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% gallery.forEach(function(g){ var gTitle = lang==='en'&&g.title_en?g.title_en:g.title; var gDesc = lang==='en'&&g.description_en?g.description_en:g.description; %>
          <div class="group bg-slate-50 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition">
            <div class="aspect-[4/3] overflow-hidden"><img src="<%= g.image_url %>" alt="<%= gTitle %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-500"></div>
            <div class="p-5">
              <% if (gTitle) { %><h3 class="font-bold text-ink"><%= gTitle %></h3><% } %>
              <div class="flex items-center gap-3 text-xs text-slate-500 mt-1">
                <% if (g.location) { %><span>📍 <%= g.location %></span><% } %>
                <% if (g.project_year) { %><span><%= g.project_year %></span><% } %>
              </div>
              <% if (gDesc) { %><p class="mt-3 text-sm text-slate-600"><%= gDesc %></p><% } %>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="text-center py-20"><p class="text-slate-500"><%= t.gallery_empty %></p></div>
    <% } %>
    <div class="mt-12 text-center">
      <a href="quote" class="inline-block px-8 py-3 rounded-lg font-semibold" style="background-color:#8b5cf6;color:#fff"><%= t.btn_quote %></a>
    </div>
  </div>
</section>
<%- include('partials/footer') %>