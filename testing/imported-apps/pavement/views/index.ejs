<%- include('partials/header') %>
<section class="relative">
  <img src="<%= settings._p_hero_image_url || 'https://placehold.co/1600x900/8b5cf6/ffffff/png?text=Pavage' %>" alt="Hero" class="w-full h-[480px] md:h-[600px] object-cover">
  <div class="absolute inset-0 gradient-hero flex items-center">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-white w-full">
      <div class="max-w-2xl fade-in">
        <span class="inline-block px-3 py-1 bg-white/15 backdrop-blur rounded-full text-xs font-semibold mb-4 border border-white/20" style="color:#fff"><%= lang==='fr'?'Pavage résidentiel · Québec':'Residential paving · Quebec' %></span>
        <h1 class="text-4xl md:text-6xl font-black leading-tight" style="color:#fff"><%= lang==='fr' ? settings.hero_title_fr : settings.hero_title_en %></h1>
        <p class="mt-5 text-lg md:text-xl text-white/90 max-w-xl" style="color:rgba(255,255,255,0.92)"><%= lang==='fr' ? settings.hero_subtitle_fr : settings.hero_subtitle_en %></p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="quote" class="px-6 py-3 rounded-lg font-semibold shadow-lg" style="background-color:#8b5cf6;color:#fff"><%= t.btn_quote %> →</a>
          <a href="booking" class="px-6 py-3 rounded-lg font-semibold bg-white text-ink hover:bg-slate-100" style="color:#0f172a"><%= t.btn_book %></a>
        </div>
        <div class="mt-8 flex flex-wrap gap-6 text-sm" style="color:rgba(255,255,255,0.85)">
          <div class="flex items-center gap-2"><span class="text-xl" style="color:#a78bfa">✓</span> <%= lang==='fr'?'Soumission gratuite':'Free quote' %></div>
          <div class="flex items-center gap-2"><span class="text-xl" style="color:#a78bfa">✓</span> <%= lang==='fr'?'Garantie 5 ans':'5-year warranty' %></div>
          <div class="flex items-center gap-2"><span class="text-xl" style="color:#a78bfa">✓</span> <%= lang==='fr'?'20+ ans d\'expérience':'20+ years experience' %></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between mb-10">
      <div>
        <h2 class="text-3xl md:text-4xl font-black text-ink"><%= t.home_services_title %></h2>
        <p class="text-slate-600 mt-2"><%= t.home_services_subtitle %></p>
      </div>
      <a href="services" class="font-semibold hover:underline hidden md:inline" style="color:#8b5cf6"><%= t.btn_view_all %> →</a>
    </div>
    <% if (services && services.length > 0) { %>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% services.forEach(function(s){ var sName = lang==='en'&&s.name_en?s.name_en:s.name; var sDesc = lang==='en'&&s.description_en?s.description_en:s.description; %>
          <div class="group bg-slate-50 rounded-2xl overflow-hidden hover:shadow-xl transition border border-slate-100">
            <% if (s.image_url) { %><div class="h-48 overflow-hidden"><img src="<%= s.image_url %>" alt="<%= sName %>" class="w-full h-full object-cover group-hover:scale-105 transition"></div><% } else { %><div class="h-48 flex items-center justify-center text-5xl" style="background:linear-gradient(135deg,#8b5cf6,#7c3aed);color:#fff">🛣️</div><% } %>
            <div class="p-6">
              <h3 class="font-bold text-xl text-ink"><%= sName %></h3>
              <p class="text-sm text-slate-600 mt-2 line-clamp-3"><%= sDesc %></p>
              <% if (s.price_from) { %><div class="mt-3 text-sm font-semibold" style="color:#8b5cf6"><%= s.price_from %></div><% } %>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <p class="text-slate-500 text-center py-8"><%= t.services_empty %></p>
    <% } %>
  </div>
</section>

<section class="py-16 bg-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between mb-10">
      <div>
        <h2 class="text-3xl md:text-4xl font-black text-ink"><%= t.home_gallery_title %></h2>
        <p class="text-slate-600 mt-2"><%= t.home_gallery_subtitle %></p>
      </div>
      <a href="gallery" class="font-semibold hover:underline hidden md:inline" style="color:#8b5cf6"><%= t.btn_view_all %> →</a>
    </div>
    <% if (gallery && gallery.length > 0) { %>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        <% gallery.forEach(function(g){ var gTitle = lang==='en'&&g.title_en?g.title_en:g.title; %>
          <div class="relative group rounded-xl overflow-hidden shadow-md aspect-[4/3]">
            <img src="<%= g.image_url %>" alt="<%= gTitle %>" class="w-full h-full object-cover group-hover:scale-110 transition duration-500">
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent opacity-0 group-hover:opacity-100 transition flex items-end p-4">
              <div style="color:#fff">
                <p class="font-semibold text-sm"><%= gTitle %></p>
                <% if (g.location) { %><p class="text-xs" style="color:rgba(255,255,255,0.8)"><%= g.location %></p><% } %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <p class="text-slate-500 text-center py-8"><%= t.gallery_empty %></p>
    <% } %>
  </div>
</section>

<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl font-black text-ink text-center mb-2"><%= t.about_features_title %></h2>
    <p class="text-slate-600 text-center mb-12"><%= lang==='fr'?'Quatre raisons de nous faire confiance':'Four reasons to trust us' %></p>
    <div class="grid md:grid-cols-4 gap-6">
      <div class="text-center p-6"><div class="w-14 h-14 mx-auto rounded-xl flex items-center justify-center text-2xl mb-4" style="background:rgba(139,92,246,0.1);color:#8b5cf6">⏱️</div><h3 class="font-bold text-ink"><%= t.feat_1_t %></h3><p class="text-sm text-slate-600 mt-2"><%= t.feat_1_d %></p></div>
      <div class="text-center p-6"><div class="w-14 h-14 mx-auto rounded-xl flex items-center justify-center text-2xl mb-4" style="background:rgba(139,92,246,0.1);color:#8b5cf6">🛡️</div><h3 class="font-bold text-ink"><%= t.feat_2_t %></h3><p class="text-sm text-slate-600 mt-2"><%= t.feat_2_d %></p></div>
      <div class="text-center p-6"><div class="w-14 h-14 mx-auto rounded-xl flex items-center justify-center text-2xl mb-4" style="background:rgba(139,92,246,0.1);color:#8b5cf6">📋</div><h3 class="font-bold text-ink"><%= t.feat_3_t %></h3><p class="text-sm text-slate-600 mt-2"><%= t.feat_3_d %></p></div>
      <div class="text-center p-6"><div class="w-14 h-14 mx-auto rounded-xl flex items-center justify-center text-2xl mb-4" style="background:rgba(139,92,246,0.1);color:#8b5cf6">⚡</div><h3 class="font-bold text-ink"><%= t.feat_4_t %></h3><p class="text-sm text-slate-600 mt-2"><%= t.feat_4_d %></p></div>
    </div>
  </div>
</section>

<% if (testimonials && testimonials.length > 0) { %>
<section class="py-16 bg-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl font-black text-ink text-center mb-12"><%= t.home_testimonials_title %></h2>
    <div class="grid md:grid-cols-3 gap-6">
      <% testimonials.forEach(function(tm){ var c = lang==='en'&&tm.content_en?tm.content_en:tm.content; %>
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
          <div class="mb-3" style="color:#8b5cf6"><% for(var i=0;i<(tm.rating||5);i++){ %>★<% } %></div>
          <p class="text-slate-700 italic">&laquo; <%= c %> &raquo;</p>
          <div class="mt-4 pt-4 border-t border-slate-100">
            <p class="font-semibold text-ink"><%= tm.author %></p>
            <% if (tm.location) { %><p class="text-sm text-slate-500"><%= tm.location %></p><% } %>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<% if (posts && posts.length > 0) { %>
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between mb-10">
      <h2 class="text-3xl md:text-4xl font-black text-ink"><%= t.blog_title %></h2>
      <a href="blog" class="font-semibold hover:underline" style="color:#8b5cf6"><%= t.btn_view_all %> →</a>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      <% posts.forEach(function(p){ var pTitle = lang==='en'&&p.title_en?p.title_en:p.title; var pContent = lang==='en'&&p.content_en?p.content_en:p.content; %>
        <a href="blog/<%= p.id %>" class="group bg-slate-50 rounded-2xl overflow-hidden hover:shadow-lg transition">
          <% if (p.image_url) { %><div class="h-48 overflow-hidden"><img src="<%= p.image_url %>" alt="<%= pTitle %>" class="w-full h-full object-cover group-hover:scale-105 transition"></div><% } %>
          <div class="p-5">
            <% if (p.category) { %><span class="text-xs font-semibold" style="color:#8b5cf6"><%= p.category.toUpperCase() %></span><% } %>
            <h3 class="font-bold text-lg text-ink mt-1 line-clamp-2"><%= pTitle %></h3>
            <p class="text-sm text-slate-600 mt-2 line-clamp-3"><%= (pContent||'').substring(0,140) %>...</p>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- voice-module-v1 START -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="rounded-2xl p-10 border border-purple-100 text-center" style="background:rgba(139,92,246,0.05)">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-5 border" style="border-color:rgba(139,92,246,0.3);color:#8b5cf6;background:rgba(139,92,246,0.1)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
        <%= lang === 'en' ? 'AI Voice Assistant' : 'Assistant vocal IA' %>
      </div>
      <h2 class="text-3xl md:text-4xl font-black text-ink"><%= lang === 'en' ? 'Talk to our voice assistant' : 'Parlez à notre assistant vocal' %></h2>
      <p class="text-slate-600 mt-3 max-w-xl mx-auto"><%= lang === 'en' ? 'Describe your project by voice — our AI assistant collects your info and connects you with our team in minutes.' : 'Décrivez votre projet à voix haute — notre assistant IA recueille vos informations et vous met en contact avec notre équipe en quelques minutes.' %></p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="voice-assistant" class="px-8 py-3 rounded-lg font-semibold shadow-lg" style="background-color:#8b5cf6;color:#fff"><%= lang === 'en' ? '🎙️ Start a voice session' : '🎙️ Démarrer la voix' %> →</a>
        <a href="quote" class="px-8 py-3 rounded-lg font-semibold bg-white border border-slate-200 hover:bg-slate-50" style="color:#8b5cf6"><%= lang === 'en' ? 'Written quote instead' : 'Soumission écrite' %></a>
      </div>
    </div>
  </div>
</section>
<!-- voice-module-v1 END -->

<section class="py-20 text-white" style="background:linear-gradient(135deg,#8b5cf6,#7c3aed);color:#fff">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl md:text-5xl font-black" style="color:#fff"><%= t.home_cta_title %></h2>
    <p class="mt-4 text-lg" style="color:rgba(255,255,255,0.92)"><%= t.home_cta_subtitle %></p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="quote" class="px-8 py-3 rounded-lg font-semibold bg-white" style="color:#8b5cf6"><%= t.btn_quote %></a>
      <a href="booking" class="px-8 py-3 rounded-lg font-semibold bg-white/15 backdrop-blur border border-white/30" style="color:#fff"><%= t.btn_book %></a>
      <% if (settings.contact_phone) { %><a href="tel:<%= settings.contact_phone %>" class="px-8 py-3 rounded-lg font-semibold bg-white/15 backdrop-blur border border-white/30" style="color:#fff">📞 <%= settings.contact_phone %></a><% } %>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
