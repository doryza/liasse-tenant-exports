<%- include('partials/header') %>
<section class="bg-ink text-white py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-4xl md:text-5xl font-black"><%= t.services_title %></h1>
    <p class="mt-4 text-lg text-slate-300 max-w-2xl"><%= t.services_subtitle %></p>
  </div>
</section>
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <% if (services && services.length > 0) { %>
      <div class="space-y-12">
        <% services.forEach(function(s, idx){ var sName = lang==='en'&&s.name_en?s.name_en:s.name; var sDesc = lang==='en'&&s.description_en?s.description_en:s.description; %>
          <div class="grid md:grid-cols-2 gap-8 items-center">
            <div class="<%= idx%2===1?'md:order-2':'' %>">
              <% if (s.image_url) { %><img src="<%= s.image_url %>" alt="<%= sName %>" class="w-full h-80 object-cover rounded-2xl shadow-lg"><% } else { %><div class="h-80 rounded-2xl flex items-center justify-center text-7xl" style="background:linear-gradient(135deg,#8b5cf6,#7c3aed);color:#fff">🛣️</div><% } %>
            </div>
            <div class="<%= idx%2===1?'md:order-1':'' %>">
              <% if (s.featured) { %><span class="inline-block px-3 py-1 text-xs font-semibold rounded-full mb-3" style="background:rgba(139,92,246,0.1);color:#8b5cf6"><%= lang==='fr'?'Service vedette':'Featured service' %></span><% } %>
              <h2 class="text-3xl font-black text-ink"><%= sName %></h2>
              <p class="mt-4 text-slate-700 leading-relaxed"><%= sDesc %></p>
              <% if (s.price_from) { %><div class="mt-5 text-2xl font-bold" style="color:#8b5cf6"><%= s.price_from %></div><% } %>
              <div class="mt-6 flex gap-3">
                <a href="quote" class="px-5 py-2.5 rounded-lg font-semibold" style="background-color:#8b5cf6;color:#fff"><%= t.btn_quote %></a>
                <a href="booking" class="px-5 py-2.5 rounded-lg font-semibold border border-slate-300" style="color:#0f172a"><%= t.btn_book %></a>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="text-center py-16"><p class="text-slate-500"><%= t.services_empty %></p></div>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>