<%- include('partials/header') %>
<section class="bg-ink text-white py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-4xl md:text-5xl font-black"><%= t.contact_title %></h1>
    <p class="mt-4 text-lg text-slate-300"><%= t.contact_subtitle %></p>
  </div>
</section>
<section class="py-12 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-12">
    <div>
      <h2 class="text-2xl font-black text-ink mb-6"><%= t.contact_info %></h2>
      <div class="space-y-4">
        <% if (settings.contact_phone) { %><div class="flex items-start gap-3"><div class="w-10 h-10 rounded-full flex items-center justify-center" style="background:rgba(139,92,246,0.1);color:#8b5cf6">📞</div><div><div class="text-xs text-slate-500"><%= t.quote_phone %></div><a href="tel:<%= settings.contact_phone %>" class="font-semibold text-ink"><%= settings.contact_phone %></a></div></div><% } %>
        <% if (settings.contact_email) { %><div class="flex items-start gap-3"><div class="w-10 h-10 rounded-full flex items-center justify-center" style="background:rgba(139,92,246,0.1);color:#8b5cf6">✉</div><div><div class="text-xs text-slate-500"><%= t.quote_email %></div><a href="mailto:<%= settings.contact_email %>" class="font-semibold text-ink"><%= settings.contact_email %></a></div></div><% } %>
        <% if (settings.business_address) { %><div class="flex items-start gap-3"><div class="w-10 h-10 rounded-full flex items-center justify-center" style="background:rgba(139,92,246,0.1);color:#8b5cf6">📍</div><div><div class="text-xs text-slate-500"><%= t.service_area %></div><div class="font-semibold text-ink"><%= settings.business_address %></div></div></div><% } %>
      </div>
      <div class="mt-8 p-5 bg-slate-50 rounded-xl">
        <h3 class="font-bold text-ink mb-3"><%= t.contact_hours %></h3>
        <div class="text-sm text-slate-700 space-y-1">
          <div><%= t.contact_hours_mf %></div>
          <div><%= t.contact_hours_sat %></div>
          <div><%= t.contact_hours_sun %></div>
        </div>
      </div>
      <div class="mt-8 p-5 rounded-xl border" style="background:rgba(139,92,246,0.08);border-color:rgba(139,92,246,0.25)">
        <h3 class="font-bold text-ink mb-2"><%= lang==='fr'?'Besoin d\'une soumission?':'Need a quote?' %></h3>
        <p class="text-sm text-slate-700 mb-3"><%= lang==='fr'?'Réponse en moins de 24 heures.':'Response within 24 hours.' %></p>
        <a href="quote" class="inline-block px-5 py-2 rounded-lg text-sm font-semibold" style="background-color:#8b5cf6;color:#fff"><%= t.btn_quote %></a>
      </div>
    </div>
    <div>
      <div id="csuccess" class="hidden bg-green-50 border border-green-200 rounded-xl p-6 text-center">
        <div class="text-4xl mb-3">✉️</div>
        <p class="text-green-800 font-semibold"><%= t.contact_success %></p>
      </div>
      <form id="contact-form" class="bg-slate-50 rounded-2xl p-6 space-y-4">
        <div><label class="block text-sm font-semibold mb-1"><%= t.contact_name %> *</label><input name="name" required class="w-full px-4 py-2.5 rounded-lg border border-slate-300"></div>
        <div><label class="block text-sm font-semibold mb-1"><%= t.contact_email %></label><input name="email" type="email" class="w-full px-4 py-2.5 rounded-lg border border-slate-300"></div>
        <div><label class="block text-sm font-semibold mb-1"><%= t.contact_phone %></label><input name="phone" type="tel" class="w-full px-4 py-2.5 rounded-lg border border-slate-300"></div>
        <div><label class="block text-sm font-semibold mb-1"><%= t.contact_message %> *</label><textarea name="message" rows="5" required class="w-full px-4 py-2.5 rounded-lg border border-slate-300"></textarea></div>
        <button type="submit" class="w-full px-6 py-3 rounded-lg font-semibold" style="background-color:#8b5cf6;color:#fff"><%= t.btn_send %></button>
        <p id="cerror" class="hidden text-red-600 text-sm text-center"><%= t.contact_error %></p>
      </form>
    </div>
  </div>
</section>
<script>
document.getElementById('contact-form').addEventListener('submit',async function(e){
  e.preventDefault();var btn=e.target.querySelector('button[type=submit]');btn.disabled=true;btn.style.opacity=0.6;
  document.getElementById('cerror').classList.add('hidden');
  var fd=new FormData(e.target);var d={};fd.forEach(function(v,k){d[k]=v});
  try{var r=await fetch('./api/contact',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(d)});var j=await r.json();
    if(r.ok&&j.success){e.target.classList.add('hidden');document.getElementById('csuccess').classList.remove('hidden');}
    else{document.getElementById('cerror').classList.remove('hidden');btn.disabled=false;btn.style.opacity=1;}
  }catch(err){document.getElementById('cerror').classList.remove('hidden');btn.disabled=false;btn.style.opacity=1;}
});
</script>
<%- include('partials/footer') %>