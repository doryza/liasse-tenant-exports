<%- include('partials/admin-header') %>
<div class="admin-content">
  <div class="admin-header"><div><h1>📅 Consultations</h1><p class="text-muted">Rendez-vous demandés par les visiteurs</p></div></div>
  <div class="toolbar"><input id="q" placeholder="🔍 Rechercher…" oninput="render()"><select id="f" onchange="render()"><option value="">Tous les statuts</option><option value="pending">En attente</option><option value="confirmed">Confirmé</option><option value="completed">Complété</option><option value="cancelled">Annulé</option></select></div>
  <div id="list" class="data-list"></div>
</div>
<div id="modal" class="modal-overlay hidden"><div class="modal"><div class="modal-header"><h2>Détails de la consultation</h2><button onclick="closeModal()" aria-label="Fermer">×</button></div><div id="mbody" class="modal-body"></div></div></div>
<div id="toast" class="toast hidden"></div>
<script>
var items = <%- JSON.stringify(items) %>;
function toast(m,e){var t=document.getElementById('toast');t.textContent=m;t.className='toast'+(e?' err':'');setTimeout(function(){t.classList.add('hidden');},2200);}
function render(){var q=(document.getElementById('q').value||'').toLowerCase();var f=document.getElementById('f').value;var filtered=items.filter(function(b){if(f&&b.status!==f)return false;if(q){var blob=((b.name||'')+' '+(b.email||'')+' '+(b.address||'')).toLowerCase();if(!blob.includes(q))return false;}return true;});var h='';if(!filtered.length){h='<div class="empty"><div class="empty-icon">📅</div><h3>Aucune consultation</h3><p>'+(items.length?'Aucun résultat.':'Les consultations réservées via le site apparaîtront ici.')+'</p></div>';}else{filtered.forEach(function(b){var d=b.preferred_date?new Date(b.preferred_date).toLocaleDateString('fr-CA',{weekday:'short',year:'numeric',month:'short',day:'numeric'}):'-';h+='<div class="data-item"><div class="placeholder">📅</div><div class="data-info"><h3>'+escapeHtml(b.name||'')+' <span class="badge badge-'+b.status+'">'+b.status+'</span></h3><p>📅 '+d+(b.preferred_time?' · 🕐 '+escapeHtml(b.preferred_time):'')+(b.project_type?' · '+escapeHtml(b.project_type):'')+'</p><div class="meta">'+(b.email?'✉ '+b.email:'')+(b.phone?' · 📞 '+b.phone:'')+(b.address?' · 📍 '+escapeHtml(b.address):'')+'</div></div><div class="data-actions"><button onclick=\'view('+JSON.stringify(b)+')\'>👁️ Détails</button><button class="danger" onclick="del('+b.id+')">🗑️</button></div></div>';});}document.getElementById('list').innerHTML=h;}
function escapeHtml(s){return String(s||'').replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
function view(b){var h='<dl class="detail-list">';var labels={name:'Nom',email:'Courriel',phone:'Téléphone',address:'Adresse',preferred_date:'Date préférée',preferred_time:'Plage horaire',project_type:'Type de projet'};Object.keys(labels).forEach(function(k){if(b[k]){var v=b[k];if(k==='preferred_date')v=new Date(v).toLocaleDateString('fr-CA');h+='<dt>'+labels[k]+'</dt><dd>'+(k==='email'?'<a href="mailto:'+escapeHtml(v)+'">'+escapeHtml(v)+'</a>':k==='phone'?'<a href="tel:'+escapeHtml(v)+'">'+escapeHtml(v)+'</a>':escapeHtml(v))+'</dd>';}});if(b.notes)h+='<dt>Notes</dt><dd style="white-space:pre-wrap">'+escapeHtml(b.notes)+'</dd>';h+='</dl><label>Statut<select id="bstat"><option value="pending">⏳ En attente</option><option value="confirmed">✅ Confirmé</option><option value="completed">🏁 Complété</option><option value="cancelled">❌ Annulé</option></select></label><div class="modal-actions"><button type="button" onclick="closeModal()">Fermer</button><button class="btn-primary" onclick="updateStatus('+b.id+')">💾 Mettre à jour</button></div>';document.getElementById('mbody').innerHTML=h;document.getElementById('bstat').value=b.status||'pending';document.getElementById('modal').classList.remove('hidden');}
function closeModal(){document.getElementById('modal').classList.add('hidden');}
async function updateStatus(id){var s=document.getElementById('bstat').value;var r=await fetch('api/admin/bookings/'+id,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:s})});if(r.ok){items=items.map(function(x){return x.id==id?Object.assign(x,{status:s}):x;});closeModal();render();toast('Statut mis à jour');}else{toast('Erreur',true);}}
async function del(id){if(!confirm('Supprimer cette consultation?'))return;var r=await fetch('api/admin/bookings/'+id,{method:'DELETE'});if(r.ok){items=items.filter(function(s){return s.id!==id});render();toast('Consultation supprimée');}}
render();
</script>
<%- include('partials/admin-footer') %>