<%- include('partials/header') %>
<section class="bg-ink text-white py-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-4xl md:text-5xl font-black"><%= t.quote_title %></h1>
    <p class="mt-4 text-lg text-slate-300"><%= t.quote_subtitle %></p>
  </div>
</section>
<section class="py-12 bg-white">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div id="qsuccess" class="hidden bg-green-50 border border-green-200 rounded-xl p-6 text-center">
      <div class="text-4xl mb-3">✅</div>
      <p class="text-green-800 font-semibold"><%= t.quote_success %></p>
    </div>
    <form id="quote-form" class="bg-slate-50 rounded-2xl p-6 md:p-8 shadow-sm space-y-5">
      <div class="grid md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1"><%= t.quote_name %> *</label>
          <input name="name" required class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-brand focus:ring-2 outline-none" style="--tw-ring-color:rgba(139,92,246,0.2)">
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1"><%= t.quote_email %></label>
          <input name="email" type="email" class="w-full px-4 py-2.5 rounded-lg border border-slate-300">
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1"><%= t.quote_phone %></label>
          <input name="phone" type="tel" class="w-full px-4 py-2.5 rounded-lg border border-slate-300">
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1"><%= t.quote_address %></label>
          <input name="address" class="w-full px-4 py-2.5 rounded-lg border border-slate-300">
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1"><%= t.quote_project_type %></label>
          <select name="project_type" class="w-full px-4 py-2.5 rounded-lg border border-slate-300">
            <option value=""><%= t.quote_select %></option>
            <option><%= t.quote_type_new %></option>
            <option><%= t.quote_type_repair %></option>
            <option><%= t.quote_type_seal %></option>
            <option><%= t.quote_type_other %></option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1"><%= t.quote_surface %></label>
          <input name="surface_size" class="w-full px-4 py-2.5 rounded-lg border border-slate-300">
        </div>
      </div>
      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1"><%= t.quote_timeline %></label>
        <select name="timeline" class="w-full px-4 py-2.5 rounded-lg border border-slate-300">
          <option value=""><%= t.quote_select %></option>
          <option><%= t.quote_time_asap %></option>
          <option><%= t.quote_time_1m %></option>
          <option><%= t.quote_time_3m %></option>
          <option><%= t.quote_time_flexible %></option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1"><%= t.quote_message %></label>
        <textarea name="message" rows="4" class="w-full px-4 py-2.5 rounded-lg border border-slate-300"></textarea>
      </div>
      <p class="text-xs text-slate-500">* <%= t.required %>. <%= lang==='fr'?'Le courriel ou le téléphone est requis pour vous joindre.':'Email or phone required so we can reach you.' %></p>
      <button type="submit" class="w-full px-6 py-3 rounded-lg font-semibold" style="background-color:#8b5cf6;color:#fff"><%= t.btn_send_quote %></button>
      <p id="qerror" class="hidden text-red-600 text-sm text-center"><%= t.quote_error %></p>
    </form>
  </div>
</section>
<script>
document.getElementById('quote-form').addEventListener('submit',async function(e){
  e.preventDefault();
  var btn=e.target.querySelector('button[type=submit]');
  btn.disabled=true;btn.style.opacity=0.6;
  document.getElementById('qerror').classList.add('hidden');
  var fd=new FormData(e.target);var d={};fd.forEach(function(v,k){d[k]=v});
  try{
    var r=await fetch('./api/quote',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(d)});
    var j=await r.json();
    if(r.ok&&j.success){e.target.classList.add('hidden');document.getElementById('qsuccess').classList.remove('hidden');window.scrollTo({top:0,behavior:'smooth'});}
    else{document.getElementById('qerror').classList.remove('hidden');btn.disabled=false;btn.style.opacity=1;}
  }catch(err){document.getElementById('qerror').classList.remove('hidden');btn.disabled=false;btn.style.opacity=1;}
});
</script>
<%- include('partials/footer') %>