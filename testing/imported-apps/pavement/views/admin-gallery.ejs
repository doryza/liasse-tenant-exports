<%- include('partials/admin-header') %>
<div class="admin-content">
  <div class="admin-header"><div><h1>🖼️ Galerie</h1><p class="text-muted">Vitrine de vos réalisations passées</p></div><button class="btn btn-primary" onclick="openModal()">+ Nouveau projet</button></div>
  <div class="toolbar"><input id="q" placeholder="🔍 Rechercher (titre, lieu)…" oninput="render()"></div>
  <div id="list" class="gallery-grid"></div>
</div>
<div id="modal" class="modal-overlay hidden"><div class="modal"><div class="modal-header"><h2 id="mtitle">Nouveau projet</h2><button onclick="closeModal()" aria-label="Fermer">×</button></div><form id="form" class="modal-body">
  <input type="hidden" name="id">
  <label>Titre (FR)<input name="title" placeholder="ex. Entrée résidentielle - Brossard"></label>
  <label>Titre (EN)<input name="title_en"></label>
  <label>Description (FR)<textarea name="description" rows="2" placeholder="Détails du projet…"></textarea></label>
  <label>Description (EN)<textarea name="description_en" rows="2"></textarea></label>
  <label>URL de l'image *<input name="image_url" required placeholder="https://…"></label>
  <div id="preview" class="image-preview hidden"></div>
  <div class="row-2"><label>Lieu<input name="location" placeholder="Brossard, QC"></label><label>Année<input name="project_year" type="number" min="2000" max="2100" placeholder="2024"></label></div>
  <label>Ordre d'affichage<input name="sort_order" type="number" value="0"><span class="hint">Plus petit = en premier</span></label>
  <div class="modal-actions"><button type="button" onclick="closeModal()">Annuler</button><button type="submit" class="btn-primary">Sauvegarder</button></div>
</form></div></div>
<div id="toast" class="toast hidden"></div>
<script>
var items = <%- JSON.stringify(items) %>;
function toast(m,e){var t=document.getElementById('toast');t.textContent=m;t.className='toast'+(e?' err':'');setTimeout(function(){t.classList.add('hidden');},2200);}
function render(){var q=(document.getElementById('q').value||'').toLowerCase();var filtered=items.filter(function(g){if(!q)return true;return ((g.title||'')+' '+(g.location||'')).toLowerCase().includes(q);});var h='';if(!filtered.length){h='<div class="empty empty-grid"><div class="empty-icon">🖼️</div><h3>Aucun projet</h3><p>'+(items.length?'Aucun résultat.':'Cliquez sur "Nouveau projet" pour ajouter une réalisation.')+'</p></div>';}else{filtered.forEach(function(g){h+='<div class="gallery-card"><img src="'+(g.image_url||'')+'" alt=""><div class="gallery-info"><h3>'+escapeHtml(g.title||'(sans titre)')+'</h3><p>'+escapeHtml(g.location||'')+(g.project_year?' · '+g.project_year:'')+'</p><div class="data-actions"><button onclick=\'edit('+JSON.stringify(g)+')\'>✏️</button><button class="danger" onclick="del('+g.id+')">🗑️</button></div></div></div>';});}document.getElementById('list').innerHTML=h;}
function escapeHtml(s){return String(s||'').replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
function openModal(){document.getElementById('mtitle').textContent='Nouveau projet';document.getElementById('form').reset();document.querySelector('[name=id]').value='';document.getElementById('preview').classList.add('hidden');document.getElementById('modal').classList.remove('hidden');}
function closeModal(){document.getElementById('modal').classList.add('hidden');}
function edit(g){document.getElementById('mtitle').textContent='Modifier le projet';var f=document.getElementById('form');f.reset();for(var k in g){var el=f.querySelector('[name='+k+']');if(el)el.value=g[k]||'';}showPreview(g.image_url);document.getElementById('modal').classList.remove('hidden');}
function showPreview(url){var p=document.getElementById('preview');if(url){p.innerHTML='<img src="'+url+'" alt="">';p.classList.remove('hidden');}else{p.classList.add('hidden');}}
document.querySelector('[name=image_url]').addEventListener('input',function(e){showPreview(e.target.value);});
async function del(id){if(!confirm('Supprimer ce projet?'))return;var r=await fetch('api/admin/gallery/'+id,{method:'DELETE'});if(r.ok){items=items.filter(function(s){return s.id!==id});render();toast('Projet supprimé');}}
document.getElementById('form').addEventListener('submit',async function(e){e.preventDefault();var fd=new FormData(e.target);var d={};fd.forEach(function(v,k){d[k]=v;});var id=d.id;delete d.id;var url='api/admin/gallery'+(id?'/'+id:'');var r=await fetch(url,{method:id?'PUT':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(d)});var j=await r.json();if(r.ok){if(id){items=items.map(function(x){return x.id==id?j.item:x;});}else{items.unshift(j.item);}closeModal();render();toast(id?'Projet mis à jour':'Projet ajouté');}else{toast('Erreur: '+(j.error||''),true);}});
render();
</script>
<%- include('partials/admin-footer') %>