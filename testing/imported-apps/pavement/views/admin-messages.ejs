<%- include('partials/admin-header') %>
<div class="admin-content">
  <div class="admin-header"><div><h1>✉️ Messages de contact</h1><p class="text-muted">Messages envoyés via le formulaire de contact</p></div></div>
  <div class="toolbar"><input id="q" placeholder="🔍 Rechercher…" oninput="render()"><select id="f" onchange="render()"><option value="">Tous</option><option value="new">Non lu</option><option value="replied">Répondu</option><option value="archived">Archivé</option></select></div>
  <div id="list" class="data-list"></div>
</div>
<div id="modal" class="modal-overlay hidden"><div class="modal"><div class="modal-header"><h2>Message</h2><button onclick="closeModal()" aria-label="Fermer">×</button></div><div id="mbody" class="modal-body"></div></div></div>
<div id="toast" class="toast hidden"></div>
<script>
var items = <%- JSON.stringify(items) %>;
function toast(m,e){var t=document.getElementById('toast');t.textContent=m;t.className='toast'+(e?' err':'');setTimeout(function(){t.classList.add('hidden');},2200);}
function render(){var q=(document.getElementById('q').value||'').toLowerCase();var f=document.getElementById('f').value;var filtered=items.filter(function(m){if(f&&m.status!==f)return false;if(q){var blob=((m.name||'')+' '+(m.email||'')+' '+(m.message||'')).toLowerCase();if(!blob.includes(q))return false;}return true;});var h='';if(!filtered.length){h='<div class="empty"><div class="empty-icon">✉️</div><h3>Aucun message</h3><p>'+(items.length?'Aucun résultat.':'Les messages reçus apparaîtront ici.')+'</p></div>';}else{filtered.forEach(function(m){h+='<div class="data-item"><div class="placeholder">✉️</div><div class="data-info"><h3>'+escapeHtml(m.name||'')+' <span class="badge badge-'+m.status+'">'+m.status+'</span></h3><p>'+escapeHtml((m.message||'').substring(0,160))+'</p><div class="meta">'+(m.email?'✉ '+m.email:'')+(m.phone?' · 📞 '+m.phone:'')+' · '+new Date(m.created_at).toLocaleDateString('fr-CA')+'</div></div><div class="data-actions"><button onclick=\'view('+JSON.stringify(m)+')\'>👁️ Lire</button><button class="danger" onclick="del('+m.id+')">🗑️</button></div></div>';});}document.getElementById('list').innerHTML=h;}
function escapeHtml(s){return String(s||'').replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
function view(m){var h='<dl class="detail-list"><dt>Nom</dt><dd>'+escapeHtml(m.name||'')+'</dd>';if(m.email)h+='<dt>Courriel</dt><dd><a href="mailto:'+escapeHtml(m.email)+'">'+escapeHtml(m.email)+'</a></dd>';if(m.phone)h+='<dt>Téléphone</dt><dd><a href="tel:'+escapeHtml(m.phone)+'">'+escapeHtml(m.phone)+'</a></dd>';h+='<dt>Reçu le</dt><dd>'+new Date(m.created_at).toLocaleString('fr-CA')+'</dd><dt>Message</dt><dd style="white-space:pre-wrap;background:#f8fafc;padding:12px;border-radius:8px">'+escapeHtml(m.message||'')+'</dd></dl><label>Statut<select id="mstat"><option value="new">🆕 Non lu</option><option value="replied">📬 Répondu</option><option value="archived">📦 Archivé</option></select></label><div class="modal-actions"><button type="button" onclick="closeModal()">Fermer</button>'+(m.email?'<a class="btn-primary" href="mailto:'+escapeHtml(m.email)+'" style="text-decoration:none;display:inline-flex;align-items:center;padding:9px 16px">📧 Répondre</a>':'')+'<button class="btn-primary" onclick="updateStatus('+m.id+')">💾 Mettre à jour</button></div>';document.getElementById('mbody').innerHTML=h;document.getElementById('mstat').value=m.status||'new';document.getElementById('modal').classList.remove('hidden');}
function closeModal(){document.getElementById('modal').classList.add('hidden');}
async function updateStatus(id){var s=document.getElementById('mstat').value;var r=await fetch('api/admin/messages/'+id,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:s})});if(r.ok){items=items.map(function(x){return x.id==id?Object.assign(x,{status:s}):x;});closeModal();render();toast('Statut mis à jour');}else{toast('Erreur',true);}}
async function del(id){if(!confirm('Supprimer ce message?'))return;var r=await fetch('api/admin/messages/'+id,{method:'DELETE'});if(r.ok){items=items.filter(function(s){return s.id!==id});render();toast('Message supprimé');}}
render();
</script>
<%- include('partials/admin-footer') %>