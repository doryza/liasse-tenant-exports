<%- include('partials/header') %>
<section class="bg-ink text-white py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-4xl md:text-5xl font-black"><%= t.blog_title %></h1>
    <p class="mt-4 text-lg text-slate-300"><%= t.blog_subtitle %></p>
  </div>
</section>
<section class="py-12 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <% if (posts && posts.length > 0) { %>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% posts.forEach(function(p){ var pTitle = lang==='en'&&p.title_en?p.title_en:p.title; var pContent = lang==='en'&&p.content_en?p.content_en:p.content; %>
          <a href="blog/<%= p.id %>" class="group bg-slate-50 rounded-2xl overflow-hidden hover:shadow-xl transition">
            <% if (p.image_url) { %><div class="h-48 overflow-hidden"><img src="<%= p.image_url %>" alt="<%= pTitle %>" class="w-full h-full object-cover group-hover:scale-105 transition"></div><% } %>
            <div class="p-5">
              <% if (p.category) { %><span class="text-xs font-semibold text-brand" style="color:#8b5cf6"><%= p.category.toUpperCase() %></span><% } %>
              <h3 class="font-bold text-lg text-ink mt-1 line-clamp-2"><%= pTitle %></h3>
              <p class="text-sm text-slate-600 mt-2 line-clamp-3"><%= (pContent||'').substring(0,160) %>...</p>
              <div class="text-xs text-slate-400 mt-3"><%= formatDate(p.created_at, lang) %></div>
            </div>
          </a>
        <% }); %>
      </div>
    <% } else { %>
      <div class="text-center py-20"><p class="text-slate-500"><%= t.posts_empty %></p></div>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>