<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Posts — Joe Admin</title>
<base href="<%= typeof tenantBase !== 'undefined' ? tenantBase : '/' %>">
<link rel="stylesheet" href="public/css/admin-styles.css">
</head>
<body class="admin-body">
<%- include('partials/admin-sidebar') %>
<main class="admin-main">
  <header class="admin-header">
    <div><h1>Posts</h1><p class="muted">Share tips, updates, and market insights.</p></div>
    <div class="header-actions"><button class="btn btn-primary" style="background-color:#6366f1;color:#fff" onclick="openModal()">+ New Post</button></div>
  </header>
  <div class="admin-toolbar"><input type="text" id="searchInput" placeholder="🔍 Search posts..." class="admin-input"></div>
  <div class="admin-panel">
    <div class="table-wrap">
      <table class="admin-table">
        <thead><tr><th></th><th>Title</th><th>Category</th><th>Status</th><th>Created</th><th>Actions</th></tr></thead>
        <tbody id="pBody"><tr><td colspan="6" class="muted">Loading...</td></tr></tbody>
      </table>
    </div>
  </div>
</main>
<div class="modal" id="editModal">
  <div class="modal-card">
    <header class="modal-head"><h2 id="modalTitle">Post</h2><button onclick="closeModal()" class="modal-close" aria-label="Close">×</button></header>
    <form id="editForm" class="modal-form">
      <input type="hidden" id="f-id">
      <div class="field"><label>Title *</label><input type="text" id="f-title" required></div>
      <div class="field-row">
        <div class="field"><label>Category</label><input type="text" id="f-category" placeholder="Tips, News, Market Update"></div>
        <div class="field"><label>Status</label><label class="check-inline"><input type="checkbox" id="f-published" checked> Published (visible)</label></div>
      </div>
      <div class="field"><label>Image URL</label><input type="url" id="f-image_url" placeholder="https://..."><img id="f-image-preview" style="display:none;margin-top:.5rem;max-height:120px;border-radius:6px"></div>
      <div class="field"><label>Content</label><textarea id="f-content" rows="8" placeholder="Write your post content here..."></textarea></div>
      <div class="modal-actions"><button type="button" class="btn btn-ghost" onclick="closeModal()">Cancel</button><button type="submit" class="btn btn-primary" style="background-color:#6366f1;color:#fff">Save</button></div>
    </form>
  </div>
</div>
<script>
var all = [];
async function load(){ try { var r = await fetch('api/admin/posts'); var d = await r.json(); all = d.posts || []; render(); } catch(e){ document.getElementById('pBody').innerHTML = '<tr><td colspan="6" class="muted">Failed to load.</td></tr>'; } }
function render(){
  var q = (document.getElementById('searchInput').value||'').toLowerCase();
  var rows = all.filter(function(p){ return !q || (p.title||'').toLowerCase().indexOf(q)>=0; });
  var body = document.getElementById('pBody');
  if (rows.length === 0) {
    if (all.length === 0) body.innerHTML = '<tr><td colspan="6"><div class="empty-block"><div class="empty-icon">📝</div><h3>No posts yet</h3><p class="muted">Share tips and updates with your audience.</p><button class="btn btn-primary" style="background-color:#6366f1;color:#fff;margin-top:1rem" onclick="openModal()">Create your first post</button></div></td></tr>';
    else body.innerHTML = '<tr><td colspan="6" class="muted" style="text-align:center;padding:2rem">No posts match your search.</td></tr>';
    return;
  }
  body.innerHTML = rows.map(function(p){
    var img = p.image_url ? '<img src="'+esc(p.image_url)+'" style="width:64px;height:42px;object-fit:cover;border-radius:6px">' : '<div class="img-ph"></div>';
    return '<tr><td>'+img+'</td><td><strong>'+esc(p.title)+'</strong></td><td>'+esc(p.category||'-')+'</td><td>'+(p.published?'<span class="badge badge-new">Published</span>':'<span class="badge badge-archived">Draft</span>')+'</td><td class="muted">'+new Date(p.created_at).toLocaleDateString('en-CA')+'</td><td><div class="row-actions"><button class="btn btn-sm" onclick=\'edit('+JSON.stringify(p)+')\'>Edit</button> <button class="btn btn-sm btn-danger" onclick="del('+p.id+')">Delete</button></div></td></tr>';
  }).join('');
}
function esc(s){ return String(s==null?'':s).replace(/[&<>"]/g,function(c){return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'})[c];}); }
function openModal(){ document.getElementById('editForm').reset(); document.getElementById('f-id').value=''; document.getElementById('f-published').checked=true; document.getElementById('f-image-preview').style.display='none'; document.getElementById('modalTitle').textContent='New Post'; document.getElementById('editModal').classList.add('open'); setTimeout(function(){document.getElementById('f-title').focus();},50); }
function edit(p){ document.getElementById('f-id').value=p.id; document.getElementById('f-title').value=p.title||''; document.getElementById('f-category').value=p.category||''; document.getElementById('f-image_url').value=p.image_url||''; document.getElementById('f-content').value=p.content||''; document.getElementById('f-published').checked=!!p.published; var prev = document.getElementById('f-image-preview'); if (p.image_url) { prev.src = p.image_url; prev.style.display='block'; } else prev.style.display='none'; document.getElementById('modalTitle').textContent='Edit Post'; document.getElementById('editModal').classList.add('open'); }
function closeModal(){ document.getElementById('editModal').classList.remove('open'); }
async function del(id){ if (!confirm('Delete this post?')) return; var r = await fetch('api/admin/posts/'+id,{method:'DELETE'}); if (r.ok) { window.showToast && showToast('Post deleted'); load(); } }
document.getElementById('f-image_url').addEventListener('input', function(){ var prev = document.getElementById('f-image-preview'); if (this.value) { prev.src = this.value; prev.style.display='block'; } else prev.style.display='none'; });
document.getElementById('editForm').addEventListener('submit', async function(e){
  e.preventDefault();
  var id = document.getElementById('f-id').value;
  var body = { title: document.getElementById('f-title').value, category: document.getElementById('f-category').value, image_url: document.getElementById('f-image_url').value, content: document.getElementById('f-content').value, published: document.getElementById('f-published').checked?1:0 };
  var r = await fetch(id ? 'api/admin/posts/'+id : 'api/admin/posts', { method: id?'PUT':'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
  if (r.ok) { closeModal(); window.showToast && showToast(id?'Post updated':'Post created'); load(); } else alert('Save failed');
});
document.getElementById('searchInput').addEventListener('input', render);
document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeModal(); });
load();
</script>
<script src="public/js/admin.js"></script>
</body>
</html>
