<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %> — Admin</title>
<link rel="stylesheet" href="public/css/admin-styles.css">
</head>
<body>
<div class="admin-layout">
<button class="sidebar-toggle" id="sidebarToggle" aria-label="Menu">☰</button>
<aside class="admin-sidebar" id="adminSidebar">
<div class="admin-sidebar-header"><h2>Administration</h2><p><%= adminUser.name %></p></div>
<a href="admin" class="<%= active==='dashboard'?'active':'' %>"><span class="icon">📊</span><span class="label">Tableau de bord</span></a>
<div class="admin-sidebar-section">Contenu</div>
<a href="admin/services" class="<%= active==='services'?'active':'' %>"><span class="icon">🛠️</span><span class="label">Services</span></a>
<a href="admin/gallery" class="<%= active==='gallery'?'active':'' %>"><span class="icon">📸</span><span class="label">Galerie</span></a>
<a href="admin/testimonials" class="<%= active==='testimonials'?'active':'' %>"><span class="icon">⭐</span><span class="label">Témoignages</span></a>
<a href="admin/posts" class="<%= active==='posts'?'active':'' %>"><span class="icon">📝</span><span class="label">Articles</span></a>
<a href="admin/certifications" class="<%= active==='certifications'?'active':'' %>"><span class="icon">🏅</span><span class="label">Certifications</span></a>
<div class="admin-sidebar-section">Demandes</div>
<a href="admin/quote-requests" class="<%= active==='quote-requests'?'active':'' %>"><span class="icon">📋</span><span class="label">Soumissions</span></a>
<a href="admin/appointments" class="<%= active==='appointments'?'active':'' %>"><span class="icon">📅</span><span class="label">Rendez-vous</span></a>
<a href="admin/messages" class="<%= active==='messages'?'active':'' %>"><span class="icon">✉️</span><span class="label">Messages</span></a>
<div class="admin-sidebar-section">Compte</div>
<a href="." target="_blank"><span class="icon">🌐</span><span class="label">Voir le site</span></a>
<a href="admin/logout"><span class="icon">🚪</span><span class="label">Déconnexion</span></a>
</aside>
<div class="sidebar-overlay" id="sidebarOverlay"></div>
<main class="admin-main">
<div class="admin-topbar">
<div><div class="breadcrumb"><a href="admin" style="color:inherit;text-decoration:none">Administration</a> / <%= title %></div><h1><%= title %></h1></div>
<div class="topbar-actions"><a href="." target="_blank" class="btn btn-secondary">🌐 Voir le site</a><button class="btn btn-primary" onclick="openEditor(null)" id="addBtn">+ Ajouter</button></div>
</div>
<div class="admin-card">
<div class="toolbar"><input type="text" id="searchInput" placeholder="🔍 Rechercher..."><select id="statusFilter" style="display:none"></select><span id="countLabel" style="color:var(--admin-muted);font-size:.85rem;margin-left:auto"></span></div>
<div id="itemsContainer"><div class="empty-state"><div class="empty-icon">⏳</div><p>Chargement...</p></div></div>
</div>
</main>
</div>
<div class="modal-bg" id="modalBg" style="display:none"><div class="modal"><div class="modal-header"><h2 id="modalTitle">Éditer</h2><button class="modal-close" type="button" onclick="closeEditor()" aria-label="Fermer">×</button></div><form id="editForm"><div class="modal-body"><div id="formFields"></div></div><div class="modal-actions"><button type="button" class="btn btn-secondary" onclick="closeEditor()">Annuler</button><button type="button" class="btn btn-danger" id="deleteFromModalBtn" style="display:none;margin-right:auto" onclick="deleteFromModal()">🗑 Supprimer</button><button type="submit" class="btn btn-primary" id="saveBtn">💾 Enregistrer</button></div></form></div></div>
<div id="toastHost"></div>
<script>
var moduleKey=<%- JSON.stringify(moduleKey) %>;
var responseKey=<%- JSON.stringify(responseKey) %>;
var singularKey=<%- JSON.stringify(singularKey) %>;
var moduleConfig=null;var items=[];var filtered=[];var editing=null;var iconMap={leaf:'🌿',shovel:'⛏️',snowflake:'❄️',tree:'🌳',flower:'🌸',truck:'🚛',tool:'🔨',home:'🏡'};
function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
function toast(msg,kind){var t=document.createElement('div');t.className='toast '+(kind||'success');t.textContent=msg;document.getElementById('toastHost').appendChild(t);setTimeout(function(){t.style.opacity='0';t.style.transition='opacity .3s';setTimeout(function(){t.remove();},300);},2400);}
function badge(s){return '<span class="badge-status badge-'+esc(s||'new')+'">'+esc(s||'new')+'</span>';}
function loadModule(){return fetch('api/admin/modules').then(function(r){return r.json();}).then(function(d){moduleConfig=(d.modules||[]).filter(function(m){return m.key===moduleKey;})[0];setupStatusFilter();});}
function setupStatusFilter(){if(!moduleConfig)return;var statusField=(moduleConfig.fields||[]).find(function(f){return f.name==='status';});var sel=document.getElementById('statusFilter');if(statusField&&statusField.options){sel.innerHTML='<option value="">Tous les états</option>'+statusField.options.map(function(o){return '<option value="'+esc(o)+'">'+esc(o)+'</option>';}).join('');sel.style.display='inline-block';sel.addEventListener('change',applyFilters);}}
function loadItems(){return fetch('api/admin/'+moduleKey).then(function(r){return r.json();}).then(function(d){items=d[responseKey]||[];applyFilters();});}
function applyFilters(){var q=(document.getElementById('searchInput').value||'').toLowerCase().trim();var stat=document.getElementById('statusFilter').value;filtered=items.filter(function(it){if(stat&&it.status!==stat)return false;if(q){var hay=Object.keys(it).map(function(k){return String(it[k]||'');}).join(' ').toLowerCase();if(hay.indexOf(q)===-1)return false;}return true;});render();}
function render(){var c=document.getElementById('itemsContainer');document.getElementById('countLabel').textContent=filtered.length+' / '+items.length;if(!items.length){c.innerHTML='<div class="empty-state"><div class="empty-icon">📭</div><p>Aucun élément pour le moment.</p><p><button class="btn btn-primary" onclick="openEditor(null)" style="margin-top:1rem">+ Créer le premier élément</button></p></div>';return;}if(!filtered.length){c.innerHTML='<div class="empty-state"><div class="empty-icon">🔍</div><p>Aucun résultat pour cette recherche.</p></div>';return;}var fields=moduleConfig.fields||[];var displayCols=fields.filter(function(f){return!['textarea','json'].includes(f.type)&&f.name!=='admin_notes'&&f.name!=='description'&&f.name!=='details'&&f.name!=='message';}).slice(0,5);var html='<div class="table-wrap"><table><thead><tr>';var hasImg=fields.find(function(f){return f.type==='image';});if(hasImg)html+='<th style="width:60px"></th>';displayCols.forEach(function(f){html+='<th>'+esc(prettyName(f.name))+'</th>';});html+='<th style="text-align:right;width:1%">Actions</th></tr></thead><tbody>';filtered.forEach(function(it){html+='<tr>';if(hasImg){var url=it[hasImg.name]||it.image_url||it.after_image_url;html+='<td>'+(url?'<img class="thumb" src="'+esc(url)+'" alt="">':'<div class="thumb" style="display:flex;align-items:center;justify-content:center;color:#cbd5e1">—</div>')+'</td>';}displayCols.forEach(function(f){var v=it[f.name];var cell='';if(f.type==='boolean'){cell=(v==1||v===true||v==='true')?'<span style="color:#16a34a">✓ Oui</span>':'<span style="color:#94a3b8">— Non</span>';}else if(f.name==='status'){cell=badge(v);}else if(f.type==='color'){cell='<span class="color-swatch" style="background:'+esc(v||'#22c55e')+'"></span>'+esc(v||'');}else if(f.type==='select'&&f.name==='icon'){cell=(iconMap[v]||'')+' '+esc(v||'');}else if(f.name==='rating'){cell='';for(var i=0;i<(parseInt(v)||0);i++)cell+='⭐';}else if(typeof v==='string'&&v.length>60){cell=esc(v.substring(0,60))+'…';}else{cell=esc(v||'');}html+='<td>'+cell+'</td>';});html+='<td><div class="row-actions"><button class="btn btn-sm btn-secondary" onclick="openEditor('+it.id+')" title="Éditer">✏️</button><button class="btn btn-sm btn-danger" onclick="deleteItem('+it.id+')" title="Supprimer">🗑</button></div></td></tr>';});html+='</tbody></table></div>';c.innerHTML=html;}
function prettyName(n){var m={author:'Auteur',role:'Rôle',content:'Contenu',rating:'Note',name:'Nom',title:'Titre',description:'Description',category:'Catégorie',color:'Couleur',icon:'Icône',display_order:'Ordre',active:'Actif',published:'Publié',short_description:'Description courte',image_url:'Image',before_image_url:'Avant',after_image_url:'Après',email:'Courriel',phone:'Téléphone',service_type:'Service',contact_method:'Méthode',address:'Adresse',status:'État',appointment_date:'Date',appointment_time:'Heure',excerpt:'Extrait'};return m[n]||n.replace(/_/g,' ');}
function openEditor(id){editing=id?items.find(function(i){return i.id==id;}):{};document.getElementById('modalTitle').textContent=id?'✏️ Éditer'+(editing.name||editing.title||editing.author?' — '+(editing.name||editing.title||editing.author):''):'+ Ajouter';document.getElementById('deleteFromModalBtn').style.display=id?'inline-flex':'none';var fc=document.getElementById('formFields');var html='';(moduleConfig.fields||[]).forEach(function(f){var v=editing[f.name];if(v==null||v==='')v=f.default==null?'':f.default;var input='';var name=f.name;var label=prettyName(name);if(f.readonly){var disp=v;if(name==='message'||name==='details')disp='<div style="background:#f8fafc;padding:.75rem;border-radius:.4rem;border:1px solid #e2e8f0;white-space:pre-wrap;font-size:.9rem;color:#334155">'+esc(v||'—')+'</div>';else disp='<input type="text" class="form-control" value="'+esc(v)+'" readonly>';if(name==='phone'&&v)disp='<div style="display:flex;gap:.5rem"><input type="text" class="form-control" value="'+esc(v)+'" readonly><a href="tel:'+esc(v)+'" class="btn btn-secondary btn-sm" style="flex-shrink:0">📞</a></div>';if(name==='email'&&v)disp='<div style="display:flex;gap:.5rem"><input type="text" class="form-control" value="'+esc(v)+'" readonly><a href="mailto:'+esc(v)+'" class="btn btn-secondary btn-sm" style="flex-shrink:0">✉️</a></div>';input=disp;}else if(f.type==='textarea'){input='<textarea name="'+name+'" class="form-control" placeholder="'+esc(f.placeholder||'')+'">'+esc(v)+'</textarea>';}else if(f.type==='boolean'){var checked=(v==1||v===true||v==='true');input='<select name="'+name+'" class="form-control"><option value="1"'+(checked?' selected':'')+'>✓ Oui</option><option value="0"'+(checked?'':' selected')+'>— Non</option></select>';}else if(f.type==='select'){input='<select name="'+name+'" class="form-control">';if(!f.required)input+='<option value="">— Choisir —</option>';(f.options||[]).forEach(function(o){var lbl=name==='icon'?(iconMap[o]||'')+' '+o:o;input+='<option value="'+esc(o)+'"'+(v==o?' selected':'')+'>'+esc(lbl)+'</option>';});input+='</select>';}else if(f.type==='image'){input='<input type="url" name="'+name+'" class="form-control" value="'+esc(v)+'" placeholder="https://..." oninput="updateImgPreview(this)"><div class="image-preview">'+(v?'<img src="'+esc(v)+'" alt="">':'<div class="thumb" style="width:100px;height:80px;display:flex;align-items:center;justify-content:center;color:#cbd5e1">—</div>')+'<div class="image-actions"><button type="button" class="btn btn-sm btn-secondary" onclick="genImg(\''+name+'\',this)">✨ Générer (IA)</button></div></div>';}else if(f.type==='number'){input='<input type="number" name="'+name+'" class="form-control" value="'+esc(v)+'"'+(f.min!=null?' min="'+f.min+'"':'')+(f.max!=null?' max="'+f.max+'"':'')+(f.step!=null?' step="'+f.step+'"':'')+'>';}else if(f.type==='color'){input='<div class="color-preview-row"><input type="color" name="'+name+'" class="form-control" value="'+esc(v||'#22c55e')+'" style="width:80px;flex-shrink:0"><input type="text" class="form-control" value="'+esc(v||'#22c55e')+'" oninput="this.previousElementSibling.value=this.value" placeholder="#22c55e"></div>';}else if(f.type==='date'){input='<input type="date" name="'+name+'" class="form-control" value="'+esc(v?String(v).split('T')[0]:'')+'">';}else{input='<input type="'+(f.type==='email'?'email':'text')+'" name="'+name+'" class="form-control" value="'+esc(v)+'" placeholder="'+esc(f.placeholder||'')+'"'+(f.maxLength?' maxlength="'+f.maxLength+'"':'')+(f.required?' required':'')+'>';}html+='<div class="form-group"><label>'+esc(label)+(f.required?' <span class="req">*</span>':'')+(f.readonly?' <small style="display:inline;color:var(--admin-muted)">(lecture seule)</small>':'')+'</label>'+input+(f.description?'<small>'+esc(f.description)+'</small>':'')+'</div>';});fc.innerHTML=html;document.getElementById('modalBg').style.display='flex';setTimeout(function(){var first=fc.querySelector('input:not([readonly]),textarea:not([readonly]),select');if(first)first.focus();},100);}
function updateImgPreview(input){var p=input.parentElement.querySelector('.image-preview');if(!p)return;var img=p.querySelector('img');if(input.value){if(img){img.src=input.value;}else{var n=document.createElement('img');n.src=input.value;p.insertBefore(n,p.firstChild);}}}
function closeEditor(){document.getElementById('modalBg').style.display='none';editing=null;}
function genImg(fname,btn){var p=prompt('Décrivez l\'image souhaitée :');if(!p)return;btn.disabled=true;var orig=btn.textContent;btn.textContent='⏳ Génération...';fetch('api/admin/generate-image',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({prompt:p,aspectRatio:'4:3'})}).then(function(r){return r.json();}).then(function(d){if(d.imageUrl){var inp=document.querySelector('[name="'+fname+'"]');if(inp){inp.value=d.imageUrl;updateImgPreview(inp);}toast('Image générée','success');}else{toast(d.error||'Erreur','error');}btn.disabled=false;btn.textContent=orig;}).catch(function(){toast('Erreur réseau','error');btn.disabled=false;btn.textContent=orig;});}
document.getElementById('editForm').addEventListener('submit',function(e){e.preventDefault();var fd=new FormData(e.target);var data={};fd.forEach(function(v,k){if(v==='1')data[k]=1;else if(v==='0')data[k]=0;else data[k]=v;});var url='api/admin/'+moduleKey+(editing&&editing.id?'/'+editing.id:'');var method=editing&&editing.id?'PUT':'POST';var btn=document.getElementById('saveBtn');btn.disabled=true;var oldText=btn.textContent;btn.textContent='⏳ Enregistrement...';fetch(url,{method:method,headers:{'Content-Type':'application/json'},body:JSON.stringify(data)}).then(function(r){return r.json().then(function(j){return{ok:r.ok,j:j};});}).then(function(res){if(res.ok){toast('Enregistré ✓','success');closeEditor();loadItems();}else{toast((res.j&&res.j.error)||'Erreur','error');}btn.disabled=false;btn.textContent=oldText;}).catch(function(){toast('Erreur réseau','error');btn.disabled=false;btn.textContent=oldText;});});
function deleteFromModal(){if(editing&&editing.id){deleteItem(editing.id);}}
function deleteItem(id){if(!confirm('Supprimer cet élément définitivement?'))return;fetch('api/admin/'+moduleKey+'/'+id,{method:'DELETE'}).then(function(r){return r.json();}).then(function(){toast('Supprimé','success');closeEditor();loadItems();}).catch(function(){toast('Erreur','error');});}
document.getElementById('searchInput').addEventListener('input',applyFilters);
(function(){var t=document.getElementById('sidebarToggle');var s=document.getElementById('adminSidebar');var o=document.getElementById('sidebarOverlay');if(t&&s&&o){t.addEventListener('click',function(){s.classList.toggle('open');o.classList.toggle('show');});o.addEventListener('click',function(){s.classList.remove('open');o.classList.remove('show');});}document.addEventListener('keydown',function(e){if(e.key==='Escape'){closeEditor();}});})();
loadModule().then(loadItems);
</script>
</body>
</html>