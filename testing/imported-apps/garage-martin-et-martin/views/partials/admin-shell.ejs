<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<base href="<%= tenantRoot %>">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#13233f">
<meta name="robots" content="noindex">
<title><%= adminTitle || t.admin %> · <%= settings.business_name %></title>
<link rel="icon" href="<%= img(assets.mark, 'w_64,h_64,c_fill') %>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Playfair+Display:wght@700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="public/css/styles.css">
<link rel="stylesheet" href="public/css/admin.css">
</head>
<body class="admin-body" data-page="admin">
<a class="skip" href="#admin-main"><%= t.skip %></a>
<div class="admin-shell">
  <aside class="admin-sidebar" id="admin-sidebar">
    <a class="admin-brand" href="admin">
      <strong><%= settings.business_name %></strong>
      <span><%= t.admin %></span>
    </a>
    <nav class="admin-nav" aria-label="<%= t.admin %>">
      <a href="admin" <%= adminSection === 'dashboard' ? 'aria-current="page"' : '' %>>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
        <span><%= lang === 'en' ? 'Dashboard' : 'Tableau de bord' %></span>
      </a>
      <a href="admin/rendez-vous" <%= adminSection === 'board' ? 'aria-current="page"' : '' %>>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
        <span><%= lang === 'en' ? 'Appointments' : 'Rendez-vous' %></span>
      </a>
      <% modules.forEach(function (m) { %>
        <a href="admin/<%= m.key %>" <%= adminSection === m.key ? 'aria-current="page"' : '' %>>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/></svg>
          <span><%= m.label %></span>
        </a>
      <% }); %>
      <a href="admin/settings" <%= adminSection === 'settings' ? 'aria-current="page"' : '' %>>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/></svg>
        <span><%= lang === 'en' ? 'Settings' : 'Réglages' %></span>
      </a>
    </nav>
    <div class="admin-sidebar-foot">
      <a href="<%= urls.home %>" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg>
        <span><%= lang === 'en' ? 'View the site' : 'Voir le site' %></span>
      </a>
    </div>
  </aside>

  <div class="admin-main-wrap">
    <header class="admin-topbar">
      <button class="admin-menu-toggle" type="button" aria-label="Menu" data-admin-menu>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
      <h1><%= adminTitle || t.admin %></h1>
      <div class="admin-user"><%= adminUser.name %></div>
    </header>
    <main class="admin-main" id="admin-main">
