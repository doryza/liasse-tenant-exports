<%- include('partials/admin-shell', { adminSection: module.key, adminTitle: module.label }) %>

<section class="admin-card">
  <div class="admin-card-head">
    <div>
      <h2><%= module.label %></h2>
      <p class="muted small" style="margin:6px 0 0"><%= module.description %></p>
    </div>
    <% if (['services','hours','closures','messages'].indexOf(module.key) > -1) { %>
      <button class="button primary small" type="button" data-new>+ <%= lang === 'en' ? 'New' : 'Ajouter' %></button>
    <% } %>
  </div>

  <div class="admin-toolbar">
    <label class="sr-only" for="admin-filter"><%= lang === 'en' ? 'Filter' : 'Filtrer' %></label>
    <input id="admin-filter" type="search" data-filter placeholder="<%= lang === 'en' ? 'Filter…' : 'Filtrer…' %>">
    <span class="muted small" data-result-count></span>
  </div>

  <div class="table-scroll">
    <table class="data" data-table
      data-module="<%= module.key %>"
      data-singular="<%= module.singular %>"
      data-fields="<%= fieldsJson %>">
      <thead data-head></thead>
      <tbody data-rows></tbody>
    </table>
  </div>
  <p class="empty" data-empty hidden><%= lang === 'en' ? 'Nothing here yet.' : 'Rien ici pour l’instant.' %></p>
</section>

<dialog class="admin-modal" data-modal>
  <form method="dialog" data-form>
    <header>
      <h2 data-modal-title></h2>
      <button class="icon-button" type="button" data-close aria-label="<%= t.close %>">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </header>
    <div class="admin-modal-body" data-fields></div>
    <footer>
      <p class="small" data-form-error role="alert" hidden></p>
      <button class="button ghost small" type="button" data-close><%= lang === 'en' ? 'Cancel' : 'Annuler' %></button>
      <button class="button primary small" type="submit"><%= t.save %></button>
    </footer>
  </form>
</dialog>

<script id="admin-items" type="application/json"><%- safeJSON(items) %></script>

<%- include('partials/admin-footer') %>
