<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Admin — Échanger un code</title>
<link rel="stylesheet" href="public/css/admin-styles.css">
<style>
.redeem-wrap { max-width: 760px; }
.redeem-card { background: #fff; border-radius: 14px; padding: 1.5rem; box-shadow: 0 2px 8px rgba(0,0,0,0.05); margin-bottom: 1.25rem; }
.redeem-card h2 { margin: 0 0 0.85rem; font-size: 1.15rem; }
.code-input-row { display: flex; gap: 0.6rem; }
.code-input-row input { flex: 1; font-family: 'SFMono-Regular','Menlo',Consolas,monospace; font-size: 1.5rem; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase; padding: 0.75rem 1rem; border: 2px solid #e2e8f0; border-radius: 10px; }
.code-input-row input:focus { outline: none; border-color: #39FF14; box-shadow: 0 0 0 4px rgba(57,255,20,0.15); }
.code-input-row button { white-space: nowrap; }
.result-empty { color: #718096; padding: 1.5rem; text-align: center; }
.result-box { padding: 1rem 0; }
.result-row { display: flex; justify-content: space-between; padding: 0.55rem 0; border-bottom: 1px solid #edf2f7; gap: 1rem; }
.result-row:last-child { border-bottom: 0; }
.result-row .lbl { color: #718096; font-size: 0.88rem; }
.result-row .val { font-weight: 600; text-align: right; }
.code-display { font-family: monospace; font-size: 1.2rem; letter-spacing: 0.15em; }
.banner { padding: 0.85rem 1.1rem; border-radius: 10px; margin-bottom: 1rem; font-weight: 600; }
.banner-ok { background: #e8fff0; color: #0a6e2e; border: 1px solid #b7f5cb; }
.banner-warn { background: #fff7e0; color: #92500a; border: 1px solid #f7d889; }
.banner-err { background: #ffeaea; color: #8a1a1a; border: 1px solid #f8b3b3; }
.btn-redeem { background: #39FF14; color: #000; padding: 0.95rem 1.5rem; font-weight: 800; font-size: 1.05rem; border-radius: 10px; border: 0; cursor: pointer; width: 100%; margin-top: 0.5rem; }
.btn-redeem:hover { background: #5cff44; }
.btn-redeem:disabled { background: #cbd5e0; color: #4a5568; cursor: not-allowed; }
.recent-list { width: 100%; border-collapse: collapse; }
.recent-list th, .recent-list td { padding: 0.55rem 0.5rem; text-align: left; border-bottom: 1px solid #edf2f7; font-size: 0.88rem; }
.recent-list th { color: #4a5568; font-weight: 700; background: #f7fafc; }
.recent-empty { color: #a0aec0; padding: 1rem 0; font-style: italic; font-size: 0.9rem; }
</style>
</head>
<body>
<div class="admin-layout">
<%- include('partials/admin-sidebar', { page: 'redeem' }) %>
<main class="admin-main">
<div class="admin-header">
  <div>
    <h1>Échanger un code</h1>
    <p style="margin:0.25rem 0 0;color:#718096;font-size:0.9rem">Entrez le code de 8 caractères que le client présente au comptoir.</p>
  </div>
</div>

<div class="redeem-wrap">
  <div class="redeem-card">
    <h2>🔎 Rechercher un code</h2>
    <div class="code-input-row">
      <input type="text" id="codeInput" maxlength="8" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="ex. B7XK9P2M">
      <button class="btn btn-primary" id="lookupBtn" style="background-color:#39FF14;color:#000">Vérifier</button>
    </div>
    <div id="resultArea" class="result-empty">Aucune recherche pour l'instant.</div>
  </div>

  <div class="redeem-card">
    <h2>🕓 Codes récents</h2>
    <div id="recentArea"><p class="recent-empty">Chargement…</p></div>
  </div>
</div>

</main>
</div>
<div class="toast" id="toast"></div>
<script>
function esc(s) { if (s == null) return ''; return String(s).replace(/[&<>"']/g, function(c){ return ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' })[c]; }); }
function toast(msg, type) { var t = document.getElementById('toast'); t.className = 'toast toast-' + (type || 'success'); t.textContent = msg; setTimeout(function(){ t.classList.add('show'); }, 10); setTimeout(function(){ t.classList.remove('show'); }, 2800); }
function fmtDateTime(s) { if (!s) return '—'; try { return new Date(s).toLocaleString('fr-CA', { year:'numeric', month:'short', day:'numeric', hour:'2-digit', minute:'2-digit' }); } catch(e) { return s; } }

function statusLabel(s) {
  if (s === 'claimed') return '<span class="badge badge-warn">Réservé</span>';
  if (s === 'redeemed') return '<span class="badge badge-success">Utilisé</span>';
  if (s === 'expired') return '<span class="badge badge-muted">Expiré</span>';
  return '<span class="badge badge-muted">' + esc(s || '—') + '</span>';
}

function userLabel(u) {
  if (!u) return '—';
  if (u.display_name) return esc(u.display_name);
  if (u.email) return esc(u.email);
  if (u.phone) return esc(u.phone);
  return '—';
}

function errorBanner(err) {
  if (err === 'not_found') return '<div class="banner banner-err">⚠️ Code introuvable. Vérifiez la saisie.</div>';
  if (err === 'expired') return '<div class="banner banner-err">⚠️ Cette offre est expirée.</div>';
  if (err === 'offer_inactive') return '<div class="banner banner-err">⚠️ Cette offre n\'est plus active.</div>';
  if (err === 'already_redeemed') return '<div class="banner banner-warn">⚠️ Ce code a déjà été utilisé.</div>';
  return '<div class="banner banner-err">Erreur: ' + esc(err || 'inconnue') + '</div>';
}

function renderClaim(c, banner) {
  if (!c) return '';
  var title = c.title_fr || c.title_en || ('Offre #' + c.offer_id);
  var html = '';
  if (banner) html += banner;
  html += '<div class="result-box">';
  html += '<div class="result-row"><div class="lbl">Code</div><div class="val code-display">' + esc(c.short_code) + '</div></div>';
  html += '<div class="result-row"><div class="lbl">Offre</div><div class="val">' + esc(title) + (c.discount_label ? ' <span style="color:#39FF14">(' + esc(c.discount_label) + ')</span>' : '') + '</div></div>';
  html += '<div class="result-row"><div class="lbl">Client</div><div class="val">' + userLabel(c._user) + '</div></div>';
  html += '<div class="result-row"><div class="lbl">Réservé le</div><div class="val">' + fmtDateTime(c.claimed_at) + '</div></div>';
  html += '<div class="result-row"><div class="lbl">Expire le</div><div class="val">' + fmtDateTime(c.offer_expires_at) + '</div></div>';
  html += '<div class="result-row"><div class="lbl">Statut</div><div class="val">' + statusLabel(c.status) + '</div></div>';
  if (c.status === 'redeemed') {
    html += '<div class="result-row"><div class="lbl">Utilisé le</div><div class="val">' + fmtDateTime(c.redeemed_at) + '</div></div>';
  }
  html += '</div>';
  if (c.status === 'claimed' && c.offer_active != 0 && new Date(c.offer_expires_at) > new Date()) {
    html += '<button class="btn-redeem" id="redeemBtn" data-id="' + c.id + '" data-code="' + esc(c.short_code) + '">✓ Valider et marquer comme utilisé</button>';
  }
  return html;
}

async function lookupCode() {
  var input = document.getElementById('codeInput');
  var code = (input.value || '').trim().toUpperCase();
  if (!code) { toast('Entrez un code', 'error'); input.focus(); return; }
  document.getElementById('resultArea').innerHTML = '<div class="result-empty">⏳ Recherche…</div>';
  try {
    var r = await fetch('api/admin/offer_claims/lookup', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ short_code: code }) });
    var data = await r.json().catch(function(){ return {}; });
    if (r.status === 404) {
      document.getElementById('resultArea').innerHTML = errorBanner('not_found');
      return;
    }
    if (!r.ok || !data.claim) {
      document.getElementById('resultArea').innerHTML = errorBanner(data.error || 'unknown');
      return;
    }
    document.getElementById('resultArea').innerHTML = renderClaim(data.claim);
  } catch(e) {
    document.getElementById('resultArea').innerHTML = errorBanner('network');
  }
}

async function redeemClaim(code) {
  var btn = document.getElementById('redeemBtn');
  if (btn) { btn.disabled = true; btn.textContent = '⏳ Validation…'; }
  try {
    var r = await fetch('api/admin/offer_claims/redeem', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ short_code: code }) });
    var data = await r.json().catch(function(){ return {}; });
    if (r.ok && data.success) {
      toast('Code validé!', 'success');
      document.getElementById('resultArea').innerHTML = renderClaim(data.claim, '<div class="banner banner-ok">✅ Code validé avec succès. Servez le client.</div>');
      loadRecent();
    } else {
      // Re-render with the latest claim (server returns updated state on conflict)
      var banner = errorBanner(data.error || 'unknown');
      if (data.claim) document.getElementById('resultArea').innerHTML = renderClaim(data.claim, banner);
      else document.getElementById('resultArea').innerHTML = banner;
    }
  } catch(e) {
    toast('Erreur réseau', 'error');
    if (btn) { btn.disabled = false; btn.textContent = '✓ Valider et marquer comme utilisé'; }
  }
}

async function loadRecent() {
  try {
    var r = await fetch('api/admin/offer_claims');
    var data = await r.json();
    var rows = (data.claims || []).slice(0, 20);
    var el = document.getElementById('recentArea');
    if (!rows.length) { el.innerHTML = '<p class="recent-empty">Aucun code pour l\'instant.</p>'; return; }
    var html = '<table class="recent-list"><thead><tr><th>Code</th><th>Offre</th><th>Client</th><th>Statut</th><th>Réservé</th></tr></thead><tbody>';
    rows.forEach(function(c){
      var title = c.title_fr || c.title_en || ('#' + c.offer_id);
      html += '<tr>';
      html += '<td class="code-display"><a href="#" data-recent-code="' + esc(c.short_code) + '" style="color:#1a73e8;text-decoration:none">' + esc(c.short_code) + '</a></td>';
      html += '<td>' + esc(title) + '</td>';
      html += '<td>' + userLabel(c._user) + '</td>';
      html += '<td>' + statusLabel(c.status) + '</td>';
      html += '<td>' + fmtDateTime(c.claimed_at) + '</td>';
      html += '</tr>';
    });
    html += '</tbody></table>';
    el.innerHTML = html;
  } catch(e) { document.getElementById('recentArea').innerHTML = '<p class="recent-empty">Erreur de chargement.</p>'; }
}

document.getElementById('codeInput').addEventListener('input', function(e){ e.target.value = e.target.value.toUpperCase().replace(/[^A-Z0-9]/g,''); });
document.getElementById('codeInput').addEventListener('keydown', function(e){ if (e.key === 'Enter') { e.preventDefault(); lookupCode(); } });
document.getElementById('lookupBtn').addEventListener('click', lookupCode);
document.addEventListener('click', function(e){
  var redeemBtn = e.target.closest('#redeemBtn');
  if (redeemBtn) { e.preventDefault(); redeemClaim(redeemBtn.getAttribute('data-code')); return; }
  var recent = e.target.closest('[data-recent-code]');
  if (recent) {
    e.preventDefault();
    var c = recent.getAttribute('data-recent-code');
    document.getElementById('codeInput').value = c;
    lookupCode();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
});

document.getElementById('codeInput').focus();
loadRecent();
</script>
</body>
</html>
