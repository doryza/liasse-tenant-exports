<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Admin — <%= title %></title>
<link rel="stylesheet" href="public/css/admin-styles.css">
</head>
<body>
<div class="admin-layout">
<%- include('admin-sidebar', { page: page }) %>
<main class="admin-main">
<div class="admin-header">
  <div>
    <h1><%= title %></h1>
    <p style="margin:0.25rem 0 0;color:#718096;font-size:0.9rem" id="countLabel"></p>
  </div>
  <button class="btn btn-primary" onclick="openModal()" style="background-color:#39FF14;color:#000">+ Ajouter</button>
</div>
<div class="toolbar">
  <input type="text" id="searchInput" placeholder="🔍 Rechercher…" oninput="renderList()">
  <select id="statusFilter" onchange="renderList()" style="display:none">
    <option value="">Tous les statuts</option>
    <option value="pending">En attente</option>
    <option value="confirmed">Confirmé</option>
    <option value="declined">Refusé</option>
    <option value="completed">Complété</option>
  </select>
</div>
<div class="card">
  <div id="listContainer"><p class="empty"><span class="emoji">⏳</span>Chargement…</p></div>
</div>
</main>
</div>
<div class="modal-overlay" id="modal" onclick="if(event.target===this)closeModal()">
  <div class="modal">
    <h2 id="modalTitle">Ajouter</h2>
    <form id="itemForm">
      <div id="formFields"></div>
      <div class="form-actions">
        <button type="button" class="btn btn-secondary" onclick="closeModal()">Annuler</button>
        <button type="submit" class="btn btn-primary" id="saveBtn" style="background-color:#39FF14;color:#000">Enregistrer</button>
      </div>
    </form>
  </div>
</div>
<div class="toast" id="toast"></div>
<script>
var MODULE_KEY = '<%- moduleKey %>';
var items = [];
var fields = [];
var editingId = null;
var dynamicSources = {}; // sourceKey -> array of rows

function esc(s) { if (s == null) return ''; return String(s).replace(/[&<>"']/g, function(c){ return ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' })[c]; }); }
function labelFor(f) { return f.label || f.name; }

function toast(msg, type) {
  var t = document.getElementById('toast');
  t.className = 'toast toast-' + (type || 'success');
  t.textContent = msg;
  setTimeout(function(){ t.classList.add('show'); }, 10);
  setTimeout(function(){ t.classList.remove('show'); }, 2800);
}

function statusBadge(status) {
  var cls = 'muted', label = status || '—';
  if (status === 'confirmed') { cls = 'success'; label = 'Confirmé'; }
  else if (status === 'pending') { cls = 'warn'; label = 'En attente'; }
  else if (status === 'declined') { cls = 'danger'; label = 'Refusé'; }
  else if (status === 'completed') { cls = 'muted'; label = 'Complété'; }
  return '<span class="badge badge-' + cls + '">' + esc(label) + '</span>';
}

async function loadModule() {
  try {
    var r = await fetch('api/admin/modules');
    var data = await r.json();
    var m = (data.modules || []).find(function(x){ return x.key === MODULE_KEY; });
    if (m) fields = m.fields;
    if (MODULE_KEY === 'reservations') document.getElementById('statusFilter').style.display = '';
    // Pre-fetch select_dynamic sources
    var sources = [];
    fields.forEach(function(f){ if (f.type === 'select_dynamic' && f.source && sources.indexOf(f.source) === -1) sources.push(f.source); });
    await Promise.all(sources.map(async function(src){
      try {
        var rr = await fetch('api/admin/' + src);
        var dd = await rr.json();
        dynamicSources[src] = dd[src] || [];
      } catch(e) { dynamicSources[src] = []; }
    }));
    await loadItems();
  } catch(e) { document.getElementById('listContainer').innerHTML = '<p class="empty"><span class="emoji">⚠️</span>Erreur de chargement</p>'; }
}

async function loadItems() {
  try {
    var r = await fetch('api/admin/' + MODULE_KEY);
    var data = await r.json();
    items = data[MODULE_KEY] || [];
    renderList();
  } catch(e) { document.getElementById('listContainer').innerHTML = '<p class="empty"><span class="emoji">⚠️</span>Erreur de chargement</p>'; }
}

function matchesSearch(it, q) {
  if (!q) return true;
  q = q.toLowerCase();
  for (var k in it) {
    var v = it[k];
    if (v != null && String(v).toLowerCase().indexOf(q) !== -1) return true;
  }
  return false;
}

function renderList() {
  var c = document.getElementById('listContainer');
  var countLabel = document.getElementById('countLabel');
  var q = (document.getElementById('searchInput') || {}).value || '';
  var statusFilter = (document.getElementById('statusFilter') || {}).value || '';
  var filtered = items.filter(function(it){
    if (statusFilter && it.status !== statusFilter) return false;
    return matchesSearch(it, q);
  });
  countLabel.textContent = filtered.length + ' / ' + items.length + ' élément' + (items.length>1?'s':'');
  if (!items.length) {
    c.innerHTML = '<p class="empty"><span class="emoji">📭</span>Aucun élément pour l\'instant.<br><span style="font-size:0.85rem;color:#a0aec0">Cliquez sur <strong>+ Ajouter</strong> pour commencer.</span></p>';
    return;
  }
  if (!filtered.length) { c.innerHTML = '<p class="empty"><span class="emoji">🔍</span>Aucun résultat pour cette recherche.</p>'; return; }
  var displayFields = fields.filter(function(f){ return f.name !== 'message' && f.type !== 'textarea' || f.name === 'content'; }).slice(0, 5);
  if (MODULE_KEY === 'reservations') displayFields = fields.filter(function(f){ return ['event_date','contact_name','event_type','guests','status'].indexOf(f.name) !== -1; });
  else if (MODULE_KEY === 'menu_items') displayFields = fields.filter(function(f){ return ['image_url','name_fr','price','category','available'].indexOf(f.name) !== -1; });
  else if (MODULE_KEY === 'delivery_platforms') displayFields = fields.filter(function(f){ return ['logo_url','name','link_url','active'].indexOf(f.name) !== -1; });
  else if (MODULE_KEY === 'posts') displayFields = fields.filter(function(f){ return ['image_url','title','category','published'].indexOf(f.name) !== -1; });
  else if (MODULE_KEY === 'offers') displayFields = fields.filter(function(f){ return ['image_url','title_fr','discount_label','expires_at','active'].indexOf(f.name) !== -1; });
  else if (MODULE_KEY === 'menu_categories') displayFields = fields.filter(function(f){ return ['position','name_fr','name_en','slug','active'].indexOf(f.name) !== -1; });

  var html = '<div style="overflow-x:auto"><table><thead><tr>';
  displayFields.forEach(function(f){ html += '<th>' + esc(labelFor(f)) + '</th>'; });
  html += '<th style="text-align:right">Actions</th></tr></thead><tbody>';
  filtered.forEach(function(it){
    html += '<tr>';
    displayFields.forEach(function(f){
      var v = it[f.name];
      if (f.type === 'image' && v) html += '<td><img src="' + esc(v) + '" alt=""></td>';
      else if (f.type === 'image') html += '<td><div style="width:48px;height:48px;background:#e2e8f0;border-radius:6px;display:flex;align-items:center;justify-content:center;color:#a0aec0">—</div></td>';
      else if (f.name === 'status') html += '<td>' + statusBadge(v) + '</td>';
      else if (f.type === 'boolean') html += '<td>' + (v && v != '0' ? '<span class="badge badge-success">✓</span>' : '<span class="badge badge-muted">—</span>') + '</td>';
      else if (f.type === 'date' && v) html += '<td>' + esc(String(v).substring(0,10)) + '</td>';
      else if (f.type === 'datetime' && v) html += '<td>' + esc(String(v).replace('T',' ').substring(0,16)) + '</td>';
      else if (f.name === 'price' && v != null) html += '<td><strong>' + esc(Number(v).toFixed(2)) + ' $</strong></td>';
      else if (f.name === 'link_url' && v) html += '<td><a href="' + esc(v) + '" target="_blank" style="color:#16a34a">🔗 Lien</a></td>';
      else if (v != null && String(v).length > 60) html += '<td>' + esc(String(v).substring(0,60)) + '…</td>';
      else html += '<td>' + esc(v == null ? '—' : String(v)) + '</td>';
    });
    html += '<td class="row-actions" style="text-align:right">';
    if (MODULE_KEY === 'reservations' && it.status === 'pending') {
      html += '<button class="btn btn-sm btn-primary" onclick="setStatus(' + it.id + ',\'confirmed\')" style="background-color:#16a34a;color:#fff" title="Confirmer">✓</button>';
    }
    html += '<button class="btn btn-sm btn-secondary" onclick="editItem(' + it.id + ')" title="Modifier">✏️</button>';
    html += '<button class="btn btn-sm btn-danger" onclick="deleteItem(' + it.id + ')" title="Supprimer">🗑️</button>';
    html += '</td>';
    html += '</tr>';
  });
  html += '</tbody></table></div>';
  c.innerHTML = html;
}

function buildFormFields(item) {
  var html = '';
  fields.forEach(function(f){
    var v = item ? (item[f.name] == null ? '' : item[f.name]) : (f.default !== undefined ? f.default : '');
    var id = 'fld_' + f.name;
    var req = f.required ? ' required' : '';
    var reqStar = f.required ? ' <span style="color:#e53e3e">*</span>' : '';
    html += '<div class="form-group"><label for="' + id + '">' + esc(labelFor(f)) + reqStar + '</label>';
    if (f.type === 'textarea') {
      html += '<textarea id="' + id + '" class="form-control"' + req + ' placeholder="' + esc(f.placeholder || '') + '">' + esc(v) + '</textarea>';
    } else if (f.type === 'boolean') {
      html += '<div class="field-checkbox"><input type="checkbox" id="' + id + '"' + (v && v != '0' ? ' checked' : '') + '><span class="help-text" style="margin:0">' + esc(f.description || '') + '</span></div>';
      html += '</div>';
      return;
    } else if (f.type === 'select') {
      html += '<select id="' + id + '" class="form-control">';
      (f.options || []).forEach(function(o){ html += '<option value="' + esc(o) + '"' + (String(v) === String(o) ? ' selected' : '') + '>' + esc(o) + '</option>'; });
      html += '</select>';
    } else if (f.type === 'select_dynamic') {
      var rows = dynamicSources[f.source] || [];
      var valueField = f.valueField || 'slug';
      var labelField = f.labelField || 'name_fr';
      var editable = !!f.editable;
      html += '<div class="select-dynamic-wrap" data-source="' + esc(f.source) + '" data-field-id="' + id + '" data-value-field="' + esc(valueField) + '" data-label-field="' + esc(labelField) + '" style="display:flex;gap:0.4rem;align-items:stretch;flex-wrap:wrap">';
      html += '<select id="' + id + '" class="form-control"' + req + ' style="flex:1;min-width:160px">';
      html += '<option value="">' + (f.required ? '— Choisir —' : '— Aucune —') + '</option>';
      rows.forEach(function(row){
        var optVal = row[valueField] == null ? '' : String(row[valueField]);
        var optLabel = row[labelField] || row[valueField] || ('#' + row.id);
        html += '<option value="' + esc(optVal) + '" data-id="' + esc(row.id) + '" data-name-fr="' + esc(row.name_fr || '') + '" data-name-en="' + esc(row.name_en || '') + '"' + (String(v) === optVal ? ' selected' : '') + '>' + esc(optLabel) + '</option>';
      });
      html += '</select>';
      if (editable) {
        html += '<button type="button" class="btn btn-sm btn-secondary" onclick="dynRename(\'' + id + '\')" title="Renommer la catégorie sélectionnée">✏️</button>';
        html += '<button type="button" class="btn btn-sm btn-secondary" onclick="dynCreate(\'' + id + '\')" title="Créer une nouvelle catégorie" style="background:#39FF14;color:#000">+ Nouvelle</button>';
      }
      html += '</div>';
      if (editable) html += '<div id="' + id + '_inline" style="display:none;margin-top:0.5rem;padding:0.75rem;background:#f7fafc;border:1px solid #e2e8f0;border-radius:8px"></div>';
      if (rows.length === 0 && !editable) html += '<div class="help-text" style="color:#e53e3e">Aucune entrée disponible.</div>';
    } else if (f.type === 'size_list') {
      var sizes = [];
      try { sizes = v ? (typeof v === 'string' ? JSON.parse(v) : v) : []; } catch(_) { sizes = []; }
      if (!Array.isArray(sizes)) sizes = [];
      html += '<div class="size-list" data-field-id="' + id + '">';
      html += '<div class="size-list-rows" id="' + id + '_rows"></div>';
      html += '<button type="button" class="btn btn-sm btn-secondary" onclick="addSizeRow(\'' + id + '\')" style="margin-top:0.4rem">+ Ajouter une taille</button>';
      html += '</div>';
      // Stash initial rows for render after DOM insertion
      window._pendingSizeInit = window._pendingSizeInit || {};
      window._pendingSizeInit[id] = sizes;
    } else if (f.type === 'image') {
      html += '<input type="text" id="' + id + '" class="form-control" placeholder="URL de l\'image" value="' + esc(v) + '" oninput="refreshPreview(\'' + id + '\')">';
      html += '<input type="file" accept="image/*" onchange="uploadImage(this, \'' + id + '\')" style="margin-top:0.5rem;font-size:0.85rem">';
      html += '<div id="' + id + '_preview">' + (v ? '<img src="' + esc(v) + '" class="img-preview">' : '') + '</div>';
    } else if (f.type === 'date') {
      var dv = v ? String(v).substring(0,10) : '';
      html += '<input type="date" id="' + id + '" class="form-control"' + req + ' value="' + esc(dv) + '">';
    } else if (f.type === 'datetime') {
      var dtv = '';
      if (v) {
        var s = String(v);
        // Accept both "YYYY-MM-DDTHH:MM[:SS][.fff][Z|+/-HH:MM]" and "YYYY-MM-DD HH:MM..."
        dtv = s.replace(' ', 'T').substring(0, 16);
      }
      html += '<input type="datetime-local" id="' + id + '" class="form-control"' + req + ' value="' + esc(dtv) + '">';
    } else if (f.type === 'number') {
      var step = f.step != null ? f.step : '1';
      var mn = f.min != null ? ' min="' + f.min + '"' : '';
      html += '<input type="number" id="' + id + '" class="form-control"' + req + ' value="' + esc(v) + '" step="' + step + '"' + mn + ' placeholder="' + esc(f.placeholder || '') + '">';
    } else if (f.type === 'email') {
      html += '<input type="email" id="' + id + '" class="form-control"' + req + ' value="' + esc(v) + '">';
    } else if (f.type === 'url') {
      html += '<input type="url" id="' + id + '" class="form-control"' + req + ' value="' + esc(v) + '" placeholder="' + esc(f.placeholder || '') + '">';
    } else {
      html += '<input type="text" id="' + id + '" class="form-control"' + req + ' value="' + esc(v) + '" placeholder="' + esc(f.placeholder || '') + '">';
    }
    if (f.description) html += '<div class="help-text">' + esc(f.description) + '</div>';
    html += '</div>';
  });
  return html;
}

function refreshPreview(fieldId) {
  var url = document.getElementById(fieldId).value;
  document.getElementById(fieldId + '_preview').innerHTML = url ? '<img src="' + url.replace(/"/g,'&quot;') + '" class="img-preview">' : '';
}

async function uploadImage(input, fieldId) {
  var file = input.files[0];
  if (!file) return;
  var reader = new FileReader();
  reader.onload = async function() {
    try {
      var r = await fetch('api/admin/upload', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ dataUri: reader.result }) });
      var data = await r.json();
      if (data.url) {
        document.getElementById(fieldId).value = data.url;
        refreshPreview(fieldId);
        toast('Image téléchargée', 'success');
      } else { toast('Erreur: ' + (data.error || 'inconnue'), 'error'); }
    } catch(e) { toast('Erreur de téléchargement', 'error'); }
  };
  reader.readAsDataURL(file);
}

async function dynRefreshSource(source) {
  try {
    var r = await fetch('api/admin/' + source);
    var d = await r.json();
    dynamicSources[source] = d[source] || [];
    return dynamicSources[source];
  } catch(e) { return dynamicSources[source] || []; }
}

function dynRerenderSelect(fieldId, selectedValue) {
  var wrap = document.querySelector('.select-dynamic-wrap[data-field-id="' + fieldId + '"]');
  if (!wrap) return;
  var source = wrap.getAttribute('data-source');
  var valueField = wrap.getAttribute('data-value-field') || 'slug';
  var labelField = wrap.getAttribute('data-label-field') || 'name_fr';
  var rows = dynamicSources[source] || [];
  var sel = document.getElementById(fieldId);
  if (!sel) return;
  var keep = selectedValue != null ? String(selectedValue) : String(sel.value || '');
  var hadEmpty = sel.querySelector('option[value=""]');
  var emptyLabel = hadEmpty ? hadEmpty.textContent : '— Aucune —';
  var html = '<option value="">' + esc(emptyLabel) + '</option>';
  rows.forEach(function(row){
    var optVal = row[valueField] == null ? '' : String(row[valueField]);
    var optLabel = row[labelField] || row[valueField] || ('#' + row.id);
    html += '<option value="' + esc(optVal) + '" data-id="' + esc(row.id) + '" data-name-fr="' + esc(row.name_fr || '') + '" data-name-en="' + esc(row.name_en || '') + '"' + (String(keep) === optVal ? ' selected' : '') + '>' + esc(optLabel) + '</option>';
  });
  sel.innerHTML = html;
}

function dynCloseInline(fieldId) {
  var box = document.getElementById(fieldId + '_inline');
  if (box) { box.style.display = 'none'; box.innerHTML = ''; }
}

function dynShowInline(fieldId, html) {
  var box = document.getElementById(fieldId + '_inline');
  if (box) { box.innerHTML = html; box.style.display = 'block'; }
}

function dynCreate(fieldId) {
  dynShowInline(fieldId,
    '<div style="font-weight:700;font-size:0.92rem;margin-bottom:0.5rem">Nouvelle catégorie</div>' +
    '<div style="display:grid;grid-template-columns:1fr 1fr auto auto;gap:0.4rem;align-items:center">' +
    '<input type="text" id="' + fieldId + '_new_fr" class="form-control" placeholder="Nom (FR)" style="font-size:0.9rem">' +
    '<input type="text" id="' + fieldId + '_new_en" class="form-control" placeholder="Name (EN)" style="font-size:0.9rem">' +
    '<button type="button" class="btn btn-sm btn-primary" onclick="dynSubmitCreate(\'' + fieldId + '\')" style="background-color:#39FF14;color:#000">✓ Créer</button>' +
    '<button type="button" class="btn btn-sm btn-secondary" onclick="dynCloseInline(\'' + fieldId + '\')">×</button>' +
    '</div>'
  );
  var el = document.getElementById(fieldId + '_new_fr');
  if (el) el.focus();
}

async function dynSubmitCreate(fieldId) {
  var wrap = document.querySelector('.select-dynamic-wrap[data-field-id="' + fieldId + '"]');
  if (!wrap) return;
  var source = wrap.getAttribute('data-source');
  var valueField = wrap.getAttribute('data-value-field') || 'slug';
  var nameFr = (document.getElementById(fieldId + '_new_fr').value || '').trim();
  var nameEn = (document.getElementById(fieldId + '_new_en').value || '').trim();
  if (!nameFr) { toast('Nom requis', 'error'); return; }
  try {
    var r = await fetch('api/admin/' + source, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name_fr: nameFr, name_en: nameEn }) });
    var d = await r.json().catch(function(){ return {}; });
    if (!r.ok) { toast('Erreur: ' + (d.error || 'inconnue'), 'error'); return; }
    await dynRefreshSource(source);
    var newVal = d.item && d.item[valueField] ? d.item[valueField] : null;
    dynRerenderSelect(fieldId, newVal);
    dynCloseInline(fieldId);
    toast('Catégorie créée', 'success');
  } catch(e) { toast('Erreur réseau', 'error'); }
}

function dynRename(fieldId) {
  var sel = document.getElementById(fieldId);
  if (!sel || !sel.value) { toast('Choisissez une catégorie à renommer', 'error'); return; }
  var opt = sel.options[sel.selectedIndex];
  var id = opt.getAttribute('data-id');
  var nameFr = opt.getAttribute('data-name-fr') || opt.textContent;
  var nameEn = opt.getAttribute('data-name-en') || '';
  if (!id) { toast('Catégorie introuvable', 'error'); return; }
  dynShowInline(fieldId,
    '<div style="font-weight:700;font-size:0.92rem;margin-bottom:0.5rem">Renommer la catégorie</div>' +
    '<div style="display:grid;grid-template-columns:1fr 1fr auto auto;gap:0.4rem;align-items:center">' +
    '<input type="text" id="' + fieldId + '_ren_fr" class="form-control" value="' + esc(nameFr) + '" placeholder="Nom (FR)" style="font-size:0.9rem">' +
    '<input type="text" id="' + fieldId + '_ren_en" class="form-control" value="' + esc(nameEn) + '" placeholder="Name (EN)" style="font-size:0.9rem">' +
    '<button type="button" class="btn btn-sm btn-primary" onclick="dynSubmitRename(\'' + fieldId + '\', ' + id + ')" style="background-color:#39FF14;color:#000">✓ Sauver</button>' +
    '<button type="button" class="btn btn-sm btn-secondary" onclick="dynCloseInline(\'' + fieldId + '\')">×</button>' +
    '</div>' +
    '<div style="font-size:0.78rem;color:#718096;margin-top:0.4rem">Seul le nom affiché change. Les plats existants restent dans cette catégorie.</div>'
  );
}

async function dynSubmitRename(fieldId, id) {
  var wrap = document.querySelector('.select-dynamic-wrap[data-field-id="' + fieldId + '"]');
  if (!wrap) return;
  var source = wrap.getAttribute('data-source');
  var nameFr = (document.getElementById(fieldId + '_ren_fr').value || '').trim();
  var nameEn = (document.getElementById(fieldId + '_ren_en').value || '').trim();
  if (!nameFr) { toast('Nom requis', 'error'); return; }
  try {
    var r = await fetch('api/admin/' + source + '/' + id, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name_fr: nameFr, name_en: nameEn }) });
    var d = await r.json().catch(function(){ return {}; });
    if (!r.ok) { toast('Erreur: ' + (d.error || 'inconnue'), 'error'); return; }
    await dynRefreshSource(source);
    var keep = document.getElementById(fieldId).value;
    dynRerenderSelect(fieldId, keep);
    dynCloseInline(fieldId);
    toast('Catégorie renommée', 'success');
  } catch(e) { toast('Erreur réseau', 'error'); }
}

function renderSizeRowsInto(fieldId, sizes) {
  var container = document.getElementById(fieldId + '_rows');
  if (!container) return;
  if (!sizes || !sizes.length) { container.innerHTML = '<p style="color:#a0aec0;font-size:0.85rem;margin:0.25rem 0">Aucune taille — le prix de base s\'applique.</p>'; return; }
  var html = '';
  sizes.forEach(function(s, idx){
    var lfr = s.label_fr == null ? '' : s.label_fr;
    var len = s.label_en == null ? '' : s.label_en;
    var price = s.price == null || s.price === '' ? '' : s.price;
    html += '<div class="size-row" data-row-idx="' + idx + '" style="display:grid;grid-template-columns:1fr 1fr 110px 36px;gap:0.4rem;margin-bottom:0.4rem;align-items:center">';
    html += '<input type="text" class="form-control size-fr" placeholder="Taille (FR)" value="' + esc(lfr) + '" style="font-size:0.9rem">';
    html += '<input type="text" class="form-control size-en" placeholder="Size (EN)" value="' + esc(len) + '" style="font-size:0.9rem">';
    html += '<input type="number" class="form-control size-price" placeholder="Prix" step="0.01" min="0" value="' + esc(price) + '" style="font-size:0.9rem">';
    html += '<button type="button" class="btn btn-sm btn-danger" onclick="removeSizeRow(\'' + fieldId + '\', ' + idx + ')" title="Supprimer">×</button>';
    html += '</div>';
  });
  container.innerHTML = html;
}
function collectSizeRows(fieldId) {
  var rows = document.querySelectorAll('#' + fieldId + '_rows .size-row');
  var out = [];
  rows.forEach(function(r){
    var lfr = (r.querySelector('.size-fr') || {}).value || '';
    var len = (r.querySelector('.size-en') || {}).value || '';
    var p = (r.querySelector('.size-price') || {}).value;
    var price = p === '' ? null : parseFloat(p);
    if (lfr || len || price != null) out.push({ label_fr: lfr.trim(), label_en: len.trim(), price: price });
  });
  return out;
}
function addSizeRow(fieldId) {
  var current = collectSizeRows(fieldId);
  current.push({ label_fr: '', label_en: '', price: '' });
  renderSizeRowsInto(fieldId, current);
}
function removeSizeRow(fieldId, idx) {
  var current = collectSizeRows(fieldId);
  current.splice(idx, 1);
  renderSizeRowsInto(fieldId, current);
}

function openModal(item) {
  editingId = item ? item.id : null;
  document.getElementById('modalTitle').textContent = item ? 'Modifier' : 'Ajouter';
  document.getElementById('formFields').innerHTML = buildFormFields(item);
  // Flush any pending size_list initializations now that DOM exists
  if (window._pendingSizeInit) {
    for (var k in window._pendingSizeInit) renderSizeRowsInto(k, window._pendingSizeInit[k]);
    window._pendingSizeInit = {};
  }
  document.getElementById('modal').classList.add('open');
}
function closeModal() { document.getElementById('modal').classList.remove('open'); }
function editItem(id) { var it = items.find(function(x){ return x.id === id; }); if (it) openModal(it); }

async function setStatus(id, status) {
  try {
    var r = await fetch('api/admin/' + MODULE_KEY + '/' + id, { method: 'PUT', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ status: status }) });
    if (r.ok) { toast('Statut mis à jour', 'success'); loadItems(); }
    else toast('Erreur', 'error');
  } catch(e) { toast('Erreur réseau', 'error'); }
}

async function deleteItem(id) {
  if (!confirm('Supprimer cet élément définitivement?')) return;
  try {
    var r = await fetch('api/admin/' + MODULE_KEY + '/' + id, { method: 'DELETE' });
    if (r.ok) { toast('Supprimé', 'success'); loadItems(); }
    else toast('Erreur de suppression', 'error');
  } catch(e) { toast('Erreur réseau', 'error'); }
}

document.getElementById('itemForm').addEventListener('submit', async function(e){
  e.preventDefault();
  var data = {};
  fields.forEach(function(f){
    if (f.type === 'size_list') {
      var fieldId = 'fld_' + f.name;
      var rows = collectSizeRows(fieldId);
      data[f.name] = rows.length ? JSON.stringify(rows) : null;
      return;
    }
    var el = document.getElementById('fld_' + f.name);
    if (!el) return;
    if (f.type === 'boolean') data[f.name] = el.checked ? 1 : 0;
    else if (f.type === 'number') data[f.name] = el.value === '' ? null : parseFloat(el.value);
    else data[f.name] = el.value;
  });
  var saveBtn = document.getElementById('saveBtn');
  saveBtn.disabled = true; saveBtn.textContent = 'Enregistrement…';
  try {
    var url = editingId ? ('api/admin/' + MODULE_KEY + '/' + editingId) : ('api/admin/' + MODULE_KEY);
    var r = await fetch(url, { method: editingId ? 'PUT' : 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) });
    if (r.ok) { closeModal(); toast(editingId ? 'Modifié avec succès' : 'Ajouté avec succès', 'success'); loadItems(); }
    else { var err = await r.json().catch(function(){ return {}; }); toast('Erreur: ' + (err.error || 'inconnue'), 'error'); }
  } catch(e) { toast('Erreur réseau', 'error'); }
  finally { saveBtn.disabled = false; saveBtn.textContent = 'Enregistrer'; }
});

document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeModal(); });

loadModule();
</script>
</body>
</html>
