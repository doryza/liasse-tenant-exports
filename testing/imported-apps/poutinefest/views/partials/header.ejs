<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#39FF14">
<title><%= settings.business_name || t.brand %></title>
<meta name="description" content="<%= settings.tagline || t.hero_subtitle %>">
<% var __faviconUrl = (typeof appIconUrl !== 'undefined' && appIconUrl) ? appIconUrl : ((typeof settings !== 'undefined' && settings._p_nav_logo_url) ? settings._p_nav_logo_url : 'https://res.cloudinary.com/duhp69meg/image/upload/v1779217153/subscriber_pwa_icons/inaklcotzdjouhzm8ues.png'); %>
<link rel="icon" type="image/png" href="<%= __faviconUrl %>">
<link rel="apple-touch-icon" href="<%= __faviconUrl %>">
<link rel="manifest" href="manifest.json">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,500;1,600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="public/css/styles.css">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="<%= t.brand %>">
</head>
<body class="squeeze">
<a class="lang-switch" href="<%= lang === 'en' ? '?lang=fr' : '?lang=en' %>" aria-label="<%= lang === 'en' ? 'Passer au français' : 'Switch to English' %>"><%= lang === 'en' ? 'FR' : 'EN' %></a>
