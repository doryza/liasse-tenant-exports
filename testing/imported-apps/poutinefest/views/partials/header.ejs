<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#39FF14">
<title><%= settings.business_name || t.brand %></title>
<meta name="description" content="<%= settings.tagline || t.hero_subtitle %>">
<link rel="manifest" href="manifest.json">
<link rel="stylesheet" href="public/css/styles.css">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="<%= t.brand %>">
</head>
<body>
<header class="site-header">
  <div class="container nav-row">
    <a href="." class="brand">
      <img src="<%= (typeof settings!=='undefined' && settings._p_nav_logo_url) ? settings._p_nav_logo_url : (typeof appIconUrl !== 'undefined' ? appIconUrl : '') %>" alt="<%= t.brand %>" class="brand-logo" onerror="this.style.display='none'">
      <span class="brand-name"><%= t.brand %></span>
    </a>
    <nav class="desktop-nav">
      <a href="."><%= t.nav_home %></a>
      <a href="menu"><%= t.nav_menu %></a>
      <a href="livraison"><%= t.nav_delivery %></a>
      <a href="apropos"><%= t.nav_about %></a>
      <a href="reserver" class="nav-cta" style="background-color:#39FF14;color:#000"><%= t.nav_reserve %></a>
      <a href="#" data-login-btn class="nav-login"><%= t.login %></a>
      <span class="lang-toggle">
        <a href="?lang=fr" class="<%= lang==='fr'?'active':'' %>">FR</a><span>|</span><a href="?lang=en" class="<%= lang==='en'?'active':'' %>">EN</a>
      </span>
    </nav>
    <button class="hamburger" aria-label="Menu" id="hamburgerBtn">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="mobile-menu" id="mobileMenu">
    <a href="."><%= t.nav_home %></a>
    <a href="menu"><%= t.nav_menu %></a>
    <a href="livraison"><%= t.nav_delivery %></a>
    <a href="apropos"><%= t.nav_about %></a>
    <a href="reserver"><%= t.nav_reserve %></a>
    <a href="#" data-login-btn><%= t.login %></a>
    <div class="mobile-lang">
      <a href="?lang=fr" class="<%= lang==='fr'?'active':'' %>">FR</a><span>|</span><a href="?lang=en" class="<%= lang==='en'?'active':'' %>">EN</a>
    </div>
  </div>
</header>
<script>
(function(){
  var b = document.getElementById('hamburgerBtn');
  var m = document.getElementById('mobileMenu');
  if (b && m) b.addEventListener('click', function(){ m.classList.toggle('open'); });
})();
</script>
