<%# Lightweight keychain-attribution signup flow.
    - Step 1 (no signupId): collect email + name, POST → server generates OTP, emails it.
    - Step 2 (signupId in URL): show OTP-entry form, POST → server verifies, redirects.
    Captures ?keychain=<id> from the URL into a hidden field so it survives form submit.
    Intentionally minimal styling — matches the bare-bones poutinefest brand colors. %>
<%- include('partials/header') %>

<div style="max-width:480px;margin:48px auto;padding:0 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif">
  <% if (!signup) { %>
    <%# ===== Step 1: email entry ===== %>
    <h1 style="font-size:24px;color:#111;margin:0 0 8px"><%= lang === 'en' ? 'Welcome!' : 'Bienvenue!' %></h1>
    <p style="color:#555;margin:0 0 24px"><%= lang === 'en'
      ? 'You scanned a PoutineFest keychain. Enter your email to claim your visit and unlock perks.'
      : 'Vous avez scanné un porte-clés PoutineFest. Entrez votre courriel pour récupérer votre visite et débloquer des avantages.' %></p>

    <% if (error) { %>
      <div style="background:#fef2f2;color:#991b1b;border:1px solid #fecaca;padding:12px;border-radius:8px;margin-bottom:16px;font-size:14px"><%= error %></div>
    <% } %>

    <form method="POST" action="/api/keychain-signup" style="display:flex;flex-direction:column;gap:12px">
      <input type="hidden" name="keychainId" value="<%= keychainId %>">
      <label style="font-size:13px;color:#374151;font-weight:600"><%= lang === 'en' ? 'Email' : 'Courriel' %>
        <input type="email" name="email" required style="width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:6px;margin-top:4px;font-size:16px">
      </label>
      <label style="font-size:13px;color:#374151;font-weight:600"><%= lang === 'en' ? 'Full name (optional)' : 'Nom complet (optionnel)' %>
        <input type="text" name="fullName" style="width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:6px;margin-top:4px;font-size:16px">
      </label>
      <button type="submit" style="background:#dc2626;color:#fff;border:none;padding:12px;border-radius:6px;font-size:16px;font-weight:600;cursor:pointer;margin-top:8px"><%= lang === 'en' ? 'Send verification code' : 'Envoyer le code de vérification' %></button>
    </form>

  <% } else { %>
    <%# ===== Step 2: OTP entry ===== %>
    <h1 style="font-size:24px;color:#111;margin:0 0 8px"><%= lang === 'en' ? 'Check your inbox' : 'Vérifiez votre boîte de réception' %></h1>
    <p style="color:#555;margin:0 0 24px"><%= lang === 'en'
      ? 'We sent a 6-digit code to ' + signup.email + '. Enter it below to confirm.'
      : 'Nous avons envoyé un code à 6 chiffres à ' + signup.email + '. Entrez-le ci-dessous pour confirmer.' %></p>

    <% if (error) { %>
      <div style="background:#fef2f2;color:#991b1b;border:1px solid #fecaca;padding:12px;border-radius:8px;margin-bottom:16px;font-size:14px"><%= error %></div>
    <% } %>

    <form method="POST" action="/api/keychain-verify" style="display:flex;flex-direction:column;gap:12px">
      <input type="hidden" name="signupId" value="<%= signup.id %>">
      <label style="font-size:13px;color:#374151;font-weight:600"><%= lang === 'en' ? 'Verification code' : 'Code de vérification' %>
        <input type="text" name="otp" required pattern="[0-9]{6}" inputmode="numeric" maxlength="6" autocomplete="one-time-code" style="width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:6px;margin-top:4px;font-size:20px;text-align:center;letter-spacing:0.3em;font-family:monospace">
      </label>
      <button type="submit" style="background:#dc2626;color:#fff;border:none;padding:12px;border-radius:6px;font-size:16px;font-weight:600;cursor:pointer;margin-top:8px"><%= lang === 'en' ? 'Verify' : 'Vérifier' %></button>
    </form>
  <% } %>
</div>

<%- include('partials/footer') %>
