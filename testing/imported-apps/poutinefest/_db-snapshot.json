        {
          "key": "_p_about_image_url",
          "value": "https://res.cloudinary.com/duhp69meg/image/upload/v1779215130/tapavis_tenant_poutinefest/build_poutinefest_1779215130910.png",
          "updated_at": "2026-05-19T18:43:04.052Z"
        },
        {
          "key": "hours",
          "value": "Lun-Jeu : 11h - 22h\nVen-Sam : 11h - minuit\nDim : 12h - 21h",
          "updated_at": "2026-05-19T18:43:04.099Z"
        },
        {
          "key": "about_text_fr",
          "value": "Depuis 2018, PoutineFest célèbre la cuisine québécoise avec passion. Nos pommes de terre proviennent de fermes québécoises, notre fromage en grains est livré tous les matins, et notre sauce brune maison mijote 6 heures pour un goût incomparable. Notre camion-restaurant parcourt la province pour servir festivals, mariages et événements corporatifs.",
          "updated_at": "2026-05-19T18:43:04.106Z"
        },
        {
          "key": "about_text_en",
          "value": "Since 2018, PoutineFest has been celebrating Quebec cuisine with passion. Our potatoes come from Quebec farms, our cheese curds are delivered every morning, and our house-made gravy simmers for 6 hours to deliver an unmatched flavor. Our food truck travels across the province for festivals, weddings and corporate events.",
          "updated_at": "2026-05-19T18:43:04.115Z"
        },
        {
          "key": "_seed_version",
          "value": "7b58791fb669",
          "updated_at": "2026-05-19T18:43:04.340Z"
        },
        {
          "key": "_seeded_at",
          "value": "2026-05-19 18:43:04.3464+00",
          "updated_at": "2026-05-19T18:43:04.346Z"
        },
        {
          "key": "_p_seo_title_en",
          "value": "PoutineFest — Authentic Poutine & Food Truck",
          "updated_at": "2026-05-19T18:43:04.611Z"
        },
        {
          "key": "_p_seo_source_title_en",
