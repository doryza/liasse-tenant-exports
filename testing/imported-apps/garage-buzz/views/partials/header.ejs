<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#2858ef">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="description" content="<%= t.hero_sub %>">
<title><%= settings.garage_name %> — <%= t.hero_h1 %></title>
<link rel="manifest" href="manifest.json">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="public/css/styles.css">
</head>
<body>
<header class="site-header"><div class="wrap hdr">
<a class="brand" href="."><svg class="mark" width="26" height="26" viewBox="0 0 26 26" aria-hidden="true"><rect x="2.5" y="2.5" width="21" height="21" fill="#fff" stroke="#0E1A3A" stroke-width="1.4"/><line x1="6" y1="9" x2="20" y2="9" stroke="#0E1A3A" stroke-width="1.4"/><line x1="6" y1="13" x2="18" y2="13" stroke="#2858EF" stroke-width="1.8"/><circle cx="20" cy="13" r="1.5" fill="#F5A623"/><line x1="6" y1="17" x2="20" y2="17" stroke="#0E1A3A" stroke-width="1.4"/></svg><span data-setting-key="garage_name"><%= settings.garage_name %></span></a>
<div class="nav-right">
<nav class="nav-links">
<a href="." data-lk="nav-home"><%= t.nav_home %></a>
<a href="book" data-lk="nav-book"><%= t.nav_book %></a>
<a href="account" data-auth-only style="display:none" data-lk="nav-account"><%= t.nav_account %></a>
<button class="linklike navbtn" data-login-btn data-lk="nav-login"><%= t.nav_login %></button>
</nav>
<span class="lang-toggle mono"><a href="?lang=fr" class="<%= lang==='fr'?'active':'' %>">FR</a> | <a href="?lang=en" class="<%= lang==='en'?'active':'' %>">EN</a></span>
<button class="hamburger" id="hbtn" aria-label="Menu"><span></span><span></span><span></span></button>
</div>
</div>
<div class="mobile-panel" id="mpanel">
<a href="." data-lk="mnav-home"><%= t.nav_home %></a>
<a href="book" data-lk="mnav-book"><%= t.nav_book %></a>
<a href="account" data-auth-only style="display:none" data-lk="mnav-account"><%= t.nav_account %></a>
<button data-login-btn data-lk="mnav-login"><%= t.nav_login %></button>
</div>
</header>
