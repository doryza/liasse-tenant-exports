<aside class="admin-sidebar" id="adminSidebar">
  <div class="admin-brand"><span>🌿</span> FreshBin Admin</div>
  <nav class="admin-nav">
    <a href="admin" class="<%= currentModule==='dashboard'?'active':'' %>"><span>📊</span> Tableau de bord</a>
    <a href="admin/services" class="<%= currentModule==='services'?'active':'' %>"><span>📦</span> Services</a>
    <a href="admin/posts" class="<%= currentModule==='posts'?'active':'' %>"><span>✏️</span> Articles</a>
    <a href="admin/testimonials" class="<%= currentModule==='testimonials'?'active':'' %>"><span>⭐</span> Témoignages</a>
    <a href="admin/bookings" class="<%= currentModule==='bookings'?'active':'' %>"><span>📅</span> Réservations</a>
    <a href="admin/submissions" class="<%= currentModule==='submissions'?'active':'' %>"><span>✉</span> Messages</a>
    <a href="admin/settings" class="<%= currentModule==='settings'?'active':'' %>"><span>⚙</span> Paramètres</a>
  </nav>
  <div class="admin-footer-links">
    <a href="." target="_blank">↗ Voir le site</a>
    <a href="admin/logout">⎋ Déconnexion</a>
  </div>
</aside>
<button class="admin-mobile-toggle" id="adminMobileToggle" aria-label="Menu" type="button">☰</button>
<script>
(function(){
  var t = document.getElementById('adminMobileToggle');
  var s = document.getElementById('adminSidebar');
  if (t && s) t.addEventListener('click', function(){ s.classList.toggle('open'); });
})();
</script>
