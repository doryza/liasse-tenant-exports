<%- include('partials/admin-shell', { adminSection: 'settings', adminTitle: lang === 'en' ? 'Settings' : 'Réglages' }) %>

<section class="admin-card">
  <h2 data-lk="admin-set-gates"><%= lang === 'en' ? 'What the site is allowed to do' : 'Ce que le site est autorisé à faire' %></h2>
  <p class="muted small" data-lk="admin-set-gates-sub"><%= lang === 'en' ? 'Each switch below turns on something that speaks for you or takes money. While it is off, the site stays careful.' : 'Chaque interrupteur ci-dessous active quelque chose qui parle en votre nom ou qui encaisse de l’argent. Tant qu’il est fermé, le site reste prudent.' %></p>
  <div class="admin-toggles" data-settings-toggles>
    <% settingsFields.forEach(function (field) { %>
      <label class="admin-toggle">
        <input type="checkbox" data-setting-toggle="<%= field.name %>" <%= rawSettings[field.name] === '1' ? 'checked' : '' %>>
        <span>
          <strong><%= field.label %></strong>
          <span class="muted small"><%= field.description %></span>
        </span>
      </label>
    <% }); %>
  </div>
  <% if (!paypalConfigured) { %>
    <div class="notice notice--warn" style="margin-top:18px">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 9v4m0 4h.01"/><circle cx="12" cy="12" r="9"/></svg>
      <p data-lk="admin-paypal-missing"><%= lang === 'en' ? 'The PayPal keys are not saved yet. Add PAYPAL_CLIENT_ID, PAYPAL_CLIENT_SECRET, PAYPAL_MODE and PAYPAL_MERCHANT_ID in your Liasse dashboard, then come back to enable payment.' : 'Les clés PayPal ne sont pas encore enregistrées. Ajoutez PAYPAL_CLIENT_ID, PAYPAL_CLIENT_SECRET, PAYPAL_MODE et PAYPAL_MERCHANT_ID dans votre tableau de bord Liasse, puis revenez activer le paiement.' %></p>
    </div>
  <% } %>
</section>

<section class="admin-card">
  <h2 data-lk="admin-set-business"><%= lang === 'en' ? 'Contact details' : 'Coordonnées' %></h2>
  <div class="admin-fields">
    <label class="field"><span><%= lang === 'en' ? 'Business name' : 'Nom de l’entreprise' %></span><input data-setting="business_name" value="<%= rawSettings.business_name || '' %>" maxlength="200"></label>
    <label class="field"><span><%= lang === 'en' ? 'Phone' : 'Téléphone' %></span><input data-setting="contact_phone" value="<%= rawSettings.contact_phone || '' %>" maxlength="40"></label>
    <label class="field"><span><%= lang === 'en' ? 'Email' : 'Courriel' %></span><input data-setting="contact_email" type="email" value="<%= rawSettings.contact_email || '' %>" maxlength="190"></label>
    <label class="field"><span><%= lang === 'en' ? 'Pickup address' : 'Adresse de cueillette' %></span><input data-setting="business_address" value="<%= rawSettings.business_address || '' %>" maxlength="240"></label>
  </div>
</section>

<section class="admin-card">
  <h2 data-lk="admin-set-shop"><%= lang === 'en' ? 'Shipping and taxes' : 'Livraison et taxes' %></h2>
  <div class="admin-fields">
    <label class="field"><span><%= lang === 'en' ? 'Shipping rate (in cents)' : 'Tarif de livraison (en cents)' %></span><input data-setting="shipping_flat_cents" inputmode="numeric" value="<%= rawSettings.shipping_flat_cents || '' %>"><span class="hint"><%= lang === 'en' ? 'E.g. 1200 for $12.00. Required before enabling shipping.' : 'Ex. 1200 pour 12,00 $. Requis avant d’activer la livraison.' %></span></label>
    <label class="field"><span><%= lang === 'en' ? 'Free shipping from (in cents)' : 'Livraison gratuite à partir de (en cents)' %></span><input data-setting="free_shipping_threshold_cents" inputmode="numeric" value="<%= rawSettings.free_shipping_threshold_cents || '' %>"><span class="hint"><%= lang === 'en' ? 'E.g. 7500 for $75.00. Set 0 to disable.' : 'Ex. 7500 pour 75,00 $. Mettez 0 pour désactiver.' %></span></label>
    <label class="field"><span><%= lang === 'en' ? 'GST (basis points)' : 'TPS (points de base)' %></span><input data-setting="gst_rate_bp" inputmode="numeric" value="<%= rawSettings.gst_rate_bp || '' %>"><span class="hint">500 = 5,000 %.</span></label>
    <label class="field"><span><%= lang === 'en' ? 'QST (basis points)' : 'TVQ (points de base)' %></span><input data-setting="qst_rate_bp" inputmode="numeric" value="<%= rawSettings.qst_rate_bp || '' %>"><span class="hint">998 = 9,975 %.</span></label>
    <label class="field"><span><%= lang === 'en' ? 'GST number' : 'Numéro de TPS' %></span><input data-setting="gst_number" value="<%= rawSettings.gst_number || '' %>" maxlength="40"></label>
    <label class="field"><span><%= lang === 'en' ? 'QST number' : 'Numéro de TVQ' %></span><input data-setting="qst_number" value="<%= rawSettings.qst_number || '' %>" maxlength="40"></label>
  </div>
</section>

<section class="admin-card">
  <h2 data-lk="admin-set-legal"><%= lang === 'en' ? 'Legal texts' : 'Textes légaux' %></h2>
  <p class="muted small" data-lk="admin-set-legal-sub"><%= lang === 'en' ? 'Both texts must be written in French AND English before they can be approved.' : 'Ces deux textes doivent être rédigés en français ET en anglais avant de pouvoir être approuvés.' %></p>
  <div class="admin-fields admin-fields--wide">
    <label class="field"><span><%= lang === 'en' ? 'Privacy notice — French' : 'Avis de confidentialité — français' %></span><textarea data-setting-json="privacy_notice" data-lang="fr"><%= jsonField(rawSettings.privacy_notice, 'fr') %></textarea></label>
    <label class="field"><span><%= lang === 'en' ? 'Privacy notice — English' : 'Avis de confidentialité — anglais' %></span><textarea data-setting-json="privacy_notice" data-lang="en"><%= jsonField(rawSettings.privacy_notice, 'en') %></textarea></label>
    <label class="field"><span><%= lang === 'en' ? 'Terms of sale — French' : 'Conditions de vente — français' %></span><textarea data-setting-json="payment_terms" data-lang="fr"><%= jsonField(rawSettings.payment_terms, 'fr') %></textarea></label>
    <label class="field"><span><%= lang === 'en' ? 'Terms of sale — English' : 'Conditions de vente — anglais' %></span><textarea data-setting-json="payment_terms" data-lang="en"><%= jsonField(rawSettings.payment_terms, 'en') %></textarea></label>
  </div>
</section>

<section class="admin-card">
  <h2 data-lk="admin-set-texts"><%= lang === 'en' ? 'Site texts' : 'Textes du site' %></h2>
  <p class="muted small" data-lk="admin-set-texts-sub"><%= lang === 'en' ? 'You can also edit any text directly on the site by hovering it from your Liasse dashboard.' : 'Vous pouvez aussi modifier n’importe quel texte directement sur le site, en le survolant depuis votre tableau de bord Liasse.' %></p>
  <div class="admin-fields admin-fields--wide">
    <% ['hero_title', 'hero_subtitle', 'hero_note', 'tagline', 'story_title', 'story_text', 'about_text', 'lists_title', 'lists_text', 'boutique_text', 'listes_text', 'livraison_text', 'contact_intro'].forEach(function (key) { %>
      <label class="field">
        <span><%= key.replace(/_/g, ' ') %> — <%= lang === 'en' ? 'French' : 'français' %></span>
        <textarea data-setting-json="<%= key %>" data-lang="fr"><%= jsonField(rawSettings[key], 'fr') %></textarea>
      </label>
      <label class="field">
        <span><%= key.replace(/_/g, ' ') %> — <%= lang === 'en' ? 'English' : 'anglais' %></span>
        <textarea data-setting-json="<%= key %>" data-lang="en"><%= jsonField(rawSettings[key], 'en') %></textarea>
      </label>
    <% }); %>
  </div>
</section>

<section class="admin-card">
  <h2 data-lk="admin-set-images"><%= lang === 'en' ? 'Page illustrations' : 'Illustrations des pages' %></h2>
  <p class="muted small"><%= lang === 'en' ? 'Paste an https image address. Leave empty to show the notebook placeholder.' : 'Collez une adresse d’image https. Laissez vide pour afficher le motif cahier.' %></p>
  <div class="admin-fields admin-fields--wide">
    <label class="field"><span><%= lang === 'en' ? 'Home hero' : 'Accueil (image principale)' %></span><input data-setting="_p_hero_image_url" value="<%= rawSettings._p_hero_image_url || '' %>" maxlength="500"></label>
    <label class="field"><span><%= lang === 'en' ? 'School lists page' : 'Page des listes scolaires' %></span><input data-setting="_p_lists_image_url" value="<%= rawSettings._p_lists_image_url || '' %>" maxlength="500"></label>
    <label class="field"><span><%= lang === 'en' ? 'About page' : 'Page À propos' %></span><input data-setting="_p_about_image_url" value="<%= rawSettings._p_about_image_url || '' %>" maxlength="500"></label>
  </div>
</section>

<p class="admin-save-bar">
  <span class="small muted" data-settings-status role="status"></span>
</p>

<%- include('partials/admin-footer') %>
