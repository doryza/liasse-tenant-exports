<!DOCTYPE html>
<html lang='<%= lang %>'>
<head>
<meta charset='utf-8'>
<meta name='viewport' content='width=device-width, initial-scale=1, viewport-fit=cover'>
<meta name='theme-color' content='#0B0A08'>
<meta name='apple-mobile-web-app-capable' content='yes'>
<meta name='apple-mobile-web-app-status-bar-style' content='black-translucent'>
<title><%= businessName %> — <%= t.meta_title %></title>
<meta name='description' content='<%= t.meta_desc %>'>
<link rel='manifest' href='manifest.json'>
<link rel='preconnect' href='https://fonts.googleapis.com'>
<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin>
<link href='https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700;9..144,900&family=Work+Sans:wght@400;500;600&display=swap' rel='stylesheet'>
<link rel='stylesheet' href='public/css/styles.css'>
</head>
<body data-page='<%= currentPath %>'>
<header class='site-head'>
 <div class='head-inner'>
  <a class='brand' href='.'>
   <span class='brand-mono'>A</span>
   <span class='brand-word' data-setting-key='business_name'><%= businessName %></span>
  </a>
  <nav class='nav-desktop' aria-label='Navigation principale'>
   <a href='.' class='<%= currentPath==="/"?"active":"" %>' data-lk='t:nav_home'><%= t.nav_home %></a>
   <a href='menu' class='<%= currentPath.indexOf("/menu")===0?"active":"" %>' data-lk='t:nav_menu'><%= t.nav_menu %></a>
   <a href='actualites' class='<%= currentPath.indexOf("/actualites")===0?"active":"" %>' data-lk='t:nav_news'><%= t.nav_news %></a>
   <span class='lang-toggle'><a href='<%= langFr %>' class='<%= lang==="fr"?"on":"" %>'>FR</a><span>/</span><a href='<%= langEn %>' class='<%= lang==="en"?"on":"" %>'>EN</a></span>
   <a class='btn-gold btn-order' style='background-color:#C9A24B;color:#120d05' href='<%= settings.order_url?settings.order_url:"menu" %>' <%- settings.order_url?'target=_blank rel=noopener':'' %> data-lk='t:nav_order'><%= t.nav_order %></a>
  </nav>
  <button class='hamburger' id='navToggle' aria-label='Menu' aria-expanded='false'><span></span><span></span><span></span></button>
 </div>
 <div class='nav-mobile' id='navMobile'>
  <a href='.' data-lk='t:nav_home'><%= t.nav_home %></a>
  <a href='menu' data-lk='t:nav_menu'><%= t.nav_menu %></a>
  <a href='actualites' data-lk='t:nav_news'><%= t.nav_news %></a>
  <a class='btn-gold' style='background-color:#C9A24B;color:#120d05' href='<%= settings.order_url?settings.order_url:"menu" %>' <%- settings.order_url?'target=_blank rel=noopener':'' %> data-lk='t:nav_order'><%= t.nav_order %></a>
  <span class='lang-toggle'><a href='<%= langFr %>' class='<%= lang==="fr"?"on":"" %>'>FR</a><span>/</span><a href='<%= langEn %>' class='<%= lang==="en"?"on":"" %>'>EN</a></span>
 </div>
</header>
<script>
(function(){var b=document.getElementById('navToggle'),m=document.getElementById('navMobile');if(b&&m){b.addEventListener('click',function(){var o=m.classList.toggle('open');b.classList.toggle('x',o);b.setAttribute('aria-expanded',o?'true':'false');});}})();
</script>
