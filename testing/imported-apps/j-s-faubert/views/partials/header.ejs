<!DOCTYPE html>
<html lang='fr'>
<head>
<meta charset='utf-8'>
<meta name='viewport' content='width=device-width, initial-scale=1, viewport-fit=cover'>
<meta name='theme-color' content='#6366f1'>
<meta name='apple-mobile-web-app-capable' content='yes'>
<meta name='apple-mobile-web-app-status-bar-style' content='black-translucent'>
<% var _bn=(typeof settings!=='undefined'&&settings.business_name)?settings.business_name:'Jean-Sébastien Faubert'; %>
<% var _tag=(typeof settings!=='undefined'&&settings.tagline)?settings.tagline:'Auteur-compositeur-interprète'; %>
<title><%= _bn %> — <%= _tag %></title>
<meta name='description' content='<%= _bn %>, <%= _tag %>. Écoutez les nouvelles chansons, suivez les dates de spectacles et les actualités.'>
<link rel='manifest' href='manifest.json'>
<link rel='preconnect' href='https://fonts.googleapis.com'>
<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin>
<link href='https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..500&display=swap' rel='stylesheet'>
<link rel='stylesheet' href='public/css/styles.css'>
</head>
<body data-page='<%= typeof page!=='undefined'?page:'' %>'>
<header class='site-head'>
  <div class='head-inner'>
    <a href='.' class='brand'><span class='brand-mark'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5'><circle cx='12' cy='12' r='9'/><circle cx='12' cy='12' r='5.2' opacity='.45'/><circle cx='12' cy='12' r='2.1' fill='currentColor' stroke='none'/></svg></span><span><%= _bn %></span></a>
    <nav class='nav-desk'>
      <a href='.' class='<%= (typeof page!=='undefined'&&page==='accueil')?'active':'' %>'>Accueil</a>
      <a href='musique' class='<%= (typeof page!=='undefined'&&page==='musique')?'active':'' %>'>Musique</a>
      <a href='spectacles' class='<%= (typeof page!=='undefined'&&page==='spectacles')?'active':'' %>'>Spectacles</a>
      <a href='journal' class='<%= (typeof page!=='undefined'&&page==='journal')?'active':'' %>'>Journal</a>
      <a href='a-propos' class='<%= (typeof page!=='undefined'&&page==='apropos')?'active':'' %>'>À propos</a>
      <a href='contact' class='<%= (typeof page!=='undefined'&&page==='contact')?'active':'' %>'>Contact</a>
    </nav>
    <div class='head-actions'>
      <a href='favoris' class='icon-link' aria-label='Mes favoris'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7'><path d='M12 20s-7-4.3-9.2-8.4C1.2 8.7 2.6 5.5 5.7 5.1 7.7 4.8 9.3 6 12 8.6 14.7 6 16.3 4.8 18.3 5.1c3.1.4 4.5 3.6 2.9 6.5C19 15.7 12 20 12 20z'/></svg></a>
      <a href='#' data-login-btn class='btn-login'>Connexion</a>
      <a href='favoris' data-auth-only class='btn-login' style='display:none'>Mon espace</a>
      <button class='nav-toggle' id='navToggle' aria-label='Menu'><span></span><span></span><span></span></button>
    </div>
  </div>
  <div class='nav-mobile' id='navMobile'>
    <a href='.'>Accueil</a>
    <a href='musique'>Musique</a>
    <a href='spectacles'>Spectacles</a>
    <a href='journal'>Journal</a>
    <a href='a-propos'>À propos</a>
    <a href='contact'>Contact</a>
    <a href='favoris'>Favoris</a>
    <a href='#' data-login-btn>Connexion</a>
  </div>
</header>
<main>
