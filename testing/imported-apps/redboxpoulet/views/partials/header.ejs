<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0c0a09">
<%
  var _name = settings.business_name || t.brand;
  var _desc = (typeof sx === 'function' ? sx('seo_description') : '') || settings.tagline || t.footer_intro || '';
  var _logoRed = settings._p_nav_logo_url || 'https://res.cloudinary.com/duhp69meg/image/upload/v1782232049/redboxpoulet/site/logo_red.png';
  var _ci = (typeof cimg === 'function') ? cimg : function(u){ return u; };
  var _ogImg = _ci(settings._p_hero_image_url || 'https://res.cloudinary.com/duhp69meg/image/upload/v1782232050/redboxpoulet/site/hero.png', 'f_auto,q_auto,w_1200,h_630,c_fill,g_auto');
  var _pageTitle = (typeof pageTitle !== 'undefined' && pageTitle) ? (pageTitle + ' — ' + _name) : (_name + ' — ' + (t.brand_tag || 'Poulet Nashville'));
  var _active = (typeof activeNav !== 'undefined') ? activeNav : '';
  var _addrParts = (settings.business_address || '').split(',').map(function(s){ return s.trim(); }).filter(Boolean);
%>
<title><%= _pageTitle %></title>
<meta name="description" content="<%= _desc %>">
<link rel="icon" type="image/png" href="<%= _ci(_logoRed, 'f_auto,w_96') %>">
<link rel="apple-touch-icon" href="<%= _ci(_logoRed, 'f_auto,w_180') %>">
<link rel="manifest" href="manifest.json">
<meta property="og:type" content="restaurant">
<meta property="og:title" content="<%= _pageTitle %>">
<meta property="og:description" content="<%= _desc %>">
<meta property="og:locale" content="<%= lang === 'en' ? 'en_CA' : 'fr_CA' %>">
<% if (_ogImg) { %><meta property="og:image" content="<%= _ogImg %>"><% } %>
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="public/css/styles.css">
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Restaurant",
  "name": _name,
  "servesCuisine": "Nashville hot chicken",
  "priceRange": "$$",
  "image": _ogImg,
  "description": _desc,
  "address": settings.business_address ? {
    "@type": "PostalAddress",
    "streetAddress": _addrParts[0] || settings.business_address,
    "addressLocality": _addrParts[1] || undefined,
    "addressRegion": _addrParts[2] || undefined,
    "addressCountry": "CA"
  } : undefined,
  "telephone": settings.contact_phone || undefined,
  "email": settings.contact_email || undefined
}) %>
</script>
</head>
<body data-page="<%= _active %>">
<a class="skip-link" href="#main"><%= lang === 'en' ? 'Skip to content' : 'Aller au contenu' %></a>

<header class="site-header">
  <div class="container nav-inner">
    <a href="." class="brand-logo" aria-label="<%= _name %>">
      <img src="<%= _ci(_logoRed, 'f_auto,q_auto,w_180') %>" alt="<%= _name %>" onerror="this.style.display='none';this.nextElementSibling.style.display='inline'">
      <span class="brand-fallback" style="display:none">RED BOX</span>
    </a>
    <nav class="main-nav" aria-label="<%= lang === 'en' ? 'Main navigation' : 'Navigation principale' %>">
      <a class="nav-link<%= _active==='menu'?' active':'' %>"<%- _active==='menu' ? ' aria-current="page"' : '' %> href="menu"><%= t.nav_menu %></a>
      <a class="nav-link<%= _active==='promesse'?' active':'' %>"<%- _active==='promesse' ? ' aria-current="page"' : '' %> href="promesse"><%= t.nav_promise %></a>
      <a class="nav-link<%= _active==='franchise'?' active':'' %>"<%- _active==='franchise' ? ' aria-current="page"' : '' %> href="franchise"><%= t.nav_franchise %></a>
      <a class="nav-link<%= _active==='contact'?' active':'' %>"<%- _active==='contact' ? ' aria-current="page"' : '' %> href="contact"><%= t.nav_contact %></a>
      <a class="nav-link<%= _active==='vip'?' active':'' %>"<%- _active==='vip' ? ' aria-current="page"' : '' %> href="vip" style="color:var(--gold)">★ <%= t.nav_vip %></a>
    </nav>
    <div class="nav-actions">
      <a class="lang-toggle" href="?lang=<%= lang === 'en' ? 'fr' : 'en' %>" aria-label="<%= lang === 'en' ? 'Passer au français' : 'Switch to English' %>"><%= lang === 'en' ? 'FR' : 'EN' %></a>
      <a class="nav-cta" href="menu"><%= t.order %></a>
      <button class="nav-toggle" id="navToggle" aria-label="<%= lang === 'en' ? 'Open menu' : 'Ouvrir le menu' %>" aria-controls="mobileNav" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="7" x2="21" y2="7"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="17" x2="21" y2="17"/></svg>
      </button>
    </div>
  </div>
</header>

<div class="mobile-nav" id="mobileNav">
  <div class="mobile-nav__backdrop" data-close></div>
  <div class="mobile-nav__panel" role="dialog" aria-modal="true" aria-label="<%= t.nav_menu %>">
    <div class="mobile-nav__head">
      <img src="<%= _ci(_logoRed, 'f_auto,q_auto,w_160') %>" alt="<%= _name %>">
      <button class="mobile-nav__close" data-close aria-label="<%= lang === 'en' ? 'Close' : 'Fermer' %>">&times;</button>
    </div>
    <a class="m-link" href="."><%= t.nav_home %></a>
    <a class="m-link" href="menu"><%= t.nav_menu %></a>
    <a class="m-link" href="promesse"><%= t.nav_promise %></a>
    <a class="m-link" href="franchise"><%= t.nav_franchise %></a>
    <a class="m-link" href="contact"><%= t.nav_contact %></a>
    <a class="m-link" href="vip" style="color:var(--gold)">★ <%= t.nav_vip %></a>
    <a class="btn btn-gold btn-block" style="margin-top:1.2rem" href="menu"><%= t.order %></a>
    <div class="mobile-nav__lang">
      <a href="?lang=fr" class="<%= lang === 'fr' ? 'active' : '' %>">Français</a>
      <a href="?lang=en" class="<%= lang === 'en' ? 'active' : '' %>">English</a>
    </div>
  </div>
</div>

<main id="main">
