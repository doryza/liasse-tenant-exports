<%- include('partials/header', { activeNav: 'home' }) %>
<%
  var _hero = settings._p_hero_image_url || 'https://res.cloudinary.com/duhp69meg/image/upload/v1782232050/redboxpoulet/site/hero.png';
  // Hero slider: one image URL per line in the hero_slides setting. >=2 enables
  // the crossfade slideshow; empty falls back to the single hero image above.
  var _heroSlides = (settings.hero_slides || '').split(/\r?\n/).map(function(s){ return s.trim(); }).filter(Boolean);
  if (!_heroSlides.length) _heroSlides = [_hero];
  var _story = settings._p_story_image_url || 'https://res.cloudinary.com/duhp69meg/image/upload/v1782232050/redboxpoulet/site/vibe.png';
  var _family = settings._p_feature_family_url || 'https://res.cloudinary.com/duhp69meg/image/upload/v1782232051/redboxpoulet/site/packaging.png';
  var _burger = settings._p_feature_burger_url || 'https://res.cloudinary.com/duhp69meg/image/upload/v1782232052/redboxpoulet/site/action.png';
%>

<!-- ============================ HERO ============================ -->
<style>
  /* Hero slider crossfade. Single image = static (no motion). */
  .hero-slide { opacity: 0; transition: opacity 1.1s ease-in-out; }
  .hero-slide.is-active { opacity: 1; }

  /* Cool VIP link in the hero — shimmering gold pill. */
  .hero-vip-row { margin-top: 1.5rem; }
  .hero-vip { position: relative; display: inline-flex; align-items: center; gap: .55rem; overflow: hidden;
    padding: .6rem 1.25rem; border-radius: 999px; font-family: var(--font-display); text-transform: uppercase;
    letter-spacing: .09em; font-size: .95rem; color: var(--gold); text-decoration: none;
    border: 1.5px solid rgba(255,198,41,.6); background: rgba(255,198,41,.08);
    transition: transform .2s ease, box-shadow .25s ease, background .2s ease; }
  .hero-vip:hover { transform: translateY(-1px); background: rgba(255,198,41,.16); box-shadow: 0 10px 26px rgba(255,198,41,.28); }
  .hero-vip .star { font-size: 1.05em; line-height: 1; }
  .hero-vip .arr { transition: transform .2s ease; }
  .hero-vip:hover .arr { transform: translateX(3px); }
  .hero-vip::after { content: ''; position: absolute; top: 0; left: -60%; width: 38%; height: 100%;
    background: linear-gradient(100deg, transparent, rgba(255,255,255,.5), transparent); transform: skewX(-18deg);
    animation: vipShine 3.4s ease-in-out infinite; }
  @keyframes vipShine { 0% { left: -60%; } 55%, 100% { left: 130%; } }
  @media (prefers-reduced-motion: reduce) { .hero-vip::after { display: none; } }

  /* Hero menu — horizontal scrolling white product cards */
  .hero-menu { display: flex; align-items: flex-start; gap: .9rem; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; margin: 1.6rem 0 1.7rem; padding-bottom: .6rem; }
  .hero-menu::-webkit-scrollbar { height: 6px; }
  .hero-menu::-webkit-scrollbar-thumb { background: rgba(255,255,255,.25); border-radius: 3px; }
  .hero-item { scroll-snap-align: start; flex: 0 0 235px; width: 235px; display: flex; flex-direction: column; background: #fff; color: var(--text-dark); border-radius: 14px; overflow: hidden; text-decoration: none; box-shadow: 0 14px 34px rgba(0,0,0,.35); transition: transform .15s ease; }
  .hero-item:hover { transform: translateY(-3px); }
  .hero-item__img { width: 100%; height: 140px; object-fit: cover; display: block; }
  .hero-item__emoji { font-size: 3rem; line-height: 1; text-align: center; padding: 1.5rem 0; background: var(--cream); }
  .hero-item__b { padding: .8rem .9rem 1rem; display: flex; flex-direction: column; flex: 1; }
  .hero-item__row { display: flex; align-items: baseline; justify-content: space-between; gap: .5rem; }
  .hero-item__name { font-family: var(--font-display); text-transform: uppercase; font-size: 1.04rem; color: var(--ink); line-height: 1.05; }
  .hero-item__price { font-family: var(--font-display); color: var(--red); font-size: 1.04rem; white-space: nowrap; }
  .hero-item__desc { color: var(--muted-dark); font-size: .82rem; line-height: 1.4; margin: .35rem 0 .7rem; flex: 1; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  /* Per-card "Commander ▾" dropdown: Takeout (our order page) + delivery */
  .hero-item__cmd { margin-top: .75rem; }
  .hero-item__cmd-btn { width: 100%; display: flex; align-items: center; justify-content: center; gap: .4rem; cursor: pointer; border: 0; border-radius: 9px; padding: .58rem .8rem; background: var(--red); color: #fff; font-family: var(--font-display); text-transform: uppercase; letter-spacing: .04em; font-size: .9rem; }
  .hero-item__cmd-btn .ar { transition: transform .2s ease; }
  .hero-item__cmd[data-open="true"] .hero-item__cmd-btn { background: var(--red-deep); }
  .hero-item__cmd[data-open="true"] .hero-item__cmd-btn .ar { transform: rotate(180deg); }
  .hero-item__cmd-menu { display: none; flex-direction: column; margin-top: .4rem; border: 1px solid var(--line-light); border-radius: 9px; overflow: hidden; }
  .hero-item__cmd[data-open="true"] .hero-item__cmd-menu { display: flex; }
  .hero-item__cmd-menu a { display: flex; align-items: center; gap: .5rem; padding: .6rem .7rem; font-size: .85rem; font-weight: 800; color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--line-light); }
  .hero-item__cmd-menu a:last-child { border-bottom: 0; }
  .hero-item__cmd-menu a:hover { background: var(--cream); }
  .hero-item__cmd-menu img { width: 16px; height: 16px; display: block; }
  .hero-ctas { flex-wrap: wrap; align-items: center; gap: .7rem; }
  /* Delivery buttons (brand icons via Simple Icons CDN) */
  .deliver-btn { display: inline-flex; align-items: center; gap: .5rem; padding: .7rem 1.1rem; border-radius: 10px; font-weight: 800; font-size: .92rem; color: #fff; text-decoration: none; line-height: 1; }
  .deliver-btn img { height: 16px; width: 16px; display: block; }
  .deliver-btn--ue { background: #06C167; }
  .deliver-btn--dd { background: #FF3008; }
  .deliver-btn:hover { filter: brightness(1.07); }
</style>
<section class="hero"<%= _heroSlides.length > 1 ? ' data-hero-slider' : '' %>>
  <% _heroSlides.forEach(function(_s, _i){ %>
  <img class="hero-bg hero-slide<%= _i === 0 ? ' is-active' : '' %>" src="<%= cimg(_s, 'f_auto,q_auto,w_1800,c_fill,g_auto') %>" alt="<%= settings.business_name || t.brand %> — <%= t.brand_tag %>"<%- _i > 0 ? ' loading="lazy"' : '' %>>
  <% }); %>
  <div class="hero-overlay"></div>
  <div class="container">
    <div class="hero-inner">
      <span class="eyebrow hero-eyebrow"><%= t.hero_eyebrow %></span>
      <h1 class="hero-title"><%= t.hero_title_1 %> <span class="hl"><%= t.hero_title_hl %></span> <%= t.hero_title_2 %></h1>
      <% var _ue = settings.ubereats_url || 'https://www.ubereats.com'; var _dd = settings.doordash_url || 'https://www.doordash.com'; %>
      <div class="hero-menu">
        <% (typeof heroFeatured !== 'undefined' ? heroFeatured : []).forEach(function(f){ var _img = f.item.image_url; %>
        <div class="hero-item">
          <% if (_img) { %><img class="hero-item__img" src="<%= cimg(_img, 'f_auto,q_auto,w_480,h_360,c_fill,g_auto') %>" alt="<%= pickLang(f.item, 'name', lang) %>" loading="lazy"><% } else { %><span class="hero-item__emoji"><%= f.emoji %></span><% } %>
          <span class="hero-item__b">
            <span class="hero-item__row">
              <span class="hero-item__name"><%= pickLang(f.item, 'name', lang) %></span>
              <% if (f.item.price != null && f.item.price !== '') { %><span class="hero-item__price"><%= formatPrice(f.item.price) %></span><% } %>
            </span>
            <% var _d = pickLang(f.item, 'description', lang); if (_d) { %><span class="hero-item__desc"><%= _d %></span><% } %>
            <div class="hero-item__cmd" data-open="false">
              <button type="button" class="hero-item__cmd-btn"><%= t.order %> <span class="ar" aria-hidden="true">▾</span></button>
              <div class="hero-item__cmd-menu">
                <a href="commander"><%= t.order_now %></a>
                <a href="<%= _ue %>" target="_blank" rel="noopener"><img src="https://cdn.simpleicons.org/ubereats" alt="" width="16" height="16" loading="lazy">Uber Eats</a>
                <a href="<%= _dd %>" target="_blank" rel="noopener"><img src="https://cdn.simpleicons.org/doordash" alt="" width="16" height="16" loading="lazy">DoorDash</a>
              </div>
            </div>
          </span>
        </div>
        <% }); %>
      </div>
    </div>
  </div>
</section>

<div class="seam seam--cream"></div>

<!-- ====================== BRAND STORY ====================== -->
<section class="band band--cream tear-to-black">
  <div class="container">
    <div class="split">
      <div class="split-media">
        <img src="<%= cimg(_story, 'f_auto,q_auto,w_900,h_675,c_fill,g_auto') %>" alt="<%= t.story_eyebrow %>">
        <span class="media-badge"><%= t.story_eyebrow %></span>
      </div>
      <div class="split-body">
        <span class="eyebrow on-light"><%= t.story_eyebrow %></span>
        <h2 class="section-title"><%= t.story_title %></h2>
        <p><%= t.story_p1 %></p>
        <p><%= t.story_p2 %></p>
        <a class="btn btn-red" href="promesse"><%= t.story_cta %></a>
      </div>
    </div>
  </div>
</section>

<!-- ===================== PRODUCT HIGHLIGHTS ===================== -->
<section class="band band--black tear-to-red">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow center"><%= t.highlights_eyebrow %></span>
      <h2 class="section-title"><%= t.highlights_title %></h2>
      <p class="section-sub"><%= t.highlights_sub %></p>
    </div>
    <div class="feature-grid">
      <article class="feature-card">
        <img src="<%= cimg(_family, 'f_auto,q_auto,w_820,h_1020,c_fill,g_auto') %>" alt="<%= t.feat_family_title %>">
        <div class="feature-card__body">
          <span class="feature-tag"><%= t.feat_family_tag %></span>
          <h3><%= t.feat_family_title %></h3>
          <p><%= t.feat_family_desc %></p>
          <a class="feature-card__link" href="menu"><%= t.feat_link %> →</a>
        </div>
      </article>
      <article class="feature-card">
        <img src="<%= cimg(_burger, 'f_auto,q_auto,w_820,h_1020,c_fill,g_auto') %>" alt="<%= t.feat_burger_title %>">
        <div class="feature-card__body">
          <span class="feature-tag"><%= t.feat_burger_tag %></span>
          <h3><%= t.feat_burger_title %></h3>
          <p><%= t.feat_burger_desc %></p>
          <a class="feature-card__link" href="menu"><%= t.feat_link %> →</a>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- ========================= CTA STRIP ========================= -->
<section class="band band--red tear-to-black">
  <div class="container center">
    <h2 class="section-title"><%= t.home_cta_title %></h2>
    <p class="section-sub" style="margin-left:auto;margin-right:auto"><%= t.home_cta_text %></p>
    <div class="cta-strip" style="margin-top:1.8rem">
      <a class="btn btn-gold btn-lg" href="menu"><%= t.home_cta_btn %></a>
    </div>
  </div>
</section>

<script>
(function(){
  var hero = document.querySelector('.hero[data-hero-slider]');
  if (!hero) return;
  var slides = hero.querySelectorAll('.hero-slide');
  if (slides.length < 2) return;
  var i = 0;
  setInterval(function(){
    slides[i].classList.remove('is-active');
    i = (i + 1) % slides.length;
    slides[i].classList.add('is-active');
  }, 5000);
})();
</script>
<script>
(function(){
  var cmds = Array.prototype.slice.call(document.querySelectorAll('.hero-item__cmd'));
  if (!cmds.length) return;
  document.addEventListener('click', function(e){
    var btn = e.target.closest('.hero-item__cmd-btn');
    cmds.forEach(function(c){
      var isThis = btn && c.contains(btn);
      c.setAttribute('data-open', isThis ? (c.getAttribute('data-open') === 'true' ? 'false' : 'true') : 'false');
    });
  });
})();
</script>
<%- include('partials/footer') %>
