<%- include('partials/header', { activeNav: 'home' }) %>
<%
  var _hero = settings._p_hero_image_url || 'https://res.cloudinary.com/duhp69meg/image/upload/v1782232050/redboxpoulet/site/hero.png';
  // Hero slider: one image URL per line in the hero_slides setting. >=2 enables
  // the crossfade slideshow; empty falls back to the single hero image above.
  var _heroSlides = (settings.hero_slides || '').split(/\r?\n/).map(function(s){ return s.trim(); }).filter(Boolean);
  if (!_heroSlides.length) _heroSlides = [_hero];
  var _story = settings._p_story_image_url || 'https://res.cloudinary.com/duhp69meg/image/upload/v1782232050/redboxpoulet/site/vibe.png';
  var _family = settings._p_feature_family_url || 'https://res.cloudinary.com/duhp69meg/image/upload/v1782232051/redboxpoulet/site/packaging.png';
  var _burger = settings._p_feature_burger_url || 'https://res.cloudinary.com/duhp69meg/image/upload/v1782232052/redboxpoulet/site/action.png';
%>

<!-- ============================ HERO ============================ -->
<style>
  /* Hero slider crossfade. Single image = static (no motion). */
  .hero-slide { opacity: 0; transition: opacity 1.1s ease-in-out; }
  .hero-slide.is-active { opacity: 1; }

  /* Cool VIP link in the hero — shimmering gold pill. */
  .hero-vip-row { margin-top: 1.5rem; }
  .hero-vip { position: relative; display: inline-flex; align-items: center; gap: .55rem; overflow: hidden;
    padding: .6rem 1.25rem; border-radius: 999px; font-family: var(--font-display); text-transform: uppercase;
    letter-spacing: .09em; font-size: .95rem; color: var(--gold); text-decoration: none;
    border: 1.5px solid rgba(255,198,41,.6); background: rgba(255,198,41,.08);
    transition: transform .2s ease, box-shadow .25s ease, background .2s ease; }
  .hero-vip:hover { transform: translateY(-1px); background: rgba(255,198,41,.16); box-shadow: 0 10px 26px rgba(255,198,41,.28); }
  .hero-vip .star { font-size: 1.05em; line-height: 1; }
  .hero-vip .arr { transition: transform .2s ease; }
  .hero-vip:hover .arr { transform: translateX(3px); }
  .hero-vip::after { content: ''; position: absolute; top: 0; left: -60%; width: 38%; height: 100%;
    background: linear-gradient(100deg, transparent, rgba(255,255,255,.5), transparent); transform: skewX(-18deg);
    animation: vipShine 3.4s ease-in-out infinite; }
  @keyframes vipShine { 0% { left: -60%; } 55%, 100% { left: 130%; } }
  @media (prefers-reduced-motion: reduce) { .hero-vip::after { display: none; } }
</style>
<section class="hero"<%= _heroSlides.length > 1 ? ' data-hero-slider' : '' %>>
  <% _heroSlides.forEach(function(_s, _i){ %>
  <img class="hero-bg hero-slide<%= _i === 0 ? ' is-active' : '' %>" src="<%= cimg(_s, 'f_auto,q_auto,w_1800,c_fill,g_auto') %>" alt="<%= settings.business_name || t.brand %> — <%= t.brand_tag %>"<%- _i > 0 ? ' loading="lazy"' : '' %>>
  <% }); %>
  <div class="hero-overlay"></div>
  <div class="container">
    <div class="hero-inner">
      <span class="eyebrow hero-eyebrow"><%= t.hero_eyebrow %></span>
      <h1 class="hero-title"><%= t.hero_title_1 %> <span class="hl"><%= t.hero_title_hl %></span> <%= t.hero_title_2 %></h1>
      <div class="hero-tags">
        <span><%= t.hero_tag1 %></span><span><%= t.hero_tag2 %></span><span><%= t.hero_tag3 %></span>
      </div>
      <div class="hero-ctas">
        <a class="btn btn-gold btn-lg" href="menu"><%= t.hero_cta %></a>
        <a class="btn btn-outline" href="promesse"><%= t.nav_promise %></a>
      </div>
      <div class="hero-vip-row">
        <a class="hero-vip" href="vip"><span class="star">★</span> <%= t.hero_vip %> <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

<div class="seam seam--cream"></div>

<!-- ====================== BRAND STORY ====================== -->
<section class="band band--cream tear-to-black">
  <div class="container">
    <div class="split">
      <div class="split-media">
        <img src="<%= cimg(_story, 'f_auto,q_auto,w_900,h_675,c_fill,g_auto') %>" alt="<%= t.story_eyebrow %>">
        <span class="media-badge"><%= t.story_eyebrow %></span>
      </div>
      <div class="split-body">
        <span class="eyebrow on-light"><%= t.story_eyebrow %></span>
        <h2 class="section-title"><%= t.story_title %></h2>
        <p><%= t.story_p1 %></p>
        <p><%= t.story_p2 %></p>
        <a class="btn btn-red" href="promesse"><%= t.story_cta %></a>
      </div>
    </div>
  </div>
</section>

<!-- ===================== PRODUCT HIGHLIGHTS ===================== -->
<section class="band band--black tear-to-red">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow center"><%= t.highlights_eyebrow %></span>
      <h2 class="section-title"><%= t.highlights_title %></h2>
      <p class="section-sub"><%= t.highlights_sub %></p>
    </div>
    <div class="feature-grid">
      <article class="feature-card">
        <img src="<%= cimg(_family, 'f_auto,q_auto,w_820,h_1020,c_fill,g_auto') %>" alt="<%= t.feat_family_title %>">
        <div class="feature-card__body">
          <span class="feature-tag"><%= t.feat_family_tag %></span>
          <h3><%= t.feat_family_title %></h3>
          <p><%= t.feat_family_desc %></p>
          <a class="feature-card__link" href="menu"><%= t.feat_link %> →</a>
        </div>
      </article>
      <article class="feature-card">
        <img src="<%= cimg(_burger, 'f_auto,q_auto,w_820,h_1020,c_fill,g_auto') %>" alt="<%= t.feat_burger_title %>">
        <div class="feature-card__body">
          <span class="feature-tag"><%= t.feat_burger_tag %></span>
          <h3><%= t.feat_burger_title %></h3>
          <p><%= t.feat_burger_desc %></p>
          <a class="feature-card__link" href="menu"><%= t.feat_link %> →</a>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- ========================= CTA STRIP ========================= -->
<section class="band band--red tear-to-black">
  <div class="container center">
    <h2 class="section-title"><%= t.home_cta_title %></h2>
    <p class="section-sub" style="margin-left:auto;margin-right:auto"><%= t.home_cta_text %></p>
    <div class="cta-strip" style="margin-top:1.8rem">
      <a class="btn btn-gold btn-lg" href="menu"><%= t.home_cta_btn %></a>
    </div>
  </div>
</section>

<script>
(function(){
  var hero = document.querySelector('.hero[data-hero-slider]');
  if (!hero) return;
  var slides = hero.querySelectorAll('.hero-slide');
  if (slides.length < 2) return;
  var i = 0;
  setInterval(function(){
    slides[i].classList.remove('is-active');
    i = (i + 1) % slides.length;
    slides[i].classList.add('is-active');
  }, 5000);
})();
</script>
<%- include('partials/footer') %>
