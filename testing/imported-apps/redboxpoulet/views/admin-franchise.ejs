<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Admin — Franchise — RED BOX</title>
<link rel="stylesheet" href="public/css/admin-styles.css">
</head>
<body>
<div class="admin-layout">
<%- include('partials/admin-sidebar', { page: adminPage }) %>
<main class="admin-main">
<div class="admin-header">
  <div>
    <h1>Demandes de franchise</h1>
    <p style="margin:0.25rem 0 0;color:#718096;font-size:0.9rem">Candidatures reçues via le formulaire de franchise.</p>
  </div>
  <a href="." target="_blank" class="btn btn-secondary">🌐 Voir le site</a>
</div>

<% if (!requests || !requests.length) { %>
  <div class="card"><div class="empty"><span class="emoji">📭</span>Aucune demande de franchise pour l'instant.</div></div>
<% } else { %>
<div class="table-wrap">
  <table class="admin-table">
    <thead><tr><th>Date</th><th>Candidat</th><th>Ville</th><th>Expérience / message</th><th>Statut</th><th></th></tr></thead>
    <tbody>
      <% requests.forEach(function(f){
        var dt = f.created_at ? new Date(f.created_at) : null;
        var when = dt && !isNaN(dt) ? dt.toLocaleString('fr-CA') : '';
        var mailSubj = encodeURIComponent('RE: Demande de franchise RED BOX');
      %>
      <tr data-row="<%= f.id %>">
        <td><span class="cell-meta"><%= when %></span><% if (f.locale) { %><br><span class="badge badge-muted"><%= String(f.locale).toUpperCase() %></span><% } %></td>
        <td>
          <strong><%= f.full_name || '—' %></strong><br>
          <a href="mailto:<%= f.email %>" class="cell-meta"><%= f.email || '' %></a>
          <% if (f.phone) { %><br><span class="cell-meta"><%= f.phone %></span><% } %>
        </td>
        <td><%= f.city || '—' %></td>
        <td><div class="msg-text"><%= f.experience || '' %></div></td>
        <td><% if (Number(f.handled)) { %><span class="badge badge-success">Traitée</span><% } else { %><span class="badge badge-warn">Nouvelle</span><% } %></td>
        <td class="row-actions">
          <a class="btn btn-secondary btn-sm" href="mailto:<%= f.email %>?subject=<%= mailSubj %>">↩️ Répondre</a>
          <button type="button" class="btn btn-secondary btn-sm" data-toggle="<%= f.id %>" data-handled="<%= Number(f.handled) ? 1 : 0 %>"><%= Number(f.handled) ? '↺ Marquer non traitée' : '✓ Marquer traitée' %></button>
          <button type="button" class="btn btn-danger btn-sm" data-del="<%= f.id %>">🗑️</button>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<% } %>

</main>
</div>
<div class="toast" id="toast"></div>
<script>
function toast(msg, type) {
  var el = document.getElementById('toast');
  el.className = 'toast toast-' + (type || 'success');
  el.textContent = msg;
  setTimeout(function(){ el.classList.add('show'); }, 10);
  setTimeout(function(){ el.classList.remove('show'); }, 2600);
}
document.querySelectorAll('[data-toggle]').forEach(function(b){
  b.addEventListener('click', async function(){
    var id = b.getAttribute('data-toggle');
    var newHandled = Number(b.getAttribute('data-handled')) ? false : true;
    b.disabled = true;
    try {
      var r = await fetch('api/admin/franchise_requests/' + id, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ handled: newHandled }) });
      var data = await r.json().catch(function(){ return {}; });
      if (r.ok && data.success) { toast('Statut mis à jour', 'success'); setTimeout(function(){ location.reload(); }, 450); }
      else { toast('Erreur', 'error'); b.disabled = false; }
    } catch(e) { toast('Erreur réseau', 'error'); b.disabled = false; }
  });
});
document.querySelectorAll('[data-del]').forEach(function(b){
  b.addEventListener('click', async function(){
    if (!confirm('Supprimer cette demande ?')) return;
    try {
      var r = await fetch('api/admin/franchise_requests/' + b.getAttribute('data-del'), { method: 'DELETE' });
      var data = await r.json().catch(function(){ return {}; });
      if (r.ok && data.success) { toast('Demande supprimée', 'success'); setTimeout(function(){ location.reload(); }, 450); }
      else { toast('Erreur de suppression', 'error'); }
    } catch(e) { toast('Erreur réseau', 'error'); }
  });
});
</script>
</body>
</html>
