<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Admin — RED BOX</title>
<link rel="stylesheet" href="public/css/admin-styles.css">
</head>
<body>
<div class="admin-layout">
<%- include('partials/admin-sidebar', { page: adminPage }) %>
<main class="admin-main">
<div class="admin-header">
  <div>
    <h1>Tableau de bord</h1>
    <p style="margin:0.25rem 0 0;color:#718096;font-size:0.9rem">Bienvenue dans le panneau d'administration de RED BOX.</p>
  </div>
  <div style="display:flex;gap:0.5rem;flex-wrap:wrap">
    <a href="." target="_blank" class="btn btn-secondary">🌐 Voir le site</a>
    <a href="admin/menu" class="btn btn-primary">🍴 Gérer le menu</a>
  </div>
</div>

<h2 class="admin-section-title">Activité du site</h2>
<div class="stat-grid">
  <div class="stat-card"><div class="label">Visites totales</div><div class="value"><%= stats.visits %></div></div>
  <div class="stat-card"><div class="label">7 derniers jours</div><div class="value"><%= stats.visits7 %></div></div>
  <div class="stat-card">
    <div class="label">Messages</div>
    <% if (stats.newMessages > 0) { %><span class="badge badge-red pill"><%= stats.newMessages %> nouveau<%= stats.newMessages > 1 ? 'x' : '' %></span><% } %>
    <div class="value"><%= stats.messages %></div>
  </div>
  <div class="stat-card">
    <div class="label">Demandes de franchise</div>
    <% if (stats.newFranchise > 0) { %><span class="badge badge-red pill"><%= stats.newFranchise %> nouvelle<%= stats.newFranchise > 1 ? 's' : '' %></span><% } %>
    <div class="value"><%= stats.franchise %></div>
  </div>
</div>

<h2 class="admin-section-title">Gestion du contenu</h2>
<div class="module-grid">
  <a href="admin/menu" class="module-card">
    <div class="module-icon">🍴</div>
    <h3>Menu</h3>
    <p><strong><%= stats.menu %></strong> élément<%= stats.menu > 1 ? 's' : '' %> au menu</p>
  </a>
  <a href="admin/messages" class="module-card">
    <div class="module-icon">✉️</div>
    <h3>Messages</h3>
    <p><strong><%= stats.messages %></strong> message<%= stats.messages > 1 ? 's' : '' %><% if (stats.newMessages > 0) { %> · <span style="color:#E11313;font-weight:700"><%= stats.newMessages %> non traité<%= stats.newMessages > 1 ? 's' : '' %></span><% } %></p>
  </a>
  <a href="admin/franchise" class="module-card">
    <div class="module-icon">🤝</div>
    <h3>Franchise</h3>
    <p><strong><%= stats.franchise %></strong> demande<%= stats.franchise > 1 ? 's' : '' %><% if (stats.newFranchise > 0) { %> · <span style="color:#E11313;font-weight:700"><%= stats.newFranchise %> non traitée<%= stats.newFranchise > 1 ? 's' : '' %></span><% } %></p>
  </a>
  <a href="admin/settings" class="module-card">
    <div class="module-icon">⚙️</div>
    <h3>Paramètres</h3>
    <p>Informations, réseaux sociaux et images</p>
  </a>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-top:2rem">
  <div class="card">
    <h2 style="font-size:1.1rem">✉️ Messages récents</h2>
    <% if (!recentMessages || !recentMessages.length) { %>
      <div class="empty"><span class="emoji">📭</span>Aucun message pour l'instant.</div>
    <% } else { %>
      <table class="admin-table">
        <thead><tr><th>Nom</th><th>Sujet</th><th>Statut</th></tr></thead>
        <tbody>
          <% recentMessages.forEach(function(m){ %>
          <tr>
            <td><strong><%= m.name %></strong><br><span class="cell-meta"><%= m.email %></span></td>
            <td><%= m.subject || '—' %></td>
            <td><% if (m.handled) { %><span class="badge badge-success">Traité</span><% } else { %><span class="badge badge-warn">Nouveau</span><% } %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      <div style="margin-top:1rem"><a href="admin/messages" class="btn btn-secondary btn-sm">Voir tous les messages →</a></div>
    <% } %>
  </div>
  <div class="card">
    <h2 style="font-size:1.1rem">🤝 Demandes de franchise récentes</h2>
    <% if (!recentFranchise || !recentFranchise.length) { %>
      <div class="empty"><span class="emoji">📭</span>Aucune demande pour l'instant.</div>
    <% } else { %>
      <table class="admin-table">
        <thead><tr><th>Nom</th><th>Ville</th><th>Statut</th></tr></thead>
        <tbody>
          <% recentFranchise.forEach(function(f){ %>
          <tr>
            <td><strong><%= f.full_name %></strong><br><span class="cell-meta"><%= f.email %></span></td>
            <td><%= f.city || '—' %></td>
            <td><% if (f.handled) { %><span class="badge badge-success">Traitée</span><% } else { %><span class="badge badge-warn">Nouvelle</span><% } %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      <div style="margin-top:1rem"><a href="admin/franchise" class="btn btn-secondary btn-sm">Voir toutes les demandes →</a></div>
    <% } %>
  </div>
</div>
</main>
</div>
</body>
</html>
