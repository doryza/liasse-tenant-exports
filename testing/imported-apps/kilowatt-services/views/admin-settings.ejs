<%- include('partials/header') %>
<div class="admin-layout"><%- include('partials/admin-sidebar') %><main id="main" class="admin-main"><header class="admin-heading"><h1><%= t.settingsLabel %></h1></header><p class="admin-notice"><%= mailConfigured ? t.mailConfigured : t.mailNotConfigured %></p><p><%= t.deliveryBoundary %></p><form id="settings-form" class="admin-panel" action="api/admin/settings" method="post"><h2><%= t.publicContacts %></h2><p><%= t.contactSettingsHelp %></p><% const settingFields = [['business_name','businessName','text'],['installation_name','installationName','text'],['installation_email','installationEmail','email'],['installation_phone','installationPhone','tel'],['service_name','serviceName','text'],['contact_email','serviceEmail','email'],['contact_phone','servicePhone','tel'],['business_address','businessAddress','text']]; settingFields.forEach(([key,label,type]) => { %><div class="field"><label for="setting-<%= key %>"><%= t[label] %></label><input id="setting-<%= key %>" name="<%= key %>" type="<%= type %>" value="<%= settings[key] || '' %>" maxlength="500"></div><% }); %><div class="field"><label class="checkbox-label"><input type="checkbox" name="mail_delivery_enabled" <%= settings.mail_delivery_enabled === 'true' ? 'checked' : '' %>><span><%= t.mailEnable %></span></label><small><%= t.mailHelp %></small></div><p id="settings-status" role="status"></p><button class="button button-brand" type="submit"><%= t.save %></button></form><p><%= t.inlineHelp %></p></main></div>
<script src="public/js/admin.js" defer></script>
<%- include('partials/footer') %>