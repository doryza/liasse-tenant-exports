<%- include('partials/header') %>
<main id="main" class="wrap">
<header class="page-intro"><p class="eyebrow" data-lk="t:territory"><%= t.territory %></p><h1 data-lk="t:<%= kind === 'quote' ? 'quoteTitle' : 'appointmentTitle' %>"><%= kind === 'quote' ? t.quoteTitle : t.appointmentTitle %></h1><p class="lead" data-lk="t:<%= kind === 'quote' ? 'quoteIntro' : 'appointmentIntro' %>"><%= kind === 'quote' ? t.quoteIntro : t.appointmentIntro %></p></header>
<div class="request-layout">
<section class="form-surface">
<% if (kind === 'quote' || (typeof user !== 'undefined' && user)) { %>
<% if (kind === 'appointment') { %><p class="notice" data-lk="t:calendarNotice"><%= t.calendarNotice %></p><% } else { %><p class="small" data-lk="t:quoteAccountNote"><%= t.quoteAccountNote %></p><% } %>
<form id="request-form" action="api/<%= kind === 'quote' ? 'quotes' : 'appointments' %>" method="post" data-kind="<%= kind %>" novalidate>
<input type="hidden" name="request_key" value="<%= requestKey %>"><div class="honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
<div id="form-fields">
<p class="small" data-lk="t:requiredNote"><%= t.requiredNote %></p>
<% if (kind === 'appointment') { %><div class="field"><label for="reason" data-lk="t:reason"><%= t.reason %> *</label><select id="reason" name="reason" required><% ['quote','maintenance','startup','repair','warranty','parts'].forEach(value => { %><option value="<%= value %>" <%= reason === value ? 'selected' : '' %>><%= t['v_' + value] %></option><% }); %></select><small id="error-reason" class="field-error" aria-live="polite"></small></div><% } %>
<div class="field"><label for="name" data-lk="t:name"><%= t.name %> *</label><input id="name" name="name" maxlength="120" required autocomplete="name" placeholder="<%= t.namePlaceholder %>"><small id="error-name" class="field-error" aria-live="polite"></small></div>
<div class="field"><label for="email" data-lk="t:email"><%= t.email %> *</label><input id="email" name="email" type="email" maxlength="254" required autocomplete="email" placeholder="<%= t.emailPlaceholder %>"><small id="error-email" class="field-error" aria-live="polite"></small></div>
<div class="field"><label for="phone" data-lk="t:phone"><%= t.phone %> *</label><input id="phone" name="phone" type="tel" maxlength="32" required autocomplete="tel" placeholder="<%= t.phonePlaceholder %>"><small id="error-phone" class="field-error" aria-live="polite"></small></div>
<div class="field"><label for="municipality" data-lk="t:municipality"><%= t.municipality %> *</label><input id="municipality" name="municipality" maxlength="120" required autocomplete="address-level2" placeholder="<%= t.municipalityPlaceholder %>"><small id="error-municipality" class="field-error" aria-live="polite"></small></div>
<div class="field"><label for="customer_type" data-lk="t:customerType"><%= t.customerType %> *</label><select id="customer_type" name="customer_type" required><option value=""><%= t.select %></option><option value="residential"><%= t.v_residential %></option><option value="commercial"><%= t.v_commercial %></option></select><small id="error-customer_type" class="field-error" aria-live="polite"></small></div>
<% if (kind === 'appointment') { %><div class="field"><label for="requested_date" data-lk="t:requestedDate"><%= t.requestedDate %></label><input id="requested_date" type="date" name="requested_date" min="<%= today %>"><small id="error-requested_date" class="field-error" aria-live="polite"></small></div><div class="field"><label for="preferred_period" data-lk="t:period"><%= t.period %></label><select id="preferred_period" name="preferred_period"><% ['flexible','morning','afternoon'].forEach(value => { %><option value="<%= value %>"><%= t['v_' + value] %></option><% }); %></select></div><div class="field"><label for="model" data-lk="t:model"><%= t.model %></label><input id="model" name="model" maxlength="120" placeholder="<%= t.modelPlaceholder %>"></div><div class="field"><label for="serial_number" data-lk="t:serial"><%= t.serial %></label><input id="serial_number" name="serial_number" maxlength="120" placeholder="<%= t.serialPlaceholder %>"></div><% } %>
<div class="field"><label for="message" data-lk="t:message"><%= t.message %></label><textarea id="message" name="message" rows="5" maxlength="4000" placeholder="<%= t.messagePlaceholder %>"></textarea><small id="error-message" class="field-error" aria-live="polite"></small></div>
<p class="small" data-lk="t:requestPrivacy"><%= t.requestPrivacy %></p><a class="privacy-link" href="<%= link('privacy') %>" data-lk="t:privacyLink"><%= t.privacyLink %></a>
</div>
<section id="review-panel" hidden tabindex="-1"><h2 data-lk="t:reviewTitle"><%= t.reviewTitle %></h2><dl id="review-list"></dl><p class="notice" data-lk="t:calendarNotice"><%= t.calendarNotice %></p><button class="text-button" id="edit-request" type="button" data-lk="t:editRequest"><%= t.editRequest %></button></section>
<p id="form-status" class="form-status" role="alert" tabindex="-1"></p><button class="button button-brand" id="send-request" type="submit" data-lk="t:<%= kind === 'appointment' ? 'review' : 'sendQuote' %>"><%= kind === 'appointment' ? t.review : t.sendQuote %></button>
</form>
<section id="request-success" hidden tabindex="-1"><span class="success-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 4 4 10-10"/></svg></span><h2 data-lk="t:savedTitle"><%= t.savedTitle %></h2><p id="success-message"></p><p><span data-lk="t:reference"><%= t.reference %></span> <strong id="request-reference"></strong></p><div class="actions"><a class="button button-brand" href="<%= link('account') %>" data-auth-only style="display:none" data-lk="t:account"><%= t.account %></a><a class="button button-outline" href="<%= link(kind === 'quote' ? 'quote' : 'appointment') %>" data-lk="t:anotherRequest"><%= t.anotherRequest %></a></div></section>
<script src="public/js/request.js" defer></script>
<% } else { %><p class="notice" data-lk="t:calendarNotice"><%= t.calendarNotice %></p><h2 data-lk="t:requestAppointment"><%= t.requestAppointment %></h2><p data-lk="t:bookingLogin"><%= t.bookingLogin %></p><button class="button button-brand" data-login-btn data-lk="t:login"><%= t.login %></button><% } %>
</section>
<aside class="request-aside"><h2 data-lk="t:directTitle"><%= t.directTitle %></h2><div id="installation-contact" <%= kind !== 'quote' && reason !== 'quote' ? 'hidden' : '' %>><%- include('partials/contact-block',{department:'installation'}) %></div><div id="service-contact" <%= kind === 'quote' || reason === 'quote' ? 'hidden' : '' %>><%- include('partials/contact-block',{department:'service'}) %></div><div class="aside-rule"><p data-lk="t:financeShort"><%= t.financeShort %></p><a class="arrow-link" href="<%= link('appointment') %>?motif=maintenance" data-lk="t:serviceInstead"><%= t.serviceInstead %></a></div></aside>
</div>
</main>
<%- include('partials/footer') %>