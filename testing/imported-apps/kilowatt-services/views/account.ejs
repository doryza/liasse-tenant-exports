<%- include('partials/header') %>
<main id="main" class="wrap account-page"><header class="page-intro"><h1 data-lk="t:accountTitle"><%= t.accountTitle %></h1><p class="lead" data-lk="t:accountIntro"><%= t.accountIntro %></p></header>
<% if (typeof user !== 'undefined' && user) { %><div id="account-requests" aria-live="polite"><p data-lk="t:loading"><%= t.loading %></p></div><p id="account-status" role="status"></p><div class="pagination"><button id="account-prev" class="button button-outline" data-lk="t:previous"><%= t.previous %></button><span id="account-page"></span><button id="account-next" class="button button-outline" data-lk="t:next"><%= t.next %></button></div><button class="text-button" id="user-logout" data-lk="t:logout"><%= t.logout %></button><script src="public/js/account.js" defer></script><% } else { %><section class="empty"><p data-lk="t:accountLogin"><%= t.accountLogin %></p><button class="button button-white" data-login-btn data-lk="t:login"><%= t.login %></button></section><% } %>
<div class="actions"><a class="button button-brand" href="<%= link('quote') %>" data-lk="t:askQuote"><%= t.askQuote %></a><a class="button button-outline" href="<%= link('appointment') %>" data-lk="t:requestAppointment"><%= t.requestAppointment %></a></div></main>
<%- include('partials/footer') %>