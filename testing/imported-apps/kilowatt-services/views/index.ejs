<%- include('partials/header') %>
<main id="main">
<section class="hero wrap">
<div class="hero-copy"><p class="eyebrow" data-lk="t:territory"><%= t.territory %></p><h1 data-lk="t:heroTitle"><%= t.heroTitle %></h1><p class="lead" data-lk="t:heroSubtitle"><%= t.heroSubtitle %></p><div class="actions"><a class="button button-brand" href="<%= link('quote') %>" data-lk="t:askQuote"><%= t.askQuote %></a><a class="button button-outline" href="<%= link('appointment') %>" data-lk="t:book"><%= t.book %></a></div></div>
<aside class="hero-diagram"><p class="eyebrow" data-lk="t:journeyLabel"><%= t.journeyLabel %></p><% if (typeof steps !== 'undefined' && steps.length) { %><ol class="diagram"><% steps.forEach((step,i) => { %><li><span class="node" aria-hidden="true"><%= i + 1 %></span><a href="<%= link('services') %>#<%= step.target %>" data-content-source="steps:<%= fieldName(step,'title') %>" data-content-id="<%= step.id %>"><%= field(step,'title') %></a></li><% }); %></ol><% } else { %><p data-lk="t:emptyContent"><%= t.emptyContent %></p><% } %></aside>
</section>
<div class="proof-strip"><div class="wrap proofs"><p data-lk="t:proofDealer"><%= t.proofDealer %></p><p data-lk="t:proofTech"><%= t.proofTech %></p><p data-lk="t:proofQuote"><%= t.proofQuote %></p></div></div>
<section class="wrap section journey"><div class="section-intro"><h2 data-lk="t:journeyTitle"><%= t.journeyTitle %></h2><p data-lk="t:journeyIntro"><%= t.journeyIntro %></p></div><% if (typeof steps !== 'undefined' && steps.length) { %><ol class="timeline"><% steps.forEach((step,i) => { %><li><span class="node" aria-hidden="true"><%= i + 1 %></span><div><h3 data-content-source="steps:<%= fieldName(step,'title') %>" data-content-id="<%= step.id %>"><%= field(step,'title') %></h3><p data-content-source="steps:<%= fieldName(step,'content') %>" data-content-id="<%= step.id %>"><%= field(step,'content') %></p><% if (step.image_url) { %><img class="content-image" loading="lazy" src="<%= step.image_url %>" alt="<%= field(step,'title') %>" data-content-source="steps:image_url" data-content-id="<%= step.id %>"><% } %><a class="arrow-link" href="<%= link('services') %>#<%= step.target %>" data-lk="t:details"><%= t.details %><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></a></div></li><% }); %></ol><% } else { %><p data-lk="t:emptyContent"><%= t.emptyContent %></p><% } %></section>
<section class="needs"><div class="wrap"><h2 data-lk="t:needsTitle"><%= t.needsTitle %></h2><div class="need-split"><article><h3 data-lk="t:newTitle"><%= t.newTitle %></h3><p data-lk="t:newBody"><%= t.newBody %></p><a class="button button-brand" href="<%= link('quote') %>" data-lk="t:askQuote"><%= t.askQuote %></a></article><article><h3 data-lk="t:existingTitle"><%= t.existingTitle %></h3><p data-lk="t:existingBody"><%= t.existingBody %></p><a class="button button-white" href="<%= link('appointment') %>" data-lk="t:requestAppointment"><%= t.requestAppointment %></a></article></div></div></section>
<section class="wrap section faq"><h2 data-lk="t:faqTitle"><%= t.faqTitle %></h2><div><% if (typeof faqs !== 'undefined' && faqs.length) { %><% faqs.forEach(item => { %><details><summary data-content-source="faqs:<%= fieldName(item,'title') %>" data-content-id="<%= item.id %>"><%= field(item,'title') %></summary><p data-content-source="faqs:<%= fieldName(item,'content') %>" data-content-id="<%= item.id %>"><%= field(item,'content') %></p><% if (item.image_url) { %><img class="content-image" loading="lazy" src="<%= item.image_url %>" alt="<%= field(item,'title') %>" data-content-source="faqs:image_url" data-content-id="<%= item.id %>"><% } %></details><% }); %><% } else { %><p data-lk="t:emptyContent"><%= t.emptyContent %></p><% } %></div></section>
</main>
<%- include('partials/footer') %>