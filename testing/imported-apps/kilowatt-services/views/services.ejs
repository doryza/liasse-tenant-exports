<%- include('partials/header') %>
<main id="main" class="wrap">
<header class="page-intro"><p class="eyebrow" data-lk="t:territory"><%= t.territory %></p><h1 data-lk="t:servicesTitle"><%= t.servicesTitle %></h1><p class="lead" data-lk="t:servicesIntro"><%= t.servicesIntro %></p></header>
<% if (typeof items !== 'undefined' && items.length) { %><nav class="service-index" aria-label="<%= t.services %>"><% items.forEach(item => { %><a href="<%= link('services') %>#<%= item.anchor %>" data-content-source="services:<%= fieldName(item,'title') %>" data-content-id="<%= item.id %>"><%= field(item,'title') %></a><% }); %></nav><div class="service-list"><% items.forEach(item => { %><section id="<%= item.anchor %>" class="service-section <%= item.anchor === 'maintenance' ? 'charcoal-section' : '' %>"><div><h2 data-content-source="services:<%= fieldName(item,'title') %>" data-content-id="<%= item.id %>"><%= field(item,'title') %></h2></div><div><p class="preserve" data-content-source="services:<%= fieldName(item,'content') %>" data-content-id="<%= item.id %>"><%= field(item,'content') %></p><% if (item.image_url) { %><img class="content-image" loading="lazy" src="<%= item.image_url %>" alt="<%= field(item,'title') %>" data-content-source="services:image_url" data-content-id="<%= item.id %>"><% } %><a class="button <%= item.action === 'quote' ? 'button-brand' : 'button-white' %>" href="<%= item.action === 'quote' ? link('quote') : link('appointment') + '?motif=' + encodeURIComponent(item.action) %>" data-lk="t:<%= item.action === 'quote' ? 'askQuote' : 'requestAppointment' %>"><%= item.action === 'quote' ? t.askQuote : t.requestAppointment %></a></div></section><% }); %></div><% } else { %><section class="empty"><p data-lk="t:emptyContent"><%= t.emptyContent %></p><a class="button button-white" href="<%= link('contact') %>" data-lk="t:contact"><%= t.contact %></a></section><% } %>
<section class="service-end"><div><p data-lk="t:financeShort"><%= t.financeShort %></p><p class="muted" data-lk="t:sourceNote"><%= t.sourceNote %></p></div><%- include('partials/contact-block',{department:'service'}) %></section>
</main>
<%- include('partials/footer') %>