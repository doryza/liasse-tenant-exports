<% const adminModule = typeof module !== 'undefined' && module && module.key ? module : {key:'',label:t.adminLink,fields:[]}; %>
<%- include('header') %>
<div class="admin-layout"><%- include('admin-sidebar') %><main id="main" class="admin-main"><header class="admin-heading"><h1><%= adminModule.label %></h1><button class="button button-brand" style="background-color:var(--brand);color:#fff" id="add-item"><%= t.add %></button></header><% if (adminModule.key === 'posts') { %><p class="admin-notice"><%= t.draftNote %></p><% } %><% if (adminModule.key === 'requests') { %><p class="admin-notice"><%= t.requestAdminNote %></p><% } %><div class="admin-toolbar"><label><span><%= t.filter %></span><input id="admin-search" type="search" placeholder="<%= t.filter %>"></label><label><span><%= t.sort %></span><select id="admin-sort"><option value="newest"><%= t.newest %></option><option value="oldest"><%= t.oldest %></option><option value="alphabetic"><%= t.alphabetic %></option></select></label></div><p id="admin-status" role="status"></p><div class="table-scroll admin-panel"><table><thead><tr><th><%= t.record %></th><th><%= t.status %></th><th><%= t.created %></th><th><%= t.actions %></th></tr></thead><tbody id="admin-rows"><% if (typeof items !== 'undefined' && items.length) { %><% items.slice(0,10).forEach(item => { %><tr><td><%= item.title || item.name || item.reference || item.id %></td><td><%= item.status ? t['v_' + item.status] : item.published ? t.v_yes : t.v_no %></td><td><%= new Date(item.created_at).toLocaleDateString(lang === 'fr' ? 'fr-CA' : 'en-CA') %></td><td><button class="table-action" data-edit="<%= item.id %>"><%= t.edit %></button><button class="table-action" data-delete="<%= item.id %>"><%= t.remove %></button></td></tr><% }); %><% } else { %><tr><td colspan="4"><%= t.noItems %></td></tr><% } %></tbody></table></div><div class="pagination"><button id="admin-prev" class="button button-outline"><%= t.previous %></button><span id="admin-page"></span><button id="admin-next" class="button button-outline"><%= t.next %></button></div></main></div>
<dialog id="edit-dialog" class="admin-dialog"><form id="editor-form" action="api/admin/<%= adminModule.key %>" method="post"><header><h2 id="editor-title"><%= t.edit %></h2><button type="button" id="close-editor" class="table-action"><%= t.close %></button></header><div id="editor-fields"></div><p id="editor-error" role="alert"></p><div class="dialog-actions"><button class="button button-brand" style="background-color:var(--brand);color:#fff" id="save-item" type="submit"><%= t.save %></button></div></form></dialog>
<script>window.ADMIN=<%- JSON.stringify({module:adminModule,items:typeof items !== 'undefined' ? items : []}).replace(/</g,'\\u003c') %>;</script>
<script src="public/js/admin.js" defer></script>
<%- include('footer') %>