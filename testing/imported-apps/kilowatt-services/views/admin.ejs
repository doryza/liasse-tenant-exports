<%- include('partials/header') %>
<div class="admin-layout"><%- include('partials/admin-sidebar') %><main id="main" class="admin-main"><header class="admin-heading"><div><h1><%= t.dashboard %></h1><p><%= t.adminIntro %></p></div><a class="button button-white" href="admin/requests"><%= t.recentRequests %></a></header><% if (!mailReady) { %><p class="admin-notice"><%= t.mailWarning %> <a href="admin/settings"><%= t.settingsLabel %></a></p><% } %><div class="stats-grid"><% [['visits',stats.totalVisits],['recentVisits',stats.recentVisits],['users',stats.userCount],['subscribers',stats.pushSubscriberCount]].forEach(item => { %><article><span><%= t[item[0]] %></span><strong><%= item[1] %></strong></article><% }); %></div><div class="module-grid"><% if (typeof modules !== 'undefined' && modules.length) { %><% modules.forEach(module => { %><a href="admin/<%= module.key %>"><span><%= module.label %></span><strong><%= stats.counts[module.key] || 0 %></strong><span><%= t.manage %> →</span></a><% }); %><% } else { %><p><%= t.noItems %></p><% } %></div><section class="admin-panel"><h2><%= t.recentRequests %></h2><% if (typeof recent !== 'undefined' && recent.length) { %><div class="table-scroll"><table><thead><tr><th><%= t.reference %></th><th><%= t.name %></th><th><%= t.reason %></th><th><%= t.status %></th></tr></thead><tbody><% recent.forEach(row => { %><tr><td><a href="admin/requests"><%= row.reference || row.id %></a></td><td><%= row.name %></td><td><%= t['v_' + row.reason] || row.reason %></td><td><%= t['v_' + row.status] || row.status %></td></tr><% }); %></tbody></table></div><% } else { %><p><%= t.noSubmissions %></p><% } %></section><section class="admin-panel"><h2><%= t.launchChecklist %></h2><p><%= t.launchHelp %></p></section></main></div>
<script src="public/js/admin.js" defer></script>
<%- include('partials/footer') %>