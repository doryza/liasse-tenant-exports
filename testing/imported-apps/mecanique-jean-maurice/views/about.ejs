<%- include('partials/header') %>
<section class="page-head">
  <div class="wrap">
    <div class="crumbs"><a href="<%= urls.home %>"><%= t.home %></a> / <%= t.about %></div>
    <h1><%= settings.business_name %></h1>
    <p><%= lang === 'en' ? 'General repair shop — Mirabel' : 'Atelier de mécanique générale — Mirabel' %></p>
  </div>
</section>
<section class="section">
  <div class="wrap band">
    <div>
      <img src="<%= assets.logo.replace('/upload/', '/upload/w_1200,f_auto,q_auto/') %>" alt="<%= settings.business_name %>" width="1152" height="768" style="border-radius:16px;border:1px solid #000">
      <div class="prose pre-line" style="margin-top:26px" data-lk="about_text"><%= settings.about_text %></div>
      <h2 class="h2" style="font-size:34px;margin:30px 0 14px"><%= t.services %></h2>
      <ul class="signs" style="grid-template-columns:repeat(2,minmax(0,1fr))"><% services.forEach(function (s) { %><li><a href="<%= urls.service %><%= s.slug %>/"><%= field(s, 'name') %></a></li><% }); %></ul>
    </div>
    <div>
      <h2 class="h2" id="heures" style="font-size:34px;margin-bottom:14px"><%= t.hours %></h2>
      <% if (hoursKnown) { %>
      <table class="hours-table">
        <% hours.forEach(function (h) { %><tr class="<%= h.weekday === todayWeekday ? 'is-today' : '' %>"><td><%= t['day' + h.weekday] %></td><td><%= h.closed ? t.closed : clock(h.opens) + ' – ' + clock(h.closes) %></td></tr><% }); %>
      </table>
      <% } else { %><p class="hours-tbc"><%= t.hours_tbc %> <a href="<%= phoneHref %>"><%= settings.contact_phone %></a></p><% } %>
      <% if (upcomingClosures.length) { %><p class="small muted" style="margin-top:12px"><%= lang === 'en' ? 'Closed on: ' : 'Fermé le : ' %><%= upcomingClosures.map(function (c) { return formatShort(c.date) + (field(c, 'reason') ? ' (' + field(c, 'reason') + ')' : ''); }).join(', ') %></p><% } %>
      <ul class="info-list" style="margin-top:28px">
        <li><%- include('partials/icon', { name: 'pin' }) %><div><b><%= t.address %></b><a href="<%= directionsHref %>" target="_blank" rel="noopener"><%= settings.business_address %></a></div></li>
        <li><%- include('partials/icon', { name: 'phone' }) %><div><b><%= t.phone %></b><a href="<%= phoneHref %>"><%= settings.contact_phone %></a></div></li>
        <li><%- include('partials/icon', { name: 'card' }) %><div><b><%= t.payment_methods %></b><span data-lk="payment_methods"><%= settings.payment_methods %></span></div></li>
        <li><%- include('partials/icon', { name: 'car' }) %><div><b><%= t.areas %></b><span data-lk="service_areas"><%= settings.service_areas %></span></div></li>
      </ul>
      <div class="map" style="margin-top:24px"><% if (mapEmbed) { %><iframe src="<%= mapEmbed %>" title="<%= t.address %>" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe><% } else { %><div class="map-fallback"><a class="btn btn-line btn-sm" href="<%= directionsHref %>" target="_blank" rel="noopener"><%= t.directions %></a></div><% } %></div>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
