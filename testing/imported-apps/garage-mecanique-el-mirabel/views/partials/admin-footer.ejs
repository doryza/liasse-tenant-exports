  <%
    var TAB_ICON = {
      today: '<path d="M9 4h6M9 4a1 1 0 0 0-1 1v1h8V5a1 1 0 0 0-1-1M8 6H6a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-2"/><path d="m9 14 2 2 4-4"/>',
      board: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
      documents: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>',
      clients: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M18 14a5.5 5.5 0 0 1 3.5 6"/>',
    };
    [['today', 'admin', tr('Aujourd’hui', 'Today')], ['board', 'admin/rendez-vous', tr('Rendez-vous', 'Bookings')], ['documents', 'admin/documents', tr('Factures', 'Invoices')], ['clients', 'admin/clients', tr('Clients', 'Customers')]].forEach(function (x) { %>
    <a href="<%= x[1] %>"<%- adminSection === x[0] ? ' aria-current="page"' : '' %>><svg viewBox="0 0 24 24" aria-hidden="true"><%- TAB_ICON[x[0]] %></svg><%= x[2] %></a>
  <% }); %>
  <button type="button" data-admin-menu<%- ['services', 'hours', 'messages', 'settings'].includes(adminSection) ? ' aria-current="page"' : '' %>><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg><%= tr('Plus', 'More') %><% if (navCounts.messages) { %> ·<%= navCounts.messages %><% } %></button>
</nav>
<div class="drawer-backdrop" data-backdrop></div>
<div class="toast" data-toast role="status" aria-live="polite" hidden></div>
<script id="page-data" type="application/json"><%- safeJSON(Object.assign({ t: t, lang: lang, urls: urls, page: page, flags: flags, section: adminSection }, typeof pageData !== 'undefined' ? pageData : {})) %></script>
<script src="public/js/app.js"></script>
<script src="public/js/admin-core.js"></script>
<% (typeof scripts !== 'undefined' ? scripts : []).forEach(function (s) { %><script src="public/js/<%= s %>.js"></script><% }); %>
