        {
          "key": "business_name",
          "value": "Ember & Oak",
          "updated_at": "2026-07-07T20:50:05.046Z"
        },
        {
          "key": "tagline",
          "value": "Montreal micro-roastery",
          "updated_at": "2026-07-07T20:50:05.054Z"
        },
        {
          "key": "hero_eyebrow",
          "value": "Mile End · Montreal",
          "updated_at": "2026-07-07T20:50:05.062Z"
        },
        {
          "key": "hero_title",
          "value": "Roasted small. Drawn by hand. Montreal.",
          "updated_at": "2026-07-07T20:50:05.069Z"
        },
        {
          "key": "hero_subtitle",
          "value": "We roast in five-kilo batches on a single drum, pulling each one by eye and ear until the cherry shows up. One fire, one hand, from green bean to your cup.",
          "updated_at": "2026-07-07T20:50:05.077Z"
        },
        {
          "key": "hero_cta",
          "value": "See the roasts",
          "updated_at": "2026-07-07T20:50:05.086Z"
        },
        {
          "key": "story_heading",
          "value": "How the fire got started",
          "updated_at": "2026-07-07T20:50:05.094Z"
        },
        {
          "key": "story_text",
          "value": "It began in a narrow alley off Saint-Laurent in 2016, with a secondhand five-kilo drum and a stack of green Ethiopian we could barely afford. We roasted at night, cracked the door to let the smoke out, and handed bags to anyone who would take one. The neighbours started knocking. A cafe on Bernard asked for a standing order. Then a corner storefront came up for lease, two blocks from that first alley — so we moved the fire in, and never looked back.",
          "updated_at": "2026-07-07T20:50:05.101Z"
        },
        {
          "key": "roasts_heading",
          "value": "Three we roast every week",
          "updated_at": "2026-07-07T20:50:05.109Z"
        },
        {
          "key": "roasts_intro",
          "value": "Small lots, turned around fast. What is in the hopper this week, and where each one lands in the cup.",
          "updated_at": "2026-07-07T20:50:05.123Z"
        }
      ]
    },
