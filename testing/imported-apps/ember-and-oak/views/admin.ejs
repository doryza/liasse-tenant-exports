<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Dashboard — Ember & Oak</title>
<link rel="stylesheet" href="public/css/admin-styles.css">
</head>
<body class="admin-body">
<button class="admin-menu-btn" id="admMenu" aria-label="Open menu">&#9776;</button>
<%- include('partials/admin-sidebar') %>
<main class="admin-main">
  <div class="admin-head">
    <div class="admin-head-titles">
      <p class="admin-eyebrow">Ember &amp; Oak · Roastery admin</p>
      <h1>Dashboard</h1>
    </div>
    <a class="btn-ghost" href="." target="_blank" rel="noopener">View site &#8599;</a>
  </div>

  <div class="stat-grid">
    <div class="stat-card">
      <span class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="2"/></svg></span>
      <span class="stat-num"><%= stats.totalVisits %></span>
      <span class="stat-label">Total visits</span>
    </div>
    <div class="stat-card">
      <span class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 7v5l3 3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span>
      <span class="stat-num"><%= stats.recentVisits %></span>
      <span class="stat-label">Visits · last 7 days</span>
    </div>
    <div class="stat-card">
      <span class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path d="M4 5h16v11H8l-4 4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></span>
      <span class="stat-num"><%= stats.enquiries %></span>
      <span class="stat-label">Wholesale enquiries</span>
    </div>
    <div class="stat-card accent">
      <span class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path d="M12 2c1 3-2 4-2 7a2 2 0 0 0 4 0c2 2 3 4 3 6a5 5 0 0 1-10 0c0-4 4-6 5-13z" fill="currentColor"/></svg></span>
      <span class="stat-num"><%= stats.newEnquiries %></span>
      <span class="stat-label">New enquiries</span>
    </div>
    <div class="stat-card">
      <span class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path d="M4 7l8-4 8 4v10l-8 4-8-4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M4 7l8 4 8-4M12 11v10" fill="none" stroke="currentColor" stroke-width="2"/></svg></span>
      <span class="stat-num"><%= stats.roasts %></span>
      <span class="stat-label">Roasts live</span>
    </div>
  </div>

  <div class="dash-cols">
    <section class="panel">
      <h2>Manage the roastery</h2>
      <p class="panel-sub">Everything customers see on your site — add, edit, or hide it here.</p>
      <div class="module-links">
        <a href="admin/roasts"><span class="ml-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path d="M4 7l8-4 8 4v10l-8 4-8-4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></span><span class="ml-txt"><strong>Roasts</strong><span>Names, tasting notes, roast level, prices</span></span></a>
        <a href="admin/story_moments"><span class="ml-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><rect x="3" y="4" width="18" height="17" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M3 9h18M8 2v4M16 2v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span><span class="ml-txt"><strong>Story timeline</strong><span>The moments behind the fire</span></span></a>
        <a href="admin/hours"><span class="ml-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 7v5l3 3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span><span class="ml-txt"><strong>Opening hours</strong><span>The visit-us ledger</span></span></a>
        <a href="admin/posts"><span class="ml-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path d="M4 20h16M4 20v-4l10-10 4 4-10 10z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></span><span class="ml-txt"><strong>Journal</strong><span>Roasting notes and news</span></span></a>
        <a href="admin/enquiries"><span class="ml-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path d="M4 5h16v11H8l-4 4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></span><span class="ml-txt"><strong>Wholesale enquiries</strong><span>Cafes reaching out<% if (stats.newEnquiries) { %> · <em class="ml-badge"><%= stats.newEnquiries %> new</em><% } %></span></span></a>
      </div>
    </section>

    <section class="panel">
      <h2>Recent enquiries</h2>
      <% if (recentEnquiries && recentEnquiries.length) { %>
        <ul class="recent-list">
        <% recentEnquiries.forEach(function(e){ %>
          <li>
            <div class="recent-top"><strong><%= e.name %></strong><% if (e.cafe) { %> · <%= e.cafe %><% } %><span class="recent-date"><%= new Date(e.created_at).toLocaleDateString('en-CA') %></span></div>
            <p><%= e.message %></p>
          </li>
        <% }); %>
        </ul>
        <a class="btn-ghost" href="admin/enquiries">See all enquiries</a>
      <% } else { %>
        <div class="empty">
          <p><strong>No enquiries yet.</strong></p>
          <p class="muted">When a cafe reaches out through the wholesale form, they will land here.</p>
        </div>
      <% } %>
    </section>
  </div>

  <p class="dash-note">Tip: open your live site and use the inline editor to change any heading, illustration, or paragraph in place — including the hero, story, and footer copy.</p>
</main>
<script>
document.getElementById('admMenu').addEventListener('click', function(){ document.getElementById('adminSidebar').classList.toggle('open'); });
</script>
</body>
</html>
