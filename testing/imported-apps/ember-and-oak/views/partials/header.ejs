<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= (typeof settings!=='undefined' && settings.business_name) ? settings.business_name : 'Ember & Oak' %> — Montreal Coffee Roaster</title>
<meta name="description" content="Ember & Oak is a Montreal micro-roastery in Mile End. Roasted small in 5-kilo batches, drawn by hand, delivered by bike.">
<meta name="theme-color" content="#D95B29">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Ember & Oak">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta property="og:title" content="Ember & Oak — Montreal Coffee Roaster">
<meta property="og:description" content="Roasted small. Drawn by hand. Montreal.">
<meta property="og:type" content="website">
<link rel="manifest" href="manifest.json">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Karla:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="public/css/styles.css">
</head>
<body>
<a class="skip" href="#roasts">Skip to the roasts</a>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="." aria-label="Ember & Oak home">
      <svg class="mark" viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
        <path d="M9 24C4 19 5 9 12 6c6-3 13 1 13 8 0 6-4 10-9 11" fill="none" stroke="#2B2320" stroke-width="2" stroke-linecap="round"/>
        <path d="M16 9c1 2-1 3-1 5s3 2 3 0c1 2 2 4 1 6s-4 2-5 0c-1-3 1-6 2-11z" fill="#D95B29" stroke="#2B2320" stroke-width="1" stroke-linejoin="round"/>
      </svg>
      <span class="wordmark">Ember <span class="amp">&amp;</span> Oak</span>
    </a>
    <nav class="nav-desktop" aria-label="Primary">
      <a href="#story" data-lk="nav-story">Story</a>
      <a href="#roasts" data-lk="nav-roasts">Roasts</a>
      <a href="#wholesale" data-lk="nav-wholesale">Wholesale</a>
      <a href="#visit" data-lk="nav-visit">Visit</a>
    </nav>
    <button class="nav-toggle" id="navToggle" aria-label="Menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="#2B2320" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
  </div>
  <nav class="nav-mobile" id="navMobile" aria-label="Mobile">
    <a href="#story" data-lk="mnav-story">Story</a>
    <a href="#roasts" data-lk="mnav-roasts">Roasts</a>
    <a href="#wholesale" data-lk="mnav-wholesale">Wholesale</a>
    <a href="#visit" data-lk="mnav-visit">Visit</a>
  </nav>
</header>
<div class="ember-thread" aria-hidden="true">
  <svg viewBox="0 0 60 1000" preserveAspectRatio="none" fill="none">
    <path id="emberPath" pathLength="1000" d="M32 0 C 8 70, 52 130, 30 200 C 10 270, 52 330, 30 400 C 12 470, 50 530, 30 600 C 12 670, 50 730, 30 800 C 14 860, 46 920, 30 1000" stroke="#2B2320" stroke-width="2.5" stroke-linecap="round" opacity="0.85"/>
  </svg>
</div>
<main id="main">
