<a href="abonnement">S'abonner à l'infolettre</a>
<a href="#" data-login-btn>Connexion</a>
<a href="#" data-auth-only style="display:none" onclick="if(window.TenantSDK){TenantSDK.auth.logout();}location.reload();return false;">Déconnexion</a>
</nav>
</header>
